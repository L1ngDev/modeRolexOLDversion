stock ac_OnPlayerRequestSpawn(playerid)
{
    PublicFlood(playerid, 19);
    if(!GetPlayerState(playerid))
	{
	    if(playerSpawnTimer[playerid])
		{
			KillTimer(playerSpawnTimer[playerid]);
			playerSpawnTimer[playerid] = 0;
		}
		playerSpawn{playerid} = 1;
	}
	return 1 ;
}


stock ac_OnVehicleSpawn(vehicleid)
{
    vehicleHealth[vehicleid] = 1000.0;
    return 1;
}


stock ac_OnGameModeInit()
{
	SetTimer("ac_MainUpdate", 1000, 1);
	SetTimer("ac_FastUpdate", 200, 1);

	new Float:pos = 436.0693;
    for(new ac_id; ac_id < AC_WARN_LINE; ac_id++)
    {
        warningPanelTD[ac_id] = TextDrawCreate(635.5764, pos, "_"); pos -= 7.0;
        TextDrawLetterSize(warningPanelTD[ac_id], 0.1804, 0.8024);
		TextDrawAlignment(warningPanelTD[ac_id], 3);
		TextDrawColor(warningPanelTD[ac_id], -1);
		TextDrawSetOutline(warningPanelTD[ac_id], 0);
		TextDrawBackgroundColor(warningPanelTD[ac_id], 255);
		TextDrawFont(warningPanelTD[ac_id], 1);
		TextDrawSetProportional(warningPanelTD[ac_id], 1);
		TextDrawSetShadow(warningPanelTD[ac_id], 1);
		warningPanelText[ac_id] = "_";
	}
    return 1;
}

stock ac_OnPlayerUpdate(playerid)
{
	if(ac_playerPaused[playerid] > 3)
	{
	    #if defined OnPlayerExitPausedAC
	        OnPlayerExitPausedAC(playerid);
		#endif
		playerCheckFly{playerid} = SleepTime(playerid);
	}
    ac_playerPaused[playerid] = 0;
    return 1;
}
