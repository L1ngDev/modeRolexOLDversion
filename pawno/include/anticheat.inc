stock AddToWarningPanel(playerid, reason[], type = 0) 
{ 
	if(IsPlayerConnected(playerid))
	{
		if ( admin_info [ playerid ] [ admin ] > 0 ) return 1 ;

		new GrandString [ 144 ] ;
		switch(type)
		{
			case 0: format(GrandString, sizeof(GrandString), "~r~~h~~h~(warning) ~w~%s(%i)(%s) reason: %s", ac_playerName[playerid], playerid, ac_playerIP[playerid], reason);
			case 1: format(GrandString, sizeof(GrandString), "~w~(kick) %s(%i)(%s) reason: %s", ac_playerName[playerid], playerid, ac_playerIP[playerid], reason);
			case 2: format(GrandString, sizeof(GrandString), "~r~~h~~h~(warning) ~w~%s", reason);
		}
		for(new ac_id = (AC_WARN_LINE - 1); ac_id >= 0; ac_id--) if(!strcmp(warningPanelText[ac_id], GrandString))
		{
			warningPanelTime{ac_id} = 30;
			return 1 ;
		}
		for(new ac_id = (AC_WARN_LINE - 1); ac_id > 0; ac_id--)
		{
			warningPanelTime{ac_id} = warningPanelTime{ac_id - 1};
			warningPanelText[ac_id] = warningPanelText[ac_id - 1];
		}
		warningPanelTime{0} = 30;
		format(warningPanelText[0], 100, GrandString);
		for(new ac_id = (AC_WARN_LINE - 1); ac_id >= 0; ac_id--) TextDrawSetString(warningPanelTD[ac_id], warningPanelText[ac_id]);
	}
	return 1 ;
}

forward ac_FastUpdate();
public ac_FastUpdate() AC_FORPLAYER(playerid)
{
    if(ac_playerPaused[playerid] <= 3)
    {
		new speed = GetPlayerSpeedAC(playerid), gstate = GetPlayerState(playerid);
  		if(gstate == PLAYER_STATE_DRIVER)
		{
	 		if(GetTickDiffAC(GetTickCount(), playerLagSpeed[playerid]) < 250 && !IsAirTransportAC(GetPlayerVehicleID(playerid)))
	 		{
			 	if((speed - playerLastSpeed[playerid]) > 50 && !playerWarningLaunch{playerid})
			 	{
			 	    if(++playerWarningSpeed{playerid} > 2) CheatDetected(playerid, AC_DIFFSPEED);
			 	    playerNullWarningTimer[playerid][0] = 10;
			 	}
		 	}
	 		playerLastSpeed[playerid] = speed;
	 	}
		else if(gstate == PLAYER_STATE_ONFOOT)
		{
	    	new Float:vel_x, Float:vel_y, Float:vel_z;
	    	GetPlayerVelocity(playerid, vel_x, vel_y, vel_z);
	        if((floatabs(vel_x) > 0.3 || floatabs(vel_y) > 0.3) && vel_z > -0.2 && GetPlayerWeapon(playerid) != 46 && GetPlayerSurfingVehicleID(playerid) == 0xFFFF && GetPlayerSurfingObjectID(playerid) == 0xFFFF) SetTimerEx("ac_CheckSurfing", 2100, 0, "if", playerid, ac_playerHealth[playerid], GetPlayerVehicleID(playerid));
			else playerWarningSurf{playerid} = 0;
		}
	}
	playerLagSpeed[playerid] = GetTickCount();
}

forward ac_CheckSurfing(playerid, Float:heal, _id_vehicle);
public ac_CheckSurfing(playerid, Float:heal, _id_vehicle)
{
	if(heal <= ac_playerHealth[playerid] && _id_vehicle == GetPlayerVehicleID(playerid)) { if(++playerWarningSurf{playerid} > 1) anti_cheat(playerid, "surf", 0); }
	else playerWarningSurf{playerid} = 0;
}

