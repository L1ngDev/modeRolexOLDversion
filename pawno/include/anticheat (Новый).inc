stock SaveAntiCheatSettings ( code_id )
{
	static const _str [ ] = "SELECT * FROM `anticheat` WHERE `a_id` = '%d' LIMIT 1" ;
	new query_string [ sizeof _str + 9 ] ;
	format ( query_string, sizeof ( query_string ), _str, code_id ) ;
	new Cache:result = mysql_query ( sql_connection, query_string ) ;
	
	new _a_count = cache_num_rows ( ) ;
	if ( _a_count )
	{
	    new sql_string [ 71 + 3 + 9 ] ;
		format ( sql_string, sizeof sql_string, "UPDATE `anticheat` SET `a_status` = '%d' WHERE `a_id` = '%d' LIMIT 1", CheatStatus [ code_id ], code_id ) ;
		mysql_tquery ( sql_connection, sql_string ) ;
	}
	else
	{
		new sql_string [ 65 + 3 + 9 ] ;
		format ( sql_string, sizeof ( sql_string ), "INSERT INTO `anticheat` (`a_id`,`a_status`) VALUES ('%d','%d')",
		code_id, CheatStatus [ code_id ] ) ;
		mysql_tquery ( sql_connection, sql_string ) ;
	}
	cache_delete ( result ) ;
	return 1 ;
}

