stock ac_OneSecondPlayer ( playerid )
{
	new Float:ac_pos_x, Float:ac_pos_y, Float:ac_pos_z;
	GetPlayerPos(playerid, ac_pos_x, ac_pos_y, ac_pos_z);
	if(++ac_playerPaused[playerid] <= 3)
	{
		for(new ac_id = (AC_NULL_WARN - 1); ac_id >= 0; ac_id--) if(playerNullWarningTimer[playerid][ac_id]) { if(--playerNullWarningTimer[playerid][ac_id] <= 0) switch(ac_id)
		{
			case 0: if(--playerWarningSpeed{playerid} > 0) playerNullWarningTimer[playerid][ac_id] = 10;
			case 1: if(--playerWarningCarShot{playerid} > 0) playerNullWarningTimer[playerid][ac_id] = 10;
			case 4: 
			{
				//if(--playerWarningNopDamage{playerid} > 0) playerNullWarningTimer[playerid][ac_id] = 1;
				playerWarningNopDamage{playerid} = 0;
			}
			case 5: if(--playerWarningLaunch{playerid} > 0) playerNullWarningTimer[playerid][ac_id] = 10;
			case 6: if(--playerWarningTeleport1{playerid} > 0) playerNullWarningTimer[playerid][ac_id] = 90;
			case 7: if(--playerWarningTeleport0{playerid} > 0) playerNullWarningTimer[playerid][ac_id] = 90;
			case 8: if(--playerWarningSpeedWarning{playerid} > 0) playerNullWarningTimer[playerid][ac_id] = 10;
			case 9: if(--playerWarningSpeedFoot{playerid} > 0) playerNullWarningTimer[playerid][ac_id] = 10;
			case 10: if(--playerWarningSpeedCar{playerid} > 0) playerNullWarningTimer[playerid][ac_id] = 10;
		}}
		//if(NetStats_MessagesRecvPerSecond(playerid) > 800) CheatDetected(playerid, AC_RECVPER);
		if(GetPlayerSpecialAction(playerid) == SPECIAL_ACTION_USEJETPACK) CheatDetected(playerid, AC_JETPACK);
			
		if(GetPlayerPing(playerid) > AC_MAX_PING) { if(++playerWarningPing{playerid} > 10) CheatDetected(playerid, AC_PING); }
		else playerWarningPing{playerid} = 0;
			
		if(playerClientCheck{playerid} <= 15) playerClientCheck{playerid}++;
		if(playerClientCheck{playerid} == 15) AddToWarningDialog(playerid, "sleep");
			
		new gstate = GetPlayerState(playerid), vehid = GetPlayerVehicleID(playerid);
		switch(gstate)
		{
			case PLAYER_STATE_DRIVER:
			{
				if(playerCheckRepair{playerid}) playerCheckRepair{playerid}--;
				else
				{
					new Float:heal;
					GetVehicleHealth(vehid, heal);
					if(!playerInModShop{playerid} && heal > vehicleHealth[vehid] && !IsPlayerInPayNSprayAC(playerid))
					{
						SetVehicleHealth(vehid, vehicleHealth[vehid]);
						if(++playerWarningReapir{playerid} > 10) CheatDetected(playerid, AC_REPAIR);
					}
					else
					{
						vehicleHealth[vehid] = heal;
						playerWarningReapir{playerid} = 0;
					}
				}
			}
			case PLAYER_STATE_ONFOOT: if(playerClientCheck{playerid} <= 15)
			{
				if(!AC_GETBIT(playerClientArg[playerid], 21))
				{
					if(playerWarningInvul{playerid} >= 10) RemoveToWarningDialog(playerid, "invul");
					playerWarningInvul{playerid} = 0;
				}
				else
				{
					if(playerWarningInvul{playerid} <= 10) playerWarningInvul{playerid}++;
					if(playerWarningInvul{playerid} == 10) AddToWarningDialog(playerid, "invul");
				}
			}
		}
		SendClientCheck(playerid, 0x2, 0, 0, 2);
				
		#if defined new_anticheat
		if(playerCheckWeapon{playerid}) playerCheckWeapon{playerid}--;
		else { for(new ac_id = 12; ac_id >= 0; ac_id--)
		{
			new weap, ammo;
			GetPlayerWeaponData(playerid, ac_id, weap, ammo);
			if(weap && weap != 1 && weap != 46)
			{
				if(ammo < ac_playerAmmo[playerid][ac_id]) ac_playerAmmo[playerid][ac_id] = ammo;
				if(weap != ac_playerWeaponID[playerid][ac_id]) CheatDetected(playerid, AC_WEAPON);
			}
		}}
		#endif // new_anticheat
		
		if(playerCheckArmour{playerid}) playerCheckArmour{playerid}--;
		else
		{
			new Float:arm;
			GetPlayerArmour(playerid, arm);
			if(ac_playerArmour[playerid] < arm)
			{
				SetPlayerArmour(playerid, ac_playerArmour[playerid]);
				if(++playerWarningArmour{playerid} > 10) CheatDetected(playerid, AC_ARMOUR);
			}
			else if(ac_playerArmour[playerid] > arm)
			{
				ac_playerArmour[playerid] = arm;
				playerWarningArmour{playerid} = 0;
			}
			else playerWarningArmour{playerid} = 0;
		}
			
		if(playerCheckHealth{playerid}) playerCheckHealth{playerid}--;
		else
		{
			new Float:heal;
			GetPlayerHealth(playerid, heal);
			if(ac_playerHealth[playerid] < heal)
			{
				SetPlayerHealth(playerid, ac_playerHealth[playerid]);
				if(++playerWarningHealth{playerid} > 10) CheatDetected(playerid, AC_HEALTH);
			}
			else if(ac_playerHealth[playerid] > heal)
			{
				ac_playerHealth[playerid] = heal;
				playerWarningHealth{playerid} = 0;
			}
			else playerWarningHealth{playerid} = 0;
		}
			
		if(vehid) { if(playerRemoveVehicle{playerid}) { if(--playerRemoveVehicle{playerid} <= 0) CheatDetected(playerid, AC_VEHREMOVE); }}
		else
		{
			new animid = GetPlayerAnimationIndex(playerid);
			switch(animid)
			{
				case 1058: CheatDetected(playerid, AC_FLY4);
				case 157, 159, 161: CheatDetected(playerid, AC_FLY1);
			}
			if(1538 <= animid <= 1544 && !IsPlayerInWaterAC(playerid)) { if(++playerWarningFly1{playerid} > 2) CheatDetected(playerid, AC_FLY2); }
			else playerWarningFly1{playerid} = 0;
			if((animid == 958 || animid == 959) && GetPlayerWeapon(playerid) != 46) { if(++playerWarningFly2{playerid} > 2) CheatDetected(playerid, AC_FLY3); }
			else playerWarningFly2{playerid} = 0;
		}
			
		new objid = GetPlayerSurfingObjectID(playerid);
		if(!objid || objid == 0xFFFF) playerWarningInviz{playerid} = 0;
		else
		{
			new Float:pos_ox, Float:pos_oy, Float:pos_oz;
			GetObjectPos(objid, pos_ox, pos_oy, pos_oz);
			if(!IsPlayerInRangeOfPoint(playerid, 50.0, pos_ox, pos_oy, pos_oz)) { if(++playerWarningInviz{playerid} > 10) CheatDetected(playerid, AC_INVIZ0); }
			else playerWarningInviz{playerid} = 0;
		}
			
		if(playerCheckFly{playerid}) playerCheckFly{playerid}--;
		else
		{
			if((gstate == PLAYER_STATE_DRIVER || gstate == PLAYER_STATE_ONFOOT) && GetTickDiffAC(GetTickCount(), playerLagFly[playerid]) < 1500 && ac_playerPosZ[playerid] > -35.0)
			{
				new Float:ac_dist = VectorSize(floatabs(ac_playerPosX[playerid] - ac_pos_x), floatabs(ac_playerPosY[playerid] - ac_pos_y), 0.0);
				if(gstate == PLAYER_STATE_DRIVER && ac_dist > 200.0) 
				{
					if ( player_device { playerid } != 2 ) CheatDetected(playerid, AC_TP0);
					else if ( player_device { playerid } == 2 )
					{
						if (++playerWarningTeleport0{playerid} > 1) CheatDetected(playerid, AC_TP0);
						playerNullWarningTimer[playerid][7] = 90;
					}
				}
				
				if ( player_device { playerid } != 2 )
				{
					if(gstate == PLAYER_STATE_ONFOOT && ac_dist > 60.0 && objid == 0xFFFF && GetPlayerSurfingVehicleID(playerid) == 0xFFFF) CheatDetected(playerid, AC_TP1);
				}
				else if ( player_device { playerid } == 2 )
				{
					if(gstate == PLAYER_STATE_ONFOOT && ac_dist > 60.0 && objid == 0xFFFF && GetPlayerSurfingVehicleID(playerid) == 0xFFFF) 
					{
						if (++playerWarningTeleport1{playerid} > 1) CheatDetected(playerid, AC_TP1);
						playerNullWarningTimer[playerid][6] = 90;
					}
				}
				if(ac_dist > 5.0 && GetPlayerSpeedAC(playerid) < 2) { if(++playerWarningFly0{playerid} > 2) CheatDetected(playerid, AC_FLY0); }
				else playerWarningFly0{playerid} = 0;
			}
		}
	}
	playerLagFly[playerid] = GetTickCount();
	ac_playerPosX[playerid] = ac_pos_x;
	ac_playerPosY[playerid] = ac_pos_y;
	ac_playerPosZ[playerid] = ac_pos_z;
	return 1 ;
}

forward ac_FastUpdate();
public ac_FastUpdate() 
{
	AC_FORPLAYER(playerid)
	{
		if(ac_playerPaused[playerid] <= 3)
		{
			new gstate = GetPlayerState(playerid);
			switch(gstate)
			{
				case PLAYER_STATE_DRIVER:
				{
					new vehicleid = GetPlayerVehicleID ( playerid ) ;
					if ( vehicleid == 0 ) continue ;
					
					new speed = GetVehicleSpeedAC ( vehicleid ) ;
					if ( player_device { playerid } == 2 )
					{
						/*new _max_speed = max_veh_speed ( getReplacableVehicleModel ( vehicleid ) ) ;
						new __max_speed = getSpeedReplacable ( _max_speed ) ;
						
						if(speed > 20 && playerLastSpeed[playerid] > 20 && speed > playerLastSpeed[playerid] && (speed - playerLastSpeed[playerid]) > ( __max_speed ) + 20 && playerWarningLaunch{playerid} < 1 && playerCheckFly{playerid} < 1)
						{
							if(++playerWarningSpeed{playerid} > 3) CheatDetected(playerid, AC_DIFFSPEED);
							playerNullWarningTimer[playerid][0] = 10;
						}
						else if(speed > 20 && playerLastSpeed[playerid] > 20 && speed > playerLastSpeed[playerid] && (speed - playerLastSpeed[playerid]) > ( __max_speed ) + 10 && playerWarningLaunch{playerid} < 1 && playerCheckFly{playerid} < 1)
						{
							if ( CheatStatus [ AC_DIFFSPEED ] == 1 || CheatStatus [ AC_DIFFSPEED ] == 2 ) 
							{
								if(++playerWarningSpeedWarning{playerid} > 1) AddToWarningPanel(playerid, "speed");
								playerNullWarningTimer[playerid][8] = 10;
							}
						}*/
					}
					else
					{
						if(speed > 20 && playerLastSpeed[playerid] > 20 && speed > playerLastSpeed[playerid] && (speed - playerLastSpeed[playerid]) > 55 && playerWarningLaunch{playerid} < 1 && playerCheckFly{playerid} < 1)
						{
							if(++playerWarningSpeed{playerid} > 3) CheatDetected(playerid, AC_DIFFSPEED);
							playerNullWarningTimer[playerid][0] = 10;
						}
						else if(speed > 20 && playerLastSpeed[playerid] > 20 && speed > playerLastSpeed[playerid] && (speed - playerLastSpeed[playerid]) > 45 && playerWarningLaunch{playerid} < 1 && playerCheckFly{playerid} < 1)
						{
							if ( CheatStatus [ AC_DIFFSPEED ] == 1 || CheatStatus [ AC_DIFFSPEED ] == 2 ) 
							{
								if(++playerWarningSpeedWarning{playerid} > 1) AddToWarningPanel(playerid, "speed");
								playerNullWarningTimer[playerid][8] = 10;
							}
						}
					}
					playerLastSpeed[playerid] = speed;
				}
				case PLAYER_STATE_PASSENGER:
				{
					new vehicleid = GetPlayerVehicleID ( playerid ) ;
					if ( vehicleid == 0 ) continue ;
						
					new speed = GetVehicleSpeedAC ( vehicleid ) ;
					if ( veh_info [ vehicleid - 1 ] [ v_driver ] != INVALID_PLAYER_ID ) continue ;
				
					if(speed > 20 && playerLastSpeed[playerid] > 20 && speed > playerLastSpeed[playerid] && (speed - playerLastSpeed[playerid]) > 55 && playerWarningLaunch{playerid} < 1 && playerCheckFly{playerid} < 1)
					{
						if(++playerWarningSpeed{playerid} > 3) CheatDetected(playerid, AC_DIFFSPEED_PASS);
						playerNullWarningTimer[playerid][0] = 10;
					}
					else if(speed > 20 && playerLastSpeed[playerid] > 20 && speed > playerLastSpeed[playerid] && (speed - playerLastSpeed[playerid]) > 45 && playerWarningLaunch{playerid} < 1 && playerCheckFly{playerid} < 1)
					{
						if ( CheatStatus [ AC_DIFFSPEED_PASS ] == 1 || CheatStatus [ AC_DIFFSPEED_PASS ] == 2 ) 
						{
							if(++playerWarningSpeedWarning{playerid} > 1) AddToWarningPanel(playerid, "speed pass");
							playerNullWarningTimer[playerid][8] = 10;
						}
					}
					
					playerLastSpeed[playerid] = speed;
				}
				case PLAYER_STATE_ONFOOT:
				{
					new speed = get_speed_ac ( playerid ) ;
					if(speed > 200 && playerCheckFly{playerid} < 1) CheatDetected(playerid, AC_SPEED_2);
				
					new surf_ = GetPlayerSurfingVehicleID ( playerid ) ;
					if(speed > 5 && playerLastSpeed[playerid] > 5 && speed > playerLastSpeed[playerid] && (speed - playerLastSpeed[playerid]) > 55 && surf_ != INVALID_VEHICLE_ID && playerCheckFly{playerid} < 1)
					{
						if(++playerWarningSpeedFoot{playerid} > 3) CheatDetected(playerid, AC_SPEED);
						playerNullWarningTimer[playerid][9] = 10;
					}
					
					playerLastSpeed[playerid] = speed;

					new Float:vel_x, Float:vel_y, Float:vel_z;
					GetPlayerVelocity(playerid, vel_x, vel_y, vel_z);
					if((floatabs(vel_x) > 0.3 || floatabs(vel_y) > 0.3) && vel_z > -0.2 && GetPlayerWeapon(playerid) != 46 && GetPlayerSurfingVehicleID(playerid) == 0xFFFF && GetPlayerSurfingObjectID(playerid) == 0xFFFF) SetTimerEx("ac_CheckSurfing", 2100, 0, "if", playerid, ac_playerHealth[playerid], GetPlayerVehicleID(playerid));
					else playerWarningSurf{playerid} = 0;
				}
			}
		}
		playerLagSpeed[playerid] = GetTickCount();
	}
	return 1 ;
}

forward ac_SlakUpdate();
