stock IsAirTransportAC(vehid)
{
	new model = GetVehicleModel(vehid);
	if(!model) return 0;
	return VehicleAir[model - 400];
}
stock IsWaterTransportAC(vehid)
{
    new model = GetVehicleModel(vehid);
	if(!model) return 0;
	return VehicleWater[model - 400];
}

stock ShowWarningPanelAC(playerid) 
{ 
	for(new ac_id = (AC_WARN_LINE - 1); ac_id >= 0; ac_id--) 
	{
		TextDrawShowForPlayer(playerid, warningPanelTD[ac_id]); 
	}
	return 1;
}

stock HideWarningPanelAC(playerid) 
{ 
	for(new ac_id = (AC_WARN_LINE - 1); ac_id >= 0; ac_id--) 
	{
		TextDrawHideForPlayer(playerid, warningPanelTD[ac_id]); 
	}
	return 1;
}

stock KickAC(playerid)
{
	new ping = GetPlayerPing(playerid);
	if(!playerKickTimer[playerid] && IsPlayerConnected(playerid)) playerKickTimer[playerid] = SetTimerEx("ac_KickTimer", (ping > AC_MAX_PING) ? (AC_MAX_PING + 50) : (ping + 50), 0, "i", playerid);
	return 1;
}

