stock switch_camera ( playerid, cam_pos, select_cam )
{
	new _position ;
	if ( p_t_info [ playerid ] [ tune_pos ] [ 0 ] ) _position = 0 ;
	else _position = 1 ;
    InterpolateCameraPos ( playerid, tuning_camera_positions [ _position ] [ cam_pos ] [ 0 ], tuning_camera_positions [ _position ] [ cam_pos ] [ 1 ], tuning_camera_positions [ _position ] [ cam_pos ] [ 2 ], tuning_camera_positions [ _position ] [ select_cam ] [ 0 ], tuning_camera_positions [ _position ] [ select_cam ] [ 1 ], tuning_camera_positions [ _position ] [ select_cam ] [ 2 ], 10000, CAMERA_MOVE ) ;
	InterpolateCameraLookAt ( playerid, tuning_camera_positions [ _position ] [ cam_pos ] [ 3 ], tuning_camera_positions [ _position ] [ cam_pos ] [ 4 ], tuning_camera_positions [ _position ] [ cam_pos ] [ 5 ], tuning_camera_positions [ _position ] [ select_cam ] [ 3 ], tuning_camera_positions [ _position ] [ select_cam ] [ 4 ], tuning_camera_positions [ _position ] [ select_cam ] [ 5 ], 10000, CAMERA_MOVE ) ;
	return 1 ;
}

