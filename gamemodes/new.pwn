			if ( player_team < 1 || player_team > 2 )
			{
			    show_dialog ( playerid, d_mp_team_set, DIALOG_STYLE_INPUT, "{"#cBHD"}Команда", "{"#cRD"}* Команда не может быть меньше 1 и более 2\n\n{"#cWH"}Укажите ID игрока и номер команды через запятую:\n\n{"#cGRDialog"}* Пример: 23, 1", "Выбрать", "Отмена");
