callback: offtime_callback ( playerid )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows )
	{
	    off_time_status { playerid } = 0 ;
	    off_time_account [ playerid ] =
	    page_count [ playerid ] = 0 ;
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данный аккаунт не найден в базе данных." ) ;
		return 1 ;
	}
	else
	{
		page_count [ playerid ] = 1 ;
		new query_string [ 80 + MAX_PLAYER_NAME ];
		format ( query_string, sizeof query_string, "SELECT * FROM `users_online` WHERE `accountid` = '%d' ORDER BY `users_online`.`id` DESC", off_time_account [ playerid ] ) ;
		mysql_tquery ( sql_connection, query_string, "callback_timelist", "i", playerid ) ;
	}
	return 1 ;
}

callback: callback_timelist ( playerid )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows )
	{
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У выбранного Вами аккаунта не найдено отыгранного времени." ) ;
		off_time_status { playerid } = 0 ;
		off_time_account [ playerid ] =
		page_count [ playerid ] = 0 ;
		return 1 ;
	}
	new rows_list = page_count [ playerid ] - 1 ;
	page_rows [ playerid ] = rows ;
	new line_string [ 39 + ( 16 * 3 ) ], _count_time = 0, _count_afk = 0 ;

	global_string [ 0 ] = EOS ;
	strcat ( global_string, "{"#cLY"}Дата\t\t\tОнлайн\n\n{ffffff}" ) ;
	for ( new i = rows_list * 10 ; i <  rows_list * 10 + 10 ; i ++ )
	{
		if ( i >= rows ) break ;

		new online_sec, afk_sec, date_online [ 16 ] ;
    	cache_get_field_content ( i, "date", date_online, sql_connection, 16 ) ;
		online_sec = cache_get_field_content_int ( i, "online_sec", sql_connection ) ;
		afk_sec = cache_get_field_content_int ( i, "afk_sec", sql_connection ) ;

		_count_time += online_sec ;
		_count_afk += afk_sec ;

		format ( line_string, sizeof ( line_string ), "{"#cWH"}%s\t\t%s {"#cBL"}[AFK: %s]\n", date_online, convert_time ( online_sec, TYPE_TIME_HOUR ), convert_time ( afk_sec, TYPE_TIME_HOUR ) ) ;
		strcat ( global_string, line_string ) ;
	}

	format ( line_string, sizeof line_string, "\n\n{ffffff}Всего отыграно (на странице): %s", convert_time ( _count_time, TYPE_TIME_HOUR ) ) ;
	strcat ( global_string, line_string ) ;
	format ( line_string, sizeof line_string, "\n{ffffff}Всего в AFK (на странице): %s", convert_time ( _count_afk, TYPE_TIME_HOUR ) ) ;
	strcat ( global_string, line_string ) ;

	format ( line_string, sizeof line_string, "{"#cBHD"}Активность игрока: {"#cWH"}№%d", off_time_account [ playerid ] ) ;
	show_dialog ( playerid, d_time_list, DIALOG_STYLE_MSGBOX, line_string, global_string, "Назад", "Далее" ) ;
	return 1 ;
}

