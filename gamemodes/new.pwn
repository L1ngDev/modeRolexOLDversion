CMD:capturecd ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 5 ) return 1 ;
	if ( sscanf ( params, "d", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /capturecd [секунды]" ) ;
	if ( params [ 0 ] < 600 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Меньше 600 секунд нельзя." ) ;

	capture_cooldown = params [ 0 ] ;
	SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Время до захвата территорий успешно установлено." ) ;
	return 1 ;
}
*/
CMD:freezepanel ( playerid )
{
	if ( admin_info [ playerid ] [ admin ] < 6 ) return 1 ;

	global_string [ 0 ] = EOS ;
	strcat ( global_string, "{"#cBL"}Орг.:\t{"#cBL"}Статус:\t{"#cBL"}Попыток:\t{"#cBL"}Время до захвата:\n" ) ;
	for ( new j = 18 ; j < 23 ; j ++ )
	{
		new line_string [ 128 ] ;
		if ( capture_gang_freezed [ j - 18 ] == 0 ) format ( line_string, sizeof ( line_string ), "{"#cWH"}%s\t{"#cGN"}Разморожено\t{"#cWH"}%d\t%s\n", f_info [ j - 1 ] [ f_name ], capture_gang_attempt [ j - 18 ], convert_time ( capture_gang_cd [ j - 18 ], TYPE_TIME_SECOND ) ) ;
		else format ( line_string, sizeof ( line_string ), "{"#cWH"}%s\t{"#cRD"}Заморожено\t{"#cWH"}%d\t%s\n", f_info [ j - 1 ] [ f_name ], capture_gang_attempt [ j - 18 ], convert_time ( capture_gang_cd [ j - 18 ], TYPE_TIME_SECOND ) ) ;
		strcat ( global_string, line_string ) ;
	}
	for ( new j = 23 ; j < 26 ; j ++ )
	{
		new line_string [ 128 ] ;
		if ( capture_gang_freezed [ j - 18 ] == 0 ) format ( line_string, sizeof ( line_string ), "{"#cWH"}%s\t{"#cGN"}Разморожено\t{"#cWH"}%d\t%s\n", f_info [ j - 1 ] [ f_name ], capture_gang_attempt [ j - 18 ], convert_time ( mafia_cd, TYPE_TIME_SECOND ) ) ;
		else format ( line_string, sizeof ( line_string ), "{"#cWH"}%s\t{"#cRD"}Заморожено\t{"#cWH"}%d\t%s\n", f_info [ j - 1 ] [ f_name ], capture_gang_attempt [ j - 18 ], convert_time ( mafia_cd, TYPE_TIME_SECOND ) ) ;
		strcat ( global_string, line_string ) ;
	}
	show_dialog ( playerid, d_capture_freeze, DIALOG_STYLE_TABLIST_HEADERS, "{"#cBHD"}Статусы заморозки", global_string, "Изменить", "Закрыть" ) ;
	return 1 ;
}

CMD:capture ( playerid )
{
	if ( ! gang_player ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команда доступна только бандам." ) ;
	if ( capture_gang_freezed [ p_info [ playerid ] [ member ] - 18 ] > 0 )
	{
		return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Ваша банда заморожена, Вы не можете начать захват территории." ) ;
	}

    if ( mw_biz != -1 || gz_captured != -1 || conf_time > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}В данный момент уже идет война." ) ;

    new year,
		month,
		day,
		hour,
		minute,
		second ;

	getdate ( year, month, day ) ;
	gettime ( hour, minute, second ) ;
	FixHour ( hour ) ;

	if ( global_hour < 12 || global_hour > 22 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Захват территорий возможен только с 12 до 22 часов." ) ;

	new fraction_id = p_info [ playerid ] [ member ] ;
	if ( p_info [ playerid ] [ rank ] < f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 6 ] )
	{
	    static const _str [ ] = "{"#cRInfo"}* {"#cGRInfo"}Команда доступна с ранга %s (%d)." ;
	    new scm_string [ sizeof _str + 30 + 3 ] ;
	    format ( scm_string, sizeof scm_string, _str, f_rank [ fraction_id - 1 ] [ f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 6 ] - 1 ], f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 6 ] ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
		return 1 ;
	}
	if ( capture_gang_cd [ fraction_id - 18 ] > 0 )
	{
		new text_str [ 78 ] ;
		format ( text_str, sizeof ( text_str ), "{"#cRInfo"}* {"#cGRInfo"}Захват будет доступен через %s.", convert_time ( capture_gang_cd [ fraction_id - 18 ], TYPE_TIME_SECOND ) ) ;
		return SendClientMessage ( playerid, col_gray, text_str ) ;
	}

    for ( new i = 0 ; i < gz_count ; i ++ )
	{
		if ( IsPlayerInGangZone ( playerid, i ) )
		{
			if ( gz_info [ i ] [ gz_owner ] == p_info [ playerid ] [ member ] )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете захватить свою территорию." ) ;
			if ( f_diplomacy [ fraction_id - 18 ] [ gz_info [ i ] [ gz_owner ] - 18 ] == dip_status_alliance || f_diplomacy [ fraction_id - 18 ] [ gz_info [ i ] [ gz_owner ] - 18 ] == dip_status_neutral )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете напасть на союзника." ) ;
			if ( capture_gang_freezed [ gz_info [ i ] [ gz_owner ] - 18 ] > 0 )
			{
				return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данную банду нельзя атаковать, она заморожена." ) ;
			}

			if ( capture_gang_cd [ gz_info [ i ] [ gz_owner ] - 18 ] > 0 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данная банда ещё не отдохнула после предыдущего захвата." ) ;

			if ( gz_info [ i ] [ gz_spawn ] == 1 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нельзя атаковать базу банды." ) ;

			new owner_counts = 0 ;
			foreach(new j: fraction_players[gz_info [ i ] [ gz_owner ]])
			{
				if ( gz_info [ i ] [ gz_owner ] == p_info [ j ] [ member ] && p_info [ j ] [ warblock ] == 0 )owner_counts ++ ;
			}
			if ( owner_counts < capture_online ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игроков организации, контроллирующей территорию, нет в игре." ) ;

			gz_captured = i ;
			gz_info [ i ] [ gz_time ] = 420 ;
			gz_info [ i ] [ gz_attacker ] = fraction_id ;

			new zone_name [ 32 ] ;
			GetPlayer2DZone ( playerid, zone_name, 32 ) ;

			new _string [ 144 ] ;
			format ( _string, sizeof ( _string ), "[U] '%s' спровоцировала битву за территорию с '%s'. Район: '%s'.",
			f_info [ fraction_id - 1 ] [ f_name ],
			f_info [ gz_info [ i ] [ gz_owner ] - 1 ] [ f_name ], zone_name ) ;
			SendGangMessage ( col_light_red, _string ) ;

			format ( _string, sizeof ( _string ), "* %s %s[%d] спровоцировал(а) войну.",
			f_rank [ fraction_id - 1 ] [ p_info [ playerid ] [ rank ] - 1 ],
			p_info [ playerid ] [ name ],
			playerid ) ;
			SendGangMessage ( col_light_red, _string ) ;

			checking_getto_quest_progress ( playerid, 1, 1 ) ;

			format ( _string, sizeof ( _string ), "{"#cBAdmin"}[A]{"#cGRAdmin"} %s начали захват территории банды %s",
			f_info [ fraction_id - 1 ] [ f_name ],
			f_info [ gz_info [ i ] [ gz_owner ] - 1 ] [ f_name ] ) ;
			foreach(new j: admin_players) SendClientMessage ( j, col_admin, _string ) ;

			owner_points =
			attacker_points	=
			capture_kills_first =
			capture_kills_two = 0 ;

			format ( capture_kills_first_name, 32, "None" ) ;
			format ( capture_kills_two_name, 32, "None" ) ;

			for ( new f = 18 ; f < 23 ; f ++ )
			{
			    f_kick [ f ] =
			    f_warn [ f ] =
			    f_ban [ f ] = 0 ;
			}

			capture_gang_cd [ fraction_id - 18 ] = 3000 ;
			capture_gang_cd [ gz_info [ i ] [ gz_owner ] - 18 ] = 3000 ;

			format ( _string, sizeof ( _string ),"UPDATE `fractions_players` SET `u_capture_start` = `u_capture_start`+1 WHERE `u_sql_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
			mysql_tquery ( sql_connection, _string, "", "" ) ;

   			GangZoneFlashForAll ( gz_info [ i ] [ gz_created ], f_info [ fraction_id - 1 ] [ f_gangzone_color ] ) ;

			gz_capture_type = gz_type_kills ;

			gz_info [ i ] [ gz_timer ] = SetTimerEx ( "gangzone_timer", 1000, 1, "iiii", i, fraction_id, gz_info [ i ] [ gz_owner ], gz_capture_type ) ;
			break ;
		}
	}
	return 1 ;
}

CMD:capturetime ( playerid )
{
	if ( ! gang_player ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команда доступна только бандам." ) ;

	new line_string [ 98 ] ;
	global_string = "{"#cGRDialog"}* Время захвата территорий: с 12:00 до 22:00\n\n" ;
	for ( new j = 0 ; j < 5 ; j ++ )
	{
		format ( line_string, sizeof ( line_string ), "{%s}До захвата %s:{"#cWH"} %s\n",
		f_info [ j + 17 ] [ f_chat_color ], f_info [ j + 17 ] [ f_name ], convert_time ( capture_gang_cd [ j ], TYPE_TIME_SECOND ) ) ;
		strcat ( global_string, line_string ) ;

	}
	show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Информация", global_string, "Закрыть", "" ) ;
	return 1 ;
}

stock gz_td_status ( playerid, bool: status )
{
	if ( status )
	{
   		capture_ptd[playerid][0] = CreatePlayerTextDraw(playerid, 71.0336, 245.1704, "00:00"); // 1 Box ( Time )
		PlayerTextDrawLetterSize(playerid, capture_ptd[playerid][0], 0.1748, 0.7578);
