		else if ( player_device { playerid } == 2 )
		{
			new w_id, w_ammo ;
			for ( new i = 0 ; i < 11 ; i ++ )
			{
				GetPlayerWeaponData ( playerid, i, w_id, w_ammo ) ;

				if ( p_t_info [ playerid ] [ p_gun_slot ] [ i ] != w_id && w_id != 0 && _gun_status == true )
				{
				    RemoveWeaponFromSlot ( playerid, i ) ;
					anti_cheat ( playerid, "weapon hack", 16 ) ;
