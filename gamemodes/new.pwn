		    SetPVarInt ( playerid, "mp_listitem", listitem ) ;
			return 1 ;
		}
		case d_mp_leader_set:
		{
		    if ( ! response ) return callcmd::mp ( playerid ), DeletePVar ( playerid, "mp_listitem" ) ;

		    if ( listitem == 0 )
		    {
		        new _team = GetPVarInt ( playerid, "mp_listitem" ) + 1 ;
		        DeletePVar ( playerid, "mp_listitem" ) ;

		        foreach(new i: fraction_players[_team])
		        {
		            set_health ( i, admin_mp_hp ) ;
					set_armour ( i, admin_mp_arm ) ;
					if ( ! admin_mp_gun ) reset_player_weapon ( i ) ;

					player_mp [ i ] = true ;
				    SendClientMessage ( i, col_yellow, !"* Вы были телепортированы на мероприятие, ожидайте команд администрации." ) ;
				    SendClientMessage ( i, col_yellow, !"* Если Вы хотите уйти с мероприятия, то используйте /back." ) ;

