							show_dialog ( playerid, d_job_skill, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Водитель автобуса", global_string, "Закрыть", "Назад" ) ;
						}
						case 51..100:
						{
							format ( global_string, 130,
							"{ffffff}Ваш уровень навыка: {"#cBL"}%d\n\n{"#cGRDialog"}До перехода на следующий уровень осталось {"#cBL"}%d очков.",  p_info [ playerid ] [ bus_skill ],
							101 - p_info [ playerid ] [ bus_skill ] ) ;
							show_dialog ( playerid, d_job_skill, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Водитель автобуса", global_string, "Закрыть", "Назад" ) ;
						}
						case 101..150:
						{
							format ( global_string, 130,
							"{ffffff}Ваш уровень навыка: {"#cBL"}%d\n\n{"#cGRDialog"}До перехода на следующий уровень осталось {"#cBL"}%d очков.",  p_info [ playerid ] [ bus_skill ],
							151 - p_info [ playerid ] [ bus_skill ] ) ;
							show_dialog ( playerid, d_job_skill, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Водитель автобуса", global_string, "Закрыть", "Назад" ) ;
						}
						case 151..200:
						{
							format ( global_string, 130,
							"{ffffff}Ваш уровень навыка: {"#cBL"}%d\n\n{"#cGRDialog"}До перехода на следующий уровень осталось {"#cBL"}%d очков.",  p_info [ playerid ] [ bus_skill ],
							201 - p_info [ playerid ] [ bus_skill ] ) ;
							show_dialog ( playerid, d_job_skill, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Водитель автобуса", global_string, "Закрыть", "Назад" ) ;
						}
						default:
						{
							format ( global_string, 130,
							"{ffffff}Ваш уровень навыка: {"#cBL"}%d\n\n{"#cGRDialog"}* У Вас максимальный уровень навыка на данной работе",  p_info [ playerid ] [ bus_skill ] ) ;
							show_dialog ( playerid, d_job_skill, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Водитель автобуса", global_string, "Закрыть", "Назад" ) ;
						}
					}
				}
				case 7:
				{
					global_string [ 0 ] = EOS ;

					if ( p_info [ playerid ] [ atm_good ] < 251 )
					{
						format ( global_string, 140,
						"{ffffff}Ваш уровень навыка: {"#cBL"}%d\n\n{"#cGRDialog"}До перехода на следующий уровень осталось {"#cBL"}%d очков.",  p_info [ playerid ] [ atm_good ],
						251 - p_info [ playerid ] [ atm_good ] ) ;
						show_dialog ( playerid, d_job_skill, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Инкассатор", global_string, "Закрыть", "Назад" ) ;
					}
					else if ( p_info [ playerid ] [ atm_good ] > 250 && p_info [ playerid ] [ atm_good ] < 751 )
					{
						format ( global_string, 140,
						"{ffffff}Ваш уровень навыка: {"#cBL"}%d\n\n{"#cGRDialog"}До перехода на следующий уровень осталось {"#cBL"}%d очков.",  p_info [ playerid ] [ atm_good ],
						751 - p_info [ playerid ] [ atm_good ] ) ;
						show_dialog ( playerid, d_job_skill, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Инкассатор", global_string, "Закрыть", "Назад" ) ;
					}
					else if ( p_info [ playerid ] [ atm_good ] > 750 && p_info [ playerid ] [ atm_good ] < 1501 )
					{
						format ( global_string, 140,
						"{ffffff}Ваш уровень навыка: {"#cBL"}%d\n\n{"#cGRDialog"}До перехода на следующий уровень осталось {"#cBL"}%d очков.",  p_info [ playerid ] [ atm_good ],
						1501 - p_info [ playerid ] [ atm_good ] ) ;
						show_dialog ( playerid, d_job_skill, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Инкассатор", global_string, "Закрыть", "Назад" ) ;
					}
      				else if ( p_info [ playerid ] [ atm_good ] > 1500 && p_info [ playerid ] [ atm_good ] < 2001 )
					{
						format ( global_string, 140,
						"{ffffff}Ваш уровень навыка: {"#cBL"}%d\n\n{"#cGRDialog"}До перехода на следующий уровень осталось {"#cBL"}%d очков.",  p_info [ playerid ] [ atm_good ],
						2001 - p_info [ playerid ] [ atm_good ] ) ;
						show_dialog ( playerid, d_job_skill, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Инкассатор", global_string, "Закрыть", "Назад" ) ;
					}
					else
					{
						format ( global_string, 140,
						"{ffffff}Ваш уровень навыка: {"#cBL"}%d\n\n{"#cGRDialog"}* У Вас максимальный уровень навыка на данной работе",  p_info [ playerid ] [ atm_good ] ) ;
						show_dialog ( playerid, d_job_skill, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Инкассатор", global_string, "Закрыть", "Назад" ) ;
					}
				}
			}
	        return 1 ;
		}
		case d_job_skill:
		{
			if ( ! response ) return show_dialog ( playerid, d_mm_job_skills, DIALOG_STYLE_LIST, "{"#cBHD"}Навыки работ", "{"#cBL"}1. {ffffff}Дальнобойщик\n{"#cBL"}2. {ffffff}Работа в порту\n{"#cBL"}3. {ffffff}Работа на шахте\n{"#cBL"}4. {ffffff}Работа на лесопилке\n{"#cBL"}5. {ffffff}Работа на заводе\n{"#cBL"}6. {ffffff}Механик\n{"#cBL"}7. {ffffff}Водитель автобуса\n{"#cBL"}8. {ffffff}Инкассатор", "Выбрать", "Назад" ) ;
		}
		case d_mm_cmds:
		{
			if ( ! response )
			{
				show_mainmenu ( playerid ) ;
				return 1 ;
			}
			switch ( listitem )
			{
				case 0:
				{
					global_string [ 0 ] = EOS ;

					strcat ( global_string, !"{"#cGN"}/id [имя игрока]{ffffff} - узнать ИД игрока по нику.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/pay [ID игрока] [количество]{ffffff} - передать деньги игроку.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/time{ffffff} - узнать время на часах.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/pass [ID игрока]{ffffff} - показать паспорт.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/lic [ID игрока]{ffffff} - показать лицензии.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/joblist [ID игрока]{ffffff} - показать трудовую книжку.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/ganglist [ID игрока]{ffffff} - показать лист бандитской славы.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/skill [ID игрока]{ffffff} - показать навыки владения оружием.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/med [ID игрока]{ffffff} - показать медицинскую карточку.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/anim{ffffff} - список анимаций.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/gps{ffffff} - навигатор.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/phone{ffffff} - панель управления телефоном.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/call [номер телефона]{ffffff} - позвонить игроку.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/sms [номер телефона]{ffffff} - написать СМС-сообщение игроку.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/togphone {ffffff}- выключить телефон.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/dir {ffffff}- использовать справочник.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/healme {ffffff}- использовать аптечку.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/repairkit {ffffff}- использовать набор инструментов.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/usecanister {ffffff}- использовать канистру с бензином.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/mask {ffffff}- надеть маску.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/unmask {ffffff}- снять маску.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/fstyle {ffffff}- навыки боя.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/number [id игрока / номер]{ffffff} - узнать номер игрока.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/namestore [имя игрока]{ffffff} - история никнеймов.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/giveammo [ID игрока] [количество]{ffffff} - передать патроны.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/giveguns [ID игрока] [количество]{ffffff} - передать ед.оружия.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/givemask [ID игрока] [количество]{ffffff} - передать маски.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/giveheal [ID игрока] [количество]{ffffff} - передать аптечки.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/givedrugs [ID игрока] [количество]{ffffff} - передать наркотики.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/givegun [ID игрока]{ffffff} - передать оружие.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/usedrugs {ffffff} - использовать наркотики.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/dropdrugs {ffffff} - выбросить наркотики.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/stoprent {ffffff} - прекратить аренду транспорта.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/quitjob {ffffff} - уволиться с работы.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/spawnchange (/spaw) {ffffff} - изменение места появления в игре.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/mywarn {ffffff} - список предупреждений.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/friends {ffffff} - список игнорируемых и Ваших друзей.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/b(1-5){ffffff} - настройки биндера.\n" ) ;

					show_dialog ( playerid, d_mm_cmd_list, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Общие команды", global_string, "Принять", "" ) ;
				}
				case 1:
				{
					switch ( p_info [ playerid ] [ job ] )
					{
						case job_taxi:
						{
							global_string [ 0 ] = EOS ;

                            strcat ( global_string, !"{"#cGN"}/tr {ffffff}- рация таксистов.\n" ) ;
							strcat ( global_string, !"{"#cGN"}/gotaxi [ID игрока] {ffffff}- принять вызов.\n" ) ;
							strcat ( global_string, !"{"#cGN"}/tpanel {ffffff}- панель таксиста.\n" ) ;
							strcat ( global_string, !"{"#cGN"}/taxi {ffffff}- начать работу.\n" ) ;
							strcat ( global_string, !"{"#cGN"}/end {ffffff}- завершить работу.\n" ) ;

							show_dialog ( playerid, d_mm_cmd_list, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Работы", global_string, "Принять", "" ) ;
							return 1 ;
						}
						case job_bus:
						{
							global_string [ 0 ] = EOS ;

                            strcat ( global_string, !"{"#cGN"}/tr {ffffff}- рация водителей автобусов.\n" ) ;
							strcat ( global_string, !"{"#cGN"}/route {ffffff}- начать работу.\n" ) ;
							strcat ( global_string, !"{"#cGN"}/end {ffffff}- завершить работу.\n" ) ;

							show_dialog ( playerid, d_mm_cmd_list, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Работы", global_string, "Принять", "" ) ;
							return 1 ;
						}
						case job_mechanic:
						{
							global_string [ 0 ] = EOS ;

                            strcat ( global_string, !"{"#cGN"}/tr {ffffff}- рация механиков.\n" ) ;
							strcat ( global_string, !"{"#cGN"}/gomechanic [ID игрока] {ffffff}- принять вызов.\n" ) ;
							strcat ( global_string, !"{"#cGN"}/fcontract {ffffff}- заключить контракт с АЗС.\n" ) ;
							strcat ( global_string, !"{"#cGN"}/refill [ID игрока] [бензин] [цена]{ffffff}- заправить машину игрока.\n" ) ;
							strcat ( global_string, !"{"#cGN"}/repair [ID игрока] [цена]{ffffff}- починить машину игрока.\n" ) ;
							strcat ( global_string, !"{"#cGN"}/mech {ffffff}- начать работу.\n" ) ;
							strcat ( global_string, !"{"#cGN"}/end {ffffff}- завершить работу.\n" ) ;

							show_dialog ( playerid, d_mm_cmd_list, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Работы", global_string, "Принять", "" ) ;
							return 1 ;
						}
						case job_trucker:
						{
							global_string [ 0 ] = EOS ;

							strcat ( global_string, !"{"#cGN"}/tskill {ffffff}- опыт дальнобойщика.\n" ) ;
							strcat ( global_string, !"{"#cGN"}/tpanel {ffffff}- панель дальнобойщика.\n" ) ;
							strcat ( global_string, !"{"#cGN"}/end {ffffff}- завершить работу.\n" ) ;

							show_dialog ( playerid, d_mm_cmd_list, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Работы", global_string, "Принять", "" ) ;
							return 1 ;
						}
						case job_delivery:
						{
							global_string [ 0 ] = EOS ;

                            strcat ( global_string, !"{"#cGN"}/tr {ffffff}- рация доставщиков.\n" ) ;
							strcat ( global_string, !"{"#cGN"}/delivery {ffffff}- панель доставки.\n" ) ;

							show_dialog ( playerid, d_mm_cmd_list, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Работы", global_string, "Принять", "" ) ;
							return 1 ;
						}
						case job_fuel_delivery:
						{
							global_string [ 0 ] = EOS ;

                            strcat ( global_string, !"{"#cGN"}/tr {ffffff}- рация доставщиков.\n" ) ;
							strcat ( global_string, !"{"#cGN"}/delivery {ffffff}- панель доставки.\n" ) ;

							show_dialog ( playerid, d_mm_cmd_list, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Работы", global_string, "Принять", "" ) ;
							return 1 ;
						}
						case job_incass:
						{
							global_string [ 0 ] = EOS ;

                            strcat ( global_string, !"{"#cGN"}/tr {ffffff}- рация инкассаторов.\n" ) ;
                            strcat ( global_string, !"{"#cGN"}/tpanel {ffffff}- панель инкассаторов.\n" ) ;
                            strcat ( global_string, !"{"#cGN"}/inviteinc {ffffff}- пригласить напарника.\n" ) ;

							show_dialog ( playerid, d_mm_cmd_list, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Работы", global_string, "Принять", "" ) ;
							return 1 ;
						}
						default:
						{
							show_playercommands ( playerid ) ;
							return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не работаете или для Вашей работы нет доступных команд." ) ;
						}
					}
				}
				case 2:
				{
					global_string [ 0 ] = EOS ;

					strcat ( global_string, !"{"#cGN"}/s [текст] {ffffff}- крикнуть.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/n [текст] {ffffff}- ООС чат. (Можно использовать ! в начале предложения)\n" ) ;
					strcat ( global_string, !"{"#cGN"}/me [текст] {ffffff}-  действия, эмоции персонажа (/me смеется).\n" ) ;
					strcat ( global_string, !"{"#cGN"}/do [текст] {ffffff}-  описание подробностей событий (/do в руках дубинка).\n" ) ;
					strcat ( global_string, !"{"#cGN"}/try [текст] {ffffff}- случайная вероятность действия (/try увернулся от удара).\n" ) ;
					strcat ( global_string, !"{"#cGN"}/todo [речь в чат*действие] {ffffff}- действие вместе с фразой персонажа.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/w [текст] {ffffff}- говорить шёпотом.\n" ) ;

					show_dialog ( playerid, d_mm_cmd_list, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Общение (чаты)", global_string, "Принять", "" ) ;
				}
				case 3:
				{
					global_string [ 0 ] = EOS ;

					strcat ( global_string, !"{"#cGN"}/hmenu {ffffff}- меню управления домом.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/hradio {ffffff}- управление аудио системой.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/hlock {ffffff}- открыть/закрыть дом.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/exit {ffffff}- выйти из дома.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/cellar {ffffff}- зайти в подвал.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/garage {ffffff}- зайти в гараж.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/hleave {ffffff}- выселиться из дома (для арендаторов).\n" ) ;
					strcat ( global_string, !"{"#cGN"}/hrent {ffffff}- меню дома (для арендаторов).\n" ) ;
					strcat ( global_string, !"{"#cGN"}/home {ffffff}- найти свой дом.\n" ) ;

					show_dialog ( playerid, d_mm_cmd_list, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Дом", global_string, "Принять", "" ) ;
				}
				case 4:
				{
					global_string [ 0 ] = EOS ;

					strcat ( global_string, !"{"#cGN"}/bpanel {ffffff}- меню управления бизнесом.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/bc {ffffff}- чат бизнеса.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/brank {ffffff}- изменить должность игрока.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/binvite [ID игрока] {ffffff}- принять игрока на работу.\n" ) ;
					strcat ( global_string, !"{"#cGN"}/buninvite [ID игрока] {ffffff}- уволить игрока.\n" ) ;

					show_dialog ( playerid, d_mm_cmd_list, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Бизнес и АЗС", global_string, "Принять", "" ) ;
				}
				case 5:
				{
					if ( radio_player ( playerid ) )
					{
						global_string [ 0 ] = EOS ;

						strcat ( global_string, !"{"#cGN"}/r {FFFFFF}- рация.\n" ) ;
						strcat ( global_string, !"{"#cGN"}/rn {FFFFFF}- non-rp(ooc) рация.\n" ) ;
						strcat ( global_string, !"{"#cGN"}/find {FFFFFF}- онлайн организации.\n" ) ;
						strcat ( global_string, !"{"#cGN"}/edit {ffffff}- редактировать объявления.\n" ) ;
						strcat ( global_string, !"{"#cGN"}/ether {ffffff}- войти в эфир.\n" ) ;
						strcat ( global_string, !"{"#cGN"}/cas [цена звонка]{ffffff} - Включить принятие звонков.\n" ) ;
						strcat ( global_string, !"{"#cGN"}/incas [ID игрока]{ffffff} - Принять звонок радиослушателя.\n" ) ;
						strcat ( global_string, !"{"#cGN"}/uncas [ID игрока]{ffffff} - Отключить радиослушателя от эфира.\n" ) ;
						strcat ( global_string, !"{"#cGN"}/offcas{ffffff} - Отключить принятие звонков.\n" ) ;
						strcat ( global_string, !"{"#cGN"}/numether{ffffff} - Установить номер прямого эфира.\n" ) ;
						strcat ( global_string, !"{"#cGN"}/nmenu{ffffff} - Панель управления радиоцентра.\n" ) ;
						strcat ( global_string, !"{"#cGN"}/fwarn [ID игрока] [причина] {ffffff}- выдать выговор члену организации.\n" ) ;
						strcat ( global_string, !"{"#cGN"}/funwarn [ID игрока] {ffffff}- снять выговор члену организации.\n" ) ;
						strcat ( global_string, !"{"#cGN"}/fmute [ID игрока] [минуты] [причина] {ffffff}- выдать затычку члену организации.\n" ) ;
						strcat ( global_string, !"{"#cGN"}/funmute [ID игрока] {ffffff}- снять затычку члену организации.\n" ) ;
						strcat ( global_string, !"{"#cGN"}/uinvite {ffffff}- принять в подразделение.\n" ) ;
						strcat ( global_string, !"{"#cGN"}/uuninvite {ffffff}- уволить из подразделения.\n" ) ;
						strcat ( global_string, !"{"#cGN"}/ufind {ffffff}- онлайн подразделения.\n" ) ;
						strcat ( global_string, !"{"#cGN"}/uoffmembers {ffffff}- оффлайн подразделения.\n" ) ;

						strcat ( global_string, !"\n{"#cBL"}** Тренировочный комплекс **\n\n" ) ;

						strcat ( global_string, !"{"#cGN"}/tren_menu {FFFFFF}- меню управления тренировкой.\n" ) ;
						strcat ( global_string, !"{"#cGN"}/trmembers {FFFFFF}- онлайн участников тренировки.\n" ) ;
						strcat ( global_string, !"{"#cGN"}/trsetteam {FFFFFF}- установить команду.\n" ) ;
