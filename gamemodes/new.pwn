			if ( _value < 18 || _value > 32 )
			{
				show_dialog ( playerid, d_donate_age, DIALOG_STYLE_INPUT, "{"#cBHD"}Донат услуги","{"#cRD"}* Вы ввели некорректный возраст персонажа.\n\n{"#cGRDialog"}- {"#cWH"}Смена игрового возраста:\n\n{"#cGRDialog"}* Цена: {"#cGN"}50 "donate_title"{"#cGRDialog"}.\n{"#cGRDialog"}* Вы действительно хотите сменить Ваш \"{"#cWH"}Возраст{"#cGRDialog"}\"?","Принять", "Назад");
				return 1 ;
			}

			new query_string [ 128 ] ;
			mysql_format ( sql_connection, query_string, sizeof ( query_string ),"UPDATE `users` SET `u_age` = '%d' WHERE `u_id` = '%d' LIMIT 1", _value, p_info [ playerid ] [ id ] ) ;
			mysql_tquery ( sql_connection, query_string ) ;

