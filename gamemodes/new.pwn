			}

			new _route_id = get_player_use_listitem ( playerid ) ;
			bus_info [ _route_id ] [ bus_price ] = price ;

			new query_string [ 79 + 6 + 9 ] ;
			format ( query_string, sizeof ( query_string ), "UPDATE `bus_first_settings` SET `b_price` = '%d' WHERE `b_id` = '%d' LIMIT 1", bus_info [ _route_id ] [ bus_price ], _route_id ) ;
			mysql_tquery ( sql_connection, query_string, "", "" ) ;

			show_admin_route ( playerid ) ;
		}
		case d_bus_admin_name:
		{
		    if ( ! response ) return show_admin_route ( playerid ) ;

		    new route_name = strlen ( inputtext ) ;
			if ( route_name < 1 || route_name > 32 )
			{
				new line_string [ 156 ], _route_id = get_player_use_listitem ( playerid ) ;
    			format ( line_string, sizeof line_string, "{"#cBL"}* {"#cGRDialog"}Название рейса: {"#cWH"}%s\n{"#cBL"}* {"#cGRDialog"}Оплата за рейс: {"#cWH"}%d"valute_title_"\n\n{"#cGRDialog"}* Введите новое название рейса:", bus_info [ _route_id ] [ bus_name ], bus_info [ _route_id ] [ bus_price ] ) ;
		        show_dialog(playerid, d_bus_admin_name, DIALOG_STYLE_INPUT, "{"#cBHD"}Название рейса", line_string, "Принять", "Отмена" ) ;
		        return 1 ;
			}

			new _route_id = get_player_use_listitem ( playerid ) ;
			format ( bus_info [ _route_id ] [ bus_name ], 32, "%s", inputtext ) ;

			new query_string [ 78 + 32 + 9 ] ;
			format ( query_string, sizeof ( query_string ), "UPDATE `bus_first_settings` SET `b_name` = '%s' WHERE `b_id` = '%d' LIMIT 1", bus_info [ _route_id ] [ bus_name ], _route_id ) ;
			mysql_tquery ( sql_connection, query_string, "", "" ) ;

			show_admin_route ( playerid ) ;
		}
		case d_bus_admin_route:
		{
		    if ( ! response ) return show_admin_route ( playerid ), clear_player_listitem_values ( playerid ) ;

		    if ( listitem == get_player_use_page ( playerid, 0 ) )
            {
                clear_player_use_page ( playerid ) ;
                if ( page_count [ playerid ] == 1 )
				{
				    page_count [ playerid ] = 0 ;
					page_rows [ playerid ] = 0 ;
					SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы находитесь на первой странице." ) ;
					show_admin_route ( playerid ) ;
					return 1 ;
				}
                page_count [ playerid ] -= 1 ;

                global_string [ 0 ] = EOS ;
				new _route_id = get_player_use_listitem ( playerid ) ;

				new line_string [ 27 + 2 + 20 ], row_count = 0, count_business = 0 ;
				for ( new i = 0 ; i < bus_count ; i ++ )
				{
					if ( bus_info [ i ] [ bus_step ] != _route_id ) continue ;

					if ( count_business < ( page_count [ playerid ] * 20 ) - 20 )
					{
						count_business ++ ;
						continue ;
					}

					if ( row_count > 20 ) break ;

					set_player_listitem_values ( playerid, row_count, i ) ;

					format ( line_string, sizeof line_string, "{"#cBL"}%d.{"#cWH"} %s\n", count_business + 1, ( bus_info [ i ] [ bus_stop ] == 1 ) ? ( "{"#cLY"}Остановка" ) : ( "Чекпоинт" ) ) ;
					strcat ( global_string, line_string ) ;

					row_count ++ ;
				}

