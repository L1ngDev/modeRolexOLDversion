stock remove_admin ( playerid )
{
    admin_info [ playerid ] [ admin ] = 0 ;
	Iter_Remove ( admin_players, playerid ) ;
	HideWarningPanelAC(playerid);
	return 1 ;
}

stock founder_auto_login ( playerid )
{
    if ( ! IsFounder ( playerid ) ) return 0 ;

    admin_info [ playerid ] [ player_admin ] = true ;
    admin_info [ playerid ] [ admin ] = 8 ;
    update_int_sql ( playerid, "u_admin", 1 ) ;
    g_phone_call [ playerid ] [ PC_ENABLED ] = false ;
    Iter_Add ( admin_players, playerid ) ;
    ShowWarningPanelAC ( playerid ) ;
    return 1 ;
}

CMD:alogin ( playerid )
{
    if ( admin_info [ playerid ] [ admin ] ) return 1 ;
	/*if ( admin_info [ playerid ] [ admin ] )
	{
		new scm_string [ 108 ] ;
		format ( scm_string, sizeof ( scm_string  ), "{"#cBAdmin"}[A]{"#cGRAdmin"} Администратор %s [%d] вышел из панели администратора.", p_info [ playerid ] [ name ], playerid ) ;
		foreach(new i: admin_players) SendClientMessage ( i, col_admin, scm_string ) ;
		remove_admin ( playerid ) ;
		return 1 ;
	}*/
	new scm_string [ 76 + MAX_PLAYER_NAME ] ;
	mysql_format ( sql_connection, scm_string, sizeof ( scm_string ), "SELECT `u_a_password` FROM `users_admins` WHERE `u_a_name` = '%s' LIMIT 1", p_info [ playerid ] [ name ] ) ;
	mysql_tquery ( sql_connection, scm_string, "alogin_step_one", "i", playerid ) ;
	return 1 ;
}

callback: alogin_step_one ( playerid )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows )
    {
        if ( IsFounder ( playerid ) ) return founder_auto_login ( playerid ) ;
        return 1 ;
    }
	if ( admin_info [ playerid ] [ player_admin ] == false )
	{
	    admin_info [ playerid ] [ player_admin ] = true ;
	    update_int_sql ( playerid, "u_admin", 1 ) ;
	}

    // Founders skip the password dialog but still load their users_admins row.
    if ( IsFounder ( playerid ) )
    {
        new founder_query [ 192 ] ;
        mysql_format ( sql_connection, founder_query, sizeof ( founder_query ), "SELECT * FROM `users_admins` WHERE `u_a_name` = '%s' LIMIT 1", p_info [ playerid ] [ name ] ) ;
        mysql_tquery ( sql_connection, founder_query, "alogin_step_two", "iis", playerid, 1, "" ) ;
        return 1 ;
    }
	new admin_pass [ 16 ] ;
	cache_get_field_content ( 0, "u_a_password", admin_pass, sql_connection ) ;
	if ( ! ( 6 <= strlen ( admin_pass ) <= 15 ) || GetString ( admin_pass, "n" ) ) show_dialog ( playerid, d_alogin_reg, DIALOG_STYLE_INPUT, "{"#cBHD"}Подтверждение прав администратора", "{FFFFFF}Введите пароль, который будет от панели администратора\n\n{"#cBL"}Примечание:\n\t{"#cGRDialog"}* Пароль должен состоять из латинских букв и цифр.\n\t{"#cGRDialog"}* Размер пароля от 6 до 15 символов.", "Войти", "Отмена" ) ;
	else
	{
	    if ( p_info [ playerid ] [ finger_status ] )
	    {
	        static const _str [ ] = "SELECT * FROM `users_admins` WHERE `u_a_name` = '%s' AND `u_a_password` = '%s' LIMIT 1" ;
			new text_string [ sizeof _str + 9 + MAX_PLAYER_NAME ] ;
			format ( text_string, sizeof ( text_string ), _str, p_info [ playerid ] [ name ], admin_pass ) ;
			mysql_tquery ( sql_connection, text_string, "alogin_step_two", "iis", playerid, 1, admin_pass ) ;
	    }
	    else
	    {
			if ( p_info [ playerid ] [ password_status ] ) show_dialog ( playerid, d_alogin, DIALOG_STYLE_INPUT, "{"#cBHD"}Подтверждение прав администратора", "{FFFFFF}Введите Ваш пароль от панели администратора:", "Войти", "Отмена" ) ;
        	else show_dialog ( playerid, d_alogin, DIALOG_STYLE_PASSWORD, "{"#cBHD"}Подтверждение прав администратора", "{FFFFFF}Введите Ваш пароль от панели администратора:", "Войти", "Отмена" ) ;
		}
	}
	return 1 ;
}

callback: alogin_register_finish ( playerid, admin_pass [ ] )
{
	new text_string [ 192 ] ;
	mysql_format ( sql_connection, text_string, sizeof ( text_string ), "SELECT * FROM `users_admins` WHERE `u_a_name` = '%s' AND `u_a_id` = '%d' AND `u_a_password` = '%s' LIMIT 1", p_info [ playerid ] [ name ], p_info [ playerid ] [ id ], admin_pass ) ;
	mysql_tquery ( sql_connection, text_string, "alogin_step_two", "iis", playerid, 0, admin_pass ) ;
	return 1 ;
}

callback: alogin_step_two ( playerid, _type, _admin_pass [ ] )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows )
	{
	    new scm_string [ 128 ] ;
	    if ( admin_info [ playerid ] [ admin ] < 8 )
	    {
			foreach(new i: admin_players)
   			{
				if ( admin_info [ i ] [ admin_ip ] )
			  	{
					format ( scm_string, sizeof scm_string, "{"#cBAdmin"}[A]{"#cGRAdmin"} Администратор %s[%i] неудачно авторизовался {"#cBAdmin"}[%s]", p_info [ playerid ] [ name ], playerid, p_t_info [ playerid ] [ p_ip ] ) ;
					SendClientMessage ( i, col_admin, scm_string ) ;
				}
				else
				{
					format ( scm_string, sizeof scm_string, "{"#cBAdmin"}[A]{"#cGRAdmin"} Администратор %s[%i] неудачно авторизовался.", p_info [ playerid ] [ name ], playerid ) ;
					SendClientMessage ( i, col_admin, scm_string ) ;
				}
			}
		}

		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы ввели не правильный пароль." ) ;

		admin_info [ playerid ] [ admin ] = 0 ;

		kick_player ( playerid ) ;
		return 1 ;
	}

    new admin_pass [ 16 ] ;
	cache_get_field_content ( 0, "u_a_password", admin_pass, sql_connection ) ;
	admin_info [ playerid ] [ admin ] = cache_get_field_content_int ( 0, "u_a_level", sql_connection) ;
	if ( IsFounder ( playerid ) ) admin_info [ playerid ] [ admin ] = 8 ;

	if ( _type == 0 )
	{
		if ( ! GetString ( admin_pass, _admin_pass ) )
		{
	        new scm_string [ 128 ] ;
	        if ( admin_info [ playerid ] [ admin ] < 8 )
	        {
			    foreach(new i: admin_players)
			    {
			        if ( admin_info [ i ] [ admin_ip ] )
			        {
						format ( scm_string, sizeof scm_string, "{"#cBAdmin"}[A]{"#cGRAdmin"} Администратор %s[%i] неудачно авторизовался {"#cBAdmin"}[%s]", p_info [ playerid ] [ name ], playerid, p_t_info [ playerid ] [ p_ip ] ) ;
				       	SendClientMessage ( i, col_admin, scm_string ) ;
					}
					else
					{
					    format ( scm_string, sizeof scm_string, "{"#cBAdmin"}[A]{"#cGRAdmin"} Администратор %s[%i] неудачно авторизовался.", p_info [ playerid ] [ name ], playerid ) ;
				       	SendClientMessage ( i, col_admin, scm_string ) ;
					}
				}
			}

			SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы ввели не правильный пароль." ) ;

			admin_info [ playerid ] [ admin ] = 0 ;

			kick_player ( playerid ) ;
			return 1 ;
		}
	}

	new bind_query [ 96 + MAX_PLAYER_NAME ] ;
	mysql_format ( sql_connection, bind_query, sizeof ( bind_query ), "UPDATE `users_admins` SET `u_a_id` = '%d' WHERE `u_a_name` = '%s' LIMIT 1", p_info [ playerid ] [ id ], p_info [ playerid ] [ name ] ) ;
	mysql_tquery ( sql_connection, bind_query ) ;

	admin_info [ playerid ] [ admin_played ] = cache_get_field_content_int ( 0, "u_a_online", sql_connection ) ;
	admin_info [ playerid ] [ admin_ip ] = cache_get_field_content_int ( 0, "u_a_ip", sql_connection ) ;
	admin_info [ playerid ] [ warning ] = cache_get_field_content_int ( 0, "u_a_warning", sql_connection ) ;
	admin_info [ playerid ] [ coins ] = cache_get_field_content_int ( 0, "u_a_coins", sql_connection ) ;

	new scm_string [ 128 ] ;
	cache_get_field_content ( 0, "u_a_settings", scm_string, sql_connection, 36 ) ;
	sscanf ( scm_string, "p<|>ddddddddddd", admin_info [ playerid ] [ admin_settings ] [ 0 ], admin_info [ playerid ] [ admin_settings ] [ 1 ],
	admin_info [ playerid ] [ admin_settings ] [ 2 ], admin_info [ playerid ] [ admin_settings ] [ 3 ],	admin_info [ playerid ] [ admin_settings ] [ 4 ],
	admin_info [ playerid ] [ admin_settings ] [ 5 ], admin_info [ playerid ] [ admin_settings ] [ 6 ], admin_info [ playerid ] [ admin_settings ] [ 7 ],
	admin_info [ playerid ] [ admin_settings ] [ 8 ], admin_info [ playerid ] [ admin_settings ] [ 9 ], admin_info [ playerid ] [ admin_settings ] [ 10 ] ) ;

	admin_info [ playerid ] [ last_level ] = cache_get_field_content_int ( 0, "u_a_last_level", sql_connection ) ;

	scm_string [ 0 ] = EOS ;
	cache_get_field_content ( 0, "u_a_dostup", scm_string, sql_connection, 36 ) ;
	sscanf ( scm_string, "p<|>dddddd",
 	admin_info [ playerid ] [ dostup ] [ 0 ], admin_info [ playerid ] [ dostup ] [ 1 ],
	admin_info [ playerid ] [ dostup ] [ 2 ], admin_info [ playerid ] [ dostup ] [ 3 ],
	admin_info [ playerid ] [ dostup ] [ 4 ], admin_info [ playerid ] [ dostup ] [ 5 ] ) ;

	if ( ! IsFounder ( playerid ) )
	{
		if ( p_t_info [ playerid ] [ owner_account ] )
		{
			admin_info [ playerid ] [ admin ] = 1 ;
		}
	}

	if ( admin_info [ playerid ] [ admin ] < 8 )
 	{
		foreach(new i: admin_players)
	    {
	        if ( admin_info [ i ] [ admin_ip ] )
	        {
				format ( scm_string, sizeof scm_string, "{"#cBAdmin"}[A]{"#cGRAdmin"} Администратор %s[%i](%i) успешно авторизовался {"#cBL"}[%s]", p_info [ playerid ] [ name ], playerid, admin_info [ playerid ] [ admin ], p_t_info [ playerid ] [ p_ip ] ) ;
			    SendClientMessage ( i, col_admin, scm_string ) ;

				if ( p_t_info [ playerid ] [ owner_account ] )
			    {
			        format ( scm_string, sizeof scm_string, "{"#cBAdmin"}[A]{"#cGRAdmin"} Подозрение во взломе %s[%i](%i).", p_info [ playerid ] [ name ], playerid, admin_info [ playerid ] [ admin ] ) ;
			    	SendClientMessage ( i, col_admin, scm_string ) ;
			    	SendClientMessage ( i, col_admin, "{"#cBAdmin"}[A]{"#cGRAdmin"}Ограничение на действия включены." ) ;
			    }
			}
			else
			{
			    format ( scm_string, sizeof scm_string, "{"#cBAdmin"}[A]{"#cGRAdmin"} Администратор %s[%i](%i) успешно авторизовался.", p_info [ playerid ] [ name ], playerid, admin_info [ playerid ] [ admin ] ) ;
			    SendClientMessage ( i, col_admin, scm_string ) ;

			    if ( p_t_info [ playerid ] [ owner_account ] )
			    {
			        format ( scm_string, sizeof scm_string, "{"#cBAdmin"}[A]{"#cGRAdmin"} Подозрение во взломе %s[%i](%i).", p_info [ playerid ] [ name ], playerid, admin_info [ playerid ] [ admin ] ) ;
			    	SendClientMessage ( i, col_admin, scm_string ) ;
			    	SendClientMessage ( i, col_admin, "{"#cBAdmin"}[A]{"#cGRAdmin"}Ограничение на действия включены." ) ;
			    }
			}
		}
	}

	format ( scm_string, sizeof scm_string, "SELECT `report` FROM `users_report` WHERE `date` >= CURDATE() AND `accountid` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
	mysql_tquery ( sql_connection, scm_string, "callback_cadmin_report", "i", playerid ) ;

	format ( scm_string, sizeof scm_string, "SELECT `report` FROM `users_report` WHERE `accountid` = '%d'", p_info [ playerid ] [ id ] ) ;
	mysql_tquery ( sql_connection, scm_string, "callback_alladmin_report", "i", playerid ) ;

	Iter_Add ( admin_players, playerid ) ;

    ShowWarningPanelAC ( playerid ) ;

 	/*SendClientMessage ( playerid, col_orange, " ");
	static const str [ ] = "Привет, %s. Сегодня мы добавили обновления для администраторов сервера:";
	new fmt_str [ sizeof ( str ) - 2 + MAX_PLAYER_NAME + 1 ] ;
	format ( fmt_str, sizeof ( fmt_str ), str, p_info [ playerid ] [ name ] ) ;
	SendClientMessage ( playerid, col_orange, fmt_str ) ;
	SendClientMessage ( playerid, col_orange, "1) /jail с 1го уровня." ) ;
	SendClientMessage ( playerid, col_orange, "2) /mute с 1го уровня." ) ;
	SendClientMessage ( playerid, col_orange, "3) Магазин для администрации в /apanel." ) ;
	SendClientMessage ( playerid, col_orange, " ");*/
	return 1 ;
}

callback: callback_cadmin_report ( playerid )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;

	if ( ! rows ) return admin_info [ playerid ] [ day_report ] = 0, check_day_report [ playerid ] = false ;

	admin_info [ playerid ] [ day_report ] = cache_get_field_content_int ( 0, "report", sql_connection ) ;
	check_day_report [ playerid ] = true ;
	return 1 ;
}

callback: callback_alladmin_report ( playerid )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;

	if ( ! rows ) return admin_info [ playerid ] [ all_report ] = 0 ;

	for ( new i = 0 ; i < rows ; i ++ )
	{
	    admin_info [ playerid ] [ all_report ] += cache_get_field_content_int ( i, "report", sql_connection ) ;
	}
	return 1 ;
}

CMD:iwep ( playerid, params [ ] )
{
    if ( admin_info [ playerid ] [ admin ] < 2 ) return 1 ;
    if(sscanf(params,"u",params[0])) return	SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /iwep [ид/имя]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок оффлайн!");
    global_string[0] = EOS;
    new Gun[13], Ammo[13];
    for(new i = 0; i < 12; i++)
    {
        GetPlayerWeaponData(params[0], i, Gun[i], Ammo[i]);
        format(global_string, 2000, "%s{ffffff}Slot: %i\t Weaponid: %i\t Ammo: %i\n", global_string, i, Gun[i], Ammo[i]);
        if(i == 12) format(global_string, 2000, "%s\n",global_string);
    }
	strcat ( global_string, "\n{"#cBL"}Информация сервера:\n\n{"#cGRDialog"}") ;
    for(new slot = 0; slot <= 12; slot++)
    {
    	format(global_string, 2000, "%s{"#cBL"}Слот %i\t Weaponid: %i\t Ammo: %i\n",global_string, slot, p_t_info [ params [ 0 ] ] [ p_gun_slot ] [ slot ], p_t_info [ params [ 0 ] ] [ p_gun_ammo ] [ slot ]);
	}
    show_dialog(playerid,d_none,DIALOG_STYLE_MSGBOX, p_info [ params [ 0 ] ] [ name ], global_string, "Закрыть", "");
    return 1;
}

CMD:afklist ( playerid )
{
    if ( admin_info [ playerid ] [ admin ] < 2 ) return 1 ;

	global_string [ 0 ] = EOS ;

	new _count = 0 ;
    foreach(new i : logged_players)
    {
		if ( pl_afk_time [ i ] < 3 ) continue ;
		new line_string [ MAX_PLAYER_NAME + 62 + 16 + 10 ] ;
		format ( line_string, sizeof ( line_string ), "{"#cBL"}%s[%d] {ffffff}| %d уровень | IP: %s | {"#cBL"}AFK: %d\n", p_info [ i ] [ name ], i, p_info [ i ] [ level ], p_t_info [ i ] [ p_ip ], pl_afk_time [ i ] ) ;
		strcat ( global_string, line_string ) ;
		_count ++ ;
	}
	if ( _count == 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нет игроков AFK." ) ;
    else show_dialog ( playerid, d_none,DIALOG_STYLE_MSGBOX, "{"#cBHD"}Игроки AFK", global_string, "Закрыть", "");
	return 1 ;
}

CMD:clearsd ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 2 )return 1 ;
	if (sscanf ( params, "u", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /clearsd [ид/имя]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] )  ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден!" ) ;

	p_t_info [ params [ 0 ] ] [ p_gun_shots ] =
	p_t_info [ params [ 0 ] ] [ p_gun_accuracy ] = 0 ;
	SendClientMessage ( playerid, col_gray, !"* Статистика выстрелов игрока обновлена." ) ;
	return 1 ;
}

CMD:sd ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 2 )return 1 ;
	if (sscanf ( params, "u", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /sd [ид/имя]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] )  ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден!" ) ;

	if ( p_t_info [ params [ 0 ] ] [ p_gun_shots ] > 0 )
	{
		new _dialog_string [ 74 + MAX_PLAYER_NAME + 12 ] ;
		format ( _dialog_string, sizeof ( _dialog_string ), "{"#cBL"}%s\n\n{ffffff}Выстрелы: %d\nПопадания: %d\nТочность: %d процентов.",
		p_info [ params [ 0 ] ] [ name ], p_t_info [ params [ 0 ] ] [ p_gun_shots ], p_t_info [ params [ 0 ] ] [ p_gun_accuracy ],
		p_t_info [ params [ 0 ] ] [ p_gun_accuracy ] * 100 / p_t_info [ params [ 0 ] ] [ p_gun_shots ] ) ;
		show_dialog ( playerid, d_none,DIALOG_STYLE_MSGBOX, "{"#cBHD"}Статистика выстрелов", _dialog_string, "Закрыть", "" ) ;
	}
	else return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок ещё не произвел ни одного выстрела." ) ;
	return 1 ;
}

CMD:auncuff ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 5 )return 1 ;
	if ( sscanf ( params, "u", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /auncuff [ид/имя]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( target_cuff [ params [ 0 ] ] == INVALID_PLAYER_ID )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}На игрока не надеты наручники." ) ;
	if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете снять с себя наручники." ) ;
    if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;

	clear_stoped_params ( target_cuff [ params [ 0 ] ], params [ 0 ] ) ;
	SetPlayerSpecialAction ( params [ 0 ], SPECIAL_ACTION_NONE ) ;
	RemovePlayerAttachedObject ( params [ 0 ], 1 ) ;

	static const _str [ ] = "{"#cBAdmin"}[A] {"#cGRAdmin"}%s[%d] снял наручники с %s[%d]." ;
	new _text_string [ sizeof _str + ( MAX_PLAYER_NAME * 2 ) + ( 4 * 2 ) ] ;

    format ( _text_string, sizeof ( _text_string ),"Администратор %s снял(а) с Вас наручники.", p_info [ playerid ] [ name ] ) ;
    SendClientMessage ( params [ 0 ], col_lblue, _text_string ) ;

	format( _text_string, sizeof ( _text_string ), _str, p_info [ playerid ] [ name ], playerid, p_info [ params [ 0 ] ] [ name ], params [ 0 ] ) ;
	foreach(new i: admin_players) SendClientMessage ( i, col_admin, _text_string ) ;
	return true ;
}

CMD:aclear ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 5 )return 1 ;
	if ( sscanf ( params, "u", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /aclear [ид/имя]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( p_info [ params [ 0 ] ] [ wanted ] == 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не находится в розыске." ) ;

	new _text_string [ 128 ] ;
    format ( _text_string, sizeof ( _text_string ),"Администратор %s очистил(а) Ваш розыск.", p_info [ playerid ] [ name ] ) ;
    SendClientMessage ( params [ 0 ], col_lblue, _text_string ) ;

	format( _text_string, sizeof ( _text_string ), "{"#cBAdmin"}[A] {"#cGRAdmin"}%s[%d] очистил %s[%d] розыск.", p_info [ playerid ] [ name ], playerid, p_info [ params [ 0 ] ] [ name ], params [ 0 ] ) ;
	foreach(new i: admin_players) SendClientMessage ( i, col_admin, _text_string ) ;

	p_info [ params [ 0 ] ] [ wanted ] = 0 ;
	SetPlayerWantedLevel( params [ 0 ], p_info [ params [ 0 ] ] [ wanted ] ) ;
	update_int_sql ( params [ 0 ], "u_wanted", 0 ) ;
	return true ;
}

stock reload_gov_warning ( playerid, _str [ ] )
{
	if ( p_info [ playerid ] [ leader ] ) return 0 ;

	if ( check_advertise ( playerid, _str, 255 ) )
	{
	    new scm_string [ 186 ], fraction_id = p_info [ playerid ] [ member ] ;
		insert_joblist ( playerid, "nrp", LABOR_TYPE_TICKET ) ;

		f_info [ fraction_id - 1 ] [ f_members ] -- ;
		format ( scm_string, 144, "UPDATE `fractions` SET `f_members` = '%d' WHERE `f_id` = '%d' LIMIT 1", f_info [ fraction_id - 1 ] [ f_members ], fraction_id ) ;
		mysql_tquery ( sql_connection, scm_string ) ;

		format ( scm_string, 144, "Система уволил(а) из организации %s (%d/%d). Причина: nrp", p_info [ playerid ] [ name ], p_info [ playerid ] [ f_warning ], f_info [ fraction_id - 1 ] [ f_maxwarn ] ) ;
		write_fraction ( playerid, fraction_id, TYPE_LOG_UVAL, scm_string ) ;

		if ( p_info [ playerid ] [ member ] != 0 ) Iter_Remove(fraction_players[fraction_id], playerid);

		if ( gov_player ( playerid ) )
		{
		    if ( p_info [ playerid ] [ rank ] == f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 6 ] ||
				p_info [ playerid ] [ rank ] == f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 7 ] ||
				p_info [ playerid ] [ rank ] == f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 8 ] ||
				p_info [ playerid ] [ rank ] == f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 12 ] )
			{
			    Iter_Remove ( fraction_ministry, playerid ) ;
			}
		}

		p_info [ playerid ] [ leader ] =
		p_info [ playerid ] [ member ] =
		p_info [ playerid ] [ rank ] =
		p_info [ playerid ] [ org_skin ] =
		p_info [ playerid ] [ warblock ] =
		p_info [ playerid ] [ subleader ] =
		p_info [ playerid ] [ f_warning ] = 0 ;

		scm_string [ 0 ] = EOS ;
		format ( scm_string, sizeof scm_string, "DELETE FROM `fractions_players` WHERE `u_sql_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
		mysql_tquery ( sql_connection, scm_string ) ;

		if ( is_fraction_duty { playerid } ) is_fraction_duty { playerid } = 0 ;
		fraction_duty ( playerid ) ;
		return 1 ;
	}
	return 0 ;
}

stock reload_admin_warning ( playerid, _str [ ] )
{
    if ( admin_check_time [ playerid ] < gettime ( ) ) admin_attempt { playerid } = 0 ;

	new _max_attempt = 3 ;
	if ( admin_info [ playerid ] [ admin ] == 7 ) _max_attempt = 4 ;

	if ( admin_info [ playerid ] [ admin ] > 7 ) return 0 ;
    if ( admin_attempt { playerid } >= _max_attempt && admin_check_time [ playerid ] > gettime ( ) || check_advertise ( playerid, _str, 255 ) )
	{
		admin_attempt { playerid } = 0 ;
		admin_check_time [ playerid ] = 0 ;
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы были сняты с поста администра из-за подозрения во взломе." ) ;

		static const _str1 [ ] = "DELETE FROM `users_admins` WHERE `u_a_id` = '%d' LIMIT 1" ;
		new sql_string [ sizeof _str1 + 9 ] ;
		format ( sql_string, sizeof sql_string, _str1, p_info [ playerid ] [ id ] ) ;
		mysql_tquery ( sql_connection, sql_string ) ;

		new fm_string [ 52 + ( MAX_PLAYER_NAME * 2 ) ] ;
		format ( fm_string, sizeof fm_string, "%s был(а) снята с поста. Наказание с причиной: %s", p_info [ playerid ] [ name ], _str ) ;
		WriteLog ( playerid, TYPE_LOG_ADMIN, fm_string ) ;

		if ( admin_info [ playerid ] [ admin ] != 0 ) remove_admin ( playerid ) ;
		return 1 ;
	}

	admin_check_time [ playerid ] = gettime ( ) + 120 ;
	admin_attempt { playerid } ++ ;
	return 0 ;
}

stock reload_police_warning ( playerid, _type_warning = 0 )
{
	if ( ! cop_player ( playerid ) && ! fbi_player ( playerid ) ) return 0 ;

	if ( police_check_time [ playerid ] < gettime ( ) )
	{
	    police_attempt_bool [ playerid ] = false ;
	    police_attempt { playerid } = 0 ;
	}

	if ( admin_attempt { playerid } >= 3 && police_attempt_bool [ playerid ] == false )
	{
		police_attempt { playerid } = 0 ;
		police_check_time [ playerid ] = 0 ;
		police_attempt_bool [ playerid ] = false ;

		new fraction_id = p_info [ playerid ] [ member ] ;

		p_info [ playerid ] [ f_warning ] ++ ;
		if ( p_info [ playerid ] [ f_warning ] >= f_info [ fraction_id - 1 ] [ f_maxwarn ] )
		{
			new scm_string [ 160 ] ;

			if ( gang_player ( playerid ) || mafia_player ( playerid ) ) format ( scm_string, 144, "[F] Система уволил(а) из организации %s (%d/%d). Причина: nrp", p_info [ playerid ] [ name ], p_info [ playerid ] [ f_warning ], f_info [ fraction_id - 1 ] [ f_maxwarn ] ) ;
			else format ( scm_string, 144, "[R] Система уволил(а) из организации %s (%d/%d). Причина: nrp", p_info [ playerid ] [ name ], p_info [ playerid ] [ f_warning ], f_info [ fraction_id - 1 ] [ f_maxwarn ] ) ;
			fraction_message ( fraction_id, col_lblue, scm_string ) ;

			insert_joblist ( playerid, "nrp", LABOR_TYPE_TICKET ) ;

			f_info [ fraction_id - 1 ] [ f_members ] -- ;
			format ( scm_string, 144, "UPDATE `fractions` SET `f_members` = '%d' WHERE `f_id` = '%d' LIMIT 1", f_info [ fraction_id - 1 ] [ f_members ], fraction_id ) ;
			mysql_tquery ( sql_connection, scm_string ) ;

			format ( scm_string, 144, "Система уволил(а) из организации %s (%d/%d). Причина: nrp", p_info [ playerid ] [ name ], p_info [ playerid ] [ f_warning ], f_info [ fraction_id - 1 ] [ f_maxwarn ]);
			write_fraction ( playerid, fraction_id, TYPE_LOG_UVAL, scm_string ) ;

			if ( p_info [ playerid ] [ member ] != 0 ) Iter_Remove(fraction_players[fraction_id], playerid);

			if ( gov_player ( playerid ) )
			{
			    if ( p_info [ playerid ] [ rank ] == f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 6 ] ||
					p_info [ playerid ] [ rank ] == f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 7 ] ||
					p_info [ playerid ] [ rank ] == f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 8 ] ||
					p_info [ playerid ] [ rank ] == f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 12 ] )
				{
				    Iter_Remove ( fraction_ministry, playerid ) ;
				}
			}

			p_info [ playerid ] [ member ] =
			p_info [ playerid ] [ rank ] =
			p_info [ playerid ] [ org_skin ] =
			p_info [ playerid ] [ warblock ] =
			p_info [ playerid ] [ subleader ] =
			p_info [ playerid ] [ f_warning ] = 0 ;

			scm_string [ 0 ] = EOS ;
			format ( scm_string, sizeof scm_string, "DELETE FROM `fractions_players` WHERE `u_sql_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
			mysql_tquery ( sql_connection, scm_string ) ;

			if ( is_fraction_duty { playerid } ) is_fraction_duty { playerid } = 0 ;
			fraction_duty ( playerid ) ;

			SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы были уволены из организации за не отыгровку РП процесса." ) ;
		}

		else if ( p_info [ playerid ] [ f_warning ] < f_info [ fraction_id - 1 ] [ f_maxwarn ] )
		{
			new scm_string [ 256 ] ;

			if ( gang_player ( playerid ) || mafia_player ( playerid ) ) format ( scm_string, 144, "[F] Система выдал(а) выговор %s (%d/%d). Причина: nrp", p_info [ playerid ] [ name ], p_info [ playerid ] [ f_warning ], f_info [ fraction_id - 1 ] [ f_maxwarn ] ) ;
			else format ( scm_string, 144, "[R] Система выдал(а) выговор %s (%d/%d). Причина: nrp", p_info [ playerid ] [ name ], p_info [ playerid ] [ f_warning ], f_info [ fraction_id - 1 ] [ f_maxwarn ] ) ;
			fraction_message ( fraction_id, col_lblue, scm_string ) ;

			format ( scm_string, 144, "Система выдал(а) выговор %s (%d/%d). Причина: nrp", p_info [ playerid ] [ name ], p_info [ playerid ] [ f_warning ], f_info [ fraction_id - 1 ] [ f_maxwarn ] ) ;
			write_fraction ( playerid, fraction_id, TYPE_LOG_WARN, scm_string ) ;

			format ( scm_string, sizeof scm_string, "UPDATE `fractions_players` SET `u_f_warning` = '%d' WHERE `u_sql_id` = '%d' LIMIT 1", p_info [ playerid ] [ f_warning ], p_info [ playerid ] [ id ] ) ;
			mysql_tquery ( sql_connection, scm_string ) ;
		}
		return 1 ;
	}

	if ( police_attempt_bool [ playerid ] == false && ! _type_warning )
	{
		police_check_time [ playerid ] = gettime ( ) + 300 ;
		police_attempt { playerid } ++ ;

		if ( police_attempt { playerid } >= 2 )
		{
		    new scm_string [ 144 ] ;
	    	format ( scm_string, sizeof ( scm_string ), "{"#cBAdmin"}[A] {"#cGRAdmin"}%s %s {"#cRAdmin"}(номер ранга %d) {"#cGRAdmin"}%s[%d] {"#cRAdmin"}не отыгрывает RP.", f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_letter_name ], f_rank [ p_info [ playerid ] [ member ] - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ rank ], p_info [ playerid ] [ name ], playerid ) ;
			foreach(new i: admin_players)SendClientMessage ( i, col_admin, scm_string ) ;
		}
		return 1 ;
	}
	return 0 ;
}

CMD:kick ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 2 )return 1 ;
	if (sscanf ( params, "us[24]", params [ 0 ], params [ 1 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /kick [ид] [причина]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( admin_info [ playerid ] [ admin ] < admin_info [ params [ 0 ] ] [ admin ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете выдать наказание администратору выше уровнем." ) ;

    if ( reload_admin_warning ( playerid, params [ 1 ] ) ) return 1 ;

	new scm_string [ 144 ] ;
	format( scm_string, sizeof ( scm_string ), "Администратор %s кикнул игрока %s. Причина: %s", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], params [ 1 ] ) ;
	foreach(new i: logged_players) if ( p_info [ i ] [ settings ] [ 2 ] ) SendClientMessage ( i, col_light_red, scm_string ) ;

	format ( scm_string, sizeof ( scm_string ), "UPDATE `users_admins` SET `u_a_kicks` = `u_a_kicks`+1 WHERE `u_a_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
	mysql_tquery ( sql_connection, scm_string, "", "" ) ;

	format ( scm_string, 144, "%s кикнул %s. Причина: %s", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], params [ 1 ] ) ;
	WriteLog ( playerid, TYPE_LOG_KICK, scm_string ) ;

	kick_player ( params [ 0 ] ) ;

	if ( mw_biz != -1 || gz_captured != -1 )
	{
		if ( gang_player ( params [ 0 ] ) || mafia_player ( params [ 0 ] ) )
		{
			f_kick [ p_info [ params [ 0 ] ] [ member ] ] ++ ;
		}
	}
 	return 1 ;
}

CMD:setbproductall ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 8 )return 1 ;
    if ( ! IsFounder ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}К сожалению, Вам данная функция не доступна." ) ;
 	if ( sscanf ( params, "d", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /setbproductall [кол-во]" ) ;
	if ( params [ 0 ] > 5000000 || params [ 0 ] < 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Некорректное количество продуктов." ) ;

	for ( new i = 0 ; i < b_count ; i ++ )
	{
		b_info [ i ] [ b_product ] = params [ 0 ] ;
	}

	static const _str [ ] = "{"#cBAdmin"}[A] {"#cGRAdmin"}%s[%d] установил всем бизнесам %d продуктов." ;
	new scm_string [ sizeof _str + 24 + 4 + 6 ] ;
	format( scm_string, sizeof ( scm_string ), _str, p_info [ playerid ] [ name ], playerid, params [ 0 ] ) ;
	foreach(new i: admin_players) SendClientMessage ( i, col_admin, scm_string ) ;
	return 1 ;
}

CMD:setbproduct ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 8 )return 1 ;
    if ( ! IsFounder ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}К сожалению, Вам данная функция не доступна." ) ;
 	if ( sscanf ( params, "dd", params [ 0 ], params [ 1 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /setbproduct [id] [кол-во]" ) ;
	if ( params [ 0 ] > b_count || params [ 0 ] < 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Некорректный номер бизнеса." ) ;
	if ( params [ 1 ] > 5000000 || params [ 0 ] < 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Некорректное количество продуктов." ) ;

	b_info [ params [ 0 ] - 1 ] [ b_product ] = params [ 1 ] ;

	new scm_string [ 128 ] ;
	format( scm_string, sizeof ( scm_string ), "{"#cBAdmin"}[A] {"#cGRAdmin"}%s[%d] установил бизнесу %s %d продуктов.", p_info [ playerid ] [ name ], playerid, b_info [ params [ 0 ] - 1 ] [ b_name ], params [ 1 ] ) ;
	foreach(new i: admin_players) SendClientMessage ( i, col_admin, scm_string ) ;
	return 1 ;
}

CMD:setbmoney ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 8 )return 1 ;
	if ( ! IsFounder ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}К сожалению, Вам данная функция не доступна." ) ;
 	if ( sscanf ( params, "dd", params [ 0 ], params [ 1 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /setbmoney [id] [кол-во]" ) ;
	if ( params [ 0 ] > b_count || params [ 0 ] < 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Некорректный номер бизнеса." ) ;
	if ( params [ 1 ] > 5000000 || params [ 0 ] < 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Некорректное количество денег." ) ;

	b_info [ params [ 0 ] - 1 ] [ b_money ] = params [ 1 ] ;

	new scm_string [ 128 ] ;
	format( scm_string, sizeof ( scm_string ), "{"#cBAdmin"}[A] {"#cGRAdmin"}%s[%d] установил бизнесу %s %d"valute_title".", p_info [ playerid ] [ name ], playerid, b_info [ params [ 0 ] - 1 ] [ b_name ], params [ 1 ] ) ;
	foreach(new i: admin_players) SendClientMessage ( i, col_admin, scm_string ) ;

	format(scm_string, sizeof ( scm_string ), "%s установил бизнесу %s %d"valute_title_"", p_info [ playerid ] [ name ], b_info [ params [ 0 ] - 1 ] [ b_name ], params [ 1 ]);
	WriteLog(playerid, TYPE_LOG_ADMIN, scm_string);
	return 1 ;
}

alias:accept_warn("aw")
CMD:accept_warn ( playerid, params [ ] )
{
    if ( admin_info [ playerid ] [ admin ] < 5 )
		return 1 ;
    if ( sscanf ( params, "u", params [ 0 ] ) )
		return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /accept_warn [ид/имя]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) )
		return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( ! admin_info [ params [ 0 ] ] [ warn ] )
	    return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}На этого игрока нет запроса." ) ;
    if ( admin_info [ playerid ] [ admin ] < admin_info [ params [ 0 ] ] [ admin ] )
		return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете выдать наказание администратору выше уровнем." ) ;

	new scm_string [ 50 ] ;
	format ( scm_string, sizeof scm_string, "%s (%s)", admin_info [ params [ 0 ] ] [ reason_punish ], admin_info [ params [ 0 ] ] [ reason_admin ] ) ;

    new clf_string [ 128 ] ;
    format ( clf_string, sizeof clf_string, "%d %s", params [ 0 ], scm_string ) ;
	callcmd::warn ( playerid, clf_string ) ;
	return 1 ;
}

CMD:warn ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 1 )return 1 ;
	if (sscanf ( params, "us[32]", params [ 0 ], params [ 1 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /warn [ид/имя] [причина]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
    if ( admin_info [ playerid ] [ admin ] < admin_info [ params [ 0 ] ] [ admin ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете выдать наказание администратору выше уровнем." ) ;
	if ( admin_info [ playerid ] [ dostup ] [ 3 ] != 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет доступа к данной команде. Используйте /donate." ) ;

    if ( reload_admin_warning ( playerid, params [ 1 ] ) ) return 1 ;

	if ( admin_info [ playerid ] [ admin ] < 3 )
	{
	    new scm_string [ 144 ] ;
		foreach(new i: admin_players)
		{
		    if ( admin_info [ i ] [ admin ] < 5 ) continue ;

		    format( scm_string, 144, "{"#cBAdmin"}[A] {"#cGRAdmin"}%s[%d] запросил(а) выдачу наказания для %s[%d].", p_info [ playerid ] [ name ], playerid, p_info [ params [ 0 ] ] [ name ], params [ 0 ] ) ;
			SendClientMessage ( i, col_admin, scm_string ) ;

			format( scm_string, 144, "{"#cBAdmin"}[A] {"#cGRAdmin"}Причина: %s. Введите {"#cBAdmin"}\"/accept_warn (/aw) [ %d ]\"{"#cGRAdmin"}.", params [ 1 ], params [ 0 ] ) ;
			SendClientMessage ( i, col_admin, scm_string ) ;
		}

		format( scm_string, 144, "{"#cBAdmin"}[A] {"#cGRAdmin"}%s[%d] запросил(а) выдачу наказания для %s[%d].", p_info [ playerid ] [ name ], playerid, p_info [ params [ 0 ] ] [ name ], params [ 0 ] ) ;
		SendClientMessage ( playerid, col_admin, scm_string ) ;

		format( scm_string, 144, "{"#cBAdmin"}[A] {"#cGRAdmin"}Причина: %s. Введите {"#cBAdmin"}\"/accept_warn (/aw) [ %d ]\"{"#cGRAdmin"}.", params [ 1 ], params [ 0 ] ) ;
		SendClientMessage ( playerid, col_admin, scm_string ) ;

		admin_info [ params [ 0 ] ] [ warn ] = 1 ;
		format ( admin_info [ params [ 0 ] ] [ reason_punish ], 64, "%s", params [ 1 ] ) ;
		format ( admin_info [ params [ 0 ] ] [ reason_admin ], MAX_PLAYER_NAME, "%s", p_info [ playerid ] [ name ] ) ;
	    return 1 ;
	}

	new _max_warn = 3 ;

	#if defined m_perks
	new _perk_stats = get_perk_info ( playerid, PERK_ADMIN_FRIEND ) ;
	if ( _perk_stats > 0 ) _max_warn = _perk_stats ;
	#endif

	if ( p_info [ params [ 0 ] ] [ p_warn ] == _max_warn - 1 )
	{
		new scm_string [ 238 ] ;
		format( scm_string, 144, "Администратор %s заблокировал %s [3 предупреждения]. Срок: 3 дня. Причина: %s", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], params [ 1 ] ) ;
		foreach(new i: logged_players) if ( p_info [ i ] [ settings ] [ 2 ] ) SendClientMessage ( i, col_light_red, scm_string ) ;

		mysql_format ( sql_connection, scm_string, sizeof ( scm_string  ), "INSERT INTO `users_bans` (`u_b_admin`,`u_b_name`,`u_b_reason`,`u_b_date`,`u_b_ndate`,`u_b_days`) VALUES ( '%s', '%s', '%s', NOW() + INTERVAL 3 DAY, NOW(), '3' )", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], params [ 1 ] ) ;
		mysql_tquery ( sql_connection, scm_string, "callback_process_ban", "i", params [ 0 ] ) ;

		format ( scm_string,sizeof(scm_string),"UPDATE `users_admins` SET `u_a_warns` = `u_a_warns`+1 WHERE `u_a_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
		mysql_tquery ( sql_connection, scm_string, "", "" ) ;

		format ( scm_string, sizeof scm_string, "UPDATE `users_warns` SET `w_end`=NOW() WHERE `w_owner`='%d'", p_info [ params [ 0 ] ] [ id ] ) ;
		mysql_tquery ( sql_connection, scm_string ) ;

	}
	else
	{
		new scm_string [ 238 ] ;
		format( scm_string, 144, "Администратор %s выдал предупреждение игроку %s. Причина: %s", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], params [ 1 ] ) ;
		foreach(new i: logged_players) if ( p_info [ i ] [ settings ] [ 2 ] ) SendClientMessage ( i, col_light_red, scm_string ) ;

		format ( scm_string,sizeof(scm_string),"UPDATE `users_admins` SET `u_a_warns` = `u_a_warns`+1 WHERE `u_a_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
		mysql_tquery ( sql_connection, scm_string, "", "" ) ;

		format ( scm_string, sizeof ( scm_string  ), "INSERT INTO `users_warns` (`w_admin_name`,`w_name`,`w_owner`,`w_reason`,`w_date`,`w_end`) VALUES ('%s', '%s', '%d', '%s', NOW(), NOW() + INTERVAL 3 DAY)", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], p_info [ params [ 0 ] ] [ id ], params [ 1 ] ) ;
		mysql_tquery ( sql_connection, scm_string ) ;

		format(scm_string, 128, "%s выдал предупреждение %s. Причина: %s", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], params [ 1 ]);
		WriteLog(playerid, TYPE_LOG_WARN, scm_string);

		if ( p_info [ params [ 0 ] ] [ member ] )
		{
			new fraction_id = p_info [ params [ 0 ] ] [ member ] ;
			Iter_Remove ( fraction_players[fraction_id], params [ 0 ] ) ;

			f_info [ fraction_id - 1 ] [ f_members ] -- ;
			format ( scm_string, 144, "UPDATE `fractions` SET `f_members` = '%d' WHERE `f_id` = '%d' LIMIT 1", f_info [ fraction_id - 1 ] [ f_members ], fraction_id ) ;
			mysql_tquery ( sql_connection, scm_string ) ;
		}

		p_info [ params [ 0 ] ] [ member ] =
		p_info [ params [ 0 ] ] [ rank ] =
		p_info [ params [ 0 ] ] [ org_skin ] =
		p_info [ params [ 0 ] ] [ warblock ] =
		p_info [ params [ 0 ] ] [ subleader ] =
		p_info [ params [ 0 ] ] [ f_warning ] = 0 ;

		scm_string [ 0 ] = EOS ;
		format ( scm_string, sizeof scm_string, "DELETE FROM `fractions_players` WHERE `u_sql_id` = '%d' LIMIT 1", p_info [ params [ 0 ] ] [ id ] ) ;
		mysql_tquery ( sql_connection, scm_string ) ;

		kick_player ( params [ 0 ] ) ;
	}

	if ( mw_biz != -1 || gz_captured != -1 )
	{
		if ( gang_player ( params [ 0 ] ) || mafia_player ( params [ 0 ] ) )
		{
			f_warn [ p_info [ params [ 0 ] ] [ member ] ] ++ ;
		}
	}
 	return 1 ;
}

CMD:unwarn ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 5 )return 1 ;
	if (sscanf ( params, "u", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /unwarn [ид/имя]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;

	if ( p_info [ params [ 0 ] ] [ p_warn ] == 0 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока нет предупреждений." ) ;

	new scm_string [ 128 ] ;
	format( scm_string, 128, "{"#cBAdmin"}[A] {"#cGRAdmin"}%s снял с %s предупреждения.", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ] ) ;
	foreach(new i: admin_players) if ( p_info [ i ] [ settings ] [ 2 ] ) SendClientMessage ( i, col_admin, scm_string ) ;

	format ( scm_string, 128, "UPDATE `users_warns` SET `w_end` = NOW() WHERE `w_owner` = '%d' AND `w_end` > NOW() LIMIT 1", p_info [ params [ 0 ] ] [ id ] ) ;
	mysql_tquery ( sql_connection, scm_string ) ;

	format(scm_string, 128, "%s снял предупреждение %s", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ]);
	WriteLog(playerid, TYPE_LOG_UNWARN,scm_string);
	return 1 ;
}

CMD:offwarn ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 4 ) return 1 ;
	new target_name [ 24 ], warn_reason [ 32 ] ;
	if (sscanf ( params, "s[24]s[32]", target_name, warn_reason ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /offwarn [имя] [причина]" ) ;

    new _pl_id ;
	sscanf ( target_name, "u", _pl_id ) ;
	if ( IsPlayerConnected ( _pl_id ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок в сети." ) ;

	new scm_string [ 59 + MAX_PLAYER_NAME ] ;
	format ( scm_string, sizeof ( scm_string  ), "SELECT `u_id` FROM `users` WHERE `u_name` = '%s' LIMIT 1", target_name ) ;
	mysql_tquery ( sql_connection, scm_string, "offwarn_check_callback", "iss", playerid, target_name, warn_reason ) ;
	return 1 ;
}

callback: offwarn_check_callback ( playerid, pl_name [ ], reason_ [ ] )
{
	new rows, fields;
	cache_get_data ( rows, fields ) ;
	if ( ! rows )
	{
		new scm_string [ 63 + MAX_PLAYER_NAME ] ;
		format( scm_string, sizeof ( scm_string ), "{"#cRInfo"}* {"#cGRInfo"}Аккаунт %s не найден в базе данных.", pl_name ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
		return 1 ;
	}
	else
	{
		new account_id = cache_get_field_content_int ( 0, "u_id", sql_connection ) ;

		new scm_string [ 69 + 9 ] ;
		format ( scm_string, sizeof ( scm_string  ), "SELECT `w_owner` FROM `users_warns` WHERE `w_owner` = '%d' LIMIT 1", account_id ) ;
		mysql_tquery ( sql_connection, scm_string, "offwarn_second_callback", "isis", playerid, pl_name, account_id, reason_ ) ;

		return 1 ;
	}
}

callback: offwarn_second_callback ( playerid, pl_name [ ], account_id, reason_ [ ] )
{
	new rows, fields;
	cache_get_data ( rows, fields ) ;
	if ( rows < 2 )
	{
        if ( reload_admin_warning ( playerid, reason_ ) ) return 1 ;

		new scm_string [ 238 ] ;
		format( scm_string, 144, "Администратор %s выдал предупреждение игроку %s. Причина: %s", p_info [ playerid ] [ name ], pl_name, reason_ ) ;
		foreach(new i: admin_players) SendClientMessage ( i, col_light_red, scm_string ) ;

		format ( scm_string, sizeof ( scm_string  ), "INSERT INTO `users_warns` (`w_admin_name`,`w_name`,`w_owner`,`w_reason`,`w_date`,`w_end`) VALUES ('%s', '%s', '%d', '%s', NOW(), NOW() + INTERVAL 5 DAY)", p_info [ playerid ] [ name ], pl_name, account_id, reason_ ) ;
		mysql_tquery ( sql_connection, scm_string ) ;

		format ( scm_string, sizeof scm_string, "DELETE FROM `fractions_players` WHERE `u_sql_id` = '%d' LIMIT 1", account_id ) ;
		mysql_tquery ( sql_connection, scm_string ) ;

		new string [ 100 ] ;
        format ( string, sizeof string, "Администратор %s выдал Вам предупреждение. Причина: %s", p_info [ playerid ] [ name ], reason_ ) ;
		insert_debtor_message ( "Наказание от администратора", string, account_id ) ;
		return 1 ;
	}
	else
	{
	    if ( reload_admin_warning ( playerid, reason_ ) ) return 1 ;

		new scm_string [ 238 ] ;
		format( scm_string, 144, "Администратор %s заблокировал %s [3 предупреждения]. Срок: 3 дня. Причина: %s", p_info [ playerid ] [ name ], pl_name, reason_ ) ;
		foreach(new i: admin_players) SendClientMessage ( i, col_light_red, scm_string ) ;

		format ( scm_string, sizeof ( scm_string  ), "INSERT INTO `users_bans` (`u_b_admin`,`u_b_name`,`u_b_reason`,`u_b_date`,`u_b_ndate`,`u_b_days`) VALUES ( '%s', '%s', '%s', NOW() + INTERVAL 3 DAY, NOW(), '3' )", p_info [ playerid ] [ name ], pl_name, reason_ ) ;
		mysql_tquery ( sql_connection, scm_string ) ;

		format ( scm_string, sizeof scm_string, "UPDATE `users_warns` SET `w_end`=NOW() WHERE `w_owner`='%d'", account_id ) ;
		mysql_tquery ( sql_connection, scm_string ) ;

		return 1 ;
	}
}

CMD:offunwarn( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 5 )return 1 ;
	if (sscanf ( params, "s[24]", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /offunwarn [имя]" ) ;

	new scm_string [ 59 + MAX_PLAYER_NAME ] ;
	format ( scm_string, sizeof ( scm_string  ), "SELECT `u_id` FROM `users` WHERE `u_name` = '%s' LIMIT 1", params [ 0 ] ) ;
	mysql_tquery ( sql_connection, scm_string, "unwarnoff_check_callback", "is", playerid, params [ 0 ] ) ;
	return 1 ;
}

callback: unwarnoff_check_callback ( playerid, pl_name [ ] )
{
	new rows, fields;
	cache_get_data ( rows, fields ) ;
	if ( ! rows )
	{
		new scm_string [ 63 + MAX_PLAYER_NAME ] ;
		format( scm_string, sizeof ( scm_string ), "{"#cRInfo"}* {"#cGRInfo"}Аккаунт %s не найден в базе данных.", pl_name ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
		return 1 ;
	}
	else
	{
		new account_id = cache_get_field_content_int ( 0, "u_id", sql_connection ) ;

		new scm_string [ 89 + 9 ] ;
		format ( scm_string, sizeof ( scm_string  ), "SELECT `w_owner` FROM `users_warns` WHERE `w_owner` = '%d' AND `w_end` > NOW() LIMIT 1", account_id ) ;
		mysql_tquery ( sql_connection, scm_string, "unwarnoff_second_callback", "iis", playerid, account_id, pl_name ) ;
		return 1 ;
	}
}

callback: unwarnoff_second_callback ( playerid, account_id, pl_name [ ] )
{
	new rows, fields;
	cache_get_data ( rows, fields ) ;
	if ( ! rows )
	{
		new scm_string [ 66 + MAX_PLAYER_NAME ] ;
		format( scm_string, sizeof ( scm_string ), "{"#cRInfo"}* {"#cGRInfo"}У игрока %s не найдено предупреждений.", pl_name ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
		return 1 ;
	}

	new scm_string [ 50 + ( MAX_PLAYER_NAME * 2 ) ] ;
	format ( scm_string, sizeof ( scm_string  ), "UPDATE `users_warns` SET `w_end` = NOW() WHERE `w_owner` = '%d' AND `w_end` > NOW() LIMIT 1", account_id ) ;
	mysql_tquery ( sql_connection, scm_string ) ;

	format( scm_string, sizeof scm_string, "{"#cBAdmin"}[A] {"#cGRAdmin"}%s снял варн с %s.", p_info [ playerid ] [ name ], pl_name ) ;
	foreach(new i: admin_players) SendClientMessage ( i, col_admin, scm_string ) ;
	return 1 ;
}

