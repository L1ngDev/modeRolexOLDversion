			SendClientMessage ( playerid, col_white, query_string ) ;
			return 1 ;
		}
		case d_cellar_menu:
		{
			if ( ! response ) return 1 ;
			switch ( listitem )
			{
				case 0:
				{
					new h = GetPVarInt ( playerid, "house_id" ) - 1 ;
					new d_string [ 172 ] ;
					format ( d_string, sizeof ( d_string ), "{"#cBL"}Посажено семян: {"#cGRDialog"}%d гр.{"#cBL"} | Урожай: {"#cGRDialog"}%d гр.\n{"#cGRDialog"}- {"#cWH"}Посадить семена\n{"#cGRDialog"}- {"#cWH"}Переработка урожая",
					h_info [ h ] [ h_seed ], h_info [ h ] [ h_seed_result ] ) ;
