			clear_player_listitem_values ( playerid ) ;

			if ( c_info [ playerid ] [ c_id ] != INVALID_PLAYER_ID ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас уже есть заказ." ) ;

			set_player_use_listitem ( playerid, target_id ) ;

			new price_head = p_info [ target_id ] [ head_value ] ;
			new fraction_data [ 32 ];
			if ( p_info [ target_id ] [ member ] )format ( fraction_data, sizeof ( fraction_data ), "%s", f_info [ p_info [ target_id ] [ member ] - 1 ] [ f_name ] ) ;
			else format ( fraction_data, sizeof ( fraction_data ), "отсутствует" ) ;
			new rank_data [ 32 ];
			if ( p_info [ target_id ] [ rank ] )format ( rank_data, sizeof ( rank_data ), "%s", f_rank [ p_info [ target_id ] [ member ] - 1 ] [ p_info [ target_id ] [ rank ] - 1 ] ) ;
			else format ( rank_data, sizeof ( rank_data ), "отсутствует" ) ;

			new dialog_string [ 256 + MAX_PLAYER_NAME ] ;
			format ( dialog_string, sizeof dialog_string, "{"#cBL"}** Информация о заказе **\n\n{"#cWH"}Заказ на имя {"#cBL"}%s\n{"#cWH"}Организация: {"#cBL"}%s\n{"#cWH"}Должность: {"#cBL"}%s\n\n{"#cGRDialog"}* Цена устранения: {"#cGN"}%d"valute_title_"",
			p_info [ target_id ] [ name ], fraction_data, rank_data, price_head ) ;

			show_dialog ( playerid, d_contract_enter, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Информация о заказе", dialog_string, "Взять", "Закрыть" ) ;
	        return 1 ;
