stock Float: RandomFloat ( Float: max )
{
    return floatdiv ( float ( random ( 0 ) ), floatdiv ( float ( cellmax ), max ) ) ;
}

stock Float: RandomFloatEx ( Float: min, Float: max )
{
    return floatadd ( RandomFloat ( floatsub ( max, min ) ), min ) ;
}

