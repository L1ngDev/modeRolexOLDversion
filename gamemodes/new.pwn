			{
				show_dialog ( playerid, d_deposit_create_pass, DIALOG_STYLE_INPUT, "{"#cBHD"}Открытие счёта", "{ffffff}Введите пин-код вашего счета:", "Принять", "Назад" ),
													SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Пинкод не может начинаться с 0 и не может быть длинее 4 цифр." ) ;
				return 1 ;
			}

			new _card_inc = 0, b = GetPVarInt ( playerid, "p_biz_id" ) - 1, _list_item = get_player_use_listitem ( playerid ) ;
			if ( b < 0 ) return bad_exit ( playerid ) ;
