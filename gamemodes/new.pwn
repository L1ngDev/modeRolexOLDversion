			{
				NewPos [ 0 ] = DeerInfo [ A ] [ D_Pos ] [ 0 ]-float(-3+random(6));
				NewPos [ 1 ] = DeerInfo [ A ] [ D_Pos ] [ 1 ]-float(-3+random(6));
				DeerInfo [ A ] [ D_UpdateTime ] = 1 + random ( 20 ) ;
			}
			else if ( DeerInfo [ A ] [ D_Status ] == 2 )
			{
				NewPos [ 0 ] = DeerInfo [ A ] [ D_Pos ] [ 0 ]-float(-5+random(10));
				NewPos [ 1 ] = DeerInfo [ A ] [ D_Pos ] [ 1 ]-float(-5+random(10));
