		}
	}

	if ( is_drug_effect { playerid } > 0 )
	{
		if ( --is_drug_effect { playerid } == 1 )
		{
			switch ( GetPlayerVirtualWorld ( playerid ) )
			{
				case 0:
				{
					new newhour, newminute, newsecond ;
					gettime ( newhour, newminute, newsecond ) ;
					SetPlayerTime ( playerid, newhour, newminute ), SetPlayerWeather ( playerid, global_weather ) ;
				}
				case 1..9: SetPlayerWeather ( playerid, 4 ), SetPlayerTime ( playerid, 18, 0 ) ;
				case 10: SetPlayerTime ( playerid, 12, 0 ), SetPlayerWeather ( playerid, 1 ) ;
				default:
				{
				    if ( GetPVarInt ( playerid, "p_biz_id" ) > 0 ) SetPlayerWeather ( playerid, 4 ), SetPlayerTime ( playerid, 18, 0 ) ;
				}
			}

			SetPlayerDrunkLevel ( playerid, 0 ) ;
			is_drug_effect { playerid } = 0 ;
			GameTextForPlayer ( playerid, "~p~Drug effect~n~~w~Gone", 4500, 1 ) ;
		}
	}

	if ( player_use_bed { playerid } > 0 )
	{
	    new h_bed = player_use_bed { playerid } - 1, Float: _health_old = p_t_info [ playerid ] [ p_health ] ;
		if ( ! IsPlayerInRangeOfPoint ( playerid, 3, h_bed_position [ h_bed ] [ 0 ], h_bed_position [ h_bed ] [ 1 ], h_bed_position [ h_bed ] [ 2 ] ) )
		{
			h_bed_toggled [ h_bed ] [ player_use_bed_world { playerid } - 1 ] = false ;
			SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы освободили кровать, лечение прервано." ) ;
			player_use_bed { playerid } = 0 ;
			ClearAnimations ( playerid, 1 ) ;
		}

		if ( _health_old >= 100 )
		{
			SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы полностью вылечились и теперь можете покинуть больницу." ) ;
			h_bed_toggled [ h_bed ] [ player_use_bed_world { playerid } - 1 ] = false ;
			player_use_bed { playerid } = 0 ;
			player_death_id [ playerid ] = 0 ;
			ClearAnimations ( playerid, 1 ) ;
		}
		else
		{
		    new Float: _health = 1.0 ;
			if ( p_info [ playerid ] [ vip ] ) _health += 1.0 ;
			if ( p_info [ playerid ] [ crime_plus ] ) _health += 1.0 ;

			else set_health ( playerid, _health_old + _health ) ;
		}
	}
	else
	{
	    switch ( player_death_id [ playerid ] )
	    {
	        case 1..3:
			{
				if ( ! p_info [ playerid ] [ jail ] )
				{
				    new Float: _health = p_t_info [ playerid ] [ p_health ] ;
					if ( _health >= 100 )
					{
						SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы полностью вылечились и теперь можете покинуть больницу." ) ;
						if ( player_use_bed { playerid } > 0 ) h_bed_toggled [ player_use_bed { playerid } - 1 ] [ player_use_bed_world { playerid } - 1 ] = false ;
						player_death_id [ playerid ] = 0 ;
						player_use_bed { playerid } = 0 ;
					}
					else if ( _health < 100 )
					{
						if ( ! p_info [ playerid ] [ vip ] ) set_health ( playerid, _health + 0.5 ) ;
						else set_health ( playerid, _health + 1.0 ) ;
					}
				}
			}
			case 4:
			{
			    if ( ! p_info [ playerid ] [ jail ] )
				{
				    new Float: _health = p_t_info [ playerid ] [ p_health ] ;
					if ( _health >= 100 )
					{
						SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы полностью вылечились и теперь можете покинуть госпиталь." ) ;
						player_death_id [ playerid ] = 0 ;
					}
					else if ( _health < 100 )
					{
						if ( ! p_info [ playerid ] [ vip ] ) set_health ( playerid, _health + 0.5 ) ;
						else set_health ( playerid, _health + 1.0 ) ;
					}
				}
			}
		}
	}

	if ( admin_info [ playerid ] [ spectate_id ] != -1 )
