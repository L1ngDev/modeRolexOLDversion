                }
			    show_dialog ( playerid, d_bpanel_money, DIALOG_STYLE_LIST, "{"#cBHD"}Управление кассой", "{"#cBL"}1.{"#cWH"} Пополнить баланс\n{"#cBL"}2.{"#cWH"} Снять наличные", "Выбрать", "Назад" ) ;
			    return 1 ;
