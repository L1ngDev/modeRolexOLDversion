stock create_cl_seed ( _cl_id )
{
    if ( cellar_info [ _cl_id - 1 ] [ cl_seed ] < 1 ) return 1 ;

    new _cl_seed = cellar_info [ _cl_id - 1 ] [ cl_seed ] ;
	cellar_info [ _cl_id - 1 ] [ cl_seed ] = 0 ;
	cellar_info [ _cl_id - 1 ] [ cl_seed_result ] += floatround ( _cl_seed / 2 ) ;
	return 1 ;
}

stock create_house_seed ( _h_id )
{
	if ( h_info [ _h_id - 1 ] [ h_seed ] < 1 ) return 1 ;

	new _h_seed = h_info [ _h_id - 1 ] [ h_seed ] ;
	h_info [ _h_id - 1 ] [ h_seed ] = 0 ;
	h_info [ _h_id - 1 ] [ h_seed_result ] += floatround ( _h_seed / 2 ) ;
	return 1 ;
}

new bool: activate_server_stats = false ;
CMD:sstats ( playerid )
{
	if ( admin_info [ playerid ] [ admin ] < 8 ) return 1 ;

	if ( activate_server_stats == true ) activate_server_stats = false ;
	else activate_server_stats = true ;
	return 1 ;
}

new checking_20_min = 0 ;
callback: minute_timer ( )
{
	new currentTime = gettime ( ) ;
	if ( offline_report )
	{
	    checking_20_min ++ ;
		if ( checking_20_min == 20 )
		{
		    if ( activate_server_stats == true )
		    {
			    global_string [ 0 ] = EOS ;
			    GetNetworkStats ( global_string, 512 ) ; // get the servers networkstats

			    printf ( "%s", global_string ) ;
			    printf ( "TICK RATE %d", GetServerTickRate ( ) ) ;
			}

		    //mysql_tquery ( sql_connection, "SELECT `r_id` FROM `logs_report` WHERE `r_status` = '0' AND `date` < NOW()-INTERVAL 20 MINUTE", "callback_report_min", "i", 1 ) ;
		}
		if ( checking_20_min == 40 )
		{
		    checking_20_min = 0 ;
		    //mysql_tquery ( sql_connection, "SELECT `r_id` FROM `logs_report` WHERE `r_status` = '0' AND `date` < NOW()-INTERVAL 40 MINUTE", "callback_report_min", "i", 2 ) ;
            mysql_tquery ( sql_connection, "DELETE FROM `logs_report` WHERE `r_status` = '0' AND `date` < NOW()-INTERVAL 40 MINUTE", "", "" ) ;
		}
	}

	for ( new i = 0 ; i < MAX_BANKS ; i ++ )
	{
		if ( bank_disconnect_time [ i ] > 0 )
		{
		    bank_disconnect_time [ i ] -- ;
		    if ( bank_disconnect_time [ i ] == 1 )
		    {
		        clear_bank_robbery ( INVALID_PLAYER_ID, 4, i ) ;
		    }
		}
	}

	for ( new A = 0 ; A != MAX_DEER ; A ++ )
	{
	    if ( DeerInfo [ A ] [ D_Status ] == 3 )
	    {
	        if ( DeerInfo [ A ] [ D_RespawnTime ] < currentTime )
		    {
		        if ( IsValidDynamicPickup ( DeerInfo [ A ] [ D_Pickup ] ) )
				{
					DestroyDynamicPickup ( DeerInfo [ A ] [ D_Pickup ] ) ;
			    	DeerInfo [ A ] [ D_Pickup ] = INVALID_PICKUP_ID ;
				}

				if ( IsValidActor ( DeerInfo [ A ] [ D_ObjectID ] ) ) DestroyActor ( DeerInfo [ A ] [ D_ObjectID ] ) ;

				/*if ( IsValidDynamicObject ( DeerInfo [ A ] [ D_ObjectID ] ) )
				{
	   				DestroyDynamicObject ( DeerInfo [ A ] [ D_ObjectID ] ) ;
		  	   		DeerInfo [ A ] [ D_ObjectID ] = INVALID_OBJECT_ID ;
				}*/

		    	DeerInfo [ A ] [ D_ObjectID ] = CreateActor ( 312, DeerPoint [ A ] [ 0 ], DeerPoint [ A ] [ 1 ], DeerPoint [ A ] [ 2 ], 90.0 ) ;
				//DeerInfo [ A ] [ D_ObjectID ] = CreateDynamicObject ( 19315, DeerPoint [ A ] [ 0 ], DeerPoint [ A ] [ 1 ], DeerPoint [ A ] [ 2 ] - 0.4, 0.0, 0.0, 0.0, 0, 0 ) ;
		    	DeerInfo [ A ] [ D_Status ] = 1 ;
		    	DeerInfo [ A ] [ D_UpdateTime ] = 1 + random ( 20 ) ;
		    }
	    }
	}

	#if defined m_garden
	    garden_minute_timer ( ) ;
	#endif

	#if defined m_jobs_module
	    trucker_minute_timer ( ) ;
	#endif

	#if defined m_medic
	    medic_minute_timer ( ) ;
	#endif

	#if defined m_tablet
		AuctionMinuteTimer ( currentTime ) ;
	#endif

	new _str [ ( MAX_PLAYER_NAME + 33 ) * 10 + 4 ] ;
	strcat ( _str,"** Очередь на сдачу **\n" ) ;
	for ( new i = 0 ; i < 10 ; i ++ )
	{
		if ( autoschool_queue [ i ] != INVALID_PLAYER_ID && ! IsPlayerConnected ( autoschool_queue [ i ] ) ||
			autoschool_queue [ i ] != INVALID_PLAYER_ID && exam_start [ autoschool_queue [ i ] ] != true ||
			autoschool_queue [ i ] != INVALID_PLAYER_ID && p_t_info [ autoschool_queue [ i ] ] [ p_data ] [ 1 ] != 1 ) autoschool_queue [ i ] = INVALID_PLAYER_ID ;

		if ( i != 9 && autoschool_queue [ i ] == INVALID_PLAYER_ID && autoschool_queue [ i + 1 ] != INVALID_PLAYER_ID )
		{
			autoschool_queue [ i ] = autoschool_queue [ i + 1 ] ;
			autoschool_queue [ i + 1 ] = INVALID_PLAYER_ID ;
		}
		if ( autoschool_queue [ i ] != INVALID_PLAYER_ID ) format ( _str, sizeof ( _str ), "%s\n{"#cGR3D"}%i.{"#cWH3D"} %s", _str, i + 1, p_info [ autoschool_queue [ i ] ] [ name ] ) ;
	}
	UpdateDynamic3DTextLabelText ( text_autoschool_queue, col_header_3d, _str ) ;

	autoschool_cd += 1 ;
 	if ( autoschool_cd == 3 )
 	{
 		autoschool_playerid = INVALID_PLAYER_ID ;
 		autoschool_cd = 0 ;
	}
	if ( autoschool_playerid == INVALID_PLAYER_ID && autoschool_queue [ 0 ] != INVALID_PLAYER_ID )
	{
		autoschool_playerid = autoschool_queue [ 0 ] ;
		new player_id = autoschool_queue [ 0 ] ;

		if ( autoschool_queue [ 1 ] != INVALID_PLAYER_ID && IsPlayerConnected ( autoschool_queue [ 1 ] ) )
		{
			new scm_string [ 70 + ( MAX_PLAYER_NAME * 2 ) ] ;
			for ( new i = 0 ; i < 10 ; i ++ )
			{
				if ( autoschool_queue [ i ] != INVALID_PLAYER_ID && IsPlayerConnected ( autoschool_queue [ i ] ) )
				{
					format ( scm_string, sizeof scm_string, "* Подошла очередь %s. Следующим к практическому тесту готовится %s.", p_info [ player_id ] [ name ], p_info [ autoschool_queue [ 1 ] ] [ name ] ) ;
				   	SendClientMessage ( autoschool_queue [ i ], col_lblue, scm_string ) ;
				}
			}
		}

		SendClientMessage ( player_id, col_gray, !"* Подошла Ваша очередь. Следуйте на парковку автошколы и садитесь в транспорт." ) ;
		SetPlayerRaceCheckpoint ( player_id, 1, autoschool_parking_pos [ 0 ], autoschool_parking_pos [ 1 ], autoschool_parking_pos [ 2 ], 0.0, 0.0, 0.0, 4.0 ) ;
		is_gps_used { player_id } = 1 ;
	}

	new hour, minute, second ;
	gettime ( hour, minute, second ) ;

	if ( minute % 2 )
	{
		SaveServerOnline ( ) ;
	}

	if ( Iter_Count(logged_players) >= online_bonus )
	{
	    new scm_string [ 144 ] ;
	    format ( scm_string, sizeof scm_string, "* "info_name": {"#cWH"}Достигнута отметка в {"#cGW"}%d {"#cWH"}игроков на сервере, каждому игроку выдан {"#cGW"}%s{"#cWH"}.", online_bonus, item_name ( 2003 ) ) ;
	    foreach(new i: logged_players)
	    {
    		SendClientMessage ( i, col_gameworld, scm_string ) ;
	        give_treasure ( i, 2003, 1 ) ;
	    }
	    online_bonus += 50 ;
	}

	if ( hour == 3 && minute == 45 ) SendClientMessageToAll( col_yellow, !"* Через 15 минут произойдет технический рестарт сервера." ) ;
	if ( hour == 4 && minute == 45 ) SendClientMessageToAll( col_yellow, !"* Через 15 минут произойдет технический рестарт сервера." ) ;
	return 1 ;
}

stock convert_time ( time_converter, type_time )
{
    new time_string [ 30 ], hours, minutes ;
	if ( type_time == TYPE_TIME_SECOND )
	{
		hours = time_converter / 3600 ;
		minutes = ( time_converter - hours * 3600 ) / 60 ;
		time_converter = floatround ( time_converter - ( ( hours * 3600 ) + ( minutes * 60 ) ) ) ;

		if ( hours > 0 ) format ( time_string, sizeof( time_string ), "%02d:%02d:%02d", hours, minutes, time_converter ) ;
		else format ( time_string, sizeof( time_string ), "%02d:%02d", minutes, time_converter ) ;
	}
	else if ( type_time == TYPE_TIME_HOUR )
	{
		hours = time_converter / 3600 ;
		minutes = ( time_converter - hours * 3600 ) / 60 ;
		format ( time_string, 30, "%d ч %d мин", hours, minutes ) ;
	}
	return time_string ;
}

stock GetElapsedTime(time, to_time, type = CONVERT_TIME_TO_HOURS)
{
	if ( time == -1 ) return -1 ;
	if ( to_time == -1 ) return -1 ;

    new result ;

    switch ( type )
    {
        case CONVERT_TIME_TO_MINUTES:
        {
            result = ((time - (time % 60)) - (to_time - (to_time % 60))) / 60;
        }
        case CONVERT_TIME_TO_HOURS:
        {
            result = ((time - (time % 3600)) - (to_time - (to_time % 3600))) / 3600;
        }
        case CONVERT_TIME_TO_DAYS:
        {
            result = ((time - (time % 86400)) - (to_time - (to_time % 86400))) / 86400;
        }
        case CONVERT_TIME_TO_WEEKS:
        {
            result = ((time - (time % 604800)) - (to_time - (to_time % 604800))) / 604800;
        }
        case CONVERT_TIME_TO_MONTHS:
        {
            result = ((time - (time % 2629743)) - (to_time - (to_time % 2629743))) / 2629743;
        }
        case CONVERT_TIME_TO_YEARS:
        {
            result = ((time - (time % 31556926)) - (to_time - (to_time % 31556926))) / 31556926;
        }
        default:
            result = -1 ;
    }
    return result ;
}

stock ConvertUnixTime(unix_time, type = CONVERT_TIME_TO_SECONDS)
{
	if ( unix_time == -1 ) return -1 ;

    switch(type)
    {
        case CONVERT_TIME_TO_SECONDS:
        {
            unix_time %= 60;
        }
        case CONVERT_TIME_TO_MINUTES:
        {
            unix_time = (unix_time / 60) % 60;
        }
        case CONVERT_TIME_TO_HOURS:
        {
            unix_time = (unix_time / 3600) % 24;
        }
        case CONVERT_TIME_TO_DAYS:
        {
            unix_time = (unix_time / 86400) % 30;
        }
        case CONVERT_TIME_TO_WEEKS:
        {
            unix_time = (unix_time / 604800) % 7;
        }
        case CONVERT_TIME_TO_MONTHS:
     	{
            unix_time = (unix_time / 2629743) % 12;
        }
        case CONVERT_TIME_TO_YEARS:
        {
            unix_time = (unix_time / 31556926) + 1970;
        }
        default:
            unix_time %= 60;
    }
    return unix_time ;
}

stock SetElapsedTime ( time, to_time, type = CONVERT_TIME_TO_SECONDS )
{
	if ( to_time < 1 ) return to_time ;

    new result ;
    switch ( type )
    {
        case CONVERT_TIME_TO_MINUTES:
        {
            result = time + (60 * to_time);
        }
        case CONVERT_TIME_TO_HOURS:
        {
            result = time + (3600 * to_time);
        }
        case CONVERT_TIME_TO_DAYS:
        {
            result = time + (86400 * to_time);
        }
        case CONVERT_TIME_TO_WEEKS:
        {
            result = time + (604800 * to_time);
        }
        case CONVERT_TIME_TO_MONTHS:
        {
            result = time + (2629743 * to_time);
        }
        case CONVERT_TIME_TO_YEARS:
        {
            result = time + (31556926 * to_time);
        }
        default:
            result = -1;
    }
    return result;
}


stock pay_day_time ( )
{
	new total_territory [ 6 ] ;
	for ( new j = 0 ; j < gz_count ; j ++ )
	{
		if ( gz_info [ j ] [ gz_owner ] == 0 ) continue ;

		new _f_id = gz_info [ j ] [ gz_owner ] ;
		update_gdorm_text ( _f_id ) ;
		total_territory [ _f_id - 18 ] ++ ;

		set_money_fraction ( _f_id - 1, 0, 500, true, false ) ;
	}

	new total_graf [ 6 ], _f_id ;
	for ( new i = 0 ; i < count_graffity ; i ++ )
	{
	    if ( graf_info [ i ] [ g_member ] == 0 ) continue ;

	    _f_id = graf_info [ i ] [ g_member ] ;
	    update_gdorm_text ( _f_id ) ;
	    total_graf [ _f_id - 18 ] ++ ;

	    set_money_fraction ( _f_id - 1, 1, 250, true, false ) ;
	}

	new newhour, newminute, newsecond ;
	gettime ( newhour, newminute, newsecond ) ;
	foreach(new i: logged_players)
	{
		switch ( p_t_info [ i ] [ p_data ] [ 1 ] )
		{
			case 0: SetPlayerTime ( i, newhour, newminute ), SetPlayerWeather ( i, global_weather ) ;
			case 1..9: SetPlayerWeather ( i, 4 ), SetPlayerTime ( i, 18, 0 ) ;
			case 10: SetPlayerTime ( i, 12, 0 ), SetPlayerWeather ( i, 1 ) ;
			default:
			{
			    if ( GetPVarInt ( i, "p_biz_id" ) != 0 )SetPlayerWeather ( i, 4 ), SetPlayerTime ( i, 18, 0 ) ;
			}
		}

		if ( floatround ( p_info [ i ] [ time_hour ] / 60 ) < 15 )
		{
			SendClientMessage ( i, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Для получения зарплаты необходимо отыграть минимум 15 минут." ) ;

			if ( newhour != 0 ) gettime_clear ( i ) ;
			else
			{
			    p_info [ i ] [ online_player ] [ 1 ] = p_info [ i ] [ online_player ] [ 0 ] ;
				p_info [ i ] [ online_player_afk ] [ 1 ] = p_info [ i ] [ online_player_afk ] [ 0 ] ;

				p_info [ i ] [ online_player ] [ 0 ] =
				p_info [ i ] [ online_player_afk ] [ 0 ] = 0 ;

				check_today_time [ i ] = false ;
				check_day_report [ i ] = false ;

				gettime_clear ( i, 1 ) ;
			}
			continue ;
		}

		new fractionid = p_info [ i ] [ member ] ;
  		if ( fractionid > 0 )
		{
		    new rank_id = p_info [ i ] [ rank ] ;
			if ( ! gang_player ( i ) && ! mafia_player ( i ) )
			{
			    // з/п от пра-во
			    new _f_rank_salary = f_info [ fractionid - 1 ] [ f_rank_salary ] [ rank_id - 1 ] ;
				if ( f_info [ 10 ] [ f_money ] > _f_rank_salary )
				{
					p_info [ i ] [ salary ] += _f_rank_salary * p_t_info [ i ] [ advert_count ] ;

					set_money_fraction ( 10, 0, _f_rank_salary, false, false ) ;
				}
				p_t_info [ i ] [ advert_count ] = 1 ;

				// з/п от организации
				_f_rank_salary = f_info [ fractionid - 1 ] [ f_rang_zp ] [ rank_id - 1 ] ;
				if ( f_info [ fractionid - 1 ] [ f_money ] > _f_rank_salary && f_info [ fractionid - 1 ] [ f_status_zp ] == 1 )
				{
				    p_info [ i ] [ salary ] += _f_rank_salary ;

				    set_money_fraction ( fractionid - 1, 0, _f_rank_salary, false, false ) ;
				}
				else if ( f_info [ fractionid - 1 ] [ f_money ] > _f_rank_salary && f_info [ fractionid - 1 ] [ f_status_zp ] == 0 )
				{
    				if ( newhour == 20 )
    				{
    				    p_info [ i ] [ salary ] += _f_rank_salary ;

				    	set_money_fraction ( fractionid - 1, 0, _f_rank_salary, false, false ) ;
    				}
				}
			}
			else
			{
			    // з/п от организации
				p_info [ i ] [ salary ] += f_info [ fractionid - 1 ] [ f_rank_salary ] [ rank_id - 1 ] ;

				new _f_rank_salary = f_info [ fractionid - 1 ] [ f_rang_zp ] [ rank_id - 1 ] ;
				if ( f_info [ fractionid - 1 ] [ f_money ] > _f_rank_salary && f_info [ fractionid - 1 ] [ f_status_zp ] == 1 )
				{
				    p_info [ i ] [ salary ] += _f_rank_salary ;

				    set_money_fraction ( fractionid - 1, 0, _f_rank_salary, false, false ) ;
				}
				else if ( f_info [ fractionid - 1 ] [ f_money ] > _f_rank_salary && f_info [ fractionid - 1 ] [ f_status_zp ] == 0 )
				{
    				if ( newhour == 20 )
    				{
    				    p_info [ i ] [ salary ] += _f_rank_salary ;

				    	set_money_fraction ( fractionid - 1, 0, _f_rank_salary, false, false ) ;
    				}
				}
			}
		}

		if ( p_info [ i ] [ b_worker ] > 0 && p_info [ i ] [ business_rang ] > 0 )
		{
	    	new bizz_id = p_info [ i ] [ b_worker ], bizz_rank = p_info [ i ] [ business_rang ] ;
	    	new _b_salary = b_info [ bizz_id - 1 ] [ b_salary ] [ bizz_rank - 1 ] ;
		   	if ( b_info [ bizz_id - 1 ] [ b_money ] > _b_salary && b_info [ bizz_id - 1 ] [ b_status_salary ] == 1 )
			{
			    p_info [ i ] [ salary ] += _b_salary ;
			    b_info [ bizz_id - 1 ] [ b_money ] -= _b_salary ;
			}
			else if ( b_info [ bizz_id - 1 ] [ b_money ] > _b_salary && b_info [ bizz_id - 1 ] [ b_status_salary ] == 0 )
			{
    			if ( newhour == 20 )
    			{
			    	p_info [ i ] [ salary ] += _b_salary ;
			    	b_info [ bizz_id - 1 ] [ b_money ] -= _b_salary ;
				}
			}
		}

		SendClientMessage ( i, col_white, !"{"#cYW"}---------------[{"#cWH"} БАНКОВСКИЙ ЧЕК {"#cYW"}]---------------" ) ;

    	new tmpintrate = 0, interest = 0, tax_player = 0, double_exp_player = 0, double_family_talon = 0, time_to_talon = 0,
			double_donate_player = 0, time_to_donate = 0, _max_bank_count = 500000 ;

    	if ( player_payday_5 { i } >= 5 ) player_payday_5 { i } = 0 ;
    	player_payday_5 { i } ++ ;
    	new _pay_day_5 = player_payday_5 { i } ;


    	if ( player_payday_3 { i } >= 3 ) player_payday_3 { i } = 0 ;
    	player_payday_3 { i } ++ ;

		new _vip = p_info [ i ] [ vip ] ;
    	switch ( _vip )
    	{
    	    case 0:
			{
				tmpintrate = 1 ;

				//if ( player_payday_3 { i } == 3 ) double_donate_player = 1 ;
				//else time_to_donate = 3 - player_payday_3 { i } ;
			}
    	    case 1:
			{
				//if ( player_payday_3 { i } == 3 ) double_donate_player = 1 ;
				//else time_to_donate = 3 - player_payday_3 { i } ;

				if ( _pay_day_5 == 5 ) double_family_talon = 1, double_donate_player = 1 ;
				else time_to_talon = 5 - _pay_day_5 ;

				tmpintrate = 2 ;
			}
    	    case 2:
			{
			    if ( player_payday_3 { i } == 3 ) double_family_talon = 1 ; //double_donate_player = 1 ;
				else time_to_donate = 3 - player_payday_3 { i } ;

				if ( _pay_day_5 == 5 ) double_exp_player = 1, double_donate_player = 2 ;
				else time_to_talon = 5 - _pay_day_5 ;

				_max_bank_count += 1000000 ;

				tmpintrate = 5 ;
			}
    	    case 3:
			{
				double_family_talon = 1 ;
				if ( player_payday_3 { i } == 3 ) double_exp_player = 1, double_donate_player = 3 ;
				else time_to_donate = 3 - player_payday_3 { i } ;

				_max_bank_count += 2000000 ;

				tmpintrate = 8 ;
			}
    	}

		new _pay_card = -1, _over_money_card = 0, _all_interest = 0 ;
		for ( new b = 0 ; b < MAX_BANK_ACCOUNT ; b ++ )
		{
		    if ( bank_info [ i ] [ bi_money ] [ b ] > 100_000_000 ) _over_money_card ++ ;

		    switch ( bank_info [ i ] [ bi_type ] [ b ] == 1 )
			{
				case 1: _pay_card = b ;
		        case 2:
			    {
			        if ( p_info [ i ] [ vip ] )
					{
						interest = floatround ( ( bank_info [ i ] [ bi_money ] [ b ] / 1000 ) * ( tmpintrate ) ) ;
						if ( interest > 100000 ) interest = 100000 ;

						if ( bank_info [ i ] [ bi_money ] [ b ] + interest < max_money ) bank_info [ i ] [ bi_money ] [ b ] += interest ;
						_all_interest += interest ;
					}
					else
					{
						interest = floatround ( ( bank_info [ i ] [ bi_money ] [ b ] / 1000 ) * ( tmpintrate ) ) ;
						if ( interest > 50000 ) interest = 50000 ;

						if ( bank_info [ i ] [ bi_money ] [ b ] + interest < max_money ) bank_info [ i ] [ bi_money ] [ b ] += interest ;
						_all_interest += interest ;
					}
			    }
			}
		}

		if ( p_info [ i ] [ salary ] > 0 )
		{
			tax_player += floatround ( ( p_info [ i ] [ salary ] * for_tax [ 6 ] ) / 100 ) ;
		}

		new _perk_economic = 1 ;

		#if defined m_perks
			new _perk_stats = get_perk_info ( i, PERK_ECONOMIC ) ;
			if ( _perk_stats > 0 ) _perk_economic = _perk_stats ;
		#endif

		new family_id = p_info [ i ] [ family ] ;
		foreach ( new veh_id: player_vehicles[i])
		{
		    if ( veh_info [ veh_id - 1 ] [ v_vw ] > 0 )
			{
				if ( family_id )
			    {
					if ( family_info [ family_id - 1 ] [ fam_enhancement ] [ 2 ] )
					{
					    tax_player += ( 100 / _perk_economic ) * for_tax [ 5 ] ;
					}
					else tax_player += ( 300 / _perk_economic ) * for_tax [ 5 ] ;
				}
		    	else tax_player += ( 300 / _perk_economic ) * for_tax [ 5 ] ;
			}
		    else
			{
			    if ( family_id )
			    {
					if ( family_info [ family_id - 1 ] [ fam_enhancement ] [ 2 ] )
					{
					    tax_player += ( 300 / _perk_economic ) * for_tax [ 5 ] ;
					}
					else tax_player += ( 700 / _perk_economic ) * for_tax [ 5 ] ;
				}
		    	else tax_player += ( 700 / _perk_economic ) * for_tax [ 5 ] ;
			}
		}

		if ( tax_player < 1 ) tax_player = 1 ;
		p_info [ i ] [ tax ] += tax_player ;

		new _t_string [ 144 ] ;
		if ( _pay_card == -1 )
		{
		    format ( _t_string, sizeof _t_string, "Чек: {"#cGN"}%i"valute_title"{"#cWH"}. Баланс: {"#cRD"}У Вас нет зарплатной карты{"#cWH"}", p_info [ i ] [ salary ] * ( server_bonus [ 4 ] * p_info [ i ] [ multiplication ] ) ) ;
			SendClientMessage ( i, col_white, _t_string ) ;
			format ( _t_string, sizeof _t_string, "Налог: {"#cGN"}-%i"valute_title"{"#cWH"}. Общая задолженность: {"#cGN"}-%i"valute_title_"", tax_player, p_info [ i ] [ tax ] ) ;
			SendClientMessage ( i, col_white, _t_string ) ;
   			format ( _t_string, sizeof _t_string, "Вклад в банке под: {"#cGN"}0.%i{"#cWH"} процентов", tmpintrate ) ;
			SendClientMessage ( i, col_white, _t_string ) ;
   			format ( _t_string, sizeof _t_string, "Полученные средства по банковскому вкладу: {"#cGN"}%i"valute_title_"{"#cWH"}", _all_interest ) ;
			SendClientMessage ( i, col_white, _t_string ) ;

			if ( _pay_day_5 == 1 || _pay_day_5 == 4 )
			{
				format ( _t_string, sizeof _t_string, "Помощь детям африки: {"#cGN"}%i"valute_title_"{"#cWH"}", _over_money_card * 1_000_000 ) ;
				SendClientMessage ( i, col_white, _t_string ) ;
			}
		}
		else
		{
			format ( _t_string, sizeof _t_string, "Чек: {"#cGN"}%i"valute_title"{"#cWH"}. Баланс: {"#cGN"}%i"valute_title_"{"#cWH"}", p_info [ i ] [ salary ] * ( server_bonus [ 4 ] * p_info [ i ] [ multiplication ] ), bank_info [ i ] [ bi_money ] [ _pay_card ] ) ;
			SendClientMessage ( i, col_white, _t_string ) ;
			format ( _t_string, sizeof _t_string, "Налог: {"#cGN"}-%i"valute_title"{"#cWH"}. Общая задолженность: {"#cGN"}-%i"valute_title_"", tax_player, p_info [ i ] [ tax ] ) ;
			SendClientMessage ( i, col_white, _t_string ) ;
			format ( _t_string, sizeof _t_string, "Вклад в банке под: {"#cGN"}0.%i{"#cWH"} процентов", tmpintrate ) ;
			SendClientMessage ( i, col_white, _t_string ) ;
			format ( _t_string, sizeof _t_string, "Полученные средства по банковскому вкладу: {"#cGN"}%i"valute_title_"{"#cWH"}", _all_interest ) ;
			SendClientMessage ( i, col_white, _t_string ) ;

			if ( _pay_day_5 == 1 || _pay_day_5 == 4 )
			{
				format ( _t_string, sizeof _t_string, "Помощь детям африки: {"#cGN"}%i"valute_title_"{"#cWH"}", _over_money_card * 1_000_000 ) ;
				SendClientMessage ( i, col_white, _t_string ) ;
			}
		}

		if ( fractionid > 0 && p_info [ i ] [ rank ] > 0 )
		{
		    new _rank_id = p_info [ i ] [ rank ] ;
		    if ( ! gang_player ( i ) && ! mafia_player ( i ) )
		    {
				if ( f_info [ fractionid - 1 ] [ f_money ] > f_info [ fractionid - 1 ] [ f_rang_zp ] [_rank_id - 1 ] && f_info [ fractionid - 1 ] [ f_status_zp ] == 1 )
				{
				    format ( _t_string, 128, "Премиальные (%s): {"#cGN"}%i"valute_title_"{"#cWH"}", f_info [ fractionid - 1 ] [ f_name ], f_info [ fractionid - 1 ] [ f_rang_zp ] [ _rank_id - 1 ] ) ;
					SendClientMessage ( i, col_white, _t_string ) ;
				}
				else if ( f_info [ fractionid - 1 ] [ f_money ] > f_info [ fractionid - 1 ] [ f_rang_zp ] [ _rank_id - 1 ] && f_info [ fractionid - 1 ] [ f_status_zp ] == 0 )
				{
				    if ( newhour == 20 )
				    {
				        format ( _t_string, 128, "Премиальные (%s): {"#cGN"}%i"valute_title_"{"#cWH"}", f_info [ fractionid - 1 ] [ f_name ], f_info [ fractionid - 1 ] [ f_rang_zp ] [ _rank_id - 1 ] ) ;
						SendClientMessage ( i, col_white, _t_string ) ;
				    }
				}
			}
		}

		if ( p_info [ i ] [ b_worker ] > 0 && p_info [ i ] [ business_rang ] > 0 )
		{
  			new bizz_id = p_info [ i ] [ b_worker ], bizz_rank = p_info [ i ] [ business_rang ] ;
		   	if ( b_info [ bizz_id - 1 ] [ b_money ] > b_info [ bizz_id - 1 ] [ b_salary ] [ bizz_rank - 1 ] && b_info [ bizz_id - 1 ] [ b_status_salary ] == 1 )
			{
			    format ( _t_string, 128, "Премиальные (%s): {"#cGN"}%i"valute_title_"{"#cWH"}", b_info [ bizz_id - 1 ] [ b_name ], b_info [ bizz_id - 1 ] [ b_salary ] [ bizz_rank - 1 ] ) ;
				SendClientMessage ( i, col_white, _t_string ) ;
			}
			else if ( b_info [ bizz_id - 1 ] [ b_money ] > b_info [ bizz_id - 1 ] [ b_salary ] [ bizz_rank - 1 ] && b_info [ bizz_id - 1 ] [ b_status_salary ] == 0 )
			{
    			if( newhour == 20 )
    			{
			    	format ( _t_string, 128, "Премиальные (%s): {"#cGN"}%i"valute_title_"{"#cWH"}", b_info [ bizz_id - 1 ] [ b_name ], b_info [ bizz_id - 1 ] [ b_salary ] [ bizz_rank - 1 ] ) ;
					SendClientMessage ( i, col_white, _t_string ) ;
				}
			}
		}

		#if defined m_familys
		    familys_pay_day_time ( i ) ;
		#endif

		if ( p_info [ i ] [ rent_house ] > 0 )
		{
		    new h = p_info [ i ] [ rent_house ] - 1 ;
			new _rent_price = h_info [ h ] [ h_rent_price ] ;
			if ( _pay_card == -1 )
			{
			   	p_info [ i ] [ rent_house ] = 0 ;
				//update_int_sql ( i, "u_renthouse", 0 ) ;
				SendClientMessage ( i, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы были выселены из арендуемого жилого помещения." ) ;
			}
			else
			{
		   		if ( bank_info [ i ] [ bi_money ] [ _pay_card ] >= _rent_price )
			   	{
			       	bank_info [ i ] [ bi_money ] [ _pay_card ] -= _rent_price ;
				    format ( _t_string, sizeof _t_string, "Аренда жилого помещения: {"#cGN"}%i"valute_title_"{"#cWH"}", _rent_price ) ;
					SendClientMessage ( i, col_white, _t_string ) ;

					h_info [ h ] [ h_safe_data ] [ 1 ] += _rent_price ;
				}
				else
				{
				   	p_info [ i ] [ rent_house ] = 0 ;
					//update_int_sql ( i, "u_renthouse", 0 ) ;
					SendClientMessage ( i, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы были выселены из арендуемого жилого помещения." ) ;
				}
			}
		}

		if ( _pay_card == -1 )
		{
		    SendClientMessage ( i, col_white, !" " ) ;
			SendClientMessage ( i, col_white, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет зарплатной карты, заработная плата не переведена." ) ;
		}
		else
		{
		    new newban_count = p_info [ i ] [ salary ] * ( server_bonus [ 4 ] * p_info [ i ] [ multiplication ] ) ;

	        if ( family_id )
		 	{
			 	if ( family_info [ family_id - 1 ] [ fam_enhancement ] [ 6 ] ) _max_bank_count += 10000000 ;
			}

			if ( bank_info [ i ] [ bi_money ] [ _pay_card ] + newban_count < _max_bank_count )
			{
				bank_info [ i ] [ bi_money ] [ _pay_card ] += newban_count ;
			}
			else
			{
				SendClientMessage ( i, col_white, !" " ) ;
				SendClientMessage ( i, col_white, !"{"#cRInfo"}* {"#cGRInfo"}Лимит средств на банковском счету превышен, часть заработной платы не была переведена." ) ;
			}
		}
		SendClientMessage ( i, col_white, !"{"#cYW"}-----------------------------------------------------------" ) ;

		p_info [ i ] [ salary ] = 0 ;

		if ( p_info [ i ] [ robbery_coldown ] > 0 )
		{
			p_info [ i ] [ robbery_coldown ] -- ;
			//update_int_sql ( i, "u_robbery_coldown", p_info [ i ] [ robbery_coldown ] ) ;
		}

		new player_level = p_info [ i ] [ level ], _exp ;
		if ( ( player_level >= promo_level && player_level < promo_llevel ) && p_info [ i ] [ promo_used ] )
		{
		    if ( family_id )
		    {
		    	if ( family_info [ family_id - 1 ] [ fam_enhancement ] [ 0 ] )
		    	{
		    	    _exp += double_exp_player + random ( 1 ) + 1 + 1 * ( server_bonus [ 0 ] * p_info [ i ] [ multiplication ] ) ;
		    	}
		    	else _exp += double_exp_player + 1 + 1 * ( server_bonus [ 0 ] * p_info [ i ] [ multiplication ] ) ;
			}
			else _exp += double_exp_player + 1 + 1 * ( server_bonus [ 0 ] * p_info [ i ] [ multiplication ] ) ;
		}
		else
		{
			if ( family_id )
		    {
		    	if ( family_info [ family_id - 1 ] [ fam_enhancement ] [ 0 ] )
		    	{
		    	    _exp += double_exp_player + random ( 1 ) + 1 + 1 * ( server_bonus [ 0 ] * p_info [ i ] [ multiplication ] ) ;
		    	}
		    	else _exp += double_exp_player + 1 * ( server_bonus [ 0 ] * p_info [ i ] [ multiplication ] ) ;
			}
			else _exp += double_exp_player + 1 * ( server_bonus [ 0 ] * p_info [ i ] [ multiplication ] ) ;
		}

		rewards_exp ( i, _exp, true ) ;
		rewards_promo ( i ) ;

		for ( new b = 0 ; b < MAX_BANK_ACCOUNT ; b ++ )
		{
		    if ( ! bank_info [ i ] [ bi_type ] [ b ] ) continue ;

		    if ( _over_money_card > 1 && ( _pay_day_5 == 1 || _pay_day_5 == 4 ) )
			{
				if ( bank_info [ i ] [ bi_money ] [ b ] > max_money - 1_000_000_000 ) bank_info [ i ] [ bi_money ] [ b ] -= 1_000_000 ;
			}

		    format ( _t_string, sizeof ( _t_string ), "UPDATE `deposit_boxes` SET `db_money` = '%d' WHERE `db_id` = '%i' LIMIT 1",
			bank_info [ i ] [ bi_money ] [ b ], bank_info [ i ] [ bi_id ] [ b ] ) ;
			mysql_tquery ( sql_connection, _t_string ) ;
		}

		p_info [ i ] [ org_date ] ++ ;
		if ( army_player ( i ) )
		{
		    if ( p_info [ i ] [ org_date ] < 15 )
			{
				if ( GetInventoryFindItem ( i, SUB_INVENTORY, ITEM_MILITARY_ID ) < 1 )
				{
				    format ( _t_string, sizeof _t_string, "До получения военного билета осталось {"#cGN"}%d {"#cWH"}часов.", 15 - p_info [ i ] [ org_date ] ) ;
				    SendClientMessage ( i, col_white, _t_string ) ;
				}
			}
			else
			{
				if ( p_info [ i ] [ rank ] > 2 && GetInventoryFindItem ( i, SUB_INVENTORY, ITEM_MILITARY_ID ) < 1 )
				{
					_t_string [ 0 ] = EOS ;
					format ( _t_string, 24, "%d%d%d%d%d%d",
						RandomEx ( 1, 9 ), RandomEx ( 1, 9 ), RandomEx ( 1, 9 ), RandomEx ( 1, 9 ), RandomEx ( 1, 9 ), RandomEx ( 1, 9 ) ) ;

					give_inventory ( i, ITEM_MILITARY_ID, 1, 0, "", _t_string, NUMBERPLATE_TYPE_NONE, -1 ) ;

					_t_string [ 0 ] = EOS ;
					format ( _t_string, sizeof _t_string, "* Вам в инвентарь был добавлен предмет '%s'.", item_name ( 171 ) ) ;
					SendClientMessage ( i, col_yellow, _t_string ) ;

					#if defined m_fractions
					    give_emp_progress ( i, 6, 1 ) ;
					#endif
				}
			}
		}

		if ( p_info [ i ] [ law_obedience ] < 100 )
		{
			if ( army_player ( i ) ) p_info [ i ] [ law_obedience ] += 2 ;
			else p_info [ i ] [ law_obedience ] ++ ;
		}

		if ( p_info [ i ] [ hunger_immune_time ] > 0 )
		{
		    if ( -- p_info [ i ] [ hunger_immune_time ] == 0 )
			{
			    p_info [ i ] [ hunger_immune ] = 0 ;

		    	format ( _t_string, sizeof _t_string, "UPDATE `users` SET `u_hungerimmunetime` = '0', `u_hungerimmune` = '0' WHERE `u_id` = '%d' LIMIT 1", p_info [ i ] [ id ] ) ;
		    	mysql_tquery ( sql_connection, _t_string, "", "" ) ;
			}
			else
			{
			    format ( _t_string, sizeof ( _t_string ), "{"#cGInfo"}* {"#cWH"}До конца бесконечной сытости осталось: {"#cGN"}%d{"#cWH"} час(ов).", p_info [ i ] [ hunger_immune_time ] ) ;
		    	SendClientMessage ( i, col_white, _t_string ) ;

		    	//update_int_sql ( i, "u_hungerimmunetime", p_info [ i ] [ hunger_immune_time ] ) ;
			}
		}

		if ( p_info [ i ] [ multiplication_time ] > 0 )
		{
		    if ( -- p_info [ i ] [ multiplication_time ] == 0 )
			{
			    p_info [ i ] [ multiplication ] = 1 ;

		    	format ( _t_string, sizeof _t_string, "UPDATE `users` SET `u_multiplication_time` = '0', `u_multiplication` = '1' WHERE `u_id` = '%d' LIMIT 1", p_info [ i ] [ id ] ) ;
		    	mysql_tquery ( sql_connection, _t_string, "", "" ) ;
			}
			else
			{
			    format ( _t_string, sizeof ( _t_string ), "{"#cGInfo"}* {"#cWH"}До конца действия 'x%d PayDay, x%d з/п на квестах' осталось: {"#cGN"}%d{"#cWH"} час(ов).", p_info [ i ] [ multiplication ], p_info [ i ] [ multiplication ], p_info [ i ] [ multiplication_time ] ) ;
		    	SendClientMessage ( i, col_white, _t_string ) ;

		    	//update_int_sql ( i, "u_multiplication_time", p_info [ i ] [ multiplication_time ] ) ;
			}
		}

		if ( double_donate_player )
		{
		   	format ( _t_string, 100, "{"#cGInfo"}* {"#cWH"}Вы получили {"#cGN"}+%d{"#cWH"} "donate_title".", double_donate_player ) ;
		   	SendClientMessage ( i, col_white, _t_string ) ;

		   	give_player_donate ( i, double_donate_player, 2 ) ;
			insert_donate_log ( i, INVALID_PLAYER_ID, double_donate_player, p_info [ i ] [ donate ], "(donate) пополнение PayDay" ) ;
		}
		else
		{
		    if ( time_to_donate > 0 && _vip )
			{
			    if ( time_to_donate == 1 ) SendClientMessage ( i, col_white, !"{"#cGInfo"}* {"#cWH"}В следующем часу Вы получите "donate_title"." ) ;
				else
				{
			    	format ( _t_string, 100, "{"#cGInfo"}* {"#cWH"}До получения "donate_title" осталось: {"#cGN"}%d{"#cWH"} час(ов).", time_to_donate ) ;
			   		SendClientMessage ( i, col_white, _t_string ) ;
				}
			}
		}

		if ( double_family_talon )
		{
		   	SendClientMessage ( i, col_white, !"{"#cGInfo"}* {"#cWH"}Вы получили {"#cGN"}+1{"#cWH"} "family_title"." ) ;

		   	give_inventory (
				i,
				ITEM_FAMILY_TALON,
				1,
				0,
				"",
				"",
				NUMBERPLATE_TYPE_NONE,
				0,
				-1
			) ;
		}
		else
		{
		    if ( time_to_talon > 0 )
		    {
			    if ( time_to_talon == 1 ) SendClientMessage ( i, col_white, !"{"#cGInfo"}* {"#cWH"}В следующем часу Вы получите "family_title"." ) ;
				else
				{
			    	format ( _t_string, 100, "{"#cGInfo"}* {"#cWH"}До получения "family_title" осталось: {"#cGN"}%d{"#cWH"} час(ов).", time_to_talon ) ;
			   		SendClientMessage ( i, col_white, _t_string ) ;
				}
			}
		}


		if ( gang_player ( i ) )
		{
		    format ( _t_string, 128, "[F] В общак начислен бонус %i"valute_title_" за подконтрольные территории.", total_territory [ fractionid - 18 ] * 500 ) ;
			SendClientMessage ( i, col_lblue, _t_string ) ;

		    format ( _t_string, 128, "[F] В общак начислен бонус %i"valute_title_" за граффити на районах.", total_graf [ fractionid - 18 ] * 250 ) ;
			SendClientMessage ( i, col_lblue, _t_string ) ;
		}

		if ( p_info [ i ] [ blocked_leader ] > 0 && p_info [ i ] [ blocked_leader ] != 255 )
		{
		    p_info [ i ] [ blocked_leader ] -= 1 ;

			format ( _t_string, 100, "{"#cGInfo"}* {"#cWH"}До снятия лидерской блокировки осталось: {"#cGN"}%d{"#cWH"} час(ов).", p_info [ i ] [ blocked_leader ] ) ;
			SendClientMessage ( i, col_white, _t_string ) ;
		}

		if ( p_info [ i ] [ blocked_adm ] > 0 && p_info [ i ] [ blocked_adm ] != 255 )
		{
		    p_info [ i ] [ blocked_adm ] -= 1 ;

			format ( _t_string, 100, "{"#cGInfo"}* {"#cWH"}До снятия админской блокировки осталось: {"#cGN"}%d{"#cWH"} час(ов).", p_info [ i ] [ blocked_adm ] ) ;
			SendClientMessage ( i, col_white, _t_string ) ;
		}

		licenses_sanction ( i ) ;
		if ( newhour != 0 ) gettime_clear ( i ) ;
		else
		{
		    p_info [ i ] [ online_player ] [ 1 ] = p_info [ i ] [ online_player ] [ 0 ] ;
			p_info [ i ] [ online_player_afk ] [ 1 ] = p_info [ i ] [ online_player_afk ] [ 0 ] ;

			p_info [ i ] [ online_player ] [ 0 ] =
			p_info [ i ] [ online_player_afk ] [ 0 ] = 0 ;

			check_today_time [ i ] = false ;
			check_day_report [ i ] = false ;

			gettime_clear ( i, 1 ) ;
		}

		global_string [ 0 ] = EOS ;
		format ( global_string, 512, "UPDATE `users` SET `u_multiplication_time` = '%d', `u_hungerimmunetime` = '%d',\
												`u_robbery_coldown` = '%d', `u_renthouse` = '%d', `u_player_payday` = '%d|%d', `u_block_leader` = '%d',\
												`u_block_adm` = '%d' WHERE `u_id` = '%d' LIMIT 1",
		p_info [ i ] [ multiplication_time ], p_info [ i ] [ hunger_immune_time ],
		p_info [ i ] [ robbery_coldown ], p_info [ i ] [ rent_house ], _pay_day_5, player_payday_3 { i },
		p_info [ i ] [ blocked_leader ], p_info [ i ] [ blocked_adm ], p_info [ i ] [ id ] ) ;
		mysql_tquery ( sql_connection, global_string ) ;
	}

	save_all ( ) ;
	return 1 ;
}

public OnDynamicObjectMoved ( objectid )
{
	#if defined m_quest
	    if ( quest_OnDynamicObjectMoved ( objectid ) ) return 1 ;
	#endif

	#if defined m_familys
	    if ( familys_OnDynamicObjectMoved ( objectid ) ) return 1 ;
	#endif

 	if ( airdrop_object [ 0 ] == objectid && airdrop_from_earth == false )
	{
	    new Float: object_x,
			Float: object_y,
			Float: object_z,
			index = -1 ;

		GetDynamicObjectPos ( airdrop_object [ 0 ], object_x, object_y, object_z ) ;
		index = object_z == air_info [ airdrop_number ] [ move_position ] [ 2 ] ? 0 : 1 ;

		if ( ! index )
		{
			if ( IsValidDynamicObject ( airdrop_object [ 1 ] ) )
			{
				DestroyDynamicObject ( airdrop_object [ 1 ] ) ;
				airdrop_object [ 1 ] = INVALID_OBJECT_ID ;
			}

			if ( IsValidDynamicObject ( airdrop_object [ 2 ] ) )
			{
				DestroyDynamicObject ( airdrop_object [ 2 ] ) ;
				airdrop_object [ 2 ] = INVALID_OBJECT_ID ;
			}

			airdrop_from_earth = true ;
		}
		else airdrop_from_earth = false ;
	}
	return 1 ;
}

callback: second_timer ( )
{
	new hor, m, s ;
	gettime ( hor, m, s ) ;

	if ( m == 0 && s >= 11 && s <= 16 ) pay_day = false ;
   	if ( m == 0 && s >= 0 && s <= 10 && pay_day == false )
   	{
   	    if ( conf_kd > 0 ) conf_kd -- ;

   	    pay_day = true ;
   	    SetWorldTime ( hor ) ;

   	    #if defined m_familys
   	        familys_second_timer ( 2, hor ) ;
   	        clear_fam_house ( -1, -1, 2 ) ;
		#endif

		for ( new i = 0 ; i < MAX_BANKS ; i ++ )
		{
		    if ( bank_time_cd [ i ] > 0 )
			{
				bank_time_cd [ i ] -- ;
				if ( bank_time_cd [ i ] == 1 ) bank_status [ i ] = 3 ;
			}
		}

		global_weather = 4 ;

   	    pay_day_time ( ) ;

   	    #if defined m_inventory_module
			if ( GetInventoryFindItem ( 15, SUB_INV_FRACTION, 172 ) < 1000 )
			{
				new USERS_INVENTORY_STRUCT: inventoryStruct [ _:INV_STRUCTURE_MAX ] ;
				inventoryStruct [ _:INV_ITEM ] = 172 ;
				inventoryStruct [ _:INV_ITEM_COUNT ] = 100 ;
				inventoryStruct [ _:INV_ITEM_TYPE ] = 0 ;
				inventoryStruct [ _:INV_ITEM_REGION ] = "" ;
				inventoryStruct [ _:INV_ITEM_PLATE ] = "" ;
				inventoryStruct [ _:INV_ITEM_PLATE_TYPE ] = NUMBERPLATE_TYPE_NONE ;
				inventoryStruct [ _:INV_ITEM_GIVE_DATE ] = 0 ;
				inventoryStruct [ _:INV_ITEM_ID ] = 0 ;
				inventoryStruct [ _:INV_ITEM_DATE ] = -1 ;
				give_fraction_item ( 15, -1, inventoryStruct ) ;
			}
			if ( GetInventoryFindItem ( 4, SUB_INV_FRACTION, 334 ) < 1000 )
			{
				new USERS_INVENTORY_STRUCT: inventoryStruct [ _:INV_STRUCTURE_MAX ] ;
				inventoryStruct [ _:INV_ITEM ] = 334 ;
				inventoryStruct [ _:INV_ITEM_COUNT ] = 100 ;
				inventoryStruct [ _:INV_ITEM_TYPE ] = 0 ;
				inventoryStruct [ _:INV_ITEM_REGION ] = "" ;
				inventoryStruct [ _:INV_ITEM_PLATE ] = "" ;
				inventoryStruct [ _:INV_ITEM_PLATE_TYPE ] = NUMBERPLATE_TYPE_NONE ;
				inventoryStruct [ _:INV_ITEM_GIVE_DATE ] = 0 ;
				inventoryStruct [ _:INV_ITEM_ID ] = 0 ;
				inventoryStruct [ _:INV_ITEM_DATE ] = -1 ;
				give_fraction_item ( 4, -1, inventoryStruct ) ;
			}
			if ( GetInventoryFindItem ( 5, SUB_INV_FRACTION, 334 ) < 1000 )
			{
				new USERS_INVENTORY_STRUCT: inventoryStruct [ _:INV_STRUCTURE_MAX ] ;
				inventoryStruct [ _:INV_ITEM ] = 334 ;
				inventoryStruct [ _:INV_ITEM_COUNT ] = 100 ;
				inventoryStruct [ _:INV_ITEM_TYPE ] = 0 ;
				inventoryStruct [ _:INV_ITEM_REGION ] = "" ;
				inventoryStruct [ _:INV_ITEM_PLATE ] = "" ;
				inventoryStruct [ _:INV_ITEM_PLATE_TYPE ] = NUMBERPLATE_TYPE_NONE ;
				inventoryStruct [ _:INV_ITEM_GIVE_DATE ] = 0 ;
				inventoryStruct [ _:INV_ITEM_ID ] = 0 ;
				inventoryStruct [ _:INV_ITEM_DATE ] = -1 ;
				give_fraction_item ( 5, -1, inventoryStruct ) ;
			}
   	    #endif

		#if defined m_profiler
			Profiler_Dump ( ) ;
		#endif

	 	if ( hor == 0 )
	 	{
			clearTruckerProgress ( 0 ) ;
	 	    if ( GetElapsedTime ( gettime ( ), week_gettime, CONVERT_TIME_TO_WEEKS ) > 0 )
			{
			    week_gettime = gettime ( ) ; // приравниваем воскресенье
				clearTruckerProgress ( 1 ) ;

			    #if defined m_familys
				    clear_week_family_quest ( ) ;
				#endif

		        new sql_string [ 81 + 9 ] ;
				format ( sql_string, sizeof sql_string, "UPDATE `server_variables` SET `var_count` = '%d' WHERE `var_id` = '67' LIMIT 1", week_gettime ) ;
				mysql_tquery ( sql_connection, sql_string ) ;

				mysql_tquery ( sql_connection, !"SELECT `f_id`,`f_money_statistic`,`f_money_statistic_minus` FROM `fractions`", "fractions_profits", "" ) ;
			}

			if ( GetElapsedTime ( gettime ( ), three_week_gettime, CONVERT_TIME_TO_WEEKS ) > 3 )
			{
			    three_week_gettime = gettime ( ) ;

		        new sql_string [ 81 + 9 ] ;
				format ( sql_string, sizeof sql_string, "UPDATE `server_variables` SET `var_count` = '%d' WHERE `var_id` = '70' LIMIT 1", three_week_gettime ) ;
				mysql_tquery ( sql_connection, sql_string ) ;
			}

			if ( GetElapsedTime ( gettime ( ), month_gettime, CONVERT_TIME_TO_MONTHS ) > 0 )
			{
			    month_gettime = gettime ( ) ; // приравниваем 1ое число месяца
				clearTruckerProgress ( 2 ) ;

		        new sql_string [ 81 + 9 ] ;
				format ( sql_string, sizeof sql_string, "UPDATE `server_variables` SET `var_count` = '%d' WHERE `var_id` = '68' LIMIT 1", month_gettime ) ;
				mysql_tquery ( sql_connection, sql_string ) ;

				mysql_tquery ( sql_connection, !"UPDATE `businesses` SET `b_freeze_day` = '7'" ) ;
				mysql_tquery ( sql_connection, !"UPDATE `houses` SET `h_freeze_day` = '7'" ) ;
			}

			update_twelve_hour ( ) ;

			#if defined m_epass
			    update_twelve_hour_eventpass ( ) ;
			#endif

	 	    /*foreach(new i: logged_players)
	 	    {
				p_info [ i ] [ online_player ] [ 1 ] = p_info [ i ] [ online_player ] [ 0 ] ;
				p_info [ i ] [ online_player_afk ] [ 1 ] = p_info [ i ] [ online_player_afk ] [ 0 ] ;

				p_info [ i ] [ online_player ] [ 0 ] =
				p_info [ i ] [ online_player_afk ] [ 0 ] = 0 ;

				check_today_time [ i ] = false ;
				check_day_report [ i ] = false ;

				gettime_clear ( i, 1 ) ;
			}*/
	 	}

	 	else if ( hor == 18 )
	 	{
	 	    if ( GetElapsedTime ( gettime ( ), week_gettime, CONVERT_TIME_TO_DAYS ) == 5 )
	 	    {
				foreach(new b: business_types[bizz_type_casino])
				{
		            new sql_string [ 126 + 9 ] ;
					format ( sql_string, sizeof sql_string, "SELECT `u_id`,`u_name` FROM `users_casino_hoax` WHERE `u_casino` = '%d' ORDER BY RAND() LIMIT 1", b_info [ b - 1 ] [ b_id ] ) ;
		 	    	mysql_tquery ( sql_connection, sql_string, "casino_hoax_callback", "d", b ) ;

					format ( sql_string, sizeof sql_string, "SELECT `u_id`,`u_name` FROM `users_casino` WHERE `u_casino` = '%d' ORDER BY `users_casino`.`u_activity_casino` DESC LIMIT 1", b_info [ b - 1 ] [ b_id ] ) ;
		 	    	mysql_tquery ( sql_connection, sql_string, "casino_itog_callback", "d", b ) ;
				}
			}
	 	}

	 	if ( hor == 21 )
	 	{
	 	    new sql_string [ 65 + 9 ], _random = random ( 9000 ) + 1000 ;
			format ( sql_string, sizeof sql_string, "SELECT * FROM `users_lottery` WHERE `u_lottery` = '%d' LIMIT 1", _random ) ;
	 	    mysql_tquery ( sql_connection, sql_string, "lottery_itog_callback", "d", _random ) ;
	 	}

		if ( hor == 4 )
		{
			SendClientMessageToAll ( col_yellow, !"* Происходит технический рестарт сервера. Процесс займет несколько минут." ) ;
			for ( new i = 0 ; i < MAX_PLAYERS ; i ++ )
			{
				kick_player ( i ) ;
			}

			mysql_tquery ( sql_connection, !"UPDATE `businesses` SET `b_freeze` = `b_freeze` - '1' WHERE `b_freeze` > 0" ) ;
			mysql_tquery ( sql_connection, !"UPDATE `houses` SET `h_freeze` = `h_freeze` - '1' WHERE `h_freeze` > 0" ) ;

			new sql_string [ 128 ] ;
			format ( sql_string, sizeof sql_string, "SELECT `u_id`, `u_vip`, `u_name` FROM `users` WHERE `u_vip_day` != '0' AND `u_vip_day` < '%d'", gettime ( ) ) ;
			mysql_tquery ( sql_connection, sql_string, "callback_reset_vip_player", "" ) ;

			format ( sql_string, sizeof sql_string, "SELECT `u_id`, `u_tax` FROM `users` WHERE `u_tax` > '%d'", tax_limit_auto ) ;
			mysql_tquery ( sql_connection, sql_string, "callback_reset_property", "ii", 1, true ) ;

			format ( sql_string, sizeof sql_string, "SELECT * FROM `deposit_boxes` WHERE `db_reset` != '0' AND `db_reset` < '%d'", gettime ( ) ) ;
			mysql_tquery ( sql_connection, sql_string, "callback_deposit_reset_date", "" ) ;

			#if defined m_credit
				mysql_tquery ( sql_connection, !"SELECT * FROM `businesses_credit` WHERE `db_date` < NOW()-INTERVAL 3 DAY", "callback_delite_credit", "" ) ;
				mysql_tquery ( sql_connection, !"SELECT * FROM `deposit_boxes` WHERE `db_credit_day` > 0", "callback_credit_day", "" ) ;
			#endif

			auto_clear ( ) ;
			Bl_Clear ( ) ;

			format ( sql_string, sizeof sql_string, "SELECT `inv_id`, `inv_item` FROM `users_inventory` WHERE `inv_date` != '-1' AND `inv_date` < '%d'", gettime ( ) ) ;
			mysql_tquery ( sql_connection, sql_string, "clear_users_inventory", "" ) ;

			save_all ( ) ;

			SetGameModeText ( "RESTART" ) ;
			SendRconCommand ( "password q1w2e3" ) ;

			SetTimer ( "restart_timer", 300000, 0 ) ;
		}
  	}

 	for ( new veh = 0 ; veh < MAX_VEHICLES ; veh ++ )
	{
		if ( ! IsValidVehicle ( veh ) ) continue ;

		if ( veh_info [ veh - 1 ] [ v_now_pos ] [ 0 ] != 0 && veh_info [ veh - 1 ] [ v_now_pos ] [ 1 ] != 0 && veh_info [ veh - 1 ] [ v_now_pos ] [ 2 ] != 0 && veh_info [ veh - 1 ] [ v_driver ] != INVALID_PLAYER_ID )
		{
			new Float:_distance = GetVehicleDistanceFromPoint ( veh, veh_info [ veh - 1 ] [ v_now_pos ] [ 0 ], veh_info [ veh - 1 ] [ v_now_pos ] [ 1 ], veh_info [ veh - 1 ] [ v_now_pos ] [ 2 ] ) ;
			if ( _distance / 1000 < 5 )	veh_info [ veh - 1 ] [ v_millage ] += _distance / 1000 ;
		}

		GetVehiclePos ( veh, veh_info [ veh - 1 ] [ v_now_pos ] [ 0 ], veh_info [ veh - 1 ] [ v_now_pos ] [ 1 ], veh_info [ veh - 1 ] [ v_now_pos ] [ 2 ] ) ;
		if ( GetEngineStatus ( veh ) == 1 && ! v_plane ( veh ) && ! v_boat ( veh ) )
		{
			if ( veh_info [ veh - 1 ] [ v_fuel ] > 0 )
			{
			    new Float: _fuel = 0.03 ;
			    if ( veh_info [ veh - 1 ] [ v_millage ] > 100 ) _fuel = _fuel + ( veh_info [ veh - 1 ] [ v_millage ] / 100000 ) ;
				veh_info [ veh - 1 ] [ v_fuel ] -= _fuel ;
			}
			if ( veh_info [ veh - 1 ] [ v_fuel ] > 0.5 && veh_info [ veh - 1 ] [ v_fuel ] < 0.6 )
			{
				new engine, lights, alarm, doors, bonnet, boot, objective ;
				GetVehicleParamsEx ( veh, engine, lights, alarm, doors, bonnet, boot, objective ) ;

				SetVehicleParamsEx ( veh, VEHICLE_PARAMS_OFF, lights, alarm, doors, bonnet, boot, objective ) ;
				veh_info [ veh - 1 ] [ v_fuel ] = 0.0 ;
			}
		}

		if ( veh_info [ veh - 1 ] [ v_test_drive ] == true )
		{
			if ( veh_info [ veh - 1 ] [ v_driver ] == INVALID_PLAYER_ID )
			{
			    if ( ++ veh_info [ veh - 1 ] [ v_spawn_time ] > 3 )
			    {
			        veh_info [ veh - 1 ] [ v_spawn_time ] = 0 ;
					veh_info [ veh - 1 ] [ v_test_drive ] = false ;
					DestroyVehicle ( veh, 5000 ) ;
				}
			}
		}

		if ( veh_info [ veh - 1 ] [ v_type ] == vehicle_type_player )
		{
			/*if ( veh_info [ veh - 1 ] [ v_spawn_time ] < gettime ( ) && ! v_plane ( veh ) && ! v_boat ( veh ) )
			{
				for ( new j = 0 ; j < MAX_NONPARKING_ZONES ; j ++ )
				{
				    if ( IsVehicleInQuad ( veh_info [ veh - 1 ] [ v_now_pos ] [ 0 ], veh_info [ veh - 1 ] [ v_now_pos ] [ 1 ],
											non_parking_pos [ j ] [ 0 ], non_parking_pos [ j ] [ 1 ],
											non_parking_pos [ j ] [ 2 ], non_parking_pos [ j ] [ 3 ] ) && veh_info [ veh - 1 ] [ v_fine ] == 0 )
					{
		   				new query_string [ 156 ] ;
						format ( query_string, sizeof ( query_string ),"UPDATE `users_vehicles` SET `v_fuel` = '%f',`v_millage` = '%f' WHERE `v_id` = '%d' LIMIT 1",
						veh_info [ veh - 1 ] [ v_fuel ],
						veh_info [ veh - 1 ] [ v_millage ],
						veh_info [ veh - 1 ] [ v_id ] ) ;
						mysql_tquery ( sql_connection, query_string, "", "" ) ;

						new playerid = -1 ;
						foreach(new i: logged_players)
						{
							if ( veh_info [ veh - 1 ] [ v_owner ] == p_info [ i ] [ id ] )
							{
								playerid = i ;
								break ;
							}
						}

				        Iter_Remove(player_vehicles[playerid], veh ) ;
						show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Информация", "{"#cRD"}ВНИМАНИЕ!\n\n{"#cRD"}ОДИН ИЗ ВАШИХ АВТОМОБИЛЕЙ БЫЛ ВЫГРУЖЕН С СЕРВЕРА\nЗА ПАРОВКУ В НЕ ПАРКОВОЧНОЙ ЗОНЫ.", "Закрыть", "" ) ;

						DestroyVehicle ( veh, 70 ) ;
					}
				}
			}*/

			if ( veh_info [ veh - 1 ] [ v_sell_price ] < 1 && IsValidDynamic3DTextLabel ( veh_info [ veh - 1 ] [ v_sell_text ] ) )
			{
				DestroyDynamic3DTextLabel ( veh_info [ veh - 1 ] [ v_sell_text ] ) ;
				veh_info [ veh - 1 ] [ v_sell_text ] = Text3D:INVALID_3DTEXT_ID ;
			}

			if ( veh_info [ veh - 1 ] [ v_fine_time ] > 0 )
			{
			    if ( veh_info [ veh - 1 ] [ v_driver ] != INVALID_PLAYER_ID )
			    {
			        veh_info [ veh - 1 ] [ v_fine_time ] = 0 ;
			        continue ;
			    }

				veh_info [ veh - 1 ] [ v_fine_time ] -- ;
				if ( veh_info [ veh - 1 ] [ v_fine_time ] == 1 && ! v_plane ( veh ) && ! v_boat ( veh ) )
				{
				    new query_string [ 156 ] ;
					format ( query_string, sizeof ( query_string ),"UPDATE `users_vehicles` SET `v_fuel` = '%f',`v_millage` = '%f',`v_fine` = '1' WHERE `v_id` = '%d' LIMIT 1",
					veh_info [ veh - 1 ] [ v_fuel ],
					veh_info [ veh - 1 ] [ v_millage ],
					veh_info [ veh - 1 ] [ v_id ] ) ;
					mysql_tquery ( sql_connection, query_string, "", "" ) ;

					new playerid = veh_info [ veh - 1 ] [ v_owner_id ] ;
					if ( playerid != INVALID_PLAYER_ID && veh_info [ veh - 1 ] [ v_owner ] == p_info [ playerid ] [ id ] )
					{
						Iter_Remove(player_vehicles[playerid], veh ) ;
						show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Информация", "{"#cRD"}ВНИМАНИЕ!\n\n{"#cRD"}ОДИН ИЗ ВАШИХ АВТОМОБИЛЕЙ НАХОДИТСЯ НА ШТРАФСТОЯНКЕ\n{"#cRD"}ВЫ НЕ УСПЕЛИ ОТОГНАТЬ ЕГО\n{"#cBL"}Чтобы забрать используйте {"#cWH"}'/gps > Прочее > Штрафстоянка'{"#cBL"}.", "Закрыть", "" ) ;
					}

					DestroyVehicle ( veh, 9 ) ;
				}
			}
		}
