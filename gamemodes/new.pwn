            new fraction_id ;
	     	if ( p_info [ playerid ] [ leader ] > 0 ) fraction_id = p_info [ playerid ] [ member ] ;
			else fraction_id = player_settings { playerid } ;

			if ( fraction_id < 0 ) return 1 ;

			new _pl_filter = strval ( inputtext ) ;
			if ( _pl_filter < 1 || _pl_filter > f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 0 ] )return show_dialog ( playerid, d_offmembers_filter, DIALOG_STYLE_INPUT, "{"#cBHD"}Члены организации", "{"#cRD"}* Неверный номер ранга!\n\n{FFFFFF}Введите ранг для фильтра:", "Далее", "Назад" ) ;
			SetPVarInt ( playerid, "ofm_type", _pl_filter ) ;

			membersOffline ( playerid, 0, 1 ) ;
			return 1 ;
		}
		case d_offmembers_list:
		{
			if ( ! response )
			{
				for ( new i = 0 ; i < 10 ; i ++ )
				{
					new pvar_string [ 8 ] ;
					format ( pvar_string, sizeof ( pvar_string ), "ofm_%d", i ) ;
					DeletePVar ( playerid, pvar_string ) ;
				}
				page_count [ playerid ] = 0 ;
				page_rows [ playerid ] = 0 ;
				DeletePVar ( playerid, "ofm_listitem" ) ;
				DeletePVar ( playerid, "ofm_type" ) ;
				show_dialog ( playerid, d_offmembers_selection, DIALOG_STYLE_LIST, "{"#cBHD"}Члены организации", "{FFFFFF}Все члены организации оффлайн\nФильтр по рангу", "Выбрать", "Назад" ) ;
				return 1 ;
			}

			if ( GetString ( inputtext, "Предыдущая страница" ) ) membersOffline ( playerid, page_count [ playerid ] - 1, 1 ) ;
			else if ( GetString ( inputtext, "Следующая страница" ) ) membersOffline ( playerid, page_count [ playerid ] + 1, 1 ) ;
			else
			{
				new pvar_string [ 38 ], pl_name [ MAX_PLAYER_NAME ] ;
				format ( pvar_string, sizeof ( pvar_string ), "ofm_%d", listitem ) ;
				GetPVarString ( playerid, pvar_string, pl_name, MAX_PLAYER_NAME ) ;
				SetPVarInt ( playerid, "ofm_listitem", listitem ) ;

				show_offmembers_dialog ( playerid, pl_name, 0 ) ;
			}
			return 1 ;
		}
		case d_offmembers_pl_menu:
		{
			if ( ! response )
			{
				membersOffline ( playerid, page_count [ playerid ], 1 ) ;
				return 1 ;
			}
			switch ( listitem )
			{
				case 0:
				{
					new pvar_string [ 38 ], pl_name [ MAX_PLAYER_NAME ] ;
					format ( pvar_string, sizeof ( pvar_string ), "ofm_%d", GetPVarInt ( playerid, "ofm_listitem" ) ) ;
					GetPVarString ( playerid, pvar_string, pl_name, MAX_PLAYER_NAME ) ;

					new query_string [ 200 ] ;
					mysql_format ( sql_connection, query_string, sizeof query_string, "\
					SELECT \
						fp.u_rank, \
						fp.u_fraction_date, \
						u.u_last_date \
					FROM users u \
					LEFT JOIN fractions_players fp ON fp.u_sql_id=u.u_id \
					WHERE u.u_name = '%s' LIMIT 1", pl_name ) ;
					mysql_tquery ( sql_connection, query_string, "callback_offmembers_info", "i", playerid ) ;
				}
				case 1:
				{
				    new pvar_string [ 38 ],
						pl_name [ MAX_PLAYER_NAME ] ;
					format ( pvar_string, sizeof ( pvar_string ), "ofm_%d", GetPVarInt ( playerid, "ofm_listitem" ) ) ;
					GetPVarString ( playerid, pvar_string, pl_name, MAX_PLAYER_NAME ) ;

				    if ( get_player_leader ( pl_name, p_info [ playerid ] [ member ] ) )
					{
						SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нельзя уволить лидера!" ) ;

						membersOffline ( playerid, page_count [ playerid ], 1 ) ;
						return 1 ;
					}
					show_dialog ( playerid, d_offmembers_pl_uninvite, DIALOG_STYLE_INPUT, "{"#cBHD"}Увольнение игрока", "{FFFFFF}Введите причину увольнения:\n\n{"#cGRDialog"}* Минимальное количество символов 3, максимальное 24", "Выбрать", "Назад" ) ;
				}
				case 2:
				{
				    new pvar_string [ 38 ],
						pl_name [ MAX_PLAYER_NAME ] ;
					format ( pvar_string, sizeof ( pvar_string ), "ofm_%d", GetPVarInt ( playerid, "ofm_listitem" ) ) ;
					GetPVarString ( playerid, pvar_string, pl_name, MAX_PLAYER_NAME ) ;

				    if ( get_player_leader ( pl_name, p_info [ playerid ] [ member ] ) )
					{
						SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нельзя изменить ранг лидеру!" ) ;

						membersOffline ( playerid, page_count [ playerid ], 1 ) ;
						return 1 ;
					}
					show_dialog ( playerid, d_offmembers_pl_rank, DIALOG_STYLE_INPUT, "{"#cBHD"}Изменение ранга игрока", "{FFFFFF}Введите номер ранга, который хотите установить для игрока:", "Выбрать", "Назад" ) ;
				}
				case 3:
				{
				    new pvar_string [ 38 ],
						pl_name [ MAX_PLAYER_NAME ] ;
					format ( pvar_string, sizeof ( pvar_string ), "ofm_%d", GetPVarInt ( playerid, "ofm_listitem" ) ) ;
					GetPVarString ( playerid, pvar_string, pl_name, MAX_PLAYER_NAME ) ;

					getMembersPlayerLogs ( playerid, pl_name, page_count [ playerid ], 1 ) ;
				}
				case 4:
				{
				    new pvar_string [ 38 ],
						pl_name [ MAX_PLAYER_NAME ] ;
					format ( pvar_string, sizeof ( pvar_string ), "ofm_%d", GetPVarInt ( playerid, "ofm_listitem" ) ) ;
					GetPVarString ( playerid, pvar_string, pl_name, MAX_PLAYER_NAME ) ;

				    page_count [ playerid ] = 1 ;
				    new _account_id = get_player_account_id ( pl_name ) ;

					new query_string [ 80 + MAX_PLAYER_NAME ];
					format ( query_string, sizeof query_string, "SELECT * FROM `users_online` WHERE `accountid` = '%d' ORDER BY `users_online`.`id` DESC", _account_id ) ;
					mysql_tquery ( sql_connection, query_string, "offtime_callback", "i", playerid ) ;

					off_time_account [ playerid ] = _account_id ;
					off_time_status { playerid } = 1 ;

					DeletePVar ( playerid, "ofm_listitem" ) ;
				}
			}
			return 1 ;
		}
		case d_offmembers_pl_uninvite:
		{
		    new pvar_string [ 38 ], pl_name [ MAX_PLAYER_NAME ] ;
			format ( pvar_string, sizeof ( pvar_string ), "ofm_%d", GetPVarInt ( playerid, "ofm_listitem" ) ) ;
			GetPVarString ( playerid, pvar_string, pl_name, MAX_PLAYER_NAME ) ;

		    if ( ! response ) return show_offmembers_dialog ( playerid, pl_name, 0 ) ;

		    if ( strlen ( inputtext ) < 3 || strlen ( inputtext ) > 24 )return show_dialog ( playerid, d_offmembers_pl_uninvite, DIALOG_STYLE_INPUT, "{"#cBHD"}Увольнение игрока", "{FFFFFF}Введите причину увольнения:\n\n{"#cGRDialog"}* Минимальное количество символов 3, максимальное 24", "Выбрать", "Назад" ) ;

			offuninvite_check ( playerid, pl_name, 5, inputtext ) ;
			return 1 ;
		}
		case d_offmembers_pl_rank:
		{
		    if ( ! response )
			{
				new pvar_string [ 38 ], pl_name [ MAX_PLAYER_NAME ] ;
				format ( pvar_string, sizeof ( pvar_string ), "ofm_%d", GetPVarInt ( playerid, "ofm_listitem" ) ) ;
				GetPVarString ( playerid, pvar_string, pl_name, MAX_PLAYER_NAME ) ;

				show_offmembers_dialog ( playerid, pl_name, 0 ) ;
				return 1 ;
			}

			new pvar_string [ 38 ],
				pl_name [ MAX_PLAYER_NAME ],
				_value = strval ( inputtext ),
				_f_id = p_info [ playerid ] [ member ] ;
			format ( pvar_string, sizeof ( pvar_string ), "ofm_%d", GetPVarInt ( playerid, "ofm_listitem" ) ) ;
			GetPVarString ( playerid, pvar_string, pl_name, MAX_PLAYER_NAME ) ;
			if ( _value < 1 || _value > f_info [ _f_id - 1 ] [ f_rank_settings ] [ 0 ] )return show_dialog ( playerid, d_offmembers_pl_rank, DIALOG_STYLE_INPUT, "{"#cBHD"}Повышение/понижение", "{"#cRD"}* Неверный номер ранга!\n\n{"#cWH"}Введите номер ранга, который хотите установить для игрока:", "Выбрать", "Назад" ) ;
			if ( _value >= p_info [ playerid ] [ rank ] )return show_dialog ( playerid, d_offmembers_pl_rank, DIALOG_STYLE_INPUT, "{"#cBHD"}Повышение/понижение", "{"#cRD"}* Вы не можете назначить игрока на ранг выше Вашего!\n\n{"#cWH"}Введите номер ранга, который хотите установить для игрока:", "Выбрать", "Назад" ) ;

            if ( _value >= f_info [ _f_id - 1 ] [ f_rank_settings ] [ 0 ] - 1 )
			{
			    if ( f_info [ _f_id - 1 ] [ f_leader_settings ] [ 6 ] == 0 && p_info [ playerid ] [ leader_status ] == 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Заместителей может назначать только главный лидер." ) ;

				static const _str [ ] = "SELECT COUNT(u_sql_id) FROM `fractions_players` WHERE `u_rank` = '%d' AND `u_member` = '%d' LIMIT 3" ;
			    new sql_string [ sizeof _str + ( 9 * 2 ) ] ;
			    format ( sql_string, sizeof sql_string, _str, _value, _f_id ) ;
			    mysql_tquery ( sql_connection, sql_string, "callback_rank_org", "iiiii", playerid, -1, _f_id, _value, false ) ;
			    return 1 ;
			}

			offmembers_rank ( playerid, strval ( inputtext ), pl_name, 0 ) ;
			show_offmembers_dialog ( playerid, pl_name, 0 ) ;
			return 1 ;
		}
		case d_offmembers_pl_menu_info:
		{
			new pvar_string [ 38 ],
				pl_name [ MAX_PLAYER_NAME ] ;

			format ( pvar_string, sizeof ( pvar_string ), "ofm_%d", GetPVarInt ( playerid, "ofm_listitem" ) ) ;
			GetPVarString ( playerid, pvar_string, pl_name, MAX_PLAYER_NAME ) ;

			show_offmembers_dialog ( playerid, pl_name, 0 ) ;
			return 1 ;
		}
		case d_give_lic:
		{
			if ( ! response )return DeletePVar ( playerid, "gl_id" ) ;
			new targetid = GetPVarInt ( playerid, "gl_id" ) ;
			switch ( listitem )
			{
				case 0:
				{
					new t_string [ 82 + MAX_PLAYER_NAME ] ;
					format ( t_string, sizeof ( t_string ), "* %s выдал Вам водительские права.", p_info [ playerid ] [ name ] ) ;
					SendClientMessage ( targetid, col_green, t_string ) ;
					p_info [ targetid ] [ drive_lic ] = 1 ;
					p_info [ targetid ] [ drive_day ] = 30 ;

					format ( t_string, sizeof t_string, "{"#cBAdmin"}[A]{"#cGRAdmin"} %s выдал %s водительские права.", p_info [ playerid ] [ name ], p_info [ targetid ] [ name ] ) ;
					foreach(new i: admin_players)SendClientMessage ( i, col_admin, t_string ) ;

					t_string [ 0 ] = EOS ;
					format ( t_string, sizeof t_string, "UPDATE `users` SET `u_drive_lic` = '1', `u_drive_day` = '30' WHERE `u_id` = '%d' LIMIT 1", p_info [ targetid ] [ id ] ) ;
					mysql_tquery ( sql_connection, t_string ) ;
				}
				case 1:
				{
					new t_string [ 82 + MAX_PLAYER_NAME ] ;
					format ( t_string, sizeof ( t_string ), "* %s выдал Вам лицензию на воздушный транспорт.", p_info [ playerid ] [ name ] ) ;
					SendClientMessage ( targetid, col_green, t_string ) ;
					p_info [ targetid ] [ fly_lic ] = 1 ;
					p_info [ targetid ] [ fly_day ] = 30 ;

					format ( t_string, sizeof t_string, "{"#cBAdmin"}[A]{"#cGRAdmin"} %s выдал %s лицензию на воздушный транспорт.", p_info [ playerid ] [ name ], p_info [ targetid ] [ name ] ) ;
					foreach(new i: admin_players)SendClientMessage ( i, col_admin, t_string ) ;

					t_string [ 0 ] = EOS ;
					format ( t_string, sizeof t_string, "UPDATE `users` SET `u_fly_lic` = '1', `u_fly_day` = '30' WHERE `u_id` = '%d' LIMIT 1", p_info [ targetid ] [ id ] ) ;
					mysql_tquery ( sql_connection, t_string ) ;
				}
				case 2:
				{
					new t_string [ 82 + MAX_PLAYER_NAME ] ;
					format ( t_string, sizeof ( t_string ), "* %s выдал Вам лицензию на водный транспорт.", p_info [ playerid ] [ name ] ) ;
					SendClientMessage ( targetid, col_green, t_string ) ;
					p_info [ targetid ] [ boat_lic ] = 1 ;
					p_info [ targetid ] [ boat_day ] = 30 ;

					format ( t_string, sizeof t_string, "{"#cBAdmin"}[A]{"#cGRAdmin"} %s выдал %s лицензию на водный транспорт.", p_info [ playerid ] [ name ], p_info [ targetid ] [ name ] ) ;
					foreach(new i: admin_players)SendClientMessage ( i, col_admin, t_string ) ;

					t_string [ 0 ] = EOS ;
					format ( t_string, sizeof t_string, "UPDATE `users` SET `u_boat_lic` = '1', `u_boat_day` = '30' WHERE `u_id` = '%d' LIMIT 1", p_info [ targetid ] [ id ] ) ;
					mysql_tquery ( sql_connection, t_string ) ;
				}
				case 3:
				{
					new t_string [ 82 + MAX_PLAYER_NAME ] ;
					format ( t_string, sizeof ( t_string ), "* %s выдал Вам лицензию на оружие.", p_info [ playerid ] [ name ] ) ;
					SendClientMessage ( targetid, col_green, t_string ) ;
					p_info [ targetid ] [ gun_lic ] = 1 ;
					p_info [ targetid ] [ gun_day ] = 30 ;

					format ( t_string, sizeof t_string, "{"#cBAdmin"}[A]{"#cGRAdmin"} %s выдал %s лицензию на оружие.", p_info [ playerid ] [ name ], p_info [ targetid ] [ name ] ) ;
					foreach(new i: admin_players)SendClientMessage ( i, col_admin, t_string ) ;

					t_string [ 0 ] = EOS ;
					format ( t_string, sizeof t_string, "UPDATE `users` SET `u_gun_lic` = '1', `u_gun_day` = '30' WHERE `u_id` = '%d' LIMIT 1", p_info [ targetid ] [ id ] ) ;
					mysql_tquery ( sql_connection, t_string ) ;
				}
			}

			DeletePVar ( playerid, "gl_id" ) ;
			return 1 ;
		}
  		case d_gps:
		{
			if ( ! response ) return 1 ;
			switch ( listitem )
			{
				case 0:
				{
				    global_string [ 0 ] = EOS ;
				    strcat ( global_string, "{"#cBL"}№. Название:\t{"#cBL"}Информация:\t{"#cBL"}Расстояние:\n" ) ;
					for ( new i = 0 ; i < gps_important_place_items ; i ++ )
					{
					    new Float:_distance = GetDistanceBetweenPoints ( p_t_info [ playerid ] [ p_pos ] [ 0 ], p_t_info [ playerid ] [ p_pos ] [ 1 ], p_t_info [ playerid ] [ p_pos ] [ 2 ], gps_important_place [ i ] [ position ] [ 0 ], gps_important_place [ i ] [ position ] [ 1 ], gps_important_place [ i ] [ position ] [ 2 ] ) ;
					    format ( global_string, sizeof global_string, "%s{"#cBL"}%d. {"#cWH"}%s\t%.2f км\n", global_string, i + 1, gps_important_place [ i ] [ loc_name ], _distance ) ;
					}
				    show_dialog ( playerid, d_gps_0, DIALOG_STYLE_TABLIST_HEADERS, "{"#cBHD"}Важные места", global_string, "Выбрать", "Назад" ) ;
				}
				case 1:
				{
				    global_string [ 0 ] = EOS ;
				    strcat ( global_string, "{"#cBL"}№. Название:\t{"#cBL"}Информация:\t{"#cBL"}Расстояние:\n" ) ;
					for ( new i = 0 ; i < gps_job_place_items ; i ++ )
