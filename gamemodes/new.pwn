		ClearAnimations ( playerid ) ;
		p_t_info [ playerid ] [ p_animation ] = true ;
  		ApplyAnimation(playerid, "CARRY", "crry_prtial", 4.1, 0, 1, 1, 1, 1 ) ;
	}

	if ( p_t_info [ playerid ] [ t_robbery ] != -1 ) exit_robbery ( playerid ) ;
	if ( g_phone_call [ playerid ] [ PC_STATUS ] ) SetPlayerSpecialAction ( playerid, SPECIAL_ACTION_USECELLPHONE ) ;

	p_t_info [ playerid ] [ p_tp_ac_timer ] = SetTimerEx ( "ac_check", 7500, false, "ifff", playerid, x, y, z ) ;
	return 1 ;
}

callback: ac_check ( playerid, Float:x, Float:y, Float:z )
{
	if ( p_t_info [ playerid ] [ p_tp_immune_time ] != 0 ) return 1 ;
	if ( GetTickCount ( ) - p_t_info [ playerid ] [ p_update ] > 1000 )return 1 ;
	p_t_info [ playerid ] [ p_tp_ac_timer ] = -1 ;
	if ( ! IsPlayerInRangeOfPoint ( playerid, 150, x, y, z ) ) return anti_cheat ( playerid, "телепортация", 0 ) ;
	return 1 ;
}

callback: toggle_controlable ( playerid, bool:toggle )
{
	if ( is_tazered { playerid } != 0 )is_tazered { playerid } = 0 ;
	return TogglePlayerControllable ( playerid, toggle ) ;
}

callback: clear_anim ( playerid )
{
	ApplyAnimation ( playerid, "CARRY", "crry_prtial", 4.0, 0, 0, 0, 0, 0, 1 ) ;

	//ClearAnimations ( playerid ) ; // Защищает от прямых рук
	return 1 ;
}

callback: player_timer ( playerid )
{
	#if defined m_anticheat
	    ac_OneSecondPlayer ( playerid ) ;
	#endif

	if ( p_info [ playerid ] [ mute ] > 0 ) p_info [ playerid ] [ mute ] -- ;
	if ( p_info [ playerid ] [ f_mute ] > 0 ) p_info [ playerid ] [ f_mute ] -- ;
	if ( p_info [ playerid ] [ fam_mute ] > 0 ) p_info [ playerid ] [ fam_mute ] -- ;
	if ( p_info [ playerid ] [ jailed ] > 0 )
	{
	    new _jail = p_info [ playerid ] [ jail ] ;
		if ( p_info [ playerid ] [ vip ] == 3 && _jail != 10 )
		{
			if ( _jail != 10 ) p_info [ playerid ] [ jailed ] -= 2 ;
			else p_info [ playerid ] [ jailed ] -= 1 ;
		}
		else p_info [ playerid ] [ jailed ] -= 1 ;

		if ( p_info [ playerid ] [ jailed ] > 0 && p_info [ playerid ] [ jailed ] < 10 )
		{
			if ( _jail > 0 && _jail < 9 ) set_pos ( playerid, exit_jail_player [ 0 ], exit_jail_player [ 1 ], exit_jail_player [ 2 ], exit_jail_player [ 3 ], 1, p_info [ playerid ] [ jail ] ) ;
			else if ( _jail == 9 )
			{
			    #if defined m_prison
				set_pos ( playerid, exit_prison_player [ 0 ], exit_prison_player [ 1 ], exit_prison_player [ 2 ], exit_prison_player [ 3 ], 0, 0 ) ;
				fraction_duty ( playerid ) ;
				#else
				SpawnPlayer ( playerid ) ;
				#endif
			}
			else if ( _jail == 10 ) SpawnPlayer ( playerid ) ;

			SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы отсидели свой срок заключения и были освобождены." ) ;

			p_info [ playerid ] [ jailed ] =
			p_info [ playerid ] [ jail ] =
			p_info [ playerid ] [ wanted ] = 0 ;

			SetPlayerWantedLevel ( playerid, p_info [ playerid ] [ wanted ] ) ;

			new sql_string [ 82 + 9 ] ;
			format ( sql_string, sizeof sql_string, "UPDATE `users` SET `u_wanted` = '0', `u_jail` = '0' WHERE `u_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
			mysql_tquery ( sql_connection, sql_string ) ;
		}
	}

	if ( p_info [ playerid ] [ masked ] > 0 )
	{
		if ( --p_info [ playerid ] [ masked ] == 1 )
		{
			fraction_color ( playerid ) ;

		    if ( p_info [ playerid ] [ mask_status ] == 0 ) RemovePlayerAttachedObject ( playerid, 3 ) ;
		}
	}

	if ( sp_timer [ playerid ] > 0 )
	{
	    if ( --sp_timer [ playerid ] == 1 )
	    {
	        admin_info [ playerid ] [ warning ] ++ ;

			new fm_string [ 144 ] ;
			if ( admin_info [ playerid ] [ warning ] >= 3 )
			{
			    format ( fm_string, sizeof fm_string, "{"#cBAdmin"}[A] {"#cGRAdmin"}Администратор {"#cBAdmin"}%s[%d]{"#cGRAdmin"} снят(а) с поста. Причина: не приход по репорту", p_info [ playerid ] [ name ], playerid ) ;
				foreach(new i: admin_players) SendClientMessage ( i, col_admin, fm_string ) ;

				remove_admin ( playerid ) ;

				static const _str [ ] = "DELETE FROM `users_admins` WHERE `u_a_id` = '%d' LIMIT 1" ;
				new sql_string [ sizeof _str + 9 ] ;
				format ( sql_string, sizeof sql_string, _str, p_info [ playerid ] [ id ] ) ;
				mysql_tquery ( sql_connection, sql_string ) ;

				format ( fm_string, sizeof fm_string, "Администратор %s снят(а) с поста. Причина: не приход по репорту", p_info [ playerid ] [ name ] ) ;
				WriteLog ( playerid, TYPE_LOG_ADMIN, fm_string ) ;

				SendClientMessage ( playerid, col_white, !"Больше Вы не сможете попасть на пост администратора!" ) ;

				p_info [ playerid ] [ blocked_adm ] = 50 ;
				update_int_sql ( playerid, "u_block_adm", 50 ) ;

				sql_string [ 0 ] = EOS ;
				format ( sql_string, sizeof sql_string, "Администратор %s получил(а) ADM BLOCK.", p_info [ playerid ] [ name ] ) ;
				WriteLog ( playerid, TYPE_LOG_ADMIN, sql_string ) ;
			}
			else
			{
			    format ( fm_string, sizeof fm_string, "{"#cBAdmin"}[A] {"#cGRAdmin"}Администратор {"#cBAdmin"}%s[%d]{"#cGRAdmin"} получил(а) выговор. Причина: не приход по репорту", p_info [ playerid ] [ name ], playerid ) ;
				foreach(new i: admin_players) SendClientMessage ( i, col_admin, fm_string ) ;

				format ( fm_string, sizeof fm_string, "Администратор %s получил(а) выговор. Причина: не приход по репорту", p_info [ playerid ] [ name ] ) ;
				WriteLog ( playerid, TYPE_LOG_ADMIN, fm_string ) ;

				format ( fm_string, sizeof fm_string, "UPDATE `users_admins` SET `u_a_warning` = '%d' WHERE `u_a_id` = '%d' LIMIT 1", admin_info [ playerid ] [ warning ], p_info [ playerid ] [ id ] ) ;
		       	mysql_tquery ( sql_connection, fm_string ) ;
			}
	    }
	}

	if ( time_for_skin { playerid } > 0 )
	{
	    if ( --time_for_skin { playerid } == 1 )
		{
			fraction_duty ( playerid ) ;
		}
