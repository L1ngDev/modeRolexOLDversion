	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете применить это к самому себе." ) ;
	if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;
	if ( ! bad_dialog ( params [ 0 ] ) || ! bad_dialog ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Недоступно в данный момент." ) ;
	if ( p_info [ params [ 0 ] ] [ jailed ] > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок в тюрьме." ) ;
	if ( cooldown_sentence [ playerid ] > gettime ( ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Предложение о сделке можно отправлять один раз в {"#cRD"}45 секунд{"#cGRInfo"}." ) ;

    cooldown_sentence [ playerid ] = gettime ( ) + time_sell_sentence ;

	buyer_id [ playerid ] = params [ 0 ] ;
	sell_price [ playerid ] = params [ 1 ] ;
	seller_id [ params [ 0 ] ] = playerid ;

	sell_time { playerid } =
	sell_time { params [ 0 ] } = time_sell_null ;

	new dialog_string [ 108 + MAX_PLAYER_NAME + 32 + 1 + 6 ] ;
	format ( dialog_string, sizeof ( dialog_string  ), "{"#cBL"}%s {FFFFFF}предлагает Вам поцеловаться.",
	p_info [ playerid ] [ name ] ) ;
	show_dialog ( params [ 0 ], d_kiss, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Поцелуй", dialog_string, "Поцеловать", "Отмена" ) ;

	format ( dialog_string, sizeof ( dialog_string  ), "{"#cGInfo"}* {"#cWH"}Вы предложили {"#cBL"}%s {FFFFFF}поцеловаться.",
	p_info [ params [ 0 ] ] [ name ] ) ;
	SendClientMessage ( playerid, col_white, dialog_string ) ;
	return true ;
}

stock SetPosInFrontOfPlayer ( playerid, giveplayerid, Float: distance )
{
	new Float: x, Float: y, Float: z, Float: a ;
	GetPlayerPos ( playerid, x, y, z ) ;
	GetPlayerFacingAngle ( playerid, a ) ;
	x += (distance * floatsin(-a, degrees));
	y += (distance * floatcos(-a, degrees));
	SetPlayerPos ( giveplayerid, x, y, z ) ;
	SetPlayerFacingAngle ( giveplayerid, a ) ;
}

CMD:sellbiz ( playerid, params [ ] )
{
	if ( ! mafia_player ( playerid ) || p_info [ playerid ] [ leader ] == 0 ) return 1 ;
	if ( sscanf ( params, "ud", params [ 0 ], params [ 1 ], params [ 2 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /sellbiz [id/имя] [цена]") ;
	if ( params [ 1 ] < 20000 || params [ 1 ] > 500000 || params [ 1 ] == INVALID_PRICE ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Цена должна быть от {"#cRD"}20.000"valute_title_"{"#cGRInfo"} до {"#cRD"}500.000"valute_title"{"#cGRInfo"}." ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете применить это к самому себе." ) ;
	if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;
	if ( ! bad_dialog ( params [ 0 ] ) || ! bad_dialog ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Недоступно в данный момент.") ;
	if ( p_info [ params [ 0 ] ] [ member ] == p_info [ playerid ] [ member ] )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Невозможно продать контроль над бизнесом члену Вашей мафии.") ;
	if ( ! mafia_player ( params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Контроль над бизнесом возможно продать только члену мафии.") ;
	if ( cooldown_sentence [ playerid ] > gettime ( ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Предложение о сделке можно отправлять один раз в {"#cRD"}45 секунд{"#cGRInfo"}." ) ;

	new sellbiz_id = -1 ;

    for ( new i = 0 ; i < b_count ; i ++ )
	{
		if ( ! IsPlayerInRangeOfPoint ( playerid, 5, b_info [ i ] [ b_position ] [ 0 ], b_info [ i ] [ b_position ] [ 1 ], b_info [ i ] [ b_position ] [ 2 ] ) ) continue ;

		sellbiz_id = i ;
		break ;
	}

	if ( sellbiz_id == -1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны быть рядом с бизнесом.") ;
	if ( b_info [ sellbiz_id ] [ b_mafia ] != p_info [ playerid ] [ member ] )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Ваша мафия не контролирует данный бизнес.") ;

    cooldown_sentence [ playerid ] = gettime ( ) + time_sell_sentence ;

	buyer_id [ playerid ] = params [ 0 ] ;
	sell_price [ playerid ] = params [ 1 ] ;
	sell_item [ playerid ] = sellbiz_id ;
	seller_id [ params [ 0 ] ] = playerid ;

	sell_time { playerid } =
	sell_time { params [ 0 ] } = time_sell_null ;

	new dialog_string [ 108 + MAX_PLAYER_NAME + 32 + 1 + 6 ] ;
	format ( dialog_string, sizeof ( dialog_string  ), "{"#cBL"}%s {FFFFFF}предлагает Вам приобрести контроль над бизнесом \"{%s}%s\"{ffffff} за {"#cGN"}%s"valute_title_"",
	p_info [ playerid ] [ name ], f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_chat_color ], f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_name ], GetPlayerCashValueToSmile ( params [ 1 ] ) ) ;
	show_dialog ( params [ 0 ], d_biz_sell_accept, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Контроль над бизнесом", dialog_string, "Купить", "Отмена" ) ;

	format ( dialog_string, sizeof ( dialog_string  ), "{"#cGInfo"}* {"#cWH"}Вы предложили {"#cBL"}%s {FFFFFF}приобрести контроль над бизнесом \"{%s}%s\"{ffffff} за {"#cBL"}%s"valute_title_"",
	p_info [ params [ 0 ] ] [ name ], f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_chat_color ], f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_name ], GetPlayerCashValueToSmile ( params [ 1 ] ) ) ;
	SendClientMessage ( playerid, col_white, dialog_string ) ;
	return true ;
}

CMD:setgps ( playerid )
{
	if ( GetInventoryFindItem ( playerid, SUB_INVENTORY, 2162 ) < 1 )
	{
	    if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "У Вас нет GPS-трекера.", 0, 3, CINFO_INVENTORY_ID, PICTURE_INFO_ERROR, "", "" ) ;
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет GPS-трекера." ) ;
		return 1 ;
	}

	new veh_id = GetPlayerVehicleID ( playerid ) ;
	if ( veh_id == 0 )
	{
	    if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Вы должны быть в транспорте.", 0, 3, CINFO_INVENTORY_ID, PICTURE_INFO_ERROR, "", "" ) ;
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны быть в транспорте." ) ;
		return 1 ;
	}
	if ( veh_info [ veh_id - 1 ] [ v_type ] != vehicle_type_player )
	{
	    if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "GPS-трекер можно установить только на личный транспорт.", 0, 3, CINFO_INVENTORY_ID, PICTURE_INFO_ERROR, "", "" ) ;
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}GPS-трекер можно установить только на личный транспорт." ) ;
		return 1 ;
	}
	if ( veh_info [ veh_id - 1 ] [ v_gps_tracker ] == 1  )
	{
	    if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "GPS-трекер уже установлен.", 0, 3, CINFO_INVENTORY_ID, PICTURE_INFO_ERROR, "", "" ) ;
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}GPS-трекер уже установлен." ) ;
		return 1 ;
	}

	veh_info [ veh_id - 1 ] [ v_gps_tracker ] = 1 ;
	clear_inventory ( playerid, 2162, 1 ) ;

	new scm_string [ 98 ] ;
	format ( scm_string, 98, "UPDATE `users_vehicles` SET `v_gps_tracker` = '1' WHERE `v_id` = '%d' LIMIT 1", veh_info [ veh_id - 1 ] [ v_id ] ) ;
	mysql_tquery ( sql_connection, scm_string ) ;

	SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}GPS-трекер успешно установлен в транспорт." ) ;
	return 1 ;
}

CMD:makegun ( playerid )
{
    if ( TeamPaint [ playerid ] != 0 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Невозможно во время участия в paintball." ) ;
	if ( p_info [ playerid ] [ jailed ] > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нельзя собирать оружие находясь в заключении.") ;
	if ( GetInventoryFindItem ( playerid, SUB_INVENTORY, 2154 ) < 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас нет патронов." ) ;
	if ( GetInventoryFindItem ( playerid, SUB_INVENTORY, 2153 ) < 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас нет ед. оружия." ) ;
	if ( GetPlayerState ( playerid ) == PLAYER_STATE_DRIVER ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете собирать оружие в транспорте." ) ;
	if ( p_info [ playerid ] [ hour_played ] < FIVE_HOUR_PLAYED ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Доступно с 5 часов в игре. Используйте /mm - Информация о персонаже - Статистика персонажа." ) ;

	#if defined m_familys
	if ( p_info [ playerid ] [ family ] )
	{
	    new family_id = p_info [ playerid ] [ family ] ;
		if ( family_info [ family_id - 1 ] [ fam_house ] )
		{
			if ( GetPlayerVirtualWorld ( playerid ) == family_info [ family_id - 1 ] [ fam_house ] )
			{
			    global_string [ 0 ] = EOS ;
			    global_string = "{"#cBL"}Название оружия:\t{"#cBL"}Количество ед.оружия:\n";
				for ( new i = 0 ; i < 7 ; i ++ )
				{
				    format ( global_string, 1000, "%s%s\t%i\n", global_string, mg_info [ i ][ mg_name ], mg_info [ i ] [ mg_guns ] ) ;
				}
				show_dialog ( playerid, d_makegun, DIALOG_STYLE_TABLIST_HEADERS, "{"#cBHD"}Сборка оружия", global_string, "Выбрать", "Закрыть" ) ;
				return 1 ;
			}
			else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы можете скрафтить оружие находясь в семейном доме." ) ;
		}
	}
	#endif

    if ( ! gang_player ( playerid ) && ! mafia_player ( playerid ) && ! army_player ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команда доступна только для криминальных организаций и военных." ) ;
    if ( gang_player ( playerid ) || mafia_player ( playerid ) )
    {
		if ( GetPlayerInterior ( playerid ) != f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_spawn_int ] && GetPlayerVirtualWorld ( playerid ) != f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_spawn_virt ] )
		{
		    if ( ! IsPlayerInRangeOfPoint ( playerid, 25, f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_spawn ] [ 0 ], f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_spawn ] [ 1 ], f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_spawn ] [ 2 ] ) )
				return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Собирать оружие можно только на своей территории." ) ;
		}
		else
		{
			for ( new i = 0 ; i < gz_count ; i ++ )
			{
				if ( IsPlayerInGangZone ( playerid, i ) )
				{
					if ( gz_info [ i ] [ gz_owner ] != p_info [ playerid ] [ member ] )
						return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Собирать оружие можно только на своей территории." ) ;
				}
			}
		}
	}
	else if ( army_player ( playerid ) )
	{
	    if ( ! is_fraction_duty { playerid } ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Не начат рабочий день." ) ;
	}

    global_string [ 0 ] = EOS ;
    global_string = "{"#cBL"}Название оружия:\t{"#cBL"}Количество ед.оружия:\n" ;
	for ( new i = 0 ; i < 7 ; i ++ )
	{
	    format ( global_string, 1000, "%s%s\t%i\n", global_string, mg_info [ i ][ mg_name ], mg_info [ i ] [ mg_guns ] ) ;
	}
	show_dialog ( playerid, d_makegun, DIALOG_STYLE_TABLIST_HEADERS, "{"#cBHD"}Сборка оружия", global_string, "Выбрать", "Закрыть" ) ;
	return 1 ;
}

CMD:giveguns ( playerid, params [ ] )
{
	if ( TeamPaint [ playerid ] != 0 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Невозможно во время участия в paintball." ) ;
	if ( p_info [ playerid ] [ jailed ] > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нельзя передавать оружие находясь в заключении.") ;
	if ( sscanf ( params, "ud", params [ 0 ], params [ 1 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /giveguns [id/имя] [кол-во]") ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете применить это к самому себе." ) ;
	if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;
	if ( params [ 1 ] < 1 || params [ 1 ] > 500 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Количество передаваемых ед.оружия должно быть от {"#cRD"}1 {"#cGRInfo"}до {"#cRD"}500{"#cGRInfo"}." ) ;
	if ( GetInventoryFindItem ( playerid, SUB_INVENTORY, 2153 ) < params [ 1 ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет столько ед.оружия." ) ;
	if ( ( GetInventoryFindItem ( params [ 0 ], SUB_INVENTORY, 2153 ) + params [ 1 ] > 500 && ! p_info [ params [ 0 ] ] [ enhancement ] [ 0 ] ) || GetInventoryFindItem ( params [ 0 ], SUB_INVENTORY, 2153 ) + params [ 1 ] > 1000 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока уже достаточно ед.оружия." ) ;
	if ( p_info [ params [ 0 ] ] [ jailed ] > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нельзя передавать оружие находящемуся в заключении.") ;

	clear_inventory ( playerid, 2153, params [ 1 ] ) ;
	give_inventory ( params [ 0 ], 2153, params [ 1 ], 0, "", "", NUMBERPLATE_TYPE_NONE, 0 ) ;

	new string [ 108 ] ;
	format ( string, sizeof ( string ), "передал(-а) ед.оружия %s", p_info [ params [ 0 ] ] [ name ] ) ;
	me_action ( playerid, string ) ;
	format ( string, sizeof ( string ), "{"#cGInfo"}* {"#cWH"}Вы передали {"#cGN"}%s %d{"#cWH"} ед.оружия.", p_info [ params [ 0 ] ] [ name ], params [ 1 ] ) ;
	SendClientMessage ( playerid, col_white, string ) ;
	format ( string, sizeof ( string ), "{"#cGN"}* %s {"#cWH"}передал%s Вам {"#cGN"}%d{"#cWH"} ед.оружия.", p_info [ playerid ] [ name ], ( p_info [ playerid ] [ gender ] == 1 ) ? (""):("а"), params [ 1 ] ) ;
	SendClientMessage ( params [ 0 ], col_white, string ) ;
	return 1 ;
}

