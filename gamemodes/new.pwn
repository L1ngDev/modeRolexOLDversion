	        format ( global_string, sizeof global_string, "%s{"#cBL"}%d. {"#cWH"}%s\n", global_string, _count, punish_warn [ i ] [ pun_name ] ) ;
	    }
	    show_dialog ( playerid, d_punish_warn, DIALOG_STYLE_LIST, "{"#cBHD"}Регламент /warn", global_string, "Выбрать", "Назад" ) ;
	}
	else if ( _param == 3 )
	{
	    new _count = 1 ;
	    global_string [ 0 ] = EOS ;
		strcat ( global_string, "{"#cBL"}№. Причина:\t{"#cBL"}Срок:\n" ) ;
		strcat ( global_string, "{"#cWH"}Создать\t \n" ) ;
	    for ( new i = 0 ; i < punishment_max ; i ++ )
	    {
	        if ( punish_ban [ i ] [ pun_time ] < 1 ) continue ;

	        set_player_listitem_values ( playerid, _count, i ) ;
	        _count ++ ;

	        format ( global_string, sizeof global_string, "%s{"#cBL"}%d. {"#cWH"}%s\t%d дн.\n", global_string, _count, punish_ban [ i ] [ pun_name ], punish_ban [ i ] [ pun_time ] ) ;
	    }
	    show_dialog ( playerid, d_punish_ban, DIALOG_STYLE_TABLIST_HEADERS, "{"#cBHD"}Регламент /ban", global_string, "Выбрать", "Назад" ) ;
