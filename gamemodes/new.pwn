					strcat ( global_string, "{"#cGRDialog"}Добавить чекпоинт" ) ;
				}
				show_dialog(playerid, d_bus_admin_route, DIALOG_STYLE_LIST, "{"#cBHD"}Движение", global_string, "Выбрать", "Отмена" ) ;
				return 1 ;
            }

            else if ( listitem == get_player_use_page ( playerid, 1 ) )
            {
                clear_player_use_page ( playerid ) ;
                if ( ofm_formula ( page_count [ playerid ] ) >= page_rows [ playerid ] )
            	{
					SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы находитесь на последней странице." ) ;
					show_admin_route ( playerid ) ;
					return 1 ;
				}
                page_count [ playerid ] += 1 ;

                global_string [ 0 ] = EOS ;
				new _route_id = get_player_use_listitem ( playerid ) ;

				new line_string [ 27 + 2 + 20 ], row_count = 0, count_business = 0 ;
				for ( new i = 0 ; i < bus_count ; i ++ )
				{
					if ( bus_info [ i ] [ bus_step ] != _route_id ) continue ;

					if ( count_business < ( page_count [ playerid ] * 20 ) - 20 )
					{
						count_business ++ ;
						continue ;
					}

					if ( row_count > 20 ) break ;

