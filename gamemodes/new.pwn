	format ( fm_string, sizeof fm_string, "{"#cBAdmin"}[A] {"#cGRAdmin"}%s %s спавн для открытия!", p_info [ playerid ] [ name ], ( server_open_time == 1 ) ? ( "открыл(а)" ) : ( "закрыл(а)" ) ) ;
	admin_message ( 5, col_admin, fm_string ) ;
	return 1 ;
}

CMD:serverlimit ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 8 ) return 1 ;
	if ( ! IsFounder ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}К сожалению, Вам данная функция не доступна." ) ;
	if ( sscanf ( params, "dd", params [ 0 ], params [ 1 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /serverlimit [limit] [count]" ) ;

	new rcon_string [ 128 ] ;
	if ( params [ 0 ] == 1 ) format ( rcon_string, 128, "ackslimit %d", params [ 1 ] ) ;
	else if ( params [ 0 ] == 2 ) format ( rcon_string, 128, "messageholelimit %d", params [ 1 ] ) ;
	else if ( params [ 0 ] == 3 ) format ( rcon_string, 128, "messageslimit %d", params [ 1 ] ) ;
	SendRconCommand ( rcon_string ) ;
	return 1 ;
}

