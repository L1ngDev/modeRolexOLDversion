	    return 1 ;
	}
	else if ( _type == 7 )
	{
	    show_dialog ( playerid, d_offmembers_pl_menu7, DIALOG_STYLE_LIST, pvar_string, "Информация об игроке\nУволить из подразделения\nИстория в организации\nАктивность игрока", "Выбрать", "Назад" ) ;
	    return 1 ;
	}
	else if ( _type == 8 )
	{
	    show_dialog ( playerid, d_offmembers_pl_menu8, DIALOG_STYLE_LIST, pvar_string, "Информация об игроке\nВыгнать из команды\nИстория в команде\nАктивность игрока", "Выбрать", "Назад" ) ;
	    return 1 ;
	}
	else if ( _type == 9 )
	{
	    show_dialog ( playerid, d_offmembers_pl_menu9, DIALOG_STYLE_LIST, pvar_string, "Информация о сотруднике\nУволить сотрудника\nАктивность сотрудника", "Выбрать", "Назад" ) ;
	    return 1 ;
