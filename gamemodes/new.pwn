stock check_quest ( playerid )
{
	new _qs = quest_select [ playerid ] [ 0 ], _qstatus = quest_status [ playerid ] [ 0 ] ;
	if ( _qs < MAX_QUESTS )
	{
		if ( _qs == 0 && _qstatus == 1 ) check_quest_gps ( playerid, false ) ;
	    else if ( _qs == 1 && _qstatus == 1 ) check_quest_gps ( playerid, false ) ;
	    else if ( _qs == 2 && _qstatus == 1 )
		{
			if ( p_info [ playerid ] [ drive_lic ] ) checking_quest_progress ( playerid, 2, 1, quest_line_start ) ;
			else check_quest_gps ( playerid, false ) ;
		}
		else if ( _qs == 3 && _qstatus == 1 )
		{
		    new bool: _finded_account = false ;
		    for ( new i = 0 ; i < MAX_BANK_ACCOUNT ; i ++ )
			{
			    if ( bank_info [ playerid ] [ bi_type ] [ i ] != 1 ) continue ;

	            _finded_account = true ;
	            checking_quest_progress ( playerid, 3, 1, quest_line_start ) ;
				break ;
			}

			if ( ! _finded_account ) check_quest_gps ( playerid, false ) ;
		}
		else if ( _qs == 4 && _qstatus == 1 )
		{
			if ( p_info [ playerid ] [ number ] ) checking_quest_progress ( playerid, 4, 1, quest_line_start ) ;
			else check_quest_gps ( playerid, false ) ;
		}
		else if ( _qs == 5 && _qstatus == 1 )
		{
			if ( GetInventoryFindItem ( playerid, SUB_INVENTORY, 2163 ) ) checking_quest_progress ( playerid, 5, 1, quest_line_start ) ;
			else check_quest_gps ( playerid, false ) ;
		}
		else if ( _qs == 7 && _qstatus == 1 )
		{
			if ( GetInventoryFindItem ( playerid, SUB_INVENTORY, ITEM_PASSPORT ) ) checking_quest_progress ( playerid, 7, 1, quest_line_start ) ;
			else check_quest_gps ( playerid, false ) ;
		}
	}

	_qs = quest_select [ playerid ] [ 1 ], _qstatus = quest_status [ playerid ] [ 1 ] ;
	if ( _qs < MAX_QUESTS )
	{
		if ( _qs == 0 && _qstatus == 1 )
		{
			check_quest_gps ( playerid, false ) ;
		}
		else if ( _qs == 1 && _qstatus == 1 )
		{
			check_quest_gps ( playerid, false ) ;
		}
		else if ( _qs == 2 && _qstatus == 1 )
		{
			SendClientMessage ( playerid, col_white, !"{"#cBInfo"}* {"#cWH"}Используйте {"#cBInfo"}'/gps - Бизнесы - Отели' {"#cWH"}для поиска свободного отеля." ) ;
			SendClientMessage ( playerid, col_white, !"{"#cBInfo"}* {"#cWH"}Используйте {"#cBInfo"}'/gps - Бизнесы - Риелторское агентство' {"#cWH"}для поиска свободного дома." ) ;
		}
		else if ( _qs == 3 && _qstatus == 1 )
		{
			check_quest_gps ( playerid, false ) ;
		}
		else if ( _qs == 4 && _qstatus == 1 )
		{
			check_quest_gps ( playerid, false ) ;
		}
		else if ( _qs == 5 && _qstatus == 1 )
		{
			check_quest_gps ( playerid, false ) ;
		}
		else if ( _qs == 6 && _qstatus == 1 )
		{
			check_quest_gps ( playerid, false ) ;
		}
		else if ( _qs == 7 && _qstatus == 1 )
		{
			check_quest_gps ( playerid, false ) ;
		}
	}

	_qs = quest_select [ playerid ] [ 2 ], _qstatus = quest_status [ playerid ] [ 2 ] ;
	if ( _qs < MAX_QUESTS )
	{
		if ( _qs == 0 && _qstatus == 1 )
		{
			if ( p_info [ playerid ] [ family ] ) checking_quest_progress ( playerid, 0, 1, quest_line_high ) ;
			else
			{
				SendClientMessage ( playerid, col_white, !"{"#cBInfo"}* {"#cWH"}Используйте {"#cBInfo"}'/reitfam' {"#cWH"}для просмотра списка ТОП-семей." ) ;
				SendClientMessage ( playerid, col_white, !"{"#cBInfo"}* {"#cWH"}Следите за объявлениями о наборах в семьи в чате." ) ;
			}
		}
		else if ( _qs == 1 && _qstatus == 1 )
		{
			SendClientMessage ( playerid, col_white, !"{"#cBInfo"}* {"#cWH"}Используйте {"#cBInfo"}'/fmenu'{"#cWH"}." ) ;
		}
		else if ( _qs == 2 && _qstatus == 1 )
		{
			SendClientMessage ( playerid, col_white, !"{"#cBInfo"}* {"#cWH"}Используйте {"#cBInfo"}'/fmenu'{"#cWH"}." ) ;
		}
		else if ( _qs == 3 && _qstatus == 1 )
		{
			check_quest_gps ( playerid, false ) ;
		}
		else if ( _qs == 4 && _qstatus == 1 )
		{
			check_quest_gps ( playerid, false ) ;
		}
		else if ( _qs == 5 && _qstatus == 1 )
		{
			check_quest_gps ( playerid, false ) ;
		}
		else if ( _qs == 6 && _qstatus == 1 )
		{
			check_quest_gps ( playerid, false ) ;
		}
		else if ( _qs == 7 && _qstatus == 1 )
		{
			check_quest_gps ( playerid, false ) ;
		}
	}
	return 1 ;
}

