			    case 0: show_stats ( playerid, playerid ) ;
				case 1: callcmd::skill ( playerid, str ) ;
				case 2: callcmd::fstyle ( playerid ) ;
				case 3: callcmd::joblist ( playerid, str ) ;
				case 4: show_enhancements ( playerid ) ;
				case 5: callcmd::spawnchange ( playerid, "" ) ;
