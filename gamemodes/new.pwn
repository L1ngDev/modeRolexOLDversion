CMD:mute ( playerid, params [ ] )
{
	if ( tester_admin [ playerid ] ) return tester_no_access ( playerid ) ;
	if ( admin_info [ playerid ] [ admin ] < 1 )
		return 1 ;

	if ( admin_info [ playerid ] [ admin ] < 6 )
	{
		if ( sscanf ( params, "uds[42]", params [ 0 ] ) )
			return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /mute [ид]" ) ;
		if ( ! IsPlayerConnected ( params [ 0 ] ) )
			return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
		if ( p_info [ params [ 0 ] ] [ mute ] > 1 )
			return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока уже есть бан чата." ) ;

	    new _count = 0, header_string [ 64 ] ;
	    global_string [ 0 ] = EOS ;
		strcat ( global_string, "{"#cBL"}№. Причина:\t{"#cBL"}Срок:\n" ) ;
	    for ( new i = 0 ; i < punishment_max ; i ++ )
	    {
	        if ( punish_mute [ i ] [ pun_time ] < 1 ) continue ;

	        set_player_listitem_values ( playerid, _count, i ) ;
	        _count ++ ;

	        format ( global_string, sizeof global_string, "%s{"#cBL"}%d. {"#cWH"}%s\t%d мин.\n", global_string, _count, punish_mute [ i ] [ pun_name ], punish_mute [ i ] [ pun_time ] ) ;
	    }
	    format ( header_string, sizeof header_string, "{"#cBHD"}Наказать {"#cWH"}%s", p_info [ params [ 0 ] ] [ name ] ) ;
	    show_dialog ( playerid, d_mute, DIALOG_STYLE_TABLIST_HEADERS, header_string, global_string, "Выбрать", "Закрыть" ) ;

	    set_player_use_listitem ( playerid, params [ 0 ] ) ;
	    return 1 ;
	}
	else
	{
		if ( sscanf ( params, "uds[42]", params [ 0 ], params [ 1 ], params [ 2 ] ) )
			SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /mute [ид] [минуты] [причина]" ) ;
		if ( ! IsPlayerConnected ( params [ 0 ] ) )
			return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
		if ( p_info [ params [ 0 ] ] [ mute ] > 1 )
			return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока уже есть бан чата." ) ;

		if ( strlen ( params [ 2 ] ) < 2 )
		{
		    new _count = 0, header_string [ 64 ] ;
		    global_string [ 0 ] = EOS ;
			strcat ( global_string, "{"#cBL"}№. Причина:\t{"#cBL"}Срок:\n" ) ;
		    for ( new i = 0 ; i < punishment_max ; i ++ )
		    {
		        if ( punish_mute [ i ] [ pun_time ] < 1 ) continue ;

		        set_player_listitem_values ( playerid, _count, i ) ;
		        _count ++ ;

		        format ( global_string, sizeof global_string, "%s{"#cBL"}%d. {"#cWH"}%s\t%d мин.\n", global_string, _count, punish_mute [ i ] [ pun_name ], punish_mute [ i ] [ pun_time ] ) ;
		    }
		    format ( header_string, sizeof header_string, "{"#cBHD"}Наказать {"#cWH"}%s", p_info [ params [ 0 ] ] [ name ] ) ;
		    show_dialog ( playerid, d_mute, DIALOG_STYLE_TABLIST_HEADERS, header_string, global_string, "Выбрать", "Закрыть" ) ;

		    set_player_use_listitem ( playerid, params [ 0 ] ) ;
		    return 1 ;
		}
		else
		{
			if ( params [ 1 ] < 1 || params [ 1 ] > 180 )
				return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Время бана чата должно составлять от 1 до 180 минут." ) ;
		}
	}

    if ( reload_admin_warning ( playerid, params [ 2 ] ) ) return 1 ;

	new scm_string [ 144 ] ;
	format( scm_string,sizeof ( scm_string  ), "Администратор %s выдал бан чата игроку %s на %d минут. Причина: %s", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], params [ 1 ], params [ 2 ] ) ;
	foreach(new i: logged_players) if ( p_info [ i ] [ settings ] [ 2 ] ) SendClientMessage ( i, col_light_red, scm_string ) ;

	format ( scm_string,sizeof(scm_string),"UPDATE `users_admins` SET `u_a_mute` = `u_a_mute`+1 WHERE `u_a_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
	mysql_tquery ( sql_connection, scm_string, "", "" ) ;

	format(scm_string, 128, "%s выдал бан чата %s. Причина: %s", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], params [ 2 ]);
	WriteLog(playerid, TYPE_LOG_MUTE, scm_string);

    admin_info [ playerid ] [ coins ] += 2 ;
	p_info [ params [ 0 ] ] [ mute ] = params [ 1 ] * 60 ;
	return 1 ;
}

CMD:unmute ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 2 )
		return 1 ;
	if ( sscanf ( params, "u", params [ 0 ] ) )
		return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /unmute [ид]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) )
		return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( p_info [ params [ 0 ] ] [ mute ] < 1 )
	    return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока нет мута!" ) ;

	p_info [ params [ 0 ] ] [ mute ] = 0 ;

	new scm_string [ 128 ] ;
	format ( scm_string, sizeof ( scm_string  ), "{"#cBAdmin"}[A] {"#cGRAdmin"}Администратор %s снял затычку игроку %s.", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ] ) ;
	foreach(new i: admin_players) SendClientMessage ( i, col_admin, scm_string ) ;

	format(scm_string, 128, "%s снял бан чата %s", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ]);
	WriteLog(playerid, TYPE_LOG_UNMUTE, scm_string);
	return 1 ;
}

CMD:offunmute ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 5 ) return 1 ;
	new
		mname [ MAX_PLAYER_NAME ] ;
	if ( sscanf ( params, "s[24]", mname ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /offunmute [имя игрока]" ) ;

    new _pl_id ;
	sscanf ( mname, "u", _pl_id ) ;
	if ( IsPlayerConnected ( _pl_id ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок в сети." ) ;

	new sql_string [ 61 + MAX_PLAYER_NAME ] ;
	format ( sql_string, sizeof sql_string, "SELECT `u_id` FROM `users` WHERE `u_name` = '%s' LIMIT 1", mname ) ;
	mysql_tquery ( sql_connection, sql_string, "unmute_check_callback", "is", playerid, mname ) ;
	return 1 ;
}

callback: unmute_check_callback ( playerid, mname [ ] )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( rows )
	{
		new string [ 144 ] ;
		format ( string, sizeof string, "UPDATE `users` SET `u_mute` = '0' WHERE `u_name` = '%s' LIMIT 1", mname ) ;
		mysql_tquery ( sql_connection, string ) ;

		format ( string, sizeof ( string ), "{"#cBAdmin"}[A] {"#cGRAdmin"}Администратор %s снял затычку игроку %s.", p_info [ playerid ] [ name ], mname ) ;
		foreach(new i: admin_players) SendClientMessage ( i, col_admin, string ) ;

		format ( string, 128, "%s снял бан чата %s", p_info [ playerid ] [ name ], mname ) ;
		WriteLog ( playerid, TYPE_LOG_UNMUTE, string ) ;

		new _u_id = cache_get_field_content_int ( 0, "u_id", sql_connection ) ;
		format ( string, sizeof string, "Администратор %s снял(а) Вам мут.", p_info [ playerid ] [ name ] ) ;
		insert_debtor_message ( "Амнистия", string, _u_id ) ;
	}
	else
	{
		new scm_string [ 34 + MAX_PLAYER_NAME ] ;
		format ( scm_string, sizeof scm_string, "Аккаунт %s не найден в базе данных.", mname ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
	}
	return 1 ;
}

CMD:offmute ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 3 ) return 1 ;
	new
		mname [ MAX_PLAYER_NAME ],
		mtime,
		mreason [ 42 ] ;
	if ( sscanf ( params, "s[24]ds[42]", mname, mtime, mreason ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /offmute [имя игрока] [минуты] [причина]" ) ;
	if ( ! ( 0 < mtime <= 180 ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Время мута не должно быть меньше 1 и больше 180 минут." ) ;

    new _pl_id ;
	sscanf ( mname, "u", _pl_id ) ;
	if ( IsPlayerConnected ( _pl_id ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок в сети." ) ;

	new sql_string [ 61 + MAX_PLAYER_NAME ] ;
	format ( sql_string, sizeof sql_string, "SELECT `u_id` FROM `users` WHERE `u_name` = '%s' LIMIT 1", mname ) ;
	mysql_tquery ( sql_connection, sql_string, "offmute_check_callback", "isds", playerid, mname, mtime, mreason ) ;
	return 1 ;
}

CMD:jaillist ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 1 ) return 1 ;

	new rows_amount ;
	new scm_string [ 28 + 24 + 4 + 4 + 8 ], jail_string [ 32 ] ;
	foreach(new i: logged_players)
	{
		if ( p_info [ i ] [ jailed ] )
		{
			switch ( p_info [ i ] [ jail ] )
			{
			    case 9: format ( jail_string, sizeof jail_string, "{"#cGRInfo"}* ИК" ) ;
			    case 10: format ( jail_string, sizeof jail_string, "{"#cGRInfo"}* Admin Jail" ) ;
			    default: format ( jail_string, sizeof jail_string, "{"#cGRInfo"}* КПЗ" ) ;
			}
			format ( scm_string, sizeof ( scm_string  ), "%s[%i] | %d секунд(ы). %s", p_info [ i ] [ name ], i, p_info [ i ] [ jailed ], jail_string ) ;
			SendClientMessage ( playerid, col_white, scm_string ) ;
			rows_amount ++ ;
		}
	}
	format ( scm_string, sizeof ( scm_string  ), "Игроков найдено: %d.", rows_amount ) ;
	SendClientMessage ( playerid, col_white, scm_string ) ;
	return 1 ;
}

CMD:mutelist ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 2 )return 1 ;
	new rows_amount ;
	foreach(new i: logged_players)
	{
		if ( p_info [ i ] [ mute ] )
		{
			new scm_string [ 25 + MAX_PLAYER_NAME + 4 + 6 ] ;
			format ( scm_string, sizeof ( scm_string  ), "%s[%i] | %d секунд(ы).", p_info [ i ] [ name ], i, p_info [ i ] [ mute ] ) ;
			SendClientMessage ( playerid, col_white, scm_string ) ;
			rows_amount ++ ;
		}
	}
	new scm_string [ 23 + 4 ] ;
	format ( scm_string, sizeof ( scm_string  ), "Игроков найдено: %d.", rows_amount ) ;
	SendClientMessage ( playerid, col_white, scm_string ) ;
	return 1 ;
}

CMD:skick ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 4 )return 1 ;
	if ( sscanf ( params, "us[24]", params [ 0 ], params [ 1 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /skick [ид] [причина]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
    if ( admin_info [ playerid ] [ admin ] < admin_info [ params [ 0 ] ] [ admin ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете выдать наказание администратору выше уровнем." ) ;

    if ( reload_admin_warning ( playerid, "/skick" ) ) return 1 ;

	new scm_string [ 128 ] ;
	format( scm_string, sizeof ( scm_string  ), "{"#cBAdmin"}[A] {"#cGRAdmin"}%s[%d] тихо кикнул игрока %s[%d]. Причина: %s", p_info [ playerid ] [ name ], playerid, p_info [ params [ 0 ] ] [ name ], params [ 0 ], params [ 1 ] ) ;
	foreach(new i: admin_players) SendClientMessage ( i, col_admin, scm_string ) ;

	format ( scm_string, 128, "[S] %s кикнул %s. Причина: %s", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], params [ 1 ] ) ;
	WriteLog ( playerid, TYPE_LOG_KICK, scm_string ) ;
	kick_player ( params [ 0 ] ) ;
 	return 1 ;
}

CMD:banlist ( playerid )
{
	if ( tester_admin [ playerid ] ) return tester_no_access ( playerid ) ;
	if ( admin_info [ playerid ] [ admin ] < 6 )return 1 ;

	page_count [ playerid ] = 1 ;
	mysql_tquery ( sql_connection, !"SELECT * FROM `users_bans` WHERE `u_b_date` > NOW() ORDER BY `users_bans`.`u_b_ndate` DESC", "callback_banlist", "i", playerid ) ;
 	return 1 ;
}

