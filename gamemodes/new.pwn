						break ;
			    	}
			  	}
			}
			if ( ! FindPlayer ) DeerInfo [ A ] [ D_Status ] = 1 ;
		}

		DeerInfo [ A ] [ D_UpdateTime ] -- ;
		if ( ! DeerInfo [ A ] [ D_UpdateTime ] && DeerInfo [ A ] [ D_ObjectID ] != INVALID_OBJECT_ID ) // && IsValidActor ( DeerInfo [ A ] [ D_ObjectID ] ) )
		{
			new Float:DZ = DeerInfo [ A ] [ D_Pos ] [ 2 ], Float:NewPos [ 2 ] ;
