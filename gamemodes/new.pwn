			}
			if ( ! strlen ( inputtext ) )return show_dialog ( playerid, d_bluninvite, DIALOG_STYLE_INPUT, "{"#cBHD"}Чёрный список", "{"#cGRDialog"}Неверный формат никнейма!\n\n{FFFFFF}Введите имя игрока, которого хотите удалить из чёрного списка:", "Принять", "Назад" ) ;
			if ( is_text_invalid ( inputtext ) )return show_dialog ( playerid, d_bluninvite, DIALOG_STYLE_INPUT, "{"#cBHD"}Чёрный список", "{"#cGRDialog"}Неверный формат никнейма!\n\n{FFFFFF}Введите имя игрока, которого хотите удалить из чёрного списка:", "Принять", "Назад" ) ;
			if ( strlen ( inputtext ) < 6 || strlen ( inputtext ) > 24 )return show_dialog ( playerid, d_bluninvite, DIALOG_STYLE_INPUT, "{"#cBHD"}Чёрный список", "{"#cGRDialog"}Неверный формат никнейма!\n\n{FFFFFF}Введите имя игрока, которого хотите удалить из чёрного списка:", "Принять", "Назад" ) ;

            new fraction_id ;
	     	if ( p_info [ playerid ] [ leader ] ) fraction_id = p_info [ playerid ] [ member ] ;
			else fraction_id = player_settings { playerid } ;

			new query_string [ 138 ] ;
			mysql_format ( sql_connection, query_string, sizeof ( query_string ),"SELECT `bl_player` FROM `fractions_blacklist` WHERE `bl_name` = '%e' AND `bl_fraction`='%d' LIMIT 1",
			inputtext, fraction_id ) ;
			mysql_tquery ( sql_connection, query_string, "check_bl_list", "ds", playerid, inputtext ) ;
			return 1 ;
		}
		case d_blinvite:
		{
			if ( ! response )
			{
				show_blacklist ( playerid ) ;
				return 1 ;
			}
			new targetid, reason [ 24 ] ;
			if ( sscanf ( inputtext, "p<,>ds[24]", targetid, reason ) )
			{
			    show_dialog ( playerid, d_blinvite, DIALOG_STYLE_INPUT, "{"#cBHD"}Чёрный список", "{FFFFFF}Введите ID игрока и причину, которого хотите добавить в чёрный список:\n\n{"#cGRDialog"}* Пример ввода: 1, оскорбление организации", "Принять", "Назад" ) ;
			    return 1 ;
			}

			new fraction_id ;
	     	if ( p_info [ playerid ] [ leader ] ) fraction_id = p_info [ playerid ] [ member ] ;
			else fraction_id = player_settings { playerid } ;

			if ( targetid < 0 ) return show_dialog ( playerid, d_blinvite, DIALOG_STYLE_INPUT, "{"#cBHD"}Чёрный список", "{"#cGRDialog"}Неверный ID игрока!\n\n{FFFFFF}Введите ID игрока, которого хотите добавить в чёрный список:\n\n{"#cGRDialog"}* Пример ввода: 1, оскорбление организации", "Принять", "Назад" ) ;
			if ( ! IsPlayerConnected ( targetid ) || targetid == playerid ) return show_dialog ( playerid, d_blinvite, DIALOG_STYLE_INPUT, "{"#cBHD"}Чёрный список", "{"#cGRDialog"}Неверный ID игрока!\n\n{FFFFFF}Введите ID игрока, которого хотите добавить в чёрный список:\n\n{"#cGRDialog"}* Пример ввода: 1, оскорбление организации", "Принять", "Назад" ) ;
			if ( fraction_id == p_info [ targetid ] [ member ] ) return show_dialog ( playerid, d_blinvite, DIALOG_STYLE_INPUT, "{"#cBHD"}Чёрный список", "{"#cGRDialog"}Игрок в Вашей организации!\n\n{FFFFFF}Введите ID игрока, которого хотите добавить в чёрный список:\n\n{"#cGRDialog"}* Пример ввода: 1, оскорбление организации", "Принять", "Назад" ) ;
			if ( strlen ( reason ) < 5 ) return show_dialog ( playerid, d_blinvite, DIALOG_STYLE_INPUT, "{"#cBHD"}Чёрный список", "{"#cGRDialog"}Причина слишком коротка!\n\n{FFFFFF}Введите ID игрока, которого хотите добавить в чёрный список:\n\n{"#cGRDialog"}* Пример ввода: 1, оскорбление организации", "Принять", "Назад" ) ;
            if ( strlen ( reason ) > 24 ) return show_dialog ( playerid, d_blinvite, DIALOG_STYLE_INPUT, "{"#cBHD"}Чёрный список", "{"#cGRDialog"}Причина слишком длинная!\n\n{FFFFFF}Введите ID игрока, которого хотите добавить в чёрный список:\n\n{"#cGRDialog"}* Пример ввода: 1, оскорбление организации", "Принять", "Назад" ) ;

            bl_info [ targetid ] [ bl_onFrac ] [ fraction_id ] = 1 ;
			bl_info [ targetid ] [ bl_kills ] [ fraction_id ] = 0 ;

			new sql_string [ 356 ] ;
			format ( sql_string, sizeof ( sql_string ), "INSERT INTO `fractions_blacklist`(`bl_death`,`bl_player`,`bl_fraction`,`bl_name`,`bl_date`,`bl_last_date`,`bl_reason`,`bl_add_name`) VALUES ('%d','%d','%d','%s',NOW(),NOW(),'%s','%s')",
			bl_info [ targetid ] [ bl_kills ] [ fraction_id ], p_info [ targetid ] [ id ], fraction_id, p_info [ targetid ] [ name ], reason, p_info [ playerid ] [ name ] ) ;
			mysql_tquery ( sql_connection, sql_string ) ;

			format ( sql_string, 144, "{"#cGInfo"}* {"#cWH"}%s добавил Вас в чёрный список \"%s\". Причина: %s", p_info [ playerid ] [ name ], f_info [ fraction_id - 1 ] [ f_name ], reason ) ;
			SendClientMessage ( targetid, col_white, sql_string ) ;
			format ( sql_string, 128, "{"#cGInfo"}* {"#cWH"}Вы добавили в чёрный список %s", p_info [ targetid ] [ name ]);
			SendClientMessage ( playerid, col_white, sql_string );

			format ( sql_string, 128, "Добавил(а) %s в чёрный список. Причина: %s", p_info [ targetid ] [ name ], reason ) ;
			write_fraction ( playerid, fraction_id, TYPE_LOG_BL, sql_string ) ;

			show_blacklist ( playerid ) ;
			return 1 ;
		}
		case d_offmembers_selection:
		{
			if ( ! response ) return ShowLeaderMenu ( playerid ) ;
			if ( listitem == 0 ) membersOffline ( playerid, 0, 1 ) ;
			else show_dialog ( playerid, d_offmembers_filter, DIALOG_STYLE_INPUT, "{"#cBHD"}Члены организации", "{FFFFFF}Введите ранг для фильтра:", "Далее", "Назад" ) ;
			return 1 ;
		}
		case d_offmembers_filter:
		{
