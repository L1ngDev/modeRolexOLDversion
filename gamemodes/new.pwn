			p_t_info [ playerid ] [ pickup_id ] = b_info [ t ] [ b_pickup ] ;

			if ( p_info [ playerid ] [ robbery_money ] != 0 ) p_info [ playerid ] [ robbery_stop ] = 2 ;

			new _b_type = b_info [ t ] [ b_type ] ;
