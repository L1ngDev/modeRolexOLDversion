/*
CREATE TABLE `punishment_kick` (`pun_id` INT(3) NOT NULL DEFAULT '0' , `pun_time` INT(11) NOT NULL DEFAULT '0' , `pun_name` VARCHAR(32) CHARACTER SET utf8 COLLATE utf8_general_ci NULL DEFAULT NULL ) ENGINE = InnoDB;
CREATE TABLE `punishment_jail` (`pun_id` INT(3) NOT NULL DEFAULT '0' , `pun_time` INT(11) NOT NULL DEFAULT '0' , `pun_name` VARCHAR(32) CHARACTER SET utf8 COLLATE utf8_general_ci NULL DEFAULT NULL ) ENGINE = InnoDB;
CREATE TABLE `punishment_warn` (`pun_id` INT(3) NOT NULL DEFAULT '0' , `pun_time` INT(11) NOT NULL DEFAULT '0' , `pun_name` VARCHAR(32) CHARACTER SET utf8 COLLATE utf8_general_ci NULL DEFAULT NULL ) ENGINE = InnoDB;
CREATE TABLE `punishment_ban` (`pun_id` INT(3) NOT NULL DEFAULT '0' , `pun_time` INT(11) NOT NULL DEFAULT '0' , `pun_name` VARCHAR(32) CHARACTER SET utf8 COLLATE utf8_general_ci NULL DEFAULT NULL ) ENGINE = InnoDB;
CREATE TABLE `punishment_mute` (`pun_id` INT(3) NOT NULL DEFAULT '0' , `pun_time` INT(11) NOT NULL DEFAULT '0' , `pun_name` VARCHAR(32) CHARACTER SET utf8 COLLATE utf8_general_ci NULL DEFAULT NULL ) ENGINE = InnoDB;

    ALTER TABLE `punishment_kick` ADD `pun_capture` INT(3) NOT NULL DEFAULT '0' AFTER `pun_time`, ADD `pun_bizwar` INT(3) NOT NULL DEFAULT '0' AFTER `pun_capture`, ADD `pun_family_war` INT(3) NOT NULL DEFAULT '0' AFTER `pun_bizwar`, ADD `pun_green_zone` INT(3) NOT NULL DEFAULT '0' AFTER `pun_family_war`;
    ALTER TABLE `punishment_jail` ADD `pun_capture` INT(3) NOT NULL DEFAULT '0' AFTER `pun_time`, ADD `pun_bizwar` INT(3) NOT NULL DEFAULT '0' AFTER `pun_capture`, ADD `pun_family_war` INT(3) NOT NULL DEFAULT '0' AFTER `pun_bizwar`, ADD `pun_green_zone` INT(3) NOT NULL DEFAULT '0' AFTER `pun_family_war`;
    ALTER TABLE `punishment_warn` ADD `pun_capture` INT(3) NOT NULL DEFAULT '0' AFTER `pun_time`, ADD `pun_bizwar` INT(3) NOT NULL DEFAULT '0' AFTER `pun_capture`, ADD `pun_family_war` INT(3) NOT NULL DEFAULT '0' AFTER `pun_bizwar`, ADD `pun_green_zone` INT(3) NOT NULL DEFAULT '0' AFTER `pun_family_war`;
    ALTER TABLE `punishment_ban` ADD `pun_capture` INT(3) NOT NULL DEFAULT '0' AFTER `pun_time`, ADD `pun_bizwar` INT(3) NOT NULL DEFAULT '0' AFTER `pun_capture`, ADD `pun_family_war` INT(3) NOT NULL DEFAULT '0' AFTER `pun_bizwar`, ADD `pun_green_zone` INT(3) NOT NULL DEFAULT '0' AFTER `pun_family_war`;
	ALTER TABLE `punishment_mute` ADD `pun_capture` INT(3) NOT NULL DEFAULT '0' AFTER `pun_time`, ADD `pun_bizwar` INT(3) NOT NULL DEFAULT '0' AFTER `pun_capture`, ADD `pun_family_war` INT(3) NOT NULL DEFAULT '0' AFTER `pun_bizwar`, ADD `pun_green_zone` INT(3) NOT NULL DEFAULT '0' AFTER `pun_family_war`;

	UPDATE `punishment_jail` SET `pun_capture` = '1', `pun_bizwar` = '1', `pun_family_war` = '1', `pun_green_zone` = '1' WHERE `pun_id` = '0';
	UPDATE `punishment_jail` SET `pun_capture` = '1', `pun_bizwar` = '1', `pun_family_war` = '1', `pun_green_zone` = '1' WHERE `pun_id` = '1';
	UPDATE `punishment_jail` SET `pun_capture` = '1', `pun_bizwar` = '1', `pun_family_war` = '1', `pun_green_zone` = '1' WHERE `pun_id` = '2';
	UPDATE `punishment_jail` SET `pun_capture` = '1', `pun_bizwar` = '1', `pun_family_war` = '1', `pun_green_zone` = '1' WHERE `pun_id` = '3';

	ALTER TABLE `punishment_kick` ADD `pun_shot` INT(3) NOT NULL DEFAULT '0' AFTER `pun_green_zone`;
	ALTER TABLE `punishment_jail` ADD `pun_shot` INT(3) NOT NULL DEFAULT '0' AFTER `pun_green_zone`;
	ALTER TABLE `punishment_warn` ADD `pun_shot` INT(3) NOT NULL DEFAULT '0' AFTER `pun_green_zone`;
