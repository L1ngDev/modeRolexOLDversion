		p_info [ playerid ] [ fly_lic ] = cache_get_field_content_int ( 0, "u_fly_lic", sql_connection ) ;
		p_info [ playerid ] [ gun_lic ] = cache_get_field_content_int ( 0, "u_gun_lic", sql_connection ) ;

		p_info [ playerid ] [ drive_day ] = cache_get_field_content_int ( 0, "u_drive_day", sql_connection ) ;
		p_info [ playerid ] [ boat_day ] = cache_get_field_content_int ( 0, "u_boat_day", sql_connection ) ;
		p_info [ playerid ] [ fly_day ] = cache_get_field_content_int ( 0, "u_fly_day", sql_connection ) ;
		p_info [ playerid ] [ gun_day ] = cache_get_field_content_int ( 0, "u_gun_day", sql_connection ) ;

		if ( p_info [ playerid ] [ drive_lic ] > 1 )
		{
			p_info [ playerid ] [ drive_hour ] = cache_get_field_content_int ( 0, "u_drive_hour", sql_connection ) ;
			cache_get_field_content ( 0, "u_drive_reason", p_info [ playerid ] [ drive_reason ], sql_connection, 16 ) ;
		}
		if ( p_info [ playerid ] [ boat_lic ] > 1 )
		{
			p_info [ playerid ] [ boat_hour ] = cache_get_field_content_int ( 0, "u_boat_hour", sql_connection ) ;
			cache_get_field_content ( 0, "u_boat_reason", p_info [ playerid ] [ boat_reason ], sql_connection, 16 ) ;
		}
		if ( p_info [ playerid ] [ fly_lic ] > 1 )
		{
			p_info [ playerid ] [ fly_hour ] = cache_get_field_content_int ( 0, "u_fly_hour", sql_connection ) ;
			cache_get_field_content ( 0, "u_fly_reason", p_info [ playerid ] [ fly_reason ], sql_connection, 16 ) ;
		}
		if ( p_info [ playerid ] [ gun_lic ] > 1 )
		{
			p_info [ playerid ] [ gun_hour ] = cache_get_field_content_int ( 0, "u_gun_hour", sql_connection ) ;
			cache_get_field_content ( 0, "u_gun_reason", p_info [ playerid ] [ gun_reason ], sql_connection, 16 ) ;
		}

		p_info [ playerid ] [ mechanic_skill ] = cache_get_field_content_int ( 0, "u_mskill", sql_connection ) ;
		p_info [ playerid ] [ bus_skill ] = cache_get_field_content_int ( 0, "u_bskill", sql_connection ) ;
		p_info [ playerid ] [ jackcar_skill ] = cache_get_field_content_int ( 0, "u_jackcarkill", sql_connection ) ;

		p_info [ playerid ] [ hunger ] = cache_get_field_content_int ( 0, "u_hunger", sql_connection ) ;

		p_info [ playerid ] [ hunger_immune ] = cache_get_field_content_int ( 0, "u_hungerimmune", sql_connection ) ;
		p_info [ playerid ] [ hunger_immune_time ] = cache_get_field_content_int ( 0, "u_hungerimmunetime", sql_connection ) ;

		cache_get_field_content ( 0, "u_tempskin", sscanf_delimit, sql_connection, 36 ) ;
		sscanf ( sscanf_delimit, "p<|>ddddd", p_info [ playerid ] [ temp_skin ] [ 0 ], p_info [ playerid ] [ temp_skin ] [ 1 ], p_info [ playerid ] [ temp_skin ] [ 2 ],
		p_info [ playerid ] [ temp_skin ] [ 3 ], p_info [ playerid ] [ temp_skin ] [ 4 ] ) ;

		p_info [ playerid ] [ cellar ] = cache_get_field_content_int ( 0, "u_cellar", sql_connection ) ;

        p_info [ playerid ] [ time_hour ] = cache_get_field_content_int ( 0, "u_time_hour", sql_connection ) ;
		p_info [ playerid ] [ hour_played ] = cache_get_field_content_int ( 0, "u_hour_played", sql_connection ) ;
		p_info [ playerid ] [ week_played ] = cache_get_field_content_int ( 0, "u_week_played", sql_connection ) ;
		p_info [ playerid ] [ tax ] = cache_get_field_content_int ( 0, "u_tax", sql_connection ) ;

		cache_get_field_content ( 0, "u_settings", sscanf_delimit, sql_connection, 24 ) ;
		sscanf ( sscanf_delimit, "p<|>dddddd", p_info [ playerid ] [ settings ] [ 0 ], p_info [ playerid ] [ settings ] [ 1 ],
		p_info [ playerid ] [ settings ] [ 2 ],	p_info [ playerid ] [ settings ] [ 3 ],	p_info [ playerid ] [ settings ] [ 4 ],
		p_info [ playerid ] [ settings ] [ 5 ] ) ;

		cache_get_field_content ( 0, "u_enhancements", sscanf_delimit, sql_connection, 10 ) ;
		sscanf ( sscanf_delimit, "p<|>dddd", p_info [ playerid ] [ enhancement ] [ 0 ], p_info [ playerid ] [ enhancement ] [ 1 ],
		p_info [ playerid ] [ enhancement ] [ 2 ], p_info [ playerid ] [ enhancement ] [ 3 ] ) ;

		p_info [ playerid ] [ promo_used ] = cache_get_field_content_int ( 0, "u_promo", sql_connection ) ;
		cache_get_field_content ( 0, "u_promotext", p_info [ playerid ] [ promo_text ], sql_connection, MAX_PLAYER_NAME ) ;
		p_info [ playerid ] [ promo_hours ] = cache_get_field_content_int ( 0, "u_promo_hours", sql_connection ) ;
		p_info [ playerid ] [ promo_type ] = cache_get_field_content_int ( 0, "u_promo_type", sql_connection ) ;
		p_info [ playerid ] [ promo_p_id ] = cache_get_field_content_int ( 0, "u_promo_p_id", sql_connection ) ;

