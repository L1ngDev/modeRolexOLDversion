stock houses_freeze ( playerid )
{
	global_string [ 0 ] = EOS ;

	new h = p_info [ playerid ] [ house ] - 1, s_year, s_month, s_day ;
	timestamp_to_date ( h_info [ h ] [ h_freeze_date ], s_year, s_month, s_day ) ;

	format ( global_string, 276, "{"#cBL"}1.{"#cWH"} Заморозить {"#cGRDialog"}(Доступно: {"#cGN"}%d{"#cGRDialog"} дн.)\n{"#cBL"}2.{"#cWH"} Последняя заморозка: {"#cGN"}%02d.%02d.%d\n{"#cBL"}3.{"#cWH"} Информация\n{"#cGRDialog"}Осталось {"#cGN"}%d{"#cGRDialog"} дн. до конца заморозки", h_info [ h ] [ h_freeze_day ], s_day, s_month, s_year, h_info [ h ] [ h_freeze ] ) ;
	show_dialog ( playerid, d_h_panel_freeze, DIALOG_STYLE_LIST, "{"#cBHD"}Заморозка дома", global_string, "Выбрать", "Закрыть" ) ;
	return 1 ;
}

stock sell_houses ( s_house_id, playerid = -1, bool: player_pay, bool: auction_status )
{
    format ( h_info [ s_house_id ] [ h_owner_name ], MAX_PLAYER_NAME, "Собственность штата" ) ;

    if ( auction_status == true )
    {
        if ( h_info [ s_house_id ] [ h_price_ticket ] > 0 ) auction_status = false ;
    }

	#if defined m_tablet
		deleteForSellProperty ( s_house_id + 1, CATEGORY_HOUSES ) ;
	#endif

	new query [ 178 ], _h_sell_price = floatround ( ( h_info [ s_house_id ] [ h_price ] * sell_percent ) / 100 ) ;
    if ( playerid != -1 && player_pay == true )
	{
		p_info [ playerid ] [ house ] = -1 ;
		Iter_Remove(player_houses[playerid], s_house_id + 1);

		give_money ( playerid, _h_sell_price ) ;
		insert_money_log ( playerid, INVALID_PLAYER_ID, _h_sell_price, "продажа дома" ) ;

		p_info [ playerid ] [ spawnchange ] = 0 ;
		update_int_sql ( playerid, "u_spawnchange", 0 ) ;

		clear_fam_house ( playerid, s_house_id + 1 ) ;

		format( query, 144, "{"#cGInfo"}* {"#cWH"}Вы продали своё жильё {"#cGN"}№%d{"#cWH"} за {"#cGN"}%d"valute_title"{"#cWH"}.", h_info [ s_house_id ] [ h_id ], _h_sell_price ) ;
		SendClientMessage ( playerid, col_white, query ) ;
	}
	else if ( playerid == -1 && player_pay == true )
	{
		insert_debtor_message ( "Продажа дома (слёт)", "Ваш дом был продан!\nПолучить деньги можно в банке подойдя к надписи получение переводов.", h_info [ s_house_id ] [ h_owner ] ) ;
		insert_return_money ( "Продажа дома (слёт)", _h_sell_price, h_info [ s_house_id ] [ h_owner ] ) ;
	}

	h_info [ s_house_id ] [ h_owner ] = -1 ;
	h_info [ s_house_id ] [ h_closed ] = 0 ;

	DestroyDynamicPickup ( h_info [ s_house_id ] [ h_pickup ] ) ;
	if ( ! h_info [ s_house_id ] [ h_vw ] ) DestroyDynamicMapIcon ( h_info [ s_house_id ] [ h_icon_id ] ) ;
	h_info [ s_house_id ] [ h_pickup ] = CreateDynamicPickup ( pickupPropertyFree, 23, h_info [ s_house_id ] [ h_pos ] [ 0 ], h_info [ s_house_id ] [ h_pos ] [ 1 ], h_info [ s_house_id ] [ h_pos ] [ 2 ], h_info [ s_house_id ] [ h_vw ], -1 ) ;
	if ( ! h_info [ s_house_id ] [ h_vw ] ) h_info [ s_house_id ] [ h_icon_id ] = CreateDynamicMapIcon ( h_info [ s_house_id ] [ h_pos ] [ 0 ], h_info [ s_house_id ] [ h_pos ] [ 1 ], h_info [ s_house_id ] [ h_pos ] [ 2 ], radar_propertyG, 0, 0, 0, -1 ) ;

	save_house ( s_house_id ) ;

	if ( IsValidDynamic3DTextLabel ( h_info [ s_house_id ] [ h_safe ] ) ) DestroyDynamic3DTextLabel ( h_info [ s_house_id ] [ h_safe ] ) ;
	if ( IsValidDynamic3DTextLabel ( h_info [ s_house_id ] [ h_fridge ] ) ) DestroyDynamic3DTextLabel ( h_info [ s_house_id ] [ h_fridge ] ) ;
	if ( h_info [ s_house_id ] [ h_safe_object ] ) DestroyDynamicObject ( h_info [ s_house_id ] [ h_safe_object ] ) ;
	if ( h_info [ s_house_id ] [ h_fridge_object ] ) DestroyDynamicObject ( h_info [ s_house_id ] [ h_fridge_object ] ) ;

	new data [ 48 ] ;
	for ( new i = 0 ; i < 8 ; i ++ )
	{
		h_info [ s_house_id ] [ h_improve ] [ i ] = 0 ;
		if ( ! i ) format ( data, sizeof ( data ),"%d", h_info [ s_house_id ] [ h_improve ] [ i ] ) ;
		else format ( data, sizeof ( data ),"%s|%d", data, h_info [ s_house_id ] [ h_improve ] [ i ] ) ;

		if ( i < 2 ) h_info [ s_house_id ] [ h_safe_data ] [ i ] = 0 ;
		if ( i < 6 ) h_info [ s_house_id ] [ h_safe_guns ] [ i ] = 0 ;
	}

	h_info [ s_house_id ] [ h_sell_status ] =
	h_info [ s_house_id ] [ h_safe_code ] = 0 ;

	global_string [ 0 ] = EOS ;
	format ( global_string, 512, "UPDATE `houses` SET `h_improve` = '%s', `h_sell_status` = '0', `h_safe_code` = '0000',\
									`h_safe_data` = '%d|%d|%d|%d|%d|%d|%d|%d' WHERE `h_id` = '%d' LIMIT 1",
	data, h_info [ s_house_id ] [ h_safe_data ] [ 0 ], h_info [ s_house_id ] [ h_safe_data ] [ 1 ],
	h_info [ s_house_id ] [ h_safe_guns ] [ 0 ], h_info [ s_house_id ] [ h_safe_guns ] [ 1 ], h_info [ s_house_id ] [ h_safe_guns ] [ 2 ],
	h_info [ s_house_id ] [ h_safe_guns ] [ 3 ], h_info [ s_house_id ] [ h_safe_guns ] [ 4 ], h_info [ s_house_id ] [ h_safe_guns ] [ 5 ],
	h_info [ s_house_id ] [ h_id ] ) ;
	mysql_tquery ( sql_connection, global_string ) ;

	if ( auction_status == true )
	{
	    h_info [ s_house_id ] [ h_auction_bet ] = 0 ;
	    h_info [ s_house_id ] [ h_auction_player ] = INVALID_PLAYER_ID ;
        h_info [ s_house_id ] [ h_auction_status ] = 1 ;
        h_info [ s_house_id ] [ h_auction_date ] = SetElapsedTime ( gettime ( ), 24, CONVERT_TIME_TO_HOURS ) ;

		global_string [ 0 ] = EOS ;
		format ( global_string, 256, "UPDATE `houses` SET `h_auction_date` = '%d',\
										`h_auction_bet` = '0', `h_auction_player` = '%d' WHERE `h_id` = '%d' LIMIT 1",
		h_info [ s_house_id ] [ h_auction_date ], h_info [ s_house_id ] [ h_auction_player ], h_info [ s_house_id ] [ h_id ] ) ;
		mysql_tquery ( sql_connection, global_string ) ;

		AddAuctionHouse ( s_house_id + 1 ) ;
		sell_houses_auction ( s_house_id, 1 ) ;
	}
	return 1 ;
}

stock sell_houses_auction ( s_house_id, auction_status = 0 )
{
    if ( auction_status == 1 )
	{
	    h_info [ s_house_id ] [ h_auction_text ] = CreateDynamic3DTextLabel ( "** Недвижимость на аукционе **", col_yellow, h_info [ s_house_id ] [ h_pos ] [ 0 ], h_info [ s_house_id ] [ h_pos ] [ 1 ], h_info [ s_house_id ] [ h_pos ] [ 2 ] + 0.5, 15.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, -1, h_info [ s_house_id ] [ h_vw ], -1 );
	}
	else if ( auction_status == 2 )
	{
	    if ( IsValidDynamic3DTextLabel ( h_info [ s_house_id ] [ h_auction_text ] ) )
		{
			DestroyDynamic3DTextLabel ( h_info [ s_house_id ] [ h_auction_text ] ) ;
			h_info [ s_house_id ] [ h_auction_text ] = Text3D:INVALID_3DTEXT_ID ;
		}
	}
	return 1 ;
}

stock sell_businesses ( businesses_id, playerid = -1, bool: player_pay, bool: auction_status )
{
    new _b_sell_price = floatround ( ( b_info [ businesses_id ] [ b_price ] * sell_percent ) / 100 ),
		query_string [ 200 + MAX_PLAYER_NAME + 1 ] ;
	format ( b_info [ businesses_id ] [ b_owner_name ], MAX_PLAYER_NAME, "Собственность штата" ) ;
	b_info [ businesses_id ] [ b_owner_inc ] = -1 ;

	if ( auction_status == true )
    {
        if ( b_info [ businesses_id ] [ b_donate_price ] > 0 ) auction_status = false ;
    }

	#if defined m_tablet
		deleteForSellProperty ( businesses_id + 1, CATEGORY_BUSINESS ) ;
	#endif

	if ( playerid != -1 && player_pay == true )
	{
	    give_money ( playerid, _b_sell_price ) ;
		insert_money_log ( playerid, INVALID_PLAYER_ID, _b_sell_price, "продажа бизнеса" ) ;

	    Iter_Remove ( business_players[businesses_id + 1], playerid ) ;

		p_info [ playerid ] [ business ] = -1 ;
		Iter_Remove(player_business[playerid], b_info [ businesses_id ] [ b_id ]);

		p_info [ playerid ] [ business_rang ] = 0 ;
		update_int_sql ( playerid, "u_business_rang", 0 ) ;

		PlayerPlaySound ( playerid, 1052, 0.0, 0.0, 0.0 ) ;

		format ( query_string, 144, "{"#cGInfo"}* {"#cWH"}Вы продали бизнес {"#cGN"}%s(№%d){"#cWH"} за {"#cGN"}%d"valute_title"{"#cWH"}.", b_types [ b_info [ businesses_id ] [ b_type ] ], b_info [ businesses_id ] [ b_id ], _b_sell_price ) ;
		SendClientMessage ( playerid, col_white, query_string ) ;
	}
	else if ( playerid == -1 && player_pay == true )
	{
		insert_debtor_message ( "Продажа бизнеса (слёт)", "Ваш бизнес был продан!\nПолучить деньги можно в банке подойдя к надписи получение переводов.", b_info [ businesses_id ] [ b_owner_inc ] ) ;
		insert_return_money ( "Продажа бизнеса (слёт)", _b_sell_price, b_info [ businesses_id ] [ b_owner_inc ] ) ;
	}

	format ( query_string, 136, "UPDATE `businesses` SET `b_owner_inc` = '-1' WHERE `b_id` = '%d' LIMIT 1", b_info [ businesses_id ] [ b_id ] ) ;
	mysql_tquery ( sql_connection, query_string ) ;

	if ( auction_status == true )
	{
	    b_info [ businesses_id ] [ b_auction_bet ] = 0 ;
	    b_info [ businesses_id ] [ b_auction_player ] = INVALID_PLAYER_ID ;
        b_info [ businesses_id ] [ b_auction_status ] = 1 ;
        b_info [ businesses_id ] [ b_auction_date ] = SetElapsedTime ( gettime ( ), 24, CONVERT_TIME_TO_HOURS ) ;

		AddAuctionBusiness ( businesses_id + 1 ) ;

		global_string [ 0 ] = EOS ;
		format ( global_string, 256, "UPDATE `businesses` SET `b_auction_date` = '%d',\
										`b_auction_bet` = '0', `b_auction_player` = '%d' WHERE `b_id` = '%d' LIMIT 1",
		b_info [ businesses_id ] [ b_auction_date ], b_info [ businesses_id ] [ b_auction_player ], b_info [ businesses_id ] [ b_id ] ) ;
		mysql_tquery ( sql_connection, global_string ) ;
	}

	for ( new i = 0 ; i < MAX_B_IMPROVE ; i ++ )
	{
	    b_info [ businesses_id ] [ b_improve ] [ i ] = 0 ;
	}

	b_info [ businesses_id ] [ b_sell_status ] = 0 ;
	b_info [ businesses_id ] [ b_maxproduct ] = 15000 ;
	format ( query_string, sizeof query_string, "UPDATE `businesses` SET `b_maxproduct` = '%d', `b_sell_status` = '0', `b_improve` = '0|0|0|0' WHERE `b_id` = '%d' LIMIT 1", b_info [ businesses_id ] [ b_maxproduct ], b_info [ businesses_id ] [ b_id ] ) ;
	mysql_tquery ( sql_connection, query_string, "", "" ) ;

	update_blabel ( businesses_id, auction_status ) ;
	return 1 ;
}

CMD:cellarlock ( playerid )
{
	if ( p_info [ playerid ] [ cellar ] == -1 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас нет гаража." ) ;
	new h = p_info [ playerid ] [ cellar ] - 1 ;

	if ( ! IsPlayerInRangeOfPoint ( playerid, 4.00, cellar_info [ h ] [ cl_pos ] [ 0 ], cellar_info [ h ] [ cl_pos ] [ 1 ], cellar_info [ h ] [ cl_pos ] [ 2 ] ) &&
	( ! IsPlayerInRangeOfPoint ( playerid, 30, cellar_enter_pos [ 0 ], cellar_enter_pos [ 1 ], cellar_enter_pos [ 2 ] ) && GetPlayerVirtualWorld ( playerid ) != cellar_info [ h ] [ cl_id ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы слишком далеко от своего подвала." ) ;

	if ( cellar_info [ h ] [ cl_closed ] == 0 )
	{
		cellar_info [ h ] [ cl_closed ] = 1 ;
		GameTextForPlayer ( playerid,"~r~closed", 2000, 3 ) ;
	}
	else
	{
		cellar_info [ h ] [ cl_closed ] = 0 ;
		GameTextForPlayer ( playerid, "~g~opened", 2000, 3 ) ;
	}

	new query_string [ 78 ];
	format ( query_string, sizeof ( query_string ), "UPDATE `cellars` SET `cl_closed` = '%d' WHERE `cl_id` = '%d' LIMIT 1", cellar_info [ h ] [ cl_closed ], h + 1 ) ;
	mysql_tquery ( sql_connection, query_string ) ;
	return 1 ;
}

CMD:cellarmenu ( playerid )
{
	if ( p_info [ playerid ] [ cellar ] == -1 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас нет гаража." ) ;
	new h = p_info [ playerid ] [ cellar ] - 1 ;
	if ( ! IsPlayerInRangeOfPoint ( playerid, 4.00, cellar_info [ h ] [ cl_pos ] [ 0 ], cellar_info [ h ] [ cl_pos ] [ 1 ], cellar_info [ h ] [ cl_pos ] [ 2 ] ) &&
	( ! IsPlayerInRangeOfPoint ( playerid, 30, cellar_enter_pos [ 0 ], cellar_enter_pos [ 1 ], cellar_enter_pos [ 2 ] ) && GetPlayerVirtualWorld ( playerid ) != cellar_info [ h ] [ cl_id ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы слишком далеко от своего подвала." ) ;
	show_cellarmenu ( playerid ) ;
	return 1 ;
}

stock show_cellarmenu ( playerid )
{
	if ( p_info [ playerid ] [ cellar ] == -1 )return 1 ;
	if ( cellar_info [ p_info [ playerid ] [ cellar ] - 1 ] [ cl_closed ] == 1 )
	{
		show_dialog ( playerid, d_cellarmenu, DIALOG_STYLE_LIST, "{"#cBHD"}Управление гаражём",
		"{"#cBL"}1.{"#cGN"} Открыть двери гаража\n{"#cBL"}2.{ffffff} Улучшения\n{"#cBL"}3.{ffffff} Склад", "Выбрать", "Закрыть" ) ;
	}
	else
	{
		show_dialog ( playerid, d_cellarmenu, DIALOG_STYLE_LIST, "{"#cBHD"}Управление гаражём",
		"{"#cBL"}1.{"#cRD"} Закрыть двери гаража\n{"#cBL"}2.{ffffff} Улучшения\n{"#cBL"}3.{ffffff} Склад", "Выбрать", "Закрыть" ) ;
	}
	return 1 ;
}

stock show_cellar_cellar ( playerid )
{
    if ( job_timer [ playerid ] != -1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}В данный момент недоступно. Подождите немного..." ) ;
	if ( GetPVarInt ( playerid, "cellar_id" ) < 1 ) return bad_exit ( playerid ) ;

	#if defined m_craft
		show_dialog ( playerid, d_cellar_action, DIALOG_STYLE_LIST, "{"#cBHD"}Гараж", "{"#cBL"}1.{ffffff} Гидропонная ферма\n{"#cBL"}2.{ffffff} Снять розыск\n{"#cBL"}3.{ffffff} Сбор оружия\n{"#cBL"}4.{ffffff} Верстак для крафта", "Выбрать", "Закрыть" ) ;
	#else
		show_dialog ( playerid, d_cellar_action, DIALOG_STYLE_LIST, "{"#cBHD"}Гараж", "{"#cBL"}1.{ffffff} Гидропонная ферма\n{"#cBL"}2.{ffffff} Снять розыск\n{"#cBL"}3.{ffffff} Сбор оружия", "Выбрать", "Закрыть" ) ;
	#endif

	if ( cellar_info [ GetPVarInt ( playerid, "cellar_id" ) - 1 ] [ cl_seed_time ] < gettime ( ) ) create_cl_seed ( GetPVarInt ( playerid, "cellar_id" ) ) ;
	return 1 ;
}

CMD:sellcellar ( playerid, params [ ] )
{
	if ( p_info [ playerid ] [ cellar ] == -1 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет гаража." ) ;
	new dialog_string [ 108 ] ;
	format ( dialog_string, sizeof ( dialog_string ),"{ffffff}Вы действительно хотите продать недвижимость государству?\n\t\t\tЦена: {"#cGN"}%d"valute_title_"", cellar_info [ p_info [ playerid ] [ cellar ] - 1 ] [ cl_price ] ) ;
	show_dialog ( playerid, d_sellcellar, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Продажа недвижимости", dialog_string, "Продать", "Закрыть" ) ;
	return 1 ;
}

CMD:cellar ( playerid )
{
	if ( p_info [ playerid ] [ cellar ] == -1 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет гаража." ) ;
	new s_house_id = p_info [ playerid ] [ cellar ] - 1 ;
	SetPlayerRaceCheckpoint ( playerid, 1, cellar_info [ s_house_id ] [ cl_pos ] [ 0 ], cellar_info [ s_house_id ] [ cl_pos ] [ 1 ], cellar_info [ s_house_id ] [ cl_pos ] [ 2 ], 0.0, 0.0, 0.0, 4.0 ) ;
	SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Ваш гараж обозначен на карте красной меткой." ) ;
	is_gps_used { playerid } = 1 ;
	return 1 ;
}

CMD:changecellar ( playerid, params [ ] )
{
	if ( p_info [ playerid ] [ cellar ] == -1 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет гаража." ) ;
	if ( p_info [ playerid ] [ hour_played ] < THREE_HOUR_PLAYED ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Доступно с 3 часов в игре. Используйте /mm - Информация о персонаже - Статистика персонажа." ) ;
	if ( sscanf(params, "dd", params [ 0 ], params [ 1 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /changecellar [ид] [цена]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( params [ 1 ] < 1 || params [ 1 ] > 100000000 || params [ 1 ] == INVALID_PRICE )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Цена не может быть меньше {"#cRD"}1"valute_title_"{"#cGRInfo"} и больше {"#cRD"}100.000.000"valute_title"{"#cGRInfo"}." ) ;
	if ( ! IsPlayerInRangeOfPoint ( params [ 0 ], 5, p_t_info [ playerid ] [ p_pos ] [ 0 ],
													p_t_info [ playerid ] [ p_pos ] [ 1 ],
													p_t_info [ playerid ] [ p_pos ] [ 2 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;
	if ( params [ 0 ] == playerid ) return 	SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете продать гараж самому себе." ) ;
	if ( p_info [ params [ 0 ] ] [ hour_played ] < THREE_HOUR_PLAYED ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не отыграл 3 часа." ) ;
    if ( ! bad_dialog ( params [ 0 ] ) || ! bad_dialog ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок в данный момент не может осуществлять сделки.") ;
	if ( cooldown_sentence [ playerid ] > gettime ( ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Предложение о сделке можно отправлять один раз в {"#cRD"}45 секунд{"#cGRInfo"}." ) ;

    if ( GetString ( p_t_info [ params [ 0 ] ] [ p_ip ], p_t_info [ playerid ] [ p_ip ] ) )
	{
		new scm_string [ 128 ] ;
		format ( scm_string, sizeof ( scm_string ), "{"#cBAdmin"}[A]{"#cGRAdmin"} %s[%d] попытка продажи гаража %s[%d] | same ip", p_info [ playerid ] [ name ], playerid, p_info [ params [ 0 ] ] [ name ], params [ 0 ] ) ;
		foreach(new i: admin_players)SendClientMessage ( i, col_admin, scm_string ) ;

		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Невозможно продать данному игроку." ) ;
		return 1 ;
	}

    cooldown_sentence [ playerid ] = gettime ( ) + time_sell_sentence ;

    buyer_id [ playerid ] = params [ 0 ] ;
	sell_price [ playerid ] = params [ 1 ] ;
	sell_item [ playerid ] = p_info [ playerid ] [ cellar ] ;
	seller_id [ params [ 0 ] ] = playerid ;

	sell_time { playerid } =
	sell_time { params [ 0 ] } = time_sell_null ;

	new dialog_string [ 90 + MAX_PLAYER_NAME + 32 + 1 + 6 ] ;
	format ( dialog_string, sizeof ( dialog_string  ), "{"#cBL"}%s {FFFFFF}предлагает Вам приобрести гараж номер {"#cBL"}%d{FFFFFF} за {"#cBL"}%s"valute_title_"", p_info [ playerid ] [ name ], p_info [ playerid ] [ cellar ], GetPlayerCashValueToSmile ( params [ 1 ] ) ) ;
	show_dialog ( params [ 0 ], d_c_sell_accept, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Покупка недвижимости", dialog_string, "Купить", "Отмена" ) ;

	format ( dialog_string, 118, "{"#cGInfo"}* {"#cWH"}Вы предложили {"#cGN"}%s{"#cWH"} приобрести Ваш гараж за %s$",
	p_info [ params [ 0 ] ] [ name ], GetPlayerCashValueToSmile ( params [ 1 ] ) ) ;
	SendClientMessage ( playerid, col_white, dialog_string ) ;
	return 1 ;
}

stock show_bpanel_advertise_sell ( playerid )
{
	if ( Iter_Count(player_business[playerid]) == 1 )
	{
	    p_info [ playerid ] [ business ] = Iter_First(player_business[playerid]) ;

	    show_dialog ( playerid, d_advertise_bpanel_price, DIALOG_STYLE_INPUT, "{"#cBHD"}Укажите цену", "{"#cWH"}Введите цену указав только цифры:\n\n{"#cGRDialog"}* Если Вы не уверены в цене и ждёте предложений, то введите цифру 0.", "Выбрать", "Закрыть" ) ;
	}
	else
	{
	    global_string [ 0 ] = EOS ;
	    new line_string [ 128 ], count_b = 0, _b_name [ 17 ], _b_type [ 17 ], header_string [ 47 + ( 4 * 2 ) ] ;
	    foreach(new b: player_business[playerid])
	    {
	        set_player_listitem_values ( playerid, count_b, b ) ;

	        count_b ++ ;

	        if ( strlen ( b_types [ b_info [ b - 1 ] [ b_type ] ] ) > 14 )
			{
				format ( _b_type, 14, "%s", b_types [ b_info [ b - 1 ] [ b_type ] ] ) ;
				strcat ( _b_type, "..." ) ;
			}
			else format ( _b_type, 14, "%s", b_types [ b_info [ b - 1 ] [ b_type ] ] ) ;

	        if ( strlen ( b_info [ b - 1 ] [ b_name ] ) > 14 )
			{
				format ( _b_name, 14, "%s", b_info [ b - 1 ] [ b_name ] ) ;
				strcat ( _b_name, "..." ) ;
			}
			else format ( _b_name, 14, "%s", b_info [ b - 1 ] [ b_name ] ) ;

			format ( line_string, sizeof line_string, "{"#cBL"}%d.{"#cWH"} (%s) %s {"#cGRDialog"}(%s{"#cGRDialog"}){"#cWH"}. Продуктов: {"#cBL"}%d\n", count_b, _b_type, _b_name, ( b_info [ b - 1 ] [ b_close ] ) ? ( "{"#cRD"}Закрыт" ) : ( "{"#cGN"}Открыт" ), b_info [ b - 1 ] [ b_product ] ) ;
			strcat ( global_string, line_string ) ;
		}

		format ( header_string, sizeof header_string, "{"#cBHD"}Бизнесы ({"#cWH"}%d из %d{"#cBHD"})", Iter_Count(player_business[playerid]), p_info [ playerid ] [ max_biz ] ) ;
	    show_dialog ( playerid, d_bpanel_advertise_sell, DIALOG_STYLE_LIST, header_string, global_string, "Выбрать", "Закрыть" ) ;
	}
	return 1 ;
}

alias:bpanel("bizinfo")
CMD:bpanel ( playerid )
{
	if ( Iter_Count(player_business[playerid]) > 0 )
	{
	    if ( p_info [ playerid ] [ b_worker ] != -1 )
	    {
			Iter_Remove ( business_players[p_info [ playerid ] [ b_worker ]], playerid ) ;

		    p_info [ playerid ] [ business_rang ] = 0 ;
			p_info [ playerid ] [ b_worker ] = -1 ;

			new _t_string [ 93 + 9 ] ;
			format ( _t_string, sizeof ( _t_string ), "UPDATE `users` SET `u_bworker` = '-1', `u_business_rang` = '0' WHERE `u_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
			mysql_tquery ( sql_connection, _t_string ) ;
		}

		show_select_bpanel ( playerid ) ;
		return 1 ;
	}

    if ( p_info [ playerid ] [ b_worker ] != -1 )
	{
		if ( p_info [ playerid ] [ business_rang ] < b_info [ p_info [ playerid ] [ b_worker ] - 1 ] [ b_settings ] [ 3 ] )
		{
		    static const _str [ ] = "{"#cRInfo"}* {"#cGRInfo"}Команда доступна с должности %s (%d)." ;
		    new scm_string [ sizeof _str + 30 + 4 ] ;
		    format ( scm_string, sizeof scm_string, _str, b_rank [ p_info [ playerid ] [ b_worker ] - 1 ] [ b_info [ p_info [ playerid ] [ b_worker ] - 1 ] [ b_settings ] [ 3 ] - 1 ], b_info [ p_info [ playerid ] [ b_worker ] - 1 ] [ b_settings ] [ 3 ] ) ;
			SendClientMessage ( playerid, col_gray, scm_string ) ;
			return 1 ;
		}
		show_bpanel ( playerid ) ;
		return 1 ;
	}

	SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас нет бизнеса." ) ;
	return 1 ;
}

stock show_select_bpanel ( playerid )
{
	if ( Iter_Count(player_business[playerid]) == 1 )
	{
	    p_info [ playerid ] [ business ] = Iter_First(player_business[playerid]) ;
        show_bpanel ( playerid ) ;
	}
	else
	{
	    global_string [ 0 ] = EOS ;
	    new line_string [ 128 ], count_b = 0, _b_name [ 17 ], _b_type [ 17 ], header_string [ 47 + ( 4 * 2 ) ] ;
	    foreach(new b: player_business[playerid])
	    {
	        set_player_listitem_values ( playerid, count_b, b ) ;

	        count_b ++ ;

	        if ( strlen ( b_types [ b_info [ b - 1 ] [ b_type ] ] ) > 14 )
			{
				format ( _b_type, 14, "%s", b_types [ b_info [ b - 1 ] [ b_type ] ] ) ;
				strcat ( _b_type, "..." ) ;
			}
			else format ( _b_type, 14, "%s", b_types [ b_info [ b - 1 ] [ b_type ] ] ) ;

	        if ( strlen ( b_info [ b - 1 ] [ b_name ] ) > 14 )
			{
				format ( _b_name, 14, "%s", b_info [ b - 1 ] [ b_name ] ) ;
				strcat ( _b_name, "..." ) ;
			}
			else format ( _b_name, 14, "%s", b_info [ b - 1 ] [ b_name ] ) ;

			format ( line_string, sizeof line_string, "{"#cBL"}%d.{"#cWH"} (%s) %s {"#cGRDialog"}(%s{"#cGRDialog"}){"#cWH"}. Продуктов: {"#cBL"}%d\n", count_b, _b_type, _b_name, ( b_info [ b - 1 ] [ b_close ] ) ? ( "{"#cRD"}Закрыт" ) : ( "{"#cGN"}Открыт" ), b_info [ b - 1 ] [ b_product ] ) ;
			strcat ( global_string, line_string ) ;
		}

		format ( header_string, sizeof header_string, "{"#cBHD"}Бизнесы ({"#cWH"}%d из %d{"#cBHD"})", Iter_Count(player_business[playerid]), p_info [ playerid ] [ max_biz ] ) ;
	    show_dialog ( playerid, d_b_panel_select, DIALOG_STYLE_LIST, header_string, global_string, "Выбрать", "Закрыть" ) ;
	}
	return 1 ;
}

stock show_bpanel ( playerid )
{
	global_string [ 0 ] = EOS ;

	new _b_id ;
	if ( p_info [ playerid ] [ b_worker ] != -1 ) _b_id = p_info [ playerid ] [ b_worker ] ;
	else _b_id = p_info [ playerid ] [ business ] ;

	new _b_type = b_info [ _b_id - 1 ] [ b_type ] ;
	if ( _b_type == bizz_type_ammo ||
		_b_type == bizz_type_shop ||
		_b_type == bizz_type_pharm ||
		_b_type == bizz_type_clothes ||
		_b_type == bizz_type_cafe ||
		_b_type == bizz_type_club ||
		_b_type == bizz_type_bar ||
		_b_type == bizz_type_casino ||
		_b_type == bizz_type_gym ||
		_b_type == bizz_type_fish ||
		_b_type == bizz_type_market_place ||
		_b_type == bizz_type_workshop )
	{
		strcat ( global_string, "{"#cBL"}1.{"#cWH"} Управление кассой\n" ) ;
		strcat ( global_string, "{"#cBL"}2.{"#cWH"} Заказать продукты\n" ) ;
