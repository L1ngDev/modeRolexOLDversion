	}
	format ( global_string, 700, "{"#cGRDialog"}- {"#cWH"}Текущее место появления: {"#cGN"}%s\n{"#cBL"}1.{"#cWH"} На вокзале\n{"#cBL"}2.{"#cWH"} В собственном доме\n{"#cBL"}3.{"#cWH"} На базе организации\n{"#cBL"}4.{"#cWH"} В личной яхте\n{"#cBL"}5.{"#cWH"} Личный гараж\n{"#cBL"}6.{"#cWH"} В арендованом доме\n{"#cBL"}7.{"#cWH"} В отеле\n{"#cBL"}8.{"#cWH"} В семейном доме", spawn_text ) ;
	show_dialog ( playerid, d_spawnchange_entrance, DIALOG_STYLE_LIST, "{"#cBHD"}Выбор места появления", global_string, "Выбрать", "Закрыть" ) ;
	return 1 ;
}

CMD:exitlobby ( playerid )
{
    if ( player_duel [ playerid ] [ duel_in_lobby ] != INVALID_PLAYER_ID )
	{
	    if ( player_duel [ playerid ] [ duel_in_lobby ] == playerid )
	    {
	        Iter_Remove(duels_created, playerid);
			foreach(new i: logged_players)
			{
			    if ( player_duel [ i ] [ duel_in_lobby ] != playerid ) continue ;

				SendClientMessage ( i, col_white, !"{"#cGInfo"}* {"#cWH"}Создатель лобби покинул лобби. Лобби закрылось!" ) ;

				set_pos ( i, last_coord [ i ] [ 0 ], last_coord [ i ] [ 1 ], last_coord [ i ] [ 2 ], last_coord [ i ] [ 3 ], last_int [ i ], last_virt [ i ] ) ;

				reset_player_weapon ( i ) ;
				for ( new j = 0 ; j < 12 ; j ++ )
				{
					give_weapon ( i, duel_guns [ i ] [ j ] [ 0 ], duel_guns [ i ] [ j ] [ 1 ] ) ;
				}

				ClearPVars_Duel ( i ) ;
			}
	    }

	    set_pos ( playerid, last_coord [ playerid ] [ 0 ], last_coord [ playerid ] [ 1 ], last_coord [ playerid ] [ 2 ], last_coord [ playerid ] [ 3 ], last_int [ playerid ], last_virt [ playerid ] ) ;

	    reset_player_weapon ( playerid ) ;
		for ( new i = 0 ; i < 12 ; i ++ )
		{
			give_weapon ( playerid, duel_guns [ playerid ] [ i ] [ 0 ], duel_guns [ playerid ] [ i ] [ 1 ] ) ;
		}

    	ClearPVars_Duel ( playerid ) ;
	}
	return 1 ;
}

CMD:exitrace ( playerid )
{
	if ( ! is_player_race_regged [ playerid ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не участвуете в гонке." ) ;

	#if defined m_player_race
	    player_race_exitrace ( playerid ) ;
	#endif

	is_player_race_regged [ playerid ] = false ;
	if ( StartRace == 2 )
 	{
 	    PlayerRaceCount -- ;

		DestroyVehicle ( player_race_vehicle [ playerid ], 22 ) ;
		DisableRemoteVehicleCollisions(playerid, 0);
		DisablePlayerRaceCheckpoint ( playerid ) ;
		set_pos ( playerid, last_coord [ playerid ] [ 0 ], last_coord [ playerid ] [ 1 ], last_coord [ playerid ] [ 2 ], last_coord [ playerid ] [ 3 ], last_int [ playerid ], last_virt [ playerid ] ) ;
		player_race_cp [ playerid ] =
		player_race_first_cp [ playerid ] = 0 ;
		player_race_vehicle [ playerid ] = INVALID_VEHICLE_ID ;
	}
	SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы успешно покинули гонки." ) ;
	return 1;
}

CMD:exitpaint ( playerid )
{
    if ( ! TeamPaint [ playerid ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не участвуете в PaintBall." ) ;

	if ( StartPaintBall == 2 )
	{
 		set_health ( playerid, 100 ) ;
		reset_player_weapon ( playerid ) ;

		set_pos ( playerid, last_coord [ playerid ] [ 0 ], last_coord [ playerid ] [ 1 ], last_coord [ playerid ] [ 2 ], last_coord [ playerid ] [ 3 ], last_int [ playerid ], last_virt [ playerid ] ) ;

		for ( new j = 0 ; j < 5 ; j ++ ) SendDeathMessageToPlayer ( playerid, 1001, 1001, 200 ) ;

		new _paint_place = GetPVarInt ( playerid, "OnPaint" ) ;
	    format ( PaintList [ _paint_place ] [ Killername ], MAX_PLAYER_NAME, "Нет" ) ;
	    PaintList [ _paint_place ] [ PlayerID ] = -1 ;

		PaintList [ _paint_place ] [ KillsPoint ] =
		PaintList [ _paint_place ] [ DeathsPoint ] =
		PaintList [ _paint_place ] [ Sortirovan ] =
		PaintList [ _paint_place ] [ DamagePoint ] = 0 ;
		DeletePVar ( playerid, "OnPaint" ) ;
	}
	switch ( TeamPaint [ playerid ] )
	{
	    case 1: BluePlayer -- ;
	    case 2: RedPlayer -- ;
	}
	TeamPaint [ playerid ] = 0 ;
	SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы успешно покинули PaintBall." ) ;

	fraction_duty ( playerid ) ;
	return 1 ;
}

CMD:startpaint ( playerid )
{
	if ( admin_info [ playerid ] [ admin ] < 6 )return 1 ;

	TimerPaintBall = 300 ;
	StartPaintBall = 1 ;
	RedScore = BlueScore = RedPlayer = BluePlayer = 0 ;

	PaintBallMap = random ( 2 ) ;
	foreach(new i: logged_players)
	{
		if ( TeamPaint [ i ] )
		{
			TeamPaint [ i ] = 0 ;
			set_pos ( i, last_coord [ i ] [ 0 ], last_coord [ i ] [ 1 ], last_coord [ i ] [ 2 ], last_coord [ i ] [ 3 ], last_int [ i ], last_virt [ i ] ) ;
		}
	}

	for ( new i = 0 ; i < sizeof ( PaintList ) ; i ++ )
	{
		format ( PaintList [ i ] [ Killername ], MAX_PLAYER_NAME, "Нет" ) ;
		PaintList [ i ] [ PlayerID ] = -1 ;

		PaintList [ i ] [ KillsPoint ] =
		PaintList [ i ] [ DeathsPoint ] =
		PaintList [ i ] [ Sortirovan ] =
		PaintList [ i ] [ DamagePoint ] = 0 ;
	}

	SendClientMessageToAll( col_yellow, !"* Через 5 минут пройдет мероприятие \"PaintBall\". (/gps > Прочее > Центр развлечений)");
	return true ;
}

CMD:startrace ( playerid )
{
	if ( admin_info [ playerid ] [ admin ] < 6 )return 1 ;

	TimerRace = 20 ;
	StartRace = 1 ;
	RaceCountWinner =
	PlayerRaceCount = 0 ;
	RaceVehicle = Race_Car [ random ( 18 ) ] ;

	foreach(new i: logged_players)
	{
		if ( is_player_race_regged [ i ] )
		{
			DestroyVehicle ( player_race_vehicle [ i ], 23 ) ;
			player_race_vehicle [ i ] = INVALID_VEHICLE_ID ;
			is_player_race_regged [ i ] = false ;

			player_race_cp [ i ] =
			player_race_first_cp [ i ] = 0 ;

			DisableRemoteVehicleCollisions ( i, 0 ) ;
			set_pos ( i, last_coord [ i ] [ 0 ], last_coord [ i ] [ 1 ], last_coord [ i ] [ 2 ], last_coord [ i ] [ 3 ], last_int [ i ], last_virt [ i ] ) ;
		}
	}
	SendClientMessageToAll( col_yellow, !"* Через 5 минут пройдет мероприятие \"Гонки\". (/gps > Прочее > Центр развлечений)");
	mysql_tquery ( sql_connection, !"SELECT * FROM `src_info` ORDER BY RAND()", "server_raceinfo_loading", "" ) ;
	return true ;
}

CMD:setwarehouse ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 8 )return 1 ;
	if ( sscanf ( params, "ddd", params [ 0 ], params [ 1 ], params [ 2 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /setwarehouse [организация] [предмет] [кол-во]" ) ;
	if ( params [ 0 ] < 0 || params [ 0 ] > fraction_count ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Неверный ID организации." ) ;
	if ( params [ 1 ] < 0 || params [ 1 ] < 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Неверное количество боеприпасов." ) ;

	new USERS_INVENTORY_STRUCT: inventoryStruct [ _:INV_STRUCTURE_MAX ] ;
	inventoryStruct [ _:INV_ITEM ] = params [ 1 ] ;
	inventoryStruct [ _:INV_ITEM_COUNT ] = params [ 2 ] ;
	inventoryStruct [ _:INV_ITEM_TYPE ] = 0 ;
	inventoryStruct [ _:INV_ITEM_REGION ] = "" ;
	inventoryStruct [ _:INV_ITEM_PLATE ] = "" ;
	inventoryStruct [ _:INV_ITEM_PLATE_TYPE ] = NUMBERPLATE_TYPE_NONE ;
	inventoryStruct [ _:INV_ITEM_GIVE_DATE ] = 0 ;
	inventoryStruct [ _:INV_ITEM_ID ] = 0 ;
	inventoryStruct [ _:INV_ITEM_DATE ] = -1 ;
	give_fraction_item ( params [ 0 ], -1, inventoryStruct ) ;

	new query_string [ 128 ] ;
	format ( query_string, sizeof ( query_string  ), "{"#cBAdmin"}[A]{"#cGRAdmin"} %s[%i] пополнил склад %s (%s, %d шт.)", p_info [ playerid ] [ name ], playerid, f_info [ params [ 0 ] - 1 ] [ f_name ], item_name ( params [ 1 ] ), params [ 2 ] ) ;
	foreach(new i: admin_players) SendClientMessage ( i, col_admin, query_string ) ;

	if ( params [ 0 ] >= 18 && params [ 0 ] <= 25 ) update_gdorm_text ( params [ 0 ] ) ;

	format(query_string, 128, "%s пополнил склад %s (%s, %d шт.)", p_info [ playerid ] [ name ], f_info [ params [ 0 ] - 1 ] [ f_name ], item_name ( params [ 1 ] ), params [ 2 ] ) ;
	WriteLog(playerid, TYPE_LOG_ADMIN, query_string);
	return 1 ;
}

CMD:setmoneyhouse ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 8 )return 1 ;
	if ( ! IsFounder ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}К сожалению, Вам данная функция не доступна." ) ;
	if ( sscanf ( params, "dd", params [ 0 ], params [ 1 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /setmoneyhouse [организация] [кол-во]" ) ;
	if ( params [ 0 ] < 0 || params [ 0 ] > fraction_count ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Неверный ID организации." ) ;

	f_info [ params [ 0 ] - 1 ] [ f_money ] += params [ 1 ] ;

	new query_string [ 136 ];
	format ( query_string, 136, "UPDATE `fractions` SET `f_money` = '%d' WHERE `f_id` = '%d' LIMIT 1",
	f_info [ params [ 0 ] - 1 ] [ f_money ], params [ 0 ] ) ;
	mysql_tquery ( sql_connection, query_string, "", "" ) ;

	format ( query_string, sizeof ( query_string  ), "{"#cBAdmin"}[A]{"#cGRAdmin"} %s[%i] пополнил средствами органиацию %s", p_info [ playerid ] [ name ], playerid, f_info [ params [ 0 ] - 1 ] [ f_name ] ) ;
	foreach(new i: admin_players) SendClientMessage ( i, col_admin, query_string ) ;

	if ( params [ 0 ] >= 18 && params [ 0 ] <= 25 )update_gdorm_text ( params [ 0 ] ) ;

	format(query_string, 128, "%s пополнил средствами органиацию %s (+%d"valute_title_")", p_info [ playerid ] [ name ], f_info [ params [ 0 ] - 1 ] [ f_name ], params [ 1 ] ) ;
	WriteLog(playerid, TYPE_LOG_ADMIN, query_string);
	return 1 ;
}

alias:rlock("rlk")
CMD:rlock ( playerid )
{
	new veh_id = INVALID_VEHICLE_ID ;
	if ( player_rentcar [ playerid ] != INVALID_VEHICLE_ID ) veh_id = player_rentcar [ playerid ] ;
	else
	{
	    if ( player_vehicle [ playerid ] != INVALID_VEHICLE_ID && veh_info [ player_vehicle [ playerid ] - 1 ] [ v_type ] == vehicle_type_server )
			veh_id = player_vehicle [ playerid ] ;
	}

	if ( veh_id == INVALID_VEHICLE_ID ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не арендуете транспорт." ) ;

	if ( veh_id == GetPlayerVehicleID ( playerid ) )
	{
		PlayerPlaySound ( playerid, 1145, 0.0, 0.0, 0.0 ) ;
		toggle_locked ( playerid, veh_id ) ;
		return 1 ;
	}

	if ( IsPlayerInRangeOfPoint ( playerid, 5.0, veh_info [ veh_id - 1 ] [ v_now_pos ] [ 0 ], veh_info [ veh_id - 1 ] [ v_now_pos ] [ 1 ], veh_info [ veh_id - 1 ] [ v_now_pos ] [ 2 ] ) ) // 2.5
	{
		PlayerPlaySound ( playerid, 1145, 0.0, 0.0, 0.0 ) ;
		toggle_locked ( playerid, veh_id ) ;
		return 1 ;
	}
	return 1 ;
}

stock show_for_timeskin ( playerid, _skin_id )
{
    time_for_skin { playerid } = 10 ;
	SetPlayerSkin ( playerid, _skin_id ) ;
	return 1 ;
}

callback: callback_buy_admin ( playerid )
{
    new rows, fields ;
	cache_get_data ( rows, fields ) ;

	if ( rows )
	{
	    global_string [ 0 ] = EOS ;
	    new query_string [ 60 + MAX_PLAYER_NAME ], _account_name [ MAX_PLAYER_NAME ], u_a_id ;
	    format ( query_string, sizeof query_string, "%s приобрел(а) права администратора.", p_info [ playerid ] [ name ] ) ;

	    for ( new i = 0 ; i < rows ; i ++ )
	    {
	        u_a_id = cache_get_field_content_int ( i, "u_a_id", sql_connection ) ;
	        cache_get_field_content ( i, "u_a_name", _account_name, sql_connection, MAX_PLAYER_NAME ) ;

			insert_debtor_message ( "Новый админ", query_string, u_a_id ) ;
	    }

	    for ( new i = 0 ; i < rows ; i ++ )
	    {
	        u_a_id = cache_get_field_content_int ( i, "u_a_id", sql_connection ) ;
	        cache_get_field_content ( i, "u_a_name", _account_name, sql_connection, MAX_PLAYER_NAME ) ;

	        if ( ! i ) format ( global_string, sizeof global_string, "{"#cBInfo"}* {"#cWH"}%s", _account_name ) ;
	        else format ( global_string, sizeof global_string, "%s, %s", global_string, _account_name ) ;
	    }

	    SendClientMessage ( playerid, col_white, "{"#cBInfo"}* {"#cWH"}Дабы Вас не сняли и Вы действовали согласно регламенту, Вам нужно обратиться к одному из: " ) ;
        SendClientMessage ( playerid, col_white, global_string ) ;
	}
	return 1 ;
}

