            new scm_string [ 100 ] ;
            format ( scm_string, sizeof scm_string, "{"#cGInfo"}* {"#cWH"}Вы взяли '{"#cGN"}%s{"#cWH"}'. Отнесите и положите его в фургон.", item_name ( _box_id [ listitem ] ) ) ;
            SendClientMessage ( playerid, col_white, scm_string ) ;

