CMD:sf ( playerid, params [ ] )
{
	if ( ! gov_player ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команда доступна только для сотрудников правительства." ) ;
	if ( p_info [ playerid ] [ rank ] != f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 6 ] &&
		p_info [ playerid ] [ rank ] != f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 7 ] &&
		p_info [ playerid ] [ rank ] != f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 8 ] &&
		p_info [ playerid ] [ rank ] != f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 12 ] )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команда доступна только для министров." ) ;
	if ( player_ssf { playerid } == 255 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не выбрали чат." ) ;
	if ( p_info [ playerid ] [ mute ] )
	{
		new scm_string [ 38 ] ;
		format ( scm_string, sizeof ( scm_string ),"У вас бан чата | %d секунд(ы)", p_info [ playerid ] [ mute ] ) ;
		SendClientMessage ( playerid, col_light_red, scm_string ) ;
		return true ;
	}

	if ( sscanf ( params, "s[100]", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /sf [текст]" ) ;
 	if ( check_advertise ( playerid, params [ 0 ], report_type_sf ) ) return 1 ;
	new scm_string [ 144 ] ;

	format ( scm_string, sizeof scm_string, "[R] %s %s[%d]: %s", f_rank [ p_info [ playerid ] [ member ] - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], playerid, params [ 0 ] ) ;
	fraction_message ( player_ssf { playerid }, col_lblue, scm_string ) ;

	SendClientMessage ( playerid, col_lblue, scm_string ) ;

	format(scm_string, sizeof scm_string, "сказал(а) в рацию: {FFFFFF}%s", params [ 0 ]);
	SetPlayerChatBubble(playerid, scm_string, col_light_purple, 15.0, 10000);
	return 1;
}

CMD:rank ( playerid, params [ ] )
{
	if ( p_info [ playerid ] [ member ] == 0 ) return 1 ;

	new fraction_id = p_info [ playerid ] [ member ] ;
	if ( p_info [ playerid ] [ rank ] <  f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 3 ] )
	{
	    static const _str [ ] = "{"#cRInfo"}* {"#cGRInfo"}Команда доступна с ранга %s (%d)." ;
	    new scm_string [ sizeof _str + 30 + 3 ] ;
	    format ( scm_string, sizeof scm_string, _str, f_rank [ fraction_id - 1 ] [ f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 3 ] - 1 ], f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 3 ] ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
		return 1 ;
	}
	if ( p_info [ playerid ] [ rank ] < 11 && fbi_player ( playerid ) ) return 1 ;
	if ( sscanf ( params, "u", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /rank [ид/имя]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете изменить ранг самому себе." ) ;

	if ( p_info [ params [ 0 ] ] [ member ] != fraction_id ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не состоит в Вашей организации." ) ;
	if ( p_info [ params [ 0 ] ] [ rank ] >= p_info [ playerid ] [ rank ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нельзя изменить ранг своему руководству." ) ;
    if ( cop_player ( params [ 0 ] ) || fbi_player ( params [ 0 ] ) || prison_player ( params [ 0 ] ) )
	{
		if ( p_info [ params [ 0 ] ] [ org_date ] < 3 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не отыграл 3 часа в организации." ) ;
	}

	global_string [ 0 ] = EOS ;
	new line_string [ 72 ] ;
	for ( new i = 0; i < f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 0 ] ; i ++ )
	{
		format ( line_string, 72, "{"#cBL"}%i. {"#cWH"}%s\n", i + 1, f_rank [ fraction_id - 1 ] [ i ] ) ;
		strcat ( global_string, line_string ) ;
	}
	show_dialog ( playerid, d_rank, DIALOG_STYLE_LIST, "{"#cBHD"}Смена ранга", global_string, "Выбрать", "Закрыть" ) ;
	SetPVarInt ( playerid, "pl_setrank_id", params [ 0 ] ) ;
	return 1 ;
}

stock entered_hospital_bed ( playerid, i )
{
	if ( GetPlayerVirtualWorld ( playerid ) < 1 || GetPlayerVirtualWorld ( playerid ) > 3 ) return 1 ;

    new Float: player_hp ;
	GetPlayerHealth ( playerid, player_hp ) ;
	if ( player_hp > 95 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не нуждаетесь в лечении." ) ;

	if ( player_use_bed { playerid } > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы уже заняли койку." ) ;
	if ( h_bed_toggled [ i ] [ GetPlayerVirtualWorld ( playerid ) - 1 ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Койка уже занята другим человеком." ) ;

	SetPlayerPos ( playerid, h_bed_position [ i ] [ 0 ], h_bed_position [ i ] [ 1 ], h_bed_position [ i ] [ 2 ] ) ;
	SetPlayerFacingAngle ( playerid, h_bed_position [ i ] [ 3 ] ) ;

	player_use_bed_world { playerid } = GetPlayerVirtualWorld ( playerid ) ;
	player_use_bed { playerid } = i + 1 ;

	h_bed_toggled [ i ] [ player_use_bed_world { playerid } - 1 ] = true ;
	ApplyAnimation ( playerid, "CRACK", "crckidle2", 10000.0, 0, 9999, 9999, 9999, 9999 ) ;
	PlayerPlaySound ( playerid, 1058, 0.0, 0.0, 0.0 ) ;
	p_t_info [ playerid ] [ p_animation ] = true ;
	SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы заняли койку, постельный режим поможет Вам быстрее поправиться." ) ;
	return 1 ;
}

stock entered_table_dice ( playerid )
{
	if ( IsPlayerNearDice ( playerid ) == -1 ) return 1 ;

    new null = -1, biz_id = GetPVarInt ( playerid, "p_biz_id" ), stol_id = IsPlayerNearDice ( playerid ) ;
    if ( biz_id < 1 ) return bad_exit ( playerid ) ;
	for ( new i = 0 ; i != 5 ; i ++ ) if ( dice_info [ biz_id ] [ stol_id ] [ b_player ] [ i ] == INVALID_PLAYER_ID ) { null = i; break ; }
	if ( player_croupier [ playerid ] && dice_info [ biz_id ] [ stol_id ] [ b_crupie ] != INVALID_PLAYER_ID ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Тут уже работает крупье." ) ;
	if ( player_dice_table { playerid } ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы уже зарегистрированы на другом столе." ) ;
	if ( null == -1 && ! player_croupier [ playerid ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}За этим столом нет свободных мест." ) ;
	if ( ! player_croupier [ playerid ] ) dice_info [ biz_id ] [ stol_id ] [ b_player ] [ null ] = playerid ;
	else dice_info [ biz_id ] [ stol_id ] [ b_crupie ] = playerid ;
	player_dice_table { playerid } = stol_id + 1 ;
	toggle_controlable ( playerid, false ) ;
	SelectTextDraw ( playerid, 0x33AAFFFF ) ;
	dice_ptd_status ( playerid, true ) ;
	return update_bone ( stol_id, biz_id ), update_bone_table ( biz_id, stol_id ) ;
}

CMD:heal ( playerid, params [ ] )
{
	if ( ! medic_player ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команда доступна только для сотрудников больницы." ) ;
	if ( sscanf ( params, "ud", params [ 0 ], params [ 1 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /heal [ид/имя] [цена]" ) ;
	if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете лечить самого себя, обратитесь к другому врачу." ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
    if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;
	if ( params [ 1 ] < 1 || params [ 1 ] > WorkSalary [ 1 ] )
	{
	    new strin [ 85 + 9 ] ;
	    format ( strin, sizeof strin, "{"#cRInfo"}* {"#cGRInfo"}Стоимость лечения не может быть меньше 1"valute_title_" или больше %d"valute_title_"", WorkSalary [ 1 ] ) ;
		SendClientMessage ( playerid, col_gray, strin ) ;
		return 1 ;
	}
	if ( ! bad_dialog ( params [ 0 ] ) || ! bad_dialog ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока уже открыт диалог." ) ;

	show_dialog ( playerid, d_heal_select, DIALOG_STYLE_LIST, "{"#cBHD"}Медицинское обслуживание", "{"#cBL"}1. {"#cWH"}Вылечить\n{"#cBL"}2. {"#cWH"}Вылечить от зависимости\n{"#cBL"}3. {"#cWH"}Поставить диагноз", "Принять", "Закрыть" ) ;

	heal_price [ params [ 0 ] ] = params [ 1 ] ;
	heal_id [ params [ 0 ] ] = playerid ;

	heal_price [ playerid ] = params [ 1 ] ;
	heal_id [ playerid ] = params [ 0 ] ;
	return 1 ;
}

CMD:givemc ( playerid, params [ ] )
{
	if ( ! medic_player ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команда доступна только для сотрудников больницы." ) ;
	if ( sscanf ( params, "u", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /givemc [ид/имя]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
    if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;

	show_dialog ( playerid, d_give_mc, DIALOG_STYLE_LIST, "{"#cBHD"}Выдача мед.карты",
	"{"#cLY"}Выберите результат осмотра:\n\
	{ffffff}Серьезно болен/больна\n\
	Наблюдаются отклонения\n\
	Полностью здоров(а)",
	"Выбрать", "Закрыть" ) ;
	SetPVarInt ( playerid, "mc_playerid", params [ 0 ] ) ;
	return 1 ;
}

CMD:med ( playerid, params [ ] )
{
	if ( sscanf ( params, "u", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /med [ид/имя]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
    if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;
	if ( ! bad_dialog ( params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Недоступно в данный момент." ) ;
	if ( ! GetInventoryFindItem ( playerid, SUB_INVENTORY, 2221 ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет мед. карты." ) ;
	if ( cooldown_sentence [ playerid ] > gettime ( ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Предложение о сделке можно отправлять один раз в {"#cRD"}45 секунд{"#cGRInfo"}." ) ;

	cooldown_sentence [ playerid ] = gettime ( ) + time_sell_sentence ;
	mc_callback ( playerid, params [ 0 ] ) ;
	return 1 ;
}

stock mc_callback ( playerid, to_id )
{
	static const mc_status [ ] [ ] = {
		"Серьезно болен/больна",
		"Наблюдаются отклонения",
		"Полностью здоров(а)" } ;

	if ( to_id == playerid ) me_action ( playerid, "посмотрел(-а) свою мед. карту" ) ;
	else
	{
	    new me_string [ 28 + MAX_PLAYER_NAME ] ;
		format ( me_string, sizeof me_string, "показал(-а) мед. карту %s", p_info [ to_id ] [ name ] ) ;
		me_action ( playerid, me_string ) ;
	}

	new dialog_string [ 280 ] ;

	new disease_string [ 84 + 6 ] ;
	if ( ! p_info [ playerid ] [ p_disease ] [ 0 ] )
	{
		format ( disease_string, sizeof disease_string, "Нет" ) ;
		if ( p_info [ playerid ] [ p_vitaminsTime ] != 0 ) format ( disease_string, sizeof disease_string, "Действуют витамины. Иммунитет усилен" ) ;
	}
   	else
	{
		if ( p_info [ playerid ] [ p_diagnosis ] == 1 ) format ( disease_string, sizeof disease_string, "Диагноз: %s (%d стадия)\nВлияние: -%d здоровья/5 мин.", viruses_name [ p_info [ playerid ] [ p_disease ] [ 0 ] - 1 ], p_info [ playerid ] [ p_disease ] [ 1 ], viruses_stage_health [ p_info [ playerid ] [ p_disease ] [ 1 ] - 1 ] ) ;
		else if ( p_info [ playerid ] [ p_diagnosis ] == 2 ) format ( disease_string, sizeof disease_string, "Диагноз: %s (%d стадия)\nВлияние: -%d здоровья/5 мин.", viruses_name [ p_info [ playerid ] [ p_wrong_virus ] [ 0 ] - 1 ], p_info [ playerid ] [ p_disease ] [ 1 ], viruses_stage_health [ p_info [ playerid ] [ p_disease ] [ 1 ] - 1 ] ) ;
		else format ( disease_string, sizeof disease_string, "Диагноз: неизвестно\nВлияние: -%d здоровья/5 мин.\nПройдите обследование у врача!", viruses_stage_health [ p_info [ playerid ] [ p_disease ] [ 1 ] - 1 ] ) ;
		if ( p_info [ playerid ] [ p_diagnosis ] != 0 )
		{
			if ( p_info [ playerid ] [ p_healingTime ] > 0 ) format ( disease_string, sizeof disease_string, "Необходимо лечение: %d раз(а) через %d мин.", p_info [ playerid ] [ p_disease ] [ 1 ] + 2 - p_info [ playerid ] [ p_healing ], p_info [ playerid ] [ p_healingTime ] ) ;
			else if ( p_info [ playerid ] [ p_healingTime ] > 0 ) format ( disease_string, sizeof disease_string, "Необходимо лечение: %d раз(а)", p_info [ playerid ] [ p_disease ] [ 1 ] + 2 - p_info [ playerid ] [ p_healing ] ) ;
		}
	}

	new cmd_mc_result = 1, s_year, s_month, s_day, s_hour, s_minute, s_second, _slot = GetInventoryFindItem ( playerid, SUB_INVENTORY, 2221 ) ;
	if ( p_info [ playerid ] [ p_diagnosis ] == 1 ) cmd_mc_result = 0 ;
	else if ( p_info [ playerid ] [ p_diagnosis ] == 2 ) cmd_mc_result = 0 ;
	else if ( p_info [ playerid ] [ p_diagnosis ] != 0 ) cmd_mc_result = 1 ;
	else cmd_mc_result = 2 ;

	timestamp_to_date ( GetUsersInventory ( playerid, INV_ITEM_GIVE_DATE, _slot ) + CONVERT_TIME_TO_MOSCOW, s_year, s_month, s_day, s_hour, s_minute, s_second ) ;

	format ( dialog_string, sizeof ( dialog_string ), "{"#cWH"}Владелец: %s\nДата выдачи: %02d.%02d.%d\n\n{"#cBL"}** Заболевания **\n{"#cWH"}%s\n\n{"#cLY"}%s",
	p_info [ playerid ] [ name ], s_day, s_month, s_year, disease_string, mc_status [ cmd_mc_result ] ) ;

	show_dialog ( to_id, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Медицинская карта", dialog_string, "Закрыть", "" ) ;
	return 1 ;
}

CMD:orglist ( playerid )
{
	if ( admin_info [ playerid ] [ admin ] < 3 )return 1 ;
	global_string [ 0 ] = EOS ;
	for ( new j = 0; j < fraction_count ; j ++ )
	{
		new line_string [ 64 ] ;
		format ( line_string, 64, "{ffffff}ID:%d - {%s}%s\n", j + 1, f_info [ j ] [ f_chat_color ], f_info [ j ] [ f_name ] ) ;
		strcat ( global_string, line_string ) ;
	}
	show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Список организаций", global_string, "Закрыть", "" ) ;

	return 1 ;
}

CMD:en ( playerid )
{
	new vehicleid = GetPlayerVehicleID ( playerid ) ;
	if ( GetPlayerState ( playerid ) != PLAYER_STATE_DRIVER ) return 1 ;
	if ( v_velo ( vehicleid ) ) return 1 ;
	toggle_engine ( playerid, vehicleid ) ;
	return 1 ;
}

CMD:light ( playerid )
{
	new vehicleid = GetPlayerVehicleID ( playerid ) ;
	if ( GetPlayerState ( playerid ) != PLAYER_STATE_DRIVER ) return 1 ;
	if ( v_velo ( vehicleid ) || v_plane ( vehicleid ) || v_boat ( vehicleid ) ) return 1 ;
	toggle_lights ( playerid, vehicleid ) ;
	return 1 ;
}

alias:lock("lk")
CMD:lock ( playerid )
{
	if ( IsValidVehicle ( GetPlayerVehicleID ( playerid ) ) )
	{
		new veh_id = GetPlayerVehicleID ( playerid ) ;
		if ( ( veh_info [ veh_id - 1 ] [ v_type ] != vehicle_type_player || veh_info [ veh_id - 1 ] [ v_owner ] != p_info [ playerid ] [ id ] ) && p_t_info [ playerid ] [ v_key ] != veh_id )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас нет ключей от данного транспорта." ) ;
		PlayerPlaySound ( playerid, 1145, 0.0, 0.0, 0.0 ) ;

		toggle_locked ( playerid, veh_id ) ;
		return 1 ;
	}
	else
	{
		if ( p_t_info [ playerid ] [ v_key ] != 0 )
		{
			new veh_id = p_t_info [ playerid ] [ v_key ],
				Float: _x_v, Float: _x_y, Float: _x_z ;
			GetVehiclePos ( veh_id, _x_v, _x_y, _x_z ) ;

			if ( IsPlayerInRangeOfPoint ( playerid, 5.0, _x_v, _x_y, _x_z ) )
			{
				PlayerPlaySound ( playerid, 1145, 0.0, 0.0, 0.0 ) ;

				toggle_locked ( playerid, veh_id ) ;
				return 1 ;
			}
		}

		foreach(new veh_id: player_vehicles[playerid])
		{
		    //new Float: _x_v, Float: _x_y, Float: _x_z ;
			//GetVehiclePos ( veh_id, _x_v, _x_y, _x_z ) ;

			if ( v_boat ( veh_id ) )
			{
				if ( ! IsVehicleInRangeOfPoint ( veh_id, 5.0, p_t_info [ playerid ] [ p_pos ] [ 0 ], p_t_info [ playerid ] [ p_pos ] [ 1 ], p_t_info [ playerid ] [ p_pos ] [ 2 ] ) ) continue ;
				//if ( ! IsPlayerInRangeOfPoint ( playerid, 5.0, _x_v, _x_y, _x_z ) ) continue ;
				PlayerPlaySound ( playerid, 1145, 0.0, 0.0, 0.0 ) ;

				toggle_locked ( playerid, veh_id ) ;
				return 1 ;
			}
			else
			{
				if ( ! IsVehicleInRangeOfPoint ( veh_id, 5.0, p_t_info [ playerid ] [ p_pos ] [ 0 ], p_t_info [ playerid ] [ p_pos ] [ 1 ], p_t_info [ playerid ] [ p_pos ] [ 2 ] ) ) continue ;
				//if ( ! IsPlayerInRangeOfPoint ( playerid, 5.0, _x_v, _x_y, _x_z ) ) continue ; // 2.5
				PlayerPlaySound ( playerid, 1145, 0.0, 0.0, 0.0 ) ;

				toggle_locked ( playerid, veh_id ) ;
				return 1 ;
			}
		}

		if ( p_info [ playerid ] [ family ] )
		{
		    foreach(new veh_id: family_vehicles[p_info [ playerid ] [ family ]])
			{
			   	//new Float: _x_v, Float: _x_y, Float: _x_z ;
				//GetVehiclePos ( veh_id, _x_v, _x_y, _x_z ) ;

				if ( v_boat ( veh_id ) )
				{
					if ( ! IsVehicleInRangeOfPoint ( veh_id, 5.0, p_t_info [ playerid ] [ p_pos ] [ 0 ], p_t_info [ playerid ] [ p_pos ] [ 1 ], p_t_info [ playerid ] [ p_pos ] [ 2 ] ) ) continue ;
					//if ( ! IsPlayerInRangeOfPoint ( playerid, 5.0, _x_v, _x_y, _x_z ) ) continue ;
					PlayerPlaySound ( playerid, 1145, 0.0, 0.0, 0.0 ) ;

					toggle_locked ( playerid, veh_id ) ;
					return 1 ;
				}
				else
				{
					if ( ! IsVehicleInRangeOfPoint ( veh_id, 5.0, p_t_info [ playerid ] [ p_pos ] [ 0 ], p_t_info [ playerid ] [ p_pos ] [ 1 ], p_t_info [ playerid ] [ p_pos ] [ 2 ] ) ) continue ;
					//if ( ! IsPlayerInRangeOfPoint ( playerid, 5.0, _x_v, _x_y, _x_z ) ) continue ; // 2.5
					PlayerPlaySound ( playerid, 1145, 0.0, 0.0, 0.0 ) ;

					toggle_locked ( playerid, veh_id ) ;
					return 1 ;
				}
			}
		}
	}
	return 1 ;
}

CMD:vlock ( playerid )
{
	if ( admin_info [ playerid ] [ admin ] < 4 )return 1 ;
	if ( IsValidVehicle ( GetPlayerVehicleID ( playerid ) ) )
	{
		new veh_id = GetPlayerVehicleID ( playerid ) ;

		PlayerPlaySound ( playerid, 1145, 0.0, 0.0, 0.0 ) ;
		toggle_locked ( playerid, veh_id ) ;
	}
	else
	{
		foreach ( new veh_id:streamed_vehicles[playerid])
		{
			if ( IsVehicleInRangeOfPoint ( veh_id, 5.0, p_t_info [ playerid ] [ p_pos ] [ 0 ], p_t_info [ playerid ] [ p_pos ] [ 1 ], p_t_info [ playerid ] [ p_pos ] [ 2 ] ) ){}
			else continue ;
			PlayerPlaySound ( playerid, 1145, 0.0, 0.0, 0.0 ) ;
			toggle_locked ( playerid, veh_id ) ;
			break ;
		}
	}
	return 1 ;
}

CMD:time ( playerid )
{
	if ( GetPlayerState ( playerid ) == PLAYER_STATE_ONFOOT ) ApplyAnimation ( playerid, "COP_AMBIENT", "Coplook_watch", 4.1, 0, 0, 0, 0, 0 ) ;

	global_string [ 0 ] = EOS ;
	new year,
		month,
		day,
		hour,
		minute,
		second,
		mtext [ 11 ] ;

	getdate ( year, month, day ) ;
	gettime ( hour, minute, second ) ;
	FixHour ( hour ) ;
	hour = global_hour ;

	switch ( month )
	{
		case 1: mtext = "Января";
		case 2: mtext = "Февраля";
		case 3: mtext = "Марта";
		case 4: mtext = "Апреля";
		case 5: mtext = "Мая";
		case 6: mtext = "Июня";
		case 7: mtext = "Июля";
		case 8: mtext = "Августа";
		case 9: mtext = "Сентября";
		case 10: mtext = "Октября";
		case 11: mtext = "Ноября";
		case 12: mtext = "Декабря";
	}

	format ( global_string, 512, "\
	{"#cBL"}Вы позвонили в службу точного времени!\n\n\
	{"#cBL"}*{"#cWH"} Сегодняшняя дата:\t\t{"#cGRDialog"}%d %s 2026 г\n\
	{"#cBL"}*{"#cWH"} Текущее время:\t\t{"#cGRDialog"}%s%d:%s%d\n\n\
	{"#cBL"}*{"#cWH"} Время в игре за час:\t\t{"#cGRDialog"}%d мин\n\
	{"#cBL"}*{"#cWH"} Время в игре за сегодня:\t{"#cGRDialog"}%s\n\
	{"#cBL"}*{"#cWH"} Время в игре за вчера:\t{"#cGRDialog"}%s\n\
	{"#cBL"}*{"#cWH"} AFK за сегодня:\t\t{"#cGRDialog"}%s\n\
	{"#cBL"}*{"#cWH"} AFK за вчера:\t\t\t{"#cGRDialog"}%s\n",
	day,mtext,(hour < 10) ? ("0") : (""), hour, (minute < 10) ? ("0") : (""), minute,
	floatround ( ( p_info [ playerid ] [ time_hour ] ) / 60 ),
	convert_time ( p_info [ playerid ] [ online_player ] [ 0 ], TYPE_TIME_HOUR ),
	convert_time ( p_info [ playerid ] [ online_player ] [ 1 ], TYPE_TIME_HOUR ),
	convert_time ( p_info [ playerid ] [ online_player_afk ] [ 0 ], TYPE_TIME_HOUR ),
	convert_time ( p_info [ playerid ] [ online_player_afk ] [ 1 ], TYPE_TIME_HOUR ) ) ;

	new line_string [ 78 + 9 ] ;
	if ( p_info [ playerid ] [ jailed ] > 0 )
	{
	    format ( line_string, sizeof line_string, "\n{"#cBL"}*{"#cWH"} Время заключения:\t\t{"#cGRDialog"}%d секунд(ы)", p_info [ playerid ] [ jailed ] ) ;
		strcat ( global_string, line_string ) ;
	}

	if ( p_info [ playerid ] [ mute ] > 0 )
	{
	    format ( line_string, sizeof line_string, "\n{"#cBL"}*{"#cWH"} Блокировка чата:\t\t{"#cGRDialog"}%d секунд(ы)", p_info [ playerid ] [ mute ] ) ;
		strcat ( global_string, line_string ) ;
	}

	format ( line_string, sizeof line_string, "\n\nВы играете на сервере %d", server_number ) ;
	strcat ( global_string, line_string ) ;

	show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Точное время", global_string, "Закрыть", "" ) ;
	me_action ( playerid, "позвонил(а) в службу точного времени" ) ;
	return 1 ;
}

CMD:bstop ( playerid )
{
    new _b_id = GetPVarInt ( playerid, "p_biz_id" ) - 1 ;
	if ( _b_id == -1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нужно находиться в бизнесе." ) ;
	if ( ! b_info [ _b_id ] [ b_radio_status ] )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}В данном бизнесе нет аудио-системы." ) ;

	if ( b_info [ _b_id ] [ b_radio_status ] == 1 )
	{
		switch ( b_info [ _b_id ] [ b_sound ] )
 	 	{
  			case 1062: PlayerPlaySound ( playerid, 1063, 0, 0, 0 ) ;
	   		case 1068: PlayerPlaySound ( playerid, 1069, 0, 0, 0 ) ;
			case 1076: PlayerPlaySound ( playerid, 1077, 0, 0, 0 ) ;
			case 1097: PlayerPlaySound ( playerid, 1098, 0, 0, 0 ) ;
			case 1183: PlayerPlaySound ( playerid, 1184, 0, 0, 0 ) ;
			case 1185: PlayerPlaySound ( playerid, 1186, 0, 0, 0 ) ;
			case 1187: PlayerPlaySound ( playerid, 1188, 0, 0, 0 ) ;
		}
	}
	else if ( b_info [ _b_id ] [ b_radio_status ] == 2 )
	{
 		StopAudioStreamForPlayer ( playerid ) ;
	}
	return 1 ;
}

CMD:bheal ( playerid )
{
	new _b_id = GetPVarInt ( playerid, "p_biz_id" ) - 1 ;
	if ( _b_id == -1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нужно находиться в бизнесе." ) ;
	if ( ! b_info [ _b_id ] [ b_improve ] [ 1 ] )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}В данном бизнесе нет медицинского обслуживания." ) ;
	if ( p_info [ playerid ] [ money ] < 250 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас недостаточно средств для использования медицинского обслуживания." ) ;

	new Float: player_hp ;
	GetPlayerHealth ( playerid, player_hp ) ;
	if ( player_hp > 95 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не нуждаетесь в лечении." ) ;

	give_money ( playerid, -250 ) ;
	insert_money_log ( playerid, INVALID_PLAYER_ID, -250, "аптечка бизнеса" ) ;

	give_bmoney ( _b_id + 1, 250, 0 ) ;

	new Float: pl_health ;
	GetPlayerHealth ( playerid, pl_health ) ;
	if ( pl_health + 65 > 160 ) set_health ( playerid, 160 ) ;
	else set_health ( playerid, pl_health + 65 ) ;

	GameTextForPlayer ( playerid, "~g~+65HP", 2000, 1 ) ;

	me_action ( playerid, "использовал(-а) аптечку" ) ;
	if ( GetPlayerState ( playerid ) == PLAYER_STATE_ONFOOT && target_cuff [ playerid ] == INVALID_PLAYER_ID && target_tie [ playerid ] == INVALID_PLAYER_ID ) ApplyAnimation(playerid, "ped", "gum_eat", 4.0, 0, 0, 0, 0, 0, 1);
	return 1 ;
}

CMD:hheal ( playerid )
{
	new h = GetPVarInt ( playerid, "house_id" ) - 1 ;
	if ( h == -1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нужно находиться в доме." ) ;
	if ( ! h_info [ h ] [ h_heal ] )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}В данном доме нет аптечек." ) ;
	if ( p_info [ playerid ] [ money ] < 250 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас недостаточно средств для использования аптечки в этом доме." ) ;

    new Float: player_hp ;
	GetPlayerHealth ( playerid, player_hp ) ;
	if ( player_hp > 95 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не нуждаетесь в лечении." ) ;

	give_money ( playerid, -250 ) ;
	insert_money_log ( playerid, INVALID_PLAYER_ID, -250, "аптечка дома" ) ;

	h_info [ h ] [ h_heal ] -= 1 ;
	h_info [ h ] [ h_safe_data ] [ 1 ] += 250 ;

	new Float: pl_health ;
	GetPlayerHealth ( playerid, pl_health ) ;
	if ( pl_health + 65 > 160 ) set_health ( playerid, 160 ) ;
	else set_health ( playerid, pl_health + 65 ) ;

	GameTextForPlayer ( playerid, "~g~+65HP", 2000, 1 ) ;

	me_action ( playerid, "использовал(-а) аптечку" ) ;
	if ( GetPlayerState ( playerid ) == PLAYER_STATE_ONFOOT && target_cuff [ playerid ] == INVALID_PLAYER_ID && target_tie [ playerid ] == INVALID_PLAYER_ID ) ApplyAnimation(playerid, "ped", "gum_eat", 4.0, 0, 0, 0, 0, 0, 1);
	return 1 ;
}

CMD:service ( playerid )
{
	if ( target_cuff [ playerid ] != INVALID_PLAYER_ID )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы в наручниках." ) ;
	if ( target_tie [ playerid ] != INVALID_PLAYER_ID )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы связаны." ) ;
	if ( ! p_info [ playerid ] [ number ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас нет телефона." ) ;
	if ( ! g_phone_call [ playerid ] [ PC_ENABLED ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас отключен мобильный телефон." ) ;
	if ( g_phone_call [ playerid ] [ PC_STATUS ] || is_ether_calling { playerid } != 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Закончите текущий разговор." ) ;
	show_service ( playerid ) ;
	return 1 ;
}

stock show_service ( playerid )
{
    show_dialog ( playerid, d_service, DIALOG_STYLE_LIST, "{"#cBHD"}Сервисы", "{"#cBL"}1.{"#cWH"} Полиция\n{"#cBL"}2.{"#cWH"} Скорая помощь\n{"#cBL"}3.{"#cWH"} Механик\n{"#cBL"}4.{"#cWH"} Доставка продуктов в дом", "Выбрать", "Назад" ) ;
	return 1 ;
}

CMD:fspawnchange ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 8 ) return 1 ;
	if ( ! IsFounder ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}К сожалению, Вам данная функция не доступна." ) ;
	if ( sscanf ( params, "d", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /fspawnchange [организация]" ) ;
	if ( params [ 0 ] < 0 || params [ 0 ] > fraction_count ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Неверный ID организации." ) ;
	params [ 0 ] -- ;
	GetPlayerPos ( playerid, f_info [ params [ 0 ]  ] [ f_spawn ] [ 0 ], f_info [ params [ 0 ]  ] [ f_spawn ] [ 1 ], f_info [ params [ 0 ]  ] [ f_spawn ] [ 2 ] ) ;
	GetPlayerFacingAngle ( playerid, f_info [ params [ 0 ]  ] [ f_spawn ] [ 3 ] ) ;

	f_info [ params [ 0 ]  ] [ f_spawn_int ] = GetPlayerInterior ( playerid ) ;
	f_info [ params [ 0 ]  ] [ f_spawn_virt ] =  GetPlayerVirtualWorld ( playerid ) ;

	new sql_string [ 82 + 9 * 4 ] ;
	format ( sql_string, sizeof ( sql_string ), "Вы успешно изменили место спавна организации \"%s\".",
	f_info [ params [ 0 ]  ] [ f_name ] ) ;
	SendClientMessage ( playerid, col_succes, sql_string ) ;

	mysql_format ( sql_connection, sql_string, sizeof ( sql_string ), "UPDATE `fractions` SET `f_spawn` = '%f|%f|%f|%f|%d|%d' WHERE `f_id` = '%d' LIMIT 1",
	f_info [ params [ 0 ]  ] [ f_spawn ] [ 0 ], f_info [ params [ 0 ]  ] [ f_spawn ] [ 1 ], f_info [ params [ 0 ]  ] [ f_spawn ] [ 2 ],
	f_info [ params [ 0 ]  ] [ f_spawn ] [ 3 ],
	f_info [ params [ 0 ]  ] [ f_spawn_int ],
	f_info [ params [ 0 ]  ] [ f_spawn_virt ],
	params [ 0 ] + 1 ) ;
	mysql_tquery ( sql_connection, sql_string, "", "" ) ;
	return 1 ;
}

CMD:togphone ( playerid )
{
	if ( target_cuff [ playerid ] != INVALID_PLAYER_ID )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы в наручниках." ) ;
	if ( target_tie [ playerid ] != INVALID_PLAYER_ID )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы связаны." ) ;
	if ( ! p_info [ playerid ] [ number ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас нет телефона." ) ;
	if ( ! g_phone_call [ playerid ] [ PC_ENABLED ] )
	{
		g_phone_call [ playerid ] [ PC_ENABLED ] = true ;
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы включили мобильный телефон." ) ;
	}
	else
	{
		g_phone_call [ playerid ] [ PC_ENABLED ] = false ;
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы отключили мобильный телефон." ) ;

	}
	return 1 ;
}

CMD:ears ( playerid )
{
	if ( admin_info [ playerid ] [ admin ] < 2 )return 1 ;
	if ( big_ears { playerid } == 0 )
	{
		big_ears { playerid } = 1 ;
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы включили режим отслеживания SMS." ) ;
	}
	else
	{
		big_ears { playerid } = 0 ;
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы отключили режим отслеживания SMS." ) ;
	}
	return 1 ;
}

CMD:exit ( playerid )
{
	if ( GetPVarInt ( playerid, "p_hotel_id" ) > 0 )
	{
	    new t = GetPVarInt ( playerid, "p_hotel_id" ) - 1 ;
	    if ( t < 0 ) return 1 ;

	    if ( GetPlayerVirtualWorld ( playerid ) != hotel_info [ t ] [ h_biz ] + hotel_info [ t ] [ h_id ] ) return 1 ;

        new _form_elevator = hotel_info [ t ] [ h_biz ] + 1000 + hotel_info [ t ] [ h_biz ] + ( hotel_info [ t ] [ h_vw ] - ( hotel_info [ t ] [ h_biz ] + 1 ) ) ;
	    set_pos ( playerid, hotel_info [ t ] [ h_pos ] [ 0 ], hotel_info [ t ] [ h_pos ] [ 1 ], hotel_info [ t ] [ h_pos ] [ 2 ], hotel_info [ t ] [ h_pos ] [ 3 ] + 0.5, 3, _form_elevator ) ;
		DeletePVar ( playerid, "p_hotel_id" ) ;
	    return 1 ;
	}
	if ( GetPVarInt ( playerid, "house_id" ) > 0 && GetPlayerVirtualWorld ( playerid ) == GetPVarInt ( playerid, "house_id" ) )
	{
	    new h = GetPVarInt ( playerid, "house_id" ) - 1 ;
     	if ( h < 0 ) return 1 ;

		if ( h_info [ h ] [ h_vw ] > 0 ) set_pos ( playerid, h_info [ h ] [ h_pos ] [ 0 ], h_info [ h ] [ h_pos ] [ 1 ], h_info [ h ] [ h_pos ] [ 2 ], h_info [ h ] [ h_pos ] [ 3 ], 1, h_info [ h ] [ h_vw ] ) ;
		else set_pos ( playerid, h_info [ h ] [ h_pos ] [ 0 ], h_info [ h ] [ h_pos ] [ 1 ], h_info [ h ] [ h_pos ] [ 2 ], h_info [ h ] [ h_pos ] [ 3 ], 0, h_info [ h ] [ h_vw ] ) ;

		DeletePVar ( playerid, "house_id" ) ;
		if ( h_info [ h ] [ h_radio_status ] == 1 )StopAudioStreamForPlayer ( playerid ) ;

		clear_check_info ( playerid, CINFO_HOUSE_HMENU_ID_1 ) ;
	    clear_check_info ( playerid, CINFO_HOUSE_HMENU_ID_2 ) ;
	   	clear_check_info ( playerid, CINFO_HOUSE_HMENU_ID_3 ) ;
		return 1 ;
	}
	return 1 ;
}

//==========================================================================================================================

CMD:edit ( playerid )
{
	if ( ! radio_player ( playerid ) ) return 1 ;

	if ( p_info [ playerid ] [ mute ] )
	{
		new scm_string [ 38 ] ;
		format ( scm_string, sizeof ( scm_string ),"{"#cRInfo"}* {"#cGRInfo"}У вас бан чата | %d секунд(ы)", p_info [ playerid ] [ mute ] ) ;
		SendClientMessage ( playerid, col_light_red, scm_string ) ;
		return true ;
	}

	if ( p_info [ playerid ] [ rank ] < 3 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Редактирование объявлений доступно с 3 ранга." ) ;
 	if ( GetPVarInt ( playerid, "ad_listitem" ) )
    {
    	ad_info [ GetPVarInt ( playerid, "ad_listitem" ) - 1 ] [ ad_checking ] = false ;
    	DeletePVar ( playerid, "ad_listitem" ) ;
	}
	show_ad_list ( playerid ) ;
	return 1 ;
}

callback: advertise_timer ( d )
{
	KillTimer ( ad_info [ d ] [ ad_time ] ) ;
	ad_info [ d ] [ ad_time ] = -1 ;

    if ( ad_info [ d ] [ ad_checked ] )
	{
	    if ( IsPlayerConnected ( ad_info [ d ] [ ad_id ] ) && strlen ( ad_info [ d ] [ ad_text ] ) > 3 )
	    {
			new scm_string [ 144 ] ;
			if ( ad_info [ d ] [ ad_phone_number ] != 0 ) format ( scm_string, 144, "%s. Отправитель: %s (тел. %d)", ad_info [ d ] [ ad_text ], ad_info [ d ] [ ad_sender ], ad_info [ d ] [ ad_phone_number ] ) ;
			else format ( scm_string, 144, "%s. Отправитель: %s", ad_info [ d ] [ ad_text ], ad_info [ d ] [ ad_sender ] ) ;
			foreach(new i: logged_players)
			{
				SendClientMessage ( i, 0x10CC33AA, scm_string ) ;
			}

			if ( ad_info [ d ] [ ad_checker_id ] != INVALID_PLAYER_ID && ad_info [ d ] [ ad_member ] > 0 && ad_info [ d ] [ ad_rank ] > 0 )
			{
				format ( scm_string, 128, "Радиоцентр %s: %s (%s)", f_info [ ad_info [ d ] [ ad_member ] - 1 ] [ f_letter_name ], ad_info [ d ] [ ad_checker ], f_rank [ ad_info [ d ] [ ad_member ] - 1 ] [ ad_info [ d ] [ ad_rank ] - 1 ] ) ;
				foreach(new i: logged_players) SendClientMessage ( i, 0x10A329AA, scm_string ) ;
			}

			strdel ( ad_info [ d ] [ ad_sender ], 0, 24 ) ;
			strdel ( ad_info [ d ] [ ad_text ], 0, 100 ) ;
			strdel ( ad_info [ d ] [ ad_date ], 0, 24 ) ;
			strdel ( ad_info [ d ] [ ad_checker ], 0, 24 ) ;

			ad_info [ d ] [ ad_checker_id ] =
			ad_info [ d ] [ ad_id ] = -1 ;

			ad_info [ d ] [ ad_busy ] =
			ad_info [ d ] [ ad_checked ] =
			ad_info [ d ] [ ad_checking ] = false ;

			ad_info [ d ] [ ad_phone_number ] =
			ad_info [ d ] [ ad_member ] =
			ad_info [ d ] [ ad_rank ] = 0 ;
		}
		else
		{
	  		strdel ( ad_info [ d ] [ ad_sender ], 0, 24 ) ;
			strdel ( ad_info [ d ] [ ad_text ], 0, 100 ) ;
			strdel ( ad_info [ d ] [ ad_date ], 0, 24 ) ;
			strdel ( ad_info [ d ] [ ad_checker ], 0, 24 ) ;

			ad_info [ d ] [ ad_checker_id ] =
			ad_info [ d ] [ ad_id ] = -1 ;

			ad_info [ d ] [ ad_busy ] =
			ad_info [ d ] [ ad_checked ] =
			ad_info [ d ] [ ad_checking ] = false ;

			ad_info [ d ] [ ad_phone_number ] =
			ad_info [ d ] [ ad_member ] =
			ad_info [ d ] [ ad_rank ] = 0 ;
		}
	}
	return 1 ;
}

CMD:advertise ( playerid, params [ ] )
{
    if ( ! p_info [ playerid ] [ number ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас нет SIM-карты, приобретите её в 24/7." ) ;
	if ( p_info [ playerid ] [ radio ] != 27 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас не включено радио. Используйте /radio." ) ;
	if ( ad_cooldown >= gettime ( ) )
	{
	    new scm_string [ 128 ] ;
	    format ( scm_string, sizeof scm_string, "{"#cRInfo"}* {"#cGRInfo"}Нельзя посылать объявление чаще одного в минуту. (Осталось {"#cRD"}%d сек.{"#cGRInfo"})", ad_cooldown - gettime ( ) ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Возможно, объявление подал уже другой игрок." ) ;
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Если успел подал другой игрок, то время ({"#cRD"}ОСТАЛОСЬ{"#cGRInfo"}) пойдёт заново." ) ;
		return 1 ;
	}
	if ( Iter_Count(fraction_players[p_info [ playerid ] [ radio ]]) < 1 )
	{
	    show_dialog ( playerid, d_advertise, DIALOG_STYLE_LIST, "{"#cBHD"}Объявления", "{"#cBHD"}1. {"#cWH"}Продать\n{"#cBHD"}2. {"#cWH"}Набор в организацию\n{"#cBHD"}3. {"#cWH"}Набор в семью\n{"#cGRDialog"}* В данный момент нет сотрудников СМИ\n{"#cGRDialog"}* Воспользуйтесь автоподачей", "Выбрать", "Закрыть" ) ;
		ad_cooldown = gettime ( ) + 60 ;
	    return 1 ;
	}
	if ( isnull ( params ) || strlen ( params ) > 100 || strlen ( params ) < 5 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /ad [текст объявления]" ) ;

    if ( p_info [ playerid ] [ mute ] )
	{
		new scm_string [ 38 ] ;
		format ( scm_string, sizeof ( scm_string ),"{"#cRInfo"}* {"#cGRInfo"}У вас бан чата | %d секунд(ы)", p_info [ playerid ] [ mute ] ) ;
		SendClientMessage ( playerid, col_light_red, scm_string ) ;
		return true ;
	}

	SetPVarString ( playerid, "advert_text", params ) ;

	new _ask [ 100 ] ;
	format ( _ask, sizeof _ask, "%s", params ) ;
	for ( new A = 0 ; A != strlen ( _ask ) ; A ++ )
    {
		switch ( _ask [ A ] )
		{
			case 'А'..'Я': _ask [ A ] = _ask [ A ] + 32 ;
		}
	}
 	if(strfind(_ask, "kk", true) != -1 || strfind(_ask, "кк", true) != -1) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Буквы {"#cRD"}'kk', 'кк' {"#cGRInfo"}нарушают правила рп процесса." ) ;
    if(strfind(_ask, "{", true) != -1 && strfind(_ask, "}", true) != -1) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Символы {"#cRD"}'{', '}' {"#cGRInfo"}нарушают правила рп процесса." ) ;

	new dialog_string [ 300 ] ;
	format ( dialog_string, 300, "{ffffff}Цена объявления: {"#cBL"}%i"valute_title_"\n{ffffff}Текст: {"#cBL"}%s\n\nОбъявление будет подано после проверки.\nВы действительно хотите отправить объявление в редакцию %s?", ad_price, params, f_info [ p_info [ playerid ] [ radio ] - 1 ] [ f_letter_name ] ) ;
	show_dialog ( playerid, d_advert, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Подача объявления",dialog_string, "Принять", "Отменить" ) ;

	ad_cooldown = gettime ( ) + 60 ;
	return 1 ;
}
alias:advertise("ad")

CMD:contract ( playerid, params [ ] )
{
    if ( p_info [ playerid ] [ hour_played ] < THREE_HOUR_PLAYED ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Доступно с 3 часов в игре. Используйте /mm - Информация о персонаже - Статистика персонажа." ) ;
    if ( mafia_player ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете заказывать, потому что Вы исполнитель." ) ;
	if ( sscanf ( params, "dd", params [ 0 ], params [ 1 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /contract [ид] [сумма]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] )  || params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
    if ( admin_info [ params [ 0 ] ] [ admin ] > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данного игрока нельзя заказать." ) ;
	if ( p_info [ params [ 0 ] ] [ head_value ] > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок уже заказан." ) ;
	if ( params [ 1 ] < 50000 || params [ 1 ] > 1000000 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Цена на убийство не может быть менее 50.000"valute_title_" и боле 1.000.000"valute_title"." ) ;
    if ( p_info [ playerid ] [ money ] < params [ 1 ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас недостаточно средств." ) ;

    give_money ( playerid, -params [ 1 ] ) ;
    insert_money_log ( playerid, INVALID_PLAYER_ID, -params [ 1 ], "заказ хитманам" ) ;

	p_info [ params [ 0 ] ] [ head_value ] = params [ 1 ] ;
	update_int_sql ( params [ 0 ], "u_head_value", params [ 1 ] ) ;

	fraction_message ( 23, col_lblue, !"[F] Список заказов обновлён." ) ;
	fraction_message ( 24, col_lblue, !"[F] Список заказов обновлён." ) ;
	fraction_message ( 25, col_lblue, !"[F] Список заказов обновлён." ) ;
	return 1 ;
}

//==========================================================================================================================

CMD:skill ( playerid, params [ ] )
{
	if ( target_cuff [ playerid ] != INVALID_PLAYER_ID )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы в наручниках." ) ;
	if ( target_tie [ playerid ] != INVALID_PLAYER_ID )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы связаны." ) ;
	if ( sscanf ( params, "u", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /skill [ид/имя]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
    if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;
	if ( cooldown_sentence [ playerid ] > gettime ( ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Предложение о сделке можно отправлять один раз в {"#cRD"}45 секунд{"#cGRInfo"}." ) ;

	cooldown_sentence [ playerid ] = gettime ( ) + time_sell_sentence ;

	global_string [ 0 ] = EOS ;

	format ( global_string, 1000, "{ffffff}SDPistol:\t[%s]%d\nDeagle:\t[%s]%d\nShotGun:\t[%s]%d\nMP5\t\t[%s]%d\nAK47:\t\t[%s]%d\nM4A1:\t\t[%s]%d\nRifle:\t\t[%s]%d",
	ToDevelopSkills ( p_info [ playerid ] [ gun_skills ] [ 0 ], 100 - p_info [ playerid ] [ gun_skills ] [ 0 ] ), p_info [ playerid ] [ gun_skills ] [ 0 ],
	ToDevelopSkills ( p_info [ playerid ] [ gun_skills ] [ 1 ], 100 - p_info [ playerid ] [ gun_skills ] [ 1 ] ), p_info [ playerid ] [ gun_skills ] [ 1 ],
	ToDevelopSkills ( p_info [ playerid ] [ gun_skills ] [ 2 ], 100 - p_info [ playerid ] [ gun_skills ] [ 2 ] ), p_info [ playerid ] [ gun_skills ] [ 2 ],
	ToDevelopSkills ( p_info [ playerid ] [ gun_skills ] [ 3 ], 100 - p_info [ playerid ] [ gun_skills ] [ 3 ] ), p_info [ playerid ] [ gun_skills ] [ 3 ],
	ToDevelopSkills ( p_info [ playerid ] [ gun_skills ] [ 4 ], 100 - p_info [ playerid ] [ gun_skills ] [ 4 ] ), p_info [ playerid ] [ gun_skills ] [ 4 ],
	ToDevelopSkills ( p_info [ playerid ] [ gun_skills ] [ 5 ], 100 - p_info [ playerid ] [ gun_skills ] [ 5 ] ), p_info [ playerid ] [ gun_skills ] [ 5 ],
	ToDevelopSkills ( p_info [ playerid ] [ gun_skills ] [ 6 ], 100 - p_info [ playerid ] [ gun_skills ] [ 6 ] ), p_info [ playerid ] [ gun_skills ] [ 6 ] ) ;
	show_dialog ( params [ 0 ], d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Навыки владения оружием", global_string, "Закрыть", "" ) ;

	if ( params [ 0 ] != playerid )
	{
		new _scm_string [ 33 + MAX_PLAYER_NAME ] ;
		format ( _scm_string, sizeof _scm_string, "показал(а) выписку из тира %s", p_info [ params [ 0 ] ] [ name ] ) ;
		me_action ( playerid, _scm_string ) ;
	}
	else me_action ( playerid, "посмотрел(а) свою выписку из тира" ) ;
	return 1 ;
}

CMD:myskill ( playerid )
{
	if ( target_cuff [ playerid ] != INVALID_PLAYER_ID )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы в наручниках." ) ;
	if ( target_tie [ playerid ] != INVALID_PLAYER_ID )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы связаны." ) ;
	global_string [ 0 ] = EOS ;

