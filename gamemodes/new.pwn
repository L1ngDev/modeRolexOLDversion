			if ( p_info [ playerid ] [ hunger_immune ] )
			{
				show_dialog ( playerid, d_donate_hunger, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Донат услуги","{"#cRD"}* У Вас уже активирована бесконечная сытость.\n\n{"#cGRDialog"}- {"#cWH"}Бесконечную сытость:\n\n{"#cGRDialog"}- {"#cWH"}Теперь Вам не нужно искать закусочные, чтобы перекусить,\n{"#cWH"}  у Вас не будет в этом необходимости.\n\n{"#cGRDialog"}* Цена: {"#cGN"}150 "donate_title"{"#cGRDialog"}.\n{"#cGRDialog"}* Вы действительно хотите получить \"{"#cWH"}Бесконечную сытость{"#cGRDialog"}\"?","Принять", "Назад");
				return 1 ;
			}
			p_info [ playerid ] [ hunger_immune ] = 1 ;
			p_info [ playerid ] [ hunger ] = 100 ;

			static const _str [ ] = "UPDATE `users` SET `u_hungerimmune` = '1' WHERE `u_id` = '%d' LIMIT 1" ;
			new query_string [ sizeof _str + 9 ] ;
