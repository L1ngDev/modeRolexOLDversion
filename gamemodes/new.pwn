/*

	Оружейный завод

*/

#define FACTORY_POSITION 12
new bool: StatusFactory [ FACTORY_POSITION ] ;
new MafiaFarriery, mineral ;
new MafiaTime [ 6 ] = { -1, ... } ;
new Text3D: RifaKyznica [ 8 ] ;
new MafiaMetal [ 6 ] ;
new MafiaMatsSlot [ 6 ] ;
new MafiaMatsTime [ 6 ] ;
new FarrieryTimeMafia_ [ 6 ] ;
new FarrieryTimeMafia [ 6 ] ;
new factory_place [ MAX_PLAYERS char ],
	factory_slot [ MAX_PLAYERS char ] ;

new Text3D: FactorySFText3D [ FACTORY_POSITION ] ;

callback: MafiaTimer ( i )
{
    new scm_string [ 100 ] ;
    if ( mineral > 2000 )
	{
		FarrieryTimeMafia [ i ] = random ( 30 ) + 60 ;
		FarrieryTimeMafia_ [ i ] = 1500 + random ( 500 ) ;

		mineral -= FarrieryTimeMafia_ [ i ] ;
        MafiaFarriery += FarrieryTimeMafia_ [ i ] ;

		format ( scm_string, sizeof scm_string, "** Кузница **\n{"#cGR3D"}Руды на переплавке: {"#cWH3D"}%i кг.", MafiaFarriery ) ;
		UpdateDynamic3DTextLabelText ( RifaKyznica [ 6 ], col_header_3d, scm_string ) ;

		format ( scm_string, sizeof scm_string, "** Склад **\n{"#cGR3D"}Руды на складе: {"#cWH3D"}%i кг.", mineral ) ;
		UpdateDynamic3DTextLabelText ( RifaKyznica [ 0 ], col_header_3d, scm_string ) ;
	}

    if ( FarrieryTimeMafia [ i ] > 0 )
    {
	   	FarrieryTimeMafia [ i ] -= 60 ;
	    if ( FarrieryTimeMafia [ i ] <= 0 )
	   	{
			MafiaMetal [ i ] += FarrieryTimeMafia_ [ i ] ;
			MafiaFarriery -= FarrieryTimeMafia_ [ i ] ;

			FarrieryTimeMafia_ [ i ] =
			FarrieryTimeMafia [ i ] = 0 ;

			format ( scm_string, 100, "{%s}*** %s ***\n{"#cGR3D"}Металла: {"#cWH3D"}%i кг.", f_info [ MafiaMatsSlot [ i ] - 1 ] [ f_chat_color ], f_info [ MafiaMatsSlot [ i ] - 1 ] [ f_name ], MafiaMetal [ i ] ) ;
			UpdateDynamic3DTextLabelText ( RifaKyznica [ 0 + i ], -1, scm_string ) ;
		}
	}

    if ( MafiaMatsTime [ i ] > 0 )
    {
    	MafiaMatsTime [ i ] -= 60 ;
     	if ( MafiaMatsTime [ i ] == 0 )
      	{
      	    KillTimer ( MafiaTime [ i ] ) ;
      	    MafiaTime [ i ] = -1 ;

   			foreach(new p: fraction_players[MafiaMatsSlot [ i ]])
			{
				if ( factory_place { p } > 0 )
    			{
     				new z = factory_place { p } - 1 ;
		       		StatusFactory [ z ] = false ;

		        	DestroyDynamic3DTextLabel ( FactorySFText3D [ z ] ) ;
			        FactorySFText3D [ z ] = Text3D:INVALID_3DTEXT_ID ;

			        factory_place { p } =
			        factory_slot { p } = 0 ;

			        DisablePlayerCheckpoint ( p ) ;

				    SendClientMessage ( i, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вашей организации истекло время аренды оружейного завода." ) ;
			    }
			}
		    MafiaMatsSlot [ i ] = -1 ;
		    MafiaMatsTime [ i ] = 0 ;
		   	UpdateDynamic3DTextLabelText ( RifaKyznica [ 0 + i ], col_header_3d, "** Пусто **" ) ;
		}
    }
	return 1 ;
}

/*

	Player Checkpoint

*/

new player_checkpoints [ MAX_PLAYERS ] [ 6 ] ;
stock set_mapicon ( Float: coords_x, Float: coords_y, Float: coords_z, team_iteration )
{
	foreach(new i : fraction_players[team_iteration])
	{
		set_player_checkpoint ( i, ZAHVAT_ICON, coords_x, coords_y, coords_z, 19, 0, -1, -1, true ) ;
	}
	return 1 ;
}

stock set_player_checkpoint ( playerid, slot, Float:x, Float:y, Float:z, icon, color, world, interior, global )
{
	if(0 <= slot <= 5)
	{
		if ( player_checkpoints [ playerid ] [ slot ] != -1 )
		{
			DestroyDynamicMapIcon ( player_checkpoints [ playerid ] [ slot ] ) ;
		}
		player_checkpoints [ playerid ] [ slot ] = CreateDynamicMapIcon ( x, y, z, icon, color, world, interior, playerid, (global) ? (99999.9) : (200.0) ) ;
		Streamer_SetIntData(4, player_checkpoints [ playerid ] [ slot ], E_STREAMER_STYLE, (global) ? (MAPICON_GLOBAL_CHECKPOINT) : (MAPICON_LOCAL_CHECKPOINT) ) ;
	}
	return 1 ;
}

stock disable_mapicon ( team_iteration )
{
	foreach(new i : fraction_players[team_iteration])
	{
		disable_player_checkpoint ( i, ZAHVAT_ICON ) ;
	}
	return 1 ;
}

stock disable_player_checkpoint ( playerid, slot )
{
	if(0 <= slot <= 5)
	{
		if ( player_checkpoints [ playerid ] [ slot ] != -1 )
		{
			DestroyDynamicMapIcon ( player_checkpoints [ playerid ] [ slot ] ) ;
			player_checkpoints [ playerid ] [ slot ] = -1 ;
		}
	}
	return 1 ;
}

