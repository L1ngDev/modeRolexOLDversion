		b_price_market [ b ] [ 2 ],
		b_price_market [ b ] [ 3 ],
		b_price_market [ b ] [ 4 ],
		b_price_market [ b ] [ 5 ] ) ;
		show_dialog ( playerid, d_cafe, DIALOG_STYLE_TABLIST_HEADERS, "{"#cBHD"}Закусочная", global_string, "Купить", "Закрыть" ) ;
