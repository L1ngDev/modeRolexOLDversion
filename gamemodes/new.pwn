}

callback: clear_td_td ( playerid, box_id )
{
	if ( box_id > 4 )
	{
	    for ( new i = 0 ; i < 4 ; i ++ )
	    {
			KillTimer ( p_t_info [ playerid ] [ take_damage_box ] [ i ] ) ;
			p_t_info [ playerid ] [ take_damage_box ] [ i ] = -1 ;
    		damage_td_status ( playerid, i, 4 ) ;
		}
	}

	if ( p_t_info [ playerid ] [ take_damage_box ] [ box_id ] == -1 ) return 1 ;

    damage_td_status ( playerid, box_id, 4 ) ;

	for ( new i = 0 ; i < 3 ; i ++ )
	{
	    if ( p_t_info [ playerid ] [ take_damage_box ] [ i ] == -1 && p_t_info [ playerid ] [ take_damage_box ] [ i + 1 ] == -1 ||
			p_t_info [ playerid ] [ take_damage_box ] [ i ] != -1 && p_t_info [ playerid ] [ take_damage_box ] [ i + 1 ] == -1 ) continue ;

	    format ( take_damage_box_name [ playerid ] [ i ], 64, "%s", take_damage_box_name [ playerid ] [ i + 1 ] ) ;

	    p_t_info [ playerid ] [ t_amount ] [ i ] = p_t_info [ playerid ] [ t_amount ] [ i + 1 ] ;
	    p_t_info [ playerid ] [ t_weapon ] [ i ] = p_t_info [ playerid ] [ t_weapon ] [ i + 1 ] ;
	    p_t_info [ playerid ] [ take_damage_box_type ] [ i ] = p_t_info [ playerid ] [ take_damage_box_type ] [ i + 1 ] ;

		damage_td_status ( playerid, i + 1, 4 ) ;

		KillTimer ( p_t_info [ playerid ] [ take_damage_box ] [ i + 1 ] ) ;
		p_t_info [ playerid ] [ take_damage_box ] [ i + 1 ] = -1 ;

        create_td_td ( playerid, p_t_info [ playerid ] [ take_damage_box_type ] [ i ], p_t_info [ playerid ] [ t_amount ] [ i ], p_t_info [ playerid ] [ t_weapon ] [ i ] ) ;
	}
	return 1 ;
}

stock GivePlayerStats ( playerid, statss, num )
{
	if ( 0 <= p_info [ playerid ] [ stats ] [ statss ] + num <= 100 ) p_info [ playerid ] [ stats ] [ statss ] += num ;
	else return 1 ;
	switch ( statss )
	{
		case 0:
		{
			if ( num > 0 )
			{
				if ( p_info [ playerid ] [ stats ] [ statss ] <= 10 ) SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы потолстели. Ваш вес - очень маленький." ) ;
				if ( p_info [ playerid ] [ stats ] [ statss ] >= 11 && p_info [ playerid ] [ stats ] [ statss ] <= 30 ) SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы потолстели. Ваш вес - маленький." ) ;
				if ( p_info [ playerid ] [ stats ] [ statss ] >= 31 && p_info [ playerid ] [ stats ] [ statss ] <= 70 ) SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы потолстели. Ваш вес - нормальный." ) ;
				if ( p_info [ playerid ] [ stats ] [ statss ] >= 71 && p_info [ playerid ] [ stats ] [ statss ] <= 90 ) SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы потолстели. Ваш вес - большой." ) ;
				if ( p_info [ playerid ] [ stats ] [ statss ] >= 91 ) SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы потолстели. Ваш вес - очень большой." ) ;
			}
			else
			{
				if ( p_info [ playerid ] [ stats ] [ statss ] <= 10 ) SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы похудели. Ваш вес - очень маленький." ) ;
				if ( p_info [ playerid ] [ stats ] [ statss ] >= 11 && p_info [ playerid ] [ stats ] [ statss ] <= 30 ) SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы похудели. Ваш вес - маленький." ) ;
				if ( p_info [ playerid ] [ stats ] [ statss ] >= 31 && p_info [ playerid ] [ stats ] [ statss ] <= 70 ) SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы похудели. Ваш вес - нормальный." ) ;
				if ( p_info [ playerid ] [ stats ] [ statss ] >= 71 && p_info [ playerid ] [ stats ] [ statss ] <= 90 ) SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы похудели. Ваш вес - большой." ) ;
				if ( p_info [ playerid ] [ stats ] [ statss ] >= 91 ) SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы похудели. Ваш вес - очень большой." ) ;
			}
			update_int_sql ( playerid, "u_stats0", p_info [ playerid ] [ stats ] [ statss ] ) ;
		}
		case 1:
		{
			if ( num > 0 )
			{
				if ( p_info [ playerid ] [ stats ] [ statss ] <= 10 ) SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Ваша выносливость улучшена. Ваша выносливость - очень плохая." ) ;
				if ( p_info [ playerid ] [ stats ] [ statss ] >= 11 && p_info [ playerid ] [ stats ] [ statss ] <= 30 ) SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Ваша выносливость улучшена. Ваша выносливость - плохая." ) ;
				if ( p_info [ playerid ] [ stats ] [ statss ] >= 31 && p_info [ playerid ] [ stats ] [ statss ] <= 70 ) SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Ваша выносливость улучшена. Ваша выносливость - нормальная." ) ;
				if ( p_info [ playerid ] [ stats ] [ statss ] >= 71 && p_info [ playerid ] [ stats ] [ statss ] <= 90 ) SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Ваша выносливость улучшена. Ваша выносливость - хорошая." ) ;
				if ( p_info [ playerid ] [ stats ] [ statss ] >= 91 ) SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Ваша выносливость улучшена. Ваша выносливость - очень хорошая." ) ;
			}
			else
			{
				if ( p_info [ playerid ] [ stats ] [ statss ] <= 10 ) SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Ваша выносливость ухудшена. Ваша выносливость - очень плохая." ) ;
				if ( p_info [ playerid ] [ stats ] [ statss ] >= 11 && p_info [ playerid ] [ stats ] [ statss ] <= 30 ) SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Ваша выносливость ухудшена. Ваша выносливость - плохая." ) ;
				if ( p_info [ playerid ] [ stats ] [ statss ] >= 31 && p_info [ playerid ] [ stats ] [ statss ] <= 70 ) SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Ваша выносливость ухудшена. Ваша выносливость - нормальная." ) ;
				if ( p_info [ playerid ] [ stats ] [ statss ] >= 71 && p_info [ playerid ] [ stats ] [ statss ] <= 90 ) SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Ваша выносливость ухудшена. Ваша выносливость - хорошая." ) ;
				if ( p_info [ playerid ] [ stats ] [ statss ] >= 91 ) SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Ваша выносливость ухудшена. Ваша выносливость - очень хорошая." ) ;
			}
			update_int_sql ( playerid, "u_stats1", p_info [ playerid ] [ stats ] [ statss ] ) ;
		}
		case 2:
		{
			if ( num > 0 )
			{
				if ( p_info [ playerid ] [ stats ] [ statss ] <= 10 ) SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Ваша сила улучшена. Ваша сила - очень маленькая." ) ;
				if ( p_info [ playerid ] [ stats ] [ statss ] >= 11 && p_info [ playerid ] [ stats ] [ statss ] <= 30 ) SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Ваша сила улучшена. Ваша сила - маленькая." ) ;
				if ( p_info [ playerid ] [ stats ] [ statss ] >= 31 && p_info [ playerid ] [ stats ] [ statss ] <= 70 ) SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Ваша сила улучшена. Ваша сила - нормальная." ) ;
				if ( p_info [ playerid ] [ stats ] [ statss ] >= 71 && p_info [ playerid ] [ stats ] [ statss ] <= 90 ) SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Ваша сила улучшена. Ваша сила - большая." ) ;
				if ( p_info [ playerid ] [ stats ] [ statss ] >= 91 ) SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Ваша сила улучшена. Ваша сила - очень большая." ) ;
			}
			else
			{
				if ( p_info [ playerid ] [ stats ] [ statss ] <= 10 ) SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Ваша сила ухудшена. Ваша сила - очень маленькая." ) ;
				if ( p_info [ playerid ] [ stats ] [ statss ] >= 11 && p_info [ playerid ] [ stats ] [ statss ] <= 30 ) SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Ваша сила ухудшена. Ваша сила - маленькая." ) ;
				if ( p_info [ playerid ] [ stats ] [ statss ] >= 31 && p_info [ playerid ] [ stats ] [ statss ] <= 70 ) SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Ваша сила ухудшена. Ваша сила - нормальная." ) ;
				if ( p_info [ playerid ] [ stats ] [ statss ] >= 71 && p_info [ playerid ] [ stats ] [ statss ] <= 90 ) SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Ваша сила ухудшена. Ваша сила - большая." ) ;
				if ( p_info [ playerid ] [ stats ] [ statss ] >= 91 ) SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Ваша сила ухудшена. Ваша сила - очень большая." ) ;
			}
			update_int_sql ( playerid, "u_stats2", p_info [ playerid ] [ stats ] [ statss ] ) ;
		}
	}
	return 1 ;
}

stock SetPlayerFightingStyles ( playerid )
{
	new Style [ 10 ] ;
	switch ( p_info [ playerid ] [ u_style ] [ 0 ] )
	{
		case 1000: for ( new A = 0 ; A != 7 ; A ++ ) Style [ A ] = 1 ;
		case 800..999: for ( new A = 0 ; A != 6 ; A ++ ) Style [ A ] = 1 ;
		case 640..799: for ( new A = 0 ; A != 5 ; A ++ ) Style [ A ] = 1 ;
		case 480..639: for ( new A = 0 ; A != 4 ; A ++ ) Style [ A ] = 1 ;
		case 320..479: for ( new A = 0 ; A != 3 ; A ++ ) Style [ A ] = 1 ;
		case 160..319: for ( new A = 0 ; A != 2 ; A ++ ) Style [ A ] = 1 ;
		case 1..159: Style [ 0 ] = 1 ;
	}
	switch ( p_info [ playerid ] [ u_style ] [ 1 ] )
	{
		case 1000: for ( new A = 7 ; A != 10 ; A ++ ) Style [ A ] = 1 ;
		case 600..999: for ( new A = 7 ; A != 9 ; A ++ ) Style [ A ] = 1 ;
		case 300..599: for ( new A = 7 ; A != 8 ; A ++ ) Style [ A ] = 1 ;
		case 1..299: Style [ 7 ] = 1 ;
	}

	new ChooseStyle = random ( 10 ) ;
	for ( new A ; A != 7 ; A ++ ) if ( A == ChooseStyle && Style [ A ] == 1 ) return SetPlayerFightingStyle ( playerid, FIGHT_STYLE_BOXING ) ;
	for ( new A = 7 ; A != 10; A ++ ) if ( A == ChooseStyle && Style [ A ] == 1 ) return SetPlayerFightingStyle ( playerid, FIGHT_STYLE_KUNGFU ) ;
	SetPlayerFightingStyle ( playerid, FIGHT_STYLE_NORMAL ) ;
	return 1 ;
}

stock gym_stop_used ( playerid, bool: status )
{
	if ( status )
	{
	    new _gym = p_t_info [ playerid ] [ gym_shell ] ;
	    if ( _gym == 1 )
		{
			if ( p_t_info [ playerid ] [ gym_time ] <= gettime ( ) )
			{
				p_t_info [ playerid ] [ gym_shell ] = 0 ;
				ApplyAnimation(playerid, "GYMNASIUM", "gym_bike_getoff", 4, 0, 0, 0, 0, 0);
				SimulatorUse [ GetPVarInt ( playerid, "p_biz_id" ) ] [ GetPVarInt ( playerid, "Simulator_ID" ) ] = false ;
				DeletePVar ( playerid, "Simulator_ID" ) ;
			}
		}
		else if ( _gym == 2 )
		{
			if ( p_t_info [ playerid ] [ gym_time ] <= gettime ( ) )
			{
				p_t_info [ playerid ] [ gym_shell ] = 0 ;
				ApplyAnimation(playerid, "GYMNASIUM", "gym_jog_falloff", 4, 0, 0, 0, 0, 0);
				SimulatorUse [ GetPVarInt ( playerid, "p_biz_id" ) ] [ GetPVarInt ( playerid, "Simulator_ID" ) ] = false ;
				DeletePVar ( playerid, "Simulator_ID" ) ;
			}
		}
		else if ( _gym == 3 )
		{
			if ( p_t_info [ playerid ] [ gym_time ] <= gettime ( ) )
			{
				p_t_info [ playerid ] [ gym_shell ] = 0 ;
				ApplyAnimation(playerid, "benchpress", "gym_bp_getoff", 4, 0, 0, 0, 0, 0);
				RemovePlayerAttachedObject(playerid, 3);
				SimulatorUse [ GetPVarInt ( playerid, "p_biz_id" ) ] [ GetPVarInt ( playerid, "Simulator_ID" ) ] = false ;
				DeletePVar ( playerid, "Simulator_ID" ) ;
			}
		}
		else if ( _gym == 4 )
		{
			if ( p_t_info [ playerid ] [ gym_time ] <= gettime ( ) )
			{
				p_t_info [ playerid ] [ gym_shell ] = 0 ;
				ApplyAnimation(playerid, "Freeweights", "gym_free_putdown", 4, 0, 0, 0, 0, 0);
				RemovePlayerAttachedObject(playerid, 3);
				SimulatorUse [ GetPVarInt ( playerid, "p_biz_id" ) ] [ GetPVarInt ( playerid, "Simulator_ID" ) ] = false ;
				DeletePVar ( playerid, "Simulator_ID" ) ;
			}
		}
	}
	else
	{
	    new _gym = p_t_info [ playerid ] [ gym_shell ] ;
	    if ( _gym == 1 )
		{
			p_t_info [ playerid ] [ gym_shell ] = 0 ;
			ApplyAnimation(playerid, "GYMNASIUM", "gym_bike_getoff", 4, 0, 0, 0, 0, 0);
			SimulatorUse [ GetPVarInt ( playerid, "p_biz_id" ) ] [ GetPVarInt ( playerid, "Simulator_ID" ) ] = false ;
			DeletePVar ( playerid, "Simulator_ID" ) ;
		}
		else if ( _gym == 2 )
		{
			p_t_info [ playerid ] [ gym_shell ] = 0 ;
			ApplyAnimation(playerid, "GYMNASIUM", "gym_jog_falloff", 4, 0, 0, 0, 0, 0);
			SimulatorUse [ GetPVarInt ( playerid, "p_biz_id" ) ] [ GetPVarInt ( playerid, "Simulator_ID" ) ] = false ;
			DeletePVar ( playerid, "Simulator_ID" ) ;
		}
		else if ( _gym == 3 )
		{
			p_t_info [ playerid ] [ gym_shell ] = 0 ;
			ApplyAnimation(playerid, "benchpress", "gym_bp_getoff", 4, 0, 0, 0, 0, 0);
			RemovePlayerAttachedObject(playerid, 3);
			SimulatorUse [ GetPVarInt ( playerid, "p_biz_id" ) ] [ GetPVarInt ( playerid, "Simulator_ID" ) ] = false ;
			DeletePVar ( playerid, "Simulator_ID" ) ;
		}
		else if ( _gym == 4 )
		{
			p_t_info [ playerid ] [ gym_shell ] = 0 ;
			ApplyAnimation(playerid, "Freeweights", "gym_free_putdown", 4, 0, 0, 0, 0, 0);
			RemovePlayerAttachedObject(playerid, 3);
			SimulatorUse [ GetPVarInt ( playerid, "p_biz_id" ) ] [ GetPVarInt ( playerid, "Simulator_ID" ) ] = false ;
			DeletePVar ( playerid, "Simulator_ID" ) ;
		}
	}
	return 1 ;
}

CMD:logs ( playerid )
{
	if ( admin_info [ playerid ] [ admin ] < 5 ) return 1 ;

	onServerSendData ( playerid, UI_ADMIN_LOGS, 0, "[]" ) ;
	request_admin_logs_ui ( playerid, TYPE_LOG_KICK ) ;
	return 1 ;
}

stock bool: is_admin_logs_ui_type ( log_type )
{
	switch ( log_type )
	{
		case TYPE_LOG_KICK, TYPE_LOG_WARN, TYPE_LOG_BAN, TYPE_LOG_UNBAN, TYPE_LOG_UNWARN,
			TYPE_LOG_MKL, TYPE_LOG_JAIL, TYPE_LOG_MUTE, TYPE_LOG_UNMUTE, TYPE_LOG_UNJAIL,
			TYPE_LOG_INVITE, TYPE_LOG_UVAL, TYPE_LOG_AGIVERANK, TYPE_LOG_OBWYAK,
			TYPE_LOG_LMENU, TYPE_LOG_ADMIN: return true ;
	}
	return false ;
}

stock request_admin_logs_ui ( playerid, log_type )
{
	if ( admin_info [ playerid ] [ admin ] < 5 || ! is_admin_logs_ui_type ( log_type ) ) return 1 ;
	if ( log_type == TYPE_LOG_ADMIN && admin_info [ playerid ] [ admin ] < 8 )
	{
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данный раздел вам недоступен." ) ;
		return 1 ;
	}

	static const query_fmt [ ] = "SELECT `type`, `date`, `text`, `name` FROM `logs_all` WHERE `type` = '%d' ORDER BY `id` DESC LIMIT 20" ;
	new query_string [ sizeof query_fmt + 4 ] ;
	format ( query_string, sizeof query_string, query_fmt, log_type ) ;
	mysql_tquery ( sql_connection, query_string, "admin_logs_ui_loaded", "ii", playerid, log_type ) ;
	return 1 ;
}

stock show_packet_admin_logs ( playerid, action_id, data [ ] )
{
	if ( action_id == 1 ) request_admin_logs_ui ( playerid, strval ( data ) ) ;
	return 1 ;
}

callback: admin_logs_ui_loaded ( playerid, log_type )
{
	if ( ! IsPlayerConnected ( playerid ) || admin_info [ playerid ] [ admin ] < 5 ) return 1 ;

	new rows, fields ;
	cache_get_data ( rows, fields ) ;

	new Node: logs_node = JSON_Array ( ) ;
	for ( new i = 0, Node: log_node ; i < rows ; i ++ )
	{
		new log_date [ 32 ], log_text [ 256 ], log_name [ MAX_PLAYER_NAME ] ;
		cache_get_field_content ( i, "date", log_date, sql_connection, sizeof log_date ) ;
		cache_get_field_content ( i, "text", log_text, sql_connection, sizeof log_text ) ;
		cache_get_field_content ( i, "name", log_name, sql_connection, sizeof log_name ) ;

		log_node = JSON_Array (
			JSON_Object (
				"type", JSON_Int ( log_type ),
				"date", JSON_String ( log_date ),
				"action", JSON_String ( log_text ),
				"performer", JSON_String ( log_name )
			)
		) ;
		logs_node = JSON_Append ( logs_node, log_node ) ;
	}

	static json_string [ 8192 ] ;
	json_string [ 0 ] = EOS ;
	JSON_Stringify ( logs_node, json_string, sizeof json_string ) ;
	JSON_Cleanup ( logs_node ) ;
	onServerSendData ( playerid, UI_ADMIN_LOGS, 100 + log_type, json_string ) ;
	return 1 ;
}

