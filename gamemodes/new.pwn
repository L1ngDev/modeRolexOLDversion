		PlayerTextDrawAlignment(playerid, robbery_ptd[playerid][9], 2);
		PlayerTextDrawColor(playerid, robbery_ptd[playerid][9], color_box);
		PlayerTextDrawBackgroundColor(playerid, robbery_ptd[playerid][9], 255);
		PlayerTextDrawFont(playerid, robbery_ptd[playerid][9], 1);
		PlayerTextDrawSetProportional(playerid, robbery_ptd[playerid][9], 1);
		PlayerTextDrawSetShadow(playerid, robbery_ptd[playerid][9], 0);

		robbery_ptd[playerid][10] = CreatePlayerTextDraw(playerid, 607.7326, 252.2236, "+"); // Weapon
		PlayerTextDrawLetterSize(playerid, robbery_ptd[playerid][10], 0.2249, 0.9279);
		PlayerTextDrawAlignment(playerid, robbery_ptd[playerid][10], 2);
		PlayerTextDrawColor(playerid, robbery_ptd[playerid][10], color_box);
		PlayerTextDrawBackgroundColor(playerid, robbery_ptd[playerid][10], 255);
		PlayerTextDrawFont(playerid, robbery_ptd[playerid][10], 1);
		PlayerTextDrawSetProportional(playerid, robbery_ptd[playerid][10], 1);
		PlayerTextDrawSetShadow(playerid, robbery_ptd[playerid][10], 0);

		robbery_ptd[playerid][11] = CreatePlayerTextDraw(playerid, 607.7326, 263.0242, "+"); // Equipment
		PlayerTextDrawLetterSize(playerid, robbery_ptd[playerid][11], 0.2249, 0.9279);
		PlayerTextDrawAlignment(playerid, robbery_ptd[playerid][11], 2);
		PlayerTextDrawColor(playerid, robbery_ptd[playerid][11], color_box);
		PlayerTextDrawBackgroundColor(playerid, robbery_ptd[playerid][11], 255);
		PlayerTextDrawFont(playerid, robbery_ptd[playerid][11], 1);
		PlayerTextDrawSetProportional(playerid, robbery_ptd[playerid][11], 1);
		PlayerTextDrawSetShadow(playerid, robbery_ptd[playerid][11], 0);

		robbery_ptd[playerid][12] = CreatePlayerTextDraw(playerid, 545.1328, 288.7257, "00:00"); // пусто
		PlayerTextDrawLetterSize(playerid, robbery_ptd[playerid][12], 0.2389, 1.5290);
		PlayerTextDrawAlignment(playerid, robbery_ptd[playerid][12], 2);
		PlayerTextDrawColor(playerid, robbery_ptd[playerid][12], color_black_box);
		PlayerTextDrawBackgroundColor(playerid, robbery_ptd[playerid][12], 255);
		PlayerTextDrawFont(playerid, robbery_ptd[playerid][12], 2);
		PlayerTextDrawSetProportional(playerid, robbery_ptd[playerid][12], 1);
		PlayerTextDrawSetShadow(playerid, robbery_ptd[playerid][12], 0);

		robbery_ptd[playerid][13] = CreatePlayerTextDraw(playerid, 592.1325, 290.3850, "$0"); // пусто
		PlayerTextDrawLetterSize(playerid, robbery_ptd[playerid][13], 0.1729, 1.2888);
		PlayerTextDrawAlignment(playerid, robbery_ptd[playerid][13], 2);
		PlayerTextDrawColor(playerid, robbery_ptd[playerid][13], color_black_box);
		PlayerTextDrawBackgroundColor(playerid, robbery_ptd[playerid][13], 255);
		PlayerTextDrawFont(playerid, robbery_ptd[playerid][13], 2);
		PlayerTextDrawSetProportional(playerid, robbery_ptd[playerid][13], 1);
		PlayerTextDrawSetShadow(playerid, robbery_ptd[playerid][13], 0);

		for ( new i = 0 ; i < 46 ; i ++ )
		{
			TextDrawShowForPlayer ( playerid, robbery_td [ i ] ) ;
			if ( i < 14 ) PlayerTextDrawShow ( playerid, robbery_ptd [ playerid ] [ i ] ) ;
		}
	}
	else
	{
	    for ( new i = 0 ; i < 46 ; i ++ )
		{
		    TextDrawHideForPlayer ( playerid, robbery_td [ i ] ) ;

		    if ( i < 14 )
		    {
			    PlayerTextDrawHide ( playerid, robbery_ptd [ playerid ] [ i ] ) ;

				PlayerTextDrawDestroy ( playerid, robbery_ptd [ playerid ] [ i ] ) ;
				robbery_ptd [ playerid ] [ i ] = PlayerText:-1 ;
			}
		}
	}
	return 1 ;
}

stock show_robbery ( playerid )
{
	static const status_names [ 3 ] [ 32 ] =
	{
	    "{"#cRD"}Уже грабится",
	    "{"#cYW"}Уже грабили",
	    "{"#cGN"}Доступен"
	} ;

	global_string [ 0 ] = EOS ;
	new line_string [ 100 ] ;
	for ( new i = 0 ; i < MAX_BANKS ; i ++ )
	{
	    format ( line_string, sizeof line_string, "{"#cBL"}%d. {"#cWH"}Банк %s {"#cGRDialog"}(%s{"#cGRDialog"})\n", i + 1, bank_names [ i ], status_names [ bank_status [ i ] - 1 ] ) ;
	    strcat ( global_string, line_string ) ;
	}
	show_dialog ( playerid, d_bank_robbery, DIALOG_STYLE_LIST, "{"#cBHD"}Ограбление банка", global_string, "Выбрать", "Закрыть" ) ;
	return 1 ;
}

CMD:ba_robbery ( playerid )
{
	if ( p_t_info [ playerid ] [ t_robbery ] == -1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не учавствуете в ограбление." ) ;

	new _team = p_t_info [ playerid ] [ t_robbery ] ;
	global_string [ 0 ] = EOS ;

	strcat ( global_string, "{"#cBL"}1. {"#cWH"}План банка\n" ) ;
	if ( bank_progress [ _team ] > 0 ) strcat ( global_string, "{"#cBL"}2. {"#cWH"}Экипировка\n" ) ;
	if ( bank_progress [ _team ] > 1 ) strcat ( global_string, "{"#cBL"}3. {"#cWH"}Оружие\n" ) ;
	if ( bank_progress [ _team ] > 2 ) strcat ( global_string, "{"#cBL"}4. {"#cWH"}Транспорт\n" ) ;
	if ( bank_progress [ _team ] > 3 ) strcat ( global_string, "{"#cBL"}5. {"#cWH"}Ограбление\n" ) ;
	strcat ( global_string, "{"#cGRDialog"}* Используйте /rob для общения с командой\n" ) ;
	show_dialog ( playerid, d_bank_progress, DIALOG_STYLE_LIST, "{"#cBHD"}Задачи", global_string, "Выбрать", "Закрыть" ) ;
	return 1 ;
}

CMD:rob ( playerid, params [ ] )
{
    if ( p_t_info [ playerid ] [ t_robbery ] == -1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не учавствуете в ограбление." ) ;
	if ( p_info [ playerid ] [ mute ] )
	{
		new scm_string [ 38 ] ;
		format ( scm_string, sizeof ( scm_string ),"{"#cRInfo"}* {"#cGRInfo"}У вас бан чата | %d секунд(ы)", p_info [ playerid ] [ mute ] ) ;
		SendClientMessage ( playerid, col_light_red, scm_string ) ;
		return true ;
	}
	if ( sscanf ( params, "s[100]", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /rob [текст]" ) ;
	if ( check_advertise ( playerid, params [ 0 ], report_type_rob ) ) return 1 ;

	new scm_string [ 144 ];
	format ( scm_string, sizeof scm_string, "* [ROBBERY] %s[%d]: %s", p_info [ playerid ] [ name ], playerid, params [ 0 ] ) ;
  	robbery_message ( p_t_info [ playerid ] [ t_robbery ], col_lblue, scm_string ) ;

	SetPlayerChatBubble(playerid, "Сказал(а) что-то в командный чат", col_light_purple, 10.0, 3000);
	return 1 ;
}

CMD:rwait ( playerid )
{
	if ( p_t_info [ playerid ] [ t_robbery ] == -1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не участник ограбления." ) ;

    global_string [ 0 ] = EOS ;
    new _team = p_t_info [ playerid ] [ t_robbery ], scm_string [ MAX_PLAYER_NAME + 4 + 32 ] ;
	foreach(new i: robbery_team[_team])
	{
	    format ( scm_string, sizeof scm_string, "{"#cGRDialog"}- {"#cWH"}%s[%d] - {"#cBL"}%s\n", p_info [ i ] [ name ], i, f_rank [ p_info [ i ] [ member ] - 1 ] [ p_info [ i ] [ rank ] - 1 ] ) ;
		strcat ( global_string, scm_string ) ;
	}
	format ( scm_string, sizeof scm_string, "{"#cGRDialog"}%d из 4 участников\n", Iter_Count(robbery_team[_team]) ) ;
	strcat ( global_string, scm_string ) ;
	show_dialog ( playerid, d_none, DIALOG_STYLE_LIST, "{"#cBHD"}Ваша команда", global_string, "Закрыть", "" ) ;
	return 1 ;
}

stock exit_robbery ( playerid )
{
    new _team = p_t_info [ playerid ] [ t_robbery ] ;
    if ( _team == -1 ) return 1 ;
	if ( Iter_Count(robbery_team[_team]) < 4 )
    {
		Iter_Remove ( robbery_team[_team], playerid ) ;
		p_t_info [ playerid ] [ t_robbery ] = -1 ;

		static const _str [ ] = "* [ROBBERY] %s[%d] покинул(а) Вашу команду ограбления!" ;
		new scm_string [ sizeof _str + 24 + 4 ] ;
		format ( scm_string, sizeof scm_string, _str, p_info [ playerid ] [ name ], playerid ) ;
		robbery_message ( _team, col_lblue, scm_string ) ;

		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы покинули ограбление." ) ;
	}
	return 1 ;
}

stock step_bank_robbery ( _team, step )
{
    switch ( step )
    {
    	case 0:
     	{
     	    foreach(new i: robbery_team[_team])
		    {
	      		SetPlayerRaceCheckpoint ( i, 1, bank_progress_checkpoint [ 0 ] [ 0 ], bank_progress_checkpoint [ 0 ] [ 1 ], bank_progress_checkpoint [ 0 ] [ 2 ], 0.0, 0.0, 0.0, 2.0 ) ; // -2345.3489, 244.7435, 22.0339

				SendClientMessage ( i, col_white, !"{"#cGInfo"}* {"#cWH"}[GPS] - Метка установлена." ) ;
				is_gps_used { i } = 1 ;
			}
		}
		case 1:
  		{
  		    foreach(new i: robbery_team[_team])
		    {
	    		if ( random ( 2 ) == 0 ) SetPlayerRaceCheckpoint ( i, 1, bank_progress_checkpoint [ 1 ] [ 0 ], bank_progress_checkpoint [ 1 ] [ 1 ], bank_progress_checkpoint [ 1 ] [ 2 ], 0.0, 0.0, 0.0, 2.0 ) ; // -2345.3489, 244.7435, 22.0339
				else SetPlayerRaceCheckpoint ( i, 1, bank_progress_checkpoint [ 2 ] [ 0 ], bank_progress_checkpoint [ 2 ] [ 1 ], bank_progress_checkpoint [ 2 ] [ 2 ], 0.0, 0.0, 0.0, 2.0 ) ; // -2345.3489, 244.7435, 22.0339

				SendClientMessage ( i, col_white, !"{"#cGInfo"}* {"#cWH"}[GPS] - Метка установлена." ) ;
				is_gps_used { i } = 1 ;
			}
		}
		case 2: return 1 ;
		case 3:
		{
	   		if ( bank_vehicle_gz [ _team ] != -1 )
		    {
	      		foreach(new i: robbery_team[_team]) GangZoneHideForPlayer ( i, bank_vehicle_gz [ _team ] ) ;
		       	GangZoneDestroy ( bank_vehicle_gz [ _team ] ) ;
				bank_vehicle_gz [ _team ] = -1 ;
	    	}

            if ( bank_gz [ _team ] == -1 ) bank_gz [ _team ] = random ( MAX_BANK_GZ ) ;
			if ( bank_vehicle [ _team ] == INVALID_VEHICLE_ID )
			{
			    new _random = bank_gz [ _team ] ;
				bank_vehicle [ _team ] = CreateVehicle ( 428, bank_vehicle_pos [ _random ] [ 0 ], bank_vehicle_pos [ _random ] [ 1 ], bank_vehicle_pos [ _random ] [ 2 ], bank_vehicle_pos [ _random ] [ 3 ], random ( 126 ), random ( 126 ), -1 ) ;

				new vehicle_id = bank_vehicle [ _team ] ;
				veh_info [ vehicle_id - 1 ] [ v_owner ] = -1 ;
				veh_info [ vehicle_id - 1 ] [ v_type ] = vehicle_type_jackcar ;
				veh_info [ vehicle_id - 1 ] [ v_sell_price ] = 0 ;

				veh_info [ vehicle_id - 1 ] [ v_now_pos ] [ 0 ] = bank_vehicle_pos [ _random ] [ 0 ] ;
				veh_info [ vehicle_id - 1 ] [ v_now_pos ] [ 1 ] = bank_vehicle_pos [ _random ] [ 1 ] ;

				new engine, lights, alarm, doors, bonnet, boot, objective ;

				veh_info [vehicle_id - 1 ] [ v_locked ] = true ;
				GetVehicleParamsEx ( vehicle_id, engine, lights, alarm, doors, bonnet, boot, objective ) ;
				SetVehicleParamsEx ( vehicle_id, engine, lights, alarm, true, bonnet, boot, objective ) ;
			}

			new Float: pos [ 4 ], Float: perv_pos [ 2 ] ;
            find_mark_gz ( -1, bank_vehicle [ _team ], perv_pos [ 0 ], perv_pos [ 1 ] ) ;
            get_gz_pos ( perv_pos [ 0 ]-float(-random(50)+random(50)), perv_pos [ 1 ]-float(-random(50)+random(50)), 80.0, pos [ 0 ], pos [ 1 ], pos [ 2 ], pos [ 3 ] ) ;
			bank_vehicle_gz [ _team ] = GangZoneCreate ( pos [ 0 ], pos [ 1 ], pos [ 2 ], pos [ 3 ] ) ;

			foreach(new i: robbery_team[_team])
			{
				GangZoneShowForPlayer ( i, bank_vehicle_gz [ _team ], 0x000000AA ) ;

				SendClientMessage ( i, col_white, !"{"#cGInfo"}* {"#cWH"}Местоположение определено и отмечено на карте." ) ;
				SendClientMessage ( i, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Откройте карту в настройках игры и ищите чёрный квадрат." ) ;
			}
		}
		case 4:
		{
			static const letter_role [ 4 ] [ 4 ] =
			{
				"K",
				"T",
				"O",
				"B"
			} ;

			new _player_role = 0, _player_name [ 12 ] ;
		    foreach(new i: robbery_team[_team])
		    {
			 	format ( _player_name, 12, "%s", letter_role [ _player_role ] ) ;

				foreach(new j: robbery_team[_team])
				{
					PlayerTextDrawSetString ( j, robbery_ptd [ j ] [ 4 + _player_role ], _player_name ) ;
				}

				_player_role ++ ;
		   	}
		}
    }
	return 1 ;
}

stock enter_bank_robbery ( playerid )
{
    for ( new i = 0 ; i < MAX_BANKS ; i ++ )
    {
        if ( bank_status [ i ] != 1 ) continue ;

        for ( new p = 0 ; p < 4 ; p ++ )
        {
            if ( bank_user_id [ i ] [ p ] != p_info [ playerid ] [ id ] ) continue ;

            p_t_info [ playerid ] [ t_robbery ] = i ;
            Iter_Add(robbery_team[i], playerid);

            robbery_td_status ( playerid, true ) ;

            new _plaeyrs = 0, _players_name [ 32 ] ;
			foreach(new a: robbery_team[i])
			{
			    if ( Iter_Count(robbery_team[i]) >= 4 )
				{
					format ( _players_name, sizeof _players_name, "%s", p_info [ a ] [ name ] ) ;
					PlayerTextDrawSetString ( playerid, robbery_ptd [ playerid ] [ _plaeyrs ], _players_name ) ;

					_plaeyrs ++ ;
				    continue ;
				}
			}

			if ( bank_progress [ i ] > 0 ) PlayerTextDrawSetString ( playerid, robbery_ptd [ playerid ] [ 8 ], "+" ) ;
			if ( bank_progress [ i ] > 1 ) PlayerTextDrawSetString ( playerid, robbery_ptd [ playerid ] [ 10 ], "+" ) ;
			if ( bank_progress [ i ] > 2 ) PlayerTextDrawSetString ( playerid, robbery_ptd [ playerid ] [ 9 ], "+" ) ;

			static const _str [ ] = "* [ROBBERY] %s[%d] вернулся(ась) в игру, ограбление продолжается!" ;
			new scm_string [ sizeof _str + 24 + 4 ] ;
			format ( scm_string, sizeof scm_string, _str, p_info [ playerid ] [ name ], playerid ) ;
			robbery_message ( i, col_lblue, scm_string ) ;

            bank_user_id [ i ] [ p ] = -1 ;
            bank_disconnect_time [ i ] = -1 ;
            break ;
        }
        break ;
    }
	return 1 ;
}

stock clear_bank_robbery ( playerid, type, _team = -1 )
{
	if ( type != 4 )
	{
	    _team = p_t_info [ playerid ] [ t_robbery ] ;
	    if ( _team == -1 ) return 1 ;
	    if ( Iter_Count(robbery_team[_team]) < 4 ) return 1 ;
	}

    if ( type == 1 )
    {
		if ( bank_progress [ _team ] < 4 )
		{
		    for ( new i = 0 ; i < 4 ; i ++ )
		    {
		        if ( bank_user_id [ _team ] [ i ] != -1 ) continue ;

		    	bank_user_id [ _team ] [ i ] = p_info [ playerid ] [ id ] ;
		    	break ;
			}
			bank_disconnect_time [ _team ] = MAX_BANK_DISCONNECT ;
			Iter_Remove(robbery_team[_team], playerid);

			p_t_info [ playerid ] [ t_robbery ] = -1 ;
			robbery_td_status ( playerid, false ) ;

			static const _str [ ] = "* [ROBBERY] %s[%d] покинул(а) игру, если игрок не зайдёт в течении %d минут, то ограбление будет прервано!" ;
			new scm_string [ sizeof _str + 24 + 4 ] ;
			format ( scm_string, sizeof scm_string, _str, p_info [ playerid ] [ name ], playerid, MAX_BANK_DISCONNECT ) ;
			robbery_message ( _team, col_lblue, scm_string ) ;
			return 1 ;
		}
		else
		{
		    static const _str [ ] = "* [ROBBERY] %s[%d] покинул(а) игру, ограбление прервано!" ;
			new scm_string [ sizeof _str + 24 + 4 ] ;
			format ( scm_string, sizeof scm_string, _str, p_info [ playerid ] [ name ], playerid ) ;
			robbery_message ( _team, col_lblue, scm_string ) ;
		}
	}
	else if ( type == 2 )
	{
	    bank_team_death [ _team ] ++ ;
		if ( bank_team_death [ _team ] >= MAX_BANK_DEATH )
		{
		    static const _str [ ] = "* [ROBBERY] %s[%d] погиб(ла), ограбление прервано!" ;
		    new scm_string [ sizeof _str + 24 + 4 ] ;
			format ( scm_string, sizeof scm_string, _str, p_info [ playerid ] [ name ], playerid ) ;
			robbery_message ( _team, col_lblue, scm_string ) ;
		}
		else
		{
		    static const _str [ ] = "* [ROBBERY] %s[%d] погиб(ла), если член команды умрёт ещё %d раз(а), то ограбление будет прервано!" ;
		    new scm_string [ sizeof _str + 24 + 4 + 2 ] ;
			format ( scm_string, sizeof scm_string, _str, p_info [ playerid ] [ name ], playerid, MAX_BANK_DEATH - bank_team_death [ _team ] ) ;
			robbery_message ( _team, col_lblue, scm_string ) ;
		    return 1 ;
		}
	}
	else if ( type == 3 )
	{
	    static const _str [ ] = "* [ROBBERY] Ограбление успешно завершено! Вы получили: %d"valute_title"." ;
	    new scm_string [ sizeof _str + 11 ] ;
		format ( scm_string, sizeof scm_string, _str, floatround ( bank_robbery_money [ _team ] / 4 ) ) ;
		robbery_message ( _team, col_lblue, scm_string ) ;
	}
	else if ( type == 4 )
	{
		robbery_message ( _team, col_lblue, !"* [ROBBERY] Один из членов команды не успел вернуться в игру, ограбление прервано!" ) ;
	}

	if ( playerid != INVALID_PLAYER_ID )
	{
		p_t_info [ playerid ] [ t_robbery ] = -1 ;
		robbery_td_status ( playerid, false ) ;

		if ( steal_timer [ playerid ] != -1 )
	  	{
	   		KillTimer ( steal_timer [ playerid ] ) ;
	     	steal_timer [ playerid ] = -1 ;
	   	}

		if ( IsPlayerAttachedObjectSlotUsed ( playerid, 1 ) ) RemovePlayerAttachedObject ( playerid, 1 ) ;
	}

	if ( bank_vehicle [ _team ] != INVALID_VEHICLE_ID )
	{
		DestroyVehicle ( bank_vehicle [ _team ], 76 ) ;
		bank_vehicle [ _team ] = INVALID_VEHICLE_ID ;
	}

 	foreach(new i: robbery_team[_team])
   	{
   	    if ( type == 3 )
   	    {
   	        p_info [ i ] [ robbery_coldown ] = 10 ;
			update_int_sql ( i, "u_robbery_coldown", 10 ) ;
   	    }

    	p_t_info [ i ] [ t_robbery ] = -1 ;
	    robbery_td_status ( i, false ) ;

	    if ( bank_vehicle_gz [ _team ] != -1 ) GangZoneHideForPlayer ( i, bank_vehicle_gz [ _team ] ) ;

	    if ( steal_timer [ i ] != -1 )
	 	{
	  		KillTimer ( steal_timer [ i ] ) ;
	     	steal_timer [ i ] = -1 ;
	   	}

	   	if ( IsPlayerAttachedObjectSlotUsed ( i, 1 ) ) RemovePlayerAttachedObject ( i, 1 ) ;
	}

	if ( bank_vehicle_gz [ _team ] != -1 )
	{
		GangZoneDestroy ( bank_vehicle_gz [ _team ] ) ;
		bank_vehicle_gz [ _team ] = -1 ;
	}

	if ( bank_robbery_timer [ _team ] != -1 )
	{
	    KillTimer ( bank_robbery_timer [ _team ] ) ;
    	bank_robbery_timer [ _team ] = -1 ;
	}
	bank_robbery_money [ _team ] =
	bank_robbery_time [ _team ] =
	bank_progress [ _team ] =
	bank_team_death [ _team ] = 0 ;

	for ( new i = 0 ; i < 4 ; i ++ )
 	{
		bank_user_id [ _team ] [ i ] = -1 ;
	}
	bank_disconnect_time [ _team ] = -1 ;

	if ( type == 3 ) bank_status [ _team ] = 2 ;
	else bank_status [ _team ] = 3, bank_time_cd [ _team ] = 0 ;

	bank_gz [ _team ] = -1 ;

	Iter_Clear(robbery_team[_team]);
	return 1 ;
}

callback: timer_bank_robbery ( team_robbery )
{
    if ( bank_robbery_time [ team_robbery ] > 0 )
   	{
    	bank_robbery_time [ team_robbery ] -- ;
     	if ( bank_robbery_time [ team_robbery ] == 1 )
      	{
      	    static const _str [ ] = "* [ROBBERY] Пора валить! Вы украли %d"valute_title". Отвезите эти деньги туда, где всё начиналось." ;
       		new scm_string [ sizeof _str + 11 ] ;
			format ( scm_string, sizeof scm_string, _str, bank_robbery_money [ team_robbery ] ) ;
			robbery_message ( team_robbery, col_lblue, scm_string ) ;
   		}

       	new scm_string [ 24 ] ;
       	format ( scm_string, sizeof scm_string, "~r~%s", convert_time ( bank_robbery_time [ team_robbery ], TYPE_TIME_SECOND ) ) ;
     	foreach(new p: robbery_team[team_robbery])
      	{
			PlayerTextDrawSetString ( p, robbery_ptd [ p ] [ 12 ], scm_string ) ;

			if ( bank_robbery_time [ team_robbery ] == 1 )
			{
				if ( steal_timer [ p ] != -1 )
  				{
   					KillTimer ( steal_timer [ p ] ) ;
	     			steal_timer [ p ] = -1 ;
			   	}
			}
   		}
   	}
	return 1 ;
}

callback: steal_bank_money ( playerid )
{
    new t_string [ 14 ] ;

	new _bank_money = random ( 500 ) + 100, _team = p_t_info [ playerid ] [ t_robbery ] ;

    bank_robbery_money [ _team ] += _bank_money ;
    format ( t_string, sizeof t_string, "%d$", bank_robbery_money [ _team ] ) ;

	foreach(new i: robbery_team[_team])
	{
		PlayerTextDrawSetString ( i, robbery_ptd [ i ] [ 13 ], t_string ) ;
	}
	return 1 ;
}

stock show_hotel_window ( playerid )
{
    show_dialog ( playerid, d_hotel_window, DIALOG_STYLE_LIST, "{"#cBHD"}Отель", "{"#cBL"}1.{ffffff} Снять номер\n{"#cBL"}2.{ffffff} Оплатить номер\n{"#cGRDialog"}Отказаться от номера", "Выбрать", "Закрыть" ) ;
	return 1 ;
}

stock show_hotel ( playerid )
{
    global_string [ 0 ] = EOS ;

    new _b_id = GetPVarInt ( playerid, "p_biz_id" ) ;
	new count_room = 0,
		_price = b_price_market [ _b_id ] [ 0 ] ;

	new line_string [ 59 + 4 + 15 + 4 ] ;

	strcat ( global_string, "{"#cBL"}Номер комнаты:\t{"#cBL"}Статус:\t{"#cBL"}Стоимость:\n" ) ;
   	for ( new i = 0 ; i < hotel_count ; i ++ )
	{
   		if ( b_info [ _b_id - 1 ] [ b_id ] != hotel_info [ i ] [ h_biz ] ) continue ;

		set_player_listitem_values ( playerid, count_room, i ) ;

		count_room ++ ;

   		format ( line_string, sizeof line_string, "{"#cBL"}№%d.{"#cWH"}\t%s\t{"#cGN"}%d"valute_title_" {"#cWH"}за сутки\n", hotel_info [ i ] [ h_desc_id ], ( hotel_info [ i ] [ h_owner ] == -1 ) ? ( "{"#cGN"}Свободен" ) : ( "{"#cRD"}Занят" ), _price ) ;
		strcat ( global_string, line_string ) ;
	}
	show_dialog ( playerid, d_hotel, DIALOG_STYLE_TABLIST_HEADERS, "{"#cBHD"}Отель", global_string, "Выбрать", "Закрыть" ) ;
	return 1 ;
}

stock makeadmin_callback ( playerid, targetid, admin_level )
{
	if ( admin_info [ playerid ] [ admin ] <= admin_info [ targetid ] [ admin ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете изменить уровень данного администратора." ) ;
	if ( admin_info [ targetid ] [ admin ] < 1 )
	{
		if ( admin_level == 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не является администратором." ) ;
		else
		{
		    if ( admin_info [ playerid ] [ admin ] == admin_level ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете выдать такой же уровень, как и у Вас." ) ;
			if ( p_info [ targetid ] [ blocked_adm ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данному игроку закрыта возможность вставать на пост администратора (Admin Block)." ) ;
			if ( p_info [ targetid ] [ blocked_leader ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данному игроку закрыта возможность вставать на пост администратора (Leader Block)." ) ;
			// if ( p_info [ targetid ] [ hour_played ] < FIVE_HOUR_PLAYED && admin_info [ playerid ] [ admin ] < 8 && admin_info [ playerid ] [ dostup ] [ 5 ] != 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не отыграл 5 часов." ) ;

            if ( reload_admin_warning ( playerid, "/makeadmin" ) ) return 1 ;

           	if ( admin_info [ playerid ] [ admin ] < 8 && admin_info [ playerid ] [ dostup ] [ 5 ] != 1 && admin_level > 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Назначать можно только на первый уровень." ) ;
            if ( admin_level >= 3 )
			{
				if ( reload_admin_warning ( playerid, "/makeadmin +3 lvl" ) ) return 1 ;
			}

			admin_info [ targetid ] [ last_level ] = gettime ( ) ;

			new sql_string [ 170 + ( 3 * 9 ) + MAX_PLAYER_NAME ] ;
			format ( sql_string, sizeof sql_string, "INSERT INTO `users_admins`(`u_a_id`, `u_a_name`, `u_a_level`, `u_a_issued`, `u_a_dostup`, `u_a_last_level`) VALUES ('%d', '%s', '%d', NOW(), '0|0|1|1|1|0','%d')",
			p_info [ targetid ] [ id ], p_info [ targetid ] [ name ], admin_level, gettime ( ) ) ;
			mysql_tquery ( sql_connection, sql_string ) ;

			admin_info [ targetid ] [ player_admin ] = true ;

			format ( sql_string, 128, "Вы назначили %s на %d уровень администратора.", p_info [ targetid ] [ name ], admin_level ) ;
			SendClientMessage ( playerid, col_lblue, sql_string ) ;

			format ( sql_string, 128, "%s назначил Вас на %d уровень администратора.", p_info [ playerid ] [ name ], admin_level ) ;
			SendClientMessage ( targetid, col_lblue, sql_string ) ;

			SendClientMessage ( targetid, col_lblue, !"Введите /alogin для авторизации в админ панель." ) ;

			format(sql_string, 98, "%s выдал ADMLVL %s (%d)", p_info [ playerid ] [ name ], p_info [ targetid ] [ name ], admin_level);
			WriteLog(playerid, TYPE_LOG_ADMIN, sql_string);

			for ( new i = 1 ; i < 5 ; i ++ )
			    admin_info [ targetid ] [ dostup ] [ i ] = 1 ;

            admin_info [ targetid ] [ dostup ] [ 0 ] =
            admin_info [ targetid ] [ dostup ] [ 1 ] =
            admin_info [ targetid ] [ dostup ] [ 5 ] = 0 ;

			callcmd::alogin ( playerid ) ;
		}
	}
	else
	{
		if ( admin_level == 0 )
		{
			static const _str [ ] = "DELETE FROM `users_admins` WHERE `u_a_id` = '%d' LIMIT 1" ;
			new sql_string [ sizeof _str + ( MAX_PLAYER_NAME * 2 ) ] ;
			format ( sql_string, sizeof sql_string, _str, p_info [ targetid ] [ id ] ) ;
			mysql_tquery ( sql_connection, sql_string ) ;

			if ( reload_admin_warning ( playerid, "/makeadmin" ) ) return 1 ;

			if ( admin_info [ targetid ] [ admin ] != 0 ) remove_admin ( targetid ) ;
			format ( sql_string, sizeof sql_string, "Вы успешно сняли %s с должности администратора.", p_info [ targetid ] [ name ] ) ;
			SendClientMessage ( playerid, col_lblue, sql_string ) ;

			admin_info [ targetid ] [ player_admin ] = false ;

			format ( sql_string, sizeof sql_string, "%s снял ADM %s", p_info [ playerid ] [ name ], p_info [ targetid ] [ name ] ) ;
			WriteLog ( playerid, TYPE_LOG_ADMIN, sql_string ) ;
		}
		else
		{
		    if ( admin_info [ playerid ] [ admin ] == admin_level )
				return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете выдать такой же уровень, как и у Вас." ) ;

			// if ( p_info [ targetid ] [ hour_played ] < FIVE_HOUR_PLAYED && admin_info [ playerid ] [ admin ] < 8 && admin_info [ playerid ] [ dostup ] [ 5 ] != 1 )
				// return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не отыграл 5 часов." ) ;

            if ( reload_admin_warning ( playerid, "/makeadmin" ) ) return 1 ;

            if ( admin_level > admin_info [ targetid ] [ admin ] )
            {
                if ( admin_info [ playerid ] [ admin ] < 8 && admin_info [ playerid ] [ dostup ] [ 5 ] != 1 && admin_info [ targetid ] [ all_report ] + admin_info [ targetid ] [ report ] < admin_level * 100 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Для повышения администратора у него должно быть ответов 'новый уровень * 100'." ) ;
               	if ( admin_info [ playerid ] [ admin ] < 8 && admin_info [ playerid ] [ dostup ] [ 5 ] != 1 && GetElapsedTime ( gettime ( ), admin_info [ targetid ] [ last_level ], CONVERT_TIME_TO_DAYS ) < 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Повышать администратора можно раз в сутки." ) ;
                if ( admin_info [ playerid ] [ admin ] < 8 && admin_info [ playerid ] [ dostup ] [ 5 ] != 1 && admin_level - admin_info [ targetid ] [ admin ] > 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Повышать можно только на один уровень в сутки." ) ;
				if ( admin_level - admin_info [ targetid ] [ admin ] >= 3 )
				{
					if ( reload_admin_warning ( playerid, "/makeadmin +3 lvl" ) ) return 1 ;
				}
            }

            admin_info [ targetid ] [ last_level ] = gettime ( ) ;

			new sql_string [ 102 + ( 3 * 9 ) ] ;
			format ( sql_string, sizeof sql_string, "UPDATE `users_admins` SET `u_a_level` = '%d', `u_a_last_level` = '%d' WHERE `u_a_id` = '%d' LIMIT 1",
			admin_level, gettime ( ), p_info [ targetid ] [ id ] ) ;
			mysql_tquery ( sql_connection, sql_string ) ;

			admin_info [ targetid ] [ admin ] = admin_level ;

			format ( sql_string, 98, "Вы назначили %s на %d уровень администратора.", p_info [ targetid ] [ name ], admin_level ) ;
			SendClientMessage ( playerid, col_lblue, sql_string ) ;

			format ( sql_string, 98, "%s назначил Вас на %d уровень администратора.", p_info [ playerid ] [ name ], admin_level ) ;
			SendClientMessage ( targetid, col_lblue, sql_string ) ;

			format(sql_string, 98, "%s выдал ADMLVL %s (%d)", p_info [ playerid ] [ name ], p_info [ targetid ] [ name ], admin_level);
			WriteLog(playerid, TYPE_LOG_ADMIN, sql_string);
		}
	}
	return 1 ;
}

stock nextVehicleCarShop ( playerid, bool: isNext, bool: isFirst )
{
	p_t_info [ playerid ] [ last_alt ] = GetTickCount ( ) ;

	new classId = GetPlayerAutoSalonData ( playerid, PAS_SELECTED_AUTO_SALON ) ;
	if ( ! isFirst )
	{
		if ( isNext )
		{
			if ( ++ GetPlayerAutoSalonData ( playerid, PAS_SELECTED_CAR ) >= g_auto_salon_max_vehicles [ classId ] - 1 )
				SetPlayerAutoSalonData ( playerid, PAS_SELECTED_CAR, 0 ) ;
		}
		else
		{
			if ( -- GetPlayerAutoSalonData ( playerid, PAS_SELECTED_CAR ) < 0 )
				SetPlayerAutoSalonData ( playerid, PAS_SELECTED_CAR, g_auto_salon_max_vehicles [ classId ] - 1 ) ;
		}
	}

    new select_car = GetPlayerAutoSalonData ( playerid, PAS_SELECTED_CAR ),
    	modelid = AutoSalonVehicleModelID ( select_car, classId ) ;

    if ( IsValidVehicle ( GetPlayerAutoSalonData ( playerid, PAS_CREATED_CAR ) ) )
        DestroyVehicle ( GetPlayerAutoSalonData ( playerid, PAS_CREATED_CAR ), 1510 ) ;

	if ( select_car != -1 )
    {
        SetPlayerAutoSalonData ( playerid, PAS_CREATED_CAR, CreateVehicle ( modelid, t_shop_pos [ classId - 1 ] [ 0 ], t_shop_pos [ classId - 1 ] [ 1 ], t_shop_pos [ classId - 1 ] [ 2 ], t_shop_pos [ classId - 1 ] [ 3 ], 0, 0, -1 ) ) ;

        new vehicleid = GetPlayerAutoSalonData ( playerid, PAS_CREATED_CAR ) ;
        SetPlayerAutoSalonData ( playerid, PAS_SELECTED_COLOR_R, 0 ) ;
        SetPlayerAutoSalonData ( playerid, PAS_SELECTED_COLOR_G, 0 ) ;
        SetPlayerAutoSalonData ( playerid, PAS_SELECTED_COLOR_B, 0 ) ;

        SetVehicleVirtualWorld ( vehicleid, playerid + 2 ) ;
        LinkVehicleToInterior ( vehicleid, last_int [ playerid ] ) ;

		set_world ( playerid, playerid + 2 ) ;

        p_t_info [ playerid ] [ p_tp_immune_time ] = 4 ;
		SetPlayerPos ( playerid, car_shop_player_position [ classId - 1 ] [ 0 ], car_shop_player_position [ classId - 1 ] [ 1 ], car_shop_player_position [ classId - 1 ] [ 2 ] ) ;

		SetPlayerCameraPos ( playerid,  t_shop_pos [ classId - 1 ] [ 4 ],
										t_shop_pos [ classId - 1 ] [ 5 ],
										t_shop_pos [ classId - 1 ] [ 6 ] ) ;

		SetPlayerCameraLookAt ( playerid, 	t_shop_pos [ classId - 1 ] [ 0 ],
											t_shop_pos [ classId - 1 ] [ 1 ],
											t_shop_pos [ classId - 1 ] [ 2 ] ) ;
    }

	update_car_showroom ( playerid ) ;
	return true ;
}

stock initCarShopModel ( playerid, modelId )
{
	p_t_info [ playerid ] [ last_alt ] = GetTickCount ( ) ;

    if ( IsValidVehicle ( GetPlayerAutoSalonData ( playerid, PAS_CREATED_CAR ) ) )
        DestroyVehicle ( GetPlayerAutoSalonData ( playerid, PAS_CREATED_CAR ), 1510 ) ;

	new classId = GetPlayerAutoSalonData ( playerid, PAS_SELECTED_AUTO_SALON ) ;
	SetPlayerAutoSalonData ( playerid, PAS_CREATED_CAR, CreateVehicle ( modelId, t_shop_pos [ classId - 1 ] [ 0 ], t_shop_pos [ classId - 1 ] [ 1 ], t_shop_pos [ classId - 1 ] [ 2 ], t_shop_pos [ classId - 1 ] [ 3 ], 0, 0, -1 ) ) ;

	new vehicleid = GetPlayerAutoSalonData ( playerid, PAS_CREATED_CAR ) ;
    SetPlayerAutoSalonData ( playerid, PAS_SELECTED_COLOR_R, 0 ) ;
    SetPlayerAutoSalonData ( playerid, PAS_SELECTED_COLOR_G, 0 ) ;
    SetPlayerAutoSalonData ( playerid, PAS_SELECTED_COLOR_B, 0 ) ;

    SetVehicleVirtualWorld ( vehicleid, playerid + 2 ) ;
    LinkVehicleToInterior ( vehicleid, last_int [ playerid ] ) ;

	set_world ( playerid, playerid + 2 ) ;

    p_t_info [ playerid ] [ p_tp_immune_time ] = 4 ;
	SetPlayerPos ( playerid, car_shop_player_position [ classId - 1 ] [ 0 ], car_shop_player_position [ classId - 1 ] [ 1 ], car_shop_player_position [ classId - 1 ] [ 2 ] ) ;

	SetPlayerCameraPos ( playerid,  t_shop_pos [ classId - 1 ] [ 4 ],
									t_shop_pos [ classId - 1 ] [ 5 ],
									t_shop_pos [ classId - 1 ] [ 6 ] ) ;

	SetPlayerCameraLookAt ( playerid, 	t_shop_pos [ classId - 1 ] [ 0 ],
										t_shop_pos [ classId - 1 ] [ 1 ],
										t_shop_pos [ classId - 1 ] [ 2 ] ) ;

	update_car_showroom ( playerid ) ;
	return true ;
}

stock exit_carbuy ( playerid )
{
	show_packet_car_showroom ( playerid, 5, "" ) ;
	clear_carbuy ( playerid ) ;
	return 1 ;
}

stock clear_carbuy ( playerid )
{
	new classId = GetPlayerAutoSalonData ( playerid, PAS_SELECTED_AUTO_SALON ) ;

    if ( IsValidVehicle ( GetPlayerAutoSalonData ( playerid, PAS_CREATED_CAR ) ) )
        DestroyVehicle ( GetPlayerAutoSalonData ( playerid, PAS_CREATED_CAR ), 1512 ) ;

	SetCameraBehindPlayer ( playerid ) ;
	ClearPlayerAutoSalonInfo ( playerid ) ;
	set_pos ( playerid, player_exit_salon [ classId - 1 ] [ 0 ], player_exit_salon [ classId - 1 ] [ 1 ], player_exit_salon [ classId - 1 ] [ 2 ], player_exit_salon [ classId - 1 ] [ 3 ], last_int [ playerid ], last_virt [ playerid ] ) ;
	return 1 ;
}

stock exit_test_drive ( playerid )
{
	show_car_showroom ( playerid ) ;
	nextVehicleCarShop ( playerid, true, true ) ;
	return 1 ;
}

stock exit_tuning ( playerid, _biz_id )
{
    onServerDestroy ( playerid, UI_TIRE_SHOP ) ;

    new _v_id = GetPlayerVehicleID ( playerid ) ;

    if ( _v_id > 0 )
    {
        if ( veh_info [ _v_id - 1 ] [ v_type ] == vehicle_type_player )
        {
            SaveComponentToOwnableCar ( _v_id, "users_vehicles_component" ) ;
            SaveVehicleHandling ( _v_id, "users_vehicles_handling" ) ;
            SaveTuningToOwnableCar ( _v_id, "users_vehicles_tuning" ) ;
        }
        else if ( veh_info [ _v_id - 1 ] [ v_type ] == vehicle_type_family )
        {
            SaveComponentToOwnableCar ( _v_id, "familys_vehicles_component" ) ;
            SaveVehicleHandling ( _v_id, "familys_vehicles_handling" ) ;
            SaveTuningToOwnableCar ( _v_id, "familys_vehicles_tuning" ) ;
        }
    }

	new _pos_id = 0 ;
	for ( new i = 0 ; i < MAX_BUSINESS_TUNING ; i ++ )
	{
	    if ( tuning_info [ i ] [ t_b_id ] != _biz_id ) continue ;

	    _pos_id = i ;
	    break ;
	}

	SetVehiclePos ( _v_id, tuning_info [ _pos_id ] [ t_exit_pos ] [ 0 ], tuning_info [ _pos_id ] [ t_exit_pos ] [ 1 ], tuning_info [ _pos_id ] [ t_exit_pos ] [ 2 ] ) ;
	SetVehicleZAngle ( _v_id, tuning_info [ _pos_id ] [ t_exit_pos ] [ 3 ] ) ;
	set_interior ( playerid, 0 ) ;
	set_world ( playerid, 0 ) ;
	LinkVehicleToInterior ( _v_id, 0 ) ;
	SetVehicleVirtualWorld ( _v_id, 0 ) ;
	SetPlayerArmedWeapon ( playerid, 0 ) ;
	PutPlayerInVehicle ( playerid, _v_id, 0 ) ;

	OnVehicleIteration ( _v_id ) ;
	return 1 ;
}

stock show_remove_millage ( playerid )
{
	global_string [ 0 ] = EOS ;

	new _v_id = GetPlayerVehicleID ( playerid ), _scm_eng [ 20 ], Float: _fuel = 0.03 ;

	_fuel = _fuel + ( veh_info [ _v_id - 1 ] [ v_millage ] / 100000 ) ;

	if ( veh_info [ _v_id - 1 ] [ v_millage ] < 500 ) format ( _scm_eng, sizeof _scm_eng, "{"#cGN"}Идеальное" ) ;
	else if ( veh_info [ _v_id - 1 ] [ v_millage ] > 499 && veh_info [ _v_id - 1 ] [ v_millage ] < 2500 ) format ( _scm_eng, sizeof _scm_eng, "{"#cLY"}Среднее" ) ;
	else format ( _scm_eng, sizeof _scm_eng, "{"#cRD"}Плохое" ) ;

	new Float: _v_millage = floatround ( veh_info [ _v_id - 1 ] [ v_millage ] * 25 ) / 100 ;
	if ( _v_millage > 1000 ) _v_millage = 1000.0 ;
	if ( _v_millage < veh_info [ _v_id - 1 ] [ v_legal_millage ] ) _v_millage = veh_info [ _v_id - 1 ] [ v_legal_millage ] ;

	format ( global_string, 600, "{"#cBL"}** Техническое обслуживание двигателя **\n\n\
								{"#cWH"}На данный момент состояние Вашего двигателя: %s\n\
								{"#cWH"}Пробег транспортного средства: {"#cWV"}%.1f км\n\
								{"#cWH"}Скрутить можно до: {"#cWV"}%.1f км\n\
								{"#cWH"}Расход топлива: {"#cWV"}%.3f л. на 1 км\n\
								{"#cWH"}Стоимость скрутки пробега за 1 км: {"#cGN"}%d"valute_title_"\n\n\
								{"#cWH"}За каждые 100 км пробега скорость т/с падает на 1 единицу.\n\
								{"#cWH"}Также увеличивается расход бензина за 1 км.\n\
								{"#cWH"}Рекомендуем проводить ТО двигателя каждые 1.000 км.\n\n\
								{"#cGRDialog"}* Укажите количество скручиваемого пробега:", _scm_eng, veh_info [ _v_id - 1 ] [ v_millage ], _v_millage, _fuel, engine_remove_millage ) ;
	show_dialog ( playerid, d_remove_millage, DIALOG_STYLE_INPUT, "{"#cBHD"}Информацие о двигателе", global_string, "Скрутить", "Назад" ) ;
	return 1 ;
}

stock veh_prise_create ( playerid, ts_id, _model )
{
    new ts_spawn_slot = random ( 5 ) ;

    new	veh_id = CreateVehicle ( _model, t_shop_respawn [ ts_id ] [ ts_spawn_slot ] [ 0 ],
												t_shop_respawn [ ts_id ] [ ts_spawn_slot ] [ 1 ],
												t_shop_respawn [ ts_id ] [ ts_spawn_slot ] [ 2 ],
												t_shop_respawn [ ts_id ] [ ts_spawn_slot ] [ 3 ],
												1, 1, SPAWN_TIME_PLAYER_VEHICLE ) ;

	veh_info [ veh_id - 1 ] [ v_price ] = GetModelPrice ( _model ) ;

	new query_string [ 300 ] ;
	mysql_format ( sql_connection, query_string, sizeof query_string, "INSERT INTO `users_vehicles`(`v_model`,`v_owner`,`v_color_1`,`v_color_2`,`v_pos_x`,`v_pos_y`,`v_pos_z`,`v_pos_a`,`v_buydate`,`v_gps_tracker`,`v_price`) VALUES ('%d','%i','1','1','%f','%f','%f','%f',NOW(),'1','%d')",
    _model,
	p_info [ playerid ] [ id ],
	t_shop_respawn [ ts_id ] [ ts_spawn_slot ] [ 0 ],
	t_shop_respawn [ ts_id ] [ ts_spawn_slot ] [ 1 ],
	t_shop_respawn [ ts_id ] [ ts_spawn_slot ] [ 2 ],
	t_shop_respawn [ ts_id ] [ ts_spawn_slot ] [ 3 ],
	veh_info [ veh_id - 1 ] [ v_price ] ) ;
	mysql_tquery ( sql_connection, query_string, "create_vehicle_callback", "d", veh_id ) ;

	p_info [ playerid ] [ p_veh_count ] ++ ;

	veh_info [ veh_id - 1 ] [ v_type ] = vehicle_type_player ;
	veh_info [ veh_id - 1 ] [ v_vehicle ] = veh_id ;
	format ( veh_info [ veh_id - 1 ] [ v_plate ], 12, "Transit" ) ;
	veh_info [ veh_id - 1 ] [ v_pos ] [ 0 ] = t_shop_respawn [ ts_id ] [ ts_spawn_slot ] [ 0 ] ;
	veh_info [ veh_id - 1 ] [ v_pos ] [ 1 ] = t_shop_respawn [ ts_id ] [ ts_spawn_slot ] [ 1 ] ;
	veh_info [ veh_id - 1 ] [ v_pos ] [ 2 ] = t_shop_respawn [ ts_id ] [ ts_spawn_slot ] [ 2 ] ;
	veh_info [ veh_id - 1 ] [ v_pos ] [ 3 ] = t_shop_respawn [ ts_id ] [ ts_spawn_slot ] [ 3 ] ;

	veh_info [ veh_id - 1 ] [ v_fuel ] = 100.0 ;
	veh_info [ veh_id - 1 ] [ v_millage ] = 0.0 ;
	veh_info [ veh_id - 1 ] [ v_legal_millage ] = 0.0 ;
	veh_info [ veh_id - 1 ] [ v_fine ] = 3 ;
	veh_info [ veh_id - 1 ] [ v_gps_tracker ] = 1 ;

    veh_plate ( veh_id ) ;

	MODEL_INFO [ _model ] [ MODEL_COUNT ] += 1 ;
	set_model_count ( _model, MODEL_INFO [ _model ] [ MODEL_COUNT ] ) ;

	new engine, lights, alarm, doors, bonnet, boot, objective ;
	veh_info [ veh_id - 1 ] [ v_locked ] = true ;
	GetVehicleParamsEx ( veh_id, engine, lights, alarm, doors, bonnet, boot, objective ) ;
	SetVehicleParamsEx ( veh_id, engine, lights, alarm, true, bonnet, boot, objective ) ;

	veh_info [ veh_id - 1 ] [ v_owner ] = p_info [ playerid ] [ id ] ;

	SetVehicleNumberPlate ( veh_info [ veh_id - 1 ] [ v_vehicle ], veh_info [ veh_id - 1 ] [ v_plate ] ) ;
	Iter_Add(player_vehicles[ playerid ], veh_info [ veh_id - 1 ] [ v_vehicle ] ) ;
	return 1 ;
}

callback: callback_fractions_profit_info ( playerid )
{
    new rows, fields;
	cache_get_data(rows, fields);

	if ( ! rows )
	{
	    page_count [ playerid ] = 0 ;
		callcmd::logs ( playerid ) ;
		return 1 ;
	}

	new _t_name [ 16 ], _t_date [ 16 ], _statistic [ 5 ], _statistic_minus [ 5 ] ;
	cache_get_field_content ( 0, "f_start_date", _t_name, sql_connection, 16 ) ;
	cache_get_field_content ( 0, "f_end_date", _t_date, sql_connection, 16 ) ;

	global_string [ 0 ] = EOS ;
	cache_get_field_content ( 0, "f_money_statistic", global_string ), sscanf ( global_string, "p<|>ddddd",
	_statistic [ 0 ], _statistic [ 1 ], _statistic [ 2 ], _statistic [ 3 ], _statistic [ 4 ] ) ;

    global_string [ 0 ] = EOS ;
	cache_get_field_content ( 0, "f_money_statistic_minus", global_string ), sscanf ( global_string, "p<|>ddddd",
	_statistic_minus [ 0 ], _statistic_minus [ 1 ], _statistic_minus [ 2 ], _statistic_minus [ 3 ], _statistic_minus [ 4 ] ) ;

