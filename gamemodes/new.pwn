	    case d_bank_progress:
	    {
	        if ( ! response ) return 1 ;
	        switch ( listitem )
	        {
	            case 0:
	            {
	                if ( bank_progress [ p_t_info [ playerid ] [ t_robbery ] ] > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Ваша команда уже достала план банка." ) ;

	                show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}План банка", "{"#cWH"}Вам нужно достать план банка!\n\nПлан банка есть в здании правительства.\nАрхитектор, который проектировал банк оставил копию.\n\nВам нужно найти этот план и украть его.", "Закрыть", "" ) ;

                    SetPlayerRaceCheckpoint ( playerid, 1, bank_progress_checkpoint [ 0 ] [ 0 ], bank_progress_checkpoint [ 0 ] [ 1 ], bank_progress_checkpoint [ 0 ] [ 2 ], 0.0, 0.0, 0.0, 2.0 ) ; // -2345.3489, 244.7435, 22.0339

					SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}[GPS] - Метка установлена." ) ;
					is_gps_used { playerid } = 1 ;
				}
				case 1:
	            {
	                if ( bank_progress [ p_t_info [ playerid ] [ t_robbery ] ] == 0 ) return 1 ;
	                if ( bank_progress [ p_t_info [ playerid ] [ t_robbery ] ] > 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Ваша команда уже достала экипировку." ) ;

	                show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Экипировка", "{"#cWH"}Вам нужно достать экипировку!\n\nХодит слух, что на военных базах можно украсть броню.\nОтправляйтесь на одну из военных баз и украдите броню.", "Закрыть", "" ) ;

                    if ( random ( 2 ) == 0 ) SetPlayerRaceCheckpoint ( playerid, 1, bank_progress_checkpoint [ 1 ] [ 0 ], bank_progress_checkpoint [ 1 ] [ 1 ], bank_progress_checkpoint [ 1 ] [ 2 ], 0.0, 0.0, 0.0, 2.0 ) ; // -2345.3489, 244.7435, 22.0339
					else SetPlayerRaceCheckpoint ( playerid, 1, bank_progress_checkpoint [ 2 ] [ 0 ], bank_progress_checkpoint [ 2 ] [ 1 ], bank_progress_checkpoint [ 2 ] [ 2 ], 0.0, 0.0, 0.0, 2.0 ) ; // -2345.3489, 244.7435, 22.0339

					SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}[GPS] - Метка установлена." ) ;
					is_gps_used { playerid } = 1 ;
				}
				case 2:
				{
				    if ( bank_progress [ p_t_info [ playerid ] [ t_robbery ] ] == 1 ) return 1 ;
				    if ( bank_progress [ p_t_info [ playerid ] [ t_robbery ] ] > 2 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Ваша команда уже достала оружие." ) ;

				    show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Оружие", "{"#cWH"}Вам нужно достать оружие!\n\nОружие можно либо купить, либо собрать...\nРешать Вам, как его доставать.", "Закрыть", "" ) ;
				}
				case 3:
				{
				    if ( bank_progress [ p_t_info [ playerid ] [ t_robbery ] ] == 2 ) return 1 ;
				    if ( bank_progress [ p_t_info [ playerid ] [ t_robbery ] ] > 3 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Ваша команда уже достала транспорт." ) ;
					if ( bank_vehicle_gz [ p_t_info [ playerid ] [ t_robbery ] ] != -1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Местоположение транспорта уже отмечено у Вас на карте." ) ;

                    show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Транспорт", "{"#cWH"}Вам нужно достать транспорт!\n\nНа карте отмечен чёрный квадрат,\nпредположительно, в этом квадрате находится транспорт.\n\n{"#cGRDialog"}* Вам понадобяться отмычки.", "Закрыть", "" ) ;

					new _team = p_t_info [ playerid ] [ t_robbery ] ;
                    if ( bank_vehicle_gz [ _team ] != -1 )
				    {
				        foreach(new i: robbery_team[_team]) GangZoneHideForPlayer ( i, bank_vehicle_gz [ _team ] ) ;
				        GangZoneDestroy ( bank_vehicle_gz [ _team ] ) ;
						bank_vehicle_gz [ _team ] = -1 ;
				    }

				    if ( bank_gz [ _team ] == -1 ) bank_gz [ _team ] = random ( MAX_BANK_GZ ) ;
					if ( bank_vehicle [ _team ] == INVALID_VEHICLE_ID )
					{
					    new _random = bank_gz [ _team ] ;
						bank_vehicle [ _team ] = CreateVehicle ( 428, bank_vehicle_pos [ _random ] [ 0 ], bank_vehicle_pos [ _random ] [ 1 ], bank_vehicle_pos [ _random ] [ 2 ], bank_vehicle_pos [ _random ] [ 3 ], random ( 126 ), random ( 126 ), -1 ) ;

						new vehicle_id = bank_vehicle [ _team ] ;
						veh_info [ vehicle_id - 1 ] [ v_owner ] = -1 ;
						veh_info [ vehicle_id - 1 ] [ v_type ] = vehicle_type_jackcar ;
						veh_info [ vehicle_id - 1 ] [ v_sell_price ] = 0 ;

						veh_info [ vehicle_id - 1 ] [ v_now_pos ] [ 0 ] = bank_vehicle_pos [ _random ] [ 0 ] ;
						veh_info [ vehicle_id - 1 ] [ v_now_pos ] [ 1 ] = bank_vehicle_pos [ _random ] [ 1 ] ;

						new engine, lights, alarm, doors, bonnet, boot, objective ;

						veh_info [vehicle_id - 1 ] [ v_locked ] = true ;
						GetVehicleParamsEx ( vehicle_id, engine, lights, alarm, doors, bonnet, boot, objective ) ;
						SetVehicleParamsEx ( vehicle_id, engine, lights, alarm, true, bonnet, boot, objective ) ;
					}

					new Float: pos [ 4 ], Float: perv_pos [ 2 ] ;
                    find_mark_gz ( -1, bank_vehicle [ _team ], perv_pos [ 0 ], perv_pos [ 1 ] ) ;
                    get_gz_pos ( perv_pos [ 0 ]-float(-random(50)+random(50)), perv_pos [ 1 ]-float(-random(50)+random(50)), 80.0, pos [ 0 ], pos [ 1 ], pos [ 2 ], pos [ 3 ] ) ;
					bank_vehicle_gz [ _team ] = GangZoneCreate ( pos [ 0 ], pos [ 1 ], pos [ 2 ], pos [ 3 ] ) ;

					foreach(new i: robbery_team[_team]) GangZoneShowForPlayer ( i, bank_vehicle_gz [ _team ], 0x000000AA ) ;

					SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Местоположение определено и отмечено на карте." ) ;
					SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Откройте карту в настройках игры и ищите чёрный квадрат." ) ;
				}
				case 4:
				{
				    new _team = p_t_info [ playerid ] [ t_robbery ] ;
				    if ( bank_progress [ _team ] != 4 ) return 1 ;

					static const role_names [ 4 ] [ 32 ] =
					{
						"Координатор",
						"Техник",
						"Охранник",
						"Водитель"
					} ;

					static const letter_role [ 4 ] [ 4 ] =
					{
						"K",
						"T",
						"O",
						"B"
					} ;

					new scm_string [ 256 ] ;
				    format ( scm_string, sizeof scm_string, "{"#cWH"}Всё готово, теперь можно отправляться к банку!\n\n{"#cGRDialog"}* Банк: {"#cGN"}%s\n\n{"#cBL"}** Распределение ролей **\n", bank_names [ _team ] ) ;
				    strcat ( global_string, scm_string ) ;

					new _player_role = 0, _player_name [ 12 ] ;
				    foreach(new i: robbery_team[_team])
				    {
				        format ( scm_string, sizeof scm_string, "{"#cGRDialog"}- {"#cWH"}%s[%d] - {"#cGN"}%s\n", p_info [ i ] [ name ], i, role_names [ _player_role ] ) ;
				    	strcat ( global_string, scm_string ) ;

				    	format ( _player_name, 12, "%s", letter_role [ _player_role ] ) ;

						foreach(new j: robbery_team[_team])
						{
							PlayerTextDrawSetString ( j, robbery_ptd [ j ] [ 4 + _player_role ], _player_name ) ;
						}

						_player_role ++ ;
				    }
				    show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Ограбление", global_string, "Закрыть", "" ) ;
				}
	        }
	        return 1 ;
	    }
	    case d_bank_robbery:
	    {
	        if ( ! response ) return 1 ;

            if ( bank_status [ listitem ] != 3 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Ограбление на выбранный банк не доступно." ) ;
			if ( bank_time_cd [ listitem ] > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Банк не так давно уже был ограблен. Нужно подождать." ) ;

			if ( Iter_Count(robbery_team[listitem]) > 0 )
			{
				foreach(new i: robbery_team[listitem])
				{
				    if ( p_info [ playerid ] [ member ] != p_info [ i ] [ member ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данный банк для ограбления выбрала другая организация." ) ;

					break ;
				}
			}
			new scm_string [ 68 + MAX_PLAYER_NAME + 4 ] ;
			format ( scm_string, sizeof scm_string, "* [ROBBERY] %s[%d] присоединился(ась) к Вашей команде ограбления!", p_info [ playerid ] [ name ], playerid ) ;
			robbery_message ( listitem, col_lblue, scm_string ) ;

			Iter_Add ( robbery_team[listitem], playerid ) ;
			p_t_info [ playerid ] [ t_robbery ] = listitem ;

			SendClientMessage ( playerid, col_yellow, !"* Используйте /rwait для просмотра участников." ) ;

			new _plaeyrs = 0, _players_name [ 32 ] ;
			foreach(new i: robbery_team[listitem])
			{
			    if ( Iter_Count(robbery_team[listitem]) >= 4 )
				{
				    if ( _plaeyrs == 0 )
				    {
					    format ( scm_string, sizeof scm_string, "* [ROBBERY] Ограбление начинается! Вы будете грабить банк %s.", bank_names [ listitem ] ) ;
						robbery_message ( listitem, col_lblue, scm_string ) ;
						robbery_message ( listitem, col_lblue, !"* [ROBBERY] Используйте /ba_robbery для отслеживания задач." ) ;

						bank_status [ listitem ] = 1 ;
						bank_time_cd [ listitem ] = 3 ;
						bank_progress [ listitem ] = 0 ;
						step_bank_robbery ( listitem, bank_progress [ listitem ] ) ;
					}

					robbery_td_status ( i, true ) ;

					format ( _players_name, sizeof _players_name, "%s", p_info [ i ] [ name ] ) ;

					foreach(new j: robbery_team[listitem])
					{
						PlayerTextDrawSetString ( j, robbery_ptd [ j ] [ _plaeyrs ], _players_name ) ;
					}

					_plaeyrs ++ ;
				    continue ;
				}
			}
	        return 1 ;
		}
	    case d_boxing_invite:
		{
			if ( ! response ) return 1 ;
			new targetid ;
			if ( sscanf ( inputtext, "u", targetid ) ) return show_dialog ( playerid, d_boxing_invite, DIALOG_STYLE_INPUT, "{"#cBHD"}Спаринг", "{"#cGRDialog"}* Введёт некорректный ID игрока.\n\n{"#cWH"}Введите ID игрока, которого желаете вызвать на спарринг:\n\n", "Принять", "Назад" ) ;
			if ( ! IsPlayerConnected ( targetid ) || p_t_info [ targetid ] [ p_logged ] == false || targetid == playerid ) return show_dialog ( playerid, d_boxing_invite, DIALOG_STYLE_INPUT, "{"#cBHD"}Cпарринг", "{"#cGRDialog"}* Игрок не найден.\n\n{"#cWH"}Введите ID игрока, которого желаете вызвать на спарринг:", "Принять", "Назад" ) ;

			if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ targetid ][ p_pos ] [ 0 ], p_t_info [ targetid ][ p_pos ] [ 1 ], p_t_info [ targetid ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( targetid ) != GetPlayerVirtualWorld ( playerid ) )
				return show_dialog ( playerid, d_boxing_invite, DIALOG_STYLE_INPUT, "{"#cBHD"}Cпарринг", "{"#cGRDialog"}* Игрок слишком далеко.\n\n{"#cWH"}Введите ID игрока, которого желаете вызвать на спарринг:", "Принять", "Назад" ) ;
			if ( player_duel [ targetid ] [ duel_money ] != 0 ) return show_dialog ( playerid, d_boxing_invite, DIALOG_STYLE_INPUT, "{"#cBHD"}Cпарринг", "{"#cGRDialog"}* Данный игрок уже имеет приглашение.\n\n{"#cWH"}Введите ID игрока, которого желаете вызвать на спарринг:", "Принять", "Назад" ) ;

            player_duel [ targetid ] [ duel_player ] = playerid ;
            player_duel [ playerid ] [ duel_player ] = targetid ;
			show_dialog ( playerid, d_boxing_invite_money, DIALOG_STYLE_INPUT, "{"#cBHD"}Cпарринг", "{"#cWH"}Введите сумму, на которую желаете предложить спарринг:", "Принять", "Назад" ) ;

	        return 1 ;
		}
		case d_boxing_invite_money:
		{
			if ( ! response ) return show_dialog ( playerid, d_boxing_invite, DIALOG_STYLE_INPUT, "{"#cBHD"}Cпарринг", "{"#cWH"}Введите ID игрока, которого желаете вызвать на спарринг:", "Принять", "Назад" ) ;
			new money_count = strval ( inputtext ) ;
			if ( money_count < 1 || money_count > 100000) return show_dialog ( playerid, d_boxing_invite_money, DIALOG_STYLE_INPUT, "{"#cBHD"}Cпарринг", "{"#cGRDialog"}* Сумма должна быть от 1"valute_title_" до 100.000"valute_title_"\n\n{"#cWH"}Введите сумму, на которую желаете предложить спарринг:", "Принять", "Назад" ) ;
			if ( p_info [ playerid ] [ money ] < money_count ) return show_dialog ( playerid, d_boxing_invite_money, DIALOG_STYLE_INPUT, "{"#cBHD"}Cпарринг", "{"#cGRDialog"}* У Вас нет такого количества средств.\n\n{"#cWH"}Введите сумму, на которую желаете предложить спарринг:", "Принять", "Назад" ) ;

			new targetid = player_duel [ playerid ] [ duel_player ] ;
			player_duel [ targetid ] [ duel_money ] = money_count ;
			player_duel [ playerid ] [ duel_money ] = money_count ;

			player_duel [ playerid ] [ duel_on ] = true ;
			player_duel [ targetid ] [ duel_on ] = true ;

			new _dialog_string [ 144 ];
			format ( _dialog_string,sizeof ( _dialog_string ),"{"#cGInfo"}* {"#cWH"}Вы предложили {"#cGN"}%s {"#cWH"}спарринг на {"#cGN"}%d"valute_title_"", p_info [ targetid ] [ name ] , money_count ) ;
			SendClientMessage ( playerid, col_white, _dialog_string ) ;

			format ( _dialog_string, sizeof ( _dialog_string ),"{FFFFFF}%s вызывает Вас на спарринг на %d"valute_title".\n\n{"#cGRDialog"}* Вы согласны на спарринг?", p_info [ playerid ] [ name ], money_count ) ;
			show_dialog ( targetid, d_accept_boxing, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Cпарринг",_dialog_string, "Да", "Нет" ) ;
	        return 1 ;
		}
		case d_accept_boxing:
		{
			new opponent_id = player_duel [ playerid ] [ duel_player ] ;
			if ( ! response )
			{
				ClearPVars_Duel ( opponent_id ) ;
				ClearPVars_Duel ( playerid ) ;
				return 1 ;
			}
			if ( p_info [ playerid ] [ money ] < player_duel [ playerid ] [ duel_money ] )
			{
				ClearPVars_Duel ( opponent_id ) ;
				ClearPVars_Duel ( playerid ) ;

				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас недостаточно средств для принятия вызова." ) ;
				return 1 ;
			}
			if ( p_info [ opponent_id ] [ money ] < player_duel [ playerid ] [ duel_money ] )
			{
				ClearPVars_Duel ( opponent_id ) ;
				ClearPVars_Duel ( playerid ) ;

				SendClientMessage ( opponent_id, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас недостаточно средств для спаринга." ) ;
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока недостаточно средств для спаринга." ) ;
				return 1 ;
			}
			if ( ! IsPlayerConnected ( opponent_id ) )
			{
				ClearPVars_Duel ( playerid ) ;

				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок уже покинул игру." ) ;
				return 1 ;
			}
			if ( ! GetPVarInt ( playerid, "p_biz_id" ) ) return bad_exit ( playerid ) ;
			if ( ! GetPVarInt ( opponent_id, "p_biz_id" ) ) return bad_exit ( opponent_id ) ;

			boxing_opponent [ playerid ] = opponent_id ;
			boxing_opponent [ opponent_id ] = playerid ;

			give_money ( playerid, -player_duel [ playerid ] [ duel_money ] ) ;
			give_money ( boxing_opponent [ playerid ], -player_duel [ playerid ] [ duel_money ] ) ;
			insert_money_log ( playerid, INVALID_PLAYER_ID, player_duel [ playerid ] [ duel_money ], "спарринг ставка" ) ;
			insert_money_log ( boxing_opponent [ playerid ], INVALID_PLAYER_ID, player_duel [ playerid ] [ duel_money ], "спарринг ставка" ) ;

			set_pos ( playerid, boxing_spawn [ 0 ] [ 0 ], boxing_spawn [ 0 ] [ 1 ], boxing_spawn [ 0 ] [ 2 ], boxing_spawn [ 0 ] [ 3 ], 5, b_info [ GetPVarInt ( playerid, "p_biz_id" ) - 1 ] [ b_id ] + 1000 ) ;
			set_pos ( opponent_id, boxing_spawn [ 1 ] [ 0 ], boxing_spawn [ 1 ] [ 1 ], boxing_spawn [ 1 ] [ 2 ], boxing_spawn [ 1 ] [ 3 ], 5, b_info [ GetPVarInt ( opponent_id, "p_biz_id" ) - 1 ] [ b_id ] + 1000 ) ;

			#if defined Matreshka
			SetPlayerSkin ( playerid, 42 ) ;
            SetPlayerSkin ( opponent_id, 85 ) ;
			#else
			SetPlayerSkin ( playerid, 80 ) ;
            SetPlayerSkin ( opponent_id, 81 ) ;
            #endif

			set_health ( playerid, 100 ) ;
			set_health ( opponent_id, 100 ) ;

			for ( new i = 0 ; i < 12 ; i ++ )
			{
				duel_guns [ playerid ] [ i ] [ 0 ] = p_t_info [ playerid ] [ p_gun_slot ] [ i ] ;
				duel_guns [ playerid ] [ i ] [ 1 ] = p_t_info [ playerid ] [ p_gun_ammo ] [ i ] ;
				duel_guns [ opponent_id ] [ i ] [ 0 ] = p_t_info [ opponent_id ] [ p_gun_slot ] [ i ] ;
				duel_guns [ opponent_id ] [ i ] [ 1 ] = p_t_info [ opponent_id ] [ p_gun_ammo ] [ i ] ;
			}
			reset_player_weapon ( playerid ) ;
			reset_player_weapon ( opponent_id ) ;
	        return 1 ;
		}
	    case d_casino_hoax:
	    {
	        if ( ! response ) return 1 ;

			new query_string [ 104 + 9 + 9 ] ;
			format ( query_string, sizeof ( query_string ),"SELECT `u_activity_casino` FROM `users_casino_hoax` WHERE `u_id` = '%d' AND `u_casino` = '%d' LIMIT 1", p_info [ playerid ] [ id ], b_info [ GetPVarInt ( playerid, "p_biz_id" ) - 1 ] [ b_id ] ) ;
			mysql_tquery ( sql_connection, query_string, "get_player_activity_hoax", "ii", playerid, GetPVarInt ( playerid, "p_biz_id" ) - 1 ) ;
	        return 1 ;
		}
	    case d_lottery:
		{
		    if ( ! response ) return ShowShopDialog ( playerid, 1 ) ;

		    ShowShopDialog ( playerid, 1 ) ;
	        return 1 ;
		}
