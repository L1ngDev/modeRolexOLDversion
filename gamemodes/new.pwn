			for ( new q = 0 ; q < sizeof _legal_fraction ; q ++ ) fraction_message ( _legal_fraction [ q ], col_lblue, !"* Берите грузовики для боеприпасов и отправляйтесь на перехват." ) ;

			format ( fm_string, sizeof fm_string, "{"#cBAdmin"}[A] {"#cGRAdmin"}В район %s была сброшена контрабанда для криминальных организаций!", air_info [ i ] [ lName ] ) ;
