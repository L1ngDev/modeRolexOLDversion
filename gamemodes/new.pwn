stock show_mp_pickup_delete ( playerid )
{
    static const pickups_name [ 20 ] [ 20 ] =
	{
		"Baseball Bat",
		"Chainsaw",
		"Grenade",
		"Tear Gas",
		"Molotov Cocktail",
		"Colt 45",
		"Silenced",
		"Desert Eagle",
		"Shotgun",
		"Sawnoff Shotgun",
		"Combat Shotgun",
		"Micro SMG",
		"MP5",
		"AK-47",
		"M4",
		"Tec-9",
		"Country Rifle",
		"Sniper Rifle",
		"Health",
		"Armour"
	} ;
	static const pickups_ids [ 20 ] = { 336, 341, 342, 343, 344, 346, 347, 348, 349, 350, 351, 352, 353, 355, 356, 372, 357, 358, 1240, 1242 } ;

	global_string [ 0 ] = EOS ;
	new line_string [ 32 + 32 + 9 ], pick_count = 0 ;
	for ( new i = 0 ; i < MAX_ADM_PICKUP ; i ++ )
	{
	    if ( adm_pickup [ i ] == INVALID_PICKUP_ID ) continue ;

		set_player_listitem_values ( playerid, pick_count, i ) ;

		pick_count ++ ;

	    new pickup_model = pick_info [ adm_pickup [ i ] ] [ pick_model ] ;
	    new pickup_names ;
	    for ( new p = 0 ; p < 20 ; p ++ )
	    {
			if ( pickup_model != pickups_ids [ p ] ) continue ;

			pickup_names = p ;
			break ;
	    }
	    format ( line_string, sizeof line_string, "{"#cBL"}%d. {"#cWH"}%s - %d\n", pick_count, pickups_name [ pickup_names ], pickups_ids [ pickup_names ] ) ;
	    strcat ( global_string, line_string ) ;
	}
	show_dialog ( playerid, d_mp_pickup_delete, DIALOG_STYLE_LIST, "{"#cBHD"}Удаление пикапов", global_string, "Удалить", "Отмена");
	return 1 ;
}

