				}
				admin_info [ playerid ] [ spectate_id ] = plid + 1 ;

				new clf_string [ 4 + 9 ] ;
		        format ( clf_string, sizeof clf_string, "%d", admin_info [ playerid ] [ spectate_id ] ) ;
				callcmd::sp ( playerid, clf_string ) ;
				return 1 ;
			}
	    }
	    else if ( playertextid == sp_ptd [ playerid ] [ 6 ] )
	    {
	        callcmd::spoff ( playerid ) ;
	        return 1 ;
	    }
	    else if ( playertextid == sp_ptd [ playerid ] [ 2 ] )
	    {
	        for ( new plid = target_id ; plid < MAX_PLAYERS ; plid ++ )
			{
				if ( p_t_info [ plid ] [ p_logged ] == false || plid == playerid ) continue ;
				if ( sp_aspect { playerid } == 1 )
				{
				    if ( gz_captured == -1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}В данный момент нет активных захватов территорий." ) ;
					if ( p_info [ plid ] [ member ] != gz_info [ gz_captured ] [ gz_attacker ] && p_info [ plid ] [ member ] != gz_info [ gz_captured ] [ gz_owner ] ) continue ;
				}
				else if ( sp_aspect { playerid } == 2 )
				{
				    if ( mw_biz == -1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}В данный момент нет активных захватов бизнесов." ) ;
					if ( p_info [ plid ] [ member ] != mw_attacker && p_info [ plid ] [ member ] != mw_owner ) continue ;
				}
				else if ( sp_aspect { playerid } == 3 )
				{
				    if ( GetString ( ac_info [ plid ], "clear" ) ) continue ;
				}
				admin_info [ playerid ] [ spectate_id ] = plid + 1 ;

				new clf_string [ 4 + 9 ] ;
		        format ( clf_string, sizeof clf_string, "%d", admin_info [ playerid ] [ spectate_id ] ) ;
				callcmd::sp ( playerid, clf_string ) ;
				return 1 ;
			}
			for ( new plid ; plid <= target_id - 1 ; plid ++ )
			{
				if ( p_t_info [ plid ] [ p_logged ] == false || plid == playerid ) continue ;
				if ( sp_aspect { playerid } == 1 )
				{
				    if ( gz_captured == -1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}В данный момент нет активных захватов территорий." ) ;
					if ( p_info [ plid ] [ member ] != gz_info [ gz_captured ] [ gz_attacker ] && p_info [ plid ] [ member ] != gz_info [ gz_captured ] [ gz_owner ] ) continue ;
				}
				else if ( sp_aspect { playerid } == 2 )
				{
