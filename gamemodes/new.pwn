public OnPlayerDeath ( playerid, killerid, reason )
{
	#if defined debug_mode
		printf ( "[DEBUG] [OnPlayerDeath] playerid:%d | killerid:%d | reason:%d", playerid, killerid, reason ) ;
	#endif

	//ac_OnPlayerDeath ( playerid, killerid, reason ) ;
    #if defined __anti_godmode
	antigm_OnPlayerDeath(playerid, killerid, reason);
	#endif

	reset_player_weapon ( playerid ) ;

	is_player_fake_spawn { playerid } = 1 ;
	p_t_info [ playerid ] [ p_tp_immune_time ] = 3 ;
	p_t_info [ playerid ] [ p_gun_immune_time ] = 8 ;
	p_t_info [ playerid ] [ p_dialog ] = -1 ;

	StopAudioStreamForPlayer ( playerid ) ;

	if ( playerid == killerid ) return anti_cheat ( playerid, "fake death", 211 ) ;
	if ( ! IsPlayerConnected ( killerid ) && killerid != INVALID_PLAYER_ID ) return anti_cheat ( playerid, "fake death", 212  );
	if ( GetPlayerState ( playerid ) != 7 ) return anti_cheat ( playerid, "fake death", 210 ) ;

	if ( killerid != INVALID_PLAYER_ID )
	{
		if ( GetPlayerState ( killerid ) == PLAYER_STATE_DRIVER )
		{
			anti_db_warning { killerid } ++ ;
			show_dialog ( killerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Предупреждение", "{FFFFFF}Вы убили игрока с помощью транспортного средства.\n\n{"#cRD"}* В случае повторных нарушений Вы можете быть кикнуты.", "Принять", "" ) ;
			if ( anti_db_warning { killerid } >= 1 )
			{
				SendClientMessage ( killerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Ваше т/с было отправлено на спавн за {"#cRD"}DB{"#cGRInfo"} в общественном месте." ) ;
				if ( GetPlayerVehicleID ( killerid ) != 0 ) SetVehicleToRespawn ( GetPlayerVehicleID ( killerid ), 4444 ) ;
			}
		}
	}

    if ( p_t_info [ playerid ] [ pl_veh ] != INVALID_VEHICLE_ID )
	{
		DestroyVehicle ( p_t_info [ playerid ] [ pl_veh ], 48 ) ;
		p_t_info [ playerid ] [ pl_veh ] = INVALID_VEHICLE_ID ;

		if ( IsValidDynamicObject ( p_t_info [ playerid ] [ pl_object ] ) )
		{
			DestroyDynamicObject ( p_t_info [ playerid ] [ pl_object ] ) ;
			p_t_info [ playerid ] [ pl_object ] = INVALID_OBJECT_ID ;
		}

		if ( IsValidDynamic3DTextLabel ( p_t_info [ playerid ] [ pl_label ] ) )
		{
			DestroyDynamic3DTextLabel ( p_t_info [ playerid ] [ pl_label ] ) ;
			p_t_info [ playerid ] [ pl_label ] = Text3D:INVALID_3DTEXT_ID ;
		}
	}

    if ( p_t_info [ playerid ] [ pl_quest ] != INVALID_VEHICLE_ID )
	{
		DestroyVehicle ( p_t_info [ playerid ] [ pl_quest ], 49 ) ;
		p_t_info [ playerid ] [ pl_quest ] = INVALID_VEHICLE_ID ;
	}

	if ( ! player_death_id [ playerid ] && TeamPaint [ playerid ] == 0 && player_duel [ playerid ] [ duel_in_lobby ] == INVALID_PLAYER_ID )
	{
		if ( IsPlayerToSquare ( playerid, -891.3302, -2950.0190,2915.9917,560.3257 ) ) player_death_id [ playerid ] = 1, p_t_info [ playerid ] [ p_health ] = 15 ;	 // LS
		else if ( IsPlayerToSquare ( playerid, -2929.6589,-2889.1660,-1326.9077,1493.1770 ) ) player_death_id [ playerid ] = 2, p_t_info [ playerid ] [ p_health ] = 15 ; // SF
		else player_death_id [ playerid ] = 3, p_t_info [ playerid ] [ p_health ] = 15 ;	 // LV

		if ( army_player ( playerid ) ) player_death_id [ playerid ] = 4 ;
		if ( gang_player ( playerid ) ) player_death_id [ playerid ] = 5 ;
		if ( p_info [ playerid ] [ family ] )
	    {
		   	new family_id = p_info [ playerid ] [ family ] ;
		   	if ( family_info [ family_id - 1 ] [ fam_enhancement ] [ 4 ] )
		   	{
		   	    player_death_id [ playerid ] = 5 ;
		   	}
		   	else
		   	{
                player_death_id [ playerid ] = 1 ;
			   	p_t_info [ playerid ] [ p_health ] = 15 ;
			}
		}

		if ( exam_vehicle [ playerid ] != INVALID_VEHICLE_ID )
		{
			is_leave_exam_vehicle { playerid } = 0 ;
			SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы допустили грубые ошибки, экзамен провален." ) ;
			GameTextForPlayer ( playerid, "~r~FAILED", 5000, 6 ) ;
			new vehicle_id = exam_vehicle [ playerid ] ;
			exam_vehicle [ playerid ] = INVALID_VEHICLE_ID ;
			exam_start [ playerid ] = false ;
			exam_cp_number { playerid } = 0 ;
			DisablePlayerRaceCheckpoint ( playerid ) ;

			player_death_id [ playerid ] = GetVehicleModel ( vehicle_id ) ;

			if ( veh_info [ vehicle_id - 1 ] [ v_model ] != vehicle_exam_drive ) DestroyVehicle ( vehicle_id, 50 ) ;
			else SetVehicleToRespawn ( vehicle_id, 17 ) ;
		}
	}
	if ( player_dice_table { playerid } > 0 ) ExitBone ( playerid ), toggle_controlable ( playerid, true ) ;
	if ( player_mp [ playerid ] ) player_mp [ playerid ] = false, p_t_info [ playerid ] [ mp_team ] = 0 ;

	if ( p_t_info [ playerid ] [ car_audio ] )
    {
		foreach(new i: streamed_players[playerid])
		{
			if ( GetPlayerVehicleID ( playerid ) == GetPlayerVehicleID ( i ) )
			{
   				StopAudioStreamForPlayer ( i ) ;
			    SendClientMessage ( i, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Аудио-система в транспорте отключена." ) ;
			}
		}
		StopAudioStreamForPlayer ( playerid ) ;
		DeletePVar ( playerid, "BBStation" ) ;
  	}

	if ( p_info [ playerid ] [ robbery_money ] != 0 ) p_info [ playerid ] [ robbery_stop ] = 1 ;
	if ( p_t_info [ playerid ] [ t_robbery ] != -1 )
	{
		exit_robbery ( playerid ) ;
		clear_bank_robbery ( playerid, 2 ) ;
	}

	#if defined m_t_stage
	    stage_OnPlayerDisconnect ( playerid ) ;
	#endif

	#if defined m_jobs_module
		taxi_OnPlayerDeath ( playerid ) ;
	#endif

	if ( pull_timer [ playerid ] != -1 )
	{
		KillTimer ( pull_timer [ playerid ] ) ;
	 	pull_timer [ playerid ] = -1 ;
	}

	if ( gotome_player [ playerid ] != -1 )
	{
	    police_gotome [ gotome_player [ playerid ] ] =
		gotome_player [ playerid ] = -1 ;
	}

    if ( factory_place { playerid } > 0 )
  	{
     	new i = factory_place { playerid } - 1 ;
	    StatusFactory [ i ] = false ;
	    DestroyDynamic3DTextLabel ( FactorySFText3D [ i ] ) ;
	    FactorySFText3D [ i ] = Text3D:INVALID_3DTEXT_ID ;
	    factory_place { playerid } = 0 ;
	    factory_slot { playerid } = 0 ;
		DisablePlayerCheckpoint ( playerid ) ;
		if(IsPlayerAttachedObjectSlotUsed(playerid, 0)) RemovePlayerAttachedObject(playerid, 0);
    }

	#if defined m_inventory_module
	    trade_OnPlayerDisconnect ( playerid ) ;
	#endif

	PlayerIndividualStream ( playerid, "" ) ;
    DestroyRecorder ( playerid ) ;

    if ( player_rentcar [ playerid ] != INVALID_VEHICLE_ID ) end_for_job ( playerid ) ;

	if ( player_use_bed { playerid } > 0 )
	{
		h_bed_toggled [ player_use_bed { playerid } - 1 ] [ player_use_bed_world { playerid } - 1 ] = false ;
		player_use_bed { playerid } = 0 ;
	}

	if ( ( gang_player ( playerid ) || mafia_player ( playerid ) ) &&
			( IsPlayerToSquare ( playerid, 80.8047, 1762.5040, 390.7005, 2093.4778 ) ||
			IsPlayerToSquare ( playerid, -1722.65625, 222.65625, -1207.03125, 539.0625 ) ) &&
			p_info [ playerid ] [ vip ] < 2 )
	{
		new _ammo = GetInventoryFindItem ( playerid, SUB_INVENTORY, 2154 ), _guns = GetInventoryFindItem ( playerid, SUB_INVENTORY, 2153 ) ;
		clear_inventory ( playerid, 2153, _guns ) ;
		clear_inventory ( playerid, 2154, _ammo ) ;

		SendClientMessage ( playerid, col_gray, !"* Перед отправкой в больницу солдаты изъяли у Вас патроны и оружие." ) ;
	}

	if ( p_info [ playerid ] [ masked ] ) p_info [ playerid ] [ masked ] = 1 ;

	if ( target_cuff [ playerid ] != INVALID_PLAYER_ID || player_cuff [ playerid ] != INVALID_PLAYER_ID )
	{
	    if ( player_cuff [ playerid ] != INVALID_PLAYER_ID )
		{
		    new _player_cuff = player_cuff [ playerid ] ;
		    clear_stoped_params ( playerid, _player_cuff ) ;

			SetPlayerSpecialAction ( _player_cuff, SPECIAL_ACTION_NONE ) ;
			RemovePlayerAttachedObject ( _player_cuff, 1 ) ;

			SendClientMessage ( _player_cuff, col_gray, !"{"#cGInfo"}* {"#cGRInfo"}Офицер, надевший на Вас наручники, погиб. Наручники сняты." ) ;
		}
		if ( target_cuff [ playerid ] != INVALID_PLAYER_ID )
		{
			new _target_cuff = target_cuff [ playerid ] ;
		    clear_stoped_params ( _target_cuff, playerid ) ;
			SetPlayerSpecialAction ( playerid, SPECIAL_ACTION_NONE ) ;
			RemovePlayerAttachedObject ( playerid, 1 ) ;
		}
	}

	if ( target_tie [ playerid ] != INVALID_PLAYER_ID || player_tie [ playerid ] != INVALID_PLAYER_ID )
	{
		if ( player_tie [ playerid ] != INVALID_PLAYER_ID )
		{
		    new _player_cuff = player_tie [ playerid ] ;
		    clear_stoped_params ( playerid, _player_cuff ) ;

			SetPlayerSpecialAction ( _player_cuff, SPECIAL_ACTION_NONE ) ;
			SendClientMessage ( _player_cuff, col_gray, !"{"#cGInfo"}* {"#cGRInfo"}Игрок, связавший Вас, погиб. Верёвка снята." ) ;
		}
		if ( target_tie [ playerid ] != INVALID_PLAYER_ID )
		{
		    new _target_cuff = target_tie [ playerid ] ;
		    clear_stoped_params ( _target_cuff, playerid ) ;
		}
	}

	if ( is_ether { playerid } != 0 )
	{
		is_ether { playerid } = 0 ; // отключаем эфир
		ether_cooldown = gettime ( ) + ( 40 * 60 ) ;
	}

	#if defined m_phone
		stopUserCalling ( playerid ) ;
	#endif

	if ( p_skin_shop [ playerid ] == true )
	{
		DeletePVar ( playerid, "skin_select_number" ) ;
		p_skin_shop [ playerid ] = false ;

		TogglePlayerControllable ( playerid, true ) ;
		SetCameraBehindPlayer ( playerid ) ;

		set_world ( playerid, 0 ) ;

		for ( new i = 0; i < 28 ; i ++ )
		{
			TextDrawHideForPlayer ( playerid, td_skinshop [ i ] ) ;
		}
		CancelSelectTextDraw ( playerid ) ;
		PlayerTextDrawDestroy ( playerid, td_skinshop_price [ playerid ] ) ;
		td_skinshop_price [ playerid ] = PlayerText:-1;
		fraction_duty ( playerid ) ;
	}

	if ( boxing_opponent [ playerid ] != INVALID_PLAYER_ID )
	{
		new target_id = boxing_opponent [ playerid ], _text_string [ 144 ] ;
		format ( _text_string, sizeof ( _text_string ), "{"#cGInfo"}* {"#cWH"}Вы одержали победу над {"#cGN"}%s{"#cWH"} и выиграли ставку в размере {"#cGN"}%d"valute_title_"", p_info [ playerid ] [ name ], player_duel [ playerid ] [ duel_money ] ) ;
		SendClientMessage ( target_id, col_white, _text_string ) ;

		give_money ( target_id, player_duel [ playerid ] [ duel_money ] * 2 ) ;
		insert_money_log ( playerid, target_id, player_duel [ playerid ] [ duel_money ], "спарринг" ) ;

		SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы проиграли спарринг." ) ;

		ClearPVars_Duel ( target_id ) ;
		ClearPVars_Duel ( playerid ) ;

		boxing_opponent [ target_id ] =
		boxing_opponent [ playerid ] = INVALID_PLAYER_ID ;

		if ( p_info [ target_id ] [ jailed ] > 0 )
		{
			if ( 4 > p_info [ target_id ] [ jail ] > 0 )
			{
				new random_jail_pos = random ( MAX_JAIL_SPAWN ) ;
				set_pos ( target_id, jail_spawn [ random_jail_pos ] [ 0 ],
									jail_spawn [ random_jail_pos ] [ 1 ],
									jail_spawn [ random_jail_pos ] [ 2 ],
									jail_spawn [ random_jail_pos ] [ 3 ],
									jail_interior, p_info [ target_id ] [ jail ] ) ;

				fraction_duty ( target_id ) ;
			}
			else if ( p_info [ target_id ] [ jail ] == 10 )
			{
				set_pos ( target_id, 5001.0518, 960.8314, 10.8203, 0.0, 0, 15 ) ;

				fraction_duty ( target_id ) ;
			}
		}
		else
		{
			new _b_id = GetPVarInt ( target_id, "p_biz_id" ) - 1 ;
			if ( _b_id < 0 ) SpawnPlayer ( target_id ) ;
			else set_pos ( target_id, boxing_spawn [ 2 ] [ 0 ], boxing_spawn [ 2 ] [ 1 ], boxing_spawn [ 2 ] [ 2 ], boxing_spawn [ 2 ] [ 3 ], 5, b_info [ _b_id ] [ b_id ] + 1000 ) ;

            fraction_duty ( target_id ) ;
		}

		reset_player_weapon ( target_id ) ;
		for ( new i = 0 ; i < 12 ; i ++ )
		{
			give_weapon ( target_id, duel_guns [ target_id ] [ i ] [ 0 ], duel_guns [ target_id ] [ i ] [ 1 ] ) ;
			duel_guns [ target_id ] [ i ] [ 0 ] =
			duel_guns [ target_id ] [ i ] [ 1 ] = 0 ;
		}

		player_death_id [ playerid ] = 323 ;
	}

	if ( duel_opponent [ playerid ] != INVALID_PLAYER_ID )
	{
	    new target_id = duel_opponent [ playerid ], _text_string [ 144 ] ;
		format ( _text_string, sizeof ( _text_string ), "{"#cGInfo"}* {"#cWH"}Вы одержали победу над {"#cGN"}%s{"#cWH"} и выиграли ставку в размере {"#cGN"}%d"valute_title_"", p_info [ playerid ] [ name ], player_duel [ playerid ] [ duel_money ] ) ;
		SendClientMessage ( target_id, col_white, _text_string ) ;

		give_money ( target_id, player_duel [ playerid ] [ duel_money ] * 2 ) ;
		insert_money_log ( playerid, target_id, player_duel [ playerid ] [ duel_money ], "дуэль" ) ;

		SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы проиграли дуэль." ) ;

		if ( p_info [ target_id ] [ jailed ] > 0 )
		{
			if ( 4 > p_info [ target_id ] [ jail ] > 0 )
			{
				new random_jail_pos = random ( MAX_JAIL_SPAWN ) ;
				set_pos ( target_id, jail_spawn [ random_jail_pos ] [ 0 ],
									jail_spawn [ random_jail_pos ] [ 1 ],
									jail_spawn [ random_jail_pos ] [ 2 ],
									jail_spawn [ random_jail_pos ] [ 3 ],
									jail_interior, p_info [ target_id ] [ jail ] ) ;

				fraction_duty ( target_id ) ;
			}
			else if ( p_info [ target_id ] [ jail ] == 10 )
			{
				set_pos ( target_id, 5001.0518, 960.8314, 10.8203, 0.0, 0, 15 ) ;

				fraction_duty ( target_id ) ;
			}
		}
		else
		{
			set_pos ( target_id, last_coord [ target_id ] [ 0 ], last_coord [ target_id ] [ 1 ], last_coord [ target_id ] [ 2 ], last_coord [ target_id ] [ 3 ], last_int [ target_id ], last_virt [ target_id ] ) ;
			fraction_duty ( target_id ) ;
		}

		reset_player_weapon ( target_id ) ;
		for ( new i = 0 ; i < 12 ; i ++ )
		{
			give_weapon ( target_id, duel_guns [ duel_opponent [ playerid ] ] [ i ] [ 0 ], duel_guns [ duel_opponent [ playerid ] ] [ i ] [ 1 ] ) ;
		}

		ClearPVars_Duel ( target_id ) ;
	  	ClearPVars_Duel ( playerid ) ;

		duel_opponent [ target_id ] =
		duel_opponent [ playerid ] = INVALID_PLAYER_ID ;

		player_death_id [ playerid ] = 322 ;
	}

	#if defined m_incass
	    incass_OnPlayerDeath ( playerid ) ;
	#endif

	#if defined m_casino_blackjack
		exit_table_blackjack ( playerid ) ;
	#endif

	if ( is_gym_training { playerid } > 0 ) gym_stop_used ( playerid, false ) ;
	return 1 ;
}

callback: callback_check_admin ( playerid )
{
    new rows, fields ;
	cache_get_data ( rows, fields ) ;

	if ( player_recomended { playerid } )
	{
	    show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, !"{"#cBHD"}Обновление клиента",
			!"{"#cWH"}Нажмите в лаунчере на кнопку {"#cBL"}\"Переустановить клиент\",\n\
			{"#cWH"}либо прочтите инструкцию в группе ВКонтакте: {"#cBL"}"vk_group"{"#cWH"}.",
			!"Закрыть", !""
		);

		SendClientMessage ( playerid, col_white, !"{"#cBInfo"}* {"#cWH"}Игровой клиент был обновлён!" ) ;
		SendClientMessage ( playerid, col_white, !"{"#cBInfo"}* {"#cWH"}Нажмите в лаунчере на кнопку {"#cBL"}\"Переустановить клиент\"{"#cWH"}!" ) ;
		SendClientMessage ( playerid, col_white, !"{"#cBInfo"}* {"#cWH"}Либо прочтите инструкцию в группе ВКонтакте: {"#cBL"}"vk_group"{"#cWH"}!" ) ;
	}

	if ( ! rows && IsFounder ( playerid ) ) return founder_auto_login ( playerid ) ;

    if ( player_recomended { playerid } == 2 && ! rows && ! server_test ) return kick_player ( playerid ) ;

	if ( rows )
	{
		if ( p_t_info [ playerid ] [ p_dialog ] == -1 )
		{
			new scm_string [ 76 + MAX_PLAYER_NAME ] ;
			mysql_format ( sql_connection, scm_string, sizeof ( scm_string ), "SELECT `u_a_password` FROM `users_admins` WHERE `u_a_name` = '%s' LIMIT 1", p_info [ playerid ] [ name ] ) ;
			mysql_tquery ( sql_connection, scm_string, "alogin_step_one", "i", playerid ) ;
		}
		g_phone_call [ playerid ] [ PC_ENABLED ] = false ;
	}
	else
	{
		if ( ! server_test )
		{
			admin_info [ playerid ] [ player_admin ] = false ;
			update_int_sql ( playerid, "u_admin", 0 ) ;
		}
	}
	return 1 ;
}

public OnPlayerSpawn ( playerid )
{
	#if defined __anti_godmode
	antigm_OnPlayerSpawn ( playerid ) ;
	#endif
	//ac_OnPlayerSpawn ( playerid ) ;
 	if ( is_player_fake_spawn { playerid } == 0 ) anti_cheat ( playerid, "fake spawn", 19323 ) ;
 	is_player_fake_spawn { playerid } = 0 ;

	if ( google_checking { playerid } == 1 )
	{
		show_dialog ( playerid, d_googleauth_entrance, DIALOG_STYLE_INPUT, "{"#cBHD"}Google Auth", "{"#cWH"}Введите код из приложения:", "Вход", "Выйти" );
	}
	#if defined debug_mode
		printf ( "[DEBUG] [OnPlayerSpawn] playerid:%d", playerid ) ;
	#endif
	set_health ( playerid, 100 ) ;
	SetPlayerScore ( playerid, p_info [ playerid ] [ level ] ) ;
	SetPlayerSkills ( playerid ) ;
	p_t_info [ playerid ] [ p_tp_immune_time ] = 4 ;
	p_t_info [ playerid ] [ p_gun_immune_time ] = 8 ;

	onServerDestroy ( playerid, UI_GAME_LOAD ) ;

	if ( ! p_t_info [ playerid ] [ p_logged ] )
	{
		TogglePlayerSpectating ( playerid, false ) ;
		TogglePlayerControllable ( playerid, false ) ;

		set_world ( playerid, playerid + 1 ) ;
		set_interior ( playerid, registration_interior ) ;

		SetPlayerPos ( playerid, registration_skin_position [ 0 ], registration_skin_position [ 1 ], registration_skin_position [ 2 ] ) ;
		SetPlayerFacingAngle ( playerid, registration_skin_position [ 3 ] ) ;

		SetPlayerCameraPos ( playerid, registration_camera_pos [ 0 ], registration_camera_pos [ 1 ], registration_camera_pos [ 2 ] ) ;
		SetPlayerCameraLookAt ( playerid, registration_camera_pos [ 3 ], registration_camera_pos [ 4 ], registration_camera_pos [ 5 ] ) ;

		if ( player_device { playerid } == 2 )
		{
		    reg_info [ playerid ] [ reg_gender ] = 1 ;
			reg_info [ playerid ] [ reg_national ] = 1 ;
			new _skin = registration_skins [ reg_info [ playerid ] [ reg_national ] - 1 ] [ reg_info [ playerid ] [ reg_gender ] - 1 ] [ 0 ] ;
			reg_info [ playerid ] [ reg_skin ] = _skin ;
			SetPlayerSkin ( playerid, _skin ) ;
		}
		else
		{
			SetPlayerPos ( playerid, registration_skin_position [ 0 ], registration_skin_position [ 1 ], registration_skin_position [ 2 ] ) ;
			SetPlayerFacingAngle ( playerid, registration_skin_position [ 3 ] ) ;

			SetPlayerSkin ( playerid, registration_skins [ reg_info [ playerid ] [ reg_national ] - 1 ] [ reg_info [ playerid ] [ reg_gender ] - 1 ] [ 0 ] ) ;

			SetPlayerCameraPos ( playerid, registration_camera_pos [ 0 ], registration_camera_pos [ 1 ], registration_camera_pos [ 2 ] ) ;
			SetPlayerCameraLookAt ( playerid, registration_camera_pos [ 3 ], registration_camera_pos [ 4 ], registration_camera_pos [ 5 ] ) ;

			for ( new i = 0; i < 22 ; i ++ )
			{
				TextDrawShowForPlayer ( playerid, td_regskins [ i ] ) ;
			}
			SelectTextDraw ( playerid, 0xB0C4DEFF ) ;
			ClearAnimations ( playerid ) ;
		}
		return 1 ;
	}

	#if defined m_info
	    noty_OnPlayerDeath ( playerid ) ;
	#endif

	ResetPlayerMoney ( playerid ) ;
	GivePlayerMoney ( playerid, p_info [ playerid ] [ money ] ) ;

	//SetPlayerSkin ( playerid, p_info [ playerid ] [ skin ] ) ;

	if ( have_factory_box [ playerid ] ) have_factory_box [ playerid ] = false ;
	if ( exam_vehicle [ playerid ] != INVALID_VEHICLE_ID )
	{
	    exam_start [ playerid ] = false ;
	    new vehicle_id = exam_vehicle [ playerid ] ;
		if ( veh_info [ vehicle_id - 1 ] [ v_model ] != vehicle_exam_drive ) DestroyVehicle ( vehicle_id, 51 ), exam_vehicle [ playerid ] = INVALID_VEHICLE_ID ;
		else SetVehicleToRespawn ( vehicle_id, 18 ), exam_vehicle [ playerid ] = INVALID_VEHICLE_ID ;
	}
	if ( player_mp [ playerid ] ) player_mp [ playerid ] = false, p_t_info [ playerid ] [ mp_team ] = 0 ;
	if ( action_type { playerid } != 0 ) action_td_status ( playerid, false ) ;

	if ( p_info [ playerid ] [ salary ] != 0 )
	{
		new _t_string [ 62 ] ;
		format ( _t_string, sizeof ( _t_string ), "Вы получили за работу компенсацию в размере %d"valute_title".", p_info [ playerid ] [ salary ] ) ;
		SendClientMessage ( playerid, 0xCCCCCCFF, _t_string ) ;

		give_money ( playerid, p_info [ playerid ] [ salary ] ) ;
		insert_money_log ( playerid, INVALID_PLAYER_ID, p_info [ playerid ] [ salary ], "компенсация ЗП" ) ;

		p_info [ playerid ] [ salary ] = 0 ;
		update_int_sql ( playerid, "u_salary", 0 ) ;
	}

	if ( p_t_info [ playerid ] [ test_drive ] != INVALID_VEHICLE_ID )
	{
	    DestroyVehicle ( p_t_info [ playerid ] [ test_drive ], 52 ) ;
	    p_t_info [ playerid ] [ test_drive ] = INVALID_VEHICLE_ID ;
		exit_test_drive ( playerid ) ;
		return 1 ;
	}

	if ( TeamPaint [ playerid ] > 0 )
	{
	    switch ( StartPaintBall )
	    {
	        case 0:
	        {
	            TeamPaint [ playerid ] = 0 ;
			}
			case 2:
			{
				set_health ( playerid, 100.0 ) ;
				SetPlayerSkin ( playerid, SkinPaint [ p_info [ playerid ] [ gender ] ] [ TeamPaint [ playerid ] - 1 ] ) ;

				//freeze_player ( playerid ) ;

				give_weapon ( playerid, 24, 500 ) ;
				give_weapon ( playerid, 25, 500 ) ;
				give_weapon ( playerid, 31, 500 ) ;

				new spawn = random ( 2 ) ;
				switch(TeamPaint[ playerid ])
				{
				    case 1:
					{
						spawn_pos ( playerid, SpawnBlueTeam[PaintBallMap][spawn][0], SpawnBlueTeam[PaintBallMap][spawn][1], SpawnBlueTeam[PaintBallMap][spawn][2], SpawnBlueTeam[PaintBallMap][spawn][3], paint_interior, 1000 ) ;
						SetPlayerColor ( playerid, 0x33AAFFFF ) ;
					}
					case 2:
					{
						spawn_pos ( playerid, SpawnRedTeam[PaintBallMap][spawn][0], SpawnRedTeam[PaintBallMap][spawn][1], SpawnRedTeam[PaintBallMap][spawn][2], SpawnRedTeam[PaintBallMap][spawn][3], paint_interior, 1000 ) ;
						SetPlayerColor ( playerid, 0xAA3333FF ) ;
					}
				}
				return 1 ;
			}
		}
	}

	if ( player_duel [ playerid ] [ duel_in_lobby ] != INVALID_PLAYER_ID )
	{
		new target_id = player_duel [ playerid ] [ duel_in_lobby ] ;
	    switch ( player_duel [ target_id ] [ duel_map ] )
		{
		    case 1:
		    {
		        if ( random ( 2 ) == 0 ) spawn_pos ( playerid, duels_pos [ 0 ] [ 0 ], duels_pos [ 0 ] [ 1 ], duels_pos [ 0 ] [ 2 ], duels_pos [ 0 ] [ 3 ], duels_interior [ 0 ], target_id + 1000 ) ;
		        else spawn_pos ( playerid, duels_pos [ 1 ] [ 0 ], duels_pos [ 1 ] [ 1 ], duels_pos [ 1 ] [ 2 ], duels_pos [ 1 ] [ 3 ], duels_interior [ 0 ], target_id + 1000 ) ;
		    }
		    case 2:
		    {
		        if ( random ( 2 ) == 0 ) spawn_pos ( playerid, duels_pos [ 2 ] [ 0 ], duels_pos [ 2 ] [ 1 ], duels_pos [ 2 ] [ 2 ], duels_pos [ 2 ] [ 3 ], duels_interior [ 1 ], target_id + 1000 ) ;
		        else spawn_pos ( playerid, duels_pos [ 3 ] [ 0 ], duels_pos [ 3 ] [ 1 ], duels_pos [ 3 ] [ 2 ], duels_pos [ 3 ] [ 3 ], duels_interior [ 1 ], target_id + 1000 ) ;
		    }
		    case 3:
		    {
		        if ( random ( 2 ) == 0 ) spawn_pos ( playerid, duels_pos [ 4 ] [ 0 ], duels_pos [ 4 ] [ 1 ], duels_pos [ 4 ] [ 2 ], duels_pos [ 4 ] [ 3 ], duels_interior [ 2 ], target_id + 1000 ) ;
		        else spawn_pos ( playerid, duels_pos [ 5 ] [ 0 ], duels_pos [ 5 ] [ 1 ], duels_pos [ 5 ] [ 2 ], duels_pos [ 5 ] [ 3 ], duels_interior [ 2 ], target_id + 1000 ) ;
			}
		}

		set_health ( playerid, player_duel [ target_id ] [ duel_hp ] ) ;
  		set_armour ( playerid, 0.0 ) ;

      	for ( new i = 0 ; i < 12 ; i ++ )
		{
			duel_guns [ playerid ] [ i ] [ 0 ] = p_t_info [ playerid ] [ p_gun_slot ] [ i ] ;
			duel_guns [ playerid ] [ i ] [ 1 ] = p_t_info [ playerid ] [ p_gun_ammo ] [ i ] ;
		}
		reset_player_weapon ( playerid ) ;

		fraction_duty ( playerid ) ;

		if ( player_duel [ target_id ] [ duel_gun ] [ 0 ] != 0 ) give_weapon ( playerid, player_duel [ target_id ] [ duel_gun ] [ 0 ], 999 ) ;
		if ( player_duel [ target_id ] [ duel_gun ] [ 1 ] != 0 ) give_weapon ( playerid, player_duel [ target_id ] [ duel_gun ] [ 1 ], 999 ) ;
		if ( player_duel [ target_id ] [ duel_gun ] [ 2 ] != 0 ) give_weapon ( playerid, player_duel [ target_id ] [ duel_gun ] [ 2 ], 999 ) ;
		return 1 ;
	}

	if ( player_loaded { playerid } == 0 )
	{

	}
	else reset_player_weapon ( playerid ) ;

	if ( admin_info [ playerid ] [ admin ] > 0 && admin_info [ playerid ] [ admin ] < 8 || admin_info [ playerid ] [ spectate_id ] != -1 )
	{
		admin_info [ playerid ] [ spectate_id ] = -1 ;

		spawn_pos ( playerid, spawn_admin_zone [ 0 ], spawn_admin_zone [ 1 ], spawn_admin_zone [ 2 ], spawn_admin_zone [ 3 ], admin_interior, 3000 ) ;
        fraction_duty ( playerid ) ;

		CancelSelectTextDraw ( playerid ) ;
		reset_player_weapon ( playerid ) ;

		show_spec_ptd ( playerid, false ) ;

		for ( new i = 0 ; i < 12 ; i ++ )
		{
			give_weapon ( playerid, p_t_info [ playerid ] [ p_gun_slot ] [ i ], p_t_info [ playerid ] [ p_gun_ammo ] [ i ] ) ;
		}
		check_player_loaded ( playerid ) ;

		SendClientMessage ( playerid, col_orange, !"* Вы появились в админ зоне." ) ;
		return 1 ;
	}

	if ( p_t_info [ playerid ] [ tr_team ] > 0 && p_t_info [ playerid ] [ tr_enter ] > 0 )
	{
		new fraction_id = p_t_info [ playerid ] [ tr_enter ] ;
		if ( time_tr_team [ fraction_id ] > 0 )
		{
			new map_id = f_info [ fraction_id - 1 ] [ f_tr_map ], team_id = p_t_info [ playerid ] [ tr_team ] - 1 ;
		    spawn_pos ( playerid, f_training_spawn [ fraction_id - 1 ] [ map_id - 1 ] [ team_id ] [ 0 ],
								f_training_spawn [ fraction_id - 1 ] [ map_id - 1 ] [ team_id ] [ 1 ],
								f_training_spawn [ fraction_id - 1 ] [ map_id - 1 ] [ team_id ] [ 2 ],
								f_training_spawn [ fraction_id - 1 ] [ map_id - 1 ] [ team_id ] [ 3 ],
								interior_training,
								f_info [ fraction_id - 1 ] [ f_id ] ) ;

	        for ( new i = 0 ; i < 12 ; i ++ )
			{
			    if ( ! f_info [ fraction_id - 1 ] [ f_tr_ammo ] [ i ] ) continue ;
				give_weapon ( playerid, f_info [ fraction_id - 1 ] [ f_tr_gun ] [ i ], f_info [ fraction_id - 1 ] [ f_tr_ammo ] [ i ] ) ;
			}

			if ( f_info [ fraction_id - 1 ] [ f_tr_health ] > 0 ) set_health ( playerid, f_info [ fraction_id - 1 ] [ f_tr_health ] ) ;
			else set_health ( playerid, 50.0 ) ;

			if ( f_info [ fraction_id - 1 ] [ f_tr_skin ] [ team_id ] > 0 ) SetPlayerSkin ( playerid, f_info [ fraction_id - 1 ] [ f_tr_skin ] [ team_id ] ) ;
			else fraction_duty ( playerid ) ;
			check_player_loaded ( playerid ) ;
		    return 1 ;
		}
		else
		{
		    p_t_info [ playerid ] [ tr_enter ] =
		    p_t_info [ playerid ] [ tr_team ] = 0 ;
		}
	}
	else
	{
		p_t_info [ playerid ] [ tr_enter ] =
		p_t_info [ playerid ] [ tr_team ] = 0 ;
	}

	if ( gang_player ( playerid ) || mafia_player ( playerid ) )is_fraction_duty { playerid } = 1 ;
	else is_fraction_duty { playerid } = 0, SetPlayerColor ( playerid, 0xFFFFFF80 ) ; // col_white
	if ( gang_player ( playerid ) ) give_weapon ( playerid, 5, 1 ) ;

	if ( p_info [ playerid ] [ jailed ] > 0 )
	{
	    SendClientMessage ( playerid, 0xCCCCCCFF, !"Используйте {"#cWH"}/time{CCCCCC}, чтоб узнать сколько Вам осталось отбывать срок." ) ;

		new _jail = p_info [ playerid ] [ jail ] ;
		if ( 4 > _jail > 0 )
		{
			new random_jail_pos = random ( MAX_JAIL_SPAWN ) ;
			spawn_pos ( playerid, jail_spawn [ random_jail_pos ] [ 0 ],
								jail_spawn [ random_jail_pos ] [ 1 ],
								jail_spawn [ random_jail_pos ] [ 2 ],
								jail_spawn [ random_jail_pos ] [ 3 ],
								jail_interior, p_info [ playerid ] [ jail ] ) ;

			fraction_duty ( playerid ) ;
			check_player_loaded ( playerid ) ;
			return 1 ;
		}
		else if ( _jail == 9 )
		{
		    #if defined m_prison
		    new _spawn_id = random ( prison_spawn_count ) ;
			spawn_pos ( playerid, prison_spawn [ _spawn_id ] [ 0 ], prison_spawn [ _spawn_id ] [ 1 ], prison_spawn [ _spawn_id ] [ 2 ], prison_spawn [ _spawn_id ] [ 3 ], prison_interior, prison_virtualworld ) ;
			if ( ! p_info [ playerid ] [ gender ] ) SetPlayerSkin ( playerid, skin_male ) ;
			else SetPlayerSkin ( playerid, skin_female ) ;
			SetPlayerColor ( playerid, 0xFFFFFF80 ) ;
			check_player_loaded ( playerid ) ;
			return 1 ;
			#endif
		}
		else if ( _jail == 10 )
		{
			spawn_pos ( playerid, jail_spawn [ 0 ] [ 0 ], jail_spawn [ 0 ] [ 1 ], jail_spawn [ 0 ] [ 2 ], jail_spawn [ 0 ] [ 3 ], 1, 15 ) ;
			fraction_duty ( playerid ) ;
			check_player_loaded ( playerid ) ;
			return 1 ;
		}
	}

	new _death_id = player_death_id [ playerid ] ;
	if ( _death_id == 5 ) player_death_id [ playerid ] = 0 ;
	else if ( _death_id >= 1 )
	{
		if ( _death_id > 3 )
		{
			switch ( _death_id )
			{
			    case 4:
			    {
				    new _fraction_id = p_info [ playerid ] [ member ] ;
					if ( _fraction_id == 8 )
						spawn_pos ( playerid, army_hospital_spawn [ 0 ], army_hospital_spawn [ 1 ], army_hospital_spawn [ 2 ], army_hospital_spawn [ 3 ], army_interior, 1 ) ;

					else if ( _fraction_id == 9 )
						spawn_pos ( playerid, army_hospital_spawn [ 0 ], army_hospital_spawn [ 1 ], army_hospital_spawn [ 2 ], army_hospital_spawn [ 3 ], army_interior, 2 ) ;

					fraction_duty ( playerid ) ;
					set_health ( playerid, 15.0 ) ;
					SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы попали в военный госпиталь, ожидайте полного восстановления здоровья, чтобы его покинуть." ) ;
					check_player_loaded ( playerid ) ;
					return 1 ;
			    }
				case vehicle_exam_fly:spawn_pos ( playerid, exam_player_pos [ 0 ], exam_player_pos [ 1 ], exam_player_pos [ 2 ], exam_player_pos [ 3 ], int_exam_fly, virt_exam_fly ) ;
				case vehicle_exam_boat:spawn_pos ( playerid, exam_player_pos [ 0 ], exam_player_pos [ 1 ], exam_player_pos [ 2 ], exam_player_pos [ 3 ], int_exam_boat, virt_exam_boat ) ;
				case vehicle_exam_drive:spawn_pos ( playerid, exam_player_pos [ 0 ], exam_player_pos [ 1 ], exam_player_pos [ 2 ], exam_player_pos [ 3 ], int_exam_drive, virt_exam_drive ) ;
				case 322:
				{
					spawn_pos ( playerid, last_coord [ playerid ] [ 0 ], last_coord [ playerid ] [ 1 ], last_coord [ playerid ] [ 2 ], last_coord [ playerid ] [ 3 ], last_int [ playerid ], last_virt [ playerid ] ) ;
					reset_player_weapon ( playerid ) ;
					for ( new i = 0 ; i < 12 ; i ++ )
					{
						give_weapon ( playerid, duel_guns [ playerid ] [ i ] [ 0 ], duel_guns [ playerid ] [ i ] [ 1 ] ) ;
						duel_guns [ playerid ] [ i ] [ 0 ] =
						duel_guns [ playerid ] [ i ] [ 1 ] = 0 ;
					}
					fraction_duty ( playerid ) ;
				}
				case 323:
				{
					if ( GetPVarInt ( playerid, "p_biz_id" ) > 0 ) spawn_pos ( playerid, boxing_spawn [ 2 ] [ 0 ], boxing_spawn [ 2 ] [ 1 ], boxing_spawn [ 2 ] [ 2 ], boxing_spawn [ 2 ] [ 3 ], 5, b_info [ GetPVarInt ( playerid, "p_biz_id" ) - 1 ] [ b_id ] + 1000 ) ;
					else SpawnPlayer ( playerid ) ;

					for ( new i = 0 ; i < 12 ; i ++ )
					{
						give_weapon ( playerid, duel_guns [ playerid ] [ i ] [ 0 ], duel_guns [ playerid ] [ i ] [ 1 ] ) ;
						duel_guns [ playerid ] [ i ] [ 0 ] =
						duel_guns [ playerid ] [ i ] [ 1 ] = 0 ;
					}

					fraction_duty ( playerid ) ;
				}
			}
			player_death_id [ playerid ] = 0 ;
			check_player_loaded ( playerid ) ;
			return 1 ;
		}
		new random_h_pos = random ( 4 ) ;
		spawn_pos ( playerid, hospital_spawn [ random_h_pos ] [ 0 ],
							hospital_spawn [ random_h_pos ] [ 1 ],
							hospital_spawn [ random_h_pos ] [ 2 ],
							hospital_spawn [ random_h_pos ] [ 3 ],
							2, p_info [ playerid ] [ hospital ] ) ;

		set_health ( playerid, 15.0 ) ;

		fraction_duty ( playerid ) ;
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вам придется пройти курс лечения или вылечиться у медика. Займите койку в палате для более эффективного лечения." ) ;
		check_player_loaded ( playerid ) ;
		return 1 ;
	}

	if ( rieltore_opened [ playerid ] )
	{
		toggle_controlable ( playerid, true ) ;
        TogglePlayerSpectating ( playerid, false ) ;

        p_t_info [ playerid ] [ p_tp_immune_time ] = 4 ;
		spawn_pos ( playerid, last_coord [ playerid ] [ 0 ], last_coord [ playerid ] [ 1 ], last_coord [ playerid ] [ 2 ], last_coord [ playerid ] [ 3 ], last_int [ playerid ], last_virt [ playerid ] ) ;
		fraction_duty ( playerid ) ;
		rieltore_opened [ playerid ] = false ;

		check_player_loaded ( playerid ) ;
		return 1 ;
	}

	SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Используйте {"#cBL"}/spawnchange (/spaw){"#cGRInfo"}, чтоб выбрать место появления." ) ;

	new _spawnchange = p_info [ playerid ] [ spawnchange ] ;
	if ( _spawnchange == 1 )
	{
		new h = p_info [ playerid ] [ house ] ;
	    if ( h != -1 )
	    {
			new hint = h_info [ h - 1 ] [ h_int ] - 1 ;

			spawn_pos ( playerid, house_int [ hint ] [ hspawn_position ] [ 0 ], house_int [ hint ] [ hspawn_position ] [ 1 ], house_int [ hint ] [ hspawn_position ] [ 2 ], house_int [ hint ] [ hspawn_position ] [ 3 ], house_int [ hint ] [ hint_int ], h_info [ h - 1 ] [ h_id ] ) ;
			SetPVarInt ( playerid, "house_id", h ) ;
			fraction_duty ( playerid ) ;

			send_check_cinfo ( playerid, "Открыть меню дома", 2, -1, CINFO_HOUSE_HMENU_ID_1, PICTURE_INFO_SUCESS, "Меню", "Закрыть" ) ;
			if ( h_info [ h - 1 ] [ h_podezd ] != -1 ) SetPVarInt ( playerid, "podezd_id", h_info [ h - 1 ] [ h_podezd ] + 1 ) ;
			check_player_loaded ( playerid ) ;
			return 1 ;
		}
	}
	else if ( _spawnchange == 4 )
	{
	    if ( p_info [ playerid ] [ cellar ] != -1 )
	    {
			new h = p_info [ playerid ] [ cellar ] - 1 ;

			spawn_pos ( playerid, cellar_player_spawn [ 0 ], cellar_player_spawn [ 1 ], cellar_player_spawn [ 2 ], cellar_player_spawn [ 3 ], cellar_interior, cellar_info [ h ] [ cl_id ] ) ;
			fraction_duty ( playerid ) ;
			SetPVarInt ( playerid, "cellar_id", p_info [ playerid ] [ cellar ] ) ;
			check_player_loaded ( playerid ) ;
			return 1 ;
		}
	}
	else if ( _spawnchange == 5 )
	{
	    if ( p_info [ playerid ] [ rent_house ] )
	    {
			new h = p_info [ playerid ] [ rent_house ] - 1, hint = h_info [ h ] [ h_int ] - 1 ;
	  		spawn_pos ( playerid, house_int [ hint ] [ hspawn_position ] [ 0 ], house_int [ hint ] [ hspawn_position ] [ 1 ], house_int [ hint ] [ hspawn_position ] [ 2 ], house_int [ hint ] [ hspawn_position ] [ 3 ], house_int [ hint ] [ hint_int ], h_info [ h ] [ h_id ] ) ;
			SetPVarInt ( playerid, "house_id", p_info [ playerid ] [ rent_house ] ) ;
			fraction_duty ( playerid ) ;

			if ( h_info [ h ] [ h_podezd ] != -1 ) SetPVarInt ( playerid, "podezd_id", h_info [ h ] [ h_podezd ] + 1 ) ;

			send_check_cinfo ( playerid, "Открыть меню дома", 2, -1, CINFO_HOUSE_HMENU_ID_2, PICTURE_INFO_SUCESS, "Меню", "Закрыть" ) ;

			SendClientMessage ( playerid, col_orange, !"* Вы арендуете жильё. Чтоб прекратить аренду используйте /hleave." ) ;
			SendClientMessage ( playerid, col_orange, !"* Вам доступны гардероб и подвал. Используйте /hrent." ) ;
			check_player_loaded ( playerid ) ;
			return 1 ;
		}
	}
    else if ( _spawnchange == 6 )
	{
	    if ( p_info [ playerid ] [ hotel ] != -1 )
	    {
			new h = p_info [ playerid ] [ hotel ] ;

			spawn_pos ( playerid, position_spawn_hotel [ 0 ], position_spawn_hotel [ 1 ], position_spawn_hotel [ 2 ], position_spawn_hotel [ 3 ], 3, hotel_info [ h - 1 ] [ h_biz ] + hotel_info [ h - 1 ] [ h_id ] ) ;
	  		SetPVarInt ( playerid, "p_hotel_id", p_info [ playerid ] [ hotel ] ) ;
			SetPVarInt ( playerid, "p_biz_id", hotel_info [ h - 1 ] [ h_biz ] ) ;
	  		//freeze_player ( playerid ) ;
			fraction_duty ( playerid ) ;
			check_player_loaded ( playerid ) ;
			return 1 ;
		}
	}
	else if ( _spawnchange == 7 )
	{
		new _family_id = p_info [ playerid ] [ family ] ;
	    if ( _family_id )
	    {
		    if ( family_info [ _family_id - 1 ] [ fam_house ] != 0 )
			{
				new h = family_info [ _family_id - 1 ] [ fam_house ] - 1, hint = h_info [ h ] [ h_int ] - 1 ;
		  		spawn_pos ( playerid, house_int [ hint ] [ hspawn_position ] [ 0 ], house_int [ hint ] [ hspawn_position ] [ 1 ], house_int [ hint ] [ hspawn_position ] [ 2 ], house_int [ hint ] [ hspawn_position ] [ 3 ], house_int [ hint ] [ hint_int ], h_info [ h ] [ h_id ] ) ;
				SetPVarInt ( playerid, "house_id", h + 1 ) ;
				fraction_duty ( playerid ) ;

				send_check_cinfo ( playerid, "Открыть меню дома", 2, -1, CINFO_HOUSE_HMENU_ID_3, PICTURE_INFO_SUCESS, "Меню", "Закрыть" ) ;
				if ( h_info [ h ] [ h_podezd ] != -1 ) SetPVarInt ( playerid, "podezd_id", h_info [ h ] [ h_podezd ] + 1 ) ;
				check_player_loaded ( playerid ) ;
				return 1 ;
			}
		}
	}
	else if ( _spawnchange == 2 )
	{
		new fraction_id = p_info [ playerid ] [ member ] ;
	    if ( fraction_id )
	    {
		    if ( p_info [ playerid ] [ subleader ] > 0 )
		    {
		        new list_item = p_info [ playerid ] [ subleader ] ;
		        if ( unit_info [ list_item - 1 ] [ u_use_spawn ] )
		        {
		        	spawn_pos ( playerid, unit_info [ list_item - 1 ] [ u_spawn ] [ 0 ],
	        						unit_info [ list_item - 1 ] [ u_spawn ] [ 1 ],
	              					unit_info [ list_item - 1 ] [ u_spawn ] [ 2 ],
	              					unit_info [ list_item - 1 ] [ u_spawn ] [ 3 ],
									unit_info [ list_item - 1 ] [ u_int ],
									unit_info [ list_item - 1 ] [ u_world ] ) ;

				    fraction_duty ( playerid ) ;
		    		check_player_loaded ( playerid ) ;
					return 1 ;
				}
			}
			spawn_pos ( playerid, f_info [ fraction_id - 1 ] [ f_spawn ] [ 0 ], f_info [ fraction_id - 1 ] [ f_spawn ] [ 1 ], f_info [ fraction_id - 1 ] [ f_spawn ] [ 2 ], f_info [ fraction_id - 1 ] [ f_spawn ] [ 3 ], f_info [ fraction_id - 1 ] [ f_spawn_int ], f_info [ fraction_id - 1 ] [ f_spawn_virt ] ) ;
		    fraction_duty ( playerid ) ;

		    check_player_loaded ( playerid ) ;
			return 1 ;
		}
	}
	else if ( _spawnchange == 3 )
	{
	  	new yacht_id = 0 ;
		foreach(new veh_id: player_vehicles[playerid])
		{
			if ( ! v_boat_int ( veh_id ) ) continue ;
			yacht_id = veh_id ;
			break ;
		}
		if ( yacht_id )
		{
			is_player_in_boat [ playerid ] = yacht_id ;

			spawn_pos ( playerid, yacht_spawn [ 0 ], yacht_spawn [ 1 ], yacht_spawn [ 2 ], yacht_spawn [ 3 ], yacht_interior, yacht_id ) ;
			fraction_duty ( playerid ) ;

			check_player_loaded ( playerid ) ;
			return 1 ;
		}
	}
	else if ( _spawnchange == 255 )
	{
		spawn_pos ( playerid, p_info [ playerid ] [ exit_pos ] [ 0 ], p_info [ playerid ] [ exit_pos ] [ 1 ], p_info [ playerid ] [ exit_pos ] [ 2 ], 0.0, p_info [ playerid ] [ exit_int ], p_info [ playerid ] [ exit_world ] ) ;
        fraction_duty ( playerid ) ;

		new _etype = p_info [ playerid ] [ exit_type ] ;
		if ( _etype == 1 )
		{
			SetPVarInt ( playerid, "house_id", p_info [ playerid ] [ exit_inc_id ] ) ;

			new h = GetPVarInt ( playerid, "house_id" ) - 1 ;
			if ( h_info [ h ] [ h_podezd ] != -1 ) SetPVarInt ( playerid, "podezd_id", h_info [ h ] [ h_podezd ] + 1 ) ;
		}
		else if ( _etype == 2 ) SetPVarInt ( playerid, "cellar_id", p_info [ playerid ] [ exit_inc_id ] ) ;
        else if ( _etype == 3 ) SetPVarInt ( playerid, "p_biz_id", p_info [ playerid ] [ exit_inc_id ] ) ;

		p_info [ playerid ] [ exit_pos ] [ 0 ] =
		p_info [ playerid ] [ exit_pos ] [ 1 ] =
		p_info [ playerid ] [ exit_pos ] [ 2 ] = 0.0 ;

		p_info [ playerid ] [ exit_int ] =
		p_info [ playerid ] [ exit_world ] =
		p_info [ playerid ] [ exit_type ] =
		p_info [ playerid ] [ exit_time ] = 0 ;

		p_info [ playerid ] [ spawnchange ] = GetPVarInt ( playerid, "EPLAYER" ) ;
  		DeletePVar ( playerid, "EPLAYER" ) ;

  		check_player_loaded ( playerid ) ;
		return 1 ;
	}

	new _lvl = p_info [ playerid ] [ level ] ;
 	if ( _lvl < 4 )
	{
	    if ( server_open_time == 0 )
	    {
			new i = 0,
				j = random ( 3 ) ;

			spawn_pos ( playerid, newbie_spawn_pos [ i ] [ j ] [ 0 ],
								newbie_spawn_pos [ i ] [ j ] [ 1 ],
								newbie_spawn_pos [ i ] [ j ] [ 2 ],
								newbie_spawn_pos [ i ] [ j ] [ 3 ],
								newbie_spawn_data [ i ] [ j ] [ 0 ], newbie_spawn_data [ i ] [ j ] [ 1 ] ) ;

	    	fraction_duty ( playerid ) ;
			if ( player_first_entrance [ playerid ] == true )
			{
				SetPlayerRaceCheckpoint ( playerid, 1, faggio_spawn [ i ] [ 0 ], faggio_spawn [ i ] [ 1 ], faggio_spawn [ i ] [ 2 ], 0.0, 0.0, 0.0, 2.0 ) ;
				SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}[GPS] - Метка установлена." ) ;
				is_gps_used { playerid } = 1 ;

				if ( ! player_learning_advice_finished [ playerid ] && ! player_learning_advice [ playerid ] )
				{
					player_learning_advice [ playerid ] = true ;
					onServerSendData ( playerid, UI_LEARNING_ADVICE, 0, "Подойдите к квестовому персонажу" ) ;
				}

				if ( player_device { playerid } == 2 )
				{
					if ( ! users_education [ playerid ] [ EDUCATION_FIRST_ENTRANCE ] )
					{
						show_window_monologue (
							playerid,
							5,
							"Привет! Я твой гид по серверу! \
							Справа вверху на экране расположены кнопки быстрого взаимодействия. \
							Советую их детально изучить. \
							Рядом с тобой находится персонаж, который даст тебе задания, чтоб помочь адаптироваться в игре. \
							Также тебе установлена метка на аренду скутеров! \
							Кстати, у тебя уже есть права. \
							До скорых встреч, друг!",
							"Местный",
							"Понял"
						) ;

						save_user_education ( playerid, EDUCATION_FIRST_ENTRANCE ) ;
					}
				}
				else
				{
					SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}На мини-карте отмечена точка аренды транспорта, отправляйтесь туда для аренды мопеда." ) ;
					SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Для быстрого взаимодействия с игроками используйте {"#cWH"}'ПКМ + Y'{"#cGRInfo"}." ) ;
					SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Рекомендуем Вам ознакомиться с {"#cWH"}/gps{"#cGRInfo"} навигатором." ) ;
					SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Вам были выданы водительские права. Используйте {"#cWH"}/licenses{"#cGRInfo"}." ) ;
				}
			}
		}
		else
		{
			new i = random ( 3 ), // i = random ( 5 ),
				j = random ( 3 ) ;

			spawn_pos ( playerid, newbie_spawn_pos [ i ] [ j ] [ 0 ],
								newbie_spawn_pos [ i ] [ j ] [ 1 ],
								newbie_spawn_pos [ i ] [ j ] [ 2 ],
								newbie_spawn_pos [ i ] [ j ] [ 3 ],
								newbie_spawn_data [ i ] [ j ] [ 0 ], newbie_spawn_data [ i ] [ j ] [ 1 ] ) ;

	    	fraction_duty ( playerid ) ;
			if ( player_first_entrance [ playerid ] == true )
			{
				SetPlayerRaceCheckpoint ( playerid, 1, faggio_spawn [ i ] [ 0 ], faggio_spawn [ i ] [ 1 ], faggio_spawn [ i ] [ 2 ], 0.0, 0.0, 0.0, 2.0 ) ;
				SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}[GPS] - Метка установлена." ) ;
				is_gps_used { playerid } = 1 ;

				if ( ! player_learning_advice_finished [ playerid ] && ! player_learning_advice [ playerid ] )
				{
					player_learning_advice [ playerid ] = true ;
					onServerSendData ( playerid, UI_LEARNING_ADVICE, 0, "Подойдите к квестовому персонажу" ) ;
				}

				if ( player_device { playerid } == 2 )
				{
					if ( ! users_education [ playerid ] [ EDUCATION_FIRST_ENTRANCE ] )
					{
						show_window_monologue (
							playerid,
							5,
							"Привет! Я твой гид по серверу! \
							Справа вверху на экране расположены кнопки быстрого взаимодействия. \
							Советую их детально изучить. \
							Рядом с тобой находится персонаж, который даст тебе задания, чтоб помочь адаптироваться в игре. \
							Также тебе установлена метка на аренду скутеров! \
							Кстати, у тебя уже есть права. \
							До скорых встреч, друг!",
							"Местный",
							"Понял"
						) ;

						save_user_education ( playerid, EDUCATION_FIRST_ENTRANCE ) ;
					}
				}
				else
				{
					SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}На мини-карте отмечена точка аренды транспорта, отправляйтесь туда для аренды мопеда." ) ;
					SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Для быстрого взаимодействия с игроками используйте {"#cWH"}'ПКМ + Y'{"#cGRInfo"}." ) ;
					SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Рекомендуем Вам ознакомиться с {"#cWH"}/gps{"#cGRInfo"} навигатором." ) ;
					SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Вам были выданы водительские права. Используйте {"#cWH"}/licenses{"#cGRInfo"}." ) ;
				}
			}
		}

		check_player_loaded ( playerid ) ;
		return 1 ;
	}
	else if ( _lvl < 9 )
	{
	    new i = 1,
			j = random ( 3 ) ;

	    spawn_pos ( playerid, newbie_spawn_pos [ i ] [ j ] [ 0 ],
							newbie_spawn_pos [ i ] [ j ] [ 1 ],
							newbie_spawn_pos [ i ] [ j ] [ 2 ],
							newbie_spawn_pos [ i ] [ j ] [ 3 ],
							newbie_spawn_data [ i ] [ j ] [ 0 ], newbie_spawn_data [ i ] [ j ] [ 1 ] ) ;

	    fraction_duty ( playerid ) ;
	}
	else
	{

	    new i = 2,
			j = random ( 3 ) ;

	    spawn_pos ( playerid, newbie_spawn_pos [ i ] [ j ] [ 0 ],
							newbie_spawn_pos [ i ] [ j ] [ 1 ],
							newbie_spawn_pos [ i ] [ j ] [ 2 ],
							newbie_spawn_pos [ i ] [ j ] [ 3 ],
							newbie_spawn_data [ i ] [ j ] [ 0 ], newbie_spawn_data [ i ] [ j ] [ 1 ] ) ;

	    fraction_duty ( playerid ) ;
	}

	check_player_loaded ( playerid ) ;
	return 1 ;
}

stock check_player_loaded ( playerid )
{
    if ( player_loaded { playerid } == 0 )
	{
		player_loaded { playerid } = 1 ;
		tester_load ( playerid ) ;

		if ( IsFounder ( playerid ) )
        {
            static const _founder_query [ ] = "SELECT `u_a_id` FROM `users_admins` WHERE `u_a_name` = '%s' LIMIT 1" ;
            new scm_string [ sizeof _founder_query + MAX_PLAYER_NAME ] ;
            format ( scm_string, sizeof ( scm_string ), _founder_query, p_info [ playerid ] [ name ] ) ;
            mysql_tquery ( sql_connection, scm_string, "callback_check_admin", "i", playerid ) ;
        }
        else if ( admin_info [ playerid ] [ player_admin ] == true )
		{
		    static const _str [ ] = "SELECT `u_a_id` FROM `users_admins` WHERE `u_a_id` = '%d' LIMIT 1" ;
			new scm_string [ sizeof _str + 9 ] ;
			format ( scm_string, sizeof ( scm_string ), _str, p_info [ playerid ] [ id ] ) ;
			mysql_tquery ( sql_connection, scm_string, "callback_check_admin", "i", playerid ) ;
		}
		else
		{
		    if ( player_recomended { playerid } )
			{
			    show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, !"{"#cBHD"}Обновление клиента",
					!"{"#cWH"}Нажмите в лаунчере на кнопку {"#cBL"}\"Переустановить клиент\",\n\
					{"#cWH"}либо прочтите инструкцию в группе ВКонтакте: {"#cBL"}"vk_group"{"#cWH"}.",
					!"Закрыть", !""
				);

				SendClientMessage ( playerid, col_white, !"{"#cBInfo"}* {"#cWH"}Игровой клиент был обновлён!" ) ;
				SendClientMessage ( playerid, col_white, !"{"#cBInfo"}* {"#cWH"}Нажмите в лаунчере на кнопку {"#cBL"}\"Переустановить клиент\"{"#cWH"}!" ) ;
				SendClientMessage ( playerid, col_white, !"{"#cBInfo"}* {"#cWH"}Либо прочтите инструкцию в группе ВКонтакте: {"#cBL"}"vk_group"{"#cWH"}!" ) ;
			}

			if ( player_recomended { playerid } == 2 && ! server_test ) return kick_player ( playerid ) ;
		}

		for ( new i = 0 ; i < 12 ; i ++ )
		{
			if ( duel_guns [ playerid ] [ i ] [ 0 ] == 0 || duel_guns [ playerid ] [ i ] [ 1 ] == 0 ) continue ;
			give_weapon ( playerid, duel_guns [ playerid ] [ i ] [ 0 ], duel_guns [ playerid ] [ i ] [ 1 ] ) ;
			duel_guns [ playerid ] [ i ] [ 0 ] = duel_guns [ playerid ] [ i ] [ 1 ] = 0 ;
		}

		new sql_string [ 166 ], _max_warn = 3 ;

		#if defined m_perks
		new _perk_stats = get_perk_info ( playerid, PERK_ADMIN_FRIEND ) ;
		if ( _perk_stats > 0 ) _max_warn = _perk_stats ;
		#endif

		format ( sql_string, sizeof ( sql_string ), "SELECT `w_owner`, `w_end` FROM `users_warns` WHERE `w_owner` = '%d' AND `w_end` > NOW( ) LIMIT %d", p_info [ playerid ] [ id ], _max_warn ) ;
		mysql_tquery ( sql_connection, sql_string, "get_player_warn_count", "i", playerid ) ;

		if ( is_fraction_cover { playerid } != 0 ) SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Вы находитесь в режиме маскировки! Для вывода из маскировки используйте {"#cBL"}/end_cover{"#cGRInfo"}." ) ;
		#if defined m_epass
		if ( stop_event == 0 ) SendClientMessage ( playerid, col_orange, !"* На сервере проходит мероприятие Event Pass. Используйте /einfo и забирайте свои призы." ) ;
		#endif

		if ( p_info [ playerid ] [ promo_hours ] )
		{
		    SendClientMessage ( playerid, col_succes, !"* У Вас есть активный промокод, который действует за отыгранные часы." ) ;
		    SendClientMessage ( playerid, col_succes, !"* Используйте {"#cWH"}/mm - Информация о персонаже - Информация о промокоде{"#cSucces"} для просмотра статистики." ) ;

			sql_string [ 0 ] = EOS ;
			new _p_type = p_info [ playerid ] [ promo_type ] ;
			if ( _p_type == 1 ) format ( sql_string, 144, "* До получения промокода: {"#cWH"}%d час(ов){"#cSucces"}. Приз: {"#cWH"}%s (%d){"#cSucces"}.", p_info [ playerid ] [ promo_hours ], GetVehicleNameEx ( INVALID_VEHICLE_ID, p_info [ playerid ] [ promo_p_id ] ), p_info [ playerid ] [ promo_p_id ] ) ;
			else if ( _p_type == 2 ) format ( sql_string, 144, "* До получения промокода: {"#cWH"}%d час(ов){"#cSucces"}. Приз: {"#cWH"}%s (%d){"#cSucces"}.", p_info [ playerid ] [ promo_hours ], get_accessorie_name ( p_info [ playerid ] [ promo_p_id ] ), p_info [ playerid ] [ promo_p_id ] ) ;
			else if ( _p_type == 3 ) format ( sql_string, 144, "* До получения промокода: {"#cWH"}%d час(ов){"#cSucces"}. Приз: {"#cWH"}Одежда (#%d){"#cSucces"}.", p_info [ playerid ] [ promo_hours ], p_info [ playerid ] [ promo_p_id ] ) ;
            SendClientMessage ( playerid, col_succes, sql_string ) ;
		}

		if ( bonus_activated ) SendClientMessage ( playerid, col_succes, !"* На сервере действует акция! Используйте /boostinfo." ) ;

		if ( ! IsARPName ( p_info [ playerid ] [ name ] ) )
		{
			SendClientMessage ( playerid, col_red, !"* Ваш никнейм не соответствует правилам Role Play режима. Смените никнейм и получите бонус в размере "rename_reward_txt""valute_title"." ) ;
            player_rp_name [ playerid ] = false ;
		}
		else player_rp_name [ playerid ] = true ;

		#if defined m_streamsource
		    CreateAllStreamSourcesForPlayer ( playerid ) ;
		#endif

		#if defined m_quest_menu
			users_education_info ( playerid ) ;
		#endif

		#if defined m_jobs_module
			OnLoadJobsInfo ( playerid, false ) ;
		#endif

		#if defined m_fractions
			OnFractionTasksLoad ( playerid, false ) ;
		#endif

		#if defined m_familys
			familyUserLoading ( playerid, true ) ;
		#endif

		#if defined m_donate
			loadUserDonateCases ( playerid, true ) ;
		#endif

		fractionUserLoading ( playerid, true ) ;

		if ( player_device { playerid } == 2 ) { }
		else PreloadAnimLibs ( playerid ) ;

		sql_string [ 0 ] = EOS ;
		format ( sql_string, sizeof sql_string, "SELECT * FROM `deposit_boxes` WHERE `db_owner` = '%d' LIMIT %d", p_info [ playerid ] [ id ], MAX_BANK_ACCOUNT ) ;
		mysql_tquery ( sql_connection, sql_string, "callback_users_deposit_boxes", "i", playerid ) ;

  		gettime_clear ( playerid, 2 ) ;

  		if ( player_android_id [ playerid ] == true )
		{
            CheckAndroidID ( playerid, 2 ) ;
			player_android_id [ playerid ] = false ;
			update_int_sql ( playerid, "u_android_id", 0 ) ;
		}
	}
	return 1 ;
}

