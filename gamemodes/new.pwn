		case 9: SetPlayerAttachedObject ( playerid, 1, setobject, 1, 0.314998,0.089999,0.001999, -90.599975,-108.399971,91.199943, 1.000000,1.000000,1.000000 ) ;
		case 10: SetPlayerAttachedObject ( playerid, 1, setobject, 1, 0.243998,0.084000,-0.006000, -90.599975,-104.999977,92.599967, 1.000000,1.000000,1.000000 ) ;
