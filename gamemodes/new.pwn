					show_dialog ( playerid, d_help_box, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Бонусы", "{"#cBL"}Бонусы:\n\n\
					{"#cWH"}На сервере имеется множество бонусов для помощи новичкам:\n\n\
					{"#cGRDialog"}- {"#cWH"}Серверный бонус (/boostinfo).\n\
					{"#cGRDialog"}- {"#cWH"}Бонус за получение каждого игрового уровня.\n\
					{"#cGRDialog"}- {"#cWH"}Бонус за отыгранные часы (/mm - Информация о персонаже - Бонусы).\n\n\
					Для активации бонусной рулетки используйте {"#cLY"}/roulette{"#cWH"}.\n\
					Большинство бонусов попадают в {"#cLY"}подарочный инвентарь (/mm){"#cWH"}.", "Назад", "Закрыть" ) ;
				}
				case 12:
