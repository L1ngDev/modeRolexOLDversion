					show_dialog ( playerid, d_help_box, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Организации", "{"#cBL"}Организации:\n\n\
					{"#cWH"}На сервере имеются разные организации:\n\n\
					{"#cGRDialog"}Полиция {"#cWH"}- контроль порядка в игре.\n\
					{"#cGRDialog"}ФСБ {"#cWH"}- конфискация определённых зон, контроллируемых криминалом, внутренняя слежка за организациями.\n\
					{"#cGRDialog"}Мэрия {"#cWH"}- контроль оплаты налогов и опечатка имущества.\n\
					{"#cGRDialog"}СМИ {"#cWH"}- проверка объявлений и развлечение игроков.\n\
					{"#cGRDialog"}Больница {"#cWH"}- выдача мед. карт, лечение больных по всему серверу.\n\
					{"#cGRDialog"}Автошкола {"#cWH"}- контроль лицензионного оборота в игре.\n\
					{"#cGRDialog"}Армия {"#cWH"}- поставка боеприпасов, конфискация криминальных организаций.\n\
					{"#cGRDialog"}Криминальные организации {"#cWH"}- перехват боеприпасов, поставок оружия, посылок.\n\n\
					Для вступления в государственную организаю Вам необходимо следить за чатом и ожидать набора.\n\
					Для ознакомления с местонахождением гос. организаций используйте /gps.\n\n\
					Для вступления в криминальную организацию следите за объявлениями, которые проверяют СМИ.\n\
					Лидеры или их заместители подают объявления о актуальном наборе и о месте его проведения.\n\n\
					Покинуть организацию можно командй {"#cLY"}/leave {"#cWH"}если у Вас приобретено улучшение (/mm - Информация о персонаже)\n\
					или обратившись к человеку, который имеет доступ к уволнению. Узнать можно в чате организации.", "Назад", "Закрыть" ) ;
				}
				case 11:
