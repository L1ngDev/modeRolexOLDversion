	    	if ( player_rentcar [ playerid ] != INVALID_VEHICLE_ID ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы уже арендуете транспорт, сначала откажитесь от старого {"#cRD"}/stoprent" ) ;

