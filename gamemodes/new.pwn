				{
					SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы слишком далеко от объекта недвижимости." ) ;
					DeletePVar ( playerid, "cellar_id" ) ;
					return 1 ;
				}
				if ( cellar_info [ h ] [ cl_owner ] != -1 )
				{
					SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данная недвижимость уже находится в частной собственности." ) ;
					DeletePVar ( playerid, "cellar_id" ) ;
					return 1 ;
				}
				if ( p_info [ playerid ] [ money ] < cellar_info [ h ] [ cl_price ] * for_tax [ 9 ] )
				{
					SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас не хватает средств для приобретения недвижимости." ) ;
					return 1 ;
				}
				if ( p_info [ playerid ] [ cellar ] != -1 )
				{
					SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас в собственности уже есть гараж." ) ;
					return 1 ;
				}
				cellar_info [ h ] [ cl_owner ] = p_info [ playerid ] [ id ] ;
				p_info [ playerid ] [ cellar ] = cellar_info [ h ] [ cl_id ] ;
				format ( cellar_info [ h ] [ cl_owner_name ], MAX_PLAYER_NAME, "%s", p_info [ playerid ] [ name ] ) ;



				give_money ( playerid, - cellar_info [ h ] [ cl_price ] * for_tax [ 9 ] ) ;
				insert_money_log ( playerid, INVALID_PLAYER_ID, - cellar_info [ h ] [ cl_price ] * for_tax [ 9 ], "покупка гаража" ) ;
				SendClientMessage ( playerid, col_gray, !"{"#cGInfo"}* {"#cGRInfo"}Вы успешно приобрели гараж." ) ;
				SendClientMessage ( playerid, col_gray, !"{"#cGInfo"}* {"#cGRInfo"}Вам добавлен слот для т/с. Он пропадёт при продаже гаража." ) ;

				p_info [ playerid ] [ max_veh ] += 1 ;
			    p_info [ playerid ] [ max_veh_timeing ] += 1 ;

			    new query_string [ 168 + ( 9 * 2 ) ] ;
			    format ( query_string, sizeof query_string, "UPDATE `users` SET `u_maxveh` = `u_maxveh` + '1', `u_maxveh_timeing` = `u_maxveh_timeing` + '1', `u_spawnchange` = '4', `u_cellar` = '%d' WHERE `u_id` = '%d' LIMIT 1", p_info [ playerid ] [ cellar ], p_info [ playerid ] [ id ] ) ;
			    mysql_tquery ( sql_connection, query_string ) ;

				p_info [ playerid ] [ spawnchange ] = 4 ;
				DeletePVar ( playerid, "cellar_id" ) ;
				save_cellar ( h ) ;

				set_money_fraction ( 10, 3, cellar_info [ h ] [ cl_price ] * for_tax [ 9 ], true ) ;
			}
			else
			{
				if ( cellar_info [ h ] [ cl_closed ] == 1 )
				{
					DeletePVar ( playerid, "cellar_id" );
					SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Дверь гаража заперта. Чтобы открыть введите {"#cWH"}'/cellarlock'{"#cGRInfo"}." ) ;
					return GameTextForPlayer ( playerid, "~r~CELLAR CLOSED", 2000, 4 );
				}
				set_pos ( playerid, cellar_enter_pos [ 0 ], cellar_enter_pos [ 1 ], cellar_enter_pos [ 2 ], cellar_enter_pos [ 3 ], cellar_interior, cellar_info [ h ] [ cl_id ] ) ;
				send_check_cinfo ( playerid, "Открыть меню гаража", 2, -1, CINFO_CELLAR_MENU_ID, PICTURE_INFO_SUCESS, "Меню", "Закрыть" ) ;
			}
	        return 1 ;
		}
		case d_cellar_action:
		{
			if ( ! response ) return 1 ;
			new house_id = GetPVarInt ( playerid, "cellar_id" ) - 1 ;
			switch ( listitem )
			{
				case 0:
				{
					if ( ! cellar_info [ house_id ] [ cl_improve ] [ 3 ] ) return show_cellarmenu ( playerid ), SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет данного улучшения." ) ;
					new h = GetPVarInt ( playerid, "cellar_id" ) - 1 ;

					new d_string [ 172 ] ;
					format ( d_string, sizeof ( d_string ), "{"#cBL"}Посажено семян: {"#cGRDialog"}%d гр.{"#cBL"} | Урожай: {"#cGRDialog"}%d гр.\n{"#cGRDialog"}- {"#cWH"}Посадить семена\n{"#cGRDialog"}- {"#cWH"}Переработка урожая\n{"#cGRDialog"}- {"#cWH"}Закупка семян",
					cellar_info [ h ] [ cl_seed ], cellar_info [ h ] [ cl_seed_result ] ) ;
					show_dialog ( playerid, d_cellar_cl_ceedmenu, DIALOG_STYLE_LIST, "{"#cBHD"}Подвал", d_string, "Выбрать", "Закрыть" ) ;
				}
				case 1:
				{
					if ( ! cellar_info [ house_id ] [ cl_improve ] [ 0 ] ) return show_cellarmenu ( playerid ), SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет данного улучшения." ) ;
					if ( p_info [ playerid ] [ wanted ] < 1 ) return show_cellarmenu ( playerid ), SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не находитесь в розыске." ) ;
					if ( p_info [ playerid ] [ wanted_result ] > gettime ( ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы недавно уже пытались понизить уровень розыска." ) ;

					new random_result = random ( 3 ) ;
					switch ( random_result )
					{
					    case 0, 2:
					    {
					        SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}У Вас не получилось понизить уровень розыска." ) ;

					        p_info [ playerid ] [ wanted_result ] = gettime ( ) + 3600 ;
					        update_int_sql ( playerid, "u_wanted_result", p_info [ playerid ] [ wanted_result ] ) ;
					    }
					    case 1:
					    {
					        p_info [ playerid ] [ wanted ] -- ;
							SetPlayerWantedLevel( playerid, p_info [ playerid ] [ wanted ] ) ;
							p_info [ playerid ] [ wanted_result ] = gettime ( ) + 3600 ;

							SendClientMessage ( playerid, col_lblue, !"{"#cBInfo"}* {"#cGRInfo"}У Вас получилось понизить уровень розыска." ) ;

							new sql_string [ 93 + 2 + ( 9 * 2 ) ] ;
							format ( sql_string, sizeof sql_string, "UPDATE `users` SET `u_wanted` = '%d', `u_wanted_result` = '%d' WHERE `u_id` = '%d' LIMIT 1",
							p_info [ playerid ] [ wanted ], p_info [ playerid ] [ wanted_result ], p_info [ playerid ] [ id ] ) ;
							mysql_tquery ( sql_connection, sql_string ) ;
					    }
					}
				}
				case 2:
				{
					if ( ! cellar_info [ house_id ] [ cl_improve ] [ 2 ] ) return show_cellarmenu ( playerid ), SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет данного улучшения." ) ;

                    global_string [ 0 ] = EOS ;
                    global_string = "{"#cBL"}Название оружия:\t{"#cBL"}Количество ед.оружия:\n";
					for ( new i = 0 ; i < 7; i ++ )
					{
					    format ( global_string, 1000, "%s%s\t%i\n", global_string, mg_info [ i ][ mg_name ], mg_info [ i ] [ mg_guns ] - 12 ) ;
					}
					show_dialog ( playerid, d_cellar_makegun, DIALOG_STYLE_TABLIST_HEADERS, "{"#cBHD"}Сборка оружия", global_string, "Выбрать", "Закрыть" ) ;
				}
				case 3:
				{
				    new _h_id = GetPVarInt ( playerid, "cellar_id" ) ;
				    if ( _h_id < 1 ) return bad_exit ( playerid ) ;

				    #if defined m_craft
				        craft_ptd_status ( playerid, true ) ;
					#endif
				    return 1 ;
				}
			}
	        return 1 ;
		}
		case d_cellar_makegun:
		{
			if ( ! response ) return 1 ;
			if ( GetInventoryFindItem ( playerid, SUB_INVENTORY, 2153 ) < mg_info [ listitem ] [ mg_guns ] - 12 )
			{
			    new _text_string [ 108 ] ;
				format ( _text_string, 108, "{"#cRInfo"}* {"#cGRInfo"}Вам нужно {"#cRD"}%d{"#cGRInfo"} ед.оружия для сборки этого оружия.", mg_info [ listitem ] [ mg_guns ] - 12 ) ;
			    SendClientMessage ( playerid, col_gray, _text_string ) ;
			    return 1 ;
			}
            show_dialog ( playerid, d_cellar_makegun_, DIALOG_STYLE_INPUT, "{"#cBHD"}Сборка оружия","{"#cWH"}Сколько патронов вы хотите использовать для этого оружия?", "Собрать", "Отмена" ) ;
			set_player_use_listitem ( playerid, listitem ) ;
	        return 1 ;

		}
		case d_cellar_makegun_:
		{
			if ( ! response )
			{
			    global_string [ 0 ] = EOS ;
				global_string = "{"#cBL"}Название оружия:\t{"#cBL"}Количество ед.оружия:\n";
				for(new i = 0; i < 7; i++)
				{
				    format ( global_string, 1000, "%s%s\t%i\n", global_string, mg_info [ i ][ mg_name ], mg_info [ i ] [ mg_guns ] - 12 ) ;
				}
				show_dialog ( playerid, d_cellar_makegun_, DIALOG_STYLE_TABLIST_HEADERS, "{"#cBHD"}Сборка оружия", global_string, "Выбрать", "Закрыть" ) ;
				return 1 ;
			}

   			new ammos = strval ( inputtext ) ;
   			new listitem_gun = get_player_use_listitem ( playerid ) ;
			if ( ammos < 1 || ammos > 500 )
			{
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Можно сделать от {"#cRD"}1 {"#cGRInfo"}до {"#cRD"}500{"#cGRInfo"}." ) ;
				return show_dialog ( playerid, d_cellar_makegun_, DIALOG_STYLE_INPUT, "{"#cBHD"}Сборка оружия","{"#cWH"}Сколько патронов вы хотите использовать для этого оружия?", "Собрать", "Отмена" ) ;
			}
			if ( GetInventoryFindItem ( playerid, SUB_INVENTORY, 2154 ) < ammos ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас нет столько патронов." ) ;

		    give_weapon ( playerid, mg_info [ listitem_gun ] [ mg_gunid ], ammos ) ;

			me_action ( playerid, "сделал(-а) оружие из деталей" ) ;
			SetPlayerChatBubble ( playerid, "собрал оружие", col_light_purple, 30.0, 10000 ) ;

            clear_inventory ( playerid, 2154, ammos ) ;
            if ( GetPlayerWeapon ( playerid ) != mg_info [ listitem_gun ] [ mg_gunid ] )
            {
				clear_inventory ( playerid, 2153, ( mg_info [ listitem_gun ] [ mg_guns ] - 12 ) ) ;
			}
		    return 1 ;
		}
		case d_house:
		{
			if ( ! response )
			{
				new h = GetPVarInt ( playerid, "house_id" ) - 1 ;
				if ( h_info [ h ] [ h_owner ] == -1 )
				{
				    new hint = h_info [ h ] [ h_int ] - 1 ;
					set_pos ( playerid, house_int [ hint ] [ hint_position ] [ 0 ], house_int [ hint ] [ hint_position ] [ 1 ], house_int [ hint ] [ hint_position ] [ 2 ], house_int [ hint ] [ hint_position ] [ 3 ], house_int [ hint ] [ hint_int ], h_info [ h ] [ h_id ] ) ;

					teleport_tick [ playerid ] = GetTickCount ( ) ;
					p_t_info [ playerid ] [ pickup_id ] = pick_house_exit [ hint ] ;

					if ( h_info [ h ] [ h_radio_status ] == 1 )PlayAudioStreamForPlayer ( playerid, h_info [ h ] [ h_radio_url ] ) ;
				}
				else DeletePVar ( playerid, "house_id" ) ;
				return 1 ;
			}
			new h = GetPVarInt ( playerid, "house_id" ) - 1 ;
			if ( h_info [ h ] [ h_owner ] == -1 )
			{
			    if ( admin_info [ playerid ] [ admin ] > 0 && admin_info [ playerid ] [ admin ] < 8 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы администратор." ) ;
			    if ( GetInventoryFindItem ( playerid, SUB_INVENTORY, ITEM_PASSPORT ) < 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет паспорта. Получить его можно в Мэрии." ) ;
				if ( h_info [ h ] [ h_meeting ] > gettime ( ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Дом опечатан. Ожидайте продажи дома." ) ;
                if ( h_info [ h ] [ h_owner ] != -1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данная недвижимость уже находится в частной собственности." ) ;
				if ( ! IsPlayerInRangeOfPoint ( playerid, 2.00, h_info [ h ] [ h_pos ] [ 0 ], h_info [ h ] [ h_pos ] [ 1 ], h_info [ h ] [ h_pos ] [ 2 ] ) )
				{
					SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы слишком далеко от объекта недвижимости." ) ;
					DeletePVar ( playerid, "house_id" ) ;
					return 1 ;
				}

				if ( Iter_Count(player_houses[playerid]) >= p_info [ playerid ] [ max_house ] )
			  	{
					SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас в собственности уже есть недвижимость." ) ;
					return 1 ;
				}

				if ( h_info [ h ] [ h_price_ticket ] > 0 )
				{
					if ( GetInventoryFindItem ( playerid, SUB_INVENTORY, ITEM_FAMILY_TALON ) < h_info [ h ] [ h_price_ticket ] )
					    return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас недостаточно "family_title"." ) ;
				}
				if ( ! h_info [ h ] [ h_price_ticket ] && p_info [ playerid ] [ money ] < h_info [ h ] [ h_price ] * for_tax [ 0 ] )
				{
					SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас не хватает средств для приобретения недвижимости." ) ;
					return 1 ;
				}
				if ( h_info [ h ] [ h_auction_status ] == 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Дом выставлен на аукционе. Вы не можете купить недвижимость." ) ;

				h_info [ h ] [ h_owner ] = p_info [ playerid ] [ id ] ;
				p_info [ playerid ] [ house ] = h_info [ h ] [ h_id ] ;
				format ( h_info [ h ] [ h_owner_name ], MAX_PLAYER_NAME, "%s", p_info [ playerid ] [ name ] ) ;

				h_info [ h ] [ h_closed ] =
				h_info [ h ] [ h_rent_price ] =
				h_info [ h ] [ h_rent_status ] = 0 ;

				for ( new i = 0 ; i < 8 ; i ++ )
				{
				    h_info [ h ] [ h_improve ] [ i ] = 0 ;
				}

				if ( IsValidDynamic3DTextLabel ( h_info [ h ] [ h_safe ] ) ) DestroyDynamic3DTextLabel ( h_info [ h ] [ h_safe ] ) ;
				if ( IsValidDynamic3DTextLabel ( h_info [ h ] [ h_fridge ] ) ) DestroyDynamic3DTextLabel ( h_info [ h ] [ h_fridge ] ) ;
				if ( h_info [ h ] [ h_safe_object ] ) DestroyDynamicObject ( h_info [ h ] [ h_safe_object ] ) ;
				if ( h_info [ h ] [ h_fridge_object ] ) DestroyDynamicObject ( h_info [ h ] [ h_fridge_object ] ) ;

                h_info [ h ] [ h_sell_status ] =
				h_info [ h ] [ h_safe_code ] = 0 ;

				new sql_string [ 144 ] ;
		 		format ( sql_string, sizeof sql_string, "UPDATE `houses` SET `h_improve` = '0|0|0|0|0|0|0|0', `h_sell_status` = '0', `h_safe_code` = '0000' WHERE `h_id` = '%d' LIMIT 1", h_info [ h ] [ h_id ] ) ;
				mysql_tquery ( sql_connection, sql_string ) ;

				DestroyDynamicPickup ( h_info [ h ] [ h_pickup ] ) ;
				if ( ! h_info [ h ] [ h_vw ] ) DestroyDynamicMapIcon ( h_info [ h ] [ h_icon_id ] ) ;

				h_info [ h ] [ h_pickup ] = CreateDynamicPickup ( pickupPropertyUse, 23, h_info [ h ] [ h_pos ] [ 0 ], h_info [ h ] [ h_pos ] [ 1 ], h_info [ h ] [ h_pos ] [ 2 ], h_info [ h ] [ h_vw ], -1 ) ;
				if ( ! h_info [ h ] [ h_vw ] ) h_info [ h ] [ h_icon_id ] = CreateDynamicMapIcon ( h_info [ h ] [ h_pos ] [ 0 ], h_info [ h ] [ h_pos ] [ 1 ], h_info [ h ] [ h_pos ] [ 2 ], radar_propertyR, 0, 0, 0, -1 ) ;

				if ( h_info [ h ] [ h_price_ticket ] > 0 )
				{
					clear_inventory ( playerid, ITEM_FAMILY_TALON, h_info [ h ] [ h_price_ticket ] ) ;
				}
				else
				{
					give_money ( playerid, - h_info [ h ] [ h_price ] * for_tax [ 0 ] ) ;
					insert_money_log ( playerid, INVALID_PLAYER_ID, - h_info [ h ] [ h_price ] * for_tax [ 0 ], "покупка дома" ) ;
				}

				SendClientMessage ( playerid, col_gray, !"{"#cGInfo"}* {"#cGRInfo"}Вы успешно приобрели данную недвижимость. Используйте {"#cGN"}/hmenu{"#cGRInfo"} для управление домом." ) ;
		 		SendClientMessage ( playerid, col_gray, !"{"#cGInfo"}* {"#cGRInfo"}Вам необходимо оплачивать налоги на недвижимость." ) ;
		 		SendClientMessage ( playerid, col_gray, !"{"#cGInfo"}* {"#cGRInfo"}Налоги списываются 1 раз в сутки. Для получения выписки рекомендуем обратиться в банк." ) ;

				if ( h_info [ h ] [ h_garage ] )
				{
					SendClientMessage ( playerid, col_gray, !"{"#cGInfo"}* {"#cGRInfo"}В доме имеется обустроенный гараж, в котором можно парковать т/с." ) ;
					SendClientMessage ( playerid, col_gray, !"{"#cGInfo"}* {"#cGRInfo"}Домашний гараж не даёт дополнительный слот для т/с." ) ;
				}
				if ( IsValidDynamicArea ( h_info [ h ] [ h_zz_area ] ) ) DestroyDynamicArea ( h_info [ h ] [ h_zz_area ] ) ;

				p_info [ playerid ] [ spawnchange ] = 1 ;
				update_int_sql ( playerid, "u_spawnchange", 1 ) ;
				save_house ( h ) ;

				DeletePVar ( playerid, "house_id" ) ;

				#if defined m_familys
					clear_fam_house ( playerid, h + 1, 1 ) ;
				#endif

				new _h_id = h_info [ h ] [ h_id ] ;
				Iter_Add(player_houses[playerid], _h_id);

				if ( ! users_education [ playerid ] [ EDUCATION_BUY_HOUSE ] )
				{
					show_window_monologue (
						playerid,
						5,
						"Поздравляю тебя с покупкой дома! \
						Не забывай оплачивать налоги. Налоги на недвижимость начисляются раз в сутки. \
						Оплатить их можно в банке или банкомате. Используй /gps, чтоб найти ближайший. \
						Если сумма долга превысит "tax_limit", то сотрудники Мэрии опечатать имущество для аукциона.",
						"Местный",
						"Понял"
					) ;

					save_user_education ( playerid, EDUCATION_BUY_HOUSE ) ;
				}

				if ( h_info [ h ] [ h_podezd ] != -1 ) update_podezd ( h_info [ h ] [ h_podezd ] ) ;

				set_money_fraction ( 10, 3, h_info [ h ] [ h_price ] * for_tax [ 0 ], true ) ;
				checking_quest_progress ( playerid, 2, 1, quest_line_medium ) ;
			}
			else
			{
				if ( h_info [ h ] [ h_closed ] == 1 )
				{
					DeletePVar ( playerid, "house_id" );
					SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Дверь дома заперта. Чтобы открыть введите {"#cWH"}'/hlock'{"#cGRInfo"}." ) ;
					return 1 ;
				}
				new hint = h_info [ h ] [ h_int ] - 1 ;
				set_pos ( playerid, house_int [ hint ] [ hint_position ] [ 0 ], house_int [ hint ] [ hint_position ] [ 1 ], house_int [ hint ] [ hint_position ] [ 2 ], house_int [ hint ] [ hint_position ] [ 3 ], house_int [ hint ] [ hint_int ], h_info [ h ] [ h_id ] ) ;

				teleport_tick [ playerid ] = GetTickCount ( ) ;
				p_t_info [ playerid ] [ pickup_id ] = pick_house_exit [ hint ] ;

				if ( h_info [ h ] [ h_radio_status ] == 1 )PlayAudioStreamForPlayer ( playerid, h_info [ h ] [ h_radio_url ]);
				if ( h_info [ h ] [ h_heal ] ) SendClientMessage ( playerid, col_gray, !"* В этом доме имеется аптечка. Чтобы восстановить здоровье используйте {"#cGN"}/hheal{"#cGRInfo"} ({"#cGN"}250"valute_title_"{"#cGRInfo"})");

				new bool: _started = false ;
				if ( Iter_Count(player_houses[playerid]) > 0)
				{
				    foreach(new _h_id: player_houses[playerid])
				    {
				        if ( _h_id == h + 1 )
				        {
				            send_check_cinfo ( playerid, "Открыть меню дома", 2, -1, CINFO_HOUSE_HMENU_ID_1, PICTURE_INFO_SUCESS, "Меню", "Закрыть" ) ;
                            _started = true ;
							break ;
				        }
				    }
				}
				if ( _started == false && p_info [ playerid ] [ rent_house ] == h + 1 )
				{
					send_check_cinfo ( playerid, "Открыть меню дома", 2, -1, CINFO_HOUSE_HMENU_ID_2, PICTURE_INFO_SUCESS, "Меню", "Закрыть" ) ;
					_started = true ;
				}
                if ( _started == false && p_info [ playerid ] [ family ] )
			    {
				    new _family_id = p_info [ playerid ] [ family ] ;
				    if ( family_info [ _family_id - 1 ] [ fam_house ] == h + 1 ) send_check_cinfo ( playerid, "Открыть меню дома", 2, -1, CINFO_HOUSE_HMENU_ID_3, PICTURE_INFO_SUCESS, "Меню", "Закрыть" ) ;
				}
			}
			return 1 ;
		}
		case d_house_buy:
		{
		    if ( ! response ) return DeletePVar ( playerid, "house_id" ) ;
		    show_dialog ( playerid, d_house, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Недвижимость продаётся", "{"#cWH"}На данном этапе у Вас есть выбор,\nкупить или осмотреть дом.\n\nЧто вы выбираете?", "Купить", "Осмотреть" ) ;
			return 1 ;
		}
		case d_sellcellar:
		{
			if ( ! response ) return 1 ;
			new s_house_id = p_info [ playerid ] [ cellar ] - 1 ;
			format ( cellar_info [ s_house_id ] [ cl_owner_name ], MAX_PLAYER_NAME, "Собственность штата" ) ;

			cellar_info [ s_house_id ] [ cl_owner ] = -1 ;
			cellar_info [ s_house_id ] [ cl_closed ] = 0 ;
			give_money ( playerid, cellar_info [ s_house_id ] [ cl_price ] ) ;
			insert_money_log ( playerid, INVALID_PLAYER_ID, cellar_info [ s_house_id ] [ cl_price ], "продажа гаража" ) ;

			p_info [ playerid ] [ cellar ] = -1 ;
			p_info [ playerid ] [ spawnchange ] = 0 ;

			save_cellar ( s_house_id ) ;

			for(new i = 0; i < 4 ; i++)
			{
				cellar_info [ s_house_id ] [ cl_improve ] [ i ] = 0 ;
			}
			new _sql_string [ 178 ] ;
			format ( _sql_string, 128, "UPDATE `cellars` SET `cl_improve` = '0|0|0|0' WHERE `cl_id` = '%d' LIMIT 1", cellar_info [ s_house_id ] [ cl_id ] ) ;
			mysql_tquery ( sql_connection, _sql_string ) ;

			format ( _sql_string, 128, "{"#cGInfo"}* {"#cWH"}Вы продали гараж {"#cGN"}№%d{"#cWH"} за {"#cGN"}%d"valute_title"{"#cWH"}.", cellar_info [ s_house_id ] [ cl_id ], cellar_info [ s_house_id ] [ cl_price ] ) ;
			SendClientMessage ( playerid, col_white, _sql_string ) ;

			p_info [ playerid ] [ max_veh ] -= 1 ;

		    format ( _sql_string, sizeof _sql_string, "UPDATE `users` SET `u_cellar` = '-1', `u_spawnchange` = '0', `u_maxveh` = `u_maxveh` - '1' WHERE `u_id` = '%d' LIMIT 1",
		    p_info [ playerid ] [ id ] ) ;
		    mysql_tquery ( sql_connection, _sql_string ) ;
	        return 1 ;
		}
		case d_c_sell_accept:
		{
			if ( ! response )
			{
			    SendClientMessage ( seller_id [ playerid ], col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок отказался от Вашего предложения." ) ;
				clear_sell_params ( playerid, seller_id [ playerid ] ) ;
				return 1 ;
			}
			else
			{
			    new h_seller_id = seller_id [ playerid ] ;
				if ( p_info [ h_seller_id ] [ cellar ] == -1 )
				{
					clear_sell_params ( playerid, h_seller_id ) ;
					return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока нет гаража." ) ;
				}
				if ( p_info [ playerid ] [ cellar ] != -1 )
				{
					clear_sell_params ( playerid, h_seller_id ) ;
					SendClientMessage ( h_seller_id, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока уже есть гараж." ) ;
					return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас уже есть гараж." ) ;
				}

				new h_price_int = sell_price [ h_seller_id ] ;
				if ( p_info [ playerid ] [ money ] < h_price_int )
				{
					clear_sell_params ( playerid, h_seller_id ) ;
					SendClientMessage ( h_seller_id, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока нет такого количества денег." ) ;
					return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет такого количества денег." ) ;
				}

				if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ h_seller_id ] [ p_pos ] [ 0 ], p_t_info [ h_seller_id ] [ p_pos ] [ 1 ], p_t_info [ h_seller_id ] [ p_pos ] [ 2 ] ) || p_t_info [ playerid ] [ p_data ] [ 1 ] != p_t_info [ h_seller_id ] [ p_data ] [ 1 ] )
				{
					clear_sell_params ( playerid, h_seller_id ) ;
					SendClientMessage ( h_seller_id, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Покупатель слишком далеко." ) ;
					return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы слишком далеко от продавца." ) ;
				}
				if ( buyer_id [ h_seller_id ] != playerid )
				{
					clear_sell_params ( playerid, h_seller_id ) ;
					return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}При покупке гаража произошла ошибка. Повторите попытку." ) ;
				}

				p_info [ playerid ] [ cellar ] = p_info [ h_seller_id ] [ cellar ] ;
				p_info [ h_seller_id ] [ cellar ] = -1 ;

				new cel_id = p_info [ playerid ] [ cellar ] ;
				format ( cellar_info [ cel_id - 1 ] [ cl_owner_name ], MAX_PLAYER_NAME, "%s", p_info [ playerid ] [ name ] ) ;
				cellar_info [ cel_id - 1 ] [ cl_owner ] = p_info [ playerid ] [ id ] ;
				give_money ( playerid, - h_price_int ) ;
				give_money ( h_seller_id, h_price_int ) ;

                insert_money_log ( playerid, h_seller_id, -h_price_int, "покупка гаража у игрока" ) ;
				insert_money_log ( h_seller_id, playerid, h_price_int, "продажа гаража игроку" ) ;

				PlayerPlaySound ( playerid, 1052, 0.0, 0.0, 0.0 ) ;

				new query_string [ 186 ] ;
				format ( query_string, 138,"UPDATE `cellars` SET `cl_owner` = '%d' WHERE `cl_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ], cel_id ) ;
				mysql_tquery ( sql_connection, query_string ) ;

				format ( query_string, 144, "{"#cGN"}* %s{"#cWH"} продал Вам гараж {"#cGN"}№%d {"#cWH"}за {"#cGN"}%d"valute_title"{"#cWH"}.", p_info [ h_seller_id ] [ name ], cellar_info [ cel_id - 1 ] [ cl_id ], h_price_int ) ;
				SendClientMessage ( playerid, col_white, query_string ) ;
				format( query_string, 144, "{"#cGInfo"}* {"#cWH"}Вы продали гараж №%d {"#cGN"}%s{"#cWH"} за {"#cGN"}%d"valute_title"{"#cWH"}.", cellar_info [ cel_id - 1 ] [ cl_id ], p_info [ playerid ] [ name ], h_price_int ) ;
				SendClientMessage ( h_seller_id, col_white, query_string ) ;

				p_info [ h_seller_id ] [ max_veh ] -= 1 ;
			    p_info [ playerid ] [ max_veh ] += 1 ;

			    query_string [ 0 ] = EOS ;
			    format ( query_string, sizeof query_string, "UPDATE `users` SET `u_maxveh` = `u_maxveh` - '1', `u_spawnchange` = '0', `u_cellar` = '-1' WHERE `u_id` = '%d' LIMIT 1", p_info [ h_seller_id ] [ id ] ) ;
			    mysql_tquery ( sql_connection, query_string ) ;

			    query_string [ 0 ] = EOS ;
			    format ( query_string, sizeof query_string, "UPDATE `users` SET `u_maxveh` = `u_maxveh` + '1', `u_spawnchange` = '4', `u_cellar` = '%d' WHERE `u_id` = '%d' LIMIT 1", p_info [ playerid ] [ cellar ], p_info [ playerid ] [ id ] ) ;
			    mysql_tquery ( sql_connection, query_string ) ;

				clear_sell_params ( playerid, h_seller_id ) ;
			}
			return 1 ;
		}
		case d_b_buy:
		{
			if ( ! response )
			{
			    new t = GetPVarInt( playerid, "p_biz_id" ) - 1 ;
			    if ( b_info [ t ] [ b_type ] == bizz_type_bank || b_info [ t ] [ b_type ] == bizz_type_autoshop )
			    {
			        new bis_int = b_info [ t ] [ b_int ] ;
					if ( bis_int == -1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Произошла ошибка при входе в бизнес." ) ;

					set_pos ( playerid, b_interior [ bis_int ] [ i_position ] [ 0 ] , b_interior [ bis_int ] [ i_position ] [ 1 ], b_interior [ bis_int ] [ i_position ] [ 2 ], b_interior [ bis_int ] [ i_position ] [ 3 ], b_interior [ bis_int ] [ i_interior ], b_info [ t ] [ b_id ] + 1000 ) ;

					teleport_tick [ playerid ] = GetTickCount ( ) ;
					p_t_info [ playerid ] [ pickup_id ] = pickup_bizz_exit [ bis_int ] ;

					if ( b_info [ t ] [ b_improve ] [ 1 ] ) SendClientMessage ( playerid, col_gray, !"* В этом бизнесе имеется аптечка. Чтобы восстановить здоровье используйте {"#cGN"}/bheal{"#cGRInfo"} ({"#cGN"}250"valute_title_"{"#cGRInfo"})");

		            if ( b_info [ t ] [ b_radio_status ] == 1 )
					{
			  			SendClientMessage ( playerid, col_gray, !"* В этом бизнесе имеется аудио-система. Чтобы отключить аудио-систему используйте {"#cGN"}/bstop{"#cGRInfo"}");
						if ( IsPlayerAttachedObjectSlotUsed ( playerid, 1 ) ) RemovePlayerAttachedObject ( playerid, 1 ), StopAudioStreamForPlayer ( playerid ) ;
						PlayerPlaySound ( playerid, b_info [ t ] [ b_sound ], 0, 0, 0 ) ;
					}
					else if ( b_info [ t ] [ b_radio_status ] == 2 )
					{
		   				SendClientMessage ( playerid, col_gray, !"* В этом бизнесе имеется аудио-система. Чтобы отключить аудио-систему используйте {"#cGN"}/bstop{"#cGRInfo"}");
					    if ( IsPlayerAttachedObjectSlotUsed ( playerid, 1 ) ) RemovePlayerAttachedObject ( playerid, 1 ), StopAudioStreamForPlayer ( playerid ) ;
					    PlayAudioStreamForPlayer ( playerid, b_info [ t ] [ b_radio_url ] ) ;
					}

		            b_info [ t ] [ b_visitors ] ++ ;
			        return 1 ;
			    }

				DeletePVar ( playerid, "p_biz_id" ) ;
				return 1 ;
			}

			if ( admin_info [ playerid ] [ admin ] > 0 && admin_info [ playerid ] [ admin ] < 8 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы администратор." ) ;
   			if ( GetInventoryFindItem ( playerid, SUB_INVENTORY, ITEM_PASSPORT ) < 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет паспорта. Получить его можно в Мэрии." ) ;
			if ( Iter_Count(player_business[playerid]) >= p_info [ playerid ] [ max_biz ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас уже есть бизнес." ) ;
			if ( p_info [ playerid ] [ b_worker ] != -1 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы являетесь работником бизнеса. Используйте /quitjob." ) ;

			new b = GetPVarInt( playerid, "p_biz_id" ) - 1 ;
			if ( b_info [ b ] [ b_meeting ] > gettime ( ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Бизнес опечатан. Ожидайте продажи бизнеса." ) ;
			if ( ! IsPlayerInRangeOfPoint ( playerid, 2.00, b_info [ b ] [ b_position ] [ 0 ], b_info [ b ] [ b_position ] [ 1 ], b_info [ b ] [ b_position ] [ 2 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не рядом с бизнесом." ) ;
			if ( b_info [ b ] [ b_owner_inc ] != -1 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Этот бизнес не продаётся." ) ;
			if ( b_info [ b ] [ b_donate_price ] )
			{
			    if ( ! get_player_donate ( playerid, b_info [ b ] [ b_donate_price ], 2 ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас недостаточно "donate_title" на основном счёте для покупки бизнеса." ) ;
			}
			else
			{
				if ( b_info [ b ] [ b_price ] * for_tax [ 1 ] > p_info [ playerid ] [ money ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Недостаточно денег для покупки бизнеса." ) ;
			}
			if ( b_info [ b ] [ b_auction_status ] == 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Бизнес выставлен на аукционе. Вы не можете купить недвижимость." ) ;

			format ( b_info [ b ] [ b_owner_name ], MAX_PLAYER_NAME, "%s", p_info [ playerid ] [ name ] ) ;
			b_info [ b ] [ b_owner_inc ] = p_info [ playerid ] [ id ] ;
			p_info [ playerid ] [ business ] = b_info [ b ] [ b_id ] ;

			p_info [ playerid ] [ business_rang ] = b_info [ b ] [ b_settings ] [ 3 ] ;
			update_int_sql ( playerid, "u_business_rang", p_info [ playerid ] [ business_rang ] ) ;

			new query_string [ 200 + MAX_PLAYER_NAME + 1 ] ;
			if ( b_info [ b ] [ b_donate_price ] )
			{
				set_player_donate ( playerid, b_info [ b ] [ b_donate_price ], 2 ) ;

				format ( query_string, 100, "(donate) покупка бизнеса (BIZ: %d)", b_info [ b ] [ b_id ] ) ;
				insert_donate_log ( playerid, INVALID_PLAYER_ID, b_info [ b ] [ b_donate_price ], p_info [ playerid ] [ donate ], query_string ) ;
			}
			else
			{
				give_money ( playerid, - b_info [ b ] [ b_price ] * for_tax [ 1 ] ) ;

				format ( query_string, 100, "покупка бизнеса (BIZ: %d)", b_info [ b ] [ b_id ] ) ;
				insert_money_log ( playerid, INVALID_PLAYER_ID, - b_info [ b ] [ b_price ] * for_tax [ 1 ], query_string ) ;
			}

			Iter_Add ( business_players[p_info [ playerid ] [ business ]], playerid ) ;
			Iter_Add ( player_business[playerid], p_info [ playerid ] [ business ] ) ;

		 	SendClientMessage ( playerid, col_gray, !"{"#cGInfo"}* {"#cGRInfo"}Вы успешно приобрели данный бизнес. Используйте {"#cGN"}/bpanel{"#cGRInfo"} для управление бизнесом." ) ;
		 	SendClientMessage ( playerid, col_gray, !"{"#cGInfo"}* {"#cGRInfo"}Вам необходимо оплачивать налоги на недвижимость." ) ;
		 	SendClientMessage ( playerid, col_gray, !"{"#cGInfo"}* {"#cGRInfo"}Налоги списываются 1 раз в сутки. Для получения выписки рекомендуем обратиться в банк." ) ;
			PlayerPlaySound ( playerid, 1052, 0.0, 0.0, 0.0 ) ;

			format ( query_string, sizeof query_string, "UPDATE `businesses` SET `b_owner_inc` = '%d' WHERE `b_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ], b_info [ b ] [ b_id ] ) ;
			mysql_tquery ( sql_connection, query_string ) ;

			for ( new i ; i < MAX_B_IMPROVE ; i ++ )
			{
			    b_info [ b ] [ b_improve ] [ i ] = 0 ;
			}

			new sql_string [ 128 ] ;
			format ( sql_string, sizeof sql_string, "UPDATE `businesses` SET `b_improve` = '0|0|0|0' WHERE `b_id` = '%d' LIMIT 1", b_info [ b ] [ b_id ] ) ;
			mysql_tquery ( sql_connection, sql_string, "", "" ) ;

			b_info [ b ] [ b_maxproduct ] = 15000 ;

			format ( sql_string, sizeof sql_string, "UPDATE `businesses` SET `b_maxproduct` = '%d' WHERE `b_id` = '%d' LIMIT 1", b_info [ b ] [ b_maxproduct ], b_info [ b ] [ b_id ] ) ;
			mysql_tquery ( sql_connection, sql_string ) ;

			if ( IsValidDynamicArea ( b_info [ b ] [ b_zz_area ] ) ) DestroyDynamicArea ( b_info [ b ] [ b_zz_area ] ) ;

			DeletePVar ( playerid, "p_biz_id" ) ;
			update_blabel ( b ) ;

			if ( ! users_education [ playerid ] [ EDUCATION_BUY_BUSINESS ] )
			{
				show_window_monologue (
					playerid,
					5,
					"Поздравляю тебя с покупкой бизнеса! \
					Не забывай оплачивать налоги. Налоги на недвижимость начисляются раз в сутки. \
					Оплатить их можно в банке или банкомате. Используй /gps, чтоб найти ближайший. \
					Если сумма долга превысит "tax_limit", то сотрудники Мэрии опечатать имущество для аукциона.",
					"Местный",
					"Понял"
				) ;

				save_user_education ( playerid, EDUCATION_BUY_BUSINESS ) ;
			}

			set_money_fraction ( 10, 3, b_info [ b ] [ b_price ] * for_tax [ 1 ], true ) ;
	        return 1 ;
		}
		case d_drop_item:
		{
		    if ( ! response ) return 1 ;

		    new query_string [ 100 ], slotId = get_player_use_listitem ( playerid ),
				invItem = GetUsersInventory ( playerid, INV_ITEM, slotId ),
				invItemCount = GetUsersInventory ( playerid, INV_ITEM_COUNT, slotId ) ;
			format ( query_string, sizeof ( query_string ), "DELETE FROM `users_inventory` WHERE `id` = '%d' LIMIT 1",GetUsersInventory ( playerid, INV_ID, slotId ) ) ;
			mysql_tquery ( sql_connection, query_string ) ;

			GetUsersInventory ( playerid, INV_ID, slotId ) =
			GetUsersInventory ( playerid, INV_ITEM, slotId ) =
			GetUsersInventory ( playerid, INV_ITEM_COUNT, slotId ) =
			GetUsersInventory ( playerid, INV_ITEM_DATE, slotId ) = 0 ;

			updateInventorySlot ( playerid, slotId ) ;

			MODEL_INFO [ invItem ] [ MODEL_COUNT ] -= invItemCount ;
			set_model_count ( invItem, MODEL_INFO [ invItem ] [ MODEL_COUNT ] ) ;

			format ( query_string, sizeof query_string, "%s выбросил %s (%d шт.)", p_info [ playerid ] [ name ], item_name ( invItem ), invItemCount ) ;
			WriteLog ( playerid, TYPE_LOG_INVENTORY, query_string ) ;
		    return 1 ;
		}
		case d_mm_lottery:
		{
		    if ( response )
			{
				if ( page_count [ playerid ] == 1 )
				{
					page_count [ playerid ] = 0 ;
					page_rows [ playerid ] = 0 ;
					show_mainmenu ( playerid ) ;
					return 1 ;
				}
				else
				{
					page_count [ playerid ] -= 1 ;

					new scm_string [ 71 + 9 ] ;
					mysql_format ( sql_connection, scm_string, sizeof ( scm_string  ), "SELECT `u_lottery` FROM `users_lottery` WHERE `u_id` = '%d' LIMIT 50", p_info [ playerid ] [ id ] ) ;
					mysql_tquery ( sql_connection, scm_string, "lottery_callback", "i", playerid ) ;
				}
				return 1 ;
			}
			else
			{
				if ( ofm_formula ( page_count [ playerid ] ) >= page_rows [ playerid ] )
				{
					SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы находитесь на последней странице лотерейных билетов." ) ;

					new scm_string [ 71 + 9 ] ;
					mysql_format ( sql_connection, scm_string, sizeof ( scm_string  ), "SELECT `u_lottery` FROM `users_lottery` WHERE `u_id` = '%d' LIMIT 50", p_info [ playerid ] [ id ] ) ;
					mysql_tquery ( sql_connection, scm_string, "lottery_callback", "i", playerid ) ;

					page_count [ playerid ] = page_count [ playerid ] ;
					return 1 ;
				}
				page_count [ playerid ] += 1 ;

				new scm_string [ 71 + 9 ] ;
				mysql_format ( sql_connection, scm_string, sizeof ( scm_string  ), "SELECT `u_lottery` FROM `users_lottery` WHERE `u_id` = '%d' LIMIT 50", p_info [ playerid ] [ id ] ) ;
				mysql_tquery ( sql_connection, scm_string, "lottery_callback", "i", playerid ) ;
				return 1 ;
			}
		}
		case d_mm:
		{
			if ( ! response ) return 1 ;
			switch ( listitem )
			{
				case 0: show_playermenu ( playerid ) ;
				case 1: show_playersettings ( playerid ) ;
				case 2:
				{
				    show_dialog ( playerid, d_mm_request_1, DIALOG_STYLE_LIST, "{"#cBHD"}Помощь", "\
						{"#cBL"}Выберите аспект помощи:\n\
						{"#cBL"}1. {"#cWH"}Вам нужен спавн?\n\
						{"#cBL"}2. {"#cWH"}Вам нужно выдать скутер?\n\
						{"#cBL"}3. {"#cWH"}Вы перевернулись?\n\
						{"#cBL"}4. {"#cWH"}У Вас застряла машина?\n\
						{"#cBL"}5. {"#cWH"}У Вас сделка?\n \n\
						{"#cLY"}Задать вопрос администрации", "Выбрать", "Закрыть" ) ;
				}
				case 3:
				{
					if ( player_device { playerid } == 2 ) show_inventory_ptd ( playerid, true ) ;
				}
				case 4:
				{
					show_playercommands ( playerid ) ;
				}
				case 5:
				{
				    if ( GetTickCount ( ) - player_name_tick [ playerid ] < 60000 * 5 )
				    {
				        SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Подавать заявку на смену ника можно раз в {"#cRD"}5 минут{"#cGRInfo"}." ) ;
                        return show_mainmenu ( playerid ) ;
				    }

				    player_name_tick [ playerid ] = GetTickCount ( ) ;

				    if ( ! player_rp_name [ playerid ] && p_info [ playerid ] [ level ] < 5 )
				    {
				        show_dialog ( playerid, d_mm_changename, DIALOG_STYLE_INPUT, "{"#cBHD"}Смена нонРП ника", "{ffffff}Ваш никнейм не соответствует правилам Role Play режима.\nСмените никнейм и получите бонус в размере "rename_reward_txt""valute_title".\nНапишите новый никнейм в пустом поле диалогового окна:\n\n{"#cGRDialog"}* Пример: Ivan_Ivanov.", "Принять", "Назад" ) ;
				    }
					else
					{
					    SendClientMessage ( playerid, col_white, !"{"#cBInfo"}* {"#cWH"}У Вас RP Nick_Name или Ваш игровой уровень выше 4, администрация такие имена не меняет. Используйте /donate." ) ;
						show_dialog ( playerid, d_mm_changename, DIALOG_STYLE_INPUT, "{"#cBHD"}Смена нонРП ника", "{ffffff}Напишите новый никнейм в пустом поле диалогового окна, если Вы считаете, что он не соответствует правилам Role Play режима.\n{"#cGRDialog"}* Пример: Ivan_Ivanov.", "Принять", "Назад" ) ;
					}
				}
				case 6:
				{
				    global_string [ 0 ] = EOS ;
				    strcat ( global_string, "{"#cWH"}Если вы пришли на {"#cBL"}"server_name"{"#cWH"}\n" ) ;
					strcat ( global_string, "по приглашению и у Вас есть {"#cLY"}промокод{"#cWH"},\n" ) ;
					strcat ( global_string, "то введите его в поле ниже.\n\n" ) ;

					strcat ( global_string, "{"#cBL"}1.{"#cWH"} При активации {"#cLY"}промокода{"#cWH"}\n" ) ;
					strcat ( global_string, "Вы получите все бонусы,\n" ) ;
					strcat ( global_string, "которые были обещаны.\n\n" ) ;

					new line_string [ 100 ] ;
