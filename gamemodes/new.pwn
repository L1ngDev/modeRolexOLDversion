			        else set_pos ( playerid, duels_pos [ 1 ] [ 0 ], duels_pos [ 1 ] [ 1 ], duels_pos [ 1 ] [ 2 ], duels_pos [ 1 ] [ 3 ], duels_interior [ 0 ], playerid + 1000 ) ;
