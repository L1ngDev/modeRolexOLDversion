stock showTuneDialog ( playerid )
{
	new modelId = getVehicleOrdinalNumber ( GetPlayerVehicleID ( playerid ) ) ;
	if ( veh_data [ modelId ] [ VEHICLE_DUMMY_SIZE ] )
	{
		show_dialog ( playerid, d_tune_box, DIALOG_STYLE_LIST, "{"#cBHD"}Обслуживание", "{"#cBL"}1. {"#cWH"}Шиномонтаж\n{"#cBL"}2. {"#cWH"}Тюнинг-центр\n{"#cBL"}3. {"#cWH"}ТО двигателя\n{"#cBL"}4. {"#cWH"}Детейлинг-центр\n{"#cBL"}5. {"#cWH"}Технический центр", "Выбрать", "Закрыть" ) ;
	}
	else
	{
		show_dialog ( playerid, d_tune_box, DIALOG_STYLE_LIST, "{"#cBHD"}Обслуживание", "{"#cBL"}1. {"#cWH"}Шиномонтаж\n{"#cBL"}2. {"#cWH"}Тюнинг-центр\n{"#cBL"}3. {"#cWH"}ТО двигателя\n{"#cBL"}4. {"#cWH"}Детейлинг-центр\n{"#cBL"}5. {"#cWH"}Технический центр", "Выбрать", "Закрыть" ) ;
	}
	return true ;
}

CMD:g ( playerid )
{
    if ( GetPlayerVehicleID ( playerid ) != 0 && GetPlayerState ( playerid ) == PLAYER_STATE_DRIVER )
	{
	    new veh_id = GetPlayerVehicleID ( playerid ) ;
	    if ( used_area [ playerid ] != -1 && area_info [ used_area [ playerid ] ] [ a_type ] == area_type_tuning )
		{
		    new i = area_info [ used_area [ playerid ] ] [ a_item ] ;
			new _b_id = tuning_info [ i ] [ t_b_id ] ;

		  	new _v_type = veh_info [ veh_id - 1 ] [ v_type ] ;
			switch ( tuning_info [ i ] [ t_type ] )
			{
			    case type_default_tuning:
			    {
			       	if ( _v_type == vehicle_type_family )
				   	{
				   	    if ( p_info [ playerid ] [ family_rang ] < family_info [ p_info [ playerid ] [ family ] - 1 ] [ fam_settings ] [ 3 ] )
							return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Семейный транспорт может тюнинговать лишь лидер семьи." ) ;
				   	}
					else if ( _v_type == vehicle_type_player )
					{
						if ( veh_info [ veh_id - 1 ] [ v_owner ] != p_info [ playerid ] [ id ] )
							return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не владелец данного транспорта." ) ;
					}
					else
						return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данный транспорт нельзя тюнинговать." ) ;

					if ( get_passenger_count ( playerid ) > 0 )  return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Для начала высадите всех пассажиров из транспорта." ) ;

					if ( b_info [ _b_id - 1 ] [ b_close ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Автостанция закрыта." ) ;

					if ( v_bike ( veh_id ) || v_velo ( veh_id ) || v_plane ( veh_id ) || v_boat ( veh_id ) )
						return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Автостанция не обслуживает такие транспортные средства" ) ;

					SetPVarInt ( playerid, "p_biz_id", _b_id ) ;

					SetVehiclePos ( veh_id, tuning_position [ 0 ], tuning_position [ 1 ], tuning_position [ 2 ] ) ;
					SetVehicleZAngle ( veh_id, tuning_position [ 3 ] ) ;
					set_interior ( playerid, tuning_interior ) ;
					set_world ( playerid, playerid + 1 ) ;
					LinkVehicleToInterior( veh_id, tuning_interior ) ;
					SetVehicleVirtualWorld ( veh_id, playerid + 1 ) ;
					SetPlayerArmedWeapon ( playerid, 0 ) ;

					showTuneDialog ( playerid ) ;
					return 1 ;
				}
				case type_perfromance:
				{
			       	if ( _v_type == vehicle_type_family )
				   	{
				   	    if ( p_info [ playerid ] [ family_rang ] < family_info [ p_info [ playerid ] [ family ] - 1 ] [ fam_settings ] [ 3 ] )
							return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Семейный транспорт может тюнинговать лишь лидер семьи." ) ;
				   	}
					else if ( _v_type == vehicle_type_player )
					{
						if ( veh_info [ veh_id - 1 ] [ v_owner ] != p_info [ playerid ] [ id ] )
							return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не владелец данного транспорта." ) ;
					}
					else
						return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данный транспорт нельзя тюнинговать." ) ;

					if ( get_passenger_count ( playerid ) > 0 )  return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Для начала высадите всех пассажиров из транспорта." ) ;

					if ( b_info [ _b_id - 1 ] [ b_close ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Тюнинг-ателье закрыто." ) ;
					if ( v_bike ( veh_id ) || v_velo ( veh_id ) || v_plane ( veh_id ) || v_boat ( veh_id ) )
						return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Тюнинг-ателье не обслуживает такие транспортные средства." ) ;

					SetPVarInt ( playerid, "p_biz_id", _b_id ) ;

					SetVehiclePos ( veh_id, tuning_position [ 0 ], tuning_position [ 1 ], tuning_position [ 2 ] ) ;
					SetVehicleZAngle ( veh_id, tuning_position [ 3 ] ) ;
					set_interior ( playerid, tuning_interior ) ;
					set_world ( playerid, playerid + 1 ) ;
					LinkVehicleToInterior( veh_id, tuning_interior ) ;
					SetVehicleVirtualWorld ( veh_id, playerid + 1 ) ;
					SetPlayerArmedWeapon ( playerid, 0 ) ;

					showTuneDialog ( playerid ) ;
					return 1 ;
				}
			}
		}
		if ( GetPVarInt ( playerid, "p_biz_id" ) )
		{
			new _b_id = GetPVarInt ( playerid, "p_biz_id" ) ;
		    DeletePVar ( playerid, "p_biz_id" ) ;
		    exit_tuning ( playerid, _b_id ) ;
			return 1 ;
		}
		if ( GetPVarInt ( playerid, "house_id" ) > 0 && GetPlayerVirtualWorld ( playerid ) > 0 )
		{
			new h = GetPVarInt ( playerid, "house_id" ) - 1, vehicle_id = GetPlayerVehicleID ( playerid ) ;

		    SetVehiclePos ( vehicle_id, h_info [ h ] [ h_v_pos ] [ 0 ], h_info [ h ] [ h_v_pos ] [ 1 ], h_info [ h ] [ h_v_pos ] [ 2 ] ) ;
			SetVehicleZAngle ( vehicle_id, h_info [ h ] [ h_v_pos ] [ 3 ] ) ;

			set_interior ( playerid, 0 ) ;
			set_world ( playerid, 0 ) ;
			LinkVehicleToInterior( vehicle_id, 0 );
			SetVehicleVirtualWorld ( vehicle_id, 0 );
			SetPlayerArmedWeapon ( playerid, 0 ) ;
			CancelSelectTextDraw ( playerid ) ;

			clear_check_info ( playerid, CINFO_HOUSE_HMENU_ID_1 ) ;
			clear_check_info ( playerid, CINFO_HOUSE_HMENU_ID_2 ) ;
			clear_check_info ( playerid, CINFO_HOUSE_HMENU_ID_3 ) ;

			DeletePVar ( playerid, "house_id" ) ;
			return 1 ;
		}
		if ( GetPVarInt ( playerid, "cellar_id" ) > 0 && GetPlayerVirtualWorld ( playerid ) > 0 )
		{
			new h = GetPVarInt ( playerid, "cellar_id" ) - 1, vehicle_id = GetPlayerVehicleID ( playerid ) ;

			SetVehiclePos ( vehicle_id, cellar_info [ h ] [ cl_pos ] [ 0 ], cellar_info [ h ] [ cl_pos ] [ 1 ], cellar_info [ h ] [ cl_pos ] [ 2 ] ) ;
			SetVehicleZAngle ( vehicle_id, cellar_info [ h ] [ cl_pos ] [ 3 ] ) ;

			set_interior ( playerid, 0 ) ;
			set_world ( playerid, 0 ) ;
			LinkVehicleToInterior ( vehicle_id, 0 ) ;
			SetVehicleVirtualWorld ( vehicle_id, 0 ) ;
			SetPlayerArmedWeapon ( playerid, 0 ) ;
			CancelSelectTextDraw ( playerid ) ;

		   	clear_check_info ( playerid, CINFO_CELLAR_MENU_ID ) ;

			DeletePVar ( playerid, "cellar_id" ) ;
			return 1 ;
		}
	}
	return 1 ;
}

stock show_pass ( playerid, showid )
{
	global_string [ 0 ] = EOS ;

    new rank_name [ 48 ], org_name [ 48 ] ;
	format ( org_name, 48, "Безработный" ) ;
	rank_name = "-";

	if ( p_info [ playerid ] [ member ] > 0 )
	{
		format ( org_name, 48, "%s", f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_name ] ) ;
		if ( p_info [ playerid ] [ rank ] ) format ( rank_name, sizeof rank_name, "%s (%d)", f_rank [ p_info [ playerid ] [ member ] - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ rank ] ) ;
	}
	new gender_name [ 8 ] ;
	if ( p_info [ playerid ] [ gender ] == 0 ) gender_name = "Мужской" ;
	else gender_name = "Женский" ;

	new houses_string [ 22 * 3 ], house_data [ 22 ], count_h = 0 ;
	if ( Iter_Count(player_houses[playerid]) > 1 )
	{
	    foreach(new h: player_houses[playerid])
		{
		    count_h ++ ;
			if ( count_h == 1 ) format ( house_data, sizeof house_data, "дом № %d", h ) ;
			else format ( house_data, sizeof house_data, ", дом № %d", h ) ;
			strcat ( houses_string, house_data ) ;
		}
	}
	else if ( Iter_Count(player_houses[playerid]) == 1 )
	{
		new h = Iter_First(player_houses[playerid]) ;
		format ( houses_string, 32, "дом № %d", h ) ;
	}
	else format ( houses_string, 32, "отсутствует" ) ;

	if ( p_info [ playerid ] [ number ] != 0 )
	{
		format ( global_string, sizeof ( global_string ), "\
		    {"#cBL"}** Данные **\n \n\
			{"#cGRDialog"}Имя: {"#cWH"}%s\n\
			{"#cGRDialog"}Пол: {"#cWH"}%s\n\
			{"#cGRDialog"}Лет прожил: {"#cWH"}%d\n\
			{"#cGRDialog"}Возраст: {"#cWH"}%d\n\
			{"#cGRDialog"}Телефон: {"#cWH"}%d\n \n\
			{"#cBL"}** Трудоустройство **\n \n\
			{"#cGRDialog"}Организация: {"#cWH"}%s\n\
			{"#cGRDialog"}Должность: {"#cWH"}%s\n \n\
			{"#cBL"}** Прописка **\n \n\
			{"#cGRDialog"}Проживание: {"#cWH"}%s\n \n\
			{"#cGRDialog"}Уровень розыска: {"#cWH"}%d\n\
			{"#cGRDialog"}Законопослушность: {"#cWH"}%d\n\
			{"#cGRDialog"}Военный билет: {"#cWH"}%s", p_info [ playerid ] [ name ], gender_name, p_info [ playerid ] [ level ], p_info [ playerid ] [ age ], p_info [ playerid ] [ number ], org_name, rank_name, houses_string, p_info [ playerid ] [ wanted ], p_info [ playerid ] [ law_obedience ], ( GetInventoryFindItem ( playerid, SUB_INVENTORY, ITEM_MILITARY_ID ) > 0 ) ? ( "есть" ) : ( "нет" ) ) ;
	}
	else
	{
		format ( global_string, sizeof ( global_string ),"\
			{"#cBL"}** Данные **\n \n\
			{"#cGRDialog"}Имя: {"#cWH"}%s\n\
			{"#cGRDialog"}Пол: {"#cWH"}%s\n\
			{"#cGRDialog"}Лет прожил: {"#cWH"}%d\n\
			{"#cGRDialog"}Возраст: {"#cWH"}%d\n\
			{"#cGRDialog"}Телефон: {"#cWH"}отсутствует\n \n\
			{"#cBL"}** Трудоустройство **\n \n\
			{"#cGRDialog"}Организация: {"#cWH"}%s\n\
			{"#cGRDialog"}Должность: {"#cWH"}%s\n \n\
			{"#cBL"}** Прописка **\n \n\
			{"#cGRDialog"}Проживание: {"#cWH"}%s\n \n\
			{"#cGRDialog"}Уровень розыска: {"#cWH"}%d\n\
			{"#cGRDialog"}Законопослушность: {"#cWH"}%d\n\
			{"#cGRDialog"}Военный билет: {"#cWH"}%s", p_info [ playerid ] [ name ], gender_name, p_info [ playerid ] [ level ], p_info [ playerid ] [ age ], org_name, rank_name, houses_string, p_info [ playerid ] [ wanted ], p_info [ playerid ] [ law_obedience ], ( GetInventoryFindItem ( playerid, SUB_INVENTORY, ITEM_MILITARY_ID ) > 0 ) ? ( "есть" ) : ( "нет" ) ) ;
	}
	show_dialog ( showid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Паспорт", global_string, "Закрыть", "" ) ;
	return 1 ;
}

stock show_player_extraaction ( playerid )
{
    #if defined m_inventory_module
		if ( used_inventory [ playerid ] == true ) return 1 ;
	#endif

	#if defined m_craft
	    if ( used_craft [ playerid ] == true ) return 1 ;
	#endif

 	if ( GetPlayerState ( playerid ) == PLAYER_STATE_ONFOOT )
	{
	    new bool: _player_radius = false ;
		foreach(new i: streamed_players[playerid])
		{
			if ( ! IsPlayerInRangeOfPoint ( playerid, 1.5, p_t_info [ i ] [ p_pos ] [ 0 ], p_t_info [ i ] [ p_pos ] [ 1 ], p_t_info [ i ] [ p_pos ] [ 2 ] ) ) continue ;

			SetPVarInt ( playerid, "playerTarget", i ) ;

			new header_string [ 39 + MAX_PLAYER_NAME ] ;
			format ( header_string, sizeof header_string, "{"#cBHD"}Взаимодействие с {"#cWH"}%s", p_info [ i ] [ name ] ) ;
			show_dialog ( playerid, d_player_target, DIALOG_STYLE_LIST, header_string, "{"#cBL"}1.{ffffff} Показать паспорт\n{"#cBL"}2.{ffffff} Показать лицензии\n{"#cBL"}3.{ffffff} Показать медицинскую карту\n{"#cBL"}4.{ffffff} Показать трудовую книжку\n{"#cBL"}5.{ffffff} Передать оружие\n{"#cBL"}6.{ffffff} Передать 10 единиц наркотиков", "Выбрать", "Закрыть" ) ;

			_player_radius = true ;
			return 1 ;
		}

		if ( ! _player_radius ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Рядом с Вами нет игроков." ) ;
	}
    else if ( GetPlayerState ( playerid ) == PLAYER_STATE_DRIVER )
	{
	    callcmd::cpanel ( playerid ) ;
	}
	return 1 ;
}

callback: show_complaints ( playerid )
{
	new fromname [ MAX_PLAYER_NAME ], toname [ MAX_PLAYER_NAME ], todate [ MAX_PLAYER_NAME ], toid, rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows )
	{
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Ничего не найдено." ) ;
		page_count [ playerid ] = 0 ;
		return 1 ;
	}

	new rows_list = page_count [ playerid ] - 1 ;
	page_rows [ playerid ] = rows ;

	global_string [ 0 ] = EOS ;
	new line_string [ 128 ], row_count ;
	strcat ( global_string, "{"#cBL"}От игрока:\t{"#cBL"}На игрока:\t{"#cBL"}Дата:\n" ) ;
	for ( new i = rows_list * 10 ; i <  rows_list * 10 + 10 ; i ++ )
	{
		if ( i >= rows ) break ;

        toid = cache_get_field_content_int ( i, "u_id", sql_connection ) ;

		set_player_listitem_values ( playerid, i - rows_list * 10, toid ) ;

		cache_get_field_content ( i, "u_fromname", fromname, sql_connection, MAX_PLAYER_NAME ) ;
		cache_get_field_content ( i, "u_toname", toname, sql_connection, MAX_PLAYER_NAME ) ;
		cache_get_field_content ( i, "u_date", todate, sql_connection, MAX_PLAYER_NAME ) ;

		format ( line_string, sizeof ( line_string ), "{"#cWH"}%s\t{"#cGRDialog"}%s{"#cWH"}\t%s\n", fromname, toname, todate ) ;
		strcat ( global_string, line_string ) ;

		row_count ++ ;
	}

	if ( rows_list > 0 )
	{
		strcat ( global_string, "{"#cBL"}Предыдущая страница\t \n" ) ;
		set_player_use_page ( playerid, row_count, 0 ) ;
		row_count ++ ;
	}
	if ( ofm_formula ( page_count [ playerid ] ) < rows )
	{
		strcat ( global_string, "{"#cBL"}Следующая страница\t \n" ) ;
		set_player_use_page ( playerid, row_count, 1 ) ;
	}

	show_dialog ( playerid, d_complaints_list, DIALOG_STYLE_TABLIST_HEADERS, "{"#cBHD"}Список жалоб", global_string, "Выбрать", "Закрыть" ) ;
	return 1 ;
}

stock SetPlayerTextStyle ( playerid, style )
{
	p_info [ playerid ] [ textstyle ] = style ;
	update_int_sql ( playerid, "u_textstyle", style ) ;
	return 1 ;
}

stock SetPlayerWalkingStyle ( playerid, style )
{
	p_info [ playerid ] [ walkstyle ] = style ;
	update_int_sql ( playerid, "u_walkstyle", style ) ;
	return 1 ;
}

callback: walking_style_callback ( playerid )
{
    if ( ! p_info [ playerid ] [ walkstyle ] ) return 1 ;

    static const walkInfo [ ] [ 16 ] =
	{
		{ "WALK_player" }, { "WALK_civi" }, { "WALK_gang1" }, { "WALK_gang2" }, { "WALK_old" }, { "WALK_fatold" },
		{ "WALK_fat" }, { "WOMAN_walknorm" }, { "WOMAN_walkbusy" }, { "WOMAN_walkpro" }, { "WOMAN_walksexy" }, { "WALK_drunk" }, { "Walk_Wuzi" }
	} ;

	new keys, updown, leftright;
    GetPlayerKeys(playerid,keys,updown,leftright);
	if ( ( keys & KEY_WALK && updown & KEY_UP ) || ( keys & KEY_WALK && updown & KEY_DOWN ) || ( keys & KEY_WALK && leftright & KEY_LEFT ) || ( keys & KEY_WALK && leftright & KEY_RIGHT ) )
    {
        KillTimer ( walk_timer [ playerid ] ), walk_timer [ playerid ] = -1 ;
		//ApplyAnimation(playerid,"PED","SEAT_down",4.1,0,0,0,1,1,1);
        ApplyAnimation(playerid,"PED", walkInfo [ p_info [ playerid ] [ walkstyle ] - 1],4.1,1,1,1,1,1);
        walk_timer [ playerid ] = SetTimerEx ( "walking_style_callback", 400, 0, "d", playerid ) ;
    }
    else ApplyAnimation(playerid,"PED", walkInfo [ p_info [ playerid ] [ walkstyle ] - 1],4.0,0,0,0,0,1), KillTimer ( walk_timer [ playerid ] ), walk_timer [ playerid ] = -1 ;
	return 1 ;
}

stock v_boat ( vehicleid, _typing = 0 )
