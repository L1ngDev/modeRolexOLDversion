callback: callback_reportlist ( playerid )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows )
	{
	    off_time_account [ playerid ] = 0 ;
	    off_time_status { playerid } = 0 ;
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У выбранного Вами аккаунта не найдено отвеченных репортов." ) ;
		page_count [ playerid ] = 0 ;
		return 1 ;
	}
	new rows_list = page_count [ playerid ] - 1 ;
	page_rows [ playerid ] = rows ;
	new line_string [ 128 ], _count_rep = 0 ;

	global_string [ 0 ] = EOS ;
	strcat ( global_string, "{"#cLY"}Дата\t\t\tРепорты\n\n{ffffff}" ) ;
	for ( new i = rows_list * 10 ; i <  rows_list * 10 + 10 ; i ++ )
	{
		if ( i >= rows ) break ;

		new online_sec, date_online [ 16 ] ;
    	cache_get_field_content ( i, "date", date_online, sql_connection, 16 ) ;
		online_sec = cache_get_field_content_int ( i, "report", sql_connection ) ;
		_count_rep += online_sec ;

		format ( line_string, sizeof ( line_string ), "{"#cWH"}%s\t\t%d\n", date_online, online_sec ) ;
		strcat ( global_string, line_string ) ;
	}

	format ( line_string, sizeof line_string, "\n\n{ffffff}Всего ответов (на странице): %d", _count_rep ) ;
	strcat ( global_string, line_string ) ;

	format ( line_string, sizeof line_string, "{"#cBHD"}Репорты игрока: {"#cWH"}№%d", off_time_account [ playerid ] ) ;
	show_dialog ( playerid, d_report_list, DIALOG_STYLE_MSGBOX, line_string, global_string, "Назад", "Далее" ) ;
	return 1 ;
}

CMD:offstats( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 6 )return 1 ;
	if (sscanf ( params, "s[24]", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /offstats [имя]" ) ;
	if ( get_player_admin_level ( params [ 0 ] ) > 7 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Запрещено просматривать информацию данного игрока." ) ;

	new query_string [ 187 + MAX_PLAYER_NAME ] ;
	format ( query_string, sizeof query_string, "SELECT `u_id`, `u_name`, `u_level`, `u_exp`, `u_phohe_balance`, `u_wanted`, `u_gender`, `u_job`, `u_maxveh` FROM `users` WHERE `u_name` = '%s' LIMIT 1", params [ 0 ] ) ;
	mysql_tquery ( sql_connection, query_string, "offstats_callback", "i", playerid ) ;
 	return 1 ;
}

callback: offstats_callback ( playerid )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows )
	{
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данный аккаунт не найден в базе данных." ) ;
		return 1 ;
	}
	else
	{
		new gs_id,
			gs_name [ MAX_PLAYER_NAME ],
			gs_level,
			gs_exp,
			gs_phone_money,
			gs_suspect,
			gs_gender,
			gs_job,
			gs_maxveh ;


		cache_get_field_content ( 0, "u_name", gs_name, sql_connection, MAX_PLAYER_NAME ) ;

		gs_id = cache_get_field_content_int ( 0, "u_id", sql_connection ) ;
		gs_level = cache_get_field_content_int ( 0, "u_level", sql_connection ) ;
		gs_exp = cache_get_field_content_int ( 0, "u_exp", sql_connection ) ;
		gs_phone_money = cache_get_field_content_int ( 0, "u_phohe_balance", sql_connection ) ;
		gs_suspect = cache_get_field_content_int ( 0, "u_wanted", sql_connection ) ;
		gs_gender = cache_get_field_content_int ( 0, "u_gender", sql_connection ) ;
		gs_job = cache_get_field_content_int ( 0, "u_job", sql_connection ) ;
		gs_maxveh = cache_get_field_content_int ( 0, "u_maxveh", sql_connection ) ;

		static const mm_gender [ ] [ ] = {
		"мужчина",
		"женщина" } ;

		static const job_status [ 10 ] [ 22 ] = {
		"Водитель автобуса",
		"Таксист",
		"Механик",
		"Дальнобойщик",
		"Развозчик продуктов",
		"Развозчик топлива",
		"Инкассатор",
		"Пожарный",
		"Мореплаватель",
		"Вертолетчик" } ;

		new house_data [ 100 ] ;
		format ( house_data, sizeof ( house_data ), "%s", get_player_house_info ( gs_id ) ) ;
		new business_date [ 144 ] ;
		format ( business_date, sizeof ( business_date ), "%s", get_player_business_info ( gs_id ) ) ;

		new job_data [ 22 ];
		if ( gs_job != 0 && gs_job < 50 )format ( job_data, sizeof ( job_data ), "%s", job_status [ gs_job - 1 ] ) ;
		else format ( job_data, sizeof ( job_data ), "отсутствует" ) ;

		new _veh_count = 0 ;
		new query_string [ 64 + 11 + 4 ] ;
		format ( query_string, sizeof ( query_string ), "SELECT `v_owner` FROM `users_vehicles` WHERE `v_owner` = '%d'", gs_id ) ;
		new Cache: result = mysql_query ( sql_connection, query_string ) ;
		_veh_count = cache_num_rows ( ) ;
		cache_delete ( result ) ;

		format ( global_string, sizeof global_string, "\
			{"#cGRDialog"}Имя:\t{"#cWH"}%s\n\
			{"#cGRDialog"}Номер аккаунта:\t{"#cWH"}%d\n\
			{"#cGRDialog"}Уровень:\t{"#cWH"}%d\n\
			{"#cGRDialog"}Очки опыта:\t{"#cWH"}%d из %d\n\
			{"#cGRDialog"}На счету телефона:\t{"#cWH"}%d\n\
			 \t \n\
			{"#cGRDialog"}Уровень розыска:\t{"#cWH"}%d\n\
			 \t \n\
			{"#cGRDialog"}Пол:\t{"#cWH"}%s\n\
			{"#cGRDialog"}Работа:\t{"#cWH"}%s\n\
			{"#cGRDialog"}Проживание:\t{"#cWH"}%s\n\
			{"#cGRDialog"}Бизнес:\t{"#cWH"}%s\n\
			 \t \n\
			{"#cGRDialog"}Слотов под т/с:\t{"#cWH"}%d шт\n\
			{"#cGRDialog"}Транспортных средств:\t{"#cWH"}%d шт",

		gs_name,
		gs_id,
		gs_level,
		gs_exp, ( gs_level + 1 ) * 4,
		gs_phone_money,

		gs_suspect,

		mm_gender [ gs_gender ],
		job_data,
		house_data,
		business_date,

		gs_maxveh,
		_veh_count ) ;
		show_dialog ( playerid, d_none, DIALOG_STYLE_TABLIST, "{"#cBHD"}Статистика игрока", global_string, "Закрыть", "" ) ;
	}
	return 1 ;
}

stock get_player_business_info ( player_id )
{
	new _b_count = 0 ;

	static const _str [ ] = "SELECT `b_id`,`b_name` FROM `businesses` WHERE `b_owner_inc` = '%d' LIMIT %d" ;
	new query_string [ sizeof _str + 9 + 4 ], line_string [ 144 ] ;
	format ( query_string, sizeof ( query_string ), _str, player_id, max_biz_gold ) ;
	new Cache: result = mysql_query ( sql_connection, query_string ) ;
	_b_count = cache_num_rows ( ) ;
	if ( _b_count > 0 )
	{
	    new _b_name [ MAX_PLAYER_NAME ], _b_id ;
	    for ( new i = 0 ; i < _b_count ; i ++ )
	    {
	    	_b_id = cache_get_field_content_int ( i, "b_id", sql_connection ) ;
			cache_get_field_content ( i, "b_name", _b_name, sql_connection, MAX_PLAYER_NAME ) ;
			if ( i == 0 ) format ( query_string, sizeof query_string, "%s (ID: %d)", _b_name, _b_id ) ;
			else format ( query_string, sizeof query_string, ", %s (ID: %d)", _b_name, _b_id ) ;
			strcat ( line_string, query_string ) ;
		}
	}
	else
	{
	    format ( line_string, sizeof line_string, "Нет" ) ;
	}
	cache_delete ( result ) ;
	return line_string ;
}

stock get_player_house_info ( player_id )
{
	new _h_count = 0 ;

	static const _str [ ] = "SELECT `h_id` FROM `houses` WHERE `h_owner` = '%d' LIMIT %d" ;
	new query_string [ sizeof _str + 9 + 4 ], line_string [ 100 ] ;
	format ( query_string, sizeof ( query_string ), _str, player_id, max_h_gold ) ;
	new Cache: result = mysql_query ( sql_connection, query_string ) ;
	_h_count = cache_num_rows ( ) ;
	if ( _h_count > 0 )
	{
        new _h_id ;
	    for ( new i = 0 ; i < _h_count ; i ++ )
	    {
	    	_h_id = cache_get_field_content_int ( i, "h_id", sql_connection ) ;
			if ( i == 0 ) format ( query_string, sizeof query_string, "дом №%d", _h_id ) ;
			else format ( query_string, sizeof query_string, ", дом №%d", _h_id ) ;
			strcat ( line_string, query_string ) ;
		}
	}
	else
	{
	    format ( line_string, sizeof line_string, "Нет" ) ;
	}
	cache_delete ( result ) ;
	return line_string ;
}

CMD:get( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 6 )return 1 ;
	if (sscanf ( params, "u", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /get [ид]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( admin_info [ playerid ] [ dostup ] [ 5 ] != 1 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет полномочий для просмотра информации." ) ;
	if ( get_player_admin_level ( p_info [ params [ 0 ] ] [ name ] ) > 7 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Запрещено просматривать информацию данного игрока." ) ;
	new query_string [ MAX_PLAYER_NAME + 222 ] ;
	format ( query_string, sizeof query_string, "SELECT `u_id`,`u_name`,`u_money`,`u_level`,`u_donate`,`u_donate_bonus`,`u_ip_registration`,`u_last_ip`,`u_date_registration`,`u_last_date` FROM `users` WHERE `u_id` = '%d' LIMIT 1", p_info [ params [ 0 ] ] [ id ] ) ;
	mysql_tquery ( sql_connection, query_string, "get_callback", "i", playerid ) ;
 	return 1 ;
}

CMD:getip( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 2 )return 1 ;
	if (sscanf ( params, "u", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /getip [ид]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( get_player_admin_level ( p_info [ params [ 0 ] ] [ name ] ) > 7 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Запрещено просматривать информацию данного игрока." ) ;

	new scm_string [ 96 ] ;
	format ( scm_string, sizeof ( scm_string  ),"{"#cBAdmin"}[A] {"#cGRAdmin"}Никнейм: %s | IP: %s", p_info [ params [ 0 ] ] [ name ], p_t_info [ params [ 0 ] ] [ p_ip ] ) ;
	SendClientMessage ( playerid, col_admin, scm_string ) ;
 	return 1 ;
}

CMD:offget( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 6 )return 1 ;
	if (sscanf ( params, "s[24]", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /offget [имя]" ) ;
	if ( admin_info [ playerid ] [ dostup ] [ 5 ] != 1 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет полномочий для просмотра информации." ) ;
	if ( get_player_admin_level ( params [ 0 ] ) > 7 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Запрещено просматривать информацию данного игрока." ) ;
	new query_string [ MAX_PLAYER_NAME + 222 ] ;
	format ( query_string, sizeof query_string, "SELECT `u_id`,`u_name`,`u_money`,`u_level`,`u_donate_bonus`,`u_ip_registration`,`u_last_ip`,`u_date_registration`,`u_last_date` FROM `users` WHERE `u_name` = '%s' LIMIT 1", params [ 0 ] ) ;
	mysql_tquery ( sql_connection, query_string, "get_callback", "i", playerid ) ;
 	return 1 ;
}

CMD:tp ( playerid )
{
	if ( admin_info [ playerid ] [ admin ] < 2 && ! tester_admin [ playerid ] ) return 1 ;
	ShowTpDialog ( playerid ) ;
	return 1 ;
}

callback: get_callback ( playerid )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows )
	{
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данный аккаунт не найден в базе данных." ) ;
		DeletePVar ( playerid, "off_get_status" ) ;
		return 1 ;
	}
	else
	{
		new gs_name [ MAX_PLAYER_NAME ],
			gs_increment,
			gs_regdate [ 26 ],
			gs_money,
			gs_level,
			gs_regip [ 16 ],
			gs_lastip [ 16 ],
			gs_lastdate [ 26 ],
			gs_donate_bonus ;

		cache_get_field_content ( 0, "u_name", gs_name, sql_connection, MAX_PLAYER_NAME ) ;
		cache_get_field_content ( 0, "u_ip_registration", gs_regip, sql_connection, 16 ) ;
		cache_get_field_content ( 0, "u_last_ip", gs_lastip, sql_connection, 16 ) ;
		cache_get_field_content ( 0, "u_date_registration", gs_regdate, sql_connection, MAX_PLAYER_NAME ) ;
		cache_get_field_content ( 0, "u_last_date", gs_lastdate, sql_connection, MAX_PLAYER_NAME ) ;

		gs_increment = cache_get_field_content_int ( 0, "u_id", sql_connection ) ;
		gs_money = cache_get_field_content_int ( 0, "u_money", sql_connection ) ;
		gs_level = cache_get_field_content_int ( 0, "u_level", sql_connection ) ;
		gs_donate_bonus = cache_get_field_content_int ( 0, "u_donate_bonus", sql_connection ) ;

		global_string [ 0 ] = EOS ;
		new pvar_string [ 16 ] ;

		if ( gs_money > 1800000000 || gs_money < -1800000000 ) gs_money = 1800000000 ;

		strcat ( global_string, "{"#cBL"}Информация о игроке:" ) ;

		strcat ( global_string, "\n\n{"#cWH"}Номер аккаунта:{"#cGN"} " ) ;
		valstr ( pvar_string, gs_increment ) ;
		strcat ( global_string, pvar_string ) ;
		strcat ( global_string, "\n{"#cWH"}Наличные:{"#cGN"} " ) ;
		valstr ( pvar_string, gs_money ) ;
		strcat ( global_string, pvar_string ) ;
		strcat ( global_string, ""valute_title_"" ) ;
		strcat ( global_string, "\n{"#cWH"}Уровень:{"#cGN"} " ) ;
		valstr ( pvar_string, gs_level ) ;
		strcat ( global_string, pvar_string ) ;
		strcat ( global_string, "\n{"#cWH"}Бонусный счёт:{"#cGN"} " ) ;
		valstr ( pvar_string, gs_donate_bonus ) ;
		strcat ( global_string, pvar_string ) ;

        strcat ( global_string, "\n\n{"#cBL"}Открытые счета:" ) ;

        new bank_count = 0, query_string [ 83 + 9 ] ;
		format ( query_string, sizeof query_string, "SELECT `db_id`, `db_money` FROM `deposit_boxes` WHERE `db_owner` = '%d' LIMIT 10", gs_increment ) ;
	 	new Cache: result = mysql_query ( sql_connection, query_string ) ;
	 	bank_count = cache_num_rows ( ) ;

		if ( bank_count )
		{
			for ( new j = 0 ; j < bank_count ; j ++ )
			{
				new _db_id = cache_get_field_content_int ( j, "db_id", sql_connection ) ;
				new _db_money = cache_get_field_content_int ( j, "db_money", sql_connection ) ;

				if ( _db_money > 1800000000 || _db_money < -1800000000 ) _db_money = 1800000000 ;

             	strcat ( global_string, "\n{"#cWH"}" ) ;

	            strcat ( global_string, "№" ) ;
				valstr ( pvar_string, _db_id ) ;
				strcat ( global_string, pvar_string ) ;
				strcat ( global_string, " - " ) ;
			 	strcat ( global_string, "{"#cGN"}" ) ;
			 	valstr ( pvar_string, _db_money ) ;
				strcat ( global_string, pvar_string ) ;
				strcat ( global_string, ""valute_title_"" ) ;
			}
		}
		else strcat ( global_string, "\n{"#cRInfo"}* {"#cGRInfo"}У игрока нет открытых банковских счетов." ) ;
		cache_delete ( result ) ;

		strcat ( global_string, "\n\n{"#cWH"}IP адрес(регист.):{"#cGN"} " ) ;
		strcat ( global_string, gs_regip ) ;
		strcat ( global_string, "\n{"#cWH"}IP адрес(послед.):{"#cGN"} " ) ;
		strcat ( global_string, gs_lastip ) ;

		strcat ( global_string, "\n\n{"#cWH"}Дата регистрации:{"#cGN"} " ) ;
		strcat ( global_string, gs_regdate ) ;
		strcat ( global_string, "\n{"#cWH"}Дата послед. пребывания:{"#cGN"} " ) ;
		strcat ( global_string, gs_lastdate ) ;

		strcat ( global_string, "\n\n{"#cBL"}Техническая информация игрока:" ) ;

		new header_string [ MAX_PLAYER_NAME + 9 ] ;
		strcat ( header_string, "{"#cBL"}" ) ;
		strcat ( header_string, gs_name ) ;
		format ( header_string, sizeof ( header_string  ), "{"#cBL"}%s", gs_name ) ;

		if ( GetPVarInt ( playerid, "off_get_status" ) > 0 )
		{
		    show_dialog ( playerid, d_offget, DIALOG_STYLE_MSGBOX, header_string, global_string, "Назад", "Закрыть" ) ;

			new scm_string [ 128 ] ;
			format ( scm_string, sizeof scm_string, "Администратор %s /(off)get %s", p_info [ playerid ] [ name ], gs_name ) ;
			WriteLog ( playerid, TYPE_LOG_ADMIN, scm_string ) ;

			format ( scm_string, sizeof ( scm_string ), "{"#cBAdmin"}[A]{"#cGRAdmin"} %s[%d] просматривает информацию о игроке %s.", p_info [ playerid ] [ name ], playerid, gs_name ) ;
			foreach(new i: admin_players) SendClientMessage ( i, col_admin, scm_string ) ;
			return 1 ;
		}

		show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, header_string, global_string, "Закрыть", "" ) ;

		new scm_string [ 128 ] ;
		format ( scm_string, sizeof scm_string, "Администратор %s использовал /get aka /offget", p_info [ playerid ] [ name ] ) ;
		WriteLog ( playerid, TYPE_LOG_ADMIN, scm_string ) ;

		format ( scm_string, sizeof ( scm_string ), "{"#cBAdmin"}[A]{"#cGRAdmin"} %s[%d] просматривает информацию о игроке %s | /get aka /offget", p_info [ playerid ] [ name ], playerid, gs_name ) ;
		admin_message ( 2, col_admin, scm_string ) ;
	}
	return 1;
}

alias:accept_ban("ab")
CMD:accept_ban ( playerid, params [ ] )
{
    if ( admin_info [ playerid ] [ admin ] < 5 )
		return 1 ;
    if ( sscanf ( params, "u", params [ 0 ] ) )
		return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /accept_ban [ид/имя]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) )
		return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( ! admin_info [ params [ 0 ] ] [ ban_day ] )
	    return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}На этого игрока нет запроса." ) ;
    if ( admin_info [ playerid ] [ admin ] < admin_info [ params [ 0 ] ] [ admin ] )
		return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете выдать наказание администратору выше уровнем." ) ;

	new scm_string [ 50 ] ;
	format ( scm_string, sizeof scm_string, "%s (%s)", admin_info [ params [ 0 ] ] [ reason_punish ], admin_info [ params [ 0 ] ] [ reason_admin ] ) ;

    new clf_string [ 128 ] ;
    format ( clf_string, sizeof clf_string, "%d %d %s", params [ 0 ], admin_info [ params [ 0 ] ] [ ban_day ], scm_string ) ;
	callcmd::ban ( playerid, clf_string ) ;
	return 1 ;
}

CMD:ban ( playerid, params [ ] )
{
	if ( tester_admin [ playerid ] ) return tester_no_access ( playerid ) ;
	if ( admin_info [ playerid ] [ admin ] < 1 ) return 1 ;
	if ( sscanf ( params, "uds[42]", params [ 0 ], params [ 1 ], params [ 2 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /ban [ид/имя] [кол-во дней] [причина]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( admin_info [ playerid ] [ admin ] > 6 )
	{
		if ( params [ 1 ] < 1 || params [ 1 ] > 2000 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Разрешено банить только от 1 до 2000 дней." ) ;
	}
	else
	{
		if ( params [ 1 ] < 1 || params [ 1 ] > 30 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Разрешено банить только от 1 до 30 дней." ) ;
	}
	if ( admin_info [ playerid ] [ admin ] < admin_info [ params [ 0 ] ] [ admin ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете выдать наказание администратору выше уровнем." ) ;
	if ( admin_info [ playerid ] [ dostup ] [ 2 ] != 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет доступа к данной команде. Используйте /donate." ) ;

    if ( reload_admin_warning ( playerid, params [ 2 ] ) ) return 1 ;

	if ( admin_info [ playerid ] [ admin ] < 4 )
	{
	    new scm_string [ 144 ] ;
		foreach(new i: admin_players)
		{
		    if ( admin_info [ i ] [ admin ] < 5 ) continue ;

		    format( scm_string, 144, "{"#cBAdmin"}[A] {"#cGRAdmin"}%s[%d] запросил(а) выдачу наказания для %s[%d].", p_info [ playerid ] [ name ], playerid, p_info [ params [ 0 ] ] [ name ], params [ 0 ] ) ;
			SendClientMessage ( i, col_admin, scm_string ) ;

			format( scm_string, 144, "{"#cBAdmin"}[A] {"#cGRAdmin"}Причина: %s. Срок наказания: %d дней. Введите {"#cBAdmin"}\"/accept_ban (/ab) [ %d ]\"{"#cGRAdmin"}.", params [ 2 ], params [ 1 ], params [ 0 ] ) ;
			SendClientMessage ( i, col_admin, scm_string ) ;
		}

		format( scm_string, 144, "{"#cBAdmin"}[A] {"#cGRAdmin"}%s[%d] запросил(а) выдачу наказания для %s[%d].", p_info [ playerid ] [ name ], playerid, p_info [ params [ 0 ] ] [ name ], params [ 0 ] ) ;
		SendClientMessage ( playerid, col_admin, scm_string ) ;

		format( scm_string, 144, "{"#cBAdmin"}[A] {"#cGRAdmin"}Причина: %s. Срок наказания: %d дней. Введите {"#cBAdmin"}\"/accept_ban (/ab) [ %d ]\"{"#cGRAdmin"}.", params [ 2 ], params [ 1 ], params [ 0 ] ) ;
		SendClientMessage ( playerid, col_admin, scm_string ) ;

		admin_info [ params [ 0 ] ] [ ban_day ] = params [ 1 ] ;
		format ( admin_info [ params [ 0 ] ] [ reason_punish ], 64, "%s", params [ 2 ] ) ;
		format ( admin_info [ params [ 0 ] ] [ reason_admin ], MAX_PLAYER_NAME, "%s", p_info [ playerid ] [ name ] ) ;
	    return 1 ;
	}

	new scm_string [ 248 ] ;
	format( scm_string, 144, "Администратор %s забанил игрока %s на %d дней. Причина: %s", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], params [ 1 ], params [ 2 ] ) ;
	foreach(new i: logged_players) if ( p_info [ i ] [ settings ] [ 2 ] ) SendClientMessage ( i, col_light_red, scm_string ) ;

	format( scm_string, 144, "{"#cBL"}[A] %s[%d] на %d дней. Причина: %s | IP: %s", p_info [ params [ 0 ] ] [ name ], params [ 0 ], params [ 1 ], params [ 2 ], p_t_info [ params [ 0 ] ] [ p_ip ] ) ;
	foreach(new i: admin_players) if ( p_info [ i ] [ settings ] [ 2 ] ) SendClientMessage ( i, col_admin, scm_string ) ;

	format ( scm_string, sizeof ( scm_string  ), "INSERT INTO `users_bans` (`u_b_admin`,`u_b_name`,`u_b_reason`,`u_b_date`,`u_b_ndate`,`u_b_days`) VALUES ('%s', '%s', '%s', NOW() + INTERVAL %d DAY,NOW( ),'%d')", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], params [ 2 ], params [ 1 ], params [ 1 ] ) ;
	mysql_tquery ( sql_connection, scm_string, "callback_process_ban", "i", params [ 0 ] ) ;

	format ( scm_string,sizeof(scm_string),"UPDATE `users_admins` SET `u_a_bans` = `u_a_bans`+1 WHERE `u_a_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
	mysql_tquery ( sql_connection, scm_string, "", "" ) ;

	format ( scm_string, 128, "%s забанил %s. Причина: %s", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], params [ 2 ]);
	WriteLog ( playerid, TYPE_LOG_BAN, scm_string ) ;

    if ( mw_biz != -1 || gz_captured != -1 )
	{
		if ( gang_player ( params [ 0 ] ) || mafia_player ( params [ 0 ] ) )
		{
			f_ban [ p_info [ params [ 0 ] ] [ member ] ] ++ ;
		}
	}
 	return 1 ;
}

callback: callback_process_ban ( playerid )
{
	new scm_string [ 85 + MAX_PLAYER_NAME ] ;
    format ( scm_string, sizeof scm_string, "SELECT * FROM `users_bans` WHERE `u_b_name` = '%s' AND `u_b_date` > NOW( ) LIMIT 1", p_info [ playerid ] [ name ] ) ;
	mysql_tquery ( sql_connection, scm_string, "check_player_banned", "i", playerid ) ;
	return 1 ;
}

CMD:jail ( playerid, params [ ] )
{
	if ( tester_admin [ playerid ] ) return tester_no_access ( playerid ) ;
	if ( admin_info [ playerid ] [ admin ] < 1 )
		return 1 ;

	if ( admin_info [ playerid ] [ admin ] < 6 )
	{
		if ( sscanf ( params, "u", params [ 0 ] ) )
			return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /jail [ид/имя]" ) ;
		if ( ! IsPlayerConnected ( params [ 0 ] ) )
			return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
		if ( p_info [ params [ 0 ] ] [ jailed ] > 0 )
		    return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок уже в jail!" ) ;
	    if ( admin_info [ playerid ] [ admin ] < admin_info [ params [ 0 ] ] [ admin ] )
			return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете выдать наказание администратору выше уровнем." ) ;

		new _count = 0, header_string [ 48 ] ;
	    global_string [ 0 ] = EOS ;
		strcat ( global_string, "{"#cBL"}№. Причина:\t{"#cBL"}Срок:\n" ) ;
	    for ( new i = 0 ; i < punishment_max ; i ++ )
	    {
	        if ( punish_jail [ i ] [ pun_time ] < 1 ) continue ;

	        set_player_listitem_values ( playerid, _count, i ) ;
	        _count ++ ;

	        format ( global_string, sizeof global_string, "%s{"#cBL"}%d. {"#cWH"}%s\t%d мин.\n", global_string, _count, punish_jail [ i ] [ pun_name ], punish_jail [ i ] [ pun_time ] ) ;
	    }
	    format ( header_string, sizeof header_string, "{"#cBHD"}Наказать {"#cWH"}%s", p_info [ params [ 0 ] ] [ name ] ) ;
	    show_dialog ( playerid, d_jail, DIALOG_STYLE_TABLIST_HEADERS, header_string, global_string, "Выбрать", "Закрыть" ) ;

	    set_player_use_listitem ( playerid, params [ 0 ] ) ;
	    return 1 ;
	}
	else
	{
		if ( sscanf ( params, "uds[42]", params [ 0 ], params [ 1 ], params [ 2 ] ) )
			SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /jail [ид/имя] [минуты] [причина]" ) ;
		if ( ! IsPlayerConnected ( params [ 0 ] ) )
			return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
  		if ( p_info [ params [ 0 ] ] [ jailed ] > 0 )
		    return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок уже в jail!" ) ;
	    if ( admin_info [ playerid ] [ admin ] < admin_info [ params [ 0 ] ] [ admin ] )
			return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете выдать наказание администратору выше уровнем." ) ;

		if ( strlen ( params [ 2 ] ) < 2 )
		{
			new _count = 0, header_string [ 48 ] ;
		    global_string [ 0 ] = EOS ;
			strcat ( global_string, "{"#cBL"}№. Причина:\t{"#cBL"}Срок:\n" ) ;
		    for ( new i = 0 ; i < punishment_max ; i ++ )
		    {
		        if ( punish_jail [ i ] [ pun_time ] < 1 ) continue ;

		        set_player_listitem_values ( playerid, _count, i ) ;
		        _count ++ ;

		        format ( global_string, sizeof global_string, "%s{"#cBL"}%d. {"#cWH"}%s\t%d мин.\n", global_string, _count, punish_jail [ i ] [ pun_name ], punish_jail [ i ] [ pun_time ] ) ;
		    }
		    format ( header_string, sizeof header_string, "{"#cBHD"}Наказать {"#cWH"}%s", p_info [ params [ 0 ] ] [ name ] ) ;
		    show_dialog ( playerid, d_jail, DIALOG_STYLE_TABLIST_HEADERS, header_string, global_string, "Выбрать", "Закрыть" ) ;

	    	set_player_use_listitem ( playerid, params [ 0 ] ) ;
		    return 1 ;
		}
		else
		{
			if ( params [ 1 ] < 1 || params [ 1 ] > 180 )
				return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Время заключения должно составлять от 1 до 180 минут." ) ;
		}
	}

	if ( reload_admin_warning ( playerid, params [ 2 ] ) ) return 1 ;

	new scm_string [ 248 ] ;
	format( scm_string, 144, "{"#cBAdmin"}[A] {"#cGRAdmin"}%s посадил %s в призон на %d минут. Причина: %s", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], params [ 1 ], params [ 2 ] ) ;
	foreach(new i: admin_players) SendClientMessage ( i, col_admin, scm_string ) ;

	format( scm_string, 144, "Администратор %s посадил %s в призон на %d минут. Причина: %s", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], params [ 1 ], params [ 2 ] ) ;
	foreach(new i: logged_players) if ( p_info [ i ] [ settings ] [ 2 ] ) SendClientMessage ( i, col_light_red, scm_string ) ;

	format( scm_string, 144, "%s поместил Вас в призон на %d минут. Причина: %s", p_info [ playerid ] [ name ], params [ 1 ], params [ 2 ] ) ;
	SendClientMessage ( params [ 0 ] , col_light_red, scm_string ) ;

	format ( scm_string,sizeof(scm_string),"UPDATE `users_admins` SET `u_a_jails` = `u_a_jails`+1 WHERE `u_a_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
	mysql_tquery ( sql_connection, scm_string, "", "" ) ;

	format(scm_string, 128, "%s посадил %s. Причина: %s", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], params [ 2 ] );
	WriteLog(playerid, TYPE_LOG_JAIL, scm_string);

   	admin_info [ playerid ] [ coins ] += 2 ;
	p_info [ params [ 0 ] ] [ jailed ] = params [ 1 ] * 60 ;

	p_info [ params [ 0 ] ] [ jail ] = 10 ;
	update_int_sql ( params [ 0 ], "u_jail", 10 ) ;

	set_pos ( params [ 0 ], jail_spawn [ 0 ] [ 0 ], jail_spawn [ 0 ] [ 1 ], jail_spawn [ 0 ] [ 2 ], jail_spawn [ 0 ] [ 3 ], 1, 15 ) ;
	reset_player_weapon ( params [ 0 ] ) ;
	return 1 ;
}

CMD:unjail ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 2 )
		return 1 ;
	if ( sscanf ( params, "d", params [ 0 ] ) )
		return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /unjail [ид/имя]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) )
		return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( ! p_info [ params [ 0 ] ] [ jailed ] )
	    return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока нет jail!" ) ;

	new scm_string [ 57 + ( MAX_PLAYER_NAME * 2 ) ] ;
	format( scm_string, sizeof scm_string, "{"#cBAdmin"}[A] {"#cGRAdmin"}%s выпустил %s из тюрьмы.", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ] ) ;
	foreach(new i: admin_players) SendClientMessage ( i, col_admin, scm_string ) ;

	format ( scm_string, sizeof scm_string, "%s выпустил из тюрьмы %s", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ] ) ;
	WriteLog ( playerid, TYPE_LOG_UNJAIL, scm_string ) ;

	p_info [ params [ 0 ] ] [ jailed ] = 10 ;
	return 1 ;
}

CMD:offjail ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 4 ) return 1 ;
	new
		jname [ MAX_PLAYER_NAME ],
		jtime,
		jreason [ 42 ] ;
	if ( sscanf ( params, "s[24]ds[42]", jname, jtime, jreason ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /offjail [имя игрока] [минуты] [причина]" ) ;
	if ( ! ( 0 < jtime <= 180 ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Время заключения не должно быть меньше 1 и больше 180 минут." ) ;

    new _pl_id ;
	sscanf ( jname, "u", _pl_id ) ;
	if ( IsPlayerConnected ( _pl_id ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок в сети." ) ;

	new sql_string [ 59 + MAX_PLAYER_NAME ] ;
	format ( sql_string, sizeof sql_string, "SELECT `u_id` FROM `users` WHERE `u_name` = '%s' LIMIT 1", jname ) ;
	mysql_tquery ( sql_connection, sql_string, "offjail_check_callback", "isds", playerid, jname, jtime, jreason ) ;
	return 1 ;
}

CMD:offban ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 4 )return 1 ;
	new offb_reason [ 42 ],
			offb_name [ 24 ],
			offb_day ;

	if ( sscanf ( params, "s[24]ds[42]", offb_name, offb_day, offb_reason ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /offban [имя] [кол-во дней] [причина]" ) ;
	if ( admin_info [ playerid ] [ admin ] > 6 )
	{
		if ( offb_day < 1 || offb_day > 2000 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Разрешено банить только от 1 до 2000 дней." ) ;
	}
	else
	{
		if ( offb_day < 1 || offb_day > 30 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Разрешено банить только от 1 до 30 дней." ) ;
	}
	if ( admin_info [ playerid ] [ admin ] < get_player_admin_level ( offb_name ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете выдать наказание администратору выше уровнем." ) ;

    new _pl_id ;
	sscanf ( offb_name, "u", _pl_id ) ;
	if ( IsPlayerConnected ( _pl_id ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок в сети." ) ;

	static const _str [ ] = "SELECT `u_id` FROM `users` WHERE `u_name` = '%s' LIMIT 1" ;
	new scm_string [ sizeof _str + 24 ] ;
	format ( scm_string, sizeof ( scm_string  ), _str, offb_name ) ;
	mysql_tquery ( sql_connection, scm_string, "offban_check_callback", "isds", playerid, offb_name, offb_day, offb_reason ) ;
 	return 1;
}

CMD:sban ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 4 )return 1 ;
	if ( sscanf ( params, "uds[32]", params [ 0 ], params [ 1 ], params [ 2 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /sban [ид] [кол-во дней] [причина]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( admin_info [ playerid ] [ admin ] > 6 )
	{
		if ( params [ 1 ] < 1 || params [ 1 ] > 2000 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Разрешено банить только от 1 до 2000 дней." ) ;
	}
	else
	{
		if ( params [ 1 ] < 1 || params [ 1 ] > 30 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Разрешено банить только от 1 до 30 дней." ) ;
	}
	if ( admin_info [ playerid ] [ admin ] < admin_info [ params [ 0 ] ] [ admin ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете выдать наказание администратору выше уровнем." ) ;
	if ( admin_info [ playerid ] [ dostup ] [ 2 ] != 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет доступа к данной команде. Используйте /donate." ) ;

    if ( reload_admin_warning ( playerid, params [ 2 ] ) ) return 1 ;

	new scm_string [ 248 ] ;

	format( scm_string, 144, "{"#cBAdmin"}[A] {"#cGRAdmin"}%s[%d] выдал тихий бан игроку %s[%d] на %d дней. Причина: %s", p_info [ playerid ] [ name ], playerid, p_info [ params [ 0 ] ] [ name ], params [ 0 ], params [ 1 ], params [ 2 ] ) ;
	foreach(new i: admin_players) SendClientMessage ( i, col_admin, scm_string ) ;
	format( scm_string, 144, "{"#cBAdmin"}[A] {"#cGRAdmin"}%s[%d] на %d дней. Причина: %s | IP: %s", p_info [ params [ 0 ] ] [ name ], params [ 0 ], params [ 1 ], params [ 2 ], p_t_info [ params [ 0 ] ] [ p_ip ] ) ;
	foreach(new i: admin_players) if ( p_info [ i ] [ settings ] [ 2 ] ) SendClientMessage ( i, col_admin, scm_string ) ;

	mysql_format ( sql_connection, scm_string, sizeof ( scm_string  ), "INSERT INTO `users_bans` (`u_b_admin`,`u_b_name`,`u_b_reason`,`u_b_date`,`u_b_ndate`,`u_b_days`) VALUES ('%s', '%s', '%e', NOW() + INTERVAL %d DAY,NOW( ),'%d')", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], params [ 2 ], params [ 1 ], params [ 1 ] ) ;
	mysql_tquery ( sql_connection, scm_string, "callback_process_ban", "i", params [ 0 ] ) ;

	format(scm_string, 128, "[S] %s забанил %s. Причина: %s", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], params [ 2 ]);
	WriteLog(playerid, TYPE_LOG_BAN, scm_string);

 	return 1 ;
}

