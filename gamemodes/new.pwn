alias:createservervehicle("addcar")
CMD:createservervehicle ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 8 )return 1 ;
	if ( GetPlayerState ( playerid ) != PLAYER_STATE_DRIVER ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны быть в транспорте." ) ;
	if ( sscanf ( params, "dds[12]d", params [ 0 ], params [ 1 ], params [ 2 ], params [ 3 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /createservervehicle [модель] [owner] [номер] [type]" ) ;
	if ( params [ 0 ] < 400 || params [ 0 ] > 611 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /createservervehicle [модель] [owner] [номер] [type]" ) ;
    if ( ! IsFounder ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}К сожалению, Вам данная функция не доступна." ) ;

	new veh_id = GetPlayerVehicleID ( playerid ) ;
	new i = GetVehicleID ( ) ;

	veh_info [ i - 1 ] [ v_owner ] = params [ 1 ] ;
	veh_info [ i - 1 ] [ v_model ] = params [ 0 ] ;
	format ( veh_info [ i - 1 ] [ v_plate ], 12, "%s", params [ 2 ] ) ;

	GetVehiclePos ( veh_id, veh_info [ i - 1 ] [ v_pos ] [ 0 ], veh_info [ i - 1 ] [ v_pos ] [ 1 ], veh_info [ i - 1 ] [ v_pos ] [ 2 ] ) ;
	GetVehicleZAngle ( veh_id, veh_info [ i - 1 ] [ v_pos ] [ 3 ] ) ;

	veh_info [ i - 1 ] [ v_rank ] = 0 ;

	veh_info [ i - 1 ] [ v_fine ] = 0 ;
	veh_info [ i - 1 ] [ v_rent_price ] = 0 ;

	veh_info [ i - 1 ] [ v_type ] = params [ 3 ] ;

   	if ( veh_info [ i - 1 ] [ v_owner ] == 1 ) veh_info [ i - 1 ] [ v_vehicle ] = AddStaticVehicleEx ( veh_info [ i - 1 ] [ v_model ], veh_info [ i - 1 ] [ v_pos ] [ 0 ], veh_info [ i - 1 ] [ v_pos ] [ 1 ], veh_info [ i - 1 ] [ v_pos ] [ 2 ], veh_info [ i - 1 ] [ v_pos ] [ 3 ], veh_info [ i - 1 ] [ v_color ] [ 0 ], veh_info [ i - 1 ] [ v_color ] [ 1 ], -1, 1 ) ;
	else veh_info [ i - 1 ] [ v_vehicle ] = AddStaticVehicleEx ( veh_info [ i - 1 ] [ v_model ], veh_info [ i - 1 ] [ v_pos ] [ 0 ], veh_info [ i - 1 ] [ v_pos ] [ 1 ], veh_info [ i - 1 ] [ v_pos ] [ 2 ], veh_info [ i - 1 ] [ v_pos ] [ 3 ], veh_info [ i - 1 ] [ v_color ] [ 0 ], veh_info [ i - 1 ] [ v_color ] [ 1 ], -1 ) ;
	SetVehicleNumberPlate ( veh_info [ i - 1 ] [ v_vehicle ], veh_info [ i - 1 ] [ v_plate ] ) ;
	veh_info [ i - 1 ] [ v_fuel ] = 60.0 ;

	if ( params [ 3 ] == vehicle_type_server )
	{
	    if ( 0 < params [ 1 ] < fraction_count ) Iter_Add(fraction_vehicles[veh_info [ i - 1 ] [ v_owner ]], veh_info [ i - 1 ] [ v_vehicle ] ) ;

		new sql_string [ 288 ] ;
		mysql_format ( sql_connection, sql_string, 288, "INSERT INTO `server_vehicles` (`sv_model`,`sv_owner`,`sv_plate`,`sv_pos_x`,`sv_pos_y`,`sv_pos_z`,`sv_pos_a`,`sv_type`) VALUES ('%d','%d','%s','%f','%f','%f','%f','%d')",
		params [ 0 ], params [ 1 ], veh_info [ i - 1 ] [ v_plate ],
		veh_info [ i - 1 ] [ v_pos ] [ 0 ], veh_info [ i - 1 ] [ v_pos ] [ 1 ], veh_info [ i - 1 ] [ v_pos ] [ 2 ], veh_info [ i - 1 ] [ v_pos ] [ 3 ], params [ 3 ] ) ;
		mysql_tquery ( sql_connection, sql_string, "create_vehicle_callback", "d", i ) ;
	}
	else if ( params [ 3 ] == vehicle_type_rentcar )
	{
	    Iter_Add(business_vehicles[veh_info [ i - 1 ] [ v_owner ]], veh_info [ i - 1 ] [ v_vehicle ] ) ;

		new sql_string [ 288 ] ;
		mysql_format ( sql_connection, sql_string, 288, "INSERT INTO `rent_vehicles` (`sv_model`,`sv_owner`,`sv_plate`,`sv_pos_x`,`sv_pos_y`,`sv_pos_z`,`sv_pos_a`,`sv_type`) VALUES ('%d','%d','%s','%f','%f','%f','%f','%d')",
		params [ 0 ], params [ 1 ], veh_info [ i - 1 ] [ v_plate ],
		veh_info [ i - 1 ] [ v_pos ] [ 0 ], veh_info [ i - 1 ] [ v_pos ] [ 1 ], veh_info [ i - 1 ] [ v_pos ] [ 2 ], veh_info [ i - 1 ] [ v_pos ] [ 3 ], params [ 3 ] ) ;
		mysql_tquery ( sql_connection, sql_string, "create_vehicle_callback", "d", i ) ;
	}
	veh_plate ( i ) ;

	SendClientMessage ( playerid, col_white, !"Транспорт успешно создан." ) ;
	return 1 ;
}

CMD:route ( playerid )
{
	if ( p_info [ playerid ] [ job ] != job_bus ) return 1 ;
	if ( player_rentcar [ playerid ] == INVALID_VEHICLE_ID || player_rentcar [ playerid ] != player_vehicle [ playerid ] ) return 1 ;
	if ( veh_info [ player_rentcar [ playerid ] - 1 ] [ v_type ] != vehicle_type_job || veh_info [ player_rentcar [ playerid ] - 1 ] [ v_owner ] != job_bus )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не в служебном транспорте!" ) ;

    new line_string [ 38 + 4 + 32 + 9 ] ;

	global_string [ 0 ] = EOS ;
	for ( new i = 0 ; i < bus_first_count ; i ++ )
	{
		format ( line_string, sizeof line_string, "{"#cBL"}%d.{"#cWH"} %s (%d"valute_title_"/рейс)\n", i + 1, bus_info [ i ] [ bus_name ], zp_for_gos [ 7 ] * bus_info [ i ] [ bus_price ] ) ;
	    strcat ( global_string, line_string ) ;
	}
	show_dialog ( playerid, d_bus_route, DIALOG_STYLE_LIST, "{"#cBHD"}Выберите маршрут", global_string, "Выбрать", "Отмена" ) ;
	return 1 ;
}

CMD:delivery ( playerid )
{
	if ( p_info [ playerid ] [ job ] != job_delivery && p_info [ playerid ] [ job ] != job_fuel_delivery ) return 1 ;
	if ( GetPlayerState ( playerid ) != PLAYER_STATE_DRIVER ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не в служебном транспорте." ) ;

	if ( player_rentcar [ playerid ] == INVALID_VEHICLE_ID ) return 1 ;
	if ( veh_info [ player_vehicle [ playerid ] - 1 ] [ v_type ] != vehicle_type_job || ( veh_info [ player_vehicle [ playerid ] - 1 ] [ v_owner ] != job_fuel_delivery && veh_info [ player_vehicle [ playerid ] - 1 ] [ v_owner ] != job_delivery ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не в служебном транспорте." ) ;

	new d_string [ 156 ] ;
	format ( d_string, sizeof ( d_string ), "{"#cBL"}Товара в транспорте: {"#cGRDialog"}%d кг.\n{"#cBL"}1. {"#cWH"}Закупка товара\n{"#cBL"}2. {"#cWH"}Список заказов",
	veh_info [ GetPlayerVehicleID ( playerid ) - 1 ] [ v_cargo ] ) ;
	show_dialog ( playerid, d_delivery, DIALOG_STYLE_LIST, "{"#cBHD"}Доставка", d_string, "Выбрать", "Закрыть" ) ;
	return 1 ;
}

CMD:stoprent ( playerid )
{
	if ( player_rentcar [ playerid ] == INVALID_VEHICLE_ID ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRDialog"}Вы не арендуете транспорт." ) ;
	if ( GetPlayerState ( playerid ) != PLAYER_STATE_ONFOOT ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRDialog"}Вы находитесь в транспорте. Для прекращения аренды покиньте транспорт." ) ;

	show_dialog ( playerid, d_end, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Прекращение аренды", "{ffffff}Вы дейтвительно хотите прекратить аренду транспорта?\n\n{"#cGRDialog"}* Деньги за аренду возвращены не будут.","Да","Отмена" ) ;
	return true ;
}

CMD:end ( playerid )
{
	if ( p_info [ playerid ] [ job ] != job_bus && p_info [ playerid ] [ job ] != job_taxi && p_info [ playerid ] [ job ] != job_mechanic && p_info [ playerid ] [ job ] != job_trucker ) return 1 ;

	if ( GetPlayerState ( playerid ) != PLAYER_STATE_DRIVER ) return 1 ;

	if ( player_rentcar [ playerid ] == INVALID_VEHICLE_ID ) return 1 ;
	if ( veh_info [ player_rentcar [ playerid ] - 1 ] [ v_type ] != vehicle_type_job || veh_info [ player_rentcar [ playerid ] - 1 ] [ v_owner ] != p_info [ playerid ] [ job ] )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не в служебном транспорте!" ) ;

	show_dialog ( playerid, d_end, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Конец рабочего дня", "{ffffff}Вы дейтвительно хотите прекратить аренду транспорта?\n\n{"#cGRDialog"}* Деньги за аренду возвращены не будут.","Да","Отмена");
	return true ;
}

CMD:mech ( playerid )
{
	if ( p_info [ playerid ] [ job ] != job_mechanic ) return 1 ;
	if ( player_rentcar [ playerid ] == INVALID_VEHICLE_ID ) return 1 ;
	if ( veh_info [ player_rentcar [ playerid ] - 1 ] [ v_type ] != vehicle_type_job || veh_info [ player_rentcar [ playerid ] - 1 ] [ v_owner ] != job_mechanic )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не в служебном транспорте!" ) ;

	show_dialog ( playerid, d_start_mech, DIALOG_STYLE_INPUT, "{"#cBHD"}Автомеханик",
				"{ffffff}Используйте название вашей технической службы \nили оставьте поле пустым", "Готово", "Отмена");

	return 1 ;
}

CMD:fcontract ( playerid )
{
    if ( p_info [ playerid ] [ job ] != job_mechanic ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не работаете механиком." ) ;
    if ( GetPlayerState ( playerid ) != PLAYER_STATE_DRIVER ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны быть в машине." ) ;

	new _v_id = GetPlayerVehicleID ( playerid ) ;
    if ( veh_info [ _v_id - 1 ] [ v_type ] != vehicle_type_job || veh_info [ _v_id - 1 ] [ v_owner ] != job_mechanic )
		return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны быть в рабочей машине." ) ;

	foreach(new t: business_types[bizz_type_gas])
	{
	    if ( b_info [ t - 1 ] [ b_type ] != bizz_type_gas ) continue;
	    if ( ! IsPlayerInRangeOfPoint ( playerid, 10.0, b_info [ t - 1 ] [ b_position ] [ 0 ], b_info [ t - 1 ] [ b_position ] [ 1 ], b_info [ t - 1 ] [ b_position ] [ 2 ])) continue;

		if ( b_info [ t - 1 ] [ b_price ] == 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Цена за 1 литр не назначена владельцем заправки." ) ;
		if ( b_info [ t - 1 ] [ b_owner_inc ] == -1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У данной заправки нет владельца, она не работает." ) ;

		new _scm_string [ 128 ] ;
		format(_scm_string, sizeof _scm_string, "{ffffff}Стоимость 1 литра: %d"valute_title_"\n\n{"#cGRDialog"}* число должно быть кратным 2\n{"#cGRDialog"}* Используйте количество бензина, которое хотите закупить:", b_price_market [ t - 1 ] [ 0 ] ) ;
		show_dialog ( playerid, d_mech_contract, DIALOG_STYLE_INPUT, "{"#cBHD"}Закупка топлива", _scm_string, "Купить", "Отмена" ) ;

		SetPVarInt ( playerid, "f_biz", t ) ;
	    return 1;
	}
	SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны быть рядом с заправкой." ) ;
	return 1;
}

CMD:refill ( playerid, params [ ] )
{
    if ( p_info [ playerid ] [ job ] != job_mechanic ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не работаете механиком." ) ;

	if ( sscanf ( params, "uii", params [ 0 ], params [ 1 ], params [ 2 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /refill [ид/имя] [бензин] [цена]");
	if ( params[ 2 ] < 80 || params[ 2 ] > 1500 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Цена не может быть больше 1500"valute_title_" и меньше 80"valute_title_"");
	if ( GetPVarInt ( playerid, "toplivo" ) < params [ 1 ] || params [ 1 ] < 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас нет столько топлива." ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
    if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;
	if ( GetPlayerState ( params [ 0 ] ) != PLAYER_STATE_DRIVER ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок должен быть в машине." ) ;
    if ( GetPlayerState ( playerid ) != PLAYER_STATE_DRIVER ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны быть в машине." ) ;
    if ( veh_info [ player_rentcar [ playerid ] - 1 ] [ v_type ] != vehicle_type_job || veh_info [ player_rentcar [ playerid ] - 1 ] [ v_owner ] != job_mechanic ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны быть в рабочей машине." ) ;
	if ( veh_info [ GetPlayerVehicleID ( params [ 0 ] ) - 1 ] [ v_fuel ] + params [ 1 ] > 100 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Столько топлива не уместится в бак." ) ;
    if ( ! bad_dialog ( params [ 0 ] ) || ! bad_dialog ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок в данный момент не может осуществлять сделки.") ;
	if ( cooldown_sentence [ playerid ] > gettime ( ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Предложение о сделке можно отправлять один раз в {"#cRD"}45 секунд{"#cGRInfo"}." ) ;

	new _scm_string [ 144 ] ;
	format ( _scm_string, 128, "Вы предложили %s заправить автомобиль на %i литров за %i"valute_title_"", p_info [ params [ 0 ] ] [ name ], params [ 1 ], params[ 2 ] ) ;
	SendClientMessage ( playerid, col_gray, _scm_string ) ;

	format ( _scm_string, sizeof _scm_string, "{"#cBL"}%s {"#cWH"}предлагает заправить Ваш автомобиль на {"#cGRDialog"}%i {"#cWH"}литров за {"#cGN"}%i"valute_title_"\n\n{"#cGRDialog"}* Вы согласны?", p_info [ playerid ] [ name ], params [ 1 ], params[ 2 ] ) ;
	show_dialog ( params [ 0 ], d_refill, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Заправка", _scm_string, "Принять", "Отклонить" ) ;

    cooldown_sentence [ playerid ] = gettime ( ) + time_sell_sentence ;

	buyer_id [ playerid ] = params [ 0 ] ;
	sell_price [ playerid ] = params [ 2 ] ;
	sell_item [ playerid ] = params [ 1 ] ;
	seller_id [ params [ 0 ] ] = playerid ;

	sell_time { playerid } =
	sell_time { params [ 0 ] } = time_sell_null ;
	return 1 ;
}

stock TouchMechanicHook ( playerid )
{
	new playerVehicle = GetPlayerVehicleID ( playerid ), Float: distance ;
	if ( GetVehicleTrailer ( playerVehicle ) == 0 )
	{
		new bool: isAttached = false ;
		foreach(new vehicleId: streamed_vehicles[playerid])
		{
			distance = GetDistanceBetweenPoints (
				veh_info [ playerVehicle - 1 ] [ v_now_pos ] [ 0 ],
				veh_info [ playerVehicle - 1 ] [ v_now_pos ] [ 1 ],
				veh_info [ playerVehicle - 1 ] [ v_now_pos ] [ 2 ],
				veh_info [ vehicleId - 1 ] [ v_now_pos ] [ 0 ],
				veh_info [ vehicleId - 1 ] [ v_now_pos ] [ 1 ],
				veh_info [ vehicleId - 1 ] [ v_now_pos ] [ 2 ]
			) ;

			if ( distance > 4.0 ) continue ;

			AttachTrailerToVehicle ( vehicleId, playerVehicle ) ;
			isAttached = true ;
			break ;
		}

		if ( ! isAttached )
		{
			send_check_cinfo ( playerid, "Рядом с Вами нет т/с, которое можно подцепить!", 0, 3, CINFO_OTHER_ID, PICTURE_INFO_ERROR, "", "" ) ;
		}
	}
	else DetachTrailerFromVehicle ( playerVehicle ) ;
	return true ;
}

CMD:repair ( playerid, params [ ] )
{
    if ( p_info [ playerid ] [ job ] != job_mechanic ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не работаете механиком." ) ;

 	if ( sscanf ( params,"ud", params [ 0 ], params [ 1 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /repair [ид/имя] [цена]");
	if ( params [ 1 ] < 80 || params [ 1 ] > 1500 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Цена за починку не может быть больше 1500"valute_title_" и меньше 80"valute_title_"");
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
    if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;
	if ( GetPlayerState ( params [ 0 ] ) != PLAYER_STATE_DRIVER ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок должен быть в машине." ) ;
    if ( GetPlayerState ( playerid ) != PLAYER_STATE_DRIVER ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны быть в машине." ) ;

	new veh_id = GetPlayerVehicleID ( playerid ) ;
	if ( veh_info [ veh_id - 1 ] [ v_type ] != vehicle_type_job || veh_info [ veh_id - 1 ] [ v_owner ] != job_mechanic ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны быть в рабочей машине." ) ;
	if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете починить свою машину." ) ;
    if ( ! bad_dialog ( params [ 0 ] ) || ! bad_dialog ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок в данный момент не может осуществлять сделки.") ;
	if ( cooldown_sentence [ playerid ] > gettime ( ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Предложение о сделке можно отправлять один раз в {"#cRD"}45 секунд{"#cGRInfo"}." ) ;

	new Float:carhealth ;
	GetVehicleHealth ( GetPlayerVehicleID ( params [ 0 ] ), carhealth ) ;
	if ( carhealth > 990 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Транспорт игрока не нуждается в починке." ) ;

	new _scm_string [ 128 ] ;
	format(_scm_string, 128, "Вы предложили %s починить автомобиль за %i"valute_title_"", p_info [ params [ 0 ] ] [ name ], params [ 1 ] ) ;
	SendClientMessage ( playerid, col_gray, _scm_string ) ;

	format(_scm_string, 128, "{"#cBL"}%s {"#cWH"}предлагает починить Ваш автомобиль за {"#cGN"}%i"valute_title_"\n\n{"#cGRDialog"}* Вы согласны?", p_info [ playerid ] [ name ], params [ 1 ] ) ;
	show_dialog ( params [ 0 ], d_repair, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Ремонт", _scm_string, "Принять", "Отклонить" ) ;

    cooldown_sentence [ playerid ] = gettime ( ) + time_sell_sentence ;

	buyer_id [ playerid ] = params [ 0 ] ;
	sell_price [ playerid ] = params [ 1 ] ;
	seller_id [ params [ 0 ] ] = playerid ;

	sell_time { playerid } =
	sell_time { params [ 0 ] } = time_sell_null ;
	return 1 ;
}

CMD:tr ( playerid, params [ ] )
{
	if ( p_info [ playerid ] [ job ] == job_none ) return 1 ;
	if ( p_info [ playerid ] [ mute ] )
	{
		new scm_string [ 38 ] ;
		format ( scm_string, sizeof ( scm_string ),"У вас бан чата | %d секунд(ы)", p_info [ playerid ] [ mute ] ) ;
		SendClientMessage ( playerid, col_light_red, scm_string ) ;
		return true ;
	}
	if ( sscanf ( params, "s[100]", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /tr [текст]" ) ;
 	if ( check_advertise ( playerid, params [ 0 ], report_type_tr ) ) return 1 ;

	new scm_string [ 144 ] ;
	if ( p_info [ playerid ] [ job ] == job_mechanic )
	{
		format ( scm_string, sizeof scm_string, "* [MECHANIC] %s: %s", p_info [ playerid ] [ name ], params [ 0 ] ) ;
		foreach(new i: logged_players) if ( p_info [ i ] [ job ] == job_mechanic && player_rentcar [ i ] != INVALID_VEHICLE_ID && (veh_info [ player_rentcar [ i ] - 1 ] [ v_type ] == vehicle_type_job || veh_info [ player_rentcar [ i ] - 1 ] [ v_owner ] == job_mechanic ) && p_info [ i ] [ settings ] [ 4 ] != 0 ) SendClientMessage ( i, color_job, scm_string ) ;

		if ( p_info [ playerid ] [ job ] == job_mechanic && player_rentcar [ playerid ] == INVALID_VEHICLE_ID )
		{
			SendClientMessage ( playerid, color_job, scm_string ) ;
			SendClientMessage ( playerid, color_job, !"* Вы не арендовали рабочий транспорт. Вы не будете видеть то, что пишут другие работники." ) ;
		}

		format(scm_string, sizeof scm_string, "сказал(а) в рацию: {FFFFFF}%s", params [ 0 ]);
		SetPlayerChatBubble(playerid, scm_string, col_light_purple, 13.0, 5000);
	}
	else if ( p_info [ playerid ] [ job ] == job_bus )
	{
		format ( scm_string, sizeof scm_string, "* [BUS DRIVER] %s: %s", p_info [ playerid ] [ name ], params [ 0 ] ) ;
		foreach(new i: logged_players) if ( p_info [ i ] [ job ] == job_bus && player_rentcar [ i ] != INVALID_VEHICLE_ID && (veh_info [ player_rentcar [ i ] - 1 ] [ v_type ] == vehicle_type_job || veh_info [ player_rentcar [ i ] - 1 ] [ v_owner ] == job_bus ) && p_info [ i ] [ settings ] [ 4 ] != 0 ) SendClientMessage ( i, color_job, scm_string ) ;

        if ( p_info [ playerid ] [ job ] == job_bus && player_rentcar [ playerid ] == INVALID_VEHICLE_ID )
		{
			SendClientMessage ( playerid, color_job, scm_string ) ;
			SendClientMessage ( playerid, color_job, !"* Вы не арендовали рабочий транспорт. Вы не будете видеть то, что пишут другие работники." ) ;
		}

		format(scm_string, sizeof scm_string, "сказал(а) в рацию: {FFFFFF}%s", params [ 0 ]);
		SetPlayerChatBubble(playerid, scm_string, col_light_purple, 13.0, 5000);
	}
	else if ( p_info [ playerid ] [ job ] == job_delivery || p_info [ playerid ] [ job ] == job_fuel_delivery )
	{
		format ( scm_string, sizeof scm_string, "* [DELIVERY] %s: %s", p_info [ playerid ] [ name ], params [ 0 ] ) ;
        foreach(new i: logged_players) if ( ( p_info [ i ] [ job ] == job_delivery && player_rentcar [ i ] != INVALID_VEHICLE_ID && (veh_info [ player_rentcar [ i ] - 1 ] [ v_type ] == vehicle_type_job || veh_info [ player_rentcar [ i ] - 1 ] [ v_owner ] == job_delivery ) ||
											p_info [ i ] [ job ] == job_fuel_delivery && player_rentcar [ i ] != INVALID_VEHICLE_ID && (veh_info [ player_rentcar [ i ] - 1 ] [ v_type ] == vehicle_type_job || veh_info [ player_rentcar [ i ] - 1 ] [ v_owner ] == job_fuel_delivery ) ) && p_info [ i ] [ settings ] [ 4 ] != 0 ) SendClientMessage ( i, color_job, scm_string ) ;

		if ( p_info [ playerid ] [ job ] == job_delivery && player_rentcar [ playerid ] == INVALID_VEHICLE_ID ||
			p_info [ playerid ] [ job ] == job_fuel_delivery && player_rentcar [ playerid ] == INVALID_VEHICLE_ID )
		{
			SendClientMessage ( playerid, color_job, scm_string ) ;
			SendClientMessage ( playerid, color_job, !"* Вы не арендовали рабочий транспорт. Вы не будете видеть то, что пишут другие работники." ) ;
		}

		format(scm_string, sizeof scm_string, "сказал(а) в рацию: {FFFFFF}%s", params [ 0 ]);
		SetPlayerChatBubble(playerid, scm_string, col_light_purple, 13.0, 5000);
	}
	else if ( p_info [ playerid ] [ job ] == job_incass )
	{
		format ( scm_string, sizeof scm_string, "* [COLLECTOR] %s: %s", p_info [ playerid ] [ name ], params [ 0 ] ) ;
        foreach(new i: logged_players) if ( ( p_info [ i ] [ job ] == job_incass && player_rentcar [ i ] != INVALID_VEHICLE_ID && (veh_info [ player_rentcar [ i ] - 1 ] [ v_type ] == vehicle_type_job || veh_info [ player_rentcar [ i ] - 1 ] [ v_owner ] == job_incass ) ) && p_info [ i ] [ settings ] [ 4 ] != 0 ) SendClientMessage ( i, color_job, scm_string ) ;

		if ( p_info [ playerid ] [ job ] == job_incass && player_rentcar [ playerid ] == INVALID_VEHICLE_ID )
		{
			SendClientMessage ( playerid, color_job, scm_string ) ;
			SendClientMessage ( playerid, color_job, !"* Вы не арендовали рабочий транспорт. Вы не будете видеть то, что пишут другие работники." ) ;
		}

		format(scm_string, sizeof scm_string, "сказал(а) в рацию: {FFFFFF}%s", params [ 0 ]);
		SetPlayerChatBubble(playerid, scm_string, col_light_purple, 13.0, 5000);
	}
	return 1 ;
}

alias:tpanel("tpl")
CMD:tpanel ( playerid )
{
    if ( p_info [ playerid ] [ job ] == job_taxi ) return show_taxi_panel ( playerid ) ;
	else if ( p_info [ playerid ] [ job ] == job_trucker ) return show_tpanel ( playerid ) ;
	else if ( p_info [ playerid ] [ job ] == job_incass ) return show_collector_panel ( playerid ) ;
	return 1 ;
}

stock show_taxi_panel ( playerid )
{
    page_count [ playerid ] = 1 ;
	new rows_list = page_count [ playerid ] - 1 ;
	page_rows [ playerid ] = bus_station_count ;

	global_string [ 0 ] = EOS ;
	new line_string [ 128 ], row_count ;
	for ( new f = rows_list * 10 ; f < rows_list * 10 + 10 ; f ++ )
	{
		if ( f >= bus_station_count ) break ;

	    set_player_listitem_values ( playerid, f - rows_list * 10, f ) ;

		format ( line_string, sizeof ( line_string ), "{"#cBL"}%i. {"#cWH"}Остановка №%d, Ожидающих: {"#cBL"}%d{"#cWH"}, Ставка: {"#cGN"}%d"valute_title_"{"#cWH"} за человека\n", f + 1, bus_station [ f ] [ b_id ], bus_station [ f ] [ b_player ], bus_station [ f ] [ b_price ] ) ;
		strcat ( global_string, line_string ) ;

		row_count ++ ;
	}

	if ( rows_list > 0 )
	{
		strcat ( global_string, "{"#cBL"}Предыдущая страница\n" ) ;
		set_player_use_page ( playerid, row_count, 0 ) ;
		row_count ++ ;
	}
	if ( ofm_formula ( page_count [ playerid ] ) < page_rows [ playerid ] )
	{
		strcat ( global_string, "{"#cBL"}Следующая страница\n" ) ;
		set_player_use_page ( playerid, row_count, 1 ) ;
	}

	show_dialog(playerid, d_taxi_panel, DIALOG_STYLE_LIST, "{"#cBHD"}Остановки", global_string, "Выбрать", "Закрыть" ) ;
	return 1 ;
}

stock show_taxi_panel_page ( playerid )
{
    new rows_list = page_count [ playerid ] - 1 ;

	global_string [ 0 ] = EOS ;
	new line_string [ 128 ], row_count ;
	for ( new f = rows_list * 10 ; f < rows_list * 10 + 10 ; f ++ )
	{
		if ( f >= bus_station_count ) break ;

		set_player_listitem_values ( playerid, f - rows_list * 10, f ) ;

		format ( line_string, sizeof ( line_string ), "{"#cBL"}%i. {"#cWH"}Остановка №%d, Ожидающих: {"#cBL"}%d{"#cWH"}, Ставка: {"#cGN"}%d"valute_title_"{"#cWH"} за человека\n", f + 1, bus_station [ f ] [ b_id ], bus_station [ f ] [ b_player ], bus_station [ f ] [ b_price ] ) ;
		strcat ( global_string, line_string ) ;

		row_count ++ ;
	}

	if ( rows_list > 0 )
	{
		strcat ( global_string, "{"#cBL"}Предыдущая страница\n" ) ;
		set_player_use_page ( playerid, row_count, 0 ) ;
		row_count ++ ;
	}
	if ( ofm_formula ( page_count [ playerid ] ) < page_rows [ playerid ] )
	{
		strcat ( global_string, "{"#cBL"}Следующая страница\n" ) ;
		set_player_use_page ( playerid, row_count, 1 ) ;
	}

	show_dialog(playerid, d_taxi_panel, DIALOG_STYLE_LIST, "{"#cBHD"}Остановки", global_string, "Выбрать", "Закрыть" ) ;
	return 1 ;
}

CMD:vowner ( playerid )
{
	if ( admin_info [ playerid ] [ admin ] < 8 ) return 1 ;
	new _str [ 64 ] ;
	format ( _str, 64, "%s[%d] owner %d type", get_player_account_name ( veh_info [ GetPlayerVehicleID ( playerid ) - 1 ] [ v_owner ] ), veh_info [ GetPlayerVehicleID ( playerid ) - 1 ] [ v_owner ], veh_info [ GetPlayerVehicleID ( playerid ) - 1 ] [ v_type ] ) ;
	SendClientMessage ( playerid, -1, _str ) ;
	return 1 ;
}

CMD:pts ( playerid, params [ ] )
{
	if ( ! IsPlayerInAnyVehicle ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны находиться в транспорте!");
	new _v_id = GetPlayerVehicleID ( playerid ) ;
	if ( veh_info [ _v_id - 1 ] [ v_owner ] != p_info [ playerid ] [ id ] || veh_info [ _v_id - 1 ] [ v_type ] != vehicle_type_player ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны находиться в вашем личном транспорте!");
	if ( sscanf ( params, "u", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /pts [ид/имя]");
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;

    if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;

	if ( params [ 0 ] == playerid ) me_action ( playerid, "посмотрел(-а) паспорт транспортного средства" ) ;
	else
	{
	    new scm_string [ 48 + MAX_PLAYER_NAME ] ;
		format ( scm_string, sizeof ( scm_string ), "показал(-а) паспорт транспортного средства %s", p_info [ params [ 0 ] ] [ name ] ) ;
		me_action ( playerid, scm_string ) ;
	}

	if ( player_device { params [ 0 ] } == 2 ) show_window_pts ( params [ 0 ], _v_id ) ;
	else show_pts ( params [ 0 ], _v_id ) ;
	return 1 ;
}

stock show_pts ( playerid, _v_id )
{
	global_string [ 0 ] = EOS ;
	new _model = getVehicleOrdinalNumber ( _v_id ) ;
	format(global_string, sizeof global_string, "\
	{FFFFFF}Владелец:\t{"#cGN"}%s\n\
	{FFFFFF}Модель:\t{"#cGN"}%s\n\
	{FFFFFF}Пробег:\t{"#cGN"}%.1f км\n\
	{FFFFFF}Можно скрутить до:\t{"#cGN"}%.1f км\n\
	{FFFFFF}Номерной знак:\t{"#cGN"}%s\n \n\
	{"#cBL"}** Улучшения автомобиля **\t{"#cWH"}\n \n\
	Колёса:\t%s",
	p_info [ playerid ] [ name ], GetVehicleNameEx ( INVALID_VEHICLE_ID, _model ),
	veh_info [ _v_id - 1 ] [ v_millage ], veh_info [ _v_id - 1 ] [ v_legal_millage ], plate_number ( _v_id ),
	( veh_info [ _v_id - 1 ] [ v_disk_id ] ) ? ( "{"#cGN"}Есть{"#cWH"}" ) : ( "{"#cRD"}Нет{"#cWH"}" ) ) ;

	show_dialog ( playerid, d_none, DIALOG_STYLE_TABLIST, "{"#cBHD"}Технический паспорт", global_string, "Закрыть", "" ) ;
	return 1 ;
}

CMD:vpark ( playerid )
{
	for ( new j = 0 ; j < MAX_NONPARKING_ZONES ; j ++ )
	{
		if ( ! IsPlayerInQuad ( playerid, non_parking_pos [ j ] [ 0 ], non_parking_pos [ j ] [ 1 ], non_parking_pos [ j ] [ 2 ], non_parking_pos [ j ] [ 3 ] ) )continue ;

		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете припарковать транспорт в зоне запрета парковки." ) ;
		return 1 ;
	}
	if ( GetPlayerState ( playerid ) != PLAYER_STATE_DRIVER )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны находиться за рулём транспортного средства." ) ;

	new veh_id = GetPlayerVehicleID ( playerid ) ;
	if ( IsValidVehicle ( veh_id ) )
	{
		if ( veh_info [ veh_id - 1 ] [ v_owner ] != p_info [ playerid ] [ id ] || veh_info [ veh_id - 1 ] [ v_type ] != vehicle_type_player )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны находиться в вашем личном транспорте." ) ;
		new Float:vehicle_health ;
		GetVehicleHealth ( veh_id, vehicle_health ) ;
		if ( vehicle_health < 950 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Для начала нужно починить транспортное средство." ) ;

        foreach(new j: streamed_vehicles[playerid])
		{
			if ( ! IsValidVehicle ( j ) ) continue ;
			if ( veh_info [ j - 1 ] [ v_vw ] == GetPlayerVirtualWorld ( playerid ) && IsPlayerInRangeOfPoint ( playerid, 3.0, veh_info [ j - 1 ] [ v_pos ] [ 0 ], veh_info [ j - 1 ] [ v_pos ] [ 1 ], veh_info [ j - 1 ] [ v_pos ] [ 2 ] ) )
			{
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Невозможно припарковать транспорт вбилизи парковки другого транспортного средства." ) ;
				return 1 ;
			}
		}

		GetVehiclePos ( veh_id, veh_info [ veh_id - 1 ] [ v_pos ] [ 0 ], veh_info [ veh_id - 1 ] [ v_pos ] [ 1 ], veh_info [ veh_id - 1 ] [ v_pos ] [ 2 ] ) ;
		GetVehicleZAngle ( veh_id, veh_info [ veh_id - 1 ] [ v_pos ] [ 3 ] ) ;

		veh_info [ veh_id - 1 ] [ v_vw ] = GetPlayerVirtualWorld ( playerid ) ;
		veh_info [ veh_id - 1 ] [ v_int ] = GetPlayerInterior ( playerid ) ;

		SendClientMessage ( playerid, col_gray, !"* Машина успешно припаркована. Теперь она будет появляться на этом месте!" ) ;

        new scm_string [ 198 ] ;
		format ( scm_string, 198, "UPDATE `users_vehicles` SET `v_pos_x` = '%.2f', `v_pos_y` = '%.2f', `v_pos_z` = '%.2f',`v_pos_a` = '%.2f',`v_vw` = '%d',`v_int` = '%d' WHERE `v_id` = '%d' LIMIT 1",
		veh_info [ veh_id - 1 ] [ v_pos ] [ 0 ], veh_info [ veh_id - 1 ] [ v_pos ] [ 1 ], veh_info [ veh_id - 1 ] [ v_pos ] [ 2 ], veh_info [ veh_id - 1 ] [ v_pos ] [ 3 ],
		veh_info [ veh_id - 1 ] [ v_vw ], veh_info [ veh_id - 1 ] [ v_int ],
		veh_info [ veh_id - 1 ] [ v_id ] ) ;
		mysql_tquery ( sql_connection, scm_string ) ;
	}
	return 1 ;
}

stock available_house_pick ( _pickup_model )
{
	if ( _pickup_model != 1239 && _pickup_model != 19131 && _pickup_model != 19134 &&
		_pickup_model != 19132 && _pickup_model != 1318 && _pickup_model != 19135 &&
		_pickup_model != 19133 && _pickup_model != 19130 ) return false ;
	return true ;
}

alias:fixcar("cars", "car")
CMD:fixcar ( playerid )
{
    if ( ! bad_dialog ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRDialog"}В данный момент недоступно." ) ;
    return show_cars_menu ( playerid ) ;
}

callback: callback_fixcar ( playerid )
{
    new rows, fields ;
	cache_get_data ( rows, fields ) ;

	if ( ! rows ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGR"}У Вас нет транспорта." ) ;

	global_string [ 0 ] = EOS ;
	new line_string [ 128 ], bool: _player_finded = false, _inc_id, str_date [ 86 ],
		_v_plate [ 12 ], _v_region [ 12 ], str_fine [ 26 ], _c_count = 0, _v_country [ 8 ],
		_v_id, _v_model, _v_date_used, _v_fine, _v_sell_price, _v_plate_type ;

	format ( global_string, sizeof ( global_string ), "{"#cBL"}Выберите транспорт для буксировки:\t\n" ) ;
	for ( new i = 0 ; i < rows ; i ++ )
	{
	    _v_id = cache_get_field_content_int ( i, "v_id", sql_connection ) ;
	    _v_model = cache_get_field_content_int ( i, "v_model", sql_connection ) ;
	    _v_date_used = cache_get_field_content_int ( i, "v_date_used", sql_connection ) ;
	    _v_fine = cache_get_field_content_int ( i, "v_fine", sql_connection ) ;
	    _v_sell_price = cache_get_field_content_int ( i, "v_sell_price", sql_connection ) ;

	    cache_get_field_content ( i, "licence_plate_country", _v_country, sql_connection, sizeof _v_country ) ;
	    cache_get_field_content ( i, "licence_plate_number", _v_plate, sql_connection, sizeof _v_plate ) ;
	    cache_get_field_content ( i, "licence_plate_region", _v_region, sql_connection, sizeof _v_region ) ;

		if ( GetString ( _v_country, "RU POLICE" ) ) _v_plate_type = NUMBERPLATE_TYPE_RU_POLICE ;
		else if ( GetString ( _v_country, "RU" ) ) _v_plate_type = NUMBERPLATE_TYPE_RUS ;
		else if ( GetString ( _v_country, "UA" ) ) _v_plate_type = NUMBERPLATE_TYPE_UA ;
		else if ( GetString ( _v_country, "BY" ) ) _v_plate_type = NUMBERPLATE_TYPE_BY ;
		else if ( GetString ( _v_country, "KZ" ) ) _v_plate_type = NUMBERPLATE_TYPE_KZ ;
		else _v_plate_type = 1 ;

	    foreach(new _veh_id: player_vehicles[playerid])
	    {
	        if ( veh_info [ _veh_id - 1 ] [ v_id ] != _v_id ) continue ;

	        _inc_id = _veh_id ;
	        _player_finded = true ;
	        break ;
	    }

	    if ( _v_date_used > 0 )
		{
			new s_year, s_month, s_day, s_hour, s_minute, s_second ;
			timestamp_to_date ( _v_date_used + CONVERT_TIME_TO_MOSCOW, s_year, s_month, s_day, s_hour, s_minute, s_second ) ;
			format ( str_date, sizeof str_date, " (Пропадёт {"#cGN"}%02d.%02d.%d в %02d:%02d:%02d{"#cWH"})", s_day, s_month, s_year, s_hour, s_minute, s_second ) ;
		}
		else format ( str_date, sizeof str_date, "" ) ;

		if ( _v_fine == 1 )
		{
			format ( str_fine, sizeof str_fine, "* На штрафстоянке" ) ;
			set_player_listitem_values ( playerid, _c_count, -1 ) ;
		}
		else if ( _v_fine == 2 )
		{
			format ( str_fine, sizeof str_fine, "* В семье" ) ;
			set_player_listitem_values ( playerid, _c_count, -100 ) ;
		}
		else
		{
			if ( _v_sell_price )
			{
				format ( str_fine, sizeof str_fine, "* Выставлена на продажу" ) ;
				set_player_listitem_values ( playerid, _c_count, -2 ) ;
			}
			else
			{
				format ( str_fine, sizeof str_fine, "* Не загружена" ) ;
				set_player_listitem_values ( playerid, _c_count, _v_id ) ;
			}
		}

		_c_count ++ ;

	    if ( _player_finded )
		{
			format ( line_string, sizeof line_string, "{"#cWH"}%s {"#cGRDialog"}(%d){"#cWH"}%s. Номера: {"#cGRDialog"}%s\n",
			GetVehicleNameEx ( INVALID_VEHICLE_ID, _v_model ), _inc_id, str_date, plate_number1 ( _v_plate_type, _v_plate, _v_region ) ) ;
			strcat ( global_string, line_string ) ;
		}
		else
		{
			format ( line_string, sizeof line_string, "{"#cWH"}%s{"#cWH"}%s. {"#cGRDialog"}%s\n",
			GetVehicleNameEx ( INVALID_VEHICLE_ID, _v_model ), str_date, str_fine ) ;
			strcat ( global_string, line_string ) ;
		}
	    _player_finded = false ;
	}

	strcat ( global_string, "{"#cGRDialog"}Забрать транспорт из семьи\n" ) ;
	set_player_listitem_values ( playerid, _c_count, -100 ) ;
	_c_count ++ ;

	format ( line_string, sizeof line_string, "{"#cGRDialog"}У Вас %d из %d транспортных средств\n", rows, p_info [ playerid ] [ max_veh ] ) ;
	strcat ( global_string, line_string ) ;

	set_player_listitem_values ( playerid, _c_count, -1 ) ;

	show_dialog ( playerid, d_fixcar, DIALOG_STYLE_LIST, "{"#cBHD"}Аварийная служба", global_string, "Выбрать", "Закрыть" ) ;
	return 1 ;
}

callback: callback_fixcar_family ( playerid )
{
    new rows, fields ;
	cache_get_data ( rows, fields ) ;

	if ( ! rows )
	{
	    new sql_string [ 116 + ( 9 * 2 ) ] ;
		format ( sql_string, sizeof sql_string, "UPDATE `users_vehicles` SET `v_fine` = '0' WHERE `v_owner` = '%d' AND `v_fine` = '2' LIMIT %d", p_info [ playerid ] [ id ], p_info [ playerid ] [ max_veh ] ) ;
		mysql_tquery ( sql_connection, sql_string ) ;

		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет транспорта во владении семьи." ) ;
		return 1 ;
	}

	new sql_string [ 116 + ( 9 * 2 ) ], _sv_id, _sv_model, _sv_owner, bool: _finded_cars = false ;
	for ( new i = 0 ; i < rows ; i ++ )
	{
	    _sv_id = cache_get_field_content_int ( i, "sv_id", sql_connection ) ;
	    _sv_model = cache_get_field_content_int ( i, "sv_model", sql_connection ) ;
	    _sv_owner = cache_get_field_content_int ( i, "sv_owner", sql_connection ) ;

		format ( sql_string, sizeof ( sql_string ), "{%s}[FAM] %s[%i] забрал(а) %s из владений семьи.", family_info [ _sv_owner - 1 ] [ fam_chat_color ], p_info [ playerid ] [ name ], playerid, GetVehicleNameEx ( INVALID_VEHICLE_ID, _sv_model ) ) ;
	    family_message ( _sv_owner, col_gray, sql_string ) ;

	    _finded_cars = false ;
		foreach(new v: family_vehicles[_sv_owner])
	    {
	        if ( ! IsValidVehicle ( v ) ) continue ;
		    if ( veh_info [ v - 1 ] [ v_id ] != _sv_id ) continue ;

            sql_string [ 0 ] = EOS ;
			format ( sql_string, sizeof sql_string, "DELETE FROM `familys_vehicles` WHERE `sv_id` = '%d' LIMIT 1", _sv_id ) ;
			mysql_tquery ( sql_connection, sql_string ) ;

			new target_id = veh_info [ v - 1 ] [ v_renter ] ;
		    if ( target_id != INVALID_PLAYER_ID && IsPlayerConnected ( target_id ) )
		   	{
				player_rentcar [ target_id ] = INVALID_VEHICLE_ID ;
				SendClientMessage ( target_id, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Арендованный транспорт был отбуксирован. Владелец забрал своё т/с из семьи." ) ;
			}

			Iter_Remove(family_vehicles[_sv_owner], v);
		   	DestroyVehicle ( v, 110 ) ;

		   	_finded_cars = true ;
			break ;
	    }

	    if ( ! _finded_cars )
	    {
	        sql_string [ 0 ] = EOS ;
			format ( sql_string, sizeof sql_string, "DELETE FROM `familys_vehicles` WHERE `sv_id` = '%d' LIMIT 1", _sv_id ) ;
			mysql_tquery ( sql_connection, sql_string ) ;
	    }
	}

	sql_string [ 0 ] = EOS ;
	format ( sql_string, sizeof sql_string, "UPDATE `users_vehicles` SET `v_fine` = '0' WHERE `v_owner` = '%d' AND `v_fine` = '2' LIMIT %d", p_info [ playerid ] [ id ], p_info [ playerid ] [ max_veh ] ) ;
	mysql_tquery ( sql_connection, sql_string ) ;
	return 1 ;
}

/*alias:fixcar("cars")
CMD:fixcar ( playerid )
{
    new sql_string [ 91 + 9 + 4 ] ;
	format ( sql_string, sizeof sql_string, "SELECT `v_fine` FROM `users_vehicles` WHERE `v_owner` = '%d' AND `v_fine` > '0' LIMIT %d", p_info [ playerid ] [ id ], p_info [ playerid ] [ max_veh ] ) ;
	mysql_tquery ( sql_connection, sql_string, "callback_fixcar", "i", playerid ) ;
	return 1 ;
}

callback: callback_fixcar ( playerid )
{
    new rows, fields ;
	cache_get_data ( rows, fields ) ;

    if ( rows )
	{
        show_dialog ( playerid, d_fine_fixcar, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Информация", "{"#cRD"}ВНИМАНИЕ!\n\n{"#cRD"}ОДИН ИЗ ВАШИХ АВТОМОБИЛЕЙ НАХОДИТСЯ НА ШТРАФСТОЯНКЕ\n{"#cBL"}Чтобы забрать используйте {"#cWH"}'/gps > Прочее > Штрафстоянка'{"#cBL"}.", "Принять", "Закрыть" ) ;
	}
	else
	{
	    if ( Iter_Count(player_vehicles[playerid]) == 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGR"}У Вас нет транспорта или он находится на штрафстоянке." ) ;

	    show_car_used ( playerid, 1 ) ;
	}
	return 1 ;
}*/

stock show_car_used ( playerid, type )
{
	if ( type == 1 )
	{
	    global_string [ 0 ] = EOS ;
	    new line_str [ 128 ], veh_slot = 0, str_date [ 86 ] ;
		format ( global_string, sizeof ( global_string ), "{"#cBL"}Выберите транспорт для буксировки:\t\n" ) ;
		foreach(new veh_id: player_vehicles[playerid])
		{
		    if ( veh_info [ veh_id - 1 ] [ v_date_used ] > 0 )
			{
				new s_year, s_month, s_day, s_hour, s_minute, s_second ;
				timestamp_to_date ( veh_info [ veh_id - 1 ] [ v_date_used ] + CONVERT_TIME_TO_MOSCOW, s_year, s_month, s_day, s_hour, s_minute, s_second ) ;
				format ( str_date, sizeof str_date, " (Пропадёт {"#cGN"}%02d.%02d.%d в %02d:%02d:%02d{"#cWH"})", s_day, s_month, s_year, s_hour, s_minute, s_second ) ;
			}
			else format ( str_date, sizeof str_date, "" ) ;

			format ( line_str, sizeof line_str, "{"#cWH"}%s {"#cGRDialog"}(%d){"#cWH"}%s. Номера: {"#cGRDialog"}%s\n", GetVehicleNameEx ( veh_id ), veh_id, str_date, plate_number ( veh_id ) ) ;
			strcat ( global_string, line_str ) ;

			set_player_listitem_values ( playerid, veh_slot, veh_id ) ;

			veh_slot ++ ;
		}

		format ( line_str, sizeof line_str, "{"#cGRDialog"}У Вас %d из %d транспортных средств\n", get_player_veh_count ( playerid ), p_info [ playerid ] [ max_veh ] ) ;
		strcat ( global_string, line_str ) ;

		show_dialog(playerid, d_fixcar, DIALOG_STYLE_LIST, "{"#cBHD"}Аварийная служба", global_string, "Выбрать", "Закрыть");
		SetPVarInt ( playerid, "rv_listitems", veh_slot ) ;
	}
	#if defined m_plates
	else if ( type == 2 )
	{
	    global_string [ 0 ] = EOS ;
	    new line_str [ 128 ], veh_slot = 0 ;
		foreach(new veh_id: player_vehicles[playerid])
		{
			if ( veh_info [ veh_id - 1 ] [ v_plate_type ] > 1 ) continue ;

			set_player_listitem_values ( playerid, veh_slot, veh_id ) ;

			veh_slot ++ ;

			format ( line_str, sizeof line_str, "{"#cWH"}%s {"#cGR"}(%d){"#cWH"}.\n", GetVehicleNameEx ( veh_id ), veh_id ) ;
			strcat ( global_string, line_str ) ;
		}
		if ( veh_slot == 0 )
		{
			SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGR"}Весь Ваш транспорт уже имеет номерные знаки." ) ;

			DeletePVar ( playerid, "select_plate" ) ;
			return 1 ;
		}
		show_dialog ( playerid, d_plates_use, DIALOG_STYLE_LIST, "{"#cBHD"}Выберите транспорт", global_string, "Выбрать", "Назад" ) ;
	}
	#endif
	else if ( type == 3 )
	{
	    global_string [ 0 ] = EOS ;
	    new line_str [ 128 ], veh_slot = 0 ;
		foreach(new veh_id: player_vehicles[playerid])
		{
			if ( ! GetString ( veh_info [ veh_id - 1 ] [ v_plate ], "Transit" ) ) continue ;

			set_player_listitem_values ( playerid, veh_slot, veh_id ) ;

			veh_slot ++ ;

			format ( line_str, sizeof line_str, "{"#cWH"}%s {"#cGRDialog"}(%d){"#cWH"}.\n", GetVehicleNameEx ( veh_id ), veh_id ) ;
			strcat ( global_string, line_str ) ;
		}
		show_dialog ( playerid, d_reg_vehicle, DIALOG_STYLE_LIST, "{"#cBHD"}Регистрация транспорта", global_string, "Выбрать", "Назад" ) ;

		if ( veh_slot == 0 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Весь Ваш транспорт уже зарегистрирован." ), show_lspdpayments ( playerid ) ;
	}
	return 1 ;
}

callback: load_fine_admin_vehicles ( playerid, target_id )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;

	if ( ! rows ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGR"}У игрока нет транспортных средств." ) ;

	global_string [ 0 ] = EOS ;
	new line_string [ 128 ], bool: _player_finded = false, _inc_id, str_date [ 86 ], str_fine [ 26 ] ;

	for ( new i = 0 ; i < rows ; i ++ )
	{
	    new _v_id = cache_get_field_content_int ( i, "v_id", sql_connection ) ;
	    new _v_model = cache_get_field_content_int ( i, "v_model", sql_connection ) ;
	    new _v_date_used = cache_get_field_content_int ( i, "v_date_used", sql_connection ) ;
	    new _v_fine = cache_get_field_content_int ( i, "v_fine", sql_connection ) ;
	    new _v_sell_price = cache_get_field_content_int ( i, "v_sell_price", sql_connection ) ;

	    //new _v_plate_type = cache_get_field_content_int ( i, "v_plate_type", sql_connection ) ;
	    //cache_get_field_content ( i, "v_plate", _v_plate, sql_connection, sizeof _v_plate ) ;
	    //cache_get_field_content ( i, "v_region", _v_region, sql_connection, sizeof _v_region ) ;

	    foreach(new _veh_id: player_vehicles[playerid])
	    {
	        if ( veh_info [ _veh_id - 1 ] [ v_id ] != _v_id ) continue ;

	        _inc_id = _veh_id ;
	        _player_finded = true ;
	        break ;
	    }

	    if ( _v_date_used > 0 )
		{
			new s_year, s_month, s_day, s_hour, s_minute, s_second ;
			timestamp_to_date ( _v_date_used + CONVERT_TIME_TO_MOSCOW, s_year, s_month, s_day, s_hour, s_minute, s_second ) ;
			format ( str_date, sizeof str_date, " (Пропадёт {"#cGN"}%02d.%02d.%d в %02d:%02d:%02d{"#cWH"})", s_day, s_month, s_year, s_hour, s_minute, s_second ) ;
		}
		else format ( str_date, sizeof str_date, "" ) ;

		if ( _v_fine == 1 ) format ( str_fine, sizeof str_fine, "* На штрафстоянке" ) ;
		else if ( _v_fine == 2 ) format ( str_fine, sizeof str_fine, "* В семье" ) ;
		else
		{
			if ( _v_sell_price ) format ( str_fine, sizeof str_fine, "* Выставлена на продажу" ) ;
			else format ( str_fine, sizeof str_fine, "* Не загружена" ) ;
		}

	    if ( _player_finded )
		{
			format ( line_string, sizeof line_string, "{"#cWH"}%s {"#cGRDialog"}(%d){"#cWH"}%s\n",
			GetVehicleNameEx ( INVALID_VEHICLE_ID, _v_model ), _inc_id, str_date ) ;
			strcat ( global_string, line_string ) ;
		}
		else
		{
			format ( line_string, sizeof line_string, "{"#cWH"}%s{"#cWH"}%s. {"#cGRDialog"}%s\n",
			GetVehicleNameEx ( INVALID_VEHICLE_ID, _v_model ), str_date, str_fine ) ;
			strcat ( global_string, line_string ) ;
		}
	    _player_finded = false ;
	}

	format ( line_string, sizeof line_string, "{"#cGRDialog"}У игрока %d из %d транспортных средств\n", rows, p_info [ playerid ] [ max_veh ] ) ;
	strcat ( global_string, line_string ) ;

	show_dialog ( playerid, d_none, DIALOG_STYLE_LIST, "{"#cBHD"}Транспорт игрока", global_string, "Закрыть", "" ) ;
	return 1 ;
}

callback: load_fine_vehicles ( playerid )
{
	new rows,
		fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет транспортных средств.") ;
	global_string [ 0 ] = EOS ;
    new line_str [ 128 ], _id = 0, veh_model, veh_id ;
	for ( new i = 0 ; i < rows ; i ++ )
	{
		veh_id = cache_get_field_content_int ( i, "v_id", sql_connection ) ;
		veh_model = cache_get_field_content_int ( i, "v_model", sql_connection ) ;

		if ( v_boat ( veh_model, 1 ) || v_plane ( veh_model, 1 ) ) continue ;

		set_player_listitem_values ( playerid, _id, veh_id ) ;
		_id ++ ;

		format ( line_str, sizeof line_str, "{"#cGRDialog"}- {"#cWH"}%s.\n", GetVehicleNameEx ( INVALID_VEHICLE_ID, veh_model ) ) ;
		strcat ( global_string, line_str ) ;
	}

	if ( _id == 0 ) SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет транспорта доступного к буксировке." ) ;
	else show_dialog ( playerid, d_fine, DIALOG_STYLE_LIST, "{"#cBHD"}TowCar", global_string, "Выбрать", "Закрыть" ) ;
	return 1 ;
}

CMD:cpanel ( playerid )
{
	if ( GetPlayerState ( playerid ) != PLAYER_STATE_DRIVER ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны находиться за рулём автомобиля." ) ;
	new veh_id = GetPlayerVehicleID ( playerid ) ;
	if ( v_velo ( veh_id ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Недоступно в велосипеде." ) ;

	new dialog_string [ 326 ] ;
	format ( dialog_string, sizeof dialog_string, "{"#cBL"}1. {"#cWH"}Управление двигателем\n{"#cBL"}2. {"#cWH"}Управление фарами\n{"#cBL"}3. {"#cWH"}Просмотреть технический паспорт автомобиля\n{"#cBL"}4. {"#cWH"}Передать ключи от автомобиля\n{"#cBL"}5. {"#cWH"}стробоскопы %s\n{"#cGRDialog"}* Припарковать автомобиль", ( veh_info [ veh_id - 1 ] [ v_strobs ] ) ? ( "{"#cGN"}включены" ) : ( "{"#cRD"}выключены" ) ) ;
	show_dialog ( playerid, d_carpanel, DIALOG_STYLE_LIST, "{"#cBHD"}Меню управления автомобилем", dialog_string, "Выбрать", "Закрыть" ) ;
	return 1 ;
}

CMD:givevkey ( playerid, params [ ] )
{
	new veh_id = GetPlayerVehicleID ( playerid ) ;
	if ( IsValidVehicle ( veh_id ) )
	{
		if ( veh_info [ veh_id - 1 ] [ v_owner ] != p_info [ playerid ] [ id ] || veh_info [ veh_id - 1 ] [ v_type ] != vehicle_type_player ) return SendClientMessage( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны находиться в вашем личном транспорте!" ) ;
		if ( sscanf ( params, "u", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /givevkey [ид]" ) ;
		if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
		if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;
		if ( p_t_info [ params [ 0 ] ] [ v_key ] > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока уже есть ключи от какого-либо автомобиля." ) ;
		p_t_info [ params [ 0 ] ] [ v_key ] = veh_id ;
		new string [ 95 + ( -2 + MAX_PLAYER_NAME ) ] ;
		format ( string, sizeof ( string ), "{"#cGInfo"}* {"#cWH"}Вы успешно выдали ключи от Вашего автомобиля игроку {"#cBL"}'%s'{"#cWH"}.", p_info [ params [ 0 ] ] [ name ] ) ;
		SendClientMessage ( playerid, col_white, string ) ;
		format ( string, sizeof ( string ), "{"#cGN"}* {"#cBL"}%s {"#cWH"}выдал Вам ключи от своего автомобиля.", p_info [ playerid ] [ name ] ) ;
		SendClientMessage ( params [ 0 ], col_white, string ) ;
	}
	else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Для передачи ключей от автомобиля необходимо быть в нём." ) ;
	return 1 ;
}

CMD:takevkey ( playerid, params [ ] )
{
	if ( sscanf ( params, "u", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /takevkey [ид]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;
	if ( p_t_info [ params [ 0 ] ] [ v_key ] == 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока нет ключей от Вашего автомобиля." ) ;
	foreach ( new veh_id:player_vehicles[playerid])
	{
		if ( p_t_info [ params [ 0 ] ] [ v_key ] == veh_id )
		{
			new string [ 128 ] ;
			p_t_info [ params [ 0 ] ] [ v_key ] = 0 ;
			format ( string, sizeof ( string ), "{"#cGN"}* {"#cBL"}%s {"#cWH"}забрал у Вас ключи от своего автомобиля.", p_info [ playerid ] [ name ] ) ;
			SendClientMessage ( params [ 0 ], col_white, string ) ;
			format ( string, sizeof ( string ), "{"#cGInfo"}* {"#cWH"}Вы успешно забрали ключи от своего автомобиля у {"#cBL"}%s{"#cWH"}.", p_info [ params [ 0 ] ] [ name ] ) ;
			SendClientMessage ( playerid, col_white, string ) ;
			return 1 ;
		}
	}
	SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока нет ключей от Вашего автомобиля." ) ;
	return 1 ;
}

alias:sellcar("sellmycar")
CMD:sellcar ( playerid, params [ ] )
{
    if ( p_t_info [ playerid ] [ owner_account ] ) return bad_owner_account ( playerid ) ;

	new veh_id = GetPlayerVehicleID ( playerid ) ;
	if ( veh_id != 0 && IsValidVehicle ( veh_id ) )
	{
		if ( veh_info [ veh_id - 1 ] [ v_owner ] != p_info [ playerid ] [ id ] || veh_info [ veh_id - 1 ] [ v_type ] != vehicle_type_player )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны находиться в вашем личном транспорте!");
		if ( sscanf ( params, "ud", params [ 0 ], params [ 1 ] ) )
		{
			new veh_price = veh_info [ veh_id - 1 ] [ v_price ],
				dialog_str [ 141 + 32 + 9 ] ;

			format ( dialog_str, sizeof ( dialog_str ),"{"#cBL"}Вы действительно хотите продать %s государству за %s"valute_title"?\n\n{"#cGRDialog"}* Для продажи игроку используйте: /sellcar [ид/имя] [цена]",
			GetVehicleNameEx ( veh_id ), GetPlayerCashValueToSmile ( floatround ( ( veh_price * sell_percent ) / 100 ) ) ) ;
			show_dialog ( playerid, d_sellcar_gov, DIALOG_STYLE_MSGBOX," {"#cBL"}Продажа транспортного средства", dialog_str, "Да", "Нет" ) ;
			return 1 ;
		}
		if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
		if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы ввели свой ID." ) ;
		if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( playerid ) != GetPlayerVirtualWorld ( params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;
		if ( params [ 1 ] < 10000 || params [ 1 ] > 100000000 || params [ 1 ] == INVALID_PRICE )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Цена не может быть меньше {"#cRD"}10.000"valute_title_"{"#cGRInfo"} или больше {"#cRD"}100.000.000"valute_title"{"#cGRInfo"}." ) ;
        if ( p_info [ playerid ] [ hour_played ] < THREE_HOUR_PLAYED ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Доступно с 3 часов в игре. Используйте /mm - Информация о персонаже - Статистика персонажа." ) ;
        if ( p_info [ params [ 0 ] ] [ hour_played ] < THREE_HOUR_PLAYED ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не отыграл 3 часа." ) ;
		if ( ! bad_dialog ( params [ 0 ] ) || ! bad_dialog ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок в данный момент не может осуществлять сделки.") ;
		if ( veh_info [ veh_id - 1 ] [ v_date_used ] > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данный транспорт у Вас от промокода, его нельзя продать.") ;
        if ( admin_info [ playerid ] [ admin ] > 0 && admin_info [ playerid ] [ admin ] < 8 && admin_info [ params [ 0 ] ] [ admin ] > 0 && admin_info [ params [ 0 ] ] [ admin ] < 8 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок администратор." ) ;
		if ( cooldown_sentence [ playerid ] > gettime ( ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Предложение о сделке можно отправлять один раз в {"#cRD"}45 секунд{"#cGRInfo"}." ) ;

		clear_player_use_listitem ( playerid ) ;

		new bool: _from_carmarket = true ;
		if ( ! IsPlayerInRangeOfPoint ( playerid, 30.0, b_info [ carmarket_integr_id [ 0 ] - 1 ] [ b_position ] [ 0 ],
														b_info [ carmarket_integr_id [ 0 ] - 1 ] [ b_position ] [ 1 ],
														b_info [ carmarket_integr_id [ 0 ] - 1 ] [ b_position ] [ 2 ] ) ) _from_carmarket = false ;

		set_player_use_listitem ( playerid, carmarket_integr_id [ 0 ] ) ;

		if ( _from_carmarket == false && ! v_boat ( veh_id ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны находиться на авторынке.") ;

		if ( GetString ( p_t_info [ params [ 0 ] ] [ p_ip ], p_t_info [ playerid ] [ p_ip ] ) )
		{
			new scm_string [ 128 ] ;
			format ( scm_string, sizeof ( scm_string ), "{"#cBAdmin"}[A]{"#cGRAdmin"} %s[%d] попытка продажи т/с %s[%d] | same ip", p_info [ playerid ] [ name ], playerid, p_info [ params [ 0 ] ] [ name ], params [ 0 ] ) ;
			foreach(new i: admin_players)SendClientMessage ( i, col_admin, scm_string ) ;

			SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Невозможно продать данному игроку." ) ;
			return 1 ;
		}

		global_string [ 0 ] = EOS ;
		if ( _from_carmarket )
		{
		    new _b_id = get_player_use_listitem ( playerid ) ;

		    new _comission = ( params [ 1 ] * b_price_market [ _b_id - 1 ] [ 1 ] ) / 100 ;
			format ( global_string, 256, "\
				{ffffff}Вы предлагаете %s[%d] приобрести {"#cOR"}%s\n\
				{ffffff}Цена: {"#cGN"}%s"valute_title_"\n\
				{ffffff}Комиссия авторынка: {"#cGN"}%s"valute_title_" (%d%%)",
			p_info [ params [ 0 ] ] [ name ], params [ 0 ], GetVehicleNameEx ( veh_id ), GetPlayerCashValueToSmile ( params [ 1 ] ),
			GetPlayerCashValueToSmile ( _comission ), b_price_market [ _b_id - 1 ] [ 1 ] ) ;
			show_dialog ( playerid, d_sellcar_accept, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Продажа транспорта", global_string, "Продать", "Отмена" ) ;
		}
		else
		{
			format ( global_string, 156, "\
				{ffffff}Вы предлагаете %s[%d] приобрести {"#cOR"}%s\n\
				{ffffff}Цена: {"#cGN"}%s"valute_title_"",
			p_info [ params [ 0 ] ] [ name ], params [ 0 ], GetVehicleNameEx ( veh_id ), GetPlayerCashValueToSmile ( params [ 1 ] ) ) ;
			show_dialog ( playerid, d_sellcar_accept, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Продажа транспорта", global_string, "Продать", "Отмена" ) ;
		}

		buyer_id [ playerid ] = params [ 0 ] ;
		sell_price [ playerid ] = params [ 1 ] ;
		sell_item [ playerid ] = veh_id ;
	}
	else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны находиться в транспорте, который хотите продать." ) ;
	return 1 ;
}

CMD:changecar ( playerid, params [ ] )
{
    if ( p_t_info [ playerid ] [ owner_account ] ) return bad_owner_account ( playerid ) ;

	new veh_id = GetPlayerVehicleID ( playerid ) ;
	if ( veh_id != 0 && IsValidVehicle ( veh_id ) )
	{
		if ( veh_info [ veh_id - 1 ] [ v_owner ] != p_info [ playerid ] [ id ] || veh_info [ veh_id - 1 ] [ v_type ] != vehicle_type_player )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны находиться в вашем личном транспорте!");
		if ( sscanf ( params, "ud", params [ 0 ], params [ 1 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /changecar [ид] [доплата]" ) ;
		if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
		if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы ввели свой ID." ) ;
		if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( playerid ) != GetPlayerVirtualWorld ( params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;
		if ( params [ 1 ] < 10000 || params [ 1 ] > 100000000 || params [ 1 ] == INVALID_PRICE )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Доплата не может быть меньше {"#cRD"}10.000"valute_title_"{"#cGRInfo"} или больше {"#cRD"}100.000.000"valute_title"{"#cGRInfo"}." ) ;
        if ( p_info [ playerid ] [ hour_played ] < THREE_HOUR_PLAYED ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Доступно с 3 часов в игре. Используйте /mm - Информация о персонаже - Статистика персонажа." ) ;
        if ( p_info [ params [ 0 ] ] [ hour_played ] < THREE_HOUR_PLAYED ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не отыграл 3 часа." ) ;
		if ( ! bad_dialog ( params [ 0 ] ) || ! bad_dialog ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок в данный момент не может осуществлять сделки.") ;
		if ( veh_info [ veh_id - 1 ] [ v_date_used ] > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данный транспорт у Вас от промокода, его нельзя продать.") ;
		if ( admin_info [ playerid ] [ admin ] > 0 && admin_info [ playerid ] [ admin ] < 8 && admin_info [ params [ 0 ] ] [ admin ] > 0 && admin_info [ params [ 0 ] ] [ admin ] < 8 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок администратор." ) ;

        new veh_id_param = GetPlayerVehicleID ( params [ 0 ] ) ;
        if ( veh_id_param == 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок должен находиться в личном транспорте!");
		if ( veh_info [ veh_id_param - 1 ] [ v_date_used ] > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данный транспорт у игрока от промокода, его нельзя продать.") ;
		if ( IsValidVehicle ( veh_id_param ) )
		{
			if ( veh_info [ veh_id_param - 1 ] [ v_owner ] != p_info [ params [ 0 ] ] [ id ] || veh_info [ veh_id_param - 1 ] [ v_type ] != vehicle_type_player )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок должен находиться в личном транспорте!");
		}
		if ( cooldown_sentence [ playerid ] > gettime ( ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Предложение о сделке можно отправлять один раз в {"#cRD"}45 секунд{"#cGRInfo"}." ) ;

		clear_player_use_listitem ( playerid ) ;
		new bool: _from_carmarket = true ;
		if ( ! IsPlayerInRangeOfPoint ( playerid, 25.0, b_info [ carmarket_integr_id [ 0 ] - 1 ] [ b_position ] [ 0 ],
														b_info [ carmarket_integr_id [ 0 ] - 1 ] [ b_position ] [ 1 ],
														b_info [ carmarket_integr_id [ 0 ] - 1 ] [ b_position ] [ 2 ] ) ) _from_carmarket = false ;

		set_player_use_listitem ( playerid, carmarket_integr_id [ 0 ] ) ;

		if ( _from_carmarket == false ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны находиться на авторынке." ) ;

        global_string [ 0 ] = EOS ;
		if ( _from_carmarket )
		{
			new _b_id = get_player_use_listitem ( playerid ) ;

		    new _comission = ( params [ 1 ] * b_price_market [ _b_id - 1 ] [ 2 ] ) / 100 ;
		    format ( global_string, 356, "\
				{ffffff}Вы предлагаете %s[%d] обменяться транспортом.\n\
				{ffffff}Транспорт %s: {"#cOR"}%s\n\
				{ffffff}Ваш транспорт: {"#cOR"}%s\n\
				{ffffff}Ваша доплата: {"#cGN"}%s"valute_title_"\n\
				{ffffff}Комиссия авторынка: {"#cGN"}%s"valute_title_" (%d%%)",
			p_info [ params [ 0 ] ] [ name ], params [ 0 ], p_info [ params [ 0 ] ] [ name ],
			GetVehicleNameEx ( veh_info [ veh_id_param - 1 ] [ v_vehicle ] ), GetVehicleNameEx ( veh_id ),
			GetPlayerCashValueToSmile ( params [ 1 ] ), GetPlayerCashValueToSmile ( _comission ), b_price_market [ _b_id - 1 ] [ 2 ] ) ;
			show_dialog ( playerid, d_changecar_accept, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Обмен транспорта", global_string, "Обменять", "Отмена" ) ;
		}
		else
		{
			format ( global_string, 256, "\
				{ffffff}%s[%d] предлагает Вам обменяться транспортом.\n\
				{ffffff}Транспорт %s: {"#cOR"}%s\n\
				{ffffff}Ваш транспорт: {"#cOR"}%s\n\
				{ffffff}Ваша доплата: {"#cWV"}%s"valute_title_"",
			p_info [ params [ 0 ] ] [ name ], params [ 0 ], p_info [ params [ 0 ] ] [ name ], GetVehicleNameEx ( veh_id_param ), GetVehicleNameEx ( veh_id ), GetPlayerCashValueToSmile ( params [ 1 ] ) ) ;
			show_dialog ( playerid, d_changecar_accept, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Обмен транспорта", global_string, "Обменять", "Отмена" ) ;
		}

		if ( veh_info [ veh_id - 1 ] [ v_date_used ] == -1 ) SendClientMessage ( playerid, col_white, !"{"#cBInfo"}* {"#cWH"}Транспортное средство получено Вами в виде бонуса. При продаже будет отнят слот." ) ;
		if ( veh_info [ veh_id_param - 1 ] [ v_date_used ] == -1 ) SendClientMessage ( params [ 0 ], col_white, !"{"#cBInfo"}* {"#cWH"}Транспортное средство получено Вами в виде бонуса. При продаже будет отнят слот." ) ;

        cooldown_sentence [ playerid ] = gettime ( ) + time_sell_sentence ;

		buyer_id [ playerid ] = params [ 0 ] ;
		sell_price [ playerid ] = params [ 1 ] ;
		sell_item [ playerid ] = veh_id ;
	}
	else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны находиться в транспорте, который хотите обменять." ) ;
	return 1 ;
}

CMD:gps ( playerid )
{
	if ( is_quest_used { playerid } )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Невозможно использовать во время прохождения квестов." ) ;
	if ( target_cuff [ playerid ] != INVALID_PLAYER_ID )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы в наручниках." ) ;
	if ( target_tie [ playerid ] != INVALID_PLAYER_ID )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы связаны." ) ;
	if ( exam_start [ playerid ] != false ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Невозможно во время сдачи экзамена." ) ;
	if ( p_t_info [ playerid ] [ pBusRoute ] )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Невозможно использовать в данный момент." ) ;
	if ( is_gps_used { playerid } )
	{
		SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}[GPS] Последняя метка уничтожена." ) ;
		DisablePlayerRaceCheckpoint ( playerid ) ;
		is_gps_used { playerid } = 0 ;

		p_t_info [ playerid ] [ gps_category ] =
		p_t_info [ playerid ] [ gps_id ] = 0 ;
	}
	show_gps ( playerid ) ;
	return 1 ;
}

stock gpsBusinessList ( playerid, businessType, page )
{
	page_count [ playerid ] = page ;

	new count_type = 0, count = 0, Float: _distance ;
	if ( businessType == bizz_type_hotel )
	{
		global_string [ 0 ] = EOS ;
		strcat ( global_string, "{"#cBL"}№. Название:\t{"#cBL"}Свободных номеров:\t{"#cBL"}Расстояние:\n" ) ;
		foreach(new b: business_types[businessType])
		{
			set_player_listitem_values ( playerid, count_type, b ) ;
			count_type ++ ;

			_distance = GetDistanceBetweenPoints ( p_t_info [ playerid ] [ p_pos ] [ 0 ], p_t_info [ playerid ] [ p_pos ] [ 1 ], p_t_info [ playerid ] [ p_pos ] [ 2 ], b_info [ b - 1 ] [ b_position ] [ 0 ], b_info [ b - 1 ] [ b_position ] [ 1 ], b_info [ b - 1 ] [ b_position ] [ 2 ] ) ;
			format ( global_string, sizeof global_string, "%s{"#cBL"}%d. {"#cWH"}%s\t%d шт.\t%.2f км\n", global_string, count_type, b_info [ b - 1 ] [ b_name ], b_info [ b - 1 ] [ b_free_number ], _distance ) ;
		}
	}
	else
	{
		global_string [ 0 ] = EOS ;
		strcat ( global_string, "{"#cBL"}№. Название:\t{"#cBL"}Расстояние:\n" ) ;
		foreach(new b: business_types[businessType])
		{
	    	count_type ++ ;

			if ( page * 20 > count_type ) continue ;
			if ( count_type > ( page + 1 ) * 20 ) continue ;

			set_player_listitem_values ( playerid, count, b ) ;

			count ++ ;

	  		_distance = GetDistanceBetweenPoints ( p_t_info [ playerid ] [ p_pos ] [ 0 ], p_t_info [ playerid ] [ p_pos ] [ 1 ], p_t_info [ playerid ] [ p_pos ] [ 2 ], b_info [ b - 1 ] [ b_position ] [ 0 ], b_info [ b - 1 ] [ b_position ] [ 1 ], b_info [ b - 1 ] [ b_position ] [ 2 ] ) ;
			format ( global_string, sizeof global_string, "%s{"#cBL"}%d. {"#cWH"}%s\t%.2f км\n", global_string, count_type, b_info [ b - 1 ] [ b_name ], _distance ) ;
		}
		set_player_use_listitem ( playerid, businessType ) ;
	}

	if ( page > 0 ) strcat ( global_string, "{"#cBL"}Предыдущая страница\n" ) ;
	if ( count_type > ( page + 1 ) * 20 ) strcat ( global_string, "{"#cBL"}Следующая страница" ) ;

	static const _str [ ] = "{"#cBHD"}%s (Всего: {"#cWH"}%d {"#cBHD"}шт.)" ;
	new header_string [ sizeof _str + 32 + 9 ] ;
	format ( header_string, sizeof header_string, _str, b_types [ businessType ], count_type ) ;
	show_dialog ( playerid, d_gps_biz, DIALOG_STYLE_TABLIST_HEADERS, header_string, global_string, "Выбрать", "Закрыть" ) ;
    return true ;
}

CMD:pass ( playerid, params [ ] )
{
	if ( GetInventoryFindItem ( playerid, SUB_INVENTORY, ITEM_PASSPORT ) < 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет паспорта. Получить его можно в Мэрии." ) ;
	if ( target_cuff [ playerid ] != INVALID_PLAYER_ID )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы в наручниках." ) ;
	if ( target_tie [ playerid ] != INVALID_PLAYER_ID )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы связаны." ) ;
	if ( sscanf ( params, "u", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /pass [ид/имя]");
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;

    if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;
	if ( ! bad_dialog ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Недоступно в данный момент.") ;
	if ( cooldown_sentence [ playerid ] > gettime ( ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Предложение о сделке можно отправлять один раз в {"#cRD"}45 секунд{"#cGRInfo"}." ) ;

	cooldown_sentence [ playerid ] = gettime ( ) + time_sell_sentence ;
	if ( player_device { params [ 0 ] } == 2 ) show_ui_passport ( playerid, params [ 0 ] ) ;
	else show_pass ( playerid, params [ 0 ] ) ;

	if ( params [ 0 ] == playerid ) me_action ( playerid, "посмотрел(-а) свой паспорт" ) ;
	else
	{
		new scm_string [ 25 + MAX_PLAYER_NAME ] ;
		format ( scm_string, sizeof scm_string, "показал(-а) паспорт %s", p_info [ params [ 0 ] ] [ name ] ) ;
		me_action ( playerid, scm_string ) ;

		if ( cop_player ( params [ 0 ] ) || fbi_player ( params [ 0 ] ) ) police_attempt_bool [ params [ 0 ] ] = true ;
	}
	return 1 ;
}

CMD:healme ( playerid, params [ ] )
{
    if ( player_mp [ playerid ] && ! admin_mp_heal )
	{
	    if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Запрещено использовать на мероприятии.", 0, 3, CINFO_INVENTORY_ID, PICTURE_INFO_ERROR, "", "" ) ;
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Запрещено использовать на мероприятии." ) ;
		return 1 ;
	}
    if ( TeamPaint [ playerid ] != 0 )
	{
	    if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Невозможно во время участия в paintball.", 0, 3, CINFO_INVENTORY_ID, PICTURE_INFO_ERROR, "", "" ) ;
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Невозможно во время участия в paintball." ) ;
		return 1 ;
	}
	if ( ! p_info [ playerid ] [ crime_plus ] && heal_cooldown [ playerid ] > gettime ( ) )
	{
	    if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Аптечку можно использовать раз в 60 секунд.", 0, 3, CINFO_INVENTORY_ID, PICTURE_INFO_ERROR, "", "" ) ;
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Аптечку можно использовать раз в {"#cRD"}60{"#cGRInfo"} секунд." ) ;
		return 1 ;
	}
 	if ( target_cuff [ playerid ] != INVALID_PLAYER_ID )
	{
	    if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Вы в наручниках.", 0, 3, CINFO_INVENTORY_ID, PICTURE_INFO_ERROR, "", "" ) ;
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы в наручниках." ) ;
		return 1 ;
	}
	if ( target_tie [ playerid ] != INVALID_PLAYER_ID )
	{
	    if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Вы связаны.", 0, 3, CINFO_INVENTORY_ID, PICTURE_INFO_ERROR, "", "" ) ;
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы связаны." ) ;
		return 1 ;
	}

	if ( sscanf ( params, "d", params [ 0 ] ) )
	{
	    params [ 0 ] = 1 ;
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /healme [тип]" ) ;
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}1 - Аптечка" ) ;
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}2 - Бинт" ) ;
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}3 - Шина" ) ;
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}4 - Аспирин" ) ;
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}5 - Морфий" ) ;
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}6 - Адреналин" ) ;
	}

	if ( params [ 0 ] == 1 )
	{
		new bool: _count = false ;
		for ( new i = 0 ; i < MAX_INVENTORY_SLOTS ; i ++ )
		{
		    if ( GetUsersInventory ( playerid, INV_ITEM, i ) != 145 ) continue ;

		    prise_open ( playerid, i ) ;
            _count = true ;
		    break ;
		}

		if ( ! _count )
		{
		    if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "У вас нет аптечки.", 0, 3, CINFO_INVENTORY_ID, PICTURE_INFO_ERROR, "", "" ) ;
			else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас нет аптечки." ) ;
			return 1 ;
		}
	}
	else if ( params [ 0 ] == 2 )
	{
		new bool: _count = false ;
		for ( new i = 0 ; i < MAX_INVENTORY_SLOTS ; i ++ )
		{
		    if ( GetUsersInventory ( playerid, INV_ITEM, i ) != 146 ) continue ;

		    prise_open ( playerid, i ) ;
		    _count = true ;
		    break ;
		}

		if ( ! _count )
		{
		    if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "У вас нет бинта.", 0, 3, CINFO_INVENTORY_ID, PICTURE_INFO_ERROR, "", "" ) ;
			else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас нет бинта." ) ;
			return 1 ;
		}
	}
	else if ( params [ 0 ] == 3 )
	{
		new bool: _count = false ;
		for ( new i = 0 ; i < MAX_INVENTORY_SLOTS ; i ++ )
		{
		    if ( GetUsersInventory ( playerid, INV_ITEM, i ) != 147 ) continue ;

		    prise_open ( playerid, i ) ;
		    _count = true ;
		    break ;
		}

		if ( ! _count )
		{
		    if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "У вас нет шины.", 0, 3, CINFO_INVENTORY_ID, PICTURE_INFO_ERROR, "", "" ) ;
			else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас нет шины." ) ;
			return 1 ;
		}
	}
	else if ( params [ 0 ] == 4 )
	{
		new bool: _count = false ;
		for ( new i = 0 ; i < MAX_INVENTORY_SLOTS ; i ++ )
		{
		    if ( GetUsersInventory ( playerid, INV_ITEM, i ) != 148 ) continue ;

		    prise_open ( playerid, i ) ;
		    _count = true ;
		    break ;
		}

		if ( ! _count )
		{
