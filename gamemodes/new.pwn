				show_dialog ( playerid, d_donate_rename, DIALOG_STYLE_INPUT, "{"#cBHD"}Донат услуги","{"#cRD"}* Указаный ник не соответствует нормам RP.\n\n{"#cGRDialog"}- {"#cWH"}Смена Ник-Нейма:\n\n{"#cGRDialog"}* Цена: {"#cGN"}100 "donate_title"{"#cGRDialog"}.\n{"#cGRDialog"}* Вы действительно хотите сменить Ваш \"{"#cWH"}Ник-Нейм{"#cGRDialog"}\".","Принять", "Назад");
				return 1 ;
			}
			if ( p_info [ playerid ] [ leader ] > 0 )
			{
				show_dialog ( playerid, d_donate_rename, DIALOG_STYLE_INPUT, "{"#cBHD"}Донат услуги","{"#cRD"}* Пока Вы занимаете лидерский пост Вы не сможете сменить игровое имя.\n\n{"#cGRDialog"}- {"#cWH"}Смена Ник-Нейма:\n\n{"#cGRDialog"}* Цена: {"#cGN"}100 "donate_title"{"#cGRDialog"}.\n{"#cGRDialog"}* Вы действительно хотите сменить Ваш \"{"#cWH"}Ник-Нейм{"#cGRDialog"}\".","Принять", "Назад");
			    return 1 ;
			}

			new query_string [ 61 + MAX_PLAYER_NAME ] ;
			mysql_format ( sql_connection, query_string, sizeof ( query_string ), "SELECT `u_name` FROM `users` WHERE `u_name` = '%e' LIMIT 1", inputtext ) ;
			mysql_tquery ( sql_connection, query_string, "change_donate_name", "ds", playerid, inputtext ) ;
			return 1 ;
		}
		case d_donate_age:
		{
