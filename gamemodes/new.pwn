stock show_hunger ( playerid )
{
    if ( player_device { playerid } == 2 && p_info [ playerid ] [ hud_id ] ) SendCheckHud ( playerid ) ;
    else
    {
	    if ( hunger_td_active [ playerid ] == true )
	    {
		    for ( new j = 0 ; j < 14 ; j ++ )
			{
				TextDrawHideForPlayer ( playerid, satiery_td [ j ] ) ;
				if ( j < 6 )
				{
					PlayerTextDrawDestroy ( playerid, satiery_ptd [ playerid ] [ j ] ) ;
					satiery_ptd [ playerid ] [ j ] = PlayerText:-1 ;
				}
			}
			hunger_td_active [ playerid ] = false ;
			KillTimer ( p_t_info [ playerid ] [ hunger_timer ] ) ;
			p_t_info [ playerid ] [ hunger_timer ] = -1 ;
		}

		if ( hunger_td_active [ playerid ] == false )
		{
			create_hunger_td ( playerid ) ;
		}
	}
	return 1 ;
}

callback: clear_hunger_td ( playerid )
{
	if ( ! hunger_td_active [ playerid ] ) return 1 ;
	for ( new j = 0 ; j < 14 ; j ++ )
	{
		TextDrawHideForPlayer ( playerid, satiery_td [ j ] ) ;
		if ( j < 6 )
		{
			PlayerTextDrawDestroy ( playerid, satiery_ptd [ playerid ] [ j ] ) ;
			satiery_ptd [ playerid ] [ j ] = PlayerText:-1 ;
		}
	}
	hunger_td_active [ playerid ] = false ;
	KillTimer ( p_t_info [ playerid ] [ hunger_timer ] ) ;
	p_t_info [ playerid ] [ hunger_timer ] = -1 ;
	return 1 ;
}

