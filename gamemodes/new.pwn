stock SetPlayerAnimation ( playerid, animid )
{
	if ( 0 <= animid <= sizeof anim_list - 1 )
	{
		switch ( animid + 1 )
		{
			case 1..4:
			{
			    SendClientMessage ( playerid, col_white, !"{"#cBInfo"}* {"#cWH"}Выключить анимацию можно повторно используя команду {"#cBL"}'/anim'{"#cWH"}." ) ;

			    p_t_info [ playerid ] [ p_animation ] = true ;

				SetPlayerSpecialAction(playerid, SPECIAL_ACTION_DANCE1 + animid);
				PlayerPlaySound ( playerid,  1058,  0.0,  0.0,  0.0 ) ;
			}
			default:
			{
			    SendClientMessage ( playerid, col_white, !"{"#cBInfo"}* {"#cWH"}Выключить анимацию можно повторно используя команду {"#cBL"}'/anim'{"#cWH"}." ) ;

 				p_t_info [ playerid ] [ p_animation ] = true ;

				ApplyAnimation(playerid, GetAnimListData(animid, AL_LIB), GetAnimListData(animid, AL_NAME), GetAnimListData(animid, AL_DELTA), (GetAnimListData(animid, AL_LOOP) % 2), GetAnimListData(animid, AL_LOCK_X), GetAnimListData(animid, AL_LOCK_Y), GetAnimListData(animid, AL_FREEZE), GetAnimListData(animid, AL_TIME), 0);
                PlayerPlaySound ( playerid,  1058,  0.0,  0.0,  0.0 ) ;
			}
		}
		return 1;
	}
	return 0;
}

stock AnimListInit ( )
{
	new fmt_str [ 64 ] ;
	for ( new idx = 0 ; idx < sizeof anim_list ; idx ++ )
	{
		format ( fmt_str, sizeof fmt_str, "{"#cBL"}%d.{"#cWH"} %s\n", idx + 1, GetAnimListData ( idx, AL_DESCRIPTION ) ) ;
		strcat ( anim_list_items, fmt_str ) ;

		if ( GetAnimListData ( idx, AL_LOOP ) > 2 )
			anim_list [ idx ] [ AL_DESCRIPTION ] = 2 ;
	}
	strcat ( anim_list_items, "{"#cGRDialog"}Информация" ) ;
}

alias:anim("animlist")
CMD:anim ( playerid, params [ ] )
{
	if ( GetPlayerState ( playerid ) != PLAYER_STATE_ONFOOT ) return 1 ;

	/*if ( anim_loaded { playerid } == 0 )
	{
     	PreloadAnimLibs ( playerid ) ;
		anim_loaded { playerid } = 1 ;

		SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Анимации успешно загружены! Можете использовать.");
		return 1 ;
	}*/

	if ( p_t_info [ playerid ] [ p_animation ] == true )
	{
		ClearAnimations ( playerid ) ;
		p_t_info [ playerid ] [ p_animation ] = false ;
		SetPlayerSpecialAction( playerid, SPECIAL_ACTION_NONE ) ;
		return 1 ;
	}

	if ( ! strlen ( params ) )
	{
		show_dialog ( playerid, d_animations, DIALOG_STYLE_LIST, "{"#cBHD"}Анимации", anim_list_items, "Выбрать", "Закрыть" ) ;
	}
	else
	{
		extract params -> new anim_id ;

		if ( ! SetPlayerAnimation ( playerid, anim_id - 1 ) )
			return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /anim(list) [номер анимации из списка]");
	}
	return 1 ;
}

