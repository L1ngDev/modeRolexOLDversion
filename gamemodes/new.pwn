					}
					else
					{
						b_info [ _b_id - 1 ] [ b_close ] = 1 ;
						SendClientMessage ( playerid, col_succes, !"Вы закрыли бизнес для посетителей." ) ;
					}

					new query_string [ 92 ] ;
					format ( query_string,sizeof(query_string),"UPDATE `businesses` SET `b_close` = '%d' WHERE `b_id` = '%d' LIMIT 1", b_info [ _b_id - 1 ] [ b_close ], p_info [ playerid ] [ business ] ) ;
					mysql_tquery ( sql_connection, query_string ) ;

					show_bpanel ( playerid ) ;
					update_blabel ( _b_id - 1 ) ;
