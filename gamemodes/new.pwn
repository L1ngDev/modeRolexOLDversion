	    }
	}
	return 1 ;
}

public OnPlayerClickTextDraw ( playerid, Text:clickedid )
{
	if ( p_t_info [ playerid ] [ p_dialog ] != -1 ) return 1 ;

	if ( reg_info [ playerid ] [ reg_national ] != 0 )
	{
		if ( ! ( _:clickedid ^ 0xFFFF ) )return SelectTextDraw ( playerid, 0xB0C4DEFF ) ;
	}

	if ( dr_timer [ playerid ] != -1 || dr_slot_item [ playerid ] [ 0 ] != 0 || p_skin_shop [ playerid ] == true )
	{
		if ( !( _:clickedid ^ 0xFFFF ) )
		{
			SelectTextDraw ( playerid, 0xB0C4DEFF ) ;
			return 1 ;
		}
	}

	if ( action_type { playerid } != 0 )
	{
	    if ( !( _:clickedid ^ 0xFFFF ) )
	    {
		    switch ( action_type { playerid } )
		    {
		    	case ACTION_CELLAR:
				{
				    action_step { playerid } = 0 ;
					action_td_status ( playerid, false ) ;
				}
				case ACTION_CLCELLAR:
				{
				    action_step { playerid } = 0 ;
					action_td_status ( playerid, false ) ;
				}
				case ACTION_FACTORY:
				{
				    RemovePlayerAttachedObject ( playerid, 0 ) ;
					RemovePlayerAttachedObject ( playerid, 1 ) ;

					action_td_status ( playerid, false ) ;
				}
				case ACTION_ARMY_GATE:
				{
				    action_step { playerid } = 0 ;
					action_td_status ( playerid, false ) ;
				}
				case ACTION_JACKCAR:
				{
				    ClearAnimations(playerid);

				    action_step { playerid } = 0 ;
					action_td_status ( playerid, false ) ;
				}
				case ACTION_JACK_IN_CAR:
				{
				    ClearAnimations(playerid);

				    action_step { playerid } = 0 ;
					action_td_status ( playerid, false ) ;
				}
	            case ACTION_GRAFFITY:
	            {
	                ClearAnimations(playerid);

	                action_step { playerid } = 0 ;
					action_td_status ( playerid, false ) ;
	            }
	            case ACTION_FAM_GRAFFITY:
	            {
	                ClearAnimations(playerid);

	                action_step { playerid } = 0 ;
					action_td_status ( playerid, false ) ;
	            }
	            case ACTION_PLANT:
	            {
	                RemovePlayerAttachedObject ( playerid, 0 ) ;
	                ClearAnimations(playerid);

	                action_step { playerid } = 0 ;
					action_td_status ( playerid, false ) ;
	            }
	            case ACTION_BANK:
	            {
	                ClearAnimations(playerid);

	                action_step { playerid } = 0 ;
					action_td_status ( playerid, false ) ;
	            }
			}
		}
	}

    if ( player_dice_table { playerid } )
	{
		if ( clickedid == dice_td [ 54 ] ) return show_dialog ( playerid, d_dice_exit,DIALOG_STYLE_MSGBOX, "{"#cBHD"}Предупреждение","{ffffff}Если вы сделали ставку и игра уже началась, то деньги Вам возвращены не будут\n\n{"#cGRDialog"}* Вы действительно хотите покинуть стол?", "Выйти", "Отмена" ) ;
		else if ( clickedid == dice_td [ 57 ] )
		{
		    new biz_id = GetPVarInt ( playerid, "p_biz_id" ), _table = player_dice_table { playerid } ;
			if ( player_croupier [ playerid ] )
			{
				new null = 0 ;
				for ( new i = 0 ; i < 5 ; i++ ) if ( GetPVarInt ( dice_info [ biz_id ] [ _table - 1 ] [ b_player ] [ i ], "InGame" ) ) null++ ;
				if ( null > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}В данный момент вы не можете изменить ставку." ) ;
				return show_dialog(playerid,d_dice_bet, DIALOG_STYLE_INPUT, "{"#cBHD"}Установка ставки для игры","{ffffff}Введите сумму для ставки\n\n{"#cGRDialog"}* Ставка должна быть не менее 1.000"valute_title_" и не более 300.000.000"valute_title_"","Далее","Отмена");
			}
			if ( ! dice_info [ biz_id ] [ _table - 1 ] [ b_bet ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Ставка не установлена." ) ;
			if ( GetPVarInt ( playerid, "InGame" ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Ты уже поставил ставку." ) ;
			if ( p_info [ playerid ] [ money ] < dice_info [ biz_id ] [ _table - 1 ] [ b_bet ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Недостаточно средств." ) ;
            if ( dice_info [ biz_id ] [ _table - 1 ] [ b_started ] > 0) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игра уже запущена." ) ;
			give_money ( playerid, -dice_info [ biz_id ] [ _table - 1 ] [ b_bet ] ) ;
			insert_money_log ( playerid, INVALID_PLAYER_ID, -dice_info [ biz_id ] [ _table - 1 ] [ b_bet ], "ставка кости" ) ;

			dice_info [ biz_id ] [ _table - 1 ] [ b_bank ] += dice_info [ biz_id ] [ _table - 1 ] [ b_bet ] ;
			SetPVarInt(playerid, "InGame", 1);
			update_bone ( _table - 1, biz_id ) ;
			update_bone_table ( biz_id, _table - 1 ) ;
		}
		else if ( clickedid == dice_td [ 60 ] )
		{
			if ( player_croupier [ playerid ] )
			{
				new null = 0 ;
				new biz_id = GetPVarInt ( playerid, "p_biz_id" ), _table = player_dice_table { playerid } ;
				for(new i; i < 5; i++) if ( GetPVarInt ( dice_info [ biz_id ] [ _table - 1 ] [ b_player ] [ i ], "InGame")) null++ ;
				if(null < 2) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Не хватает игроков для старта." ) ;
				if(dice_info [ biz_id ] [ _table - 1 ] [ b_started ] > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игра уже запущена." ) ;

				dice_info [ biz_id ] [ _table - 1 ] [ b_started ] = 30 ;
				dice_info [ biz_id ] [ _table - 1 ] [ b_timer ] = SetTimerEx ( "dice_timer", 1000, true, "ii", biz_id, _table - 1 ) ;
				return 1 ;
			}
			else
			{
				if(!GetPVarInt(playerid,"InGame")) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не поставили ставку." ) ;
	            new biz_id = GetPVarInt ( playerid, "p_biz_id" ), _table = player_dice_table { playerid } ;
				if ( dice_info [ biz_id ] [ _table - 1 ] [ b_started ] <= 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}В данный момент нельзя кинуть кости." ) ;
				if ( GetPVarInt ( playerid, "InGame" ) > 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы уже кидали кубики в этом раунде." ) ;
				new null = 0 ;
				SetPVarInt ( playerid, "InGame", random ( 11 ) + 2 ) ;
				update_bone ( _table - 1, biz_id ) ;
				new i ;
				for ( new g = 0 ; g < MAX_PLAYER_DICE - 1 ; g ++ )
				{
					i = dice_info [ biz_id ] [ _table - 1 ] [ b_player ] [ g ] ;
					if ( ! IsPlayerConnected ( i ) ) continue ;

					if ( GetPVarInt ( i, "InGame") == 1 ) null ++ ;
				}
				if ( ! null ) dice_info [ biz_id ] [ _table - 1 ] [ b_started ] = 4 ;
			}
		}

		if ( ! (_:clickedid ^ 0xFFFF) )
		{
			show_dialog ( playerid, d_dice_exit, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Предупреждение","{ffffff}Если вы сделали ставку и игра уже началась, то деньги Вам возвращены не будут\n\n{"#cGRDialog"}* Вы действительно хотите покинуть стол?", "Выйти", "Отмена" ) ;
			return SelectTextDraw ( playerid, 0xB0C4DEFF ) ;
		}
	}
	if ( GetPVarInt ( playerid, "p_acc_listitem" ) )
	{
		if(!(_:clickedid ^ 0xFFFF) || clickedid == acc_td [ 18 ] )
		{
			show_dialog(playerid, d_accessories_exit,DIALOG_STYLE_MSGBOX, "{"#cBHD"}Отказ от покупки","{ffffff}Вы действительно желаете покинуть меню покупки аксессуаров?", "Выйти", "Отмена" ) ;
		}
	}
	if ( clickedid == td_regskins [ 12 ] )
	{
		new skin_count = GetPVarInt ( playerid, "skin_select_number" ) ;
		if ( skin_count == 0 ) return 1 ;
		SetPVarInt ( playerid, "skin_select_number", skin_count - 1 ) ;
		SetPlayerSkin ( playerid, registration_skins [ reg_info [ playerid ] [ reg_national ] - 1 ][ reg_info [ playerid ] [ reg_gender ] - 1 ] [ skin_count - 1 ] ) ;
		return 1 ;
	}
	else if ( clickedid == td_regskins [ 6 ] )
	{
		new skin_count = GetPVarInt ( playerid, "skin_select_number" ) ;
		if ( skin_count == 4 ) return 1 ;
		SetPVarInt ( playerid, "skin_select_number", skin_count + 1 ) ;
		SetPlayerSkin ( playerid, registration_skins [ reg_info [ playerid ] [ reg_national ] - 1 ][ reg_info [ playerid ] [ reg_gender ] - 1 ] [ skin_count + 1 ] ) ;
		return 1 ;
	}
	else if ( clickedid == td_regskins [ 10 ] )
	{
		reg_info [ playerid ] [ reg_skin ] = registration_skins [ reg_info [ playerid ] [ reg_national ] - 1 ][ reg_info [ playerid ] [ reg_gender ] - 1 ] [ GetPVarInt ( playerid, "skin_select_number" ) ] ;

		DeletePVar ( playerid, "skin_select_number" ) ;
		DeletePVar ( playerid, "skin_selection" ) ;
		for ( new i = 0; i < 22 ; i ++ )
		{
			TextDrawHideForPlayer ( playerid, td_regskins [ i ] ) ;
			CancelSelectTextDraw ( playerid ) ;
		}

		switch ( random ( 3 ) )
	    {
			case 0:
			{
			    SetPlayerCameraPos ( playerid, -434.7303, 920.1633, 41.6910 ) ;
				SetPlayerCameraLookAt ( playerid, -489.0881, 910.4733, 28.4928 ) ;
			}
			case 1:
			{
			    SetPlayerCameraPos ( playerid, -434.7303, 920.1633, 41.6910 ) ;
				SetPlayerCameraLookAt ( playerid, -489.0881, 910.4733, 28.4928 ) ;
			    //SetPlayerCameraPos ( playerid, 1124.9702, 2714.2822, 26.8169 ) ;
				//SetPlayerCameraLookAt ( playerid, 1130.7309, 2666.2785, 18.2449 ) ;
			}
			case 2:
			{
			    SetPlayerCameraPos ( playerid, -434.7303, 920.1633, 41.6910 ) ;
				SetPlayerCameraLookAt ( playerid, -489.0881, 910.4733, 28.4928 ) ;
			    //SetPlayerCameraPos ( playerid, -2188.8039, -2565.1611, 52.7962 ) ;
				//SetPlayerCameraLookAt ( playerid, -2147.4816, -2711.9841, 20.1075 ) ;
			}
		}
		set_world ( playerid, playerid + 1 ) ;
		set_interior ( playerid, 0 ) ;

		show_register ( playerid ) ;
		return 1 ;
	}

	else if ( clickedid == td_skinshop [ 23 ] || clickedid == td_skinshop [ 24 ] ) SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данная кнопка доступна при выборе акссесуаров." ) ;
	else if ( clickedid == td_skinshop [ 20 ] )
	{
	  	new _gender = p_info [ playerid ] [ gender ] ;
		new skin_count = GetPVarInt ( playerid, "skin_select_number" ) ;
		if ( skin_count == 0 )
		{
			if ( _gender == 0 )
			{
				skin_count = last_skin_shop [ 0 ] ;
				SetPVarInt ( playerid, "skin_select_number", skin_count ) ;
				SetPlayerSkin ( playerid, shop_skins [ _gender ] [ skin_count ] ) ;

				new _td_string [ 16 ] ;
				format ( _td_string, sizeof _td_string, "%d$", shop_skins_price [ _gender ] [ skin_count ] ) ;
				PlayerTextDrawSetString ( playerid, td_skinshop_price [ playerid ], _td_string ) ;
				return 1 ;
			}
			else if ( _gender == 1 )
			{
				skin_count = last_skin_shop [ 1 ] ;
				SetPVarInt ( playerid, "skin_select_number", skin_count ) ;
				SetPlayerSkin ( playerid, shop_skins [ _gender ] [ skin_count ] ) ;

				new _td_string [ 16 ] ;
				format ( _td_string, sizeof _td_string, "%d$", shop_skins_price [ _gender ] [ skin_count ] ) ;
				PlayerTextDrawSetString ( playerid, td_skinshop_price [ playerid ], _td_string ) ;
			}
		}
		SetPVarInt ( playerid, "skin_select_number", skin_count - 1 ) ;
		SetPlayerSkin ( playerid, shop_skins [ _gender ] [ skin_count - 1 ] ) ;

		new _td_string [ 16 ] ;
		format ( _td_string, sizeof _td_string, "%d$", shop_skins_price [ _gender ] [ skin_count - 1 ] ) ;
		PlayerTextDrawSetString ( playerid, td_skinshop_price [ playerid ], _td_string ) ;
		return 1 ;
	}
	else if ( clickedid == td_skinshop [ 14 ] )
	{
	  	new _gender = p_info [ playerid ] [ gender ] ;
		new skin_count = GetPVarInt ( playerid, "skin_select_number" ) ;
		if ( _gender == 0 )
		{
			if ( skin_count == last_skin_shop [ 0 ] )
			{
				skin_count = 0 ;
				SetPVarInt ( playerid, "skin_select_number", 0 ) ;
				SetPlayerSkin ( playerid, shop_skins [ _gender ] [ 0 ] ) ;

				new _td_string [ 16 ] ;
				format ( _td_string, sizeof _td_string, "%d$", shop_skins_price [ _gender ] [ 0 ] ) ;
				PlayerTextDrawSetString ( playerid, td_skinshop_price [ playerid ], _td_string ) ;
				return 1 ;
			}
		}
		else if ( _gender == 1 )
		{
			if ( skin_count == last_skin_shop [ 1 ] )
			{
				skin_count = 0 ;
				SetPVarInt ( playerid, "skin_select_number", 0 ) ;
				SetPlayerSkin ( playerid, shop_skins [ _gender ] [ 0 ] ) ;
				new _td_string [ 48 ] ;
				format ( _td_string, sizeof _td_string, "%d$", shop_skins_price [ _gender ] [ 0 ] ) ;
				PlayerTextDrawSetString ( playerid, td_skinshop_price [ playerid ], _td_string ) ;
				return 1 ;
			}
		}
		SetPVarInt ( playerid, "skin_select_number", skin_count + 1 ) ;
		SetPlayerSkin ( playerid, shop_skins [ _gender ] [ skin_count + 1 ] ) ;

		new _td_string [ 16 ] ;
		format ( _td_string, sizeof _td_string, "%d$", shop_skins_price [ _gender ] [ skin_count + 1 ] ) ;
		PlayerTextDrawSetString ( playerid, td_skinshop_price [ playerid ], _td_string ) ;
		return 1 ;
	}
	else if ( clickedid == td_skinshop [ 26 ] )
	{
		new _d_str [ 104 + 9 ] ;
		format ( _d_str, sizeof _d_str, "{ffffff}Стоимость:\t{"#cBL"}%d"valute_title_"\n\n{"#cGRDialog"}* Вы действительно желаете приобрести данную одежду?", shop_skins_price [ p_info [ playerid ] [ gender ] ] [ GetPVarInt ( playerid, "skin_select_number" ) ] ) ;
		show_dialog ( playerid, d_buy_skin, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Покупка одежды", _d_str, "Купить", "Назад" ) ;
		return 1 ;
	}
	else if ( clickedid == td_skinshop [ 18 ] )
	{
		DeletePVar ( playerid, "skin_select_number" ) ;
		p_skin_shop [ playerid ] = false ;

		TogglePlayerControllable ( playerid, true ) ;
		SetCameraBehindPlayer ( playerid ) ;

		show_skinshop_ptd ( playerid, 1, false ) ;

		fraction_duty ( playerid ) ;

		set_world ( playerid, b_info [ GetPVarInt ( playerid, "p_biz_id" ) - 1 ] [ b_id ] + 1000 ) ;
		return 1 ;
	}
	else if ( clickedid == acc_td [ 14 ] )
	{
		new acc_number = GetPVarInt ( playerid, "p_acc_id" ),
			acc_type = GetPVarInt ( playerid, "p_acc_listitem" ) - 1 ;

		if ( accessories_items [ acc_type ] [ acc_number + 1 ] == 1 )
		{
			acc_number = 0 ;
			SetPVarInt ( playerid, "p_acc_id", 0 ) ;
			skinShopAccessories ( playerid, accessories_items [ acc_type ] [ 0 ] ) ;

			new _td_string [ 16 ] ;
			format ( _td_string, sizeof _td_string, "%d$", accessories_items_price [ acc_type ] [ 0 ] ) ;
			PlayerTextDrawSetString ( playerid, acc_ptd [ playerid ], _td_string ) ;
			return 1 ;
		}
		skinShopAccessories ( playerid, accessories_items [ acc_type ] [ acc_number + 1 ] ) ;
		SetPVarInt ( playerid, "p_acc_id", acc_number + 1 ) ;

		new _td_string [ 16 ] ;
		format ( _td_string, sizeof _td_string, "%d$", accessories_items_price [ acc_type ] [ acc_number + 1 ] ) ;
		PlayerTextDrawSetString ( playerid, acc_ptd [ playerid ], _td_string ) ;
		return 1 ;
	}
	else if ( clickedid == acc_td [ 20 ] )
	{
		new acc_number = GetPVarInt ( playerid, "p_acc_id" ),
			acc_type = GetPVarInt ( playerid, "p_acc_listitem" ) - 1 ;

		if ( acc_number == 0 )
		{
			for ( new j = 0 ; j < 50 ; j ++ )
			{
				if ( accessories_items [ acc_type ] [ j + 1 ] == 1 )
				{
					acc_number = j ;
					break ;
				}
			}
			SetPVarInt ( playerid, "p_acc_id", acc_number ) ;
			skinShopAccessories ( playerid, accessories_items [ acc_type ] [ acc_number ] ) ;

			new _td_string [ 16 ] ;
			format ( _td_string, sizeof _td_string, "%d$", accessories_items_price [ acc_type ] [ acc_number ] ) ;
			PlayerTextDrawSetString ( playerid, acc_ptd [ playerid ], _td_string ) ;
			return 1 ;
		}
		new _td_string [ 16 ] ;
		format ( _td_string, sizeof _td_string, "%d$", accessories_items_price [ acc_type ] [ acc_number - 1 ] ) ;
		PlayerTextDrawSetString ( playerid, acc_ptd [ playerid ], _td_string ) ;

		skinShopAccessories ( playerid, accessories_items [ acc_type ] [ acc_number - 1 ] ) ;
		SetPVarInt ( playerid, "p_acc_id", acc_number - 1 ) ;
		return 1 ;
	}
	else if ( clickedid == acc_td [ 26 ] )
	{
		new _d_str [ 107 + 9 ] ;
		format ( _d_str, sizeof _d_str, "{ffffff}Стоимость:\t{"#cBL"}%d"valute_title_"\n\n{"#cGRDialog"}* Вы действительно желаете приобрести данный аксессуар?", accessories_items_price [ GetPVarInt ( playerid, "p_acc_listitem" ) - 1 ] [ GetPVarInt ( playerid, "p_acc_id" ) ] ) ;
		show_dialog ( playerid, d_buy_accessories, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Покупка аксессуаров", _d_str, "Купить", "Назад" ) ;
		return 1 ;
	}
	else if ( clickedid == acc_td [ 23 ] )
	{
	    if ( GetPVarInt ( playerid, "p_acc_view" ) == 1 ) return 1 ;

	    SetPVarInt ( playerid, "p_acc_view", GetPVarInt ( playerid, "p_acc_view" ) - 1 ) ;
	    new _view = GetPVarInt ( playerid, "p_acc_view" ) - 1 ;
	    SetPlayerCameraPos ( playerid, accessories_camera_positions [ _view ] [ 0 ], accessories_camera_positions [ _view ] [ 1 ], accessories_camera_positions [ _view ] [ 2 ] ) ;
		SetPlayerCameraLookAt ( playerid, accessories_camera_positions [ _view ] [ 3 ], accessories_camera_positions [ _view ] [ 4 ], accessories_camera_positions [ _view ] [ 5 ] ) ;
	    return 1 ;
	}
	else if ( clickedid == acc_td [ 24 ] )
	{
	    if ( GetPVarInt ( playerid, "p_acc_view" ) == 3 ) return 1 ;

	    SetPVarInt ( playerid, "p_acc_view", GetPVarInt ( playerid, "p_acc_view" ) + 1 ) ;
	    new _view = GetPVarInt ( playerid, "p_acc_view" ) - 1 ;
	    SetPlayerCameraPos ( playerid, accessories_camera_positions [ _view ] [ 0 ], accessories_camera_positions [ _view ] [ 1 ], accessories_camera_positions [ _view ] [ 2 ] ) ;
		SetPlayerCameraLookAt ( playerid, accessories_camera_positions [ _view ] [ 3 ], accessories_camera_positions [ _view ] [ 4 ], accessories_camera_positions [ _view ] [ 5 ] ) ;
	    return 1 ;
	}
	return 1 ;
}

public OnPlayerGiveDamage ( playerid, damagedid, Float: amount, weaponid, bodypart )
{
	#if defined debug_mode
		printf ( "[DEBUG] [OnPlayerGiveDamage] playerid:%d | damagedid:%d | amount:%f | weaponid:%d", playerid, damagedid, amount, weaponid ) ;
	#endif
	if ( weaponid == 0 && GetPlayerState ( playerid ) != PLAYER_STATE_ONFOOT ) return false ;
	if ( weaponid == 0 && ( GetPlayerDistanceToPlayer ( playerid, damagedid ) > 2 || amount > 6.71 || bodypart == 9 ) ) return false ;
	if ( GetPlayerDistanceToPlayer ( playerid, damagedid ) > 300 ) return false ;
    if ( weaponid == 20090 ) return false ;
    if ( amount > 400 ) return false ;
    if ( pl_afk_time [ damagedid ] > 2 ) return false ;

    #if defined __anti_godmode
		antigm_OnPlayerGiveDamage ( playerid, damagedid, amount, weaponid, bodypart ) ;
	#endif

	#if defined m_guards_module
		guards_OnPlayerGiveDamage ( playerid, damagedid, amount, weaponid, bodypart ) ;
	#endif

 	if ( damagedid != INVALID_PLAYER_ID && playerid != INVALID_PLAYER_ID && IsPlayerConnected ( damagedid ) )
	{
		if ( weaponid == 3 && ( cop_player ( playerid ) || fbi_player ( playerid ) || mayor_player ( playerid ) ) )
		{
			if ( TeamPaint [ playerid ] == 0 && duel_opponent [ playerid ] == INVALID_PLAYER_ID && ! p_t_info [ playerid ] [ tr_team ] )
			{
			    if ( target_cuff [ damagedid ] == INVALID_PLAYER_ID && is_tazered { damagedid } == 0 && GetPlayerState ( damagedid ) == PLAYER_STATE_ONFOOT )
				{
				    if ( ! reload_police_warning ( playerid ) )
			    	{
						ApplyAnimation ( damagedid, "CRACK", "crckdeth2", 4.0, 1, 0, 0, 0, 0 ) ;
						SetTimerEx ( "untazer_timer", 15000, false, "i", damagedid ) ;
				 		TogglePlayerControllable ( damagedid, 0 ) ;
				   		is_tazered { damagedid } = 1 ;

						new _text_string [ 79 + MAX_PLAYER_NAME ] ;
						format ( _text_string, sizeof ( _text_string ), "{"#cBInfo"}* {"#cWH"}Вы оглушили гражданина {"#cBL"}%s{"#cWH"} на 15 секунд.", p_info [ damagedid ] [ name ] ) ;
						SendClientMessage ( playerid, col_white, _text_string ) ;

						format ( _text_string, sizeof ( _text_string ), "{"#cBInfo"}* {"#cWH"}Вы были оглушены {"#cBL"}%s{"#cWH"} на 15 секунд.", p_info [ playerid ] [ name ] ) ;
						SendClientMessage ( damagedid, col_white, _text_string ) ;
					}
					else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы пытаетесь применить NonRP санкцию! Она заблокирована." ) ;
				}
			}
		}
	}
	return 1 ;
}

public OnPlayerTakeDamage ( playerid, issuerid, Float: amount, weaponid, bodypart )
{
	#if defined debug_mode
		printf ( "[DEBUG] [OnPlayerTakeDamage] playerid:%d | issuerid:%d | amount:%f | weaponid:%d | bodypart:%d", playerid, issuerid, amount, weaponid, bodypart ) ;
	#endif

	#if defined __anti_godmode
	antigm_OnPlayerTakeDamage(playerid, issuerid, Float: amount, weaponid, bodypart);
	#endif
	return 1 ;
}

stock show_area_quest_actor ( playerid, _a_type )
{
    if ( _a_type == 0 )
	{
		if ( player_device { playerid } == 2 ) show_open_quest ( playerid ) ;
		else show_quest ( playerid, 0 ) ;
		return 1 ;
	}
	else if ( _a_type == 1 )
	{
	    if ( ! gang_player ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Проваливай от сюда, пока тебя парни не увидели." ) ;

		return show_getto_quest ( playerid ) ;
	}
	else if ( _a_type == 2 )
	{
		if ( ! mafia_player ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Сяо, ты не авторитет криминального мира, ступай с миром." ) ;

		return show_mafia_quest ( playerid ) ;
	}
	else if ( _a_type == 3 )
	{
 		if ( ! p_info [ playerid ] [ family ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Мне кажется, что ты ронин. Уходи!" ) ;
        if ( p_info [ playerid ] [ hour_played ] < THREE_HOUR_PLAYED ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Доступно с 3 часов в игре. Используйте /mm - Информация о персонаже - Статистика персонажа." ) ;

		if ( player_device { playerid } == 2 ) show_open_quest ( playerid ) ;
		else show_family_quest ( playerid ) ;
		return 1 ;
	}
	else if ( _a_type == 4 )
	{
 		if ( ! gang_player ( playerid ) && ! mafia_player ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Браток, а ты чей будешь? Как определишься - приходи." ) ;

		return show_jackcar_quest ( playerid ) ;
	}
	else if ( _a_type == 5 )
	{
		if ( ! p_info [ playerid ] [ family ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не состоите в семье." ) ;

	   	global_string [ 0 ] = EOS ;
		new line_string [ 100 ] ;
  		strcat ( global_string, "{"#cBL"}Название:\t{"#cBL"}Стоимость:\n" ) ;
    	for ( new i = 0 ; i < MAX_FAMILY_TRADE_ITEM ; i ++ )
	    {
     		format ( line_string, sizeof line_string, "{"#cGRDialog"}- {"#cWH"}%s\t%d "family_title"\n", family_trade [ i ] [ family_name ], family_trade [ i ] [ family_price ] ) ;
			strcat ( global_string, line_string ) ;
   		}
	    show_dialog ( playerid, d_family_prise, DIALOG_STYLE_TABLIST_HEADERS, "{"#cBHD"}Товар", global_string, "Выбрать", "Закрыть" ) ;
		return 1 ;
	}
	else if ( _a_type == 6 ) return show_quest ( playerid, 6 ) ;
	else if ( _a_type == 7 ) return show_quest ( playerid, 7 ) ;
	else if ( _a_type == 20 )
	{
		show_dialog ( playerid, d_dealer, DIALOG_STYLE_LIST, "{"#cBHD"}Наркоторговец", "{"#cBL"}1.{"#cWH"} Купить семяна\n{"#cBL"}2.{"#cWH"} Купить наркотики", "Выбрать", "Закрыть" ) ;
  		return 1 ;
	}
	else if ( _a_type == 21 )
	{
 		#if defined m_details_thief
   		if ( ! gang_player ( playerid ) && ! mafia_player ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Браток, а ты чей будешь? Как определишься - приходи." ) ;

		return show_thief_info ( playerid ) ;
		#endif
	}
	return 1 ;
}

stock show_area_carmarket ( playerid )
{
    if ( ! IsPlayerInRangeOfPoint ( playerid, 50.0, b_info [ carmarket_integr_id [ 0 ] - 1 ] [ b_position ] [ 0 ],
													b_info [ carmarket_integr_id [ 0 ] - 1 ] [ b_position ] [ 1 ],
													b_info [ carmarket_integr_id [ 0 ] - 1 ] [ b_position ] [ 2 ] ) ) return 1 ;

	new veh_id = INVALID_VEHICLE_ID ;
	foreach(new i: streamed_vehicles[playerid])
	{
		if ( ! IsPlayerInRangeOfPoint ( playerid, 5.0, veh_info [ i - 1 ] [ v_now_pos ] [ 0 ],
													veh_info [ i - 1 ] [ v_now_pos ] [ 1 ],
													veh_info [ i - 1 ] [ v_now_pos ] [ 2 ] ) ) continue ;

		if ( veh_info [ i - 1 ] [ v_sell_price ] < 1 ) continue ;

		veh_id = i ;
		break ;
	}

	if ( veh_id != INVALID_VEHICLE_ID && veh_info [ veh_id - 1 ] [ v_type ] == vehicle_type_carmarket )
	{
		if ( veh_info [ veh_id - 1 ] [ v_sell_price ] > 0 )
		{
			if ( veh_info [ veh_id - 1 ] [ v_owner ] != p_info [ playerid ] [ id ] )
			{
				global_string [ 0 ] = EOS ;
				format ( global_string, sizeof ( global_string ),
				"{"#cBL"}Покупка транспорта:\n\n{"#cBL"}* {"#cGRDialog"}Модель: {"#cWH"}%s\n{"#cBL"}* {"#cGRDialog"}Стоимость: {"#cWH"}%d"valute_title_"\n{"#cBL"}* {"#cGRDialog"}Номер: {"#cWH"}%s\n{"#cBL"}* {"#cGRDialog"}Пробег: {"#cWH"}%d",
				GetVehicleNameEx ( veh_id ),
				veh_info [ veh_id - 1 ] [ v_sell_price ],
				veh_info [ veh_id - 1 ] [ v_plate ],
				floatround ( veh_info [ veh_id - 1 ] [ v_millage ] ) ) ;

				set_player_use_listitem ( playerid, veh_id ) ;

				strcat ( global_string, "\n{"#cGRDialog"}Вы действительно желаете приобрести данный транспорт?" ) ;
				show_dialog ( playerid, d_carmarket_buy, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Авторынок", global_string, "Купить", "Отмена" ) ;
			}
			else if ( veh_info [ veh_id - 1 ] [ v_owner ] == p_info [ playerid ] [ id ] )
			{
    			set_player_use_listitem ( playerid, veh_id ) ;

				show_dialog ( playerid, d_carmarket_buy, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Продажа транспорта", "{ffffff}Ваш транспорт продаётся, Вы действительно желаете снять его с продажи?\n\n{"#cGRDialog"}* Стоимость услуг авторынка возвращена не будет.", "Принять", "Отмена" ) ;
			}
			return 1 ;
		}
	}
	return 0 ;
}

public OnPlayerKeyStateChange ( playerid, newkeys, oldkeys )
{
	#if defined debug_mode
		printf ( "[DEBUG] [OnPlayerKeyStateChange] playerid:%d | newkeys:%d | oldkeys:%d", playerid, newkeys, oldkeys ) ;
	#endif

	#define PRESSED(%0) (((newkeys & (%0)) == (%0)) && ((oldkeys & (%0)) != (%0)))
	if (((newkeys & KEY_WALK && newkeys & KEY_UP) || (newkeys & KEY_WALK && newkeys & KEY_DOWN) || (newkeys & KEY_WALK && newkeys & KEY_LEFT) || (newkeys & KEY_WALK && newkeys & KEY_RIGHT))
			|| ((oldkeys & KEY_WALK && newkeys & KEY_UP) || (oldkeys & KEY_WALK && newkeys & KEY_DOWN) || (oldkeys & KEY_WALK && newkeys & KEY_LEFT) || (oldkeys & KEY_WALK && newkeys & KEY_RIGHT))
			|| ((newkeys & KEY_WALK && oldkeys & KEY_UP) || (newkeys & KEY_WALK && oldkeys & KEY_DOWN) || (newkeys & KEY_WALK && oldkeys & KEY_LEFT) || (newkeys & KEY_WALK && oldkeys & KEY_RIGHT))
			&& GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
		walk_timer [ playerid ] = SetTimerEx ( "walking_style_callback", 400, 0, "d", playerid ) ;
	}

	if ( newkeys == KEY_CROUCH )
	{
	    if ( used_area [ playerid ] != -1 )
		{
		    if ( area_info [ used_area [ playerid ] ] [ a_type ] == area_type_barriers )
		    {
				new j = area_info [ used_area [ playerid ] ] [ a_item ] ;
				if ( mafia_player ( playerid ) || gang_player ( playerid ) )
				{
				    if ( action_type { playerid } != ACTION_ARMY_GATE )
				    {
						#if defined m_action
						    if ( player_device { playerid } == 2 )
						    {
								action_type { playerid } = ACTION_ARMY_GATE ;
						        actionShow ( playerid, "Взлом ворот", 100 ) ;
						        return 1 ;
						    }
						#endif

						action_type { playerid } = ACTION_ARMY_GATE ;
						action_step { playerid } = 0 ;
						action_td_status ( playerid, true ) ;
						return 1 ;
					}
				}
				if ( j < MAX_BARRIERS )
				{
					for ( new i = 0 ; i < 4 ; i ++ )
					{
					    if ( p_info [ playerid ] [ member ] != barrier_pos [ j ] [ fraction_bar ] [ i ] ) continue ;
						if ( barrier_status [ j ] == true ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Барьер уже поднят!" ) ;

						barrier_status [ j ] = true ;
	                    MoveDynamicObject ( barrier_object [ j ],
											barrier_pos [ j ] [ open_bar ] [ 0 ],
											barrier_pos [ j ] [ open_bar ] [ 1 ],
											barrier_pos [ j ] [ open_bar ] [ 2 ],
											barrier_pos [ j ] [ speed_bar ],
											barrier_pos [ j ] [ open_bar ] [ 3 ],
											barrier_pos [ j ] [ open_bar ] [ 4 ],
											barrier_pos [ j ] [ open_bar ] [ 5 ] ) ;

						SetTimerEx("barrier_callback", 10000, 0, "i", j ) ;
						if ( barrier_pos [ j ] [ double_bar_id ] != -1 )
						{
						    new _double_bar_id = barrier_pos [ j ] [ double_bar_id ] ;
							MoveDynamicObject ( barrier_object [ _double_bar_id ],
												barrier_pos [ _double_bar_id ] [ open_bar ] [ 0 ],
												barrier_pos [ _double_bar_id ] [ open_bar ] [ 1 ],
												barrier_pos [ _double_bar_id ] [ open_bar ] [ 2 ],
												barrier_pos [ _double_bar_id ] [ speed_bar ],
												barrier_pos [ _double_bar_id ] [ open_bar ] [ 3 ],
												barrier_pos [ _double_bar_id ] [ open_bar ] [ 4 ],
												barrier_pos [ _double_bar_id ] [ open_bar ] [ 5 ] ) ;
							SetTimerEx("barrier_callback", 10000, 0, "i", _double_bar_id ) ;
						}

						SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Барьер опустится в течение {"#cBL"}10 секунд{"#cGRInfo"}." ) ;
						return 1 ;
					}
				}
			}
		}
	}
	switch ( GetPlayerState ( playerid ) )
	{
		case PLAYER_STATE_ONFOOT:
		{
			if ( newkeys & KEY_WALK )
			{
				#if defined m_garden
				    if ( garden_KeyStateChange ( playerid, newkeys, oldkeys ) ) return 1 ;
				#endif

				#if defined m_medic
				    if ( medic_OnPlayerKeyStateChange ( playerid, newkeys, oldkeys ) ) return 1 ;
				#endif
			}

			if ( PRESSED ( KEY_YES ) )
			{
				new target_player = GetPlayerTargetPlayer ( playerid ) ;
				new target_actor = GetPlayerTargetActor ( playerid ) ;
				if ( target_player != INVALID_PLAYER_ID )
				{
					if ( ! IsPlayerInRangeOfPoint ( playerid, 1.5, p_t_info [ target_player ] [ p_pos ] [ 0 ], p_t_info [ target_player ] [ p_pos ] [ 1 ], p_t_info [ target_player ] [ p_pos ] [ 2 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;
					SetPVarInt ( playerid, "playerTarget", target_player ) ;
					show_dialog ( playerid, d_player_target, DIALOG_STYLE_LIST, "{"#cBHD"}Меню взаимодействия", "{"#cBL"}1.{ffffff} Показать паспорт\n{"#cBL"}2.{ffffff} Показать лицензии\n{"#cBL"}3.{ffffff} Показать медицинскую карту\n{"#cBL"}4.{ffffff} Показать трудовую книжку\n{"#cBL"}5.{ffffff} Передать оружие\n{"#cBL"}6.{ffffff} Передать 10 единиц наркотиков", "Выбрать", "Закрыть" ) ;
					return 1 ;
				}
				else if ( target_actor != INVALID_ACTOR_ID )
				{
				    new _biz_id = GetPVarInt ( playerid, "p_biz_id" ) ;
				    if ( ! _biz_id ) return bad_exit ( playerid ) ;

				    p_t_info [ playerid ] [ target_actor_id ] = target_actor ;
				    if ( actor_info [ target_actor ] [ ACTOR_TYPE ] == ACTOR_TYPE_DEER )
					{
					    new dialog_string [ 208 + 9 ] ;
					    format ( dialog_string, sizeof dialog_string, "{"#cWH"}Вы можете бросить деньги стриптезёрше, чтобы она лучше танцевала.\nЧем больше денег вы бросите, тем дольше она будет танцевать.\n\n{"#cGRDialog"}* Введите сумму (минимум {"#cGN"}%d"valute_title_"{"#cGRDialog"}):", b_info [ _biz_id - 1 ] [ b_fee ] ) ;
						show_dialog ( playerid, d_strip_club, DIALOG_STYLE_INPUT, "{"#cBHD"}Бросить деньги", dialog_string, "Принять", "Закрыть" ) ;
					}
				    return 1 ;
				}
			}

			if ( player_use_bed { playerid } > 0 && newkeys != KEY_SECONDARY_ATTACK && oldkeys != KEY_SECONDARY_ATTACK )
			{
				h_bed_toggled [ player_use_bed { playerid } - 1 ] [ player_use_bed_world { playerid } - 1 ] = false ;
				ClearAnimations ( playerid, 1 ) ;
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы освободили кровать, лечение прервано." ) ;
				player_use_bed { playerid } = 0 ;
				return 1 ;
			}

			if ( p_info [ playerid ] [ timejob ] == job_sawmil && PRESSED ( KEY_FIRE ) && GetPlayerWeapon ( playerid ) == 9 )
			{
				new _derevo_id = tree_id [ playerid ] ;
				if ( tree_object [ _derevo_id ] != INVALID_OBJECT_ID && IsPlayerInRangeOfPoint ( playerid, 3.5, tree_positions [ _derevo_id ] [ 0 ], tree_positions [ _derevo_id ] [ 1 ], tree_positions [ _derevo_id ] [ 2 ] ) )
				{
					if ( GetTickCount ( ) - cmd_cooldown [ playerid ] < 500 ) return 1 ;
					cmd_cooldown [ playerid ] = GetTickCount ( ) ;

					tree_process [ playerid ] += 2 ;
					if ( tree_process [ playerid ] >= 100 )
					{
						MoveDynamicObject ( tree_object [ _derevo_id ], tree_positions [ _derevo_id ] [ 0 ], tree_positions [ _derevo_id ] [ 1 ], tree_positions [ _derevo_id ] [ 2 ] + 0.004, 0.004, tree_positions [ _derevo_id ] [ 3 ], tree_positions [ _derevo_id ] [ 4 ] + 90, tree_positions [ _derevo_id ] [ 5 ] ) ;
						job_timer [ playerid ] = SetTimerEx ( "main_jobs_timer", 2000, false, "i", playerid ) ;
					}
					else
					{
						new td_string [ 64 ] ;
						format ( td_string, sizeof td_string, "~n~~n~~n~~n~PROCESS: ~g~ %i/100", tree_process [ playerid ] ) ;
						GameTextForPlayer ( playerid, td_string, 2000, 5 ) ;

						format ( td_string, sizeof td_string, "{"#cGInfo"}* {"#cWH"}Прогресс: {"#cGN"}%i/100", tree_process [ playerid ] ) ;
						SendClientMessage ( playerid, col_white, td_string ) ;
					}
					return 1 ;
				}
			}

            if ( g_phone_call [ playerid ] [ PC_STATUS ] )
			{
			    if ( newkeys & KEY_NO )
			    {
					if ( ! p_info [ playerid ] [ number ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас нет телефона." ) ;
					if ( ! g_phone_call [ playerid ] [ PC_ENABLED ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас отключен мобильный телефон." ) ;

                    switch ( p_info [ playerid ] [ sound_call ] )
			 	 	{
			  			case 1062: PlayerPlaySound ( playerid, 1063, 0, 0, 0 ) ;
				   		case 1068: PlayerPlaySound ( playerid, 1069, 0, 0, 0 ) ;
						case 1076: PlayerPlaySound ( playerid, 1077, 0, 0, 0 ) ;
						case 1097: PlayerPlaySound ( playerid, 1098, 0, 0, 0 ) ;
						case 1183: PlayerPlaySound ( playerid, 1184, 0, 0, 0 ) ;
						case 1185: PlayerPlaySound ( playerid, 1186, 0, 0, 0 ) ;
						case 1187: PlayerPlaySound ( playerid, 1188, 0, 0, 0 ) ;
					}

					if ( is_ether_calling { playerid } != 0 )
					{
						is_ether { playerid } = 0 ;
						is_ether_calling { playerid } = 0 ;
						g_phone_call [ playerid ] [ PC_STATUS ] = false ;
						SetPlayerSpecialAction ( playerid, SPECIAL_ACTION_STOPUSECELLPHONE ) ;
						RemovePlayerAttachedObject ( playerid, 2 ) ;
						SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы отключились от эфира." ) ;
						return 1 ;
					}

					#if defined m_phone
						stopUserCalling ( playerid ) ;
					#endif
					return 1 ;
				}
			}
			if ( g_phone_call [ playerid ] [ PC_STATUS ] )
			{
			    if ( newkeys & KEY_YES )
				{
					if ( target_cuff [ playerid ] != INVALID_PLAYER_ID )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы в наручниках." ) ;
					if ( target_tie [ playerid ] != INVALID_PLAYER_ID )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы связаны." ) ;
					if ( ! p_info [ playerid ] [ number ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас нет телефона." ) ;
					if ( ! g_phone_call [ playerid ] [ PC_ENABLED ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас отключен мобильный телефон." ) ;
					if ( ! p_t_info [ playerid ] [ p_logged ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вам никто не звонит." ) ;
					if ( is_ether { playerid } != 0 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете говорить по телефону во время эфира." ) ;

					#if defined m_phone
						startUserCalling ( playerid ) ;
					#endif
					return 1 ;
				}
			}

			if ( GetPlayerInterior ( playerid ) != 0 )
			{
				if ( newkeys & KEY_YES )
				{
				    if ( is_gym_training { playerid } > 0 )
					{
	    				new _gym = p_t_info [ playerid ] [ gym_shell ] ;
					    if ( _gym == 1 && p_t_info [ playerid ] [ gym_time ] <= gettime ( ) + 2 )
						{
							ApplyAnimation ( playerid, "GYMNASIUM", "gym_bike_pedal", 4, 0, 0, 0, 1, 0 ) ;
							p_t_info [ playerid ] [ gym_time ] = gettime ( ) + 2 ;
							if ( p_t_info [ playerid ] [ gym_click ] >= 100 )
							{
								if ( p_info [ playerid ] [ stats ] [ 1 ] < 100 )
								{
									GivePlayerStats ( playerid, 1, 1 ) ;
									GameTextForPlayer ( playerid,"~n~~n~~n~~n~~n~~n~~n~~n~~w~ STAMINA ~g~+1", 3000, 3 ) ;

									checking_quest_progress ( playerid, 1, 1, quest_line_medium ) ;
								}
								p_t_info [ playerid ] [ gym_click ] = 0 ;
							}
							else p_t_info [ playerid ] [ gym_click ] ++ ;
							return 1 ;
						}
						else if ( _gym == 2 && p_t_info [ playerid ] [ gym_time ] <= gettime ( ) + 2 )
						{
							ApplyAnimation ( playerid, "GYMNASIUM", "gym_tread_jog", 4, 0, 0, 0, 1, 0 ) ;
							p_t_info [ playerid ] [ gym_time ] = gettime ( ) + 2 ;
							if ( p_t_info [ playerid ] [ gym_click ] >= 100 )
							{
								if ( p_info [ playerid ] [ stats ] [ 1 ] < 100 )
								{
									GivePlayerStats ( playerid, 1, 1 ) ;
									GameTextForPlayer ( playerid,"~n~~n~~n~~n~~n~~n~~n~~n~~w~ STAMINA ~g~+1", 3000, 3 ) ;

									checking_quest_progress ( playerid, 1, 1, quest_line_medium ) ;
								}
								p_t_info [ playerid ] [ gym_click ] = 0 ;
							}
							else p_t_info [ playerid ] [ gym_click ] ++ ;
							return 1 ;
						}
						else if ( _gym == 3 && p_t_info [ playerid ] [ gym_time ] <= gettime ( ) + 2 )
						{
							ApplyAnimation ( playerid, "benchpress", "gym_bp_up_smooth", 4, 0, 0, 0, 1, 0 ) ;
							p_t_info [ playerid ] [ gym_time ] = gettime ( ) + 2 ;
							if ( p_t_info [ playerid ] [ gym_click ] >= 100 )
							{
								if ( p_info [ playerid ] [ stats ] [ 2 ] < 100 )
								{
									GivePlayerStats ( playerid, 2, 1 ) ;
									GameTextForPlayer ( playerid,"~n~~n~~n~~n~~n~~n~~n~~n~~w~ FORCE ~g~+1", 3000, 3 ) ;

									checking_quest_progress ( playerid, 1, 1, quest_line_medium ) ;
								}
								p_t_info [ playerid ] [ gym_click ] = 0 ;
							}
							else p_t_info [ playerid ] [ gym_click ] ++ ;
							if ( ! IsPlayerAttachedObjectSlotUsed ( playerid, 3 ) ) SetPlayerAttachedObject ( playerid, 3, 2913, 6, 0.033000, 0.028000, -0.104999, 5.699995, -1.999999, 0.500062, 1.000000, 1.000000, 1.000000);
			                return 1 ;
						}
						else if ( _gym == 4 && p_t_info [ playerid ] [ gym_time ] <= gettime ( ) + 2 )
						{
							ApplyAnimation ( playerid, "Freeweights", "gym_free_down", 4, 0, 0, 0, 1, 0 ) ;
							p_t_info [ playerid ] [ gym_time ] = gettime ( ) + 2 ;
							if ( p_t_info [ playerid ] [ gym_click ] >= 100 )
							{
								if ( p_info [ playerid ] [ stats ] [ 2 ] < 100 )
								{
									GivePlayerStats ( playerid, 2, 1 ) ;
									GameTextForPlayer ( playerid,"~n~~n~~n~~n~~n~~n~~n~~n~~w~ FORCE ~g~+1", 3000, 3 ) ;

									checking_quest_progress ( playerid, 1, 1, quest_line_medium ) ;
								}
								p_t_info [ playerid ] [ gym_click ] = 0 ;
							}
							else p_t_info [ playerid ] [ gym_click ] ++ ;
							if ( ! IsPlayerAttachedObjectSlotUsed ( playerid, 3 ) ) SetPlayerAttachedObject ( playerid, 3, 2915, 6, 0.083999, 0.000000, -0.039999, -7.199998, -87.000038, -3.199999, 1.000000, 1.000000, 1.000000);
			                return 1 ;
						}
					}

					if ( is_player_in_boat [ playerid ] != 0 )
					{
						if ( IsPlayerInRangeOfPoint ( playerid, 2.5, yacht_clothes [ 0 ], yacht_clothes [ 1 ], yacht_clothes [ 2 ] ) )// гардероб
						{
							if ( veh_info [ is_player_in_boat [ playerid ] - 1 ] [ v_owner ] != p_info [ playerid ] [ id ] )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Гардероб может использовать только владелец." ) ;
							new line_string [ 80 ] ;
							global_string [ 0 ] = EOS ;
							for ( new j = 0 ; j < 5 ; j ++ )
							{
								if ( p_info [ playerid ] [ temp_skin ] [ j ] == 0 )
								{
									strcat ( global_string, "{"#cGRDialog"}- Пусто\n" ) ;
								}
								else
								{
									format ( line_string, sizeof line_string, "{ffffff}Одежда '%s' (%d)\n", get_skin_name ( p_info [ playerid ] [ temp_skin ] [ j ] ), p_info [ playerid ] [ temp_skin ] [ j ] ) ;
									strcat ( global_string, line_string ) ;
								}
							}
							strcat ( global_string, "Одежда организации" ) ;
							show_dialog ( playerid, d_boat_clothes, DIALOG_STYLE_LIST, "{"#cBHD"}Гардероб", global_string, "Выбрать", "Назад" ) ;
						}
						else if ( IsPlayerInRangeOfPoint ( playerid, 2.5, yacht_freeze [ 0 ], yacht_freeze [ 1 ], yacht_freeze [ 2 ] ) )// холодильник
						{
							show_dialog ( playerid, d_boat_freeze, DIALOG_STYLE_LIST, "{"#cBHD"}Холодильник", "Хот-дог ({"#cRD"}-10 прод. {"#cGN"}+20 сытость{"#cWH"})\nБургер ({"#cRD"}-15 прод. {"#cGN"}+30 сытость{"#cWH"})\nПицца ({"#cRD"}-30 прод. {"#cGN"}+60 сытость{"#cWH"})", "Съесть", "Закрыть" ) ;
							return 1 ;
						}
					}
					new _areaid = used_area [ playerid ] ;
					if ( _areaid != -1 )
					{
					    new _a_type = area_info [ _areaid ] [ a_type ] ;
					    if ( _a_type == area_type_cellar )
						{
					        if ( GetPVarInt ( playerid, "house_id" ) < 1 ) return 1 ;
						   	show_house_cellar ( playerid ) ;
				   			return 1 ;
						}
						else if ( _a_type == area_type_cellar_table ) // cellar
						{
					        if ( GetPVarInt ( playerid, "cellar_id" ) < 1 ) return 1 ;
							show_cellar_cellar ( playerid ) ;
							return 1 ;
						}
					}
				}
			}
			else
			{
			    #if defined m_quest
				    if ( quest_OnPlayerKeyStateChange ( playerid, newkeys, oldkeys ) ) return 1 ;
				#endif

				if ( newkeys & KEY_YES )
				{
				    if ( IsPlayerInRangeOfPoint ( playerid, 10, -1051.7904, -1342.4224, 130.3141 ) )
					{
						if ( b_info [ mafia_farm_id - 1 ] [ b_mafia ] != p_info [ playerid ] [ member ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет доступа на ферму." ) ;
						if( farmdoor == true )
						{
							MoveDynamicObject ( farm_gate, -1051.859009, -1342.810059, 126.240005, 3.0, 0.000000, 0.000000, 257.000000 ) ;
							farmdoor = false ;
						}
						else
						{
							MoveDynamicObject ( farm_gate, -1051.859009, -1342.810059, 131.240005, 3.0, 0.000000, 0.000000, 257.000000 ) ;
							farmdoor = true ;
						}
						return 1 ;
					}

					foreach(new i:streamed_vehicles[playerid])
					{
						if ( ! IsValidVehicle ( i ) ) continue ;
						if ( ! v_boat_int ( i ) ) continue ;
						new Float:bd_x, Float:bd_y, Float:bd_z ;
						GetBoatDoorPos ( i, bd_x, bd_y, bd_z ) ;
						if ( IsPlayerInRangeOfPoint ( playerid, 2.0, bd_x, bd_y, bd_z ) )
						{
							if ( veh_info [ i - 1 ] [ v_locked ] )return GameTextForPlayer ( playerid, "~r~BOAT CLOSED", 2000, 4 ) ;
							is_player_in_boat [ playerid ] = i ;
							set_pos ( playerid, yacht_enter [ 0 ], yacht_enter [ 1 ], yacht_enter [ 2 ], yacht_enter [ 3 ], yacht_interior, i ) ;
							return 1 ;
						}
					}

					if ( used_area [ playerid ] != -1 )
					{
						#if defined m_treasure
						    if ( tr_OnPlayerKeyStateChange ( playerid, newkeys, oldkeys ) ) return 1 ;
						#endif
					}

					if ( action_type { playerid } == 0 )
					{
