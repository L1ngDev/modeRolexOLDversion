CMD:savegz ( playerid, params [ ] )
{
    if ( admin_info [ playerid ] [ admin ] < 7 ) return 1 ;
	if ( sscanf ( params, "s[32]", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /savegz [название]");

    new Float: pos [ 4 ] ;
    GetPlayerPos ( playerid, p_t_info [ playerid ] [ p_pos ] [ 0 ], p_t_info [ playerid ] [ p_pos ] [ 1 ], p_t_info [ playerid ] [ p_pos ] [ 2 ] ) ;
  	get_gz_pos ( p_t_info [ playerid ] [ p_pos ] [ 0 ], p_t_info [ playerid ] [ p_pos ] [ 1 ], 200.0, pos [ 0 ], pos [ 1 ], pos [ 2 ], pos [ 3 ] ) ;
	printf ( "[get_gz_pos] { %.4f, %.4f, %.4f, %.4f } (%s)", pos [ 0 ], pos [ 1 ], pos [ 2 ], pos [ 3 ], params [ 0 ] ) ;
	return 1 ;
}

CMD:save ( playerid, params [ ] )
{
    if ( admin_info [ playerid ] [ admin ] < 7 ) return 1 ;
	if ( sscanf ( params, "s[32]", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /save [название]");

	new Float: player_pos [ 4 ] ;
	if ( GetPlayerVehicleID ( playerid ) )
	{
	    new _veh_id = GetPlayerVehicleID ( playerid ) ;
	    GetVehiclePos ( _veh_id, player_pos [ 0 ], player_pos [ 1 ], player_pos [ 2 ] ) ;
		GetVehicleZAngle ( _veh_id, player_pos [ 3 ] ) ;

		printf ( "[SAVED VEHICLE] [%d] { %.4f, %.4f, %.4f, %.4f } (%s)", GetVehicleModel ( _veh_id ), player_pos [ 0 ], player_pos [ 1 ], player_pos [ 2 ], player_pos [ 3 ], params [ 0 ] ) ;
	}
	else
	{
		GetPlayerPos ( playerid, player_pos [ 0 ], player_pos [ 1 ], player_pos [ 2 ] ) ;
		GetPlayerFacingAngle ( playerid, player_pos [ 3 ] ) ;

		printf ( "[SAVED] { %.4f, %.4f, %.4f, %.4f } (%s)", player_pos [ 0 ], player_pos [ 1 ], player_pos [ 2 ], player_pos [ 3 ], params [ 0 ] ) ;
	}
	SendClientMessage ( playerid, col_white, "Saved position." ) ;
	return 1 ;
}

CMD:checktwink ( playerid )
{
	if ( admin_info [ playerid ] [ admin ] < 8 ) return 1 ;
	if ( ! IsFounder ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}К сожалению, Вам данная функция не доступна." ) ;

	for ( new b = 0 ; b < b_count ; b ++ )
	{
	    new sql_string [ 83 + 9 ] ;
	    format ( sql_string, sizeof sql_string, "SELECT `u_ip_registration`, `u_last_ip` FROM `users` WHERE `u_id` = '%d' LIMIT 1", b_info [ b ] [ b_owner_inc ] ) ;
	    mysql_tquery ( sql_connection, sql_string, "callback_finded_twink", "iii", playerid, b_info [ b ] [ b_owner_inc ], 1 ) ;
	}
	return 1 ;
}

