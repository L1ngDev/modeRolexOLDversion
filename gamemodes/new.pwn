					find_mark_gz ( plid, -1, perv_pos [ 0 ], perv_pos [ 1 ] ) ;
                    get_gz_pos ( perv_pos [ 0 ], perv_pos [ 1 ], 80.0, pos [ 0 ], pos [ 1 ], pos [ 2 ], pos [ 3 ] ) ;
