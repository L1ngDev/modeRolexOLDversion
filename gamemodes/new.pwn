stock find_mark ( playerid = -1, vehicleid = -1 )
{
	if ( IsVehicleInRangeOfPoint ( vehicleid, 10.0, cellar_veh_garage [ 0 ], cellar_veh_garage [ 1 ], cellar_veh_garage [ 2 ] ) )
    {
    	new _park_id = cellar_info [ GetVehicleVirtualWorld ( vehicleid ) ] [ cl_id ] ;
	    SetPlayerRaceCheckpoint ( playerid, 1, cellar_info [ _park_id ] [ cl_pos ] [ 0 ], cellar_info [ _park_id ] [ cl_pos ] [ 1 ], cellar_info [ _park_id ] [ cl_pos ] [ 2 ], 0.0, 0.0, 0.0, 2.0 ) ;

        static const _str [ ] = "{"#cGInfo"}* {"#cWH"}Ваш транспорт находится в гараже №%d." ;
		new scm_string [ sizeof _str + 9 ] ;
		format ( scm_string, sizeof scm_string, _str, _park_id ) ;
	    SendClientMessage ( playerid, col_white, scm_string ) ;
	    return 1 ;
	}
    for ( new i = 0 ; i < sizeof house_veh_garage ; i ++ )
    {
	   	if ( IsVehicleInRangeOfPoint ( vehicleid, 30.0, house_veh_garage [ i ] [ 0 ], house_veh_garage [ i ] [ 1 ], house_veh_garage [ i ] [ 2 ] ) )
	   	{
			new _park_id = h_info [ GetVehicleVirtualWorld ( vehicleid ) ] [ h_id ] ;
		    SetPlayerRaceCheckpoint ( playerid, 1, h_info [ _park_id ] [ h_v_pos ] [ 0 ], h_info [ _park_id ] [ h_v_pos ] [ 1 ], h_info [ _park_id ] [ h_v_pos ] [ 2 ], 0.0, 0.0, 0.0, 2.0 ) ;

			static const _str [ ] = "{"#cGInfo"}* {"#cWH"}Ваш транспорт находится в гараже дома №%d." ;
			new scm_string [ sizeof _str + 9 ] ;
			format ( scm_string, sizeof scm_string, _str, _park_id ) ;
		    SendClientMessage ( playerid, col_white, scm_string ) ;
	    	return 1 ;
		}
	}
	SetPlayerRaceCheckpoint ( playerid, 1, veh_info [ vehicleid - 1 ] [ v_now_pos ] [ 0 ], veh_info [ vehicleid - 1 ] [ v_now_pos ] [ 1 ], veh_info [ vehicleid - 1 ] [ v_now_pos ] [ 2 ], 0.0, 0.0, 0.0, 2.0 ) ;
	return 1 ;
}

stock find_mark_gz ( playerid = -1, vehicleid = -1, &Float:x, &Float:y )
{
	if ( vehicleid != -1 )
	{
	    x = veh_info [ vehicleid - 1 ] [ v_now_pos ] [ 0 ] ;
	    y = veh_info [ vehicleid - 1 ] [ v_now_pos ] [ 1 ] ;
	    return 1 ;
	}

	if ( GetPVarInt ( playerid, "p_biz_id" ) )
	{
	    new _b_id = GetPVarInt ( playerid, "p_biz_id" ) ;
	    x = b_info [ _b_id - 1 ] [ b_position ] [ 0 ] ;
	    y = b_info [ _b_id - 1 ] [ b_position ] [ 1 ] ;
	    return 1 ;
	}
	if ( GetPVarInt ( playerid, "house_id" ) )
	{
	    new _h_id = GetPVarInt ( playerid, "house_id" ) ;
	    x = h_info [ _h_id - 1 ] [ h_pos ] [ 0 ] ;
	    y = h_info [ _h_id - 1 ] [ h_pos ] [ 1 ] ;
	    return 1 ;
	}
	if ( GetPVarInt ( playerid, "cellar_id" ) )
	{
	    new _cl_id = GetPVarInt ( playerid, "cellar_id" ) ;
	    x = cellar_info [ _cl_id - 1 ] [ cl_pos ] [ 0 ] ;
	    y = cellar_info [ _cl_id - 1 ] [ cl_pos ] [ 1 ] ;
	    return 1 ;
	}
	if ( GetPVarInt ( playerid, "p_hotel_id" ) )
	{
	    new _b_id = GetPVarInt ( playerid, "p_biz_id" ) ;
	    x = b_info [ _b_id - 1 ] [ b_position ] [ 0 ] ;
	    y = b_info [ _b_id - 1 ] [ b_position ] [ 1 ] ;
	    return 1 ;
	}
	x = p_t_info [ playerid ] [ p_pos ] [ 0 ] ;
	y = p_t_info [ playerid ] [ p_pos ] [ 1 ] ;
	return 1 ;
}

CMD:acsettings ( playerid )
{
    if ( admin_info [ playerid ] [ admin ] < 8 ) return 1 ;

	#if defined m_anticheat
	    ShowAntiCheatSettings ( playerid ) ;
	#endif
	return 1 ;
}

CMD:meeting ( playerid )
{
	show_dialog ( playerid, d_meeting, DIALOG_STYLE_LIST, "{"#cBHD"}Опечатаное имущество", "{"#cBL"}1. {"#cWH"}Дома на слёте\n{"#cBL"}2. {"#cWH"}Бизнесы на слёте", "Выбрать", "Закрыть" ) ;
	return 1 ;
}

stock meetingPropertyList ( playerid, propertyType, page )
{
	page_count [ playerid ] = page ;

	new count_type, count = 0, s_year, s_month, s_day, s_hour, s_minute, s_second ;
	if ( propertyType == 0 )
	{
		global_string [ 0 ] = EOS ;
		strcat ( global_string, "{"#cBL"}№ Дома:\t{"#cBL"}Дата слёта:\t{"#cBL"}Класс:\t{"#cBL"}Стоимость:\n" ) ;
		for ( new i = 0 ; i < house_count ; i ++ )
		{
			if ( h_info [ i ] [ h_meeting ] < gettime ( ) ) continue ;

	    	count_type ++ ;

			if ( page * 20 > count_type ) continue ;
			if ( count_type > ( page + 1 ) * 20 ) continue ;

			set_player_listitem_values ( playerid, count, h_info [ i ] [ h_id ] ) ;

			count ++ ;

			timestamp_to_date ( h_info [ i ] [ h_meeting ] + CONVERT_TIME_TO_MOSCOW, s_year, s_month, s_day, s_hour, s_minute, s_second ) ;
			if ( h_info [ i ] [ h_price_ticket ] > 0 ) format ( global_string, sizeof ( global_string ), "%s{"#cWH"}№%d\t%02d.%02d.%d в %02d:%02d:%02d\t%s\t%d "family_title_abb"\n", global_string, i + 1, s_day, s_month, s_year, s_hour, s_minute, s_second, house_classes [ house_int [ h_info [ i ] [ h_int ] - 1 ] [ hint_class ] ], h_info [ i ] [ h_price_ticket ] ) ;
			else format ( global_string, sizeof ( global_string ), "%s{"#cWH"}№%d\t%02d.%02d.%d в %02d:%02d:%02d\t%s\t%s"valute_title_"\n", global_string, i + 1, s_day, s_month, s_year, s_hour, s_minute, s_second, house_classes [ house_int [ h_info [ i ] [ h_int ] - 1 ] [ hint_class ] ], GetPlayerCashValueToSmile ( h_info [ i ] [ h_price ] ) ) ;
		}

		if ( page > 0 ) strcat ( global_string, "{"#cBL"}Предыдущая страница\n" ) ;
		if ( count_type > ( page + 1 ) * 20 ) strcat ( global_string, "{"#cBL"}Следующая страница" ) ;

		if ( count_type < 1 ) return show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Дома", "{"#cWH"}Нет домов, которые доступны для ловли.", "Закрыть", "" ) ;
		show_dialog ( playerid, d_meeting_house, DIALOG_STYLE_TABLIST_HEADERS, "{"#cBHD"}Дома", global_string, "Выбрать", "Закрыть" ) ;
	}
	else if ( propertyType == 1 )
	{
		global_string [ 0 ] = EOS ;
		strcat ( global_string, "{"#cBL"}№ Бизнеса:\t{"#cBL"}Дата слёта:\t{"#cBL"}Тип:\t{"#cBL"}Стоимость:\n" ) ;
		for ( new i = 0 ; i < b_count ; i ++ )
		{
			if ( b_info [ i ] [ b_meeting ] < gettime ( ) ) continue ;

	    	count_type ++ ;

			if ( page * 20 > count_type ) continue ;
			if ( count_type > ( page + 1 ) * 20 ) continue ;

			set_player_listitem_values ( playerid, count, b_info [ i ] [ b_id ] ) ;

			count ++ ;

			timestamp_to_date ( b_info [ i ] [ b_meeting ] + CONVERT_TIME_TO_MOSCOW, s_year, s_month, s_day, s_hour, s_minute, s_second ) ;
			if ( b_info [ i ] [ b_donate_price ] > 0 ) format ( global_string, sizeof ( global_string ), "%s{"#cWH"}№%d\t%02d.%02d.%d в %02d:%02d:%02d\t%s\t%d "donate_title_abb"\n", global_string, i + 1, s_day, s_month, s_year, s_hour, s_minute, s_second, b_types [ b_info [ i ] [ b_type ] ], b_info [ i ] [ b_donate_price ] ) ;
			else format ( global_string, sizeof ( global_string ), "%s{"#cWH"}№%d\t%02d.%02d.%d в %02d:%02d:%02d\t%s\t%s"valute_title_"\n", global_string, i + 1, s_day, s_month, s_year, s_hour, s_minute, s_second, b_types [ b_info [ i ] [ b_type ] ], GetPlayerCashValueToSmile ( b_info [ i ] [ b_price ] ) ) ;
		}

		if ( page > 0 ) strcat ( global_string, "{"#cBL"}Предыдущая страница\n" ) ;
		if ( count_type > ( page + 1 ) * 20 ) strcat ( global_string, "{"#cBL"}Следующая страница" ) ;

		if ( count_type < 1 ) return show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Бизнесы", "{"#cWH"}Нет бизнесов, которые доступны для ловли.", "Закрыть", "" ) ;
		show_dialog ( playerid, d_meeting_bizz, DIALOG_STYLE_TABLIST_HEADERS, "{"#cBHD"}Бизнесы", global_string, "Выбрать", "Закрыть" ) ;
	}
    return true ;
}

CMD:apanel ( playerid )
{
	if ( tester_admin [ playerid ] ) return tester_no_access ( playerid ) ;
    if ( ! admin_info [ playerid ] [ admin ] ) return 1 ;

    new submarine_string [ 68 ] ;
    if ( start_submarine > 1 ) format ( submarine_string, sizeof submarine_string, "Подлодка привлывёт через {"#cLY"}%s", convert_time ( start_submarine, TYPE_TIME_SECOND ) ) ;
    else format ( submarine_string, sizeof submarine_string, "До отплыва подлодки {"#cLY"}%s", convert_time ( end_submarine, TYPE_TIME_SECOND ) ) ;

    new airdrop_string [ 68 ] ;
    if ( start_airdrop > 1 ) format ( airdrop_string, sizeof airdrop_string, "AirDrop будет сброшен через {"#cLY"}%s", convert_time ( start_airdrop, TYPE_TIME_SECOND ) ) ;
    else format ( airdrop_string, sizeof airdrop_string, "До конца AirDrop {"#cLY"}%s", convert_time ( end_airdrop, TYPE_TIME_SECOND ) ) ;

    new garagewars_string [ 80 ] ;
    if ( garage_war_time [ 0 ] > 900 ) format ( garagewars_string, sizeof garagewars_string, "(Порт №1) До начала гаражного аукциона {"#cLY"}%s", convert_time ( garage_war_time [ 0 ] - 900, TYPE_TIME_SECOND ) ) ;
    else format ( garagewars_string, sizeof garagewars_string, "(Порт №1) Гаражный аукцион уже проходит" ) ;

    new garagewars_string2 [ 80 ] ;
    if ( garage_war_time [ 1 ] > 900 ) format ( garagewars_string2, sizeof garagewars_string2, "(Порт №2) До начала гаражного аукциона {"#cLY"}%s", convert_time ( garage_war_time [ 1 ] - 900, TYPE_TIME_SECOND ) ) ;
    else format ( garagewars_string2, sizeof garagewars_string2, "(Порт №2) Гаражный аукцион уже проходит" ) ;

	global_string [ 0 ] = EOS ;
	format ( global_string, sizeof global_string, "\
		{"#cBL"}[A-LVL 1]{"#cWH"} IP и провайдер при коннекте {"#cGRDialog"}(%s{"#cGRDialog"})\n\
		{"#cBL"}[A-LVL 4]{"#cWH"} Очистить чат\n\
		{"#cBL"}[A-LVL 6]{"#cWH"} Спавн транспорта\n\
		{"#cBL"}[A-LVL 6]{"#cWH"} Заправить транспорт\n\
		{"#cBL"}[A-LVL 3]{"#cWH"} Мониторинг домов\n\
		{"#cBL"}[A-LVL 3]{"#cWH"} Мониторинг бизнесов\n\
		{"#cBL"}[A-LVL 3]{"#cWH"} Мониторинг гаражей\n\
		{"#cBL"}[A-LVL 8]{"#cWH"} Ответ сервера на репорт {"#cGRDialog"}(%s{"#cGRDialog"})\n\
		{"#cBL"}[A-LVL 8]{"#cWH"} Авто-репорт {"#cGRDialog"}(%s{"#cGRDialog"})\n\
		{"#cBL"}[A-LVL 5]{"#cWH"} BANLIST\n\
		{"#cBL"}[A-LVL 8]{"#cWH"} Проверка на взлом {"#cGRDialog"}(%s{"#cGRDialog"})\n\
		{"#cBL"}[A-LVL 4]{"#cWH"} Подозрение на взлом\n\
		{"#cBL"}[A-LVL 8]{"#cWH"} Очистка репорта\n\
		{"#cBL"}[A-LVL 1]{"#cWH"} Личные настройки\n\
		{"#cBL"}[A-LVL 8]{"#cWH"} Настройки сервера\n\
		{"#cBL"}[A-LVL 7]{"#cWH"} Перезапустить охотничьи угодья\n\
		{"#cBL"}[A-LVL 5]{"#cWH"} ЗЗ на спавне банд {"#cGRDialog"}(%s{"#cGRDialog"})\n\
		{"#cBL"}[A-LVL 8]{"#cWH"} OFFLINE REPORT {"#cGRDialog"}(%s{"#cGRDialog"})\n\
		{"#cBL"}[A-LVL 6]{"#cWH"} Состояние наборов\n\
		{"#cBL"}[A-LVL 6]{"#cWH"} Активные клады\n\
		{"#cBL"}[A-LVL 8]{"#cWH"} Перезапустить клады\n\
		{"#cBL"}[A-LVL 8]{"#cWH"} Перезапустить донат-скидки\n\
		{"#cBL"}[A-LVL 1]{"#cWH"} Admin Shop\n\
		{"#cBL"}[A-LVL 1]{"#cWH"} Начисление Admin Coins\n\
		{"#cBL"}[A-LVL 7]{"#cWH"} Приход / расход\n\
		{"#cBL"}[A-LVL 8]{"#cWH"} Регламент наказаний\n\
		{"#cGRDialog"}- {"#cWH"}Обращений в репорт: {"#cLY"}%d\n\
		{"#cGRDialog"}- {"#cWH"}Авто ответов на репорт: {"#cLY"}%d\n\
		{"#cGRDialog"}- {"#cWH"}Удалено ответов с 40 м. ожиданием: {"#cLY"}%d\n\
		{"#cGRDialog"}- {"#cWH"}Потеряно отрезков: {"#cLY"}%d\n\
		{"#cGRDialog"}- {"#cWH"}%s\n\
		{"#cGRDialog"}- {"#cWH"}%s\n\
		{"#cGRDialog"}- {"#cWH"}%s\n\
		{"#cGRDialog"}- {"#cWH"}%s",
		( admin_info [ playerid ] [ admin_ip ] ) ? ( "{"#cGN"}Включено{"#cGRDialog"}" ) : ( "{"#cRD"}Выключено{"#cGRDialog"}" ),
		( server_report ) ? ( "{"#cGN"}Включено{"#cGRDialog"}" ) : ( "{"#cRD"}Выключено{"#cGRDialog"}" ),
		( auto_report ) ? ( "{"#cGN"}Включено{"#cGRDialog"}" ) : ( "{"#cRD"}Выключено{"#cGRDialog"}" ),
		( owner_account_en ) ? ( "{"#cGN"}Включено{"#cGRDialog"}" ) : ( "{"#cRD"}Выключено{"#cGRDialog"}" ),
		( gz_spawn_zz ) ? ( "{"#cGN"}Включено{"#cGRDialog"}" ) : ( "{"#cRD"}Выключено{"#cGRDialog"}" ),
		( offline_report ) ? ( "{"#cGN"}Включено{"#cGRDialog"}" ) : ( "{"#cRD"}Выключено{"#cGRDialog"}" ),
		count_report, count_auto_report, count_delete_report, count_auto_activation,
		submarine_string, airdrop_string, garagewars_string, garagewars_string2 ) ;

	new header_string [ 64 ] ;
	format ( header_string, sizeof header_string, "{"#cBHD"}У Вас {"#cWH"}%d {"#cBHD"}Admin Coins", admin_info [ playerid ] [ coins ] ) ;
    show_dialog ( playerid, d_apanel, DIALOG_STYLE_LIST, header_string, global_string, "Выбрать", "Закрыть" ) ;
	return 1 ;
}

