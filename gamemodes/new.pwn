										{"#cBL"}2. {"#cWH"}Ящики с AK47:\t{"#cGN"}%d {"#cWH"}шт.\n\
										{"#cBL"}3. {"#cWH"}Ящики с M4A1:\t{"#cGN"}%d {"#cWH"}гр.\n\
