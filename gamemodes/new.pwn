			else p_info [ playerid ] [ gender ] = 1 ;

			new query_string [ 128 ] ;
			mysql_format ( sql_connection, query_string, sizeof ( query_string ), "UPDATE `users` SET `u_gender` = '%d' WHERE `u_id` = '%d' LIMIT 1", p_info [ playerid ] [ gender ], p_info [ playerid ] [ id ] ) ;
			mysql_tquery ( sql_connection, query_string ) ;

