			{
				new ticket_id,
					query_string [ 78 ] ;

				ticket_id = get_player_listitem_values ( playerid, GetPVarInt ( playerid, "ticket_listitem" ) ) ;
				mysql_format ( sql_connection, query_string, sizeof query_string, "SELECT `fine_value` FROM `users_tickets` WHERE `id` = '%d' LIMIT 1", ticket_id ) ;
				mysql_tquery ( sql_connection, query_string, "callback_bankticket_payment", "i", playerid ) ;
				return 1 ;
			}
		}
		case d_bankticket_list:
		{
			if ( ! response )
			{
				clear_player_listitem_values ( playerid ) ;
				page_count [ playerid ] = 0 ;
				page_rows [ playerid ] = 0 ;
				DeletePVar ( playerid, "ticket_list_price" ) ;
				if ( ! tablet_opened [ playerid ] ) show_deposit ( playerid ) ;
				return 1 ;
			}
			if ( listitem == 0 )
			{
			    new deposit_id = get_player_use_listitem ( playerid ),
					ticket_count = GetPVarInt ( playerid, "ticket_list_price" ),
					commision = 0 ;
				DeletePVar ( playerid, "ticket_list_price" ) ;

				if ( tablet_opened [ playerid ] ) commision = ( ticket_count * TABLET_BANK_COMMISION ) / 100 ;
				if ( bank_info [ playerid ] [ bi_money ] [ deposit_id ] < ticket_count + commision )
				{
				    SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас не достаточно средств на банковском счёте для оплаты штрафов." ) ;
					if ( ! tablet_opened [ playerid ] ) show_deposit ( playerid ) ;
				    return 1 ;
				}

				bank_info [ playerid ] [ bi_money ] [ deposit_id ] -= ticket_count + commision ;

				new _text_string [ 76 + 9 + 9 ] ;
				format ( _text_string, sizeof ( _text_string ), "UPDATE `deposit_boxes` SET `db_money` = '%d' WHERE `db_id` = '%d' LIMIT 1", bank_info [ playerid ] [ bi_money ] [ deposit_id ], bank_info [ playerid ] [ bi_id ] [ deposit_id ] ) ;
				mysql_tquery ( sql_connection, _text_string, "", "" ) ;

				for ( new i = 0 ; i < 10 ; i ++ )
				{
				    p_info [ playerid ] [ ticket_c ] -- ;

					mysql_format ( sql_connection, _text_string, sizeof _text_string, "DELETE FROM `users_tickets` WHERE `id` = '%d' LIMIT 1", get_player_listitem_values ( playerid, i ) ) ;
					mysql_tquery ( sql_connection, _text_string, "" ) ;
				}
				clear_player_listitem_values ( playerid ) ;

				if ( p_info [ playerid ] [ ticket_c ] < 0 ) p_info [ playerid ] [ ticket_c ] = 0 ;

				format ( _text_string, sizeof _text_string, "{"#cGN"}* {ffffff}Штрафы на странице, на сумму {"#cGN"}%d"valute_title_"{"#cWH"}, оплачены.", ticket_count ) ;
				SendClientMessage ( playerid, col_white, _text_string ) ;

				if ( ! tablet_opened [ playerid ] ) show_deposit ( playerid ) ;

				set_money_fraction ( 10, 4, ticket_count, true ) ;
			}

			else if ( GetString ( inputtext, "Предыдущая страница" ) ) bankTicketList ( playerid, page_count [ playerid ] - 1, 1 ) ;
			else if ( GetString ( inputtext, "Следующая страница" ) ) bankTicketList ( playerid, page_count [ playerid ] + 1, 1 ) ;
			else
			{
			    DeletePVar ( playerid, "ticket_list_price" ) ;
				SetPVarInt ( playerid, "ticket_listitem", listitem - 1 ) ;
				show_dialog ( playerid, d_bankticket_info, DIALOG_STYLE_LIST, "{"#cBHD"}Штраф", "{"#cBL"}1. {"#cWH"}Информация о штрафе\n{"#cBL"}2. {"#cWH"}Оплатить штраф", "Выбрать", "Назад" ) ;
			}
			return 1 ;
		}
		case d_bankticket_stats:
		{
			show_dialog ( playerid, d_bankticket_info, DIALOG_STYLE_LIST, "{"#cBHD"}Штраф", "{"#cBL"}1. {"#cWH"}Информация о штрафе\n{"#cBL"}2. {"#cWH"}Оплатить штраф", "Выбрать", "Назад" ) ;
			return 1 ;
		}
		case d_fine:
		{
			if ( ! response )
			{
				clear_player_listitem_values ( playerid ) ;
				DeletePVar ( playerid, "p_biz_id" ) ;
				return 1 ;
			}
			SetPVarInt ( playerid, "fine_vehid", get_player_listitem_values ( playerid, listitem ) ) ;

			clear_player_listitem_values ( playerid ) ;

            new dialog_string [ 107 + 9 ], b = GetPVarInt ( playerid, "p_biz_id" ) - 1 ;
			format ( dialog_string, sizeof dialog_string, "{"#cWH"}Вы действительно желаете выкупить данный транспорт?\n\n{"#cRD"}* Стоимость выкупа составляет %d"valute_title_"", b_info [ b ] [ b_cost ] ) ;
			show_dialog ( playerid, d_fine_accept, DIALOG_STYLE_MSGBOX, "{"#cBHD"}TowCar", dialog_string, "Принять", "Назад" ) ;
			return 1 ;
		}
		case d_fine_accept:
		{
			if ( ! response )
			{
			    static const _str [ ] = "SELECT `v_id`, `v_model` FROM `users_vehicles` WHERE `v_owner` = '%d' AND `v_fine` < '2' AND `v_sell_price` < '1' LIMIT %d" ;
				new sql_string [ sizeof _str + 9 + 4 ] ;
				format ( sql_string, sizeof sql_string, _str, p_info [ playerid ] [ id ], p_info [ playerid ] [ max_veh ] ) ;
				mysql_tquery ( sql_connection, sql_string, "load_fine_vehicles", "i", playerid ) ;

				DeletePVar ( playerid, "fine_vehid" ) ;
				return 1 ;
			}

			new b = GetPVarInt ( playerid, "p_biz_id" ) - 1 ;
			new _b_pay = b_info [ b ] [ b_cost ] ;
			if ( p_info [ playerid ] [ money ] < _b_pay )
			{
				new dialog_string [ 107 + 9 ] ;
				format ( dialog_string, sizeof dialog_string, "{"#cWH"}Вы действительно желаете выкупить данный транспорт?\n\n{"#cRD"}* У Вас недостаточно средств.\n{"#cRD"}* Стоимость выкупа составляет %d"valute_title_"", _b_pay ) ;
				show_dialog ( playerid, d_fine_accept, DIALOG_STYLE_MSGBOX, "{"#cBHD"}TowCar", dialog_string, "Принять", "Назад" ) ;
				return 1 ;
			}

			new _fine_vehicle = GetPVarInt ( playerid, "fine_vehid" ), bool: _status = false ;
			DeletePVar ( playerid, "fine_vehid" ) ;
			foreach(new veh_id: player_vehicles[playerid])
			{
			    if ( veh_info [ veh_id - 1 ] [ v_id ] == _fine_vehicle )
			    {
				    if ( ! IsValidVehicle ( veh_id ) ) continue ;

			        new scm_string [ 73 + 9 ] ;
					format ( scm_string, sizeof scm_string, "UPDATE `users_vehicles` SET `v_fine` = '1' WHERE `v_id` = '%d' LIMIT 1", veh_info [ veh_id - 1 ] [ v_id ] ) ;
					mysql_tquery ( sql_connection, scm_string, "fined_player_vehicles", "iii", playerid, _fine_vehicle, b_info [ b ] [ b_car_marker ] ) ;

			        Iter_Remove ( player_vehicles[playerid], veh_id ) ;
			        DestroyVehicle ( veh_id, 34 ) ;

			        _status = true ;
			        break ;
			    }
			}

			give_money ( playerid, -_b_pay ) ;
			insert_money_log ( playerid, INVALID_PLAYER_ID, -_b_pay, "TowCar" ) ;

			if ( _status == false )
			{
				global_string [ 0 ] = EOS ;
				format ( global_string, 256, "SELECT uv.*, lp.* \
											FROM users_vehicles uv \
											LEFT JOIN licence_plate lp \
											ON lp.licence_plate_use_own_car_id = uv.v_id \
											WHERE `v_id` = '%d' LIMIT 1", _fine_vehicle ) ;
				mysql_tquery ( sql_connection, global_string, "load_player_vehicles", "iii", playerid, true, b_info [ b ] [ b_car_marker ] ) ;

				set_player_use_listitem ( playerid, 0 ) ;
			}

			give_bmoney ( b + 1, _b_pay, 0 ) ;

			SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Транспортное средство выкуплено и доставлено к зданию штрафстоянки." ) ;
			SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Не забудьте припарковать Ваше транспортное средство в этот раз." ) ;
			SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}У Вас есть 2 минуты, чтобы его отогнать с штрафстоянки." ) ;
			return 1 ;
		}
		case d_b_fee_enter:
		{
			if ( ! response ) return DeletePVar ( playerid, "p_biz_id" ) ;

			new t = GetPVarInt ( playerid, "p_biz_id" ) - 1 ;
			new _b_pay = b_info [ t ] [ b_fee ] ;

			if ( p_info [ playerid ] [ money ] < _b_pay ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас недостаточно средств для входа в бизнес" ) ;

			give_money ( playerid, -_b_pay ) ;
			insert_money_log ( playerid, INVALID_PLAYER_ID, -_b_pay, "вход в бизнес" ) ;

			give_bmoney ( t + 1, _b_pay, 0 ) ;

			new bis_int = b_info [ t ] [ b_int ] ;
			if ( bis_int == -1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Произошла ошибка при входе в бизнес." ) ;
			if ( b_info [ t ] [ b_close ] == 1 ||  b_info [ t ] [ b_owner_inc ] == -1 )
			{
				if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Бизнес закрыт!", 0, 3, CINFO_OTHER_ID, PICTURE_INFO_ERROR, "", "" ) ;
				else GameTextForPlayer ( playerid, "~r~BUSINESS CLOSED", 2000, 4 ) ;
				return 1 ;
			}

   			set_pos ( playerid, b_interior [ bis_int ] [ i_position ] [ 0 ] , b_interior [ bis_int ] [ i_position ] [ 1 ], b_interior [ bis_int ] [ i_position ] [ 2 ], b_interior [ bis_int ] [ i_position ] [ 3 ], b_interior [ bis_int ] [ i_interior ], b_info [ t ] [ b_id ] + 1000 ) ;

			teleport_tick [ playerid ] = GetTickCount ( ) ;
			p_t_info [ playerid ] [ pickup_id ] = pickup_bizz_exit [ bis_int ] ;

			if ( b_info [ t ] [ b_improve ] [ 1 ] ) SendClientMessage ( playerid, col_gray, !"* В этом бизнесе имеется аптечка. Чтобы восстановить здоровье используйте {"#cGN"}/bheal{"#cGRInfo"} ({"#cGN"}250"valute_title_"{"#cGRInfo"})");

			new _rstatus = b_info [ t ] [ b_radio_status ] ;
            if ( _rstatus == 1 )
			{
	  			SendClientMessage ( playerid, col_gray, !"* В этом бизнесе имеется аудио-система. Чтобы отключить аудио-систему используйте {"#cGN"}/bstop{"#cGRInfo"}");
				if ( IsPlayerAttachedObjectSlotUsed ( playerid, 1 ) ) RemovePlayerAttachedObject ( playerid, 1 ), StopAudioStreamForPlayer ( playerid ) ;
				PlayerPlaySound ( playerid, b_info [ t ] [ b_sound ], 0, 0, 0 ) ;
			}
			else if ( _rstatus == 2 )
			{
   				SendClientMessage ( playerid, col_gray, !"* В этом бизнесе имеется аудио-система. Чтобы отключить аудио-систему используйте {"#cGN"}/bstop{"#cGRInfo"}");
			    if ( IsPlayerAttachedObjectSlotUsed ( playerid, 1 ) ) RemovePlayerAttachedObject ( playerid, 1 ), StopAudioStreamForPlayer ( playerid ) ;
			    PlayAudioStreamForPlayer ( playerid, b_info [ t ] [ b_radio_url ] ) ;
			}

            b_info [ t ] [ b_visitors ] ++ ;
			return 1 ;
		}
		case d_ptp:
		{
		    if ( ! response )
		    {
		        clear_sell_params ( playerid, playerid ) ;
		        return 1 ;
		    }

		    new _target_id = seller_id [ playerid ], _admin_id = buyer_id [ playerid ] ;
		    if ( ! IsPlayerConnected ( _target_id ) )
		    {
		        SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не в сети." ) ;
		    	clear_sell_params ( playerid, playerid ) ;
		        return 1 ;
		    }

		    new Float:PPos [ 3 ] ;
		    GetPlayerPos ( _target_id, PPos [ 0 ], PPos [ 1 ], PPos [ 2 ] ) ;
		    PPos [ 0 ] += 2.0 ;
		    set_pos ( playerid, PPos [ 0 ], PPos [ 1 ], PPos [ 2 ], 90.0, GetPlayerInterior ( _target_id ), GetPlayerVirtualWorld ( _target_id ) ) ;

			new scm_string [ 144 ] ;
		    format ( scm_string, sizeof ( scm_string  ),"Администратор %s[%d] телепортировал Вас к игроку %s[%d].", p_info [ playerid ] [ name ], playerid, p_info [ _target_id ] [ name ], _target_id ) ;
			SendClientMessage ( playerid, col_gray, scm_string ) ;
			format ( scm_string, sizeof ( scm_string  ),"{"#cBAdmin"}[A] {"#cGRAdmin"}%s[%d] телепортировал игрока %s[%d] к игроку %s[%d]", p_info [ playerid ] [ name ], playerid, p_info [ _admin_id ] [ name ], _admin_id, p_info [ _target_id ] [ name ], _target_id ) ;
			foreach(new i: admin_players)SendClientMessage ( i, col_admin, scm_string ) ;

			if ( GetPVarInt ( playerid, "house_id" ) > 0 )
			{
			    clear_check_info ( playerid, CINFO_HOUSE_HMENU_ID_1 ) ;
			    clear_check_info ( playerid, CINFO_HOUSE_HMENU_ID_2 ) ;
			    clear_check_info ( playerid, CINFO_HOUSE_HMENU_ID_3 ) ;
			}

			if ( GetPVarInt ( playerid, "cellar_id" ) > 0 ) clear_check_info ( playerid, CINFO_CELLAR_MENU_ID ) ;

		    clear_sell_params ( playerid, playerid ) ;
		    return 1 ;
		}
		case d_roulette:
		{
		    if ( ! response ) return 1 ;

		    showPlayerRoulette ( playerid ) ;
		    return 1 ;
		}
		case d_help:
		{
			if ( ! response ) return 1 ;
			switch ( listitem )
			{
			    case 0:
			    {
					show_dialog ( playerid, d_help_box, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Интерфейс", "{"#cBL"}Худ:\n\n\
					{"#cWH"}На экране у Вас отображается информация о Вашем персонаже:\n\n\
					{"#cGRDialog"}- {"#cWH"}Уровень здоровья.\n\
					{"#cGRDialog"}- {"#cWH"}Уровень брони.\n\
					{"#cGRDialog"}- {"#cWH"}Уровень сытости.\n\
					{"#cGRDialog"}- {"#cWH"}Меню EVENT PASS.\n\
					{"#cGRDialog"}- {"#cWH"}DONATE меню.\n\
					{"#cGRDialog"}- {"#cWH"}Кнопки для быстрого взаимодействия.\n\n\
					Кнопка с изображением {"#cLY"}шестерёнки {"#cWH"}помогает вызвать меню настроек игры,\n\
					а кнопка с изображением {"#cLY"}человека {"#cWH"}вызвать меню взаимодействия с игроками,\n\
					которые находятся рядом с Вами. Сытость можно пополнить в любой закусочной или баре.\n\n\
					Для управления передвижением используйте свайп в левой нижней части экрана.\n\n\
					{"#cBL"}Карта:\n\n\
					{"#cWH"}Если Вы нажмёте на мини карту, то у Вас откроется меню игры, где Вы сможете управлять настройками графики.\n\
					Если у Вас слишком низкое фпс или появляются время от времени лаги, то советуем понизить настройки в разделе 'дисплей'.\n\n\
					{"#cBL"}Взаимодействие:\n\n\
					{"#cWH"}Если у Вас имеется какой-то вопрос или жалоба, то используйте {"#cLY"}/mm - Связь с администрацией{"#cWH"}.\n\
					Ввод команд осуществляется при {"#cLY"}нажатии на чат{"#cWH"}.", "Назад", "Закрыть" ) ;
				}
			    case 1:
			    {
					show_dialog ( playerid, d_help_box, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Работа", "{"#cBL"}Работа:\n\n\
					{"#cWH"}Устроиться на любую работу можно в Мэрии.\n\
					Некоторые работы имеют ограничение по уровню.\n\
					После устройства на работу используйте {"#cLY"}/mm - Команды сервера - Работы{"#cWH"}.\n\n\
					{"#cBL"}Транспортные компании:\n\n\
					{"#cWH"}Устройство в транспортную компанию происходит в два этапа:\n\n\
					{"#cGRDialog"}- {"#cWH"}Устройство в Мэрии.\n\
					{"#cGRDialog"}- {"#cWH"}Устройство в в самой ТК.\n\n\
					После чего Вам нужно арендовать транспорт на пикапе устройства в ТК. И отправиться на загрузку {"#cLY"}/tpanel{"#cWH"}.\n\
					На одни фуры загружается прицеп и перевозимый груз больше, на другие загружается в кузов и перевозимый груз меньше\n\n\
					{"#cGRDialog"}/quitjob {"#cWH"}- уволиться с любой работы.", "Назад", "Закрыть" ) ;
				}
			    case 2:
			    {
					show_dialog ( playerid, d_help_box, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Транспорт", "{"#cBL"}Транспорт:\n\n\
					{"#cWH"}Для приобретения и ознакомления с ассортиментом транспортных средств на сервере используйте {"#cGN"}/gps - Бизнесы - Автосалоны{"#cWH"}.\n\
					На сервере имеется несколько видов тюнинга: внешний, Perfomance (технические характеристики).\n\n\
					{"#cBL"}Внешний тюнинг:\n\n\
					{"#cWH"}Во внешнем тюнинге Вы сможете установить винилы, изменить колёса, цвета фар, неон.\n\
					Не на весь транспорт подходят одни и те же диски, неон, винилы и т.п.\n\n\
					{"#cBL"}Perfomance:\n\n\
					{"#cWH"}В Perfomance тюнинге Вы сможете изменить скорость, улучшить торможение и сцепление с дорогой.\n\n\
					{"#cGRInfo"}/cars{"#cWH"} - управление транспортом.\n\
					{"#cGRInfo"}/vpark{"#cWH"} - припарковать транспорт.\n\
					{"#cGRInfo"}/fuelcar{"#cWH"} - заправить транспорт канистрой (покупается на заправках).\n\
					{"#cGRInfo"}/repcar{"#cWH"} - починить транспорт набором инструментов (покупается в 24/7).", "Назад", "Закрыть" ) ;
				}
			    case 3:
			    {
					show_dialog ( playerid, d_help_box, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Ограбление банка", "{"#cBL"}Процесс ограбления:\n\n\
					{"#cWH"}Для начала ограбления Вы должны состоять в мафии. На базе Вашей организации находится пикап, который и позволит начать ограбление.\n\
					Залог успешного ограбления - команда из {"#cLY"}четырёх {"#cWH"}человек.\n\
					В течении всего процесса ограбления у Вас будет появляться информация, используйте /b_robbery.\n\
					Вам необходимо будет выполнить несколько простейших действий прежде, чем приступить к самому ограблению банка.\n\
					Вы также можете приглашать Ваших друзей и знакомых в виде пассивных помощников при ограблении.\n\
					При начале самого ограбления банка у Вас будет 10 минут, мы Вас не ограничиваем по сумме выноса денежных средств.\n\
					Сколько награбите, столько и заберёте. Сумма будет поделена на всех участников ограбления.", "Назад", "Закрыть" ) ;
				}
				case 4:
				{
					show_dialog ( playerid, d_help_box, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Клады", "{"#cBL"}Поиск кладов:\n\n\
					{"#cWH"}Клады разбросаны по всему штату. Находятся они в самых потаёных местах.\n\
					Для успешного выкапывания клада Вам нужна лопата. Приобрести можно в любом магазине 24/7.\n\
					Одна лопата - {"#cLY"}три {"#cWH"}клада. Также, когда Вы раскопаете сам клад (горку), то другой игрок может Вам помешать,\n\
					и забрать Ваш клад, поэтому будьте внимательны и аккуратны.\n\
					Также Вы можете найти {"#cLY"}карту кладов{"#cWH"}, которая облегчит поиски.\n\n\
					{"#cBL"}Возможный дроп:\n\n\
					{"#cGRDialog"}- {"#cWH"}Редкий транспорт.\n\
					{"#cGRDialog"}- {"#cWH"}Донат поинты.\n\
					{"#cGRDialog"}- {"#cWH"}Семейные талоны.\n\
					{"#cGRDialog"}- {"#cWH"}VIP на несколько дней.\n\
					{"#cGRDialog"}- {"#cWH"}Уникальный скин.", "Назад", "Закрыть" ) ;
				}
				case 5:
				{
					show_dialog ( playerid, d_help_box, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Семьи", "{"#cBL"}Семья:\n\n\
					{"#cWH"}Семья - это некоторая разновидность личных организаций. Семью можно создать в Мэрии.\n\
					Лидеру семьи будут доступны настройки такие как: количество рангов, ранг приёма в семью и т.д.\n\
					У семей есть репутация, которая влияет на ежечасовое получение семейных талонов.\n\
					Транспорт в семью закупается самостоятельно лидером, а банк семьи могут пополнять любые члены семьи.\n\
					Когда Вы заключаете дипломатические отношения с другой семьёй, то Вам будет доступен чат альянса.\n\
					В чате альянса то, что Вы написали будут видеть все семьи, с которыми у Вашей семьи дипломатические отношения в статусе {"#cLY"}союз{"#cWH"}.\n\
					Также лидер семьи может установить свой дом, как семейный и всем членам семьи будет доступен новый вид спавна.\n\
					Когда у семьи появляется свой дом, то автоматически становится доступен общак, который пополняют члены семьи.\n\n\
					{"#cBL"}Рейтинг семей:\n\n\
					{"#cWH"}Рейтинг семьи начисляется за перехваты посылок, контрабанду, подконтрольные территории.\n\
					{"#cWH"}Чем Выше семья в рейтинге, тем больше бонусов она получит.\n\
					{"#cWH"}Для просмотра ТОП рейтинга семей используйте {"#cLY"}/reitfam{"#cWH"}.\n\n\
					{"#cBL"}Семейные талоны:\n\n\
					{"#cWH"}За семейные талоны Вы сможете приобретать дополнительные слоты для транспорта в семью, уникальные аксессуары, скины, транспорт.\n\
					Всё это доступно в войне за территории, которые разбросаны по карте.\n\
					Семейные талоны также можно зарабатывать с контролирующих территорий или за семейные задания. (/fmenu или /gps - Прочее)", "Назад", "Закрыть" ) ;
				}
				case 6:
				{
					show_dialog ( playerid, d_help_box, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Альянс", "{"#cBL"}Альянс организаций:\n\n\
					{"#cWH"}Альянс могут создавать только криминальные организации используя /diplomacy.\n\
					Создав альянс Вам будет доступен общий чат Вашего альянса.\n\
					Состоя в альянсе Вы можете помогать друг другу на захватах. Очки убийств будут засчитываться,\n\
					но не забывайте, убивая Ваших союзников, противник будет тоже получать очки на захватах.\n\
					Когда Вы заключаете дипломатические отношения с другой семьёй, то Вам будет доступен чат альянса.", "Назад", "Закрыть" ) ;
				}
				case 7:
				{
					show_dialog ( playerid, d_help_box, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Тренировочный комплекс", "{"#cBL"}Тренировочный комплекс:\n\n\
					{"#cWH"}Тренировочный комплекс есть в каждой организации. Функционал тренировочного комплекса почти не ограничен.\n\
					Лидер организации может устанавливать ранг доступа к тренировочному комплексу, менять позицию тренировочного комплекса и т.д.\n\
					Ваша организация может устраивать совместные тренировки с другими организациями, даже с противоположными.\n\
					Например: мафия может устроить тренировку с полицией.\n\
					Сперва Вам нужно будет установить каждому игроку команду на время тренировки, а только потом Вы сможете начать тренировку.\n\
					Если игрок зайдёт в тренировочный комплекс во время тренировки, то ему всего-лишь нужно будет установить команду и он\n\
					автоматически станет участником тренировки. Чтобы прервать тренировку просто покиньте тренировочный комплекс.", "Назад", "Закрыть" ) ;
