*/

callback: punishment_kick_loading ( playerid )
{
    new rows, fields ;
	cache_get_data ( rows, fields ) ;

	if ( rows )
	{
		for ( new i = 0 ; i < rows ; i ++ )
		{
		    new _pun_id = cache_get_field_content_int ( i, "pun_id", sql_connection ) ;
		    punish_kick [ _pun_id ] [ pun_time ] = cache_get_field_content_int ( i, "pun_time", sql_connection ) ;

			new _p ;
			_p = cache_get_field_content_int ( i, "pun_capture", sql_connection ) ;
			if ( _p ) punish_kick [ _pun_id ] [ pun_capture ] = true ;
			else punish_kick [ _pun_id ] [ pun_capture ] = false ;
			_p = cache_get_field_content_int ( i, "pun_bizwar", sql_connection ) ;
			if ( _p ) punish_kick [ _pun_id ] [ pun_bizwar ] = true ;
			else punish_kick [ _pun_id ] [ pun_bizwar ] = false ;
			_p = cache_get_field_content_int ( i, "pun_family_war", sql_connection ) ;
			if ( _p ) punish_kick [ _pun_id ] [ pun_family_war ] = true ;
			else punish_kick [ _pun_id ] [ pun_family_war ] = false ;
			_p = cache_get_field_content_int ( i, "pun_green_zone", sql_connection ) ;
			if ( _p ) punish_kick [ _pun_id ] [ pun_green_zone ] = true ;
			else punish_kick [ _pun_id ] [ pun_green_zone ] = false ;
			_p = cache_get_field_content_int ( i, "pun_shot", sql_connection ) ;
			if ( _p ) punish_kick [ _pun_id ] [ pun_shot ] = true ;
			else punish_kick [ _pun_id ] [ pun_shot ] = false ;

		    cache_get_field_content ( i, "pun_name", punish_kick [ _pun_id ] [ pun_name ], sql_connection, 32 ) ;
		}
	}
	return 1 ;
}

