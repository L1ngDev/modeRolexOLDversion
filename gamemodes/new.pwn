		   	SendClientMessage ( playerid, col_gray, bonus_text ) ;
		}
		if ( server_bonus [ 3 ] > 1 )
		{
			format ( bonus_text, sizeof bonus_text, "{"#cGRInfo"}- {"#cWH"}Зарплата на работах {"#cGN"}x%d.", server_bonus [ 3 ] ) ;
		    SendClientMessage ( playerid, col_gray, bonus_text ) ;
		}
		if ( server_bonus [ 4 ] > 1 )
		{
		    format ( bonus_text, sizeof bonus_text, "{"#cGRInfo"}- {"#cWH"}Зарплата {"#cGN"}{"#cGN"}x%d в PayDay.", server_bonus [ 4 ] ) ;
		    SendClientMessage ( playerid, col_gray, bonus_text ) ;
		}
		if ( server_bonus [ 5 ] > 1 )
