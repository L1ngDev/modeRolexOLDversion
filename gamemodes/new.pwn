						return 1 ;
					}
					show_dialog ( playerid, d_deposit_transfer_id, DIALOG_STYLE_INPUT, "{"#cBHD"}Перевод", "{ffffff}Введите номер счёта:", "Принять", "Назад" ) ;

				}
				case 2:
				{
				    new dialog_string [ 150 ] ;
				    format ( dialog_string, sizeof dialog_string, "{ffffff}Деньги на вашем счету: {"#cLY"}%s"valute_title"{"#cWH"}.\n\n{"#cGRDialog"}* Введите сумму, которую хотите положить на ваш счет:", GetPlayerCashValue ( db_money ) ) ;
					show_dialog ( playerid, d_deposit_put, DIALOG_STYLE_INPUT, "{"#cBHD"}Положить деньги", dialog_string, "Принять", "Назад" ) ;
				}
				case 3:
				{
				    new dialog_string [ 200 ] ;
				    if ( atm_used [ playerid ] > 0 && GetPVarInt ( playerid, "p_biz_id" ) > 0 ) format ( dialog_string, sizeof dialog_string, "{ffffff}Деньги на вашем счету: {"#cLY"}%s"valute_title"{"#cWH"}.\nКомиссия: {"#cLY"}%d%%{"#cWH"}.\n\n{"#cGRDialog"}* Введите сумму, которую хотите снять со счета:", GetPlayerCashValue ( db_money ), b_price_market [ GetPVarInt ( playerid, "p_biz_id" ) - 1 ] [ 0 ] ) ;
 					else format ( dialog_string, sizeof dialog_string, "{ffffff}Деньги на вашем счету: {"#cLY"}%s"valute_title"{"#cWH"}.\n\n{"#cGRDialog"}* Введите сумму, которую хотите снять со счета:", GetPlayerCashValue ( db_money ) ) ;
					show_dialog ( playerid, d_deposit_take, DIALOG_STYLE_INPUT, "{"#cBHD"}Снять деньги", dialog_string, "Принять", "Назад" ) ;
				}
				case 4:
				{
					show_dialog ( playerid, d_deposit_tophone, DIALOG_STYLE_INPUT, "{"#cBHD"}Пополнение баланса телефона", "{ffffff}Введите сумму, на которую хотите пополнить баланс:", "Принять", "Назад" ) ;
				}
				case 5:
				{
				    new text_string [ 118 + 9 + 9 ] ;
					mysql_format ( sql_connection, text_string, sizeof ( text_string  ), "SELECT * FROM `deposit_logs` WHERE `dl_from` = '%d' ORDER BY `deposit_logs`.`dl_id` DESC LIMIT 25", bank_info [ playerid ] [ bi_id ] [ deposit_id ] ) ;
					mysql_tquery ( sql_connection, text_string, "deposit_logs_callback", "i", playerid ) ;
				}
				case 6:
				{
				    show_dialog ( playerid, d_deposit_setpincode, DIALOG_STYLE_INPUT, "{"#cBHD"}Изменение PIN-кода", "{ffffff}Введите пин-код, на который хотите поменять:", "Принять", "Назад" ) ;
				}
				case 7:
				{
					show_debtors_bank ( playerid ) ;
				}
				case 8:
				{
					bankTicketList ( playerid, 0, 1 ) ;
				}
				case 9:
				{
					show_bank_balance ( playerid ) ;
					return 1 ;
				}
				case 10:
				{
				    global_string [ 0 ] = EOS ;
				    new line_string [ 128 ], fraction_id = 1, bool: status_bl = false ;
				    strcat ( global_string, "{"#cGRDialog"}* Вы находитесь в чёрных списках:\n") ;
				    for ( new i = 0 ; i < fraction_count ; i ++ )
				    {
				        if ( bl_info [ playerid ] [ bl_onFrac ] [ i + 1 ] ) continue ;

						set_player_listitem_values ( playerid, fraction_id, i ) ;

						fraction_id ++ ;

				        format ( line_string, sizeof line_string, "{"#cWH"}%s - Цена вынесения: {"#cGN"}%d"valute_title_"\n", f_info [ i ] [ f_name ], f_info [ i ] [ f_price_clear ] ) ;
				        strcat ( global_string, line_string ) ;
				        status_bl = true ;
				    }
				    if ( status_bl == false ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не находитесь в чёрных списках организаций." ) ;
				    show_dialog ( playerid, d_bank_ransom, DIALOG_STYLE_LIST, "{"#cBHD"}Чёрный список", global_string, "Выбрать", "Назад" ) ;
				}
			}
			return 1 ;
		}
		case d_deposit_delete:
		{
		    if ( ! response )
		    {
		        show_dr_boxes ( playerid ) ;
				return 1 ;
			}

			new _deposit_num = get_player_use_listitem ( playerid ) ;

			new sql_string [ 100 ] ;
