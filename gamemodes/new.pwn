CMD:id ( playerid, params [ ] )
{
    if ( sscanf ( params, "s[24]", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /id [ид/имя]");

    if ( ! _is_numeric ( params [ 0 ] ) )
    {
        new _pl_id = strval ( params [ 0 ] ), string [ 144 ] ;
        if ( ! IsPlayerConnected ( _pl_id ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;

       	format ( string, sizeof string, "%s - ID: {"#cGN"}%d{"#cWH"}, LVL: {"#cGN"}%d {"#cGRInfo"}(Аккаунт: {"#cGN"}№%d{"#cGRInfo"}) %s", p_info [ _pl_id ] [ name ], _pl_id, p_info [ _pl_id ] [ level ], p_info [ _pl_id ] [ id ], ( pl_afk_time [ _pl_id ] > 2 ) ? ( "{EBA43D}[AFK]{ffffff}" ) : ( "" ));
       	SendClientMessage ( playerid, col_white, string ) ;
        return 1 ;
    }

    new string [ 144 ], pl_id = 0, name_string [ MAX_PLAYER_NAME + 16 ], insert_pos = 0 ;
    foreach(new i: logged_players)
    {
		if ( strfind ( p_info [ i ] [ name ], params [ 0 ], true ) != -1 )
        {
            GetPlayerName ( i, name_string, sizeof name_string ) ;

	        insert_pos = strfind ( name_string, params [ 0 ], true ) ;
	        if ( insert_pos != -1 )
			{
	            strins ( name_string, "{"#cWH"}", strlen ( params [ 0 ] ) + insert_pos ) ;
	            strins ( name_string, "{"#cLY"}", insert_pos ) ;
	        }

        	format ( string, sizeof string, "%s - ID: {"#cGN"}%d{"#cWH"}, LVL: {"#cGN"}%d {"#cGRInfo"}(Аккаунт: {"#cGN"}№%d{"#cGRInfo"}) %s", name_string, i, p_info [ i ] [ level ], p_info [ i ] [ id ], ( pl_afk_time [ i ] > 2 ) ? ( "{EBA43D}[AFK]{ffffff}" ) : ( "" ));
        	SendClientMessage ( playerid, col_white, string ) ;
        	pl_id ++ ;

			if ( pl_id == 10 ) return SendClientMessage ( playerid, col_orange, !"* Первые 10 игроков с похожим ником." ) ;
        }
    }
    if ( pl_id == 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игроков с похожим ником нет на сервере." ) ;
    return 1 ;
}

stock _is_numeric ( const string [ ] )
{
	for ( new i = 0, j = strlen ( string ) ; i < j ; i ++ )
	{
		if ( string [ i ] > '9' || string [ i ] < '0' ) return 1 ;
	}
	return 0 ;
}

alias:n("b")
CMD:n ( playerid, params [ ] )
{
	if ( p_info [ playerid ] [ mute ] )
	{
		new scm_string [ 38 ] ;
		format ( scm_string, sizeof ( scm_string  ),"У вас бан чата | %d секунд(ы)", p_info [ playerid ] [ mute ] ) ;
		SendClientMessage ( playerid, col_light_red, scm_string ) ;
		return false ;
	}
	if ( player_mp [ playerid ] && ! admin_mp_chat ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Запрещено использовать на мероприятии." ) ;

	new _n_str [ 128 ] ;
	if ( sscanf ( params, "s[128]", _n_str ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /n [текст]" ) ;
	if ( strlen ( _n_str ) < 2 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы ничего не ввели в текст сообщения." ) ;
 	if ( check_advertise ( playerid, _n_str, report_type_n ) ) return 1 ;
    if ( is_seller_text ( _n_str ) )
	{
 		check_advertise ( playerid, _n_str, report_type_n, true ) ;
 		return 1 ;
	}
	if ( ! antiflood_OnPlayerText ( playerid, _n_str, 2 ) ) return 1 ;

 	new scm_string [ 144 ];
	format ( scm_string, sizeof ( scm_string ), "(( %s[%d]: %s ))", p_info [ playerid ] [ name ], playerid, _n_str ) ;
	send_world_message ( playerid, 20.0, scm_string, 0xCCCC99FF, 0xCCCC99FF, 0xCCCC99FF, false ) ;
	format ( scm_string, sizeof ( scm_string ), "(( %s ))", _n_str ) ;
	SetPlayerChatBubble ( playerid, scm_string, 0xCCCC99FF, 20, 5000 ) ;
	return true ;
}

