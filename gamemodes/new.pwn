				        set_pos ( _o_id, duels_pos [ 3 ] [ 0 ], duels_pos [ 3 ] [ 1 ], duels_pos [ 3 ] [ 2 ], duels_pos [ 3 ] [ 3 ], duels_interior [ 1 ], _o_id + 1000 ) ;
				    }
