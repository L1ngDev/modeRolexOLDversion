			if ( is_text_invalid ( inputtext ) ) return show_dialog ( playerid, d_business_rank_name, DIALOG_STYLE_INPUT, "{"#cBHD"}Название должности", "{FFFFFF}Введите название должности:\n\n{"#cRD"}* Название должности не должно содержать некорректных символов", "Принять", "Назад" ) ;

            new business_id = p_info [ playerid ] [ business ] ;
			new dialog_rank_id = GetPVarInt ( playerid, "rank_name_listitem" ) ;
