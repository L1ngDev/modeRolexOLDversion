CMD:radio ( playerid )
{
	show_dialog ( playerid, d_radio_select, DIALOG_STYLE_LIST, "{"#cBHD"}Выбор радиостанции", "{"#cBL"}1.{"#cWH"} Радиостанция "radio_name"\n{"#cGRDialog"}- Выключить", "Принять", "Закрыть" ) ;
	return 1 ;
}

new ether_cooldown ;

CMD:ether ( playerid )
{
	if ( ! radio_player ( playerid ) ) return 1 ;
	if ( p_info [ playerid ] [ rank ] < f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 9 ] )
	{
	    static const _str [ ] = "{"#cRInfo"}* {"#cGRInfo"}Команда доступна с ранга %s (%d)." ;
	    new scm_string [ sizeof _str + 30 + 3 ] ;
	    format ( scm_string, sizeof scm_string, _str, f_rank [ p_info [ playerid ] [ member ] - 1 ] [ f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 9 ] - 1 ], f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 9 ] ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
		return 1 ;
	}

	if ( is_ether { playerid } == 0 )
	{
	    if ( ether_cooldown > gettime ( ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Эфир можно проводить не чаще одного раза за 40 минут!" ) ;

		is_ether { playerid } = p_info [ playerid ] [ member ] ;
		p_info [ playerid ] [ radio ] = is_ether { playerid } ;
		SendClientMessage ( playerid, col_succes, !"Вы вошли в эфир. (Принятие звонков и смс /cas)" ) ;
		SendClientMessage ( playerid, col_succes, !"Чтоб сообщение вышло в эфир набирайте его в обычный чат." ) ;
		return 1 ;
	}
	else
	{
	    if ( cas_price [ p_info [ playerid ] [ member ] - 26 ] != 0 ) callcmd::offcas ( playerid ) ;
		is_ether { playerid } = 0 ;
		SendClientMessage ( playerid, col_succes, !"Вы закончили эфир." ) ;

		ether_cooldown = gettime ( ) + ( 40 * 60 ) ;
		return 1 ;
	}
}

CMD:nmenu ( playerid )
{
	if ( ! radio_player ( playerid ) ) return 1 ;
	show_nmenu ( playerid ) ;
	return 1 ;
}

CMD:cas ( playerid, params [ ] )
{
	if ( ! radio_player ( playerid ) )return 1 ;
	if ( p_info [ playerid ] [ rank ] <  f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 9 ] )
	{
	    static const _str [ ] = "{"#cRInfo"}* {"#cGRInfo"}Команда доступна с ранга %s (%d)." ;
	    new scm_string [ sizeof _str + 30 + 3 ] ;
	    format ( scm_string, sizeof scm_string, _str, f_rank [ p_info [ playerid ] [ member ] - 1 ] [ f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 9 ] - 1 ], f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 9 ] ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
		return 1 ;
	}
	if ( is_ether { playerid } == 0 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны быть в эфире!" ) ;
	if ( cas_price [ p_info [ playerid ] [ member ] - 26 ] != 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Приём звонков и смс уже запущен!" ) ;
	if ( sscanf ( params, "d", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /cas [цена звонка]" ) ;
	if ( params [ 0 ] < 1 || params [ 0 ] > 1000 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Цена звонка не может быть меньше 1"valute_title_" или больше 1000"valute_title"!" ) ;
	cas_price [ p_info [ playerid ] [ member ] - 26 ] = params [ 0 ] ;
	SendClientMessage ( playerid, col_succes, !"Чтобы отключить приём звонков, введите команду /offcas." ) ;
	return 1 ;
}

CMD:offcas ( playerid )
{
	if ( ! radio_player ( playerid ) )return 1 ;
	if ( p_info [ playerid ] [ rank ] <  f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 9 ] )
	{
	    static const _str [ ] = "{"#cRInfo"}* {"#cGRInfo"}Команда доступна с ранга %s (%d)." ;
	    new scm_string [ sizeof _str + 30 + 3 ] ;
	    format ( scm_string, sizeof scm_string, _str, f_rank [ p_info [ playerid ] [ member ] - 1 ] [ f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 9 ] - 1 ], f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 9 ] ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
		return 1 ;
	}
	if ( is_ether { playerid } == 0 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны быть в эфире!" ) ;
	if ( cas_price [ p_info [ playerid ] [ member ] - 26 ] == 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Приём звонков и смс ещё не запущен!" ) ;

	new fraction_id = p_info [ playerid ] [ member ] ;
	cas_price [ fraction_id - 26 ] = 0 ;

	new scm_string [ 98 ] ;
	format ( scm_string, sizeof scm_string, "[R] %s %s закончил принятие звонков. Доход: %d"valute_title".", f_rank [ fraction_id - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], cas_bank [ fraction_id - 26 ] ) ;
    fraction_message ( fraction_id, col_lblue, scm_string ) ;
	foreach(new i: logged_players)
	{
		if ( is_ether { i } == 0 || is_ether { i } != fraction_id || i == playerid ) continue ;

		is_ether { i } = 0 ;
		SetPlayerSpecialAction ( i, SPECIAL_ACTION_STOPUSECELLPHONE ) ;
		RemovePlayerAttachedObject ( i, 2 ) ;
	}
	return 1 ;
}

CMD:numether ( playerid )
{
	if ( ! radio_player ( playerid ) )return 1 ;
	if ( p_info [ playerid ] [ rank ] <  f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 9 ] )
	{
	    static const _str [ ] = "{"#cRInfo"}* {"#cGRInfo"}Команда доступна с ранга %s (%d)." ;
	    new scm_string [ sizeof _str + 30 + 3 ] ;
	    format ( scm_string, sizeof scm_string, _str, f_rank [ p_info [ playerid ] [ member ] - 1 ] [ f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 9 ] - 1 ], f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 9 ] ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
		return 1 ;
	}
	if ( cas_price [ p_info [ playerid ] [ member ] - 26 ] != 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нельзя изменить номер во время приёма звонков." ) ;

	new _dialog_string [ 144 ] ;
	format ( _dialog_string, sizeof _dialog_string, "{"#cWH"}Текущий номер радиостанции: {"#cGN"}%d{"#cWH"}.\n\n{"#cGRDialog"}* Если хотите изменить номер, укажите его в пустую графу:", f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_materials ] ) ;
	show_dialog ( playerid, d_numether, DIALOG_STYLE_INPUT, "{"#cBHD"}Номер прямого эфира", _dialog_string, "Принять", "Отмена" ) ;
	return 1 ;
}

CMD:incas ( playerid, params [ ] )
{
	if ( ! radio_player ( playerid ) )return 1 ;
	if ( p_info [ playerid ] [ rank ] <  f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 9 ] )
	{
	    static const _str [ ] = "{"#cRInfo"}* {"#cGRInfo"}Команда доступна с ранга %s (%d)." ;
	    new scm_string [ sizeof _str + 30 + 3 ] ;
	    format ( scm_string, sizeof scm_string, _str, f_rank [ p_info [ playerid ] [ member ] - 1 ] [ f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 9 ] - 1 ], f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 9 ] ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
		return 1 ;
	}
	if ( is_ether { playerid } == 0 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны быть в эфире!" ) ;
	if ( cas_price [ p_info [ playerid ] [ member ] - 26 ] == 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Приём звонков и смс ещё не запущен!" ) ;
	if ( sscanf ( params, "u", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /incas [ид/имя]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( is_ether_calling { params [ 0 ] } == 0 &&
		( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не пытается позвонить в эфир и не находится рядом с вами." ) ;

	if ( is_ether_calling { params [ 0 ] } != 0 && p_t_info [ params [ 0 ] ] [ p_dialog ] == d_ether_calling ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не пытается позвонить в эфир." ) ;

	new scm_string [ 78 ] ;
	format ( scm_string, sizeof scm_string, "Вы подключили к прямому эфиру слушателя %s.", p_info [ params [ 0 ] ] [ name ] ) ;
	SendClientMessage ( playerid, col_succes, scm_string ) ;

	is_ether { params [ 0 ] } = p_info [ playerid ] [ member ] ;
	is_ether_calling { params [ 0 ] } = 0 ;
	return 1 ;
}

CMD:uncas ( playerid, params [ ] )
{
	if ( ! radio_player ( playerid ) )return 1 ;

	new fractionid = p_info [ playerid ] [ member ] ;
	if ( p_info [ playerid ] [ rank ] < f_info [ fractionid - 1 ] [ f_rank_settings ] [ 9 ] )
	{
	    static const _str [ ] = "{"#cRInfo"}* {"#cGRInfo"}Команда доступна с ранга %s (%d)." ;
	    new scm_string [ sizeof _str + 30 + 3 ] ;
	    format ( scm_string, sizeof scm_string, _str, f_rank [ fractionid - 1 ] [ f_info [ fractionid - 1 ] [ f_rank_settings ] [ 9 ] - 1 ], f_info [ fractionid - 1 ] [ f_rank_settings ] [ 9 ] ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
		return 1 ;
	}
	if ( is_ether { playerid } == 0 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны быть в эфире!" ) ;
	if ( cas_price [ fractionid - 26 ] == 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Приём звонков и смс ещё не запущен!" ) ;
	if ( sscanf ( params, "u", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /uncas [ид/имя]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( is_ether { params [ 0 ] } == 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не находится в эфире." ) ;


	new scm_string [ 98 ] ;
	format ( scm_string, sizeof scm_string, "[R] %s %s отключил слушателя %s от эфира.",
	f_rank [ fractionid - 1 ] [ p_info [ playerid ] [ rank ] - 1 ],
	p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ] ) ;
	fraction_message ( fractionid, col_lblue, scm_string ) ;

	is_ether { params [ 0 ] } = 0 ;
	is_ether_calling { params [ 0 ] } = 0 ;
 	SetPlayerSpecialAction ( params [ 0 ], SPECIAL_ACTION_STOPUSECELLPHONE ) ;
  	RemovePlayerAttachedObject ( params [ 0 ], 2 ) ;
	return 1 ;
}

CMD:ash ( playerid )
{
	if ( GetPVarInt ( playerid, "AutoExam" ) ) return 1 ;
	show_dialog ( playerid, d_auto_exam_1, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Автошкола","{ffffff}\t\t\t\t\t\tШкола вождения\n\nДобро пожаловать в автошколу. Чтобы сдать на права Вам нужно выполнить следующие действия\n1. Прочитайте и запомните ПДД\n2. Сдайте тест на знание ПДД\n3. Сдайте практический экзамен иструктору","Далее","Выход");
	SetPVarInt(playerid,"AutoExam", true);
	return 1 ;
}

CMD:licenses ( playerid )
{
    global_string [ 0 ] = EOS ;
    new line_string [ 64 ] ;

    new _drive_lic = p_info [ playerid ] [ drive_lic ] ;
	strcat ( global_string, "{"#cBL"}** Водительские права **\n" ) ;
	if ( ! _drive_lic ) strcat ( global_string, "{"#cGRDialog"}Нет, можно получить\n" ) ;
	else if ( _drive_lic == 1 )
	{
	    strcat ( global_string, "{"#cGRDialog"}Имеются, без ограничений\n" ) ;
	    format ( line_string, sizeof line_string, "{"#cGRDialog"}Срок действия: {"#cWH"}%d дн.\n", p_info [ playerid ] [ drive_day ] ) ;
	    strcat ( global_string, line_string ) ;
	}
	else if ( _drive_lic == 2 )
	{
		strcat ( global_string, "{"#cGRDialog"}Имеются, {"#cLY"}временно заморожены\n" ) ;
	    format ( line_string, sizeof line_string, "{"#cGRDialog"}Срок действия: {"#cWH"}%d дн.\n", p_info [ playerid ] [ drive_day ] ) ;
	    strcat ( global_string, line_string ) ;
	    format ( line_string, sizeof line_string, "{"#cGRDialog"}Заморожены на {"#cWH"}%d часов\n", p_info [ playerid ] [ drive_hour ] ) ;
	    strcat ( global_string, line_string ) ;
	    format ( line_string, sizeof line_string, "{"#cGRDialog"}Причина: {"#cWH"}%s\n", p_info [ playerid ] [ drive_reason ] ) ;
	    strcat ( global_string, line_string ) ;
	}
	else if ( _drive_lic == 3 )
	{
		strcat ( global_string, "{"#cGRDialog"}Нет, {"#cRD"}ограничение на получение\n" ) ;
	    format ( line_string, sizeof line_string, "{"#cGRDialog"}Ограничение на {"#cWH"}%d часов\n", p_info [ playerid ] [ drive_hour ] ) ;
	    strcat ( global_string, line_string ) ;
	    format ( line_string, sizeof line_string, "{"#cGRDialog"}Причина: {"#cWH"}%s\n", p_info [ playerid ] [ drive_reason ] ) ;
	    strcat ( global_string, line_string ) ;
	}

	new _fly_lic = p_info [ playerid ] [ fly_lic ] ;
