callback: clear_users_inventory ( )
{
    new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows ) return 1 ;

   	new sql_string [ 92 + ( 32 * 2 ) ], _u_id, _u_prise ;
	for ( new i = 0 ; i < rows ; i ++ )
	{
	    _u_id = cache_get_field_content_int ( i, "inv_id", sql_connection ) ;
	    _u_prise = cache_get_field_content_int ( i, "inv_item", sql_connection ) ;

	    format ( sql_string, sizeof sql_string, "Действие %s подошло к концу. %s удалён из подарочного инвентаря.", item_name ( _u_prise ), item_name ( _u_prise ) ) ;
	    insert_debtor_message ( "Подарочный инвентарь", sql_string, _u_id ) ;
	}

	format ( sql_string, sizeof sql_string, "DELETE FROM `users_inventory` WHERE `inv_date` != '-1' AND `inv_date` < '%d'", gettime ( ) ) ;
	mysql_tquery ( sql_connection, sql_string, "", "" ) ;
	return 1 ;
}

CMD:giveitem ( playerid, params [ ] )
{
    if ( admin_info [ playerid ] [ admin ] < 8 ) return 1 ;
    if ( ! IsFounder ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}К сожалению, Вам данная функция не доступна." ) ;
    if ( sscanf ( params, "ddd", params [ 0 ], params [ 1 ], params [ 2 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /giveitem [id] [model] [count]");
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;

    give_inventory ( params [ 0 ], params [ 1 ], params [ 2 ], 0, "", "", NUMBERPLATE_TYPE_NONE, 0 ) ;

	new fmt_str [ 128 ] ;
	format(fmt_str, sizeof fmt_str, "* Администратор %s выдал Вам %s %d шт.", p_info [ playerid ] [ name ], item_name ( params [ 1 ] ), params [ 2 ] ) ;
	SendClientMessage ( params [ 0 ], col_succes, fmt_str ) ;

	format(fmt_str, sizeof fmt_str, "* Вы выдали игроку %s[%d] '%s' %d шт.", p_info [ params [ 0 ] ] [ name ], params [ 0 ], item_name ( params [ 1 ] ), params [ 2 ] ) ;
	SendClientMessage ( playerid, col_succes, fmt_str ) ;

	format(fmt_str, sizeof fmt_str, "%s выдал %s %s %d шт", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], item_name ( params [ 1 ] ), params [ 2 ] ) ;
	WriteLog(playerid, TYPE_LOG_ADMIN, fmt_str);
	return 1 ;
}

stock give_treasure ( playerid, item_type, item_count, bool: treasure = false )
{
    new query_string [ 144 ] ;
	if ( treasure )
	{
		format ( query_string, sizeof query_string, "* Вам в инвентарь был добавлен предмет '%s'.", item_name ( item_type ) ) ;
		SendClientMessage ( playerid, col_yellow, query_string ) ;

	  	format(query_string, sizeof query_string, "{"#cRD"}* WARNING %s открыл(а) %d клад(ов) за сессию (в игре уже: %s). Приз: %s", p_info [ playerid ] [ name ], p_t_info [ playerid ] [ treasure_open ], convert_time ( p_info [ playerid ] [ time_hour ], TYPE_TIME_SECOND ), item_name ( item_type ) ) ;
        foreach(new i: admin_players) SendClientMessage ( i, col_gray, query_string ) ;

        format(query_string, sizeof query_string, "%s открыл(а) клад. Приз: %s", p_info [ playerid ] [ name ], item_name ( item_type ) ) ;
		WriteLog(playerid, TYPE_LOG_TREASURE, query_string);

		give_event_progress ( playerid, THE_TREASURE, 1 ) ;
	}
	else
	{
	    /*format ( query_string, sizeof query_string, "* %s получил(а) в подарок '%s' от "server_name".", p_info [ playerid ] [ name ], item_name ( item_type ) ) ;
   		foreach(new j: logged_players) SendClientMessage ( j, col_purple, query_string ) ;*/

   		//format ( query_string, sizeof query_string, "* Вы получили в подарок '%s' от "server_name".", item_name ( item_type ) ) ;
		//SendClientMessage ( playerid, col_purple, query_string ) ;

		format ( query_string, sizeof query_string, "* Вам в инвентарь был добавлен предмет '%s'.", item_name ( item_type ) ) ;
		SendClientMessage ( playerid, col_yellow, query_string ) ;

		format(query_string, sizeof query_string, "%s получил(а) в подарок %s", p_info [ playerid ] [ name ], item_name ( item_type ) ) ;
		WriteLog(playerid, TYPE_LOG_TREASURE, query_string);
	}

   	if ( item_type == 2003 || item_type == 2048 ) give_event_progress ( playerid, THE_WEEKLY_CASE, 1 ) ;

	give_inventory ( playerid, item_type, item_count, 0, "", "", NUMBERPLATE_TYPE_NONE, 0 ) ;
	return 1 ;
}

CMD:limitbonus ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 8 ) return 1 ;

	if ( sscanf ( params, "d", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /limitbonus [online]" ) ;

	online_bonus = params [ 0 ] ;

	new _sql_string [ 82 + 4 + 4 ] ;
 	format ( _sql_string, sizeof _sql_string, "UPDATE `server_variables` SET `var_count` = '%d' WHERE `var_id` = '69' LIMIT 1", online_bonus ) ;
	mysql_tquery ( sql_connection, _sql_string ) ;

	format ( _sql_string, sizeof _sql_string, "{"#cBAdmin"}[A] {"#cGRAdmin"}%s[%d] изменил(а) бонус по онлайну на %d человек", p_info [ playerid ] [ name ], playerid, online_bonus ) ;
	foreach(new i: admin_players)SendClientMessage ( i, col_admin, _sql_string ) ;
	return 1 ;
}

CMD:infocar ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 1 ) return 1 ;

	if ( sscanf ( params, "d", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}infocarйте: /infocar [model]");
	if ( params [ 0 ] < 400 || params [ 0 ] > 611 ) return 1 ;

	global_string [ 0 ] = EOS ;
	new line_string [ 100 ], _type_name [ 32 ] ;
	for ( new i = params [ 0 ] ; i < params [ 0 ] + 20 ; i ++ )
	{
	    if ( i > 611 ) break ;

	    switch ( i )
		{
		    case 430, 446, 452, 453, 454, 472, 473, 484, 493: format ( _type_name, sizeof _type_name, "Водный" ) ;
			case 417, 425, 447, 460, 469, 476, 487, 488, 497, 511, 512, 513, 519, 520, 548, 553,
					563, 577, 592, 593: format ( _type_name, sizeof _type_name, "Воздушный" ) ;
			case 581, 522, 461, 521, 523, 463, 468, 471, 586: format ( _type_name, sizeof _type_name, "Мотоцикл" ) ;
			case 509, 481, 510: format ( _type_name, sizeof _type_name, "Велосипед" ) ;
			case 462, 448: format ( _type_name, sizeof _type_name, "Мопед" ) ;
			case 538, 537: format ( _type_name, sizeof _type_name, "Поезд" ) ;
			default: format ( _type_name, sizeof _type_name, "Машина" ) ;
		}

	    format ( line_string, sizeof line_string, "{"#cBL"}%d. {"#cWH"}%s - %d"valute_title_"{"#cGRDialog"} ({"#cWH"}%s{"#cGRDialog"})\n", i, GetVehicleNameEx ( INVALID_VEHICLE_ID, i ), GetModelPrice ( i ), _type_name ) ;
	    strcat ( global_string, line_string ) ;
	}
	show_dialog ( playerid, d_none, DIALOG_STYLE_LIST, "{"#cBHD"}Car Info", global_string, "Закрыть", "" ) ;
	return 1 ;
}

stock clear_inventory ( playerid, modelId, modelCount )
{
	new slotId = ClearInventory ( playerid, SUB_INVENTORY, modelId, modelCount ) ;
	if ( slotId == -1 ) return 0 ;
	updateInventorySlot ( playerid, slotId ) ;
	return 1 ;
}

stock clear_inventory_slot ( playerid, modelId, modelCount, slotId )
{
	ClearInventorySlot ( playerid, SUB_INVENTORY, slotId, modelId, modelCount ) ;
	updateInventorySlot ( playerid, slotId ) ;
	return 1 ;
}

stock giveInventory ( playerid, const USERS_INVENTORY_STRUCT: itemStruct [ _:INV_STRUCTURE_MAX ] )
{
	new slotId = GiveInventory ( playerid, SUB_INVENTORY, itemStruct ) ;
	updateInventorySlot ( playerid, slotId ) ;
	return 1 ;
}

stock giveInventorySlot ( playerid, const USERS_INVENTORY_STRUCT: itemStruct [ _:INV_STRUCTURE_MAX ], slotId )
{
	GiveInventorySlot ( playerid, SUB_INVENTORY, slotId, itemStruct ) ;
	updateInventorySlot ( playerid, slotId ) ;
	return 1 ;
}

stock give_inventory ( playerid, modelId, modelCount, _type, _region [ ], _plate [ ], _plate_type, _other_id, _day = -1 )
{
	new USERS_INVENTORY_STRUCT: inventoryStruct [ _:INV_STRUCTURE_MAX ] ;
	inventoryStruct [ _:INV_ITEM ] = modelId ;
	inventoryStruct [ _:INV_ITEM_COUNT ] = modelCount ;
	inventoryStruct [ _:INV_ITEM_TYPE ] = _type ;
	format ( inventoryStruct [ _:INV_ITEM_REGION ], 12, "%s", _region ) ;
	format ( inventoryStruct [ _:INV_ITEM_PLATE ], 12, "%s", _plate ) ;
	inventoryStruct [ _:INV_ITEM_PLATE_TYPE ] = _plate_type ;
	inventoryStruct [ _:INV_ITEM_GIVE_DATE ] = 0 ;
	inventoryStruct [ _:INV_ITEM_ID ] = _other_id ;
	inventoryStruct [ _:INV_ITEM_DATE ] = _day ;
	return giveInventory ( playerid, inventoryStruct ) ;
}

stock give_inventory_slot ( playerid, modelId, modelCount, _type, _region [ ], _plate [ ], _plate_type, _other_id, slotId, _day = 20 )
{
	new USERS_INVENTORY_STRUCT: inventoryStruct [ _:INV_STRUCTURE_MAX ] ;
	inventoryStruct [ _:INV_ITEM ] = modelId ;
	inventoryStruct [ _:INV_ITEM_COUNT ] = modelCount ;
	inventoryStruct [ _:INV_ITEM_TYPE ] = _type ;
	format ( inventoryStruct [ _:INV_ITEM_REGION ], 12, "%s", _region ) ;
	format ( inventoryStruct [ _:INV_ITEM_PLATE ], 12, "%s", _plate ) ;
	inventoryStruct [ _:INV_ITEM_PLATE_TYPE ] = _plate_type ;
	inventoryStruct [ _:INV_ITEM_GIVE_DATE ] = 0 ;
	inventoryStruct [ _:INV_ITEM_ID ] = _other_id ;
	inventoryStruct [ _:INV_ITEM_DATE ] = _day ;
	return giveInventorySlot ( playerid, inventoryStruct, slotId ) ;
}

stock updateInventorySlot ( playerid, slotId )
{
	if ( slotId == -1 ) return 0 ;

	#if defined m_inventory_module
		if ( used_inventory [ playerid ] == true ) SetInventoryItemID ( playerid, slotId ) ;
	#endif

	#if defined m_inventory_module
		if ( used_trade [ playerid ] == true ) SetTradePlayerItemID ( playerid, slotId ) ;
	#endif

	#if defined m_inventory_module
		if ( player_market [ playerid ] != -1 ) SetPlayerItemID ( playerid, slotId ) ;
	#endif

	SetInventoryCacheItem ( playerid, slotId ) ;
	return 1 ;
}

stock dragged_player_inventory ( playerid, fromMoveIndex, toMoveIndex )
{
	new draggedItem = GetUsersInventory ( playerid, INV_ITEM, fromMoveIndex ),
		draggedItemCount = GetUsersInventory ( playerid, INV_ITEM_COUNT, fromMoveIndex ),
		droppedItem = GetUsersInventory ( playerid, INV_ITEM, toMoveIndex ),
		droppedItemCount = GetUsersInventory ( playerid, INV_ITEM_COUNT, toMoveIndex ),
		USERS_INVENTORY_STRUCT: moveInventory [ _:INV_STRUCTURE_MAX ],
		USERS_INVENTORY_STRUCT: toInventory [ _:INV_STRUCTURE_MAX ] ;

	moveInventory = TransferInventoryStructure ( playerid, SUB_INVENTORY, fromMoveIndex ) ;
	toInventory = TransferInventoryStructure ( playerid, SUB_INVENTORY, toMoveIndex ) ;

	if ( droppedItem > 0 )
	{
		if ( draggedItem == droppedItem )
		{
			clear_inventory_slot ( playerid, draggedItem, draggedItemCount, fromMoveIndex ) ;
			giveInventorySlot ( playerid, moveInventory, toMoveIndex ) ;
			return 1 ;
		}

		clear_inventory_slot ( playerid, draggedItem, draggedItemCount, fromMoveIndex ) ;
		clear_inventory_slot ( playerid, droppedItem, droppedItemCount, toMoveIndex ) ;

		giveInventorySlot ( playerid, moveInventory, toMoveIndex ) ;
		giveInventorySlot ( playerid, toInventory, fromMoveIndex ) ;
	}
	else
	{
		clear_inventory_slot ( playerid, draggedItem, draggedItemCount, fromMoveIndex ) ;
		giveInventorySlot ( playerid, moveInventory, toMoveIndex ) ;
	}
	return 1 ;
}

