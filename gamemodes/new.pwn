					Каждая лицензия имеет свой срок действия, его нужно обновлять. \
					Обновить можно теми же способами, что и получить. \
					Показать лицензии можно через радиальное меню или используя /lic. \
					Нажав на лицению в открывшимся окне тебе покажется более подробная информация о ней.",
					"Местный",
					"Понял"
				) ;

				save_user_education ( playerid, EDUCATION_LICENSES ) ;
			}
			return 1 ;
		}
		case 331..367:
		{
		    new _weap_id = -1 ;
			if ( invItem == 331 ) _weap_id = 1 ;
			else if ( invItem == 333 ) _weap_id = 2 ;
			else if ( invItem == 334 ) _weap_id = 3 ;
			else if ( invItem == 335 ) _weap_id = 4 ;
			else if ( invItem == 336 ) _weap_id = 5 ;
			else if ( invItem == 337 ) _weap_id = 6 ;
			else if ( invItem == 338 ) _weap_id = 7 ;
			else if ( invItem == 339 ) _weap_id = 8 ;
			else if ( invItem == 341 ) _weap_id = 9 ;
			else if ( invItem == 321 ) _weap_id = 10 ;
			else if ( invItem == 322 ) _weap_id = 11 ;
			else if ( invItem == 323 ) _weap_id = 12 ;
			else if ( invItem == 324 ) _weap_id = 13 ;
			else if ( invItem == 325 ) _weap_id = 14 ;
			else if ( invItem == 326 ) _weap_id = 15 ;
			else if ( invItem == 342 ) _weap_id = 16 ;
			else if ( invItem == 343 ) _weap_id = 17 ;
			else if ( invItem == 346 ) _weap_id = 22 ;
			else if ( invItem == 347 ) _weap_id = 23 ;
			else if ( invItem == 348 ) _weap_id = 24 ;
			else if ( invItem == 349 ) _weap_id = 25 ;
			else if ( invItem == 350 ) _weap_id = 26 ;
			else if ( invItem == 351 ) _weap_id = 27 ;
			else if ( invItem == 352 ) _weap_id = 28 ;
			else if ( invItem == 353 ) _weap_id = 29 ;
			else if ( invItem == 355 ) _weap_id = 30 ;
			else if ( invItem == 356 ) _weap_id = 31 ;
			else if ( invItem == 372 ) _weap_id = 32 ;
			else if ( invItem == 357 ) _weap_id = 33 ;
			else if ( invItem == 358 ) _weap_id = 34 ;
			else if ( invItem == 359 ) _weap_id = 35 ;
			else if ( invItem == 360 ) _weap_id = 36 ;
			else if ( invItem == 361 ) _weap_id = 37 ;
			else if ( invItem == 362 ) _weap_id = 38 ;
			else if ( invItem == 363 ) _weap_id = 39 ;
			else if ( invItem == 364 ) _weap_id = 40 ;
			else if ( invItem == 365 ) _weap_id = 41 ;
			else if ( invItem == 366 ) _weap_id = 42 ;
			else if ( invItem == 367 ) _weap_id = 43 ;
			if ( _weap_id == -1 ) return 1 ;

			give_weapon ( playerid, _weap_id, 1 ) ;
			clear_inventory_slot ( playerid, invItem, 1, slotId ) ;
		    return 1 ;
		}
		case 400..611:
		{
      		callback_veh_count ( playerid, invItem ) ;
			return 1 ;
		}
		case 0..300:
		{
		    set_skin ( playerid, invItem ) ;

			new line_string [ 80 ] ;
			global_string [ 0 ] = EOS ;
			strcat ( global_string, "{"#cBL"}Выберите слот одежды\n" ) ;
			for ( new j = 0 ; j < 5 ; j ++ )
			{
				if ( p_info [ playerid ] [ temp_skin ] [ j ] == 0 )
				{
					strcat ( global_string, "{"#cGRDialog"}- Пусто\n" ) ;
				}
				else
				{
					format ( line_string, sizeof line_string, "{ffffff}Одежда '%s' (%d)\n", get_skin_name ( p_info [ playerid ] [ temp_skin ] [ j ] ), p_info [ playerid ] [ temp_skin ] [ j ] ) ;
					strcat ( global_string, line_string ) ;
				}
			}
			show_dialog ( playerid, d_donate_skin_list, DIALOG_STYLE_LIST, "{"#cBHD"}Гардероб", global_string, "Выбрать", "" ) ;

			clear_inventory_slot ( playerid, invItem, 1, slotId ) ;
			return 1 ;
		}
		case 1083: give_inventory ( playerid, 1083, 1, 0, "", "", NUMBERPLATE_TYPE_NONE, 0 ) ;
		case 1242: set_armour ( playerid, 25 ) ;
		case 1243: set_armour ( playerid, 60 ) ;
		case 1244: set_armour ( playerid, 100 ) ;
		case 3200..3400:
		{
            callback_veh_count ( playerid, invItem ) ;
			return 1 ;
		}
		case 11746:
		{
			#if defined m_prison
				if ( used_key_prison [ playerid ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы уже взяли ключ в руки! Можете открыть дверь." ) ;

				used_key_prison [ playerid ] = true ;
			#endif
		}
		case 905, 19941, 1463, 2684, 1080, 1018, 1038, 1140, 1165, 19773: return 1 ;
		default:
		{
		    if ( GetString ( get_accessorie_name ( invItem ), "Unknown" ) )
		    {
		        SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Произошла ошибка с предметом." ) ;
		        SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Пожалуйста, сообщите о проблеме в тех. поддержку проекта {"#cRInfo"}"vk_group_technical"{"#cGRInfo"}." ) ;
		        SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Заранее благодарим Вас за содействие." ) ;
		        return 1 ;
		    }

			clear_inventory_slot ( playerid, invItem, 1, slotId ) ;
			give_inventory ( playerid, invItem, 1, 0, "", "", NUMBERPLATE_TYPE_NONE, 0 ) ;

			SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы активировали аксессуар. Управление доступно в панели аксессуаров." ) ;
		    return 1 ;
		}
	}

	clear_inventory_slot ( playerid, invItem, 1, slotId ) ;

	global_string [ 0 ] = EOS ;
	new line_string [ 68 ] ;

	strcat ( global_string, "{"#cBL"}Содержимое подарка:\n\n{"#cGRDialog"}" ) ;
    if ( invItem >= 47 && invItem <= 49 ) format ( line_string, sizeof line_string, "%s на %d час(ов)\n", item_name ( invItem ), _random_mp ) ;
    else format ( line_string, sizeof line_string, "%s\n", item_name ( invItem ) ) ;
	strcat ( global_string, line_string ) ;

	show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Подарочный инвентарь", global_string, "Закрыть", "" ) ;
	return 1 ;
}

stock callback_veh_count ( playerid, prize_type )
{
	if ( get_player_veh_count ( playerid ) >= p_info [ playerid ] [ max_veh ] )
	{
		if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Для начала нужно продать одно из имеющихся транспортных средств!", 0, 3, CINFO_OTHER_ID, PICTURE_INFO_ERROR, "", "" ) ;
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Для начала нужно продать одно из имеющихся транспортных средств." ) ;
		return 1 ;
	}

	new delete_prize ;
	switch ( prize_type )
	{
	    case 10: delete_prize = prize_type, prize_type = 400 ;
		case 11: delete_prize = prize_type, prize_type = 439 ;
		case 12: delete_prize = prize_type, prize_type = 522 ;
		case 13: delete_prize = prize_type, prize_type = 446 ;
		case 14: delete_prize = prize_type, prize_type = 493 ;
	    case 66: delete_prize = prize_type, prize_type = 559 ;
		case 67: delete_prize = prize_type, prize_type = 550 ;
		case 68: delete_prize = prize_type, prize_type = 502 ;
		case 69: delete_prize = prize_type, prize_type = 412 ;
		case 70: delete_prize = prize_type, prize_type = 494 ;
		case 71: delete_prize = prize_type, prize_type = 451 ;
		default: delete_prize = prize_type ;
	}

	veh_prise_create ( playerid, 0, prize_type ) ;
	clear_inventory ( playerid, delete_prize, 1 ) ;

	global_string [ 0 ] = EOS ;
	new line_string [ 68 ] ;

	strcat ( global_string, "{"#cBL"}Содержимое подарка:\n\n{"#cGRDialog"}" ) ;
    format ( line_string, sizeof line_string, "%s\n", item_name ( prize_type ) ) ;
	strcat ( global_string, line_string ) ;

	show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Подарочный инвентарь", global_string, "Закрыть", "" ) ;
	return 1 ;
}

CMD:recorder ( playerid )
{
	if ( ! GetInventoryFindItem ( playerid, SUB_INVENTORY, 2256 ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет магнитофона, приобретите его в магазине 24/7." ) ;
	if ( p_info [ playerid ] [ hour_played ] < THREE_HOUR_PLAYED ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Доступно с 3 часов в игре. Используйте /mm - Информация о персонаже - Статистика персонажа." ) ;
	if ( p_info [ playerid ] [ jailed ] > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нельзя использовать в тюрьме." ) ;
	if ( p_info [ playerid ] [ mute ] )
	{
		new _t_string [ 38 ] ;
		format ( _t_string, sizeof ( _t_string ),"У Вас бан чата | %d секунд(ы)", p_info [ playerid ] [ mute ] ) ;
		SendClientMessage ( playerid, col_light_red, _t_string ) ;
		return 1 ;
	}

	SetAddRecorder ( playerid ) ;
	return 1 ;
}

stock SetAddRecorder ( playerid )
{
    if ( Iter_Count(box_player) >= MAX_BOOMBOXES - 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}В данный момент установить нельзя." ), -1 ;
	if ( boombox_player [ playerid ] [ b_status ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы уже установили магнитофон." ), -1 ;

    for ( new j = 0 ; j < MAX_DM_ZONE ; j ++ )
	{
		if ( ! IsPlayerInQuad ( playerid, anti_dm_pos [ j ] [ 0 ], anti_dm_pos [ j ] [ 1 ], anti_dm_pos [ j ] [ 2 ], anti_dm_pos [ j ] [ 3 ] ) ) continue ;

		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Запрещено устанавливать магнитофон в зелёной зоне." ) ;
		return -1 ;
	}

	GetPlayerPos(playerid, boombox_player [ playerid ] [ b_pos ] [ 0 ], boombox_player [ playerid ] [ b_pos ] [ 1 ], boombox_player [ playerid ] [ b_pos ] [ 2 ] ) ;

	new bool: find_boombox = false ;
	foreach(new i: streamed_players[playerid])
	{
		if ( ! boombox_player [ playerid ] [ b_status ] ) continue ;

		find_boombox = true ;
		break ;
	}

	if ( find_boombox == true ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Уже кто-то установил магнитофон." ), -1 ;

	boombox_player [ playerid ] [ b_object ] = CreateDynamicObject ( jbl_object, boombox_player [ playerid ] [ b_pos ] [ 0 ],
																		boombox_player [ playerid ] [ b_pos ] [ 1 ],
																		boombox_player [ playerid ] [ b_pos ] [ 2 ] + 0.3, 0.0, 0.0, 0.0, GetPlayerVirtualWorld ( playerid ), GetPlayerInterior ( playerid ) ) ;

    new box_text [ 86 + MAX_PLAYER_NAME ] ;
	format ( box_text, sizeof box_text, "** Установил %s **\n\n{"#cWH3D"}/setrecorder - Поставить песню\n/drecorder - Убрать", p_info [ playerid ] [ name ] ) ;
    boombox_player [ playerid ] [ b_text ] = CreateDynamic3DTextLabel ( box_text, col_header_3d, boombox_player [ playerid ] [ b_pos ] [ 0 ],
																						boombox_player [ playerid ] [ b_pos ] [ 1 ],
																						boombox_player [ playerid ] [ b_pos ] [ 2 ] + 0.6, 5.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, GetPlayerVirtualWorld ( playerid ), GetPlayerInterior ( playerid ) ) ;

	boombox_player [ playerid ] [ b_area ] = CreateDynamicSphere ( boombox_player [ playerid ] [ b_pos ] [ 0 ],
																boombox_player [ playerid ] [ b_pos ] [ 1 ],
																boombox_player [ playerid ] [ b_pos ] [ 2 ], 15.0, GetPlayerVirtualWorld ( playerid ), GetPlayerInterior ( playerid ) ) ;
	area_info [ boombox_player [ playerid ] [ b_area ] ] [ a_type ] = area_type_boombox ;

	ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.0, 0, 0, 0, 0, 0);

	boombox_player [ playerid ] [ b_status ] = true ;
	Iter_Add(box_player, playerid);
	return 1 ;
}

CMD:setrecorder ( playerid )
{
	if ( ! boombox_player [ playerid ] [ b_status ] && g_aStreamSources [ playerid ] [ eStreamID ] == -1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Магнитофон не установлен." ) ;

	if ( player_device { playerid } == 2 )
	{
		if ( ! IsPlayerInRangeOfPoint ( playerid, 3.0, boombox_player [ playerid ] [ b_pos ] [ 0 ], boombox_player [ playerid ] [ b_pos ] [ 1 ], boombox_player [ playerid ] [ b_pos ] [ 2 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не около магнитофона." ) ;
		show_dialog ( playerid, d_recorder, DIALOG_STYLE_LIST, "{"#cBHD"}Магнитофон", "{"#cBL"}1. {"#cWH"}Радио", "Выбор", "Выход" ) ;
		return 1 ;
	}
	if ( ! IsPlayerInRangeOfPoint ( playerid, 3.0, boombox_player [ playerid ] [ b_pos ] [ 0 ], boombox_player [ playerid ] [ b_pos ] [ 1 ], boombox_player [ playerid ] [ b_pos ] [ 2 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не около магнитофона." ) ;
	show_dialog ( playerid, d_recorder, DIALOG_STYLE_LIST, "{"#cBHD"}Магнитофон", "{"#cBL"}1. {"#cWH"}Радио", "Выбор", "Выход" ) ;
	return 1 ;
}

CMD:drecorder ( playerid, params [ ] )
{
	if ( ! boombox_player [ playerid ] [ b_status ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не ставили магнитофон." ) ;
	DestroyRecorder ( playerid ) ;
	return 1 ;
}

stock DestroyRecorder ( playerid )
{
	if ( g_aStreamSources [ playerid ] [ eStreamType ] == TOVEHICLE )
	{
		new vehicleId = g_aStreamSources [ playerid ] [ eStreamAttach ] ;
		veh_info [ vehicleId - 1 ] [ v_sound ] = INVALID_PLAYER_ID ;
	}

	if ( g_aStreamSources [ playerid ] [ eStreamID ] != -1 )
	{
	    if ( g_aStreamSources [ playerid ] [ eStreamID ] == playerid )
	    {
	        foreach(new i: logged_players)
	        {
	            if ( g_aStreamSources [ i ] [ eStreamID ] == playerid )
	            {
	                DestroyStreamSource ( i, playerid ) ;
	            }
	        }
	    }
	    else
	    {
	        DestroyStreamSource ( playerid, g_aStreamSources [ playerid ] [ eStreamID ] ) ;
	    }
	}

	g_aStreamSources [ playerid ] [ eStreamID ] = -1 ;

	if ( IsValidDynamicObject ( boombox_player [ playerid ] [ b_object ] ) ) DestroyDynamicObject ( boombox_player [ playerid ] [ b_object ] ) ;
	if ( boombox_player [ playerid ] [ b_status ] )
	{
		Iter_Remove(box_player, playerid);
		boombox_player [ playerid ] [ b_status ] = false ;
		DestroyDynamicArea ( boombox_player [ playerid ] [ b_area ] ) ;
	}

	if ( IsValidDynamic3DTextLabel ( boombox_player [ playerid ] [ b_text ] ) )
	{
		DestroyDynamic3DTextLabel ( boombox_player [ playerid ] [ b_text ] ) ;
		boombox_player [ playerid ] [ b_text ] = Text3D:INVALID_3DTEXT_ID ;
	}
	return 1 ;
}

stock StopStream ( playerid )
{
	DeletePVar ( playerid, "pAudioStream" ) ;
	StopAudioStreamForPlayer ( playerid ) ;
}

stock PlayStream ( playerid, url[], Float: posX = 0.0, Float: posY = 0.0, Float: posZ = 0.0, Float: distance = 50.0, usepos = 0 )
{
	if ( GetPVarType ( playerid, #pAudioStream ) ) StopAudioStreamForPlayer ( playerid ) ;
	else SetPVarInt ( playerid, #pAudioStream, 1 ) ;
	PlayAudioStreamForPlayer ( playerid, url, posX, posY, posZ, distance, usepos ) ;
}

