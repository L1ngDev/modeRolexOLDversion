	format ( scm_string, sizeof scm_string, "UPDATE `houses` SET `h_garden_position_x` = '%.2f', `h_garden_position_y` = '%.2f', `h_garden_position_z` = '%.2f',`h_garden_position_c` = '%.2f',`h_garden` = '%d' WHERE `h_id` = '%d' LIMIT 1",
	h_info [ params [ 0 ] - 1 ] [ h_garden_position ] [ 0 ], h_info [ params [ 0 ] - 1 ] [ h_garden_position ] [ 1 ], h_info [ params [ 0 ] - 1 ] [ h_garden_position ] [ 2 ],
	h_info [ params [ 0 ] - 1 ] [ h_garden_position ] [ 3 ], h_info [ params [ 0 ] - 1 ] [ h_garden ], params [ 0 ] ) ;
