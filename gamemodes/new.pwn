stock toggle_engine ( playerid, _veh_id )
{
	if ( GetPlayerState ( playerid ) != PLAYER_STATE_DRIVER ) return 1 ;

    /*new	Float:veh_health ;

	GetVehicleHealth ( _veh_id, veh_health ) ;
	if ( veh_health < 350 )
	{
		SendClientMessage ( playerid, col_gray, !"* Транспорт сильно повреждён, запустить двигатель не удалось!" ) ;
		return 1 ;
	}*/

	new engine, lights, alarm, doors, bonnet, boot, objective ;
	GetVehicleParamsEx ( _veh_id, engine, lights, alarm, doors, bonnet, boot, objective ) ;

	if ( engine == VEHICLE_PARAMS_UNSET || engine == VEHICLE_PARAMS_OFF )
	{
		if ( veh_info [ _veh_id - 1 ] [ v_fuel ] < 1 )
		{
	  	    SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте {"#cRInfo"}/gps - Найти ближайшую заправку{"#cGRInfo"}, чтобы купить канистру." ) ;
	  	    SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте {"#cRInfo"}/service{"#cGRInfo"} или {"#cRInfo"}/dir{"#cGRInfo"} для вызова механика." ) ;
			if ( GetInventoryFindItem ( playerid, SUB_INVENTORY, 2157 ) > 0 ) SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}У Вас есть канистра! Введите {"#cGN"}/fuelcar{"#cWH"}, чтобы использовать." ) ;
			return SetVehicleParamsEx ( _veh_id, VEHICLE_PARAMS_OFF, lights, alarm, doors, bonnet, boot, objective ) ;
		}
		else SetVehicleParamsEx ( _veh_id, VEHICLE_PARAMS_ON, lights, alarm, doors, bonnet, boot, objective ) ;
		me_action( playerid, "завел(а) двигатель" ) ;

		if ( player_device { playerid } != 2 )
		{
			PlayerTextDrawHide ( playerid, ptd_sp [ playerid ] [ 2 ] ) ;
			PlayerTextDrawColor ( playerid, ptd_sp [ playerid ] [ 2 ], 8388863 ) ;
			PlayerTextDrawShow ( playerid, ptd_sp [ playerid ] [ 2 ] ) ;
		}
	}
	else
	{
		SetVehicleParamsEx ( _veh_id, VEHICLE_PARAMS_OFF, lights, alarm, doors, bonnet, boot, objective ) ;
		me_action( playerid, "заглушил(а) двигатель" ) ;

    	if ( player_device { playerid } != 2 )
		{
			PlayerTextDrawHide ( playerid, ptd_sp [ playerid ] [ 2 ] ) ;
			PlayerTextDrawColor ( playerid, ptd_sp [ playerid ] [ 2 ], -1523963137 ) ;
			PlayerTextDrawShow ( playerid, ptd_sp [ playerid ] [ 2 ] ) ;
		}
	}
	return 1 ;
}

stock toggle_lights ( playerid, _veh_id )
{
	new engine, lights, alarm, doors, bonnet, boot, objective ;
	GetVehicleParamsEx ( _veh_id, engine, lights, alarm, doors, bonnet, boot, objective ) ;

    if ( GetPlayerState ( playerid ) != PLAYER_STATE_DRIVER ) return 1 ;
    if ( lights == VEHICLE_PARAMS_UNSET || lights == VEHICLE_PARAMS_OFF )
	{
	    SetVehicleParamsEx ( _veh_id, engine, VEHICLE_PARAMS_ON, alarm, doors, bonnet, boot, objective ) ;

		if ( player_device { playerid } != 2 )
		{
			PlayerTextDrawHide ( playerid, ptd_sp [ playerid ] [ 3 ] ) ;
			PlayerTextDrawColor ( playerid, ptd_sp [ playerid ] [ 3 ], 8388863 ) ;
			PlayerTextDrawShow ( playerid, ptd_sp [ playerid ] [ 3 ] ) ;
		}
	}
	else
	{
	    SetVehicleParamsEx ( _veh_id, engine, VEHICLE_PARAMS_OFF, alarm, doors, bonnet, boot, objective ) ;

		if ( player_device { playerid } != 2 )
		{
			PlayerTextDrawHide ( playerid, ptd_sp [ playerid ] [ 3 ] ) ;
			PlayerTextDrawColor ( playerid, ptd_sp [ playerid ] [ 3 ], -1 ) ;
			PlayerTextDrawShow ( playerid, ptd_sp [ playerid ] [ 3 ] ) ;
		}
	}
	return 1 ;
}

stock toggle_locked ( playerid, _veh_id, type = 0 )
{
	if ( type == 1 )
	{
	    new engine, lights, alarm, doors, bonnet, boot, objective ;

		veh_info [ _veh_id - 1 ] [ v_locked ] = false ;
		GetVehicleParamsEx ( _veh_id, engine, lights, alarm, doors, bonnet, boot, objective ) ;
		SetVehicleParamsEx ( _veh_id, engine, lights, alarm, false, bonnet, boot, objective ) ;

		if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Вы открыли транспорт!", 0, 3, CINFO_OTHER_ID, PICTURE_INFO_SUCESS, "", "" ) ;
		else GameTextForPlayer ( playerid,"~n~~n~~n~~n~~n~~n~~n~~n~~g~ CAR UNLOCK", 3000, 3 ) ;
		me_action ( playerid, "открыл(а) транспорт" ) ;

		if ( GetPlayerState ( playerid ) == PLAYER_STATE_DRIVER )
		{
			if ( player_device { playerid } != 2 )
			{
				PlayerTextDrawHide ( playerid, ptd_sp [ playerid ] [ 4 ] ) ;
				PlayerTextDrawColor ( playerid, ptd_sp [ playerid ] [ 4 ], 8388863 ) ;
				PlayerTextDrawShow ( playerid, ptd_sp [ playerid ] [ 4 ] ) ;
			}
		}
	    return 1 ;
	}
	else if ( type == 2 )
	{
	    new engine, lights, alarm, doors, bonnet, boot, objective ;

		veh_info [ _veh_id - 1 ] [ v_locked ] = true ;
		GetVehicleParamsEx ( _veh_id, engine, lights, alarm, doors, bonnet, boot, objective ) ;
		SetVehicleParamsEx ( _veh_id, engine, lights, alarm, true, bonnet, boot, objective ) ;

		if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Вы закрыли транспорт!", 0, 3, CINFO_OTHER_ID, PICTURE_INFO_SUCESS, "", "" ) ;
		else GameTextForPlayer ( playerid,"~n~~n~~n~~n~~n~~n~~n~~n~~r~ CAR LOCK", 3000, 3 ) ;
		me_action ( playerid, "закрыл(а) транспорт" ) ;

        if ( GetPlayerState ( playerid ) == PLAYER_STATE_DRIVER )
		{
			if ( player_device { playerid } != 2 )
			{
				PlayerTextDrawHide ( playerid, ptd_sp [ playerid ] [ 4 ] ) ;
				PlayerTextDrawColor ( playerid, ptd_sp [ playerid ] [ 4 ], -1523963137 ) ;
				PlayerTextDrawShow ( playerid, ptd_sp [ playerid ] [ 4 ] ) ;
			}
		}
	    return 1 ;
	}

    if ( veh_info [ _veh_id - 1 ] [ v_locked ] )
	{
   		new engine, lights, alarm, doors, bonnet, boot, objective ;

		veh_info [ _veh_id - 1 ] [ v_locked ] = false ;
		GetVehicleParamsEx ( _veh_id, engine, lights, alarm, doors, bonnet, boot, objective ) ;
		SetVehicleParamsEx ( _veh_id, engine, lights, alarm, false, bonnet, boot, objective ) ;

		if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Вы открыли транспорт!", 0, 3, CINFO_OTHER_ID, PICTURE_INFO_SUCESS, "", "" ) ;
		else GameTextForPlayer ( playerid,"~n~~n~~n~~n~~n~~n~~n~~n~~g~ CAR UNLOCK", 3000, 3 ) ;
		me_action ( playerid, "открыл(а) транспорт" ) ;

        if ( GetPlayerState ( playerid ) == PLAYER_STATE_DRIVER )
		{
			if ( player_device { playerid } != 2 )
			{
				PlayerTextDrawHide ( playerid, ptd_sp [ playerid ] [ 4 ] ) ;
				PlayerTextDrawColor ( playerid, ptd_sp [ playerid ] [ 4 ], 8388863 ) ;
				PlayerTextDrawShow ( playerid, ptd_sp [ playerid ] [ 4 ] ) ;
			}
		}
	}
	else
	{
		new engine, lights, alarm, doors, bonnet, boot, objective ;

		veh_info [ _veh_id - 1 ] [ v_locked ] = true ;
		GetVehicleParamsEx ( _veh_id, engine, lights, alarm, doors, bonnet, boot, objective ) ;
		SetVehicleParamsEx ( _veh_id, engine, lights, alarm, true, bonnet, boot, objective ) ;

		if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Вы закрыли транспорт!", 0, 3, CINFO_OTHER_ID, PICTURE_INFO_SUCESS, "", "" ) ;
		else GameTextForPlayer ( playerid,"~n~~n~~n~~n~~n~~n~~n~~n~~r~ CAR LOCK", 3000, 3 ) ;
		me_action ( playerid, "закрыл(а) транспорт" ) ;

        if ( GetPlayerState ( playerid ) == PLAYER_STATE_DRIVER )
		{
			if ( player_device { playerid } != 2 )
			{
				PlayerTextDrawHide ( playerid, ptd_sp [ playerid ] [ 4 ] ) ;
				PlayerTextDrawColor ( playerid, ptd_sp [ playerid ] [ 4 ], -1523963137 ) ;
				PlayerTextDrawShow ( playerid, ptd_sp [ playerid ] [ 4 ] ) ;
			}
		}
	}
	return 1 ;
}

stock memset(array[], value, size = sizeof(array))
{
    if(!size)
    {
        print("memset: Не указан размер массива" ) ;

        /*
        //размер массива
        #emit ADDR.pri array
        #emit ADD.c 4
        #emit PUSH.pri
        #emit SHL.C.pri 2

        //вызов заного
        #emit LREF.S.alt value
        #emit LCTRL 1
        #emit POP.alt
        #emit JZER
        #emit CALL.pri
        */

        return 0;
    }

    new phys_addr;

    #emit LOAD.S.pri array
    #emit STOR.S.pri phys_addr

    /*return */memfill_byaddr(phys_addr, value, size ) ;
}

stock memfill_byaddr(address, cellsize, value)
{
    new idx;

    #emit LCTRL       6
    #emit MOVE.alt
    #emit LCTRL       0

    #emit ADD
    #emit MOVE.alt

    #emit LCTRL       1
    #emit SUB.alt
    #emit ADD.C       92

    #emit STOR.S.pri  idx
    #emit LOAD.S.pri  cellsize
    #emit SHL.C.pri   2
    #emit SREF.S.pri  idx

    #emit LOAD.S.alt  address
    #emit LOAD.S.pri  value
    #emit FILL        0
}

