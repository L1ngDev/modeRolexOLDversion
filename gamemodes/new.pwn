stock checking_quest_progress ( playerid, quest_id, amount_plus, _type )
{
	if ( _type == 0 )
	{
		if ( quest_select [ playerid ] [ 0 ] != quest_id ) return 1 ;
		if ( quest_status [ playerid ] [ 0 ] == 1 )
		{
			quest_progress [ playerid ] [ 0 ] += amount_plus ;

			if ( quest_progress [ playerid ] [ 0 ] >= quest_progress_start [ quest_id ] )
			{
			    new scm_string [ 72 + ( 32 * 2 ) ] ;
			    if ( quest_id == MAX_QUESTS - 1 )
			    {
			        format ( scm_string, sizeof scm_string, "Задание успешно выполнено. Ваша награда: {"#cWH"}%s{"#cSucces"}.", quest_info [ quest_id ] [ q_rewards ] ) ;
					SendClientMessage ( playerid, col_succes, scm_string ) ;

					SendClientMessage ( playerid, col_succes, !"Вы завершили 'начальную' квестовую линию. Отправляйтесь к одному из помощников, чтобы получить своё вознаграждение." ) ;
			    }
			    else
			    {
					format ( scm_string, sizeof scm_string, "Задание успешно выполнено. Ваша награда: {"#cWH"}%s{"#cSucces"}.", quest_info [ quest_id ] [ q_rewards ] ) ;
					SendClientMessage ( playerid, col_succes, scm_string ) ;

				    format ( scm_string, sizeof scm_string, "Следующее задание: {"#cWH"}%s{"#cSucces"}.", quest_info [ quest_id + 1 ] [ q_name ] ) ;
					SendClientMessage ( playerid, col_succes, scm_string ) ;

					new _id = p_info [ playerid ] [ start_quest_id ] ;
					if ( _id != -1 )
			    		SetPlayerRaceCheckpoint ( playerid, 1, quest_actor [ _id ] [ actor_pos ] [ 0 ], quest_actor [ _id ] [ actor_pos ] [ 1 ], quest_actor [ _id ] [ actor_pos ] [ 2 ], 0.0, 0.0, 0.0, 2.0 ) ;

					SendClientMessage ( playerid, col_succes, !"Отправляйтесь к одному из помощников, чтобы получить своё вознаграждение." ) ;
			    }

				quest_status [ playerid ] [ 0 ] = 2 ;
				update_quest_data ( playerid ) ;
			}
			else
			{
				update_quest_data ( playerid ) ;
			}
		}
	}
	else if ( _type == 1 )
	{
		if ( quest_select [ playerid ] [ 1 ] != quest_id ) return 1 ;
		if ( quest_status [ playerid ] [ 1 ] == 1 )
		{
			quest_progress [ playerid ] [ 1 ] += amount_plus ;

			if ( quest_progress [ playerid ] [ 1 ] >= quest_progress_medium [ quest_id ] )
			{
			    new scm_string [ 72 + ( 32 * 2 ) ] ;
			    if ( quest_id == MAX_QUESTS - 1 )
			    {
			        format ( scm_string, sizeof scm_string, "Задание успешно выполнено. Ваша награда: {"#cWH"}%s{"#cSucces"}.", quest_info_2 [ quest_id ] [ q_rewards ] ) ;
					SendClientMessage ( playerid, col_succes, scm_string ) ;
				}
			    else
			    {
					format ( scm_string, sizeof scm_string, "Задание успешно выполнено. Ваша награда: {"#cWH"}%s{"#cSucces"}.", quest_info_2 [ quest_id ] [ q_rewards ] ) ;
					SendClientMessage ( playerid, col_succes, scm_string ) ;

				    format ( scm_string, sizeof scm_string, "Следующее задание: {"#cWH"}%s{"#cSucces"}.", quest_info_2 [ quest_id + 1 ] [ q_name ] ) ;
					SendClientMessage ( playerid, col_succes, scm_string ) ;

					is_gps_used { playerid } = 1 ;
				    SetPlayerRaceCheckpoint ( playerid, 1, 1815.0227, 2524.3146, 15.8020, 0.0, 0.0, 0.0, 2.0 ) ;

					SendClientMessage ( playerid, col_succes, !"Отправляйтесь к одному из помощников, чтобы получить своё вознаграждение." ) ;
			    }

				quest_status [ playerid ] [ 1 ] = 2 ;
				update_quest_data ( playerid ) ;
			}
			else
			{
				update_quest_data ( playerid ) ;
			}
		}
	}
	else if ( _type == 2 )
	{
		if ( quest_select [ playerid ] [ 2 ] != quest_id ) return 1 ;
		if ( quest_status [ playerid ] [ 2 ] == 1 )
		{
			quest_progress [ playerid ] [ 2 ] += amount_plus ;

			if ( quest_progress [ playerid ] [ 2 ] >= quest_progress_high [ quest_id ] )
			{
			    new scm_string [ 72 + ( 32 * 2 ) ] ;
			    if ( quest_id == MAX_QUESTS - 1 )
			    {
			        format ( scm_string, sizeof scm_string, "Задание успешно выполнено. Ваша награда: {"#cWH"}%s{"#cSucces"}.", quest_info_3 [ quest_id ] [ q_rewards ] ) ;
					SendClientMessage ( playerid, col_succes, scm_string ) ;
				}
			    else
			    {
			        format ( scm_string, sizeof scm_string, "Задание успешно выполнено. Ваша награда: {"#cWH"}%s{"#cSucces"}.", quest_info_3 [ quest_id ] [ q_rewards ] ) ;
					SendClientMessage ( playerid, col_succes, scm_string ) ;

				    format ( scm_string, sizeof scm_string, "Следующее задание: {"#cWH"}%s{"#cSucces"}.", quest_info_3 [ quest_id + 1 ] [ q_name ] ) ;
					SendClientMessage ( playerid, col_succes, scm_string ) ;

					is_gps_used { playerid } = 1 ;
				    SetPlayerRaceCheckpoint ( playerid, 1, 1815.0227, 2524.3146, 15.8020, 0.0, 0.0, 0.0, 2.0 ) ;

					SendClientMessage ( playerid, col_succes, !"Отправляйтесь к одному из помощников, чтобы получить своё вознаграждение." ) ;
			    }

				quest_status [ playerid ] [ 2 ] = 2 ;
				update_quest_data ( playerid ) ;
			}
			else
			{
				update_quest_data ( playerid ) ;
			}
		}
	}
	return 1 ;
}

