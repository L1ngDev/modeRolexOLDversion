		mysql_tquery ( sql_connection, query_string, "unban_callback", "is", playerid, params [ 0 ] ) ;
	}
	return 1 ;
}

CMD:veh ( playerid, params [ ] )
{
    if ( admin_info [ playerid ] [ admin ] < 4 && ! tester_admin [ playerid ] ) return 1 ;
	if ( GetPlayerState ( playerid ) == PLAYER_STATE_DRIVER ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы уже за рулём." ) ;
	if ( sscanf ( params, "ddd", params [ 0 ], params [ 1 ], params [ 2 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /veh [ид авто] [цвет 1] [цвет 2]" ) ;
	if ( ! tester_admin [ playerid ] && admin_info [ playerid ] [ dostup ] [ 1 ] != 1 && admin_info [ playerid ] [ admin ] < 7 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет доступа к данной команде. Используйте /donate." ) ;

    if ( params [ 0 ] == 406 || params [ 0 ] == 520 || params [ 0 ] == 449 || params [ 0 ] == 450 || params [ 0 ] == 537 || params [ 0 ] == 538 || params [ 0 ] == 569 || params [ 0 ] == 570 || params [ 0 ] == 590 || params [ 0 ] == 425 || params [ 0 ] == 432 ) return 1 ;

	if ( ! getValidReplacableModel ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /veh [ид авто] [цвет 1] [цвет 2]" ) ;
	if ( params [ 1 ] < 0 || params [ 1 ] > 255 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /veh [ид авто] [цвет 1] [цвет 2]" ) ;
	if ( params [ 2 ] < 0 || params [ 2 ] > 255 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /veh [ид авто] [цвет 1] [цвет 2]" ) ;

	if ( GetPVarInt ( playerid, "admin_vehicle" ) ) DestroyVehicle ( GetPVarInt ( playerid, "admin_vehicle" ), 13 ) ;
	new Float:player_pos [ 4 ], adm_veh ;
	GetPlayerPos ( playerid, player_pos [ 0 ], player_pos [ 1 ], player_pos [ 2 ] ) ;
	GetPlayerFacingAngle ( playerid, player_pos [ 3 ] ) ;
	if ( params [ 0 ] == 537 || params [ 0 ] == 538 ) adm_veh = AddStaticVehicleEx ( params [ 0 ], player_pos [ 0 ], player_pos [ 1 ], player_pos [ 2 ], player_pos [ 3 ], params [ 1 ], params [ 2 ], -1) ;
	else adm_veh = CreateVehicle ( params [ 0 ], player_pos [ 0 ], player_pos [ 1 ], player_pos [ 2 ], player_pos [ 3 ], params [ 1 ], params [ 2 ], -1) ;
	SetPVarInt ( playerid, "admin_vehicle", adm_veh ) ;
	veh_info [ adm_veh - 1 ] [ v_fuel ] = 60.0 ;

	new engine, lights, alarm, doors, bonnet, boot, objective ;
 	veh_info [ adm_veh - 1 ] [ v_locked ] = false ;
	GetVehicleParamsEx ( adm_veh, engine, lights, alarm, doors, bonnet, boot, objective ) ;
	SetVehicleParamsEx ( adm_veh, engine, false, alarm, false, bonnet, boot, objective ) ;

	LinkVehicleToInterior ( adm_veh, p_t_info [ playerid ] [ p_data ] [ 0 ] ) ;
	SetVehicleVirtualWorld ( adm_veh, p_t_info [ playerid ] [ p_data ] [ 1 ] ) ;
	PutPlayerInVehicle ( playerid, adm_veh, 0 ) ;
	SetPlayerArmedWeapon ( playerid, 0 ) ;

    create_speedometr ( playerid ) ;

	new scm_string [ 100 ] ;
	format ( scm_string, sizeof scm_string, "Администратор %s создал т/с %d", p_info [ playerid ] [ name ], params [ 0 ] ) ;
	WriteLog ( playerid, TYPE_LOG_ADMIN, scm_string ) ;
	return true ;
}

