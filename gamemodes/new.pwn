stock get_player_donate ( playerid, donate_value, type_value = 0 )
{
	new donate_count_money = 0 ;
	if ( type_value == 1 )
	{
		if ( p_info [ playerid ] [ donate_bonus ] < donate_value )
		{
            donate_count_money = donate_value - p_info [ playerid ] [ donate_bonus ] ;
            if ( p_info [ playerid ] [ donate ] < donate_count_money ) return 0 ;
            else return 1 ;
		}
		else return 1 ;
	}

	else if ( type_value == 2 )
	{
		if ( p_info [ playerid ] [ donate ] < donate_value ) return 0 ;
		else return 1 ;
	}

	return 1 ;
}

stock give_player_donate ( playerid, donate_value, type_value = 0 )
{
	if ( type_value == 1 )
	{
		p_info [ playerid ] [ donate_bonus ] += donate_value ;
		update_int_sql ( playerid, "u_donate_bonus", p_info [ playerid ] [ donate_bonus ] ) ;
	}

	else if ( type_value == 2 )
	{
		p_info [ playerid ] [ donate ] += donate_value ;
		update_donate_sql ( p_info [ playerid ] [ launcher ], donate_value, true ) ;
	}

	setUpdateBalance ( playerid, p_info [ playerid ] [ donate ] ) ;
	return 1 ;
}

stock set_player_donate ( playerid, donate_value, type_value = 0 )
{
	if ( type_value == 1 )
	{
		if ( p_info [ playerid ] [ donate_bonus ] < donate_value )
		{
			new donate_count_money = 0 ;
			donate_count_money = donate_value - p_info [ playerid ] [ donate_bonus ] ;
			if ( p_info [ playerid ] [ donate ] < donate_count_money ) return 0 ;
			else
			{
				p_info [ playerid ] [ donate_bonus ] = 0 ;
				p_info [ playerid ] [ donate ] -= donate_count_money ;

				update_int_sql ( playerid, "u_donate_bonus", 0 ) ;
				update_donate_sql ( p_info [ playerid ] [ launcher ], donate_count_money, false ) ;
				setUpdateBalance ( playerid, p_info [ playerid ] [ donate ] ) ;
				return 1 ;
			}
		}
		else
		{
			p_info [ playerid ] [ donate_bonus ] -= donate_value ;
			update_int_sql ( playerid, "u_donate_bonus", p_info [ playerid ] [ donate_bonus ] ) ;
			setUpdateBalance ( playerid, p_info [ playerid ] [ donate ] ) ;
			return 1 ;
		}
	}

	else if ( type_value == 2 )
	{
		if ( p_info [ playerid ] [ donate ] < donate_value ) return 0 ;
		else
		{
			p_info [ playerid ] [ donate ] -= donate_value ;
			update_donate_sql ( p_info [ playerid ] [ launcher ], donate_value, false ) ;

			if ( p_info [ playerid ] [ promo_used ] == 1 )
			{
				static const _str [ ] = "UPDATE `users` SET `u_donate_referal` = `u_donate_referal` + '%d' WHERE `u_id` = '%d' LIMIT 1" ;
				new query_string [ sizeof _str + ( 9 * 2 ) ] ;
				format ( query_string, sizeof query_string, _str, donate_value, p_info [ playerid ] [ id ] ) ;
				mysql_tquery ( sql_connection, query_string ) ;
			}
			setUpdateBalance ( playerid, p_info [ playerid ] [ donate ] ) ;
			return 1 ;
		}
	}

	return 1 ;
}

stock get_player_banned ( pl_name [ ] )
{
	new ban_days = 0, ban_count = 0, query_string [ 94 + 32 ] ;
	format ( query_string, sizeof query_string, "SELECT `u_b_days` FROM `users_bans` WHERE `u_b_name` = '%s' AND `u_b_date` > NOW( ) LIMIT 1", pl_name ) ;
 	new Cache:result = mysql_query ( sql_connection, query_string ) ;
 	ban_count = cache_num_rows ( ) ;
 	if ( ban_count ) ban_days = cache_get_field_content_int ( 0, "u_b_days", sql_connection ) ;
	cache_delete ( result ) ;
	return ban_days ;
}

