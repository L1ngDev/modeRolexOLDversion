			}

			new _b_type = b_info [ t ] [ b_type ] ;
		    if ( _b_type == bizz_type_fixcar )
			{
			    SetPVarInt ( playerid, "p_biz_id", t + 1 ) ;

			    static const _str [ ] = "SELECT `v_id`, `v_model` FROM `users_vehicles` WHERE `v_owner` = '%d' AND `v_fine` < '2' AND `v_sell_price` < '1' LIMIT %d" ;
			    new sql_string [ sizeof _str + 9 + 4 ] ;
				format ( sql_string, sizeof sql_string, _str, p_info [ playerid ] [ id ], p_info [ playerid ] [ max_veh ] ) ;
				mysql_tquery ( sql_connection, sql_string, "load_fine_vehicles", "i", playerid ) ;

				give_event_progress ( playerid, THE_TOWCAR, 1 ) ;
				return 1 ;
			}
			else if ( _b_type == bizz_type_carshop )
			{
			    SetPVarInt ( playerid, "p_biz_id", t + 1 ) ;

				show_dialog ( playerid, d_carshop_menu, DIALOG_STYLE_LIST, "{"#cBHD"}Авторынок", "{"#cBL"}1. {"#cWH"}Продажа\n{"#cBL"}2. {"#cWH"}Снятие с продажи", "Выбрать", "Закрыть" ) ;
				return 1 ;
			}
			else if ( _b_type == bizz_type_electric )
			{
			    show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Электростанция", "\
				{"#cWH"}Электростанция - это полностью пассивный тип бизнеса,\n\
				который отвечает за всю электросеть штата.\n\
				Если случаются перебои в электростанции, то случаются перебои в штате.\n\n\
				Электростанция берёт налогооблажение на имущество за предоставление услуг.", "Принять", "" ) ;
				return 1 ;
			}
			else if ( _b_type == bizz_type_lake )
			{
			    show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Рыбацкие угодья", "\
				{"#cWH"}Рыбацкие угодья - это полностью пассивный тип бизнеса,\n\
				который отвечает за комфортный отдых игроков на рыбалке.\n\n\
