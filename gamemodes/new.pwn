			format ( text_string, 128, "UPDATE `fractions_players` SET `u_subleader` = '%d' WHERE `u_sql_id` = '%d' LIMIT 1", p_info [ playerid ] [ subleader ], p_info [ playerid ] [ id ] ) ;
			mysql_tquery ( sql_connection, text_string ) ;

			unit_info [ _unit_id - 1 ] [ u_members ] ++ ;
			format ( text_string, 128, "UPDATE `unit_settings` SET `unit_members` = '%d' WHERE `unit_id` = '%d' LIMIT 1", unit_info [ _unit_id - 1 ] [ u_members ], sell_item [ pl_id ] ) ;
			mysql_tquery ( sql_connection, text_string ) ;

			clear_sell_params ( playerid, pl_id ) ;
			return 1 ;
		}
		case d_invite_box:
		{
			if ( ! response )
			{
				clear_sell_params ( playerid, seller_id [ playerid ] ) ;
				return 1 ;
			}

			new pl_id = seller_id [ playerid ] ;
			new frac_id = p_info [ pl_id ] [ member ] ;
			if ( frac_id < 0 )
			{
			    clear_sell_params ( playerid, pl_id ) ;
			    SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Произошла ошибка. Код ошибки: d_invite_box." ) ;
			    return 1 ;
			}

			new dialog_string [ 200 + ( 4 * 9 ) ] ;

			SendClientMessage ( playerid, col_wavy, !"Ожидайте, пока лидер/заместитель выберет для Вас одежду." ) ;

			p_info [ playerid ] [ member ] = frac_id ;
			p_info [ playerid ] [ rank ] = 1 ;
			day_invite_player [ frac_id - 1 ] += 1 ;

			new _skin_invite ;
			if ( f_info [ frac_id - 1 ] [ f_skin_type ] == 1 ) _skin_invite = f_skin_rank [ frac_id - 1 ] [ p_info [ playerid ] [ gender ] ] [ 0 ] ;
			else _skin_invite = f_skin_invite [ frac_id - 1 ] [ p_info [ playerid ] [ gender ] ] ;

			p_info [ playerid ] [ org_skin ] = _skin_invite ;
			SetPlayerSkin ( playerid, p_info [ playerid ] [ org_skin ] ) ;

			SetPlayerColor ( playerid, f_info [ frac_id - 1 ] [ f_radar_color ] ) ;

			p_info [ playerid ] [ spawnchange ] = 2 ;
			p_info [ playerid ] [ org_date ] = 0 ;

			Iter_Add ( fraction_players[frac_id], playerid ) ;
			fractionUserInsert ( playerid ) ;
			ResetFractionTasks ( playerid, true ) ;

			f_info [ frac_id - 1 ] [ f_members ] ++ ;
			format ( dialog_string, 100, "UPDATE `fractions` SET `f_members` = '%d' WHERE `f_id` = '%d' LIMIT 1", f_info [ frac_id - 1 ] [ f_members ], frac_id ) ;
			mysql_tquery ( sql_connection, dialog_string ) ;

			format ( dialog_string, sizeof ( dialog_string ), "{"#cGInfo"}* {"#cWH"}Вы успешно вступили в организацию \"%s\".", f_info [ frac_id - 1 ] [ f_name ] ) ;
			SendClientMessage ( playerid, col_white, dialog_string ) ;
			format ( dialog_string, sizeof( dialog_string ), "{"#cGInfo"}* {"#cWH"}Вы приняли в организацию игрока \"%s\".", p_info [ playerid ] [ name ]);
			SendClientMessage ( pl_id, col_white, dialog_string );

			if ( gang_player ( playerid ) || mafia_player ( playerid ) ) format ( dialog_string, 128, "[F] %s присоединился к организации (Пригласил: %s). Приветствуем!", p_info [ playerid ] [ name ], p_info [ pl_id ] [ name ] ) ;
			else format ( dialog_string, 128, "[R] %s присоединился к организации (Пригласил: %s). Приветствуем!", p_info [ playerid ] [ name ], p_info [ pl_id ] [ name ] ) ;
			fraction_message ( frac_id, col_lblue, dialog_string ) ;

			SendClientMessage ( playerid, col_wavy, !"Используйте {"#cWH"}/mm - Команды сервера {"#cWV"}для ознакомления с функционалом организации." ) ;

			insert_joblist ( playerid, "INVITE", LABOR_TYPE_INVITE ) ;

            format ( dialog_string, 128, "Принял(а) %s", p_info [ playerid ] [ name ] ) ;
			write_fraction ( pl_id, frac_id, TYPE_LOG_INVITE, dialog_string ) ;

			give_event_progress ( playerid, THE_FRACTION, 1 ) ;

			clear_sell_params ( playerid, pl_id ) ;
			return 1 ;
		}
		case d_set_fskin:
		{
