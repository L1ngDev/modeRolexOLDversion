	    case d_tr_health:
	    {
	        if ( ! response ) return show_training_menu ( playerid ) ;

	        new f = p_info [ playerid ] [ member ] - 1 ;
	        new _value = strval ( inputtext ) ;
	        if ( _value < 40 || _value > 160 )
	        {
		    	global_string [ 0 ] = EOS ;
				format(global_string, 450, "{"#cWH"}Вы собираетесь изменить следующую конфигурацию:\n\n\tОрганизация: {%s}%s\n\t{"#cWH"}Название: {"#cLY"}ХП при спавне на тренировке\n\t{"#cWH"}Текущее значение: {"#cLY"}%d\n\n{"#cGRDialog"}* Введите новое значение для данной конфигурации:", f_info [ f ] [ f_chat_color ], f_info [ f ] [ f_name ], f_info [ f ] [ f_tr_health ] );
				show_dialog(playerid, d_tr_health, DIALOG_STYLE_INPUT, "{"#cBHD"}Изменение конфигурации", global_string, "Выбрать", "Назад");

