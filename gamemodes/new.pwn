		RifaKyznica[5] = CreateDynamic3DTextLabel ( "** Пусто **", col_header_3d, -2169.2346, -265.9763, 37.9203, 50.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, -1, -1 ) ;
		CreateDynamicPickup ( 19607, 23, -2147.4714, -261.7650, 36.5156-2.7 ) ;*/

