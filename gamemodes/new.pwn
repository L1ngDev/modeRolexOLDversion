				if ( p_info [ playerid ] [ money ] < _price ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас недостаточно наличных для покупки." ) ;

				new bool: _sucess_product = false ;
				if ( b_info [ _b_id - 1 ] [ b_product ] < b_gun_shop [ listitem ] [ bs_product ] ) _sucess_product = true ;

