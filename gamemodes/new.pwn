			PlayerTextDrawSetString ( admin_id, td_td [ admin_id ] [ i ], temp ) ;

			p_t_info [ admin_id ] [ take_damage_box ] [ i ] = SetTimerEx ( "clear_td_td", 5000 * ( i + 1 ), false, "i", admin_id ) ;
		  	break ;
	    }
	    else
	    {
		    if ( p_t_info [ playerid ] [ take_damage_box ] [ i ] != -1 ) continue ;

		    p_t_info [ playerid ] [ take_damage_box_type ] [ i ] = targetid ;

		    if ( p_t_info [ playerid ] [ take_damage_box_type ] [ i ] != -1 )
		    {
			    for ( new j = 0 ; j < 4 ; j ++ )
			    {
			        if ( i == j ) continue ;

			        if ( p_t_info [ playerid ] [ take_damage_box_type ] [ i ] == p_t_info [ playerid ] [ take_damage_box_type ] [ j ] )
			        {
			            p_t_info [ playerid ] [ take_damage_box_type ] [ i ] = -1 ;

						p_t_info [ playerid ] [ t_amount ] [ j ] += d_amount ;
						p_t_info [ playerid ] [ t_weapon ] [ j ] = weapon_id ;

						new gun_name [ 24 ] ;
						GetWeaponName ( p_t_info [ playerid ] [ t_weapon ] [ j ], gun_name, sizeof ( gun_name ) ) ;

						new temp [ 64 ] ;
						format ( temp, sizeof temp, "~r~~h~%s~w~ / -%.1f ~r~~h~%s", take_damage_box_name [ playerid ] [ j ], p_t_info [ playerid ] [ t_amount ] [ j ], gun_name ) ;
						PlayerTextDrawSetString ( playerid, td_td [ playerid ] [ j ], temp ) ;

					    KillTimer ( p_t_info [ playerid ] [ take_damage_box ] [ j ] ) ;
					    p_t_info [ playerid ] [ take_damage_box ] [ j ] = -1 ;

					    p_t_info [ playerid ] [ take_damage_box ] [ j ] = SetTimerEx("clear_td_td", 5000 * ( j + 1 ), false, "i", playerid);
			            return 1 ;
			        }
			    }
			}

			damage_td_status ( playerid, i, 2 ) ;

			p_t_info [ playerid ] [ t_amount ] [ i ] += d_amount ;
			p_t_info [ playerid ] [ t_weapon ] [ i ] = weapon_id ;

			new gun_name [ 24 ] ;
			GetWeaponName ( p_t_info [ playerid ] [ t_weapon ] [ i ], gun_name, sizeof ( gun_name ) ) ;

			format ( take_damage_box_name [ playerid ] [ i ], MAX_PLAYER_NAME, "%s", p_info [ targetid ] [ name ] ) ;

			new temp [ 64 ] ;
			format ( temp, sizeof temp, "~r~~h~%s~w~ / -%.1f ~r~~h~%s", take_damage_box_name [ playerid ] [ i ], p_t_info [ playerid ] [ t_amount ] [ i ], gun_name ) ;
			PlayerTextDrawSetString ( playerid, td_td [ playerid ] [ i ], temp ) ;

