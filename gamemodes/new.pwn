CMD:gopolice ( playerid, params [ ] )
{
    if ( ! cop_player ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команда доступна только для гос. организаций." ) ;
	if ( ! is_fraction_duty { playerid } ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Не начат рабочий день." ) ;
	if ( sscanf ( params, "d", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /gopolice [id/имя]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете применить это к самому себе." ) ;

	if ( ! call_police { params [ 0 ] } ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Этот игрок не вызывал полицию либо его вызов уже приняли." ) ;

	new scm_string [ 108 ], fraction_id = p_info [ playerid ] [ member ] ;
	format ( scm_string, 108, "{"#cGN"}%s %s{"#cWH"} принял(а) ваш вызов, ожидайте.", f_rank [ fraction_id - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ] ) ;
	SendClientMessage ( params [ 0 ], col_white, scm_string ) ;
	format ( scm_string, 72, "{"#cGN"}%s{"#cWH"} отмечен(а) на Вашей карте.", p_info [ params [ 0 ] ] [ name ] ) ;
	SendClientMessage ( playerid, col_white, scm_string ) ;

	SetPlayerRaceCheckpoint ( playerid, 1, p_t_info [ params [ 0 ] ] [ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ] [ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ] [ p_pos ] [ 2 ], 0.0, 0.0, 0.0, 2.0 ) ;
	SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}[GPS] - Метка установлена." ) ;
	is_gps_used { playerid } = 1 ;

	call_police { params [ 0 ] } = 0 ;
	return 1 ;
}

CMD:gomedhelp ( playerid, params [ ] )
{
    if ( ! medic_player ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команда доступна только для сотрудников больницы." ) ;
	if ( sscanf ( params, "d", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /gomedhelp [id/имя]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете применить это к самому себе." ) ;

	if ( ! call_medic { params [ 0 ] } ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Этот игрок не вызывал скорую помощь либо его вызов уже приняли." ) ;

    new scm_string [ 108 ], fraction_id = p_info [ playerid ] [ member ] ;
	format ( scm_string, 108, "{"#cGN"}%s %s{"#cWH"} принял(а) ваш вызов, ожидайте.", f_rank [ fraction_id - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ] ) ;
	SendClientMessage ( params [ 0 ], col_white, scm_string ) ;
	format ( scm_string, 72, "{"#cGN"}%s{"#cWH"} отмечен(а) на Вашей карте.", p_info [ params [ 0 ] ] [ name ] ) ;
	SendClientMessage ( playerid, col_white, scm_string ) ;

	SetPlayerRaceCheckpoint ( playerid, 1, p_t_info [ params [ 0 ] ] [ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ] [ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ] [ p_pos ] [ 2 ], 0.0, 0.0, 0.0, 2.0 ) ;
	SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}[GPS] - Метка установлена." ) ;
	is_gps_used { playerid } = 1 ;

	#if defined m_fractions
		give_emp_progress ( playerid, 1, 1 ) ;
	#endif

	call_medic { params [ 0 ] } = 0 ;
	return 1 ;
}

CMD:gotaxi ( playerid, params [ ] )
{
    if ( p_info [ playerid ] [ job ] != job_taxi ) return 1 ;
	if ( sscanf ( params, "d", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /gotaxi [id/имя]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете применить это к самому себе." ) ;

	if ( ! call_taxi { params [ 0 ] } ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Этот игрок не вызывал такси либо его вызов уже приняли." ) ;

    new scm_string [ 128 ] ;
	format ( scm_string, 128, "* [TAXI] Таксист %s[%d] принял(а) вызов %s[%d].", p_info [ playerid ] [ name ], playerid, p_info [ params [ 0 ] ] [ name ], params [ 0 ] ) ;
	foreach(new i : logged_players)
	{
		if ( p_info [ i ] [ job ] == job_taxi && job_started [ i ] == true )
		{
			SendClientMessage ( i, color_job, scm_string ) ;
		}
	}
	format ( scm_string, 108, "{"#cGN"}Таксист %s(%d){"#cWH"} принял(а) ваш вызов, ожидайте.", p_info [ playerid ] [ name ], playerid ) ;
	SendClientMessage ( params [ 0 ], col_white, scm_string ) ;
	format ( scm_string, 72, "{"#cGN"}%s{"#cWH"} отмечен(а) на Вашей карте.", p_info [ params [ 0 ] ] [ name ] ) ;
	SendClientMessage ( playerid, col_white, scm_string ) ;

	SetPlayerRaceCheckpoint ( playerid, 1, p_t_info [ params [ 0 ] ] [ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ] [ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ] [ p_pos ] [ 2 ], 0.0, 0.0, 0.0, 2.0 ) ;
	SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}[GPS] - Метка установлена." ) ;
	is_gps_used { playerid } = 1 ;

	call_taxi { params [ 0 ] } = 0 ;
	return 1 ;
}

CMD:gomechanic ( playerid, params [ ] )
{
    if ( p_info [ playerid ] [ job ] != job_mechanic ) return 1 ;
	if ( sscanf ( params, "d", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /gomechanic [id/имя]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
