				}

				if ( b_info [ t ] [ b_improve ] [ 2 ] ) SendClientMessage ( playerid, col_gray, !"* В этом бизнесе имеется аптечка. Чтобы восстановить здоровье используйте {"#cGN"}/bheal{"#cGRInfo"} ({"#cGN"}250"valute_title_"{"#cGRInfo"})");

				b_info [ t ] [ b_visitors ] ++ ;

