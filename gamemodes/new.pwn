				case 4: show_dialog ( playerid, d_mp_hp, DIALOG_STYLE_INPUT, "{"#cBHD"}Выдача здоровья", "{"#cWH"}Укажите количество здоровья, которое хотите выдать игрокам:", "Выбрать", "Отмена");
                case 5: show_dialog ( playerid, d_mp_arm, DIALOG_STYLE_INPUT, "{"#cBHD"}Выдача брони", "{"#cWH"}Укажите количество брони, которое хотите выдать игрокам:", "Выбрать", "Отмена");
				case 6: show_dialog ( playerid, d_mp_gun, DIALOG_STYLE_INPUT, "{"#cBHD"}Выдача оружия", "{ffffff}Используйте id оружия и патроны\n{"#cGRDialog"}* Пример: {"#cBL"}31, 500\n{"#cGRDialog"}* Где {"#cBL"}31 m4 {"#cGRDialog"}а {"#cBL"}500 патроны", "Выдать", "Закрыть");
				case 7: show_dialog ( playerid, d_mp_car, DIALOG_STYLE_INPUT, "{"#cBHD"}Выдача транспорта", "{"#cWH"}Укажите ID транспорта, которое хотите выдать игрокам:", "Выбрать", "Отмена");
				case 8:
				{
				    foreach(new i:streamed_players[playerid])
