			    else show_dialog ( playerid, d_phone_main, DIALOG_STYLE_LIST, "{"#cBHD"}Телефон", "{"#cBL"}1.{"#cWH"} Звук СМС\n{"#cBL"}2.{"#cWH"} Мелодия звонка\n{"#cBL"}3.{"#cWH"} Включить телефон", "Выбрать", "Назад");
