			switch ( listitem )
			{
				case 0: show_dialog ( playerid, d_mm_enhancements2, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Приобрести улучшение", "{ffffff}Вы собираетесь приобрести улучшение {"#cBL"}'Рюкзак'\n\n{"#cGRDialog"}* Стоимость данного улучшения составляет: {"#cBL"}20.000"valute_title"{ffffff}.", "Приобрести", "Отмена" ) ;
				case 1: show_dialog ( playerid, d_mm_enhancements2, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Приобрести улучшение", "{ffffff}Вы собираетесь приобрести улучшение {"#cBL"}'Скрытность'\n\n{"#cGRDialog"}* Стоимость данного улучшения составляет: {"#cBL"}50.000"valute_title"{ffffff}.", "Приобрести", "Отмена" ) ;
				case 2: show_dialog ( playerid, d_mm_enhancements2, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Приобрести улучшение", "{ffffff}Вы собираетесь приобрести улучшение {"#cBL"}'Решительность'\n\n{"#cGRDialog"}* Стоимость данного улучшения составляет: {"#cBL"}70.000"valute_title"{ffffff}.", "Приобрести", "Отмена" ) ;
				case 3: show_dialog ( playerid, d_mm_enhancements2, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Приобрести улучшение", "{ffffff}Вы собираетесь приобрести улучшение {"#cBL"}'Мастер маскировки'\n\n{"#cGRDialog"}* Стоимость данного улучшения составляет: {"#cBL"}100.000"valute_title"{ffffff}.", "Приобрести", "Отмена" ) ;
				case 4: return show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Информация по улучшениям", "{"#cGRDialog"}- Улучшение {"#cWH"}'Рюкзак' {"#cGRDialog"}позволяет игроку вмещать больше ед. оружия и патронов в инвентарь в два раза чем остальным.\n{"#cGRDialog"}- Улучшение {"#cWH"}'Скрытность' {"#cGRDialog"}ускоряет падение уровня розыска в два раза (каждые 15 минут снимает по 2 уровня розыска).\n{"#cGRDialog"}- Улучшение {"#cWH"}'Решительность' {"#cGRDialog"}позволяет игроку самостоятельно уволиться из организации при помощи команды {"#cWH"}'/leave'{"#cGRDialog"}.\n{"#cGRDialog"}- Улучшение {"#cWH"}'Мастер маскировки' {"#cGRDialog"}позволяет игроку надеть маску и не снимать её в течение 30 минут, когда без улучшения маска даётся на 15 минут.", "Закрыть", "" ), 1 ;
			}
