            {
	            set_mapicon ( air_info [ i ] [ move_position ] [ 0 ], air_info [ i ] [ move_position ] [ 1 ], air_info [ i ] [ move_position ] [ 2 ], _legal_fraction [ q ] ) ;
                fraction_message ( _legal_fraction [ q ], col_lblue, fm_string ) ;
			}
