						format ( line_string, sizeof line_string, "{"#cGRDialog"}- {"#cWH"}%d (%s)\t{"#cGN"}%d "donate_title"\n", donate_skin [ i ] [ 0 ], mm_gender [ donate_skin [ i ] [ 2 ] ], donate_skin [ i ] [ 1 ] ) ;
