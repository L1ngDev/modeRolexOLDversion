	else if ( _a_type == area_type_family_airdrop || _a_type == area_type_family_dealer )
	{
	    new gstate = GetPlayerState ( playerid ) ;
		switch ( gstate )
		{
		    case PLAYER_STATE_DRIVER:
		    {
		        new _v_id = GetPlayerVehicleID ( playerid ) ;
				if ( _v_id == 0 ) return 1 ;

				new _v_model = getVehicleOrdinalNumber ( _v_id ) ;
				if ( v_plane ( _v_model, 1 ) )
				{
					if ( veh_info [ _v_id - 1 ] [ v_now_pos ] [ 2 ] < 100 )
					{
					    if ( ++ anti_db_warning { playerid } > 2 )
