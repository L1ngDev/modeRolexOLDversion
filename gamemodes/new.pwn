new mafia_select [ MAX_PLAYERS ] ;
new mafia_status [ MAX_PLAYERS ] ;
new mafia_progress [ MAX_PLAYERS ] ;

stock checking_mafia_quest_progress ( playerid, quest_id, amount_plus )
{
	if ( mafia_select [ playerid ] != quest_id ) return 1 ;
	if ( mafia_status [ playerid ] == 1 )
	{
	    static const _quest_progress [ ] =
		{
			100,
			5,
			100,
			50000,
			10,
			30000,
			5,
			50
		} ;

		mafia_progress [ playerid ] += amount_plus ;

		if ( mafia_progress [ playerid ] >= _quest_progress [ quest_id ] )
		{
		    new scm_string [ 72 + ( 32 * 2 ) ] ;
		    if ( quest_id == sizeof quest_mafia_info - 1 )
		    {
		        format ( scm_string, sizeof scm_string, "Задание успешно выполнено. Ваша награда: {"#cWH"}%s{"#cSucces"}.", quest_mafia_info [ quest_id ] [ q_rewards ] ) ;
				SendClientMessage ( playerid, col_succes, scm_string ) ;

				SendClientMessage ( playerid, col_succes, !"Вы завершили квестовую линию. Отправляйтесь к Цветочнику Джое, чтобы получить своё вознаграждение." ) ;
		    }
		    else
		    {
		        format ( scm_string, sizeof scm_string, "Задание успешно выполнено. Ваша награда: {"#cWH"}%s{"#cSucces"}.", quest_mafia_info [ quest_id ] [ q_rewards ] ) ;
				SendClientMessage ( playerid, col_succes, scm_string ) ;

		        format ( scm_string, sizeof scm_string, "Следующее задание: {"#cWH"}%s{"#cSucces"}.", quest_mafia_info [ quest_id + 1 ] [ q_name ] ) ;
				SendClientMessage ( playerid, col_succes, scm_string ) ;

				SendClientMessage ( playerid, col_succes, !"Отправляйтесь к Цветочнику Джое, чтобы получить своё вознаграждение." ) ;
		    }

			mafia_status [ playerid ] = 2 ;
			update_quest_mafia ( playerid ) ;
		}
		else
		{
			update_int_sql ( playerid, "u_quest_mafia_progress", mafia_progress [ playerid ] ) ;
		}
	}
	return 1 ;
}

