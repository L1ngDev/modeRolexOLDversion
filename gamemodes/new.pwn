				        set_pos ( _o_id, duels_pos [ 5 ] [ 0 ], duels_pos [ 5 ] [ 1 ], duels_pos [ 5 ] [ 2 ], duels_pos [ 5 ] [ 3 ], duels_interior [ 2 ], _o_id + 1000 ) ;
				    }
				}

				toggle_controlable ( playerid, false ) ;
				toggle_controlable ( _o_id, false ) ;

				set_health ( _o_id, player_duel [ _o_id ] [ duel_hp ] ) ;
				set_health ( playerid, player_duel [ _o_id ] [ duel_hp ] ) ;

                set_armour ( _o_id, 0.0 ) ;
                set_armour ( playerid, 0.0 ) ;

				player_duel [ playerid ] [ duel_on ] = true ;
				player_duel [ _o_id ] [ duel_on ] = true ;

				SetTimerEx("Duel_Count", 1000, 0, "dd", playerid, 3);
				SetTimerEx("Duel_Count", 2000, 0, "dd", playerid, 2);
				SetTimerEx("Duel_Count", 3000, 0, "dd", playerid, 1);
				SetTimerEx("Duel_Count", 4000, 0, "dd", playerid, 0);
			}
