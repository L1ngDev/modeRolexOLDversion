				{"#cGRDialog"}* Введите причину удаления:", ad_info [ _ad_id ] [ ad_sender ], ad_info [ _ad_id ] [ ad_date ], ad_info [ _ad_id ] [ ad_text ] ) ;

				return show_dialog ( playerid, d_ad_delete, DIALOG_STYLE_INPUT, "{"#cBHD"}Удаление", global_string, "Принять", "Отмена" ) ;
			}

			if ( is_text_invalid ( inputtext ) )
			{
			    global_string [ 0 ] = EOS ;
				format ( global_string, 512, "\
				{"#cGRDialog"}* Причина не может содержать менее 3 и более 32 символов\n\n\
				{"#cWH"}Отправитель: {"#cBL"}%s\n\
				{"#cWH"}Время подачи: {"#cBL"}%s\n\
				{"#cWH"}Текст отправления: {"#cBL"}%s\n\n\
				{"#cGRDialog"}* Введите причину удаления:", ad_info [ _ad_id ] [ ad_sender ], ad_info [ _ad_id ] [ ad_date ], ad_info [ _ad_id ] [ ad_text ] ) ;

				return show_dialog ( playerid, d_ad_delete, DIALOG_STYLE_INPUT, "{"#cBHD"}Удаление", global_string, "Принять", "Отмена" ) ;
			}

			new pl_id, _text_string [ 200 ] ;
			sscanf ( ad_info [ _ad_id ] [ ad_sender ], "u", pl_id ) ;
			if ( IsPlayerConnected ( pl_id ) )
			{
				format ( _text_string, sizeof ( _text_string ), "Ваше объявление было отклонено сотрудником %s. Причина: %s", p_info [ playerid ] [ name ], inputtext ) ;
				SendClientMessage ( ad_info [ _ad_id ] [ ad_id ], -1, _text_string ) ;
			}
			format ( _text_string, sizeof _text_string, "[R] %s %s отклонил(а) объявление %s. Причина: %s", f_rank [ p_info [ playerid ] [ member ] - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], ad_info [ _ad_id ] [ ad_sender ], inputtext ) ;
			fraction_message ( fraction_id, col_lblue, _text_string ) ;

			format ( _text_string, sizeof _text_string, "Отклонил(а) объявление %s. Причина: %s", ad_info [ _ad_id ] [ ad_sender ], inputtext ) ;
			write_fraction ( playerid, fraction_id, TYPE_LOG_OBWYAK, _text_string ) ;

			format ( _text_string, sizeof _text_string, "{"#cRD"}* REPORT [AD] %s:{"#cWH"} %s", ad_info [ _ad_id ] [ ad_sender ], ad_info [ _ad_id ] [ ad_text ] ) ;
			foreach(new i: admin_players) SendClientMessage ( i, col_gray, _text_string ) ;

            strdel ( ad_info [ _ad_id ] [ ad_sender ], 0, 24 ) ;
			strdel ( ad_info [ _ad_id ] [ ad_text ], 0, 100 ) ;
			strdel ( ad_info [ _ad_id ] [ ad_date ], 0, 24 ) ;
			strdel ( ad_info [ _ad_id ] [ ad_checker ], 0, 24 ) ;

            ad_info [ _ad_id ] [ ad_time ] =
			ad_info [ _ad_id ] [ ad_checker_id ] =
			ad_info [ _ad_id ] [ ad_id ] = -1 ;

			ad_info [ _ad_id ] [ ad_busy ] =
			ad_info [ _ad_id ] [ ad_checked ] =
			ad_info [ _ad_id ] [ ad_checking ] = false ;

			ad_info [ _ad_id ] [ ad_phone_number ] =
			ad_info [ _ad_id ] [ ad_member ] =
			ad_info [ _ad_id ] [ ad_rank ] = 0 ;

			show_ad_list ( playerid ) ;

			DeletePVar ( playerid, "ad_listitem" ) ;
			return 1 ;
		}
		case d_ad_redit:
		{
			if ( ! response )
			{
			    ad_info [ GetPVarInt ( playerid, "ad_listitem" ) - 1 ] [ ad_checking ] = false ;
			    DeletePVar ( playerid, "ad_listitem" ) ;
				show_ad_list ( playerid ) ;
				return 1 ;
			}
			new _ad_id = GetPVarInt ( playerid, "ad_listitem" ) - 1 ;
			if ( strfind(inputtext,"{" ) != -1 )
			{
				new header_string [ MAX_PLAYER_NAME + 9 ],
					inputtext_string [ 100 + 9 ] ;
				strcat ( header_string, "{"#cBL"}" ) ;
				strcat ( header_string, ad_info [ _ad_id ] [ ad_sender ] ) ;
				strcat ( inputtext_string, "{ffffff}" ) ;
				strcat ( inputtext_string, ad_info [ _ad_id ] [ ad_text ] ) ;
				return show_dialog ( playerid, d_ad_redit, DIALOG_STYLE_INPUT, header_string, inputtext_string, "Принять", "Отмена" ) ;
			}

            new _ask [ 100 ] ;
			format ( _ask, sizeof _ask, "%s", inputtext ) ;
			for ( new A = 0 ; A != strlen ( _ask ) ; A ++ )
		  	{
				switch ( _ask [ A ] )
				{
					case 'А'..'Я': _ask [ A ] = _ask [ A ] + 32 ;
				}
			}
			if(strfind(_ask, "kk", true) != -1 || strfind(_ask, "кк", true) != -1) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Буквы {"#cRD"}'kk', 'кк' {"#cGRInfo"}нарушают правила рп процесса." ) ;
           	if(strfind(_ask, "{", true) != -1 && strfind(_ask, "}", true) != -1) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Символы {"#cRD"}'{', '}' {"#cGRInfo"}нарушают правила рп процесса." ) ;

			format ( ad_info [ _ad_id ] [ ad_text ], 100, "%s", inputtext ) ;

			new _ad_count = 1 ;
		   	for ( new q = 0 ; q < MAX_ADVERTS; q ++ )
		   	{
				if ( ad_info [ q ] [ ad_time ] != -1 ) _ad_count ++ ;
			}
			format ( ad_info [ _ad_id ] [ ad_checker ], MAX_PLAYER_NAME, "%s", p_info [ playerid ] [ name ] ) ;
			ad_info [ _ad_id ] [ ad_checker_id ] = playerid ;
			ad_info [ _ad_id ] [ ad_checking ] = false ;
			ad_info [ _ad_id ] [ ad_checked ] = true ;

			//ad_info [ _ad_id ] [ ad_time ] += _ad_count * 15 ;
			ad_info [ _ad_id ] [ ad_time ] = SetTimerEx ( "advertise_timer", ( _ad_count * 15 ) * 1000, false, "d", _ad_id ) ;

			ad_info [ _ad_id ] [ ad_member ] = p_info [ playerid ] [ member ] ;
			ad_info [ _ad_id ] [ ad_rank ] = p_info [ playerid ] [ rank ] ;

			new _text_string [ 200 ] ;
			format ( _text_string, sizeof _text_string, "Изменил(а) объявление. Новый текст: %s", inputtext ) ;
			write_fraction ( playerid, p_info [ playerid ] [ member ], TYPE_LOG_OBWYAK, _text_string ) ;

			show_ad_list ( playerid ) ;

			DeletePVar ( playerid, "ad_listitem" ) ;
			return 1 ;
		}
		case d_advert:
		{
			if ( ! response ) return 1 ;
			if ( p_info [ playerid ] [ money ] < ad_price ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас не достаточно средств для подачи объявления." ) ;

			new slot = -1 ;
			for ( new i = 0; i < MAX_ADVERTS ; i ++ )
			{
				if ( ! ad_info [ i ] [ ad_busy ] )
				{
					slot = i ;
					break ;
				}
			}
			if ( slot == -1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нет места для объявлений, попробуйте позже." ) ;

			new ad_inputtext [ 100 ] ;
			GetPVarString ( playerid, "advert_text", ad_inputtext, 100 ) ;
			DeletePVar ( playerid, "advert_text" ) ;
			give_money ( playerid, -ad_price ) ;

			format ( ad_info [ slot ] [ ad_sender ], MAX_PLAYER_NAME, "%s", p_info [ playerid ] [ name ] ) ;
			ad_info [ slot ] [ ad_id ] = playerid ;
			ad_info [ slot ] [ ad_phone_number ] = p_info [ playerid ] [ number ] ;
			format ( ad_info [ slot ] [ ad_text ], 100, "%s", ad_inputtext ) ;
			ad_info [ slot ] [ ad_busy ] = true ;

			new hour, minute, second ;

			gettime ( hour, minute, second ) ;
			FixHour ( hour ) ;
			hour = global_hour ;

			format ( ad_info [ slot ] [ ad_date ], 24, "%s%d:%s%d", ( hour < 10 ) ? ( "0" ) : (""), hour, ( minute < 10 ) ? ( "0" ) : ( "" ), minute ) ;

			SendClientMessage ( playerid, 0xCCCCCCFF, !"Вы успешно отправили объявление. Ожидайте пока его проверят." ) ;
			SendClientMessage ( playerid, 0xCCCCCCFF, !"Для проверки сотрудников СМИ в игре используйте /dir." ) ;
			new _text_string [ 84 + MAX_PLAYER_NAME + 3 ] ;
			format ( _text_string, sizeof ( _text_string ),"[R] Пришло новое объявление от %s (ID: %d) | Подробнее /edit", p_info [ playerid ] [ name ], playerid ) ;
			fraction_message ( p_info [ playerid ] [ radio ], col_lblue, _text_string ) ;
			return 1 ;
		}
		case d_advertise_send:
		{
			if ( ! response ) return 1 ;

			callcmd::advertise ( playerid, inputtext ) ;
			return 1 ;
		}
		case d_advertise:
		{
		    if ( ! response ) return 1 ;

		    if ( listitem == 0 )
			{
			    show_dialog ( playerid, d_advertise_sell, DIALOG_STYLE_LIST, "{"#cBHD"}Что Вы хотите продать?", "\
					{"#cBHD"}1. {"#cWH"}Дом\n\
					{"#cBHD"}2. {"#cWH"}Бизнес\n\
					{"#cBHD"}3. {"#cWH"}Транспорт", "Выбрать", "Закрыть" ) ;
			}
			else if ( listitem == 1 )
			{
			    if ( p_info [ playerid ] [ member ] < 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не состоите в организации." ) ;
				if ( ! gang_player ( playerid ) && ! mafia_player ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Набор доступен только в криминальные организации." ) ;
			   	if ( p_info [ playerid ] [ money ] < ad_price ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас не достаточно средств для подачи объявления." ) ;

				new _fraction_id = p_info [ playerid ] [ member ] ;
				if ( p_info [ playerid ] [ rank ] < f_info [ _fraction_id - 1 ] [ f_rank_settings ] [ 1 ] )
				{
				    static const _str [ ] = "{"#cRInfo"}* {"#cGRInfo"}Подача объявлений о наборе доступна с ранга %s (%d)." ;
				    new scm_string [ sizeof _str + 30 + 3 ] ;
				    format ( scm_string, sizeof scm_string, _str, f_rank [ _fraction_id - 1 ] [ f_info [ _fraction_id - 1 ] [ f_rank_settings ] [ 1 ] - 1 ], f_info [ _fraction_id - 1 ] [ f_rank_settings ] [ 1 ] ) ;
					SendClientMessage ( playerid, col_gray, scm_string ) ;
					return 1 ;
				}

			    new slot = -1 ;
				for ( new i = 0; i < MAX_ADVERTS ; i ++ )
				{
					if ( ! ad_info [ i ] [ ad_busy ] )
					{
						slot = i ;
						break ;
					}
				}
				if ( slot == -1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нет места для объявлений, попробуйте позже." ) ;

				give_money ( playerid, -ad_price ) ;

				format ( ad_info [ slot ] [ ad_sender ], MAX_PLAYER_NAME, "%s", p_info [ playerid ] [ name ] ) ;
				ad_info [ slot ] [ ad_id ] = playerid ;
				ad_info [ slot ] [ ad_phone_number ] = p_info [ playerid ] [ number ] ;
				if ( gang_player ( playerid ) ) format ( ad_info [ slot ] [ ad_text ], 100, "Проходит набор в клуб '%s'. Подробности по телефону", f_info [ _fraction_id - 1 ] [ f_name ] ) ;
				else format ( ad_info [ slot ] [ ad_text ], 100, "Проходит набор в ресторан '%s'. Подробности по телефону", f_info [ _fraction_id - 1 ] [ f_name ] ) ;
				ad_info [ slot ] [ ad_busy ] = true ;

				new hour, minute, second ;

				gettime ( hour, minute, second ) ;
				FixHour ( hour ) ;
				hour = global_hour ;

				format ( ad_info [ slot ] [ ad_date ], 24, "%s%d:%s%d", ( hour < 10 ) ? ( "0" ) : (""), hour, ( minute < 10 ) ? ( "0" ) : ( "" ), minute ) ;

				SendClientMessage ( playerid, 0xCCCCCCFF, !"Вы успешно отправили объявление. Ожидайте публикации." ) ;

				new _ad_count = 1 ;
    			for ( new q = 0 ; q < MAX_ADVERTS; q ++ )
			    {
					if ( ad_info [ q ] [ ad_time ] != -1 ) _ad_count ++ ;
				}
				ad_info [ slot ] [ ad_checker_id ] = INVALID_PLAYER_ID ;
				ad_info [ slot ] [ ad_checking ] = false ;
				ad_info [ slot ] [ ad_checked ] = true ;

				//ad_info [ _ad_id ] [ ad_time ] += _ad_count * 15 ;
				ad_info [ slot ] [ ad_time ] = SetTimerEx ( "advertise_timer", ( _ad_count * 15 ) * 1000, false, "d", slot ) ;
				return 1 ;
			}
			else if ( listitem == 2 )
			{
    			if ( p_info [ playerid ] [ family ] < 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не состоите в семье." ) ;
				if ( p_info [ playerid ] [ money ] < ad_price ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас не достаточно средств для подачи объявления." ) ;

				new _family_id = p_info [ playerid ] [ family ] ;
				if ( p_info [ playerid ] [ family_rang ] < family_info [ _family_id - 1 ] [ fam_settings ] [ 0 ] )
				{
				    static const _str [ ] = "{"#cRInfo"}* {"#cGRInfo"}Подача объявлений о наборе доступна со статуса %s (%d)." ;
				    new scm_string [ sizeof _str + 30 + 3 ] ;
				    format ( scm_string, sizeof scm_string, _str, family_rank [ _family_id - 1 ] [ family_info [ _family_id - 1 ] [ fam_settings ] [ 0 ] - 1 ], family_info [ _family_id - 1 ] [ fam_settings ] [ 0 ] ) ;
					SendClientMessage ( playerid, col_gray, scm_string ) ;
					return 1 ;
				}

			    new slot = -1 ;
				for ( new i = 0; i < MAX_ADVERTS ; i ++ )
				{
					if ( ! ad_info [ i ] [ ad_busy ] )
					{
						slot = i ;
						break ;
					}
				}
				if ( slot == -1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нет места для объявлений, попробуйте позже." ) ;

