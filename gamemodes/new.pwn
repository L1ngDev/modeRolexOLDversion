CMD:jackcar ( playerid )
{
	if ( p_info [ playerid ] [ wanted ] > 0 )
	{
		if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Вы находитесь в розыске.", 0, 3, CINFO_INVENTORY_ID, PICTURE_INFO_ERROR, "", "" ) ;
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы находитесь в розыске." ) ;
		return 1 ;
	}
	if ( ! gang_player ( playerid ) && ! mafia_player ( playerid ) )
	{
		if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Команда доступна только для криминальных организаций.", 0, 3, CINFO_INVENTORY_ID, PICTURE_INFO_ERROR, "", "" ) ;
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команда доступна только для криминальных организаций." ) ;
		return 1 ;
	}
	if ( GetInventoryFindItem ( playerid, SUB_INVENTORY, 2161 ) < 1 )
	{
		if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "У вас нету отмычек.", 0, 3, CINFO_INVENTORY_ID, PICTURE_INFO_ERROR, "", "" ) ;
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас нету отмычек." ) ;
		return 1 ;
	}
	new Float:X, Float:Y, Float:Z ;
	new bool:check_vehicle = false ;
	foreach(new veh_id: streamed_vehicles[playerid])
	{
	    if ( veh_info [ veh_id - 1 ] [ v_owner ] == p_info [ playerid ] [ id ] || veh_info [ veh_id - 1 ] [ v_sell_price ] > 0 ) continue ;
		if ( veh_info [ veh_id - 1 ] [ v_type ] == vehicle_type_player || veh_info [ veh_id - 1 ] [ v_type ] == vehicle_type_jackcar && veh_info [ veh_id - 1 ] [ v_jackcar ] == playerid )
		{
			GetVehiclePos ( veh_id, X, Y, Z ) ;
			if ( IsPlayerInRangeOfPoint ( playerid, 4.0, X, Y, Z ) )
			{
				SetPVarInt ( playerid, "CarJack", veh_id ) ;
				check_vehicle = true ;
				break ;
			}
		}
	}
	if ( ! check_vehicle )
	{
		if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Можно взламывать только личные т/с игроков.", 0, 3, CINFO_INVENTORY_ID, PICTURE_INFO_ERROR, "", "" ) ;
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Можно взламывать только личные т/с игроков." ) ;
		return 1 ;
	}

	clear_inventory ( playerid, 2161, 1 ) ;

	if ( GetPlayerVehicleID ( playerid ) == 0 )
	{
		#if defined m_action
			if ( player_device { playerid } == 2 )
			{
				action_type { playerid } = ACTION_JACKCAR ;
			    actionShow ( playerid, "Взлом транспорта", 100 ) ;
       			return 1 ;
	    	}
		#endif

		action_type { playerid } = ACTION_JACKCAR ;
		action_step { playerid } = 0 ;
		action_td_status ( playerid, true ) ;

		ApplyAnimation ( playerid, "BD_FIRE", "wash_up", 4.1, 1, 0, 0, 0, 0, 0 ) ;
	}
	else
	{
		speedometr_status ( playerid, false ) ;

		#if defined m_action
			if ( player_device { playerid } == 2 )
			{
				action_type { playerid } = ACTION_JACK_IN_CAR ;
			    actionShow ( playerid, "Взлом двигателя", 100 ) ;
       			return 1 ;
	    	}
		#endif

	    action_type { playerid } = ACTION_JACK_IN_CAR ;
		action_step { playerid } = 0 ;
		action_td_status ( playerid, true ) ;
	}
	return 1 ;
}

CMD:mpanel ( playerid )
{
	if ( ! gov_player ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команда доступна только для сотрудников правительства." ) ;
	if ( p_info [ playerid ] [ rank ] == f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 6 ] )
	{
		show_dialog ( playerid, d_mpanel, DIALOG_STYLE_LIST, "{"#cBHD"}Министр здравоохранения","- Настройки организации\n- Цена на лечение", "Выбрать", "Отмена" ) ;
	}
	else if ( p_info [ playerid ] [ rank ] == f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 7 ] )
	{
		show_dialog ( playerid, d_mpanel, DIALOG_STYLE_LIST, "{"#cBHD"}Комиссар","- Настройки организации\n- Премия за поимку преступника", "Выбрать", "Отмена" ) ;
	}
	else if ( p_info [ playerid ] [ rank ] == f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 8 ] )
	{
		show_dialog ( playerid, d_mpanel, DIALOG_STYLE_LIST, "{"#cBHD"}Министр обороны","- Настройки организации\n- Премия за доставку боеприпасов\n- Запрет на использование тяжёлой техники", "Выбрать", "Отмена" ) ;
	}
	else if ( p_info [ playerid ] [ rank ] == f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 12 ] )
	{
		show_dialog ( playerid, d_mpanel, DIALOG_STYLE_LIST, "{"#cBHD"}Министр юстиции","- Настройки организации", "Выбрать", "Отмена" ) ;
	}
	/*if ( p_info [ playerid ] [ rank ] == f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 0 ] )
	{
		show_dialog(playerid, d_mpanel, DIALOG_STYLE_LIST, "{"#cBHD"}Губернатор","- Государственная волна\n- Чат департамента", "Выбрать", "Отмена");
	}*/
	return true ;
}

public OnPlayerEditObject ( playerid, playerobject, objectid, response, Float:fX, Float:fY, Float:fZ, Float:fRotX, Float:fRotY, Float:fRotZ )
{
	if ( GetPVarInt ( playerid, "TotalGraf_" ) )
	{
		new slot = GetPVarInt ( playerid, "TotalGraf_" ) - 1 ;
		graf_info [ slot ] [ gr_x ] [ 0 ] = fX ;
		graf_info [ slot ] [ gr_x ] [ 1 ] = fY ;
		graf_info [ slot ] [ gr_x ] [ 2 ] = fZ ;
		graf_info [ slot ] [ gr_x ] [ 3 ] = fRotX ;
		graf_info [ slot ] [ gr_x ] [ 4 ] = fRotY ;
		graf_info [ slot ] [ gr_x ] [ 5 ] = fRotZ ;
	}
	return 1 ;
}

CMD:creategraf ( playerid )
{
	if ( admin_info [ playerid ] [ admin ] < 8 ) return 1 ;
	if ( GetPVarInt ( playerid, "TotalGraf_" ) ) return 1 ;
	new Float:X, Float:Y, Float:Z ;
	GetPlayerPos ( playerid, X, Y, Z ) ;
	graf_info [ count_graffity ] [ g_id ] = CreateDynamicObject ( 18661, X, Y + 0.5, Z, 0.0, 0.0, 0.0, -1, -1, -1, 200.0, 200.0 ) ;

	graf_info [ count_graffity ] [ gr_x ] [ 0 ] = X ;
	graf_info [ count_graffity ] [ gr_x ] [ 1 ] = Y + 0.5 ;
	graf_info [ count_graffity ] [ gr_x ] [ 2 ] = Z ;

	Streamer_Update ( playerid ) ;

	new text_size [ 64 ] ;
	format ( text_size, 64, "Вы создали граффити (slot: %i)", count_graffity ) ;
	SendClientMessage ( playerid, col_gray, text_size ) ;
	SendClientMessage ( playerid, col_gray, !"Для редактирования её месторасположения Используйте /editgraf" ) ;

	SetPVarInt ( playerid, "TotalGraf_", count_graffity + 1 ) ;
	count_graffity ++ ;
	return 1 ;
}

CMD:editgraf ( playerid )
{
	if ( ! GetPVarInt ( playerid, "TotalGraf_" ) ) return 1 ;

	new slot = GetPVarInt ( playerid, "TotalGraf_") - 1 ;
	EditDynamicObject ( playerid, graf_info [ slot ] [ g_id ] ) ;

	SendClientMessage ( playerid, col_gray, !"После редактирования, для сохранения нажмите /finishgraf" ) ;
	return 1 ;
}

CMD:finishgraf ( playerid )
{
	if ( ! GetPVarInt ( playerid,"TotalGraf_" ) ) return 1 ;
	new slot = GetPVarInt(playerid,"TotalGraf_" ) - 1 ;

	new Float:X, Float:Y, Float:Z;
	new Float:rX, Float:rY, Float:rZ;

	GetDynamicObjectPos ( graf_info[slot][g_id],X,Y,Z ) ;
	GetDynamicObjectRot ( graf_info[slot][g_id],rX,rY,rZ ) ;

	DestroyDynamicObject(graf_info[slot][g_id]);
	graf_info[slot][g_id] = CreateDynamicObject(18661, graf_info[slot][gr_x][0], graf_info[slot][gr_x][1], graf_info[slot][gr_x][2], graf_info[slot][gr_x][3], graf_info[slot][gr_x][4], graf_info[slot][gr_x][5],-1,-1,-1,200.0,200.0);
	Streamer_Update(playerid);

	new sql_string [ 200 ] ;
	format(sql_string, 200, "INSERT INTO `grafity` (`gr_x0`, `gr_x1`, `gr_x2`, `gr_x3`, `gr_x4`, `gr_x5`) VALUES ('%f','%f','%f','%f','%f','%f')", graf_info[slot][gr_x][0], graf_info[slot][gr_x][1], graf_info[slot][gr_x][2], graf_info[slot][gr_x][3], graf_info[slot][gr_x][4], graf_info[slot][gr_x][5]);
	mysql_tquery(sql_connection, sql_string, "", "");

	SendClientMessage ( playerid, col_gray, !"Граффити сохранена." ) ;
	DeletePVar ( playerid, "TotalGraf_" ) ;
	return 1 ;
}

callback: load_graffity ( )
{
	new fields, time = GetTickCount ( ) ;
	cache_get_data ( count_graffity, fields ) ;
	for ( new i = 1 ; i <= count_graffity ; i ++ )
	{
		graf_info [ i ] [ g_id ] = cache_get_row_int ( i - 1, 0, sql_connection ) ;
		graf_info [ i ] [ g_member ] = cache_get_row_int ( i - 1, 1, sql_connection ) ;
		graf_info [ i ] [ gr_x ] [ 0 ] = cache_get_row_float ( i - 1, 2, sql_connection ) ;
		graf_info [ i ] [ gr_x ] [ 1 ] = cache_get_row_float ( i - 1, 3, sql_connection ) ;
		graf_info [ i ] [ gr_x ] [ 2 ] = cache_get_row_float ( i - 1, 4, sql_connection ) ;
		graf_info [ i ] [ gr_x ] [ 3 ] = cache_get_row_float ( i - 1, 5, sql_connection ) ;
		graf_info [ i ] [ gr_x ] [ 4 ] = cache_get_row_float ( i - 1, 6, sql_connection ) ;
		graf_info [ i ] [ gr_x ] [ 5 ] = cache_get_row_float ( i - 1, 7, sql_connection ) ;
		graf_info [ i ] [ gr_x ] [ 6 ] = cache_get_row_float ( i - 1, 8, sql_connection ) ;

        new object ;
		switch ( graf_info [ i ] [ g_member ] )
		{
			case 0: object = 1525 ;
			case 18: object = 18659 ;
			case 22: object = 18661 ;
			case 21: object = 18663 ;
			case 19: object = 18664 ;
			case 20: object = 18665 ;
		}

		graf_info [ i ] [ g_object ] = CreateDynamicObject ( object, graf_info [ i ] [ gr_x ] [ 0 ], graf_info [ i ] [ gr_x ] [ 1 ], graf_info [ i ] [ gr_x ] [ 2 ], graf_info [ i ] [ gr_x ] [ 3 ], graf_info [ i ] [ gr_x ] [ 4 ], graf_info [ i ] [ gr_x ] [ 5 ] ) ;
		CreateDynamic3DTextLabel ( "** Граффити **\n{"#cGR3D"}Нажмите {"#cWH3D"}H{"#cGR3D"} для взаимодействия", col_header_3d, graf_info [ i ] [ gr_x ] [ 0 ], graf_info [ i ] [ gr_x ] [ 1 ], graf_info [ i ] [ gr_x ] [ 2 ], 15.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1 ) ;
        graf_info [ i ] [ g_area ] = CreateDynamicSphere ( graf_info [ i ] [ gr_x ] [ 0 ], graf_info [ i ] [ gr_x ] [ 1 ], graf_info [ i ] [ gr_x ] [ 2 ], 4.0, -1, -1, -1 ) ;
		area_info [ graf_info [ i ] [ g_area ] ] [ a_type ] = area_type_graffity ;
		area_info [ graf_info [ i ] [ g_area ] ] [ a_item ] = i ;
	}
	printf ( "[SERVER] Загружено %i граффити. (%d ms)", count_graffity, GetTickCount ( ) - time ) ;
	return 1 ;
}

stock callback_player_contacts_info ( playerid )
{
	new dialog_string [ 107 + 32 + 6 + 32 ], j = get_player_use_listitem ( playerid ) ;
	format ( dialog_string, sizeof ( dialog_string ), "{"#cWH"}Контакт: {"#cOR"}%s\n{"#cWH"}Номер: {"#cWV"}%d\n\n{"#cGRDialog"}* Владелец SIM-карты: {"#cWH"}%s",
	users_contacts [ playerid ] [ j ] [ uc_subname ], users_contacts [ playerid ] [ j ] [ uc_number ], users_contacts [ playerid ] [ j ] [ uc_name ] ) ;
	show_dialog ( playerid, d_phone_menu_4, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Информация о контакте", dialog_string, "Назад", "Выйти" ) ;
	return 1 ;
}

stock callback_player_contacts ( playerid )
{
    global_string [ 0 ] = EOS ;
    strcat ( global_string, "{"#cBL"}Имя:\t{"#cBL"}Номер:\t{"#cBL"}Статус:\n" ) ;

	new line_string [ 144 ], row_count = 0 ;
	for ( new j = 0 ; j < MAX_CONTACTS ; j ++ )
	{
	    if ( users_contacts [ playerid ] [ j ] [ uc_inc ] == -1 ) continue ;

	    set_player_listitem_values ( playerid, row_count, j ) ;
	    row_count ++ ;

	    new _pl_id ;
		sscanf ( users_contacts [ playerid ] [ j ] [ uc_name ], "u", _pl_id ) ;

		format ( line_string, sizeof ( line_string ), "{"#cBL"}%d. {"#cWH"}%s\tтел. {"#cGRDialog"}%d\t%s\n",
		row_count, users_contacts [ playerid ] [ j ] [ uc_subname ], users_contacts [ playerid ] [ j ] [ uc_number ], ( IsPlayerConnected ( _pl_id ) ) ? ( "({"#cGN"}ONLINE{"#cGRDialog"})" ) : ( "({"#cRD"}OFFLINE{"#cGRDialog"})" ) ) ;
		strcat ( global_string, line_string ) ;
	}

	if ( ! row_count ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Телефонная книга пуста." ) ;
	show_dialog ( playerid, d_phone_menu_3, DIALOG_STYLE_TABLIST_HEADERS, "{"#cBHD"}Контакты", global_string, "Выбрать", "Закрыть" ) ;
	return 1 ;
}

CMD:unit ( playerid )
{
	if ( p_info [ playerid ] [ leader ] < 1 ) return 1 ;

	global_string [ 0 ] = EOS ;
	new line_string [ 128 ], row_count ;
	for ( new i = 0 ; i < unit_count ; i++ )
	{
	    if ( row_count >= 5 ) break ;
	    if ( p_info [ playerid ] [ member ] != unit_info [ i ] [ u_fraction ] ) continue ;

	    set_player_listitem_values ( playerid, row_count, i ) ;

        row_count ++ ;

		format ( line_string, sizeof line_string, "{"#cBL"}%i. {"#cWH"}%s\n", row_count, unit_info [ i ] [ un_name ] ) ;
		strcat ( global_string, line_string ) ;
	}
	if ( row_count < 5 )
	{
		strcat ( global_string, "{"#cBL"}Создать подразделение{"#cWH"}\n" ) ;
		set_player_use_listitem ( playerid, row_count ) ;
	}
	show_dialog ( playerid, d_unit, DIALOG_STYLE_LIST, "{"#cBHD"}Подразделения", global_string, "Выбрать", "Закрыть");
	return 1 ;
}

callback: unitLeaderUninvite ( playerName [ ], init )
{
	if ( init )
	{
		static const _str [ ] = "SELECT `u_id` FROM `users` WHERE `u_name` = '%s' LIMIT 1" ;
		new query_string [ sizeof _str + MAX_PLAYER_NAME ] ;
		format ( query_string, sizeof query_string, _str, playerName ) ;
		mysql_tquery ( sql_connection, query_string, "unitLeaderUninvite", "si", playerName, false ) ;
	}
	else
	{
		new rows, fields ;
		cache_get_data ( rows, fields ) ;
		if ( ! rows ) return false ;

		static const _str [ ] = "UPDATE `fractions_players` SET `u_subleader` = '0' WHERE `u_sql_id` = '%d' LIMIT 1" ;
		new query_string [ sizeof _str + 9 ] ;
		format ( query_string, sizeof query_string, _str, cache_get_field_content_int ( 0, "u_id" ) ) ;
		mysql_tquery ( sql_connection, query_string ) ;
	}
	return true ;
}

stock show_unit ( playerid )
{
	new unit_id = get_player_use_listitem ( playerid ) ;

    new text_string [ 64 ] ;
	format ( text_string, sizeof text_string, "{"#cBHD"}%s", unit_info [ unit_id ] [ un_name ] ) ;

	new _u_leader [ 32 ] ;
	if ( ! GetString ( unit_info [ unit_id ] [ u_leader ], "None" ) ) format ( _u_leader, sizeof _u_leader, "%s", unit_info [ unit_id ] [ u_leader ] ) ;
	else format ( _u_leader, sizeof _u_leader, "Отсутствует" ) ;

	global_string [ 0 ] = EOS ;
	new line_string [ 100 ] ;

	format ( line_string, sizeof line_string, "{"#cGRDialog"}- {"#cWH"}Командир: {"#cBL"}%s\n", _u_leader ) ;
	strcat ( global_string, line_string ) ;
	strcat ( global_string, "{"#cBL"}1. {"#cWH"}Изменить название подразделения\n" ) ;
	strcat ( global_string, "{"#cBL"}2. {"#cWH"}Назначить лидера подразделения\n" ) ;
	strcat ( global_string, "{"#cBL"}3. {"#cWH"}Снять лидера подразделения\n" ) ;
	strcat ( global_string, "{"#cBL"}4. {"#cWH"}Состав подразделения\n" ) ;
	strcat ( global_string, "{"#cBL"}5. {"#cWH"}Состав подразделения оффлайн\n" ) ;

	if ( medic_player ( playerid ) )
	{
	    format ( line_string, sizeof line_string, "{"#cBL"}6. {"#cWH"}Спавн подразделения {"#cGRDialog"}(%s{"#cGRDialog"})\n", ( ! unit_info [ unit_id ] [ u_use_spawn ] ) ? ( "{"#cRD"}Не установлен" ) : ( "{"#cGN"}Установлен" ) ) ;
		strcat ( global_string, line_string ) ;
	}

	show_dialog ( playerid, d_edit_unit, DIALOG_STYLE_LIST, text_string, global_string, "Выбрать", "Закрыть" ) ;
	return 1 ;
}

CMD:uinvite ( playerid , params [ ] )
{
    if ( p_info [ playerid ] [ member ] == 0 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не состоите в организации." ) ;
	if ( p_info [ playerid ] [ subleader ] < 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не состоите в подразделении." ) ;

	if ( sscanf ( params, "u", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /uinvite [ид/имя]");
    if ( ! IsPlayerConnected ( params [ 0 ] )  || params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( ! bad_dialog ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Невозможно принять игрока в данный момент." ) ;

	if ( strcmp ( unit_info [ p_info [ playerid ] [ subleader ] - 1 ] [ u_leader ], p_info [ playerid ] [ name ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не являетесь лидером подразделения." ) ;
	if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;
	if ( p_info [ playerid ] [ member ] != p_info [ params [ 0 ] ] [ member ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок состоит не в Вашей организации." ) ;
	if ( p_info [ params [ 0 ] ] [ subleader ] > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок состоит в подразделении." ) ;

	new scm_string [ 144 ] ;
	format ( scm_string, sizeof scm_string, "Вы пригласили %s в подразделение", p_info [ params [ 0 ] ] [ name ] ) ;
	SendClientMessage ( playerid, col_gray, scm_string ) ;
	format ( scm_string, sizeof scm_string, "{"#cBL"}%s {"#cWH"}предлагает Вам вступить в подразделение {"#cGRDialog"}\"%s\"", p_info [ playerid ] [ name ], unit_info [ p_info [ playerid ] [ subleader ] - 1 ] [ un_name ] ) ;
	show_dialog ( params [ 0 ], d_invite_box_sub, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Вступление в подразделение", scm_string, "Вступить", "Отклонить" ) ;

	buyer_id [ playerid ] = params [ 0 ] ;
	seller_id [ params [ 0 ] ] = playerid ;
	return 1 ;
}

CMD:uuninvite ( playerid, params [ ] )
{
	if ( p_info [ playerid ] [ member ] == 0 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не состоите в организации." ) ;
	if ( p_info [ playerid ] [ subleader ] < 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не состоите в подразделении." ) ;

	if ( strcmp ( unit_info [ p_info [ playerid ] [ subleader ] - 1 ] [ u_leader ], p_info [ playerid ] [ name ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не являетесь лидером подразделения." ) ;
	if ( sscanf ( params, "us[48]", params [ 0 ], params [ 1 ] ) )
		return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /uuninvite [ид/имя] [причина]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] )  || params [ 0 ] == playerid )
		return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( p_info [ params [ 0 ] ] [ subleader ] != p_info [ playerid ] [ subleader ] )
		return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не состоит в Вашем подразделении." ) ;
	if ( is_text_invalid ( params [ 1 ] ) )
		return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Причина содержит некорректные символы." ) ;


	new scm_string [ 128 ], _unit_id = p_info [ params [ 0 ] ] [ subleader ] ;
	format ( scm_string, 128, "%s выгнал Вас из подразделения. Причина: {ffffff}%s", p_info [ playerid ] [ name ], params [ 1 ] ) ;
	SendClientMessage ( params [ 0 ], col_wavy, scm_string ) ;
	format ( scm_string, 128, "Вы выгнали %s из подразделения. Причина: {ffffff}%s", p_info [ params [ 0 ] ] [ name ], params [ 1 ] ) ;
	SendClientMessage ( playerid, col_wavy, scm_string ) ;

	format ( scm_string, 128, "Выгнал(а) %s из подразделения. Причина: %s", p_info [ params [ 0 ] ] [ name ], params [ 1 ] ) ;
	write_fraction ( playerid, p_info [ playerid ] [ member ], TYPE_LOG_UVAL, scm_string ) ;

	unit_info [ _unit_id - 1 ] [ u_members ] -- ;
	format ( scm_string, 128, "UPDATE `unit_settings` SET `unit_members` = '%d' WHERE `unit_id` = '%d' LIMIT 1", unit_info [ _unit_id - 1 ] [ u_members ], _unit_id ) ;
	mysql_tquery ( sql_connection, scm_string ) ;

	p_info [ params [ 0 ] ] [ subleader ] = 0 ;
	format ( scm_string, sizeof scm_string, "UPDATE `fractions_players` SET `u_subleader` = '0' WHERE `u_sql_id` = '%d' LIMIT 1", p_info [ params [ 0 ] ] [ id ] ) ;
	mysql_tquery ( sql_connection, scm_string ) ;
	return 1 ;
}

CMD:uoffmembers ( playerid )
{
    if ( p_info [ playerid ] [ member ] < 1 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не состоите в организации." ) ;
	if ( p_info [ playerid ] [ subleader ] < 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не состоите в подразделении." ) ;

	if ( strcmp ( unit_info [ p_info [ playerid ] [ subleader ] - 1 ] [ u_leader ], p_info [ playerid ] [ name ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не являетесь лидером подразделения." ) ;

    unitMembersOffline ( playerid, 0, 1 ) ;
	return 1 ;
}

alias:ufind("umembers")
CMD:ufind ( playerid, params [ ] )
{
    if ( p_info [ playerid ] [ member ] < 1 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не состоите в организации." ) ;
	if ( p_info [ playerid ] [ subleader ] < 1 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не состоите в подразделении." ) ;

    ULoadAllMembers ( playerid, p_info [ playerid ] [ subleader ] ) ;
	return 1 ;
}

callback: load_online_today ( playerid )
{
	new rows, fields ;
    cache_get_data ( rows, fields ) ;
    if ( ! rows )
	{
		p_info [ playerid ] [ online_player ] [ 0 ] =
		p_info [ playerid ] [ online_player_afk ] [ 0 ] = 0 ;

		check_today_time [ playerid ] = false ;
	}
	else
	{
		p_info [ playerid ] [ online_player ] [ 0 ] = cache_get_field_content_int ( 0, "online_sec", sql_connection ) ;
		p_info [ playerid ] [ online_player_afk ] [ 0 ] = cache_get_field_content_int ( 0, "afk_sec", sql_connection ) ;

		check_today_time [ playerid ] = true ;
	}

	new sql_string [ 144 ] ;
	format ( sql_string, sizeof sql_string, "SELECT `online_sec`, `afk_sec` FROM `users_online` WHERE (date >= (CURDATE()-1) AND date < CURDATE()) AND accountid = %d LIMIT 1", p_info [ playerid ] [ id ] ) ;
	mysql_tquery ( sql_connection, sql_string, "load_online_yesterday", "i", playerid ) ;
    return 1 ;
}

callback: load_online_yesterday ( playerid )
{
	new rows, fields ;
    cache_get_data ( rows, fields ) ;
	if ( ! rows )
	{
		p_info [ playerid ] [ online_player ] [ 1 ] =
		p_info [ playerid ] [ online_player_afk ] [ 1 ] = 0 ;
	}
	else
	{
  		p_info [ playerid ] [ online_player ] [ 1 ] = cache_get_field_content_int ( 0, "online_sec", sql_connection ) ;
		p_info [ playerid ] [ online_player_afk ] [ 1 ] = cache_get_field_content_int ( 0, "afk_sec", sql_connection ) ;
	}

	new sql_string [ 70 + 9 ] ;
	format ( sql_string, sizeof sql_string, "SELECT `id` FROM `users_tickets` WHERE `u_id` = '%d' LIMIT 30", p_info [ playerid ] [ id ] ) ;
	mysql_tquery ( sql_connection, sql_string, "callback_ticket_player", "i", playerid ) ;
    return 1 ;
}

