callback: Stripper_Animation ( actorid, type )
{
	if ( type == 1 && actor_info [ actorid ] [ ACTOR_TIME ] < gettime ( ) )
	{
	    new Random_Animation = random ( 21 ) ;
		if ( Random_Animation == 20 )
		{
			ApplyActorAnimation(actorid, "STRIP", "strip_E", 4.1, 1, 0, 0, 0, 0);
			SetTimerEx("Stripper_Animation", 4000, 0, "dd", actorid, type);
		}
		if ( 18 <= Random_Animation <= 19 )
		{
			ApplyActorAnimation(actorid, "STRIP", "strip_D", 4.1, 1, 0, 0, 0, 0);
			SetTimerEx("Stripper_Animation", 3000, 0, "dd", actorid, type);
		}
		if ( 15 <= Random_Animation <= 17 )
		{
			ApplyActorAnimation(actorid, "STRIP", "strip_F", 4.1, 1, 0, 0, 0, 0);
			SetTimerEx("Stripper_Animation", 2000, 0, "dd", actorid, type);
		}
		if ( 12 <= Random_Animation <= 14 )
		{
			ApplyActorAnimation(actorid, "STRIP", "strip_G", 4.1, 1, 0, 0, 0, 0);
			SetTimerEx("Stripper_Animation", 3500, 0, "dd", actorid, type);
		}
		if ( 8 <= Random_Animation <= 11 )
		{
			ApplyActorAnimation(actorid, "STRIP", "strip_C", 4.1, 1, 0, 0, 0, 0);
			SetTimerEx("Stripper_Animation", 2000, 0, "dd", actorid, type);
		}
		if ( 4 <= Random_Animation <= 7 )
		{
			ApplyActorAnimation(actorid, "STRIP", "strip_B", 4.1, 1, 0, 0, 0, 0);
			SetTimerEx("Stripper_Animation", 2000, 0, "dd", actorid, type);
		}
		if ( 0 <= Random_Animation <= 3 )
		{
			ApplyActorAnimation(actorid, "STRIP", "strip_A", 4.1, 1, 0, 0, 0, 0);
			SetTimerEx("Stripper_Animation", 3000, 0, "dd", actorid, type);
		}
	}
	else if ( type == 2 )
	{
	    if ( actor_info [ actorid ] [ ACTOR_TIME ] < gettime ( ) ) Stripper_Animation ( actorid, 3 ) ;
	    else
	    {
			new Random_Animation = random ( 6 ) ;
			if(Random_Animation == 5)
			{
				ApplyActorAnimation(actorid, "STRIP", "STR_B2C", 4.1, 1, 0, 0, 0, 0);
				SetTimerEx("Stripper_Animation", 4500, 0, "dd", actorid, 3);
			}
			if(3 <= Random_Animation <= 4)
			{
				ApplyActorAnimation(actorid, "STRIP", "STR_Loop_A", 4.1, 1, 0, 0, 0, 0);
				SetTimerEx("Stripper_Animation", 2000, 0, "dd", actorid, type);
			}
			if(0 <= Random_Animation <= 2)
			{
				ApplyActorAnimation(actorid, "STRIP", "STR_Loop_B", 4.1, 1, 0, 0, 0, 0);
				SetTimerEx("Stripper_Animation", 2000, 0, "dd", actorid, type);
			}
		}
	}
	else if ( type == 3 )
	{
	    if ( actor_info [ actorid ] [ ACTOR_TIME ] < gettime ( ) )
	    {
	        ApplyActorAnimation(actorid, "STRIP", "STR_C2B", 4.1, 1, 0, 0, 0, 0 ) ;
			SetTimerEx("Stripper_Animation", 1000, 0, "dd", actorid, 1 ) ;
	    }
	    else
	    {
			new Random_Animation = random ( 4 ) ;
			if ( Random_Animation == 3 )
			{
				ApplyActorAnimation(actorid, "STRIP", "STR_C1", 4.1, 1, 0, 0, 0, 0 ) ;
				SetTimerEx("Stripper_Animation", 5500, 0, "dd", actorid, type ) ;
			}
			if ( Random_Animation == 2 )
			{
				ApplyActorAnimation(actorid, "STRIP", "STR_C2", 4.1, 1, 0, 0, 0, 0 ) ;
				SetTimerEx("Stripper_Animation", 5500, 0, "dd", actorid, type ) ;
			}
			if ( 0 <= Random_Animation <= 1 )
			{
				ApplyActorAnimation(actorid, "STRIP", "STR_Loop_C", 4.1, 1, 0, 0, 0, 0 ) ;
				SetTimerEx("Stripper_Animation", 4500, 0, "dd", actorid, type ) ;
			}
		}
	}
	return 1 ;
}

stock find_answer ( playerid, ask [ ] )
{
	for ( new A = 0 ; A != strlen ( ask ) ; A ++ )
    {
		switch ( ask [ A ] )
		{
			case 'А'..'Я': ask [ A ] = ask [ A ] + 32 ;
		}
	}
 	if(strfind(ask, "как", true) != -1 || strfind(ask, "куда", true) != -1)
	{
		//if(strfind(ask, "добраться", true) != -1 && strfind(ask, "до", true) != -1 || strfind(ask, "доехать", true) != -1 && strfind(ask, "до", true) != -1) return 1 ;
		if(strfind(ask, "узнат", true) != -1 || strfind(ask, "посмотрет", true) != -1 || strfind(ask, "показат", true) != -1 || strfind(ask, "передат", true) != -1)
		{
			if(strfind(ask, "лиценз", true) != -1) return 8 ;
			if(strfind(ask, "мед", true) != -1) return 28 ;
			if(strfind(ask, "пасп", true) != -1 || strfind(ask, "удостовер", true) != -1) return 43 ;
			if(strfind(ask, "деньги", true) != -1) return 121 ;
			if(strfind(ask, "адвокат", true) != -1 || strfind(ask, "такс", true) != -1 || strfind(ask, "механик", true) != -1 || strfind(ask, "врач", true) != -1) return 127 ;
			if(strfind(ask, "контакт", true) != -1 || strfind(ask, "кантакт", true) != -1) return 132 ;
			if(strfind(ask, "воен", true) != -1 && (strfind(ask, "билет", true) != -1 || strfind(ask, "белет", true) != -1)) return 141 ;
			if(strfind(ask, "труд", true) != -1 && (strfind(ask, "кни", true) != -1 || strfind(ask, "кин", true) != -1)) return 144 ;
		}

		if((strfind(ask, "вкл", true) != -1 || strfind(ask, "выкл", true) != -1) && strfind(ask, "тел", true) != -1) return 132 ;

		if ( ( strfind(ask, "устроиться", true) != -1 || strfind(ask, "устроится", true) != -1 ) &&
			( strfind(ask, "инкас", true) != -1 || strfind(ask, "такси", true) != -1 || strfind(ask, "механ", true) != -1 || strfind(ask, "водител", true) != -1 || strfind(ask, "развоз", true) != -1 ) ) return 5 ;

		if ( strfind(ask, "узнат", true) != -1 || strfind(ask, "посмотрет", true) != -1 )
		{
			if(strfind(ask, "свой", true) != -1 && strfind(ask, "номер", true) != -1) return 12 ;
			if(strfind(ask, "номер", true) != -1 && (strfind(ask, "счет", true) != -1 || strfind(ask, "счёт", true) != -1)) return 117 ;
			if((strfind(ask, "счет", true) != -1 || strfind(ask, "счёт", true) != -1) && strfind(ask, "банк", true) != -1) return 117 ;
			if(strfind(ask, "номер", true) != -1) return 13 ;
			if(strfind(ask, "ско", true) != -1 && strfind(ask, "отыгр", true) != -1) return 125 ;
			if(strfind(ask, "адвокат", true) != -1 || strfind(ask, "такс", true) != -1 || strfind(ask, "механик", true) != -1) return 127 ;
		}

		if(strfind(ask, "получит", true) != -1)
		{
			if( strfind(ask, "пасп", true) != -1 ) return 44 ;
		}

		if(strfind(ask, "снят", true) != -1)
		{
			if ( strfind(ask, "выг", true) != -1 || strfind(ask, "варн", true) != -1 || strfind(ask, "пред", true) != -1 )
			{
			    show_dialog ( playerid, d_report_vig, DIALOG_STYLE_LIST, "{"#cBHD"}Снятие выговора", "{"#cBL"}1. {"#cWH"}Снять выговор в организации\n{"#cBL"}2. {"#cWH"}Снять варн", "Выбрать", "Закрыть" ) ;
			    return 142 ;
			}
		}

		if(strfind(ask, "вызват", true) != -1 || strfind(ask, "звон", true) != -1)
		{
			if(strfind(ask, "полиц", true) != -1 || strfind(ask, "такс", true) != -1) return 19 ;
		}
		if(strfind(ask, "передат", true) != -1 || strfind(ask, "передават", true) != -1 || strfind(ask, "подар", true) != -1 || strfind(ask, "дать", true) != -1)
		{
			if(strfind(ask, "предмет", true) != -1 || strfind(ask, "деньги", true) != -1) return 9 ;
			if(strfind(ask, "оруж", true) != -1 || strfind(ask, "цвет", true) != -1) return 75 ;
			if(strfind(ask, "аптеч", true) != -1) return 95 ;
			if(strfind(ask, "нарко", true) != -1) return 130 ;
			if(strfind(ask, "патрон", true) != -1) return 138 ;
		}

		if(strfind(ask, "выкин", true) != -1 || strfind(ask, "выброс", true) != -1 || strfind(ask, "выбрас", true) != -1)
		{
			if(strfind(ask, "нарко", true) != -1) return 76 ;
		}

		if(strfind(ask, "донатит", true) != -1) return 108 ;

		if(strfind(ask, "собр", true) != -1 || strfind(ask, "сдел", true) != -1 || strfind(ask, "здел", true) != -1 || strfind(ask, "крафт", true) != -1)
		{
