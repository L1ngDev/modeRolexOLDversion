			        DeletePVar ( playerid, "_checkpoint_id" ) ;

			        GetPlayerPos ( playerid, bus_info [ _checkpoint_id ] [ bus_position ] [ 0 ], bus_info [ _checkpoint_id ] [ bus_position ] [ 1 ], bus_info [ _checkpoint_id ] [ bus_position ] [ 2 ] ) ;
			        GetPlayerFacingAngle ( playerid, bus_info [ _checkpoint_id ] [ bus_position ] [ 3 ] ) ;

			        new query_string [ 176 ] ;
					format ( query_string, sizeof ( query_string ), "UPDATE `bus_settings` SET `b_pos_x` = '%f', `b_pos_y` = '%f', `b_pos_z` = '%f', `b_pos_a` = '%f' WHERE `b_id` = '%d' LIMIT 1",
					bus_info [ _checkpoint_id ] [ bus_position ] [ 0 ],
					bus_info [ _checkpoint_id ] [ bus_position ] [ 1 ],
					bus_info [ _checkpoint_id ] [ bus_position ] [ 2 ],
					bus_info [ _checkpoint_id ] [ bus_position ] [ 3 ],
					bus_info [ _checkpoint_id ] [ bus_id ] ) ;
