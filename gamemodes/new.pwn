CMD:resetweapon ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 3 )return 1 ;
	if (sscanf ( params, "ud", params [ 0 ], params [ 1 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /resetweapon [ид] [оружие]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( params [ 1 ] < 1 || params [ 1 ] > 46 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Не правильно указан ID оружия." ) ;

	new scm_string [ 96 + MAX_PLAYER_NAME ] ;
	format ( scm_string, sizeof ( scm_string  ),"{"#cBAdmin"}[A] {"#cGRAdmin"}%s забрал у %s оружие. (%d | %d)", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], params [ 1 ], p_t_info [ playerid ] [ p_gun_ammo ] [ get_weapon_slot ( params [ 1 ] ) ] ) ;
	foreach(new i: admin_players) SendClientMessage ( i, col_admin, scm_string ) ;

 	give_weapon ( params [ 0 ], params [ 1 ], -p_t_info [ params [ 0 ] ] [ p_gun_ammo ] [ get_weapon_slot ( params [ 1 ] ) ] ) ;
	return 1 ;
}

CMD:weapondata ( playerid, params [ ] )
{
	if ( ! admin_info [ playerid ] [ admin ] )return 1 ;
	if (sscanf ( params, "u", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /weapondata [ид]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;

	new pl_ammo, pl_gun, pl_slot = get_weapon_slot ( GetPlayerWeapon ( params [ 0 ] )  ) ;
	GetPlayerWeaponData(playerid, pl_slot, pl_gun, pl_ammo ) ;

	new scm_string [ 128 ] ;
	format ( scm_string, sizeof ( scm_string  ),"{"#cBL"}%s{FFFFFF} [{"#cBL"}%d{FFFFFF}] | REAL DATA: {"#cBL"}%d %d{FFFFFF} | SERVER DATA: {"#cBL"}%d %d", p_info [ params [ 0 ] ] [ name ], params [ 0 ], pl_gun, pl_ammo, p_t_info [ params [ 0 ] ] [ p_gun_slot ] [ pl_slot ], p_t_info [ params [ 0 ] ] [ p_gun_ammo ] [ pl_slot ] ) ;
	SendClientMessage ( playerid, col_white, scm_string ) ;
	return 1 ;
}

CMD:changeskin ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 7 )return 1 ;
	if (sscanf ( params, "ud", params [ 0 ], params [ 1 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /changeskin [ид] [скин]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( admin_info [ playerid ] [ dostup ] [ 0 ] != 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет доступа к данной команде. Используйте /donate." ) ;
	if ( params [ 1 ] == 74 || params [ 1 ] == 267 || params [ 1 ] == 268 || params [ 1 ] == 269 || params [ 1 ] == 270 || params [ 1 ] == 271 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /skin [ид] [скин]" ) ;
	if ( ! getValidReplacableSkinModel ( params [ 1 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /changeskin [ид] [скин]" ) ;

	new scm_string [ 128 ] ;
	format ( scm_string, sizeof ( scm_string  ),"Администратор %s выдал вам новый скин.", p_info [ playerid ] [ name ] ) ;
	SendClientMessage ( params [ 0 ], col_gray, scm_string ) ;
	format ( scm_string, sizeof ( scm_string  ),"{"#cBAdmin"}[A] {"#cGRAdmin"}%s выдал игроку %s постоянный скин %d", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], params [ 1 ] ) ;
	admin_message ( 5, col_admin, scm_string ) ;

	set_skin ( params [ 0 ], params [ 1 ] ) ;

	format ( scm_string, sizeof scm_string, "%s изменил скин %s на %d", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], params [ 1 ] ) ;
	WriteLog ( playerid, TYPE_LOG_SKIN, scm_string ) ;
	return 1 ;
}

CMD:skin ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 5 && ! tester_admin [ playerid ] ) return 1 ;
	if ( sscanf ( params, "ud", params [ 0 ], params [ 1 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /skin [ид] [скин]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( ! tester_admin [ playerid ] && admin_info [ playerid ] [ dostup ] [ 0 ] != 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет доступа к данной команде. Используйте /donate." ) ;
	if ( params [ 1 ] == 74 || params [ 1 ] == 267 || params [ 1 ] == 268 || params [ 1 ] == 269 || params [ 1 ] == 270 || params [ 1 ] == 271 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /skin [ид] [скин]" ) ;
	if ( ! getValidReplacableSkinModel ( params [ 1 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /skin [ид] [скин]" ) ;

	new scm_string [ 128 ] ;
	format ( scm_string, sizeof ( scm_string  ),"Администратор %s[%i] выдал Вам временный скин #%i.", p_info [ playerid ] [ name ], playerid, params [ 1 ] ) ;
	SendClientMessage ( params [ 0 ], col_gray, scm_string ) ;
	format ( scm_string, sizeof ( scm_string  ),"{"#cBAdmin"}[A] {"#cGRAdmin"}%s[%d] выдал временный скин игроку %s[%d]", p_info [ playerid ] [ name ], playerid, p_info [ params [ 0 ] ] [ name ], params [ 0 ] ) ;
	admin_message ( 5, col_admin, scm_string ) ;
	SetPlayerSkin ( params [ 0 ], params [ 1 ] ) ;

	format ( scm_string, sizeof scm_string, "%s изменил скин %s на %d", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], params [ 1 ] ) ;
	WriteLog ( playerid, TYPE_LOG_SKIN, scm_string ) ;
	return 1 ;
}

CMD:aad ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 6 )return 1 ;
	if ( sscanf( params, "s[108]", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /aad [текст]" ) ;
	if ( check_advertise ( playerid, params [ 0 ], report_type_aad ) && admin_info [ playerid ] [ admin ] < 8 ) return true ;
	if ( reload_admin_warning ( playerid, params [ 0 ] ) ) return 1 ;

	new scm_string [ 144 ] ;
	format ( scm_string, sizeof ( scm_string  ),"Администратор %s: %s ", p_info [ playerid ] [ name ], params [ 0 ] ) ;
	foreach(new i: logged_players) SendClientMessage ( i, col_lorange, scm_string ) ;

	format ( scm_string, sizeof scm_string, "(/aad) %s: %s", p_info [ playerid ] [ name ], params [ 0 ] ) ;
	WriteLog ( playerid, TYPE_LOG_ADMIN, scm_string ) ;
	return true ;
}
alias:aad("msg")

alias:connections("conip")
CMD:connections ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 6 )return 1 ;
	if ( sscanf ( params, "d", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /connections [номер аккаунта]" ) ;

	new sql_string [ 121 ] ;
	format ( sql_string, sizeof sql_string, "SELECT * FROM `users_history` WHERE `uh_user` = '%d' ORDER BY `users_history`.`uh_id` DESC LIMIT 30", params [ 0 ] ) ;
	mysql_tquery ( sql_connection, sql_string, "adminload_user_history", "i", playerid ) ;
	return 1 ;
}

callback: adminload_user_history ( playerid )
{
	new rows,
		fields ;
	cache_get_data ( rows, fields ) ;
	if ( rows )
	{
		global_string [ 0 ] = EOS ;

		for ( new i = 0 ; i < 10 ; i ++ )
		{
		    if ( i >= rows ) break ;

			new uh_ip [ 16 ],
				uh_date [ 22 ] ;

			new line_string [ 62 ] ;

			cache_get_field_content ( i, "uh_ip", uh_ip, sql_connection, 16 ) ;
			cache_get_field_content ( i, "uh_date", uh_date, sql_connection, 22 ) ;

			format ( line_string, sizeof ( line_string ), "{"#cGRDialog"}%d.{"#cWH"}\t%s\t%s\n",
															i + 1,
															uh_date,
															uh_ip ) ;
			strcat ( global_string, line_string ) ;
		}
		show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}История подключений", global_string, "Назад", "" ) ;
	}
	if ( ! rows )
	{
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}История подключений отсутствует, попробуйте позже." ) ;
		return 1 ;
	}
	return 1 ;
}

stock offmembers_rank ( playerid, value_rank, pl_name [ ], type )
{
	if ( type == 0 )
	{
	    new fraction_id ;
	  	if ( p_info [ playerid ] [ leader ] ) fraction_id = p_info [ playerid ] [ member ] ;
		else fraction_id = player_settings { playerid } ;

	    new _pl_id, _text_string [ 144 ] ;
		sscanf ( pl_name, "u", _pl_id ) ;
		if ( IsPlayerConnected ( _pl_id ) )
		{
		    if ( playerid == _pl_id )
		    {
  				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете применить это действие к себе." ) ;

                show_offmembers_dialog ( playerid, pl_name, 0 ) ;
				return 1 ;
		    }

    		if ( p_info [ _pl_id ] [ org_date ] < 3 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не отыграл 3 часа в организации." ) ;

			p_info [ _pl_id ] [ rank ] = value_rank ;
			format ( _text_string, sizeof _text_string, "{"#cBL"}%s{FFFFFF} изменил(а) Вам ранг на {"#cBL"}%d{FFFFFF}.", p_info [ playerid ] [ name ], value_rank ) ;
			SendClientMessage ( _pl_id, col_white, _text_string ) ;
		}
        else
		{
			new query_string [ 59 + MAX_PLAYER_NAME ] ;
			format ( query_string, sizeof ( query_string ), "SELECT `u_id` FROM `users` WHERE `u_name` = '%s' LIMIT 1", pl_name ) ;
			mysql_tquery ( sql_connection, query_string, "callback_off_message", "iiis", playerid, 1, value_rank, "none" ) ;
		}

		format ( _text_string, sizeof _text_string, "Вы изменили ранг {"#cBL"}%s{FFFFFF} на {"#cBL"}%d{FFFFFF}.", pl_name, value_rank ) ;
		SendClientMessage ( playerid, col_white, _text_string ) ;

		format ( _text_string, 128, "Изменил(а) ранг %s на %d (OFF)", pl_name, value_rank ) ;
		write_fraction ( playerid, fraction_id, TYPE_LOG_AGIVERANK, _text_string ) ;
	}
	else if ( type == 1 )
	{
	    #if defined m_familys
	        familys_offmembers_rank ( playerid, value_rank, pl_name ) ;
	    #endif
	}
	else if ( type == 11 )
	{
	    new _pl_id, _text_string [ 144 ] ;
		sscanf ( pl_name, "u", _pl_id ) ;
		if ( IsPlayerConnected ( _pl_id ) )
		{
		    if ( playerid == _pl_id )
		    {
  				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете применить это действие к себе." ) ;

                show_offmembers_dialog ( playerid, pl_name, 12 ) ;
				return 1 ;
		    }
			p_info [ _pl_id ] [ rank ] = value_rank ;
			format ( _text_string, sizeof _text_string, "{"#cBL"}%s{FFFFFF} изменил(а) Вам ранг на {"#cBL"}%d{FFFFFF}.", p_info [ playerid ] [ name ], value_rank ) ;
			SendClientMessage ( _pl_id, col_white, _text_string ) ;
		}
        else
		{
			new query_string [ 59 + MAX_PLAYER_NAME ] ;
			format ( query_string, sizeof ( query_string ), "SELECT `u_id` FROM `users` WHERE `u_name` = '%s' LIMIT 1", pl_name ) ;
			mysql_tquery ( sql_connection, query_string, "callback_off_message", "iiis", playerid, 1, value_rank, "none" ) ;
		}

		format ( _text_string, sizeof _text_string, "Вы изменили ранг {"#cBL"}%s{FFFFFF} на {"#cBL"}%d{FFFFFF}.", pl_name, value_rank ) ;
		SendClientMessage ( playerid, col_white, _text_string ) ;

		format ( _text_string, 128, "Изменил(а) ранг %s на %d (OFF)", pl_name, value_rank ) ;
		write_fraction ( playerid, p_info [ playerid ] [ member ], TYPE_LOG_AGIVERANK, _text_string ) ;
	}
	return 1 ;
}

stock offuninvite_check ( playerid, pl_name [ ], type, scm_uninvite [ ] )
{
	if ( type == 1 )
	{
		/*#if defined m_teams
		    teams_offuninvite_check ( playerid, pl_name ) ;
		#endif*/
	}
	else if ( type == 2 )
	{
	    new _pl_id, query_string [ 256 ] ;
		sscanf ( pl_name, "u", _pl_id ) ;
		if ( IsPlayerConnected ( _pl_id ) )
		{
		    if ( playerid == _pl_id )
		    {
		    	SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете применить это действие к себе." ) ;
				membersUnitOffline ( playerid, page_count [ playerid ], 1 ) ;
    			return 1 ;
		    }
			p_info [ _pl_id ] [ subleader ] = 0 ;
			format ( query_string, 144, "{"#cBL"}%s{FFFFFF} уволил(а) Вас из подразделения.", p_info [ playerid ] [ name ] ) ;
			SendClientMessage ( _pl_id, col_white, query_string ) ;
		}
		else
		{
			new query_string1 [ 59 + MAX_PLAYER_NAME ] ;
			format ( query_string1, sizeof ( query_string1 ), "SELECT `u_id` FROM `users` WHERE `u_name` = '%s' LIMIT 1", pl_name ) ;
			mysql_tquery ( sql_connection, query_string1, "callback_off_message", "iiis", playerid, 2, 1, "none" ) ;
		}

		format ( query_string, 144, "Вы уволили {"#cBL"}%s{FFFFFF} из подразделения.", pl_name ) ;
		SendClientMessage ( playerid, col_white, query_string ) ;

		format ( query_string, 128, "Уволил(а) из подразделения %s.", pl_name ) ;
		write_fraction ( playerid, p_info [ playerid ] [ member ], TYPE_LOG_UVAL, query_string ) ;

	    new _unit_id = get_player_use_listitem ( playerid ) ;
	    if ( _unit_id > 0 )
	    {
			unit_info [ _unit_id - 1 ] [ u_members ] -- ;
			format ( query_string, 128, "UPDATE `unit_settings` SET `unit_members` = '%d' WHERE `unit_id` = '%d' LIMIT 1", unit_info [ _unit_id - 1 ] [ u_members ], _unit_id ) ;
			mysql_tquery ( sql_connection, query_string ) ;
		}

		membersUnitOffline ( playerid, page_count [ playerid ], 1 ) ;
	}
	else if ( type == 3 )
	{
	    new _pl_id, query_string [ 256 ] ;
		sscanf ( pl_name, "u", _pl_id ) ;
		if ( IsPlayerConnected ( _pl_id ) )
		{
		    if ( playerid == _pl_id )
		   	{
		   		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете применить это действие к себе." ) ;

		        unitMembersOffline ( playerid, page_count [ playerid ], 1 ) ;
		     	return 1 ;
		    }
			p_info [ _pl_id ] [ subleader ] = 0 ;
			format ( query_string, 144, "{"#cBL"}%s{FFFFFF} уволил(а) Вас из подразделения.", p_info [ playerid ] [ name ] ) ;
			SendClientMessage ( _pl_id, col_white, query_string ) ;
		}
		else
		{
		    new query_string1 [ 59 + MAX_PLAYER_NAME ] ;
			format ( query_string1, sizeof ( query_string1 ), "SELECT `u_id` FROM `users` WHERE `u_name` = '%s' LIMIT 1", pl_name ) ;
			mysql_tquery ( sql_connection, query_string1, "callback_off_message", "iiis", playerid, 2, 1, "none" ) ;
		}

		format ( query_string, 144, "Вы уволили {"#cBL"}%s{FFFFFF} из подразделения.", pl_name ) ;
		SendClientMessage ( playerid, col_white, query_string ) ;

		format ( query_string, 128, "Уволил(а) из подразделения %s.", pl_name ) ;
		write_fraction ( playerid, p_info [ playerid ] [ member ], TYPE_LOG_UVAL, query_string ) ;

		new _unit_id = p_info [ playerid ] [ subleader ] ;
		unit_info [ _unit_id - 1 ] [ u_members ] -- ;
		format ( query_string, 128, "UPDATE `unit_settings` SET `unit_members` = '%d' WHERE `unit_id` = '%d' LIMIT 1", unit_info [ _unit_id - 1 ] [ u_members ], _unit_id ) ;
		mysql_tquery ( sql_connection, query_string ) ;

		unitMembersOffline ( playerid, page_count [ playerid ], 1 ) ;
		return 1 ;
	}
	else if ( type == 4 )
	{
	    new _pl_id, query_string [ 256 ] ;
		sscanf ( pl_name, "u", _pl_id ) ;
		if ( IsPlayerConnected ( _pl_id ) )
		{
		  	if ( playerid == _pl_id )
		    {
		        SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете применить это действие к себе." ) ;

				DeletePVar( playerid, "ofm_listitem" ) ;
				if( ! GetPVarInt ( playerid, "ofm_type" ) )
				{
					mysql_format ( sql_connection, query_string, sizeof query_string, "SELECT `u_name`,`u_played_time`,`u_business_rang`,`u_bworker` FROM `users` WHERE `u_bworker` = '%d'", p_info [ playerid ] [ business ] ) ;
					mysql_tquery ( sql_connection, query_string, "callback_offbusiness", "i", playerid ) ;
					return 1;
				}
				mysql_format ( sql_connection, query_string, sizeof query_string, "SELECT `u_name`,`u_played_time`,`u_business_rang`,`u_bworker` FROM `users` WHERE `u_bworker` = '%d'", p_info [ playerid ] [ business ] ) ;
				mysql_tquery ( sql_connection, query_string, "callback_offbusiness", "i", playerid ) ;
    			return 1 ;
		    }
			p_info [ _pl_id ] [ b_worker ] = -1 ;
			p_info [ _pl_id ] [ business_rang ] = 0 ;

			Iter_Remove(business_players[p_info [ playerid ] [ business ]], _pl_id ) ;

			format ( query_string, 144, "{"#cBL"}%s{FFFFFF} уволил(а) Вас.", p_info [ playerid ] [ name ] ) ;
			SendClientMessage ( _pl_id, col_white, query_string ) ;
		}
		else
		{
			new query_string1 [ 59 + MAX_PLAYER_NAME ] ;
			format ( query_string1, sizeof ( query_string1 ), "SELECT `u_id` FROM `users` WHERE `u_name` = '%s' LIMIT 1", pl_name ) ;
			mysql_tquery ( sql_connection, query_string1, "callback_off_message", "iiis", playerid, 3, 1, "none" ) ;
		}

		format ( query_string, 144, "UPDATE `users` SET `u_bworker` = '-1',`u_business_rang` = '0' WHERE `u_name` = '%s' LIMIT 1", pl_name ) ;
		mysql_tquery ( sql_connection, query_string, "", "" ) ;

		format ( query_string, 144, "Вы уволили сотрудника {"#cBL"}%s{FFFFFF}.", pl_name ) ;
		SendClientMessage ( playerid, col_white, query_string ) ;

		DeletePVar( playerid, "ofm_listitem" ) ;
		if( ! GetPVarInt ( playerid, "ofm_type" ) )
		{
			mysql_format ( sql_connection, query_string, sizeof query_string, "SELECT `u_name`,`u_played_time`,`u_business_rang`,`u_bworker` FROM `users` WHERE `u_bworker` = '%d'", p_info [ playerid ] [ business ] ) ;
			mysql_tquery ( sql_connection, query_string, "callback_offbusiness", "i", playerid ) ;
			return 1 ;
		}
		mysql_format ( sql_connection, query_string, sizeof query_string, "SELECT `u_name`,`u_played_time`,`u_business_rang`,`u_bworker` FROM `users` WHERE `u_bworker` = '%d'", p_info [ playerid ] [ business ] ) ;
		mysql_tquery ( sql_connection, query_string, "callback_offbusiness", "i", playerid ) ;
	}
	else if ( type == 5 )
	{
	    new fraction_id ;
	  	if ( p_info [ playerid ] [ leader ] ) fraction_id = p_info [ playerid ] [ member ] ;
		else fraction_id = player_settings { playerid } ;

	    new _pl_id, query_string [ 256 ] ;
		sscanf ( pl_name, "u", _pl_id ) ;
		if ( IsPlayerConnected ( _pl_id ) )
		{
		   	if ( playerid == _pl_id )
		    {
		      	SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете применить это действие к себе." ) ;

		        membersOffline ( playerid, page_count [ playerid ], 1 ) ;
			    return 1 ;
		    }

		   	new clf_string [ 3 + 24 ] ;
    		format ( clf_string, sizeof clf_string, "%d %s", _pl_id, scm_uninvite ) ;
			callcmd::uninvite ( playerid, clf_string ) ;
			return 1 ;
		}
		else
		{
		   	format ( query_string, sizeof query_string, "{"#cRInfo"}* {"#cGRInfo"}%s уволил(а) Вас из организации!\n\n{"#cRInfo"}* {"#cGRInfo"}Причина: %s", p_info [ playerid ] [ name ], scm_uninvite ) ;

			new query_string1 [ 59 + MAX_PLAYER_NAME ] ;
			format ( query_string1, sizeof ( query_string1 ), "SELECT `u_id` FROM `users` WHERE `u_name` = '%s' LIMIT 1", pl_name ) ;
			mysql_tquery ( sql_connection, query_string1, "callback_off_message", "iiis", playerid, 4, 1, query_string ) ;

			day_uninvite_player [ fraction_id - 1 ] += 1 ;
		}

		new scm_string [ 128 ] ;
		format ( scm_string, sizeof scm_string, "{"#cBAdmin"}[A]{"#cGRAdmin"} %s уволил(а) в оффлайне %s. (Организация: %s)", p_info [ playerid ] [ name ], pl_name, f_info [ fraction_id - 1 ] [ f_name ] ) ;
		admin_message ( 6, col_admin, scm_string ) ;

		format ( scm_string, sizeof scm_string, "{"#cBAdmin"}[A]{"#cGRAdmin"} Причина увольнения: %s", scm_uninvite ) ;
		admin_message ( 6, col_admin, scm_string ) ;

		if ( gang_player ( playerid ) || mafia_player ( playerid ) )
		{
			format ( scm_string, 128, "[F] %s %s выселил(а) %s с района. Причина: %s", f_rank [ fraction_id - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], pl_name, scm_uninvite ) ;
			fraction_message ( p_info [ playerid ] [ member ], col_lblue, scm_string ) ;

			static const _str [ ] = "\
				SELECT \
					fp.u_sql_id, \
					fp.u_rank \
				FROM users u \
				LEFT JOIN fractions_players fp ON fp.u_sql_id=u.u_id \
				WHERE u.u_name = '%s' LIMIT 1" ;
			new sql_string [ sizeof _str + MAX_PLAYER_NAME ] ;
			format ( sql_string, sizeof sql_string, _str, pl_name ) ;
			mysql_tquery ( sql_connection, sql_string, "callback_jobinfo_uninvite", "sii", scm_uninvite, p_info [ playerid ] [ member ], LABOR_TYPE_UNINVITE ) ;
		}
		else
		{
		    format ( scm_string, 128, "[R] %s %s выгнал(а) %s из организации. Причина: %s", f_rank [ fraction_id - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], pl_name, scm_uninvite ) ;
			fraction_message ( fraction_id, col_lblue, scm_string ) ;

			static const _str [ ] = "\
				SELECT \
					fp.u_sql_id, \
					fp.u_rank \
				FROM users u \
				LEFT JOIN fractions_players fp ON fp.u_sql_id=u.u_id \
				WHERE u.u_name = '%s' LIMIT 1" ;
			new sql_string [ sizeof _str + MAX_PLAYER_NAME ] ;
			format ( sql_string, sizeof sql_string, _str, pl_name ) ;
			mysql_tquery ( sql_connection, sql_string, "callback_jobinfo_uninvite", "sii", scm_uninvite, p_info [ playerid ] [ member ], LABOR_TYPE_UNINVITE ) ;
		}

		f_info [ fraction_id - 1 ] [ f_members ] -- ;
		format ( query_string, 144, "UPDATE `fractions` SET `f_members` = '%d' WHERE `f_id` = '%d' LIMIT 1", f_info [ fraction_id - 1 ] [ f_members ], fraction_id ) ;
		mysql_tquery ( sql_connection, query_string ) ;

		format ( query_string, 144, "Вы уволили {"#cBL"}%s{FFFFFF} из организации.", pl_name ) ;
		SendClientMessage ( playerid, col_white, query_string ) ;

		format ( query_string, 128, "Уволил(а) из организации %s (OFF)", pl_name ) ;
		write_fraction ( playerid, fraction_id, TYPE_LOG_UVAL, query_string ) ;

		membersOffline ( playerid, page_count [ playerid ], 1 ) ;
	}
	else if ( type == 6 )
	{
	    #if defined m_familys
		    familys_offuninvite_check ( playerid, pl_name, scm_uninvite ) ;
		#endif
	}
	return 1 ;
}

callback: callback_off_message ( playerid, type_message, value_rank, _text_info [ ] )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;

    new _u_id = cache_get_field_content_int ( 0, "u_id", sql_connection ) ;

    new _text_string [ 144 ] ;
	if ( type_message == 1 )
	{
	    format ( _text_string, sizeof _text_string, "%s изменил(а) Вам ранг в организации на %d!", p_info [ playerid ] [ name ], value_rank ) ;
		insert_debtor_message ( "Организация", _text_string, _u_id ) ;

		format ( _text_string, sizeof _text_string, "UPDATE `fractions_players` SET `u_rank` = '%d' WHERE `u_sql_id` = '%d' LIMIT 1", value_rank, _u_id ) ;
		mysql_tquery ( sql_connection, _text_string ) ;
	}
	else if ( type_message == 2 )
	{
	    format ( _text_string, sizeof _text_string, "%s уволил(а) Вас из подразделения!", p_info [ playerid ] [ name ] ) ;
		insert_debtor_message ( "Организация", _text_string, _u_id ) ;

		format ( _text_string, sizeof _text_string, "UPDATE `fractions_players` SET `u_subleader` = '0' WHERE `u_sql_id` = '%d' LIMIT 1", _u_id ) ;
		mysql_tquery ( sql_connection, _text_string ) ;
	}
	else if ( type_message == 3 )
	{
	    format ( _text_string, sizeof _text_string, "%s уволил(а) Вас с предприятия!", p_info [ playerid ] [ name ] ) ;
		insert_debtor_message ( "Предприятие", _text_string, _u_id ) ;
	}
	else if ( type_message == 4 )
	{
 		insert_debtor_message ( "Организация", _text_info, _u_id ) ;

		format ( _text_string, sizeof _text_string, "DELETE FROM `fractions_players` WHERE `u_sql_id` = '%d' LIMIT 1", _u_id ) ;
		mysql_tquery ( sql_connection, _text_string ) ;
	}
	else if ( type_message == 5 )
	{
	    insert_debtor_message ( "Семья", _text_info, _u_id ) ;
	}
	else if ( type_message == 6 )
	{
	    format ( _text_string, sizeof _text_string, "%s изменил(а) Вам ранг в семье на %d!", p_info [ playerid ] [ name ], value_rank ) ;
		insert_debtor_message ( "Семья", _text_string, _u_id ) ;
	}
	else if ( type_message == 7 )
	{
	    insert_debtor_message ( "Аренда дома", _text_info, _u_id ) ;
	}
	return 1 ;
}

CMD:delacc ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 8 )return 1 ;
	if ( ! IsFounder ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}К сожалению, Вам данная функция не доступна." ) ;
	if ( sscanf ( params,"s[24]", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /delacc [имя]" ) ;

	static const _str [ ] = "SELECT * FROM `users` WHERE `u_name` = '%s' LIMIT 1" ;
	new scm_string [ sizeof _str + 24 ] ;
	format ( scm_string, sizeof ( scm_string  ), _str, params [ 0 ] ) ;
	mysql_tquery ( sql_connection, scm_string, "dellaccount_check_callback", "is", playerid, params [ 0 ] ) ;
	return 1 ;
}

callback: dellaccount_check_callback ( playerid, pl_name [ ] )
{
	new rows, fields;
	cache_get_data ( rows, fields ) ;
	if ( ! rows )
	{
	    static const _str [ ] = "{"#cRInfo"}* {"#cGRInfo"}Аккаунт %s не найден в базе данных." ;
		new scm_string [ sizeof _str + 24 ] ;
		format( scm_string, sizeof ( scm_string ), _str, pl_name ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
		return 1 ;
	}
	else
	{
	    new _u_id = cache_get_field_content_int ( 0, "u_id", sql_connection ) ;

		new query_string [ 144 ] ;

		format ( query_string, sizeof ( query_string ), "SELECT * FROM `houses` WHERE `h_owner` = '%d' LIMIT %d", _u_id, max_h_gold ) ;
		mysql_tquery ( sql_connection, query_string, "dellaccount_prop_h_callback", "" ) ;

		format ( query_string, sizeof ( query_string ), "SELECT * FROM `businesses` WHERE `b_owner_inc` = '%d' LIMIT %d", _u_id, max_biz_gold ) ;
		mysql_tquery ( sql_connection, query_string, "dellaccount_prop_b_callback", "" ) ;

		format ( query_string, sizeof ( query_string ), "SELECT * FROM `cellars` WHERE `cl_owner` = '%d' LIMIT 1", _u_id ) ;
		mysql_tquery ( sql_connection, query_string, "dellaccount_prop_c_callback", "" ) ;

		format ( query_string, sizeof ( query_string ), "DELETE FROM `deposit_boxes` WHERE `db_owner` = '%d' LIMIT %d", _u_id, MAX_BANK_ACCOUNT ) ;
		mysql_tquery ( sql_connection, query_string ) ;

		format ( query_string, sizeof ( query_string ), "DELETE FROM `users_vehicles` WHERE `v_owner` = '%d'", _u_id ) ;
		mysql_tquery ( sql_connection, query_string ) ;

		format ( query_string, sizeof ( query_string ), "DELETE FROM `familys_vehicles` WHERE `v_owner_fam` = '%d'", _u_id ) ;
		mysql_tquery ( sql_connection, query_string ) ;

		format ( query_string, 144, "{"#cBAdmin"}[A] {"#cGRAdmin"}%s[%d] удалил аккаунт %s", p_info [ playerid ] [ name ], playerid, pl_name ) ;
		foreach(new i: admin_players) SendClientMessage ( i, col_admin, query_string ) ;

		format ( query_string, 128, "%s удалил аккаунт %s.", p_info [ playerid ] [ name ], pl_name ) ;
		WriteLog(playerid, TYPE_LOG_ADMIN, query_string);

		format ( query_string, 128, "DELETE FROM `users` WHERE `u_name` = '%s' LIMIT 1", pl_name ) ;
		mysql_tquery ( sql_connection, query_string ) ;
		return 1 ;
	}
}

callback: dellaccount_prop_h_callback ( )
{
	static const _str [ ] = "{"#cBAdmin"}[A] {"#cGRAdmin"}Домов на аукцион: %d." ;
    new query_string [ sizeof _str + 4 ] ;

    new rows, fields;
	cache_get_data ( rows, fields ) ;
	if ( rows )
	{
	    new _h_id [ max_h_gold ] ;
	    for ( new i = 0 ; i < rows ; i ++ )
	   	{
     		_h_id [ i ] = cache_get_field_content_int ( i, "h_id", sql_connection ) ;
	    }
	    for ( new i = 0 ; i < rows ; i ++ )
	    {
	        sell_houses ( _h_id [ i ] - 1, -1, false, true ) ;
	        if ( h_info [ _h_id [ i ] - 1 ] [ h_podezd ] != -1 ) update_podezd ( h_info [ _h_id [ i ] - 1 ] [ h_podezd ] ) ;
	    }
	    format ( query_string, sizeof query_string, _str, rows ) ;
		foreach(new i: admin_players) SendClientMessage ( i, col_admin, query_string ) ;
	}
	return 1 ;
}

callback: dellaccount_prop_b_callback ( )
{
    static const _str [ ] = "{"#cBAdmin"}[A] {"#cGRAdmin"}Бизнесов на аукцион: %d." ;
    new query_string [ sizeof _str + 4 ] ;

    new rows, fields;
	cache_get_data ( rows, fields ) ;
	if (  rows )
	{
	    new _b_id [ max_biz_gold ] ;
 		for ( new i = 0 ; i < rows ; i ++ )
	    {
     		_b_id [ i ] = cache_get_field_content_int ( i, "b_id", sql_connection ) ;
	   	}
	   	for ( new i = 0 ; i < rows ; i ++ )
	    {
		    sell_businesses ( _b_id [ i ] - 1, -1, false, true ) ;
	   	}
	    format ( query_string, sizeof query_string, _str, rows ) ;
		foreach(new i: admin_players) SendClientMessage ( i, col_admin, query_string ) ;
	}
	return 1 ;
}

callback: dellaccount_prop_c_callback ( )
{
    static const _str [ ] = "{"#cBAdmin"}[A] {"#cGRAdmin"}Гаражей на аукцион: %d." ;
    new query_string [ sizeof _str + 4 ] ;

    new rows, fields;
	cache_get_data ( rows, fields ) ;
	if (  rows )
	{
	    for ( new i = 0 ; i < rows ; i ++ )
	   	{
     		new _cl_id = cache_get_field_content_int ( i, "cl_id", sql_connection ) ;

			format ( cellar_info [ _cl_id - 1 ] [ cl_owner_name ], MAX_PLAYER_NAME, "Собственность штата" ) ;

			cellar_info [ _cl_id - 1 ] [ cl_owner ] = -1 ;
			cellar_info [ _cl_id - 1 ] [ cl_closed ] = 0 ;

			save_cellar ( _cl_id - 1 ) ;
   		}
	    format ( query_string, sizeof query_string, _str, rows ) ;
		foreach(new i: admin_players) SendClientMessage ( i, col_admin, query_string ) ;
	}
	return 1 ;
}

CMD:freeze ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 2 )return 1 ;
	if ( sscanf ( params, "u", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /freeze [ид]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( admin_info [ playerid ] [ admin ] < 8 && p_t_info [ params [ 0 ] ] [ last_time_damage_spawn ] > gettime ( ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGR"}Игрок находился / находится в перестрелке." ) ;
	toggle_controlable ( params [ 0 ], false ) ;
	new scm_string [ 128 ] ;
	format ( scm_string, sizeof ( scm_string  ),"{"#cBAdmin"}[A] {"#cGRAdmin"}%s[%d] заморозил игрока %s[%d].", p_info [ playerid ] [ name ], playerid, p_info [ params [ 0 ] ] [ name ], params [ 0 ] ) ;
	foreach(new i: admin_players)SendClientMessage ( i, col_admin, scm_string ) ;
	format ( scm_string, sizeof ( scm_string  ),"Администратор %s заморозил вас.", p_info [ playerid ] [ name ] ) ;
	SendClientMessage ( params [ 0 ], col_gray, scm_string ) ;
	return 1 ;
}

CMD:unfreeze ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 2 )return 1 ;
	if ( sscanf ( params, "u", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /unfreeze [ид]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	toggle_controlable ( params [ 0 ], true ) ;
	new scm_string [ 128 ] ;
	format ( scm_string, sizeof ( scm_string  ),"{"#cBAdmin"}[A] {"#cGRAdmin"}%s[%d] разморозил игрока %s[%d].", p_info [ playerid ] [ name ], playerid, p_info [ params [ 0 ] ] [ name ], params [ 0 ] ) ;
	foreach(new i: admin_players)SendClientMessage ( i, col_admin, scm_string ) ;
	format ( scm_string, sizeof ( scm_string  ),"Администратор %s разморозил вас.", p_info [ playerid ] [ name ] ) ;
	SendClientMessage ( params [ 0 ], col_gray, scm_string ) ;
	return 1 ;
}

CMD:slap ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 2 )return 1 ;
	if ( sscanf ( params, "u", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /slap [ид]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( p_info [ params [ 0 ] ] [ jailed ] > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок в КПЗ." ) ;
	if ( admin_info [ playerid ] [ admin ] < 8 && p_t_info [ params [ 0 ] ] [ last_time_damage_spawn ] > gettime ( ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGR"}Игрок находился / находится в перестрелке." ) ;
	new Float:pl_pos [ 3 ];
	p_t_info [ playerid ] [ p_tp_immune_time ] = 3 ;

	GetPlayerPos ( params [ 0 ], pl_pos [ 0 ], pl_pos [ 1 ], pl_pos [ 2 ] ) ;
	SetPlayerPos ( params [ 0 ], pl_pos [ 0 ], pl_pos [ 1 ], pl_pos [ 2 ] + 6 ) ;
	PlayerPlaySound ( params [ 0 ], 1130, pl_pos [ 0 ], pl_pos [ 1 ], pl_pos [ 2 ] + 6 ) ;
	new scm_string [ 98 ] ;
	format ( scm_string, sizeof ( scm_string  ),"Администратор %s[%d] подкинул Вас.", p_info [ playerid ] [ name ], playerid ) ;
	SendClientMessage ( params [ 0 ], col_gray, scm_string ) ;

	format ( scm_string, sizeof ( scm_string  ),"{"#cBAdmin"}[A] {"#cGRAdmin"}%s[%d] подкинул игрока %s[%d].", p_info [ playerid ] [ name ], playerid, p_info [ params [ 0 ] ] [ name ], params [ 0 ] ) ;
	foreach(new i: admin_players)SendClientMessage ( i, col_admin, scm_string ) ;

	return 1 ;
}

CMD:hp ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 3 )return 1 ;
	if ( sscanf ( params, "u", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /hp [ид]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( admin_info [ playerid ] [ admin ] < 8 && p_t_info [ params [ 0 ] ] [ last_time_damage_spawn ] > gettime ( ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGR"}Игрок находился / находится в перестрелке." ) ;
	set_health ( params [ 0 ], 100 ) ;

	static const _str [ ] = "{"#cBAdmin"}[A] {"#cGRAdmin"}%s[%d] пополнил жизни %s[%d]" ;
	new scm_string [ sizeof _str + 24 + 4 + 24 + 4 ] ;
	format ( scm_string, sizeof ( scm_string  ), _str, p_info [ playerid ] [ name ], playerid, p_info [ params [ 0 ] ] [ name ], params [ 0 ] ) ;
	foreach(new i: admin_players)SendClientMessage ( i, col_admin, scm_string ) ;
//	if ( GetPlayerState ( playerid ) == PLAYER_STATE_DRIVER ) RepairVehicle ( GetPlayerVehicleID ( playerid ) ) ;

	format ( scm_string, sizeof scm_string, "Администратор %s пополнил hp %s", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ] ) ;
	WriteLog ( playerid, TYPE_LOG_ADMIN, scm_string ) ;
	return true ;
}

CMD:sethp ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 8 )return 1 ;
	if ( sscanf ( params, "ud", params [ 0 ], params [ 1 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /sethp [ид] [hp]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( admin_info [ playerid ] [ admin ] < 8 && p_t_info [ params [ 0 ] ] [ last_time_damage_spawn ] > gettime ( ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGR"}Игрок находился / находится в перестрелке." ) ;
	set_health ( params [ 0 ], params [ 1 ] ) ;

	static const _str [ ] = "{"#cBAdmin"}[A] {"#cGRAdmin"}%s[%d] пополнил жизни %s[%d]" ;
	new scm_string [ sizeof _str + 24 + 4 + 24 + 4 ] ;
	format ( scm_string, sizeof ( scm_string  ), _str, p_info [ playerid ] [ name ], playerid, p_info [ params [ 0 ] ] [ name ], params [ 0 ] ) ;
	foreach(new i: admin_players)SendClientMessage ( i, col_admin, scm_string ) ;
	return true ;
}

CMD:gmcheck ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 2 )return 1 ;
	if (sscanf ( params, "u", params [ 0 ]) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /gmcheck [ид]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( pl_afk_time [ params [ 0 ] ] > 2 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок в AFK." ) ;

	new Float:pl_health ;
	GetPlayerHealth ( params [ 0 ], pl_health ) ;
	set_health ( params [ 0 ], pl_health - 5 ) ;

	SetTimerEx ( "check_player_nop", 1400, false, "iif", playerid, params [ 0 ], pl_health ) ;
	return true ;
}

callback:check_player_nop ( playerid, targetid, Float:pl_health )
{
	new Float:new_health, gm_result [ 16 ], scm_string [ 128 ] ;
	GetPlayerHealth ( targetid, new_health ) ;

	if ( new_health == pl_health )format ( gm_result, 16, "обнаружен NOP" ) ;
	else format ( gm_result, 16, "NOP не найден" ) ;

	format ( scm_string, sizeof ( scm_string  ),"{"#cBAdmin"}[A] {"#cGRAdmin"}%s[%d] проверил %s[%d] на GM | Результат: %s", p_info [ playerid ] [ name ], playerid, p_info [ targetid ] [ name ], targetid, gm_result ) ;
	foreach(new i: admin_players)SendClientMessage ( i, col_admin, scm_string ) ;
	return 1 ;
}

CMD:satiety ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 6 )return 1 ;
	if (sscanf ( params, "u", params [ 0 ]) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /satiety [ид]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	p_info [ params [ 0 ] ] [ hunger ] = 100 ;

	static const _str [ ] = "{"#cBAdmin"}[A] {"#cGRAdmin"}%s[%d] пополнил сытость %s[%d]" ;
	new scm_string [ sizeof _str + 24 + 4 + 24 + 4 ] ;
	format ( scm_string, sizeof ( scm_string  ), _str, p_info [ playerid ] [ name ], playerid, p_info [ params [ 0 ] ] [ name ], params [ 0 ] ) ;
	admin_message ( 5, col_admin, scm_string ) ;
	return true ;
}

CMD:fix ( playerid )
{
	if ( admin_info [ playerid ] [ admin ] < 3 && ! tester_admin [ playerid ] ) return 1 ;
	new veh_id = GetPlayerVehicleID ( playerid ) ;
	if ( veh_id == 0 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны находиться в транспорте." ) ;
	veh_info [ veh_id - 1 ] [ v_fuel ] = 60.0 ;
	RepairVehicle ( veh_id ) ;
	return 1 ;
}

CMD:fv ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 3 )return 1 ;
	if ( sscanf ( params, "d", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /fv [ид]" ) ;
	if ( params [ 0 ] < 1 || params [ 0 ] > MAX_VEHICLES ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Автомобиль не найден." ) ;
	RepairVehicle ( params [ 0 ] ) ;

	static const _str [ ] = "{"#cBAdmin"}[A] {"#cGRAdmin"}%s[%d] починил автомобиль | ID: %d" ;
	new scm_string [ sizeof _str + 4 + 24 + 4 ] ;
	format ( scm_string, sizeof ( scm_string  ), _str, p_info [ playerid ] [ name ], playerid, params [ 0 ] ) ;
	admin_message ( 5, col_admin, scm_string ) ;
	return 1 ;
}

