					format ( fm_string, sizeof fm_string, "UPDATE `users_admins` SET `u_a_warning` = '%d' WHERE `u_a_id` = '%d' LIMIT 1", admin_info [ i ] [ warning ], p_info [ i ] [ id ] ) ;
			        mysql_tquery ( sql_connection, fm_string ) ;
				}
