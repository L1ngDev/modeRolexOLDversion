			#endif

			new _forest = DeerInfo [ A ] [ D_Forest ] ;
			if ( ForestPoint [ _forest ] [ 0 ] <= NewPos [ 0 ] <= ForestPoint [ _forest ] [ 2 ]
			&& ForestPoint [ _forest ] [ 1 ] <= NewPos [ 1 ] <= ForestPoint [ _forest ] [ 3 ] )
