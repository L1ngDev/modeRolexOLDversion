stock _SetPlayerPos ( playerid, Float:x, Float:y, Float:z )
{
    #if defined debug_mode
		printf ( "[_SetPlayerPos] playerid: %d", p_info [ playerid ] [ name ] ) ;
	#endif

    playerCheckFly { playerid } = SleepTime ( playerid ) ;
	p_t_info [ playerid ] [ p_tp_immune_time ] = 4 ;

	p_t_info [ playerid ] [ real_pos ] [ 0 ] = x ;
	p_t_info [ playerid ] [ real_pos ] [ 1 ] = y ;
	p_t_info [ playerid ] [ real_pos ] [ 2 ] = z ;

	p_t_info [ playerid ] [ old_pos ] [ 0 ] = x ;
	p_t_info [ playerid ] [ old_pos ] [ 1 ] = y ;
	p_t_info [ playerid ] [ old_pos ] [ 2 ] = z ;
	p_t_info [ playerid ] [ last_alt ] = GetTickCount ( ) ;

	if ( g_phone_call [ playerid ] [ PC_STATUS ] ) SetPlayerSpecialAction ( playerid, SPECIAL_ACTION_USECELLPHONE ) ;

	SetPlayerPos ( playerid, x, y, z ) ;
	return 1 ;
}
#define SetPlayerPos _SetPlayerPos

new ac_kick_count [ 2 ] = { 0, ... } ;
new bool: ac_toggled [ 2 ] = { false, ... } ;
CMD:ac_stats ( playerid )
{
	if ( admin_info [ playerid ] [ admin ] < 8 ) return 1 ;

	new line_string [ 100 ] ;
	format ( line_string, sizeof line_string, "818: %d, toggled: %d, 817: %d, toggled: %d", ac_kick_count [ 0 ], ac_toggled [ 0 ], ac_kick_count [ 1 ], ac_toggled [ 1 ] ) ;
	SendClientMessage ( playerid, col_white, line_string ) ;
	return 1 ;
}

CMD:ac_tog1 ( playerid )
{
	if ( admin_info [ playerid ] [ admin ] < 8 ) return 1 ;

	ac_kick_count [ 0 ] = 0 ;

	if ( ac_toggled [ 0 ] == false ) ac_toggled [ 0 ] = true ;
	else ac_toggled [ 0 ] = false ;
	return 1 ;
}

CMD:ac_tog2 ( playerid )
{
	if ( admin_info [ playerid ] [ admin ] < 8 ) return 1 ;

    ac_kick_count [ 1 ] = 0 ;

	if ( ac_toggled [ 1 ] == false ) ac_toggled [ 1 ] = true ;
	else ac_toggled [ 1 ] = false ;
	return 1 ;
}

stock anti_cheat ( playerid, reason [ 32 ], code )
{
	if ( admin_info [ playerid ] [ admin ] > 0 ) return 1 ;

	if ( player_device { playerid } == 2 )
	{
		if ( code != 16 && code != 999 && code != 818 && code != 817 && code != 998 ) return 1 ;
	}

	if ( code == 818 && ac_toggled [ 0 ] == true ) ac_kick_count [ 0 ] ++ ;
	else if ( code == 818 && ac_toggled [ 0 ] == false )
	{
	    ac_kick_count [ 0 ] ++ ;
	    return 1 ;
	}

	if ( code == 817 && ac_toggled [ 1 ] == true ) ac_kick_count [ 1 ] ++ ;
	else if ( code == 817 && ac_toggled [ 1 ] == false )
	{
	    ac_kick_count [ 1 ] ++ ;
	    return 1 ;
	}

	if ( code == 16 )
	{
	    if ( player_device { playerid } != 2 )
			reset_player_weapon ( playerid ) ;

		else if ( player_device { playerid } == 2 )
		{
			ac_info [ playerid ] = reason ;
			ac_date [ playerid ] = gettime ( ) ;

			new line_string [ 144 ], s_year, s_month, s_day, s_hour, s_minute, s_second ;
			timestamp_to_date ( ac_date [ playerid ] + CONVERT_TIME_TO_MOSCOW, s_year, s_month, s_day, s_hour, s_minute, s_second ) ;

			format ( line_string, 100, "%s", reason ) ;
			AddToWarningPanel ( playerid, line_string, 0 ) ;

			foreach(new i: admin_players)
			{
				if ( admin_info [ i ] [ spectate_id ] == playerid + 1 )
				{
					format ( line_string, sizeof ( line_string ), "%s[%d] добавлен в чит панель. Причина: %s. Время: %02d:%02d:%02d.", p_info [ playerid ] [ name ], playerid, ac_info [ playerid ], s_hour, s_minute, s_second ) ;
					SendClientMessage ( i, col_white, line_string ) ;
				}
			}
			return 1 ;
		}
	}

	new _t_string [ 356 ] ;
	if ( code > ac_type_kick )
	{
	    format(_t_string, 100, "%s", reason);
		AddToWarningPanel(playerid, _t_string, 1);

		new year, month, day, hour, minute, second, mtext [ 11 ] ;

		getdate ( year, month, day ) ;
		gettime ( hour, minute, second ) ;
		FixHour ( hour ) ;
		hour = global_hour ;

		switch ( month )
		{
			case 1: mtext = "Января" ;
			case 2: mtext = "Февраля" ;
			case 3: mtext = "Марта" ;
			case 4: mtext = "Апреля" ;
			case 5: mtext = "Мая" ;
			case 6: mtext = "Июня" ;
			case 7: mtext = "Июля" ;
			case 8: mtext = "Августа" ;
			case 9: mtext = "Сентября" ;
			case 10: mtext = "Октября" ;
			case 11: mtext = "Ноября" ;
			case 12: mtext = "Декабря" ;
		}

		format ( _t_string, sizeof _t_string, "{"#cWH"}Вы были кикнуты системой защиты!\n\
											{"#cWH"}Если Вы считаете, что произошла ошибка,\n\
											{"#cWH"}то сообщите нам: {"#cRD"}"site_name"\n\n\
											{"#cWH"}Код: {"#cRD"}#%d{"#cWH"}\n\
											Сегодняшняя дата: {"#cRD"}%d %s 2024 г{"#cWH"}\n\
											Текущее время: {"#cRD"}%s%d:%s%d{"#cWH"}\n\
											Пинг: {"#cRD"}%d{"#cWH"}\n\n\
											Используйте {"#cRD"}/q{"#cWH"} для выхода.", code, day, mtext, ( hour < 10 ) ? ( "0" ) : (""), hour, ( minute < 10 ) ? ( "0" ) : ( "" ), minute, GetPlayerPing ( playerid ) ) ;
		show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX,"{"#cRD"}Соединение разорвано", _t_string, "Закрыть", "") ;
		kick_player ( playerid ) ;
	}
	else
	{
		ac_info [ playerid ] = reason ;
		ac_date [ playerid ] = gettime ( ) ;

		new s_year, s_month, s_day, s_hour, s_minute, s_second ;
		timestamp_to_date ( ac_date [ playerid ] + CONVERT_TIME_TO_MOSCOW, s_year, s_month, s_day, s_hour, s_minute, s_second ) ;

		format(_t_string, 100, "%s", reason);
		AddToWarningPanel(playerid, _t_string, 0);

		foreach(new i: admin_players)
		{
			if ( admin_info [ i ] [ spectate_id ] == playerid + 1 )
			{
				new line_string [ 144 ] ;
				format ( line_string, sizeof ( line_string ), "%s[%d] добавлен в чит панель. Причина: %s. Время: %02d:%02d:%02d.", p_info [ playerid ] [ name ], playerid, ac_info [ playerid ], s_hour, s_minute, s_second ) ;
				SendClientMessage ( i, col_white, line_string ) ;
			}
		}
	}
	return 1 ;
}

stock kick_player ( playerid )
{
	new ms = GetPlayerPing ( playerid ) > 200 ? 200 : GetPlayerPing ( playerid ) + 50 ;
	return SetTimerEx ( "fixed_kick", ms, 0, "i", playerid ) ;
}

callback: fixed_kick ( playerid )
{
	if ( ! IsPlayerConnected ( playerid ) ) return 1 ;
	Kick ( playerid ) ;
	return 1 ;
}

callback: fixed_camera_pos ( playerid, _inter_id, _type )
{
	if ( _type == 1 )
	{
	    SetPlayerCameraPos(playerid, b_info [ _inter_id ] [ b_position ] [ 0 ] - 15, b_info [ _inter_id ] [ b_position ] [ 1 ] + 27, b_info [ _inter_id ] [ b_position ] [ 2 ] + 31);
		SetPlayerCameraLookAt(playerid, b_info [ _inter_id ] [ b_position ] [ 0 ] - 14, b_info [ _inter_id ] [ b_position ] [ 1 ] + 26, b_info [ _inter_id ] [ b_position ] [ 2 ] + 30);
	}
	else if ( _type == 2 )
	{
	    if ( h_info [ _inter_id ] [ h_podezd ] != -1 )
	    {
	    	new _padik_id = h_info [ _inter_id ] [ h_podezd ] ;
	    	SetPlayerCameraPos(playerid, podezd_info [ _padik_id ] [ p_pos ] [ 0 ] - 15, podezd_info [ _padik_id ] [ p_pos ] [ 1 ] + 27, podezd_info [ _padik_id ] [ p_pos ] [ 2 ] + 31);
			SetPlayerCameraLookAt(playerid, podezd_info [ _padik_id ] [ p_pos ] [ 0 ] - 14, podezd_info [ _padik_id ] [ p_pos ] [ 1 ] + 26, podezd_info [ _padik_id ] [ p_pos ] [ 2 ] + 30);
		}
		else
		{
			SetPlayerCameraPos(playerid, h_info [ _inter_id ] [ h_pos ] [ 0 ] - 15, h_info [ _inter_id ] [ h_pos ] [ 1 ] + 27, h_info [ _inter_id ] [ h_pos ] [ 2 ] + 31);
			SetPlayerCameraLookAt(playerid, h_info [ _inter_id ] [ h_pos ] [ 0 ] - 14, h_info [ _inter_id ] [ h_pos ] [ 1 ] + 26, h_info [ _inter_id ] [ h_pos ] [ 2 ] + 30);
		}
	}

	if ( p_t_info [ playerid ] [ camera_timer ] != -1 )
	{
		KillTimer ( p_t_info [ playerid ] [ camera_timer ] ) ;
		p_t_info [ playerid ] [ camera_timer ] = -1 ;
	}
	return 1 ;
}

stock set_interior ( playerid, interior )
{
	p_t_info [ playerid ] [ p_data ] [ 0 ] = interior ;
	return SetPlayerInterior ( playerid, interior ) ;
}

stock set_world ( playerid, world )
{
	p_t_info [ playerid ] [ p_data ] [ 1 ] = world ;
	if ( p_t_info [ playerid ] [ p_logged ] == true && is_drug_effect { playerid } == 0 )
	{
		switch ( world )
		{
			case 0:
			{
				new newhour, newminute, newsecond ;
				gettime ( newhour, newminute, newsecond ) ;
				SetPlayerTime ( playerid, newhour, newminute ), SetPlayerWeather ( playerid, global_weather ) ;
			}
			default: SetPlayerWeather ( playerid, 4 ), SetPlayerTime ( playerid, 18, 0 ) ;
		}
	}
	return SetPlayerVirtualWorld ( playerid, world ) ;
}
#define SetPlayerVirtualWorld set_world

stock set_race_pos ( playerid, Float:x, Float:y, Float:z, Float:angle, interior, world )
{
	if ( world == 0 && p_t_info [ playerid ] [ p_data ] [ 1 ] != 0 && is_drug_effect { playerid } == 0) SetPlayerWeather ( playerid, global_weather ), SetPlayerTime ( playerid, global_hour, 0  ) ;
	if ( interior != -1 ) set_interior ( playerid, interior ) ;
	if ( world != -1 ) set_world ( playerid, world ) ;

    playerCheckFly{playerid} = SleepTime(playerid);
	p_t_info [ playerid ] [ p_tp_immune_time ] = 4 ;
	SetPlayerPos ( playerid, x, y, z ) ;
	SetPlayerFacingAngle ( playerid, angle ) ;
	p_t_info [ playerid ] [ p_pos ] [ 0 ] = x ;
	p_t_info [ playerid ] [ p_pos ] [ 1 ] = y ;
	p_t_info [ playerid ] [ p_pos ] [ 2 ] = z ;
	p_t_info [ playerid ] [ p_pos ] [ 3 ] = angle ;

	p_t_info [ playerid ] [ p_ab_warnings ] = 0 ;
	if ( gotome_player [ playerid ] != -1 )
	{
	    new player_id = gotome_player [ playerid ] ;
		p_t_info [ player_id ] [ p_tp_immune_time ] = 2 ;
		SetPlayerPos ( player_id, x, y, z ) ;
		SetPlayerFacingAngle ( player_id, angle ) ;
		p_t_info [ player_id ] [ p_pos ] [ 0 ] = x ;
		p_t_info [ player_id ] [ p_pos ] [ 1 ] = y ;
		p_t_info [ player_id ] [ p_pos ] [ 2 ] = z ;
		p_t_info [ player_id ] [ p_pos ] [ 3 ] = angle ;
		set_world ( player_id, world ) ;
		set_interior ( player_id, interior ) ;
	}

	ClearAnimations ( playerid, 1 ) ;
	SetCameraBehindPlayer ( playerid ) ;
	foreach(new i: admin_players)
	{
		if ( admin_info [ i ] [ spectate_id ] == playerid )
		{
			switch ( GetPlayerState ( playerid ) )
			{
				case 1:
				{
					set_interior ( i, p_t_info [ playerid ][ p_data ] [ 0 ] ) ;
					set_world ( i, p_t_info [ playerid ][ p_data ] [ 1 ] ) ;
					TogglePlayerSpectating ( i, true ) ;
					PlayerSpectatePlayer ( i, playerid ) ;
				}
				case 2:
				{
					set_interior ( i, p_t_info [ playerid ][ p_data ] [ 0 ] ) ;
					set_world ( i, p_t_info [ playerid ][ p_data ] [ 1 ] ) ;
					new veh_id = GetPlayerVehicleID ( playerid ) ;
					TogglePlayerSpectating ( i, true ) ;
					PlayerSpectateVehicle ( i, veh_id ) ;
				}
				case 3:
				{
					set_interior ( i, p_t_info [ playerid ][ p_data ] [ 0 ] ) ;
					set_world ( i, p_t_info [ playerid ][ p_data ] [ 1 ] ) ;
					new veh_id = GetPlayerVehicleID ( playerid ) ;
					TogglePlayerSpectating ( i, true ) ;
					PlayerSpectateVehicle (i, veh_id ) ;
				}
			}
		}
	}

//	p_t_info [ playerid ] [ p_tp_ac_timer ] = SetTimerEx ( "ac_check", 12000, 0, "ifff", playerid, x, y, z ) ;
	return 1 ;
}

stock Float: GetDistanceBetweenPlayers ( p1, p2 )
{
	if ( ! IsPlayerConnected ( p1 ) || ! IsPlayerConnected ( p2 ) )
	{
		return -1.00 ;
	}
	new Float:x1,Float:y1,Float:z1,Float:x2,Float:y2,Float:z2;
	GetPlayerPos(p1,x1,y1,z1);
	GetPlayerPos(p2,x2,y2,z2);
	return floatsqroot(floatpower(floatabs(floatsub(x2,x1)),2)+floatpower(floatabs(floatsub(y2,y1)),2)+floatpower(floatabs(floatsub(z2,z1)),2));
}

stock set_pos ( playerid, Float:x, Float:y, Float:z, Float:angle, interior, world )
{
	if ( world == 0 && p_t_info [ playerid ] [ p_data ] [ 1 ] != 0 && is_drug_effect { playerid } == 0 ) SetPlayerWeather ( playerid, global_weather ), SetPlayerTime ( playerid, global_hour, 0 ) ;

	if ( interior != -1 ) set_interior ( playerid, interior ) ;
	if ( world != -1 ) set_world ( playerid, world ) ;

	if ( p_t_info [ playerid ] [ p_tp_ac_timer ] ) KillTimer ( p_t_info [ playerid ] [ p_tp_ac_timer ] ), p_t_info [ playerid ] [ p_tp_ac_timer ] = -1 ;

	#if defined SAMP
		freeze_player ( playerid ) ;
	#endif

    playerCheckFly { playerid } = SleepTime ( playerid ) ;
	p_t_info [ playerid ] [ p_tp_immune_time ] = 4 ;

	SetPlayerPos ( playerid, x, y, z ) ;
	SetPlayerFacingAngle ( playerid, angle ) ;

	p_t_info [ playerid ] [ p_pos ] [ 0 ] = x ;
	p_t_info [ playerid ] [ p_pos ] [ 1 ] = y ;
	p_t_info [ playerid ] [ p_pos ] [ 2 ] = z ;
	p_t_info [ playerid ] [ p_pos ] [ 3 ] = angle ;

	p_t_info [ playerid ] [ last_alt ] = GetTickCount ( ) ;

	p_t_info [ playerid ] [ old_pos ] [ 0 ] = x ;
	p_t_info [ playerid ] [ old_pos ] [ 1 ] = y ;
	p_t_info [ playerid ] [ old_pos ] [ 2 ] = z ;

	p_t_info [ playerid ] [ real_pos ] [ 0 ] = x ;
	p_t_info [ playerid ] [ real_pos ] [ 1 ] = y ;
	p_t_info [ playerid ] [ real_pos ] [ 2 ] = z ;

	p_t_info [ playerid ] [ p_ab_warnings ] = 0 ;
/*	if ( gotome_player [ playerid ] != -1 )
	{
		p_t_info [ gotome_player [ playerid ] ] [ p_tp_immune_time ] = 2 ;
		SetPlayerPos ( gotome_player [ playerid ], x, y, z ) ;
		SetPlayerFacingAngle ( gotome_player [ playerid ], angle ) ;
		p_t_info [ gotome_player [ playerid ] ] [ p_pos ] [ 0 ] = x ;
		p_t_info [ gotome_player [ playerid ] ] [ p_pos ] [ 1 ] = y ;
		p_t_info [ gotome_player [ playerid ] ] [ p_pos ] [ 2 ] = z ;
		p_t_info [ gotome_player [ playerid ] ] [ p_pos ] [ 3 ] = angle ;
		set_world ( gotome_player [ playerid ], world ) ;
		set_interior ( gotome_player [ playerid ], interior ) ;
	}*/

	ClearAnimations ( playerid, 1 ) ;
	SetCameraBehindPlayer ( playerid ) ;
	foreach(new i: admin_players)
	{
		if ( admin_info [ i ] [ spectate_id ] == playerid )
		{
			switch ( GetPlayerState ( playerid ) )
			{
				case 1:
				{
					set_interior ( i, p_t_info [ playerid ][ p_data ] [ 0 ] ) ;
					set_world ( i, p_t_info [ playerid ][ p_data ] [ 1 ] ) ;
					TogglePlayerSpectating ( i, true ) ;
					PlayerSpectatePlayer ( i, playerid ) ;
				}
				case 2:
				{
					set_interior ( i, p_t_info [ playerid ][ p_data ] [ 0 ] ) ;
					set_world ( i, p_t_info [ playerid ][ p_data ] [ 1 ] ) ;
					new veh_id = GetPlayerVehicleID ( playerid ) ;
					TogglePlayerSpectating ( i, true ) ;
					PlayerSpectateVehicle ( i, veh_id ) ;
				}
				case 3:
				{
					set_interior ( i, p_t_info [ playerid ][ p_data ] [ 0 ] ) ;
					set_world ( i, p_t_info [ playerid ][ p_data ] [ 1 ] ) ;
					new veh_id = GetPlayerVehicleID ( playerid ) ;
					TogglePlayerSpectating ( i, true ) ;
					PlayerSpectateVehicle (i, veh_id ) ;
				}
			}
		}
	}

 	if ( IsPlayerAttachedObjectSlotUsed ( playerid, 0 ) )
	{
	 	RemovePlayerAttachedObject ( playerid, 0 ) ;
		SetPlayerAttachedObject ( playerid, 0, 3013, 6, 0.0, 0.10, -0.2, -110.0, 0.0, 78.0 ) ;
		ClearAnimations ( playerid ) ;
		p_t_info [ playerid ] [ p_animation ] = true ;
  		ApplyAnimation(playerid, "CARRY", "crry_prtial", 4.1, 0, 1, 1, 1, 1 ) ;
	}

	if ( p_t_info [ playerid ] [ t_robbery ] != -1 ) exit_robbery ( playerid ) ;
	if ( g_phone_call [ playerid ] [ PC_STATUS ] ) SetPlayerSpecialAction ( playerid, SPECIAL_ACTION_USECELLPHONE ) ;

	p_t_info [ playerid ] [ p_tp_ac_timer ] = SetTimerEx ( "ac_check", 7500, false, "ifff", playerid, x, y, z ) ;
	return 1 ;
}

