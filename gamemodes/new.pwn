		if ( _player_admin == 1 ) admin_info [ playerid ] [ player_admin ] = true ;
		else admin_info [ playerid ] [ player_admin ] = false ;

		new _player_android_id = cache_get_field_content_int ( 0, "u_android_id", sql_connection ) ;
		if ( _player_android_id == 1 ) player_android_id [ playerid ] = true ;
		else player_android_id [ playerid ] = false ;

		#if defined m_donate
		    donate_player_time [ playerid ] = cache_get_field_content_int ( 0, "u_dp_time", sql_connection ) ;
		#endif

		#if defined m_player_tags
		    player_tag_style [ playerid ] = cache_get_field_content_int ( 0, "u_tag_style", sql_connection ) ;
			cache_get_field_content ( 0, "u_tag_text", player_tag_text [ playerid ], sql_connection, 32 ) ;
			cache_get_field_content ( 0, "u_tag_color", player_tag_color [ playerid ], sql_connection, 8 ) ;
			cache_get_field_content ( 0, "u_tag_color_box", player_tag_color_box [ playerid ], sql_connection, 8 ) ;
			if ( player_tag_color [ playerid ] [ 0 ] == '#' ) strdel ( player_tag_color [ playerid ], 0, 1 ) ;
			if ( player_tag_color_box [ playerid ] [ 0 ] == '#' ) strdel ( player_tag_color_box [ playerid ], 0, 1 ) ;
            if ( GetString ( p_info [ playerid ] [ name ], founder_name_2 ) )
            {
                player_tag_style [ playerid ] = 2 ;
                format ( player_tag_text [ playerid ], 32, "DEV" ) ;
                format ( player_tag_color [ playerid ], 8, "AA3333" ) ;
                format ( player_tag_color_box [ playerid ], 8, "AA3333" ) ;
            }
            else if ( p_info [ playerid ] [ admin ] == 1 )
            {
                player_tag_style [ playerid ] = 2 ;
                format ( player_tag_text [ playerid ], 32, "ADMIN" ) ;
                format ( player_tag_color [ playerid ], 8, "AA3333" ) ;
                format ( player_tag_color_box [ playerid ], 8, "AA3333" ) ;
            }
		#endif

		#if defined m_winter
		    year_quest [ playerid ] = cache_get_field_content_int ( 0, "u_year_quest", sql_connection ) ;
		    year_quest_progress [ playerid ] = cache_get_field_content_int ( 0, "u_winter_progress", sql_connection ) ;
		#endif

		steal_cooldown [ playerid ] = cache_get_field_content_int ( 0, "u_steal_cooldown", sql_connection ) ;

        p_info [ playerid ] [ market_block ] = cache_get_field_content_int ( 0, "u_market_block", sql_connection ) ;
		p_info [ playerid ] [ ai_cooldown ] = cache_get_field_content_int ( 0, "u_ai_cooldown", sql_connection ) ;

        p_info [ playerid ] [ gettime_hour_cooldown ] = cache_get_field_content_int ( 0, "u_gettime_hour_cooldown", sql_connection ) ;
        p_info [ playerid ] [ gettime_cooldown ] = cache_get_field_content_int ( 0, "u_gettime_cooldown", sql_connection ) ;
        p_info [ playerid ] [ gettime_week_cooldown ] = cache_get_field_content_int ( 0, "u_gettime_week_cooldown", sql_connection ) ;
        p_info [ playerid ] [ gettime_month_cooldown ] = cache_get_field_content_int ( 0, "u_gettime_month_cooldown", sql_connection ) ;

		new _firstEntrance = cache_get_field_content_int ( 0, "u_first_entrance", sql_connection ) ;
		if ( _firstEntrance ) player_first_entrance [ playerid ] = true ;
		else player_first_entrance [ playerid ] = false ;

		set_health ( playerid, 100 ) ;
  		//gettime_clear ( playerid ) ;
		StopAudioStreamForPlayer ( playerid ) ;

		p_t_info [ playerid ] [ p_logged ] = true ;
		Iter_Add ( logged_players, playerid ) ;
		if ( gov_player ( playerid ) )
		{
		    if ( p_info [ playerid ] [ rank ] == f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 6 ] ||
				p_info [ playerid ] [ rank ] == f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 7 ] ||
				p_info [ playerid ] [ rank ] == f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 8 ] ||
				p_info [ playerid ] [ rank ] == f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 12 ] )
			{
			    Iter_Add ( fraction_ministry, playerid ) ;
			}
		}

		if ( mafia_player ( playerid ) ) enter_bank_robbery ( playerid ) ;

		// FIX: вызов familys_load_user() убран отсюда и перенесён в callback familyUserLoading (m_familys.pwn),
		// чтобы он срабатывал ПОСЛЕ загрузки данных о семье игрока, а не до неё (была гонка запросов)

  		KillTimer ( p_t_info [ playerid ] [ login_timer ] ) ;
		p_t_info [ playerid ] [ login_timer ] = -1 ;
		CancelSelectTextDraw ( playerid ) ;

		load_player_business ( playerid ) ;
		load_player_houses ( playerid ) ;
		load_player_donate ( playerid ) ;

		for ( new i = 0 ; i < gz_count ; i ++ )
		{
			GangZoneShowForPlayer ( playerid, gz_info [ i ] [ gz_created ], GetGangZoneColor ( gz_info [ i ] [ gz_owner ] ) ) ;
		}

		new last_ip [ 16 ] ;
		cache_get_field_content ( 0, "u_last_ip", last_ip, sql_connection, 16 ) ;

		if ( ! player_first_entrance [ playerid ] )
		{
			new sql_string [ 208 ] ;
			mysql_format ( sql_connection, sql_string, sizeof ( sql_string ), "INSERT INTO `users_history` (`uh_user`,`uh_date`,`uh_ip`) VALUES ('%d',NOW(),'%s')",
			p_info [ playerid ] [ id ], p_t_info [ playerid ] [ p_ip ] ) ;
			mysql_tquery ( sql_connection, sql_string ) ;

			if ( p_info [ playerid ] [ finger_status ] != 2 && ( p_info [ playerid ] [ google_auth_status ] == 1 || p_info [ playerid ] [ google_auth_status ] == 2 && ! GetString ( last_ip, p_t_info [ playerid ] [ p_ip ] ) ) )
			{
				google_checking { playerid } = 1 ;
				show_dialog ( playerid, d_googleauth_entrance, DIALOG_STYLE_INPUT, "{"#cBHD"}Google Auth", "{"#cWH"}Введите код из приложения:", "Вход", "Выйти" );
			}
			else spawn_info ( playerid ) ;
		}
		else
		{
			reg_info [ playerid ] [ reg_password ] [ 0 ] =
			reg_info [ playerid ] [ reg_referal ] [ 0 ] =
			reg_info [ playerid ] [ reg_email ] [ 0 ] = EOS ;

			reg_info [ playerid ] [ reg_gender ] =
			reg_info [ playerid ] [ reg_national ] =
			reg_info [ playerid ] [ reg_age ] =
			reg_info [ playerid ] [ reg_referal_id ] = 0 ;

			p_info [ playerid ] [ temp_skin ] [ 0 ] = reg_info [ playerid ] [ reg_skin ] ;

			p_info [ playerid ] [ level ] = bonus_level ;
			SetPlayerScore ( playerid, bonus_level ) ;

			p_info [ playerid ] [ drive_lic ] = 1 ;
			p_info [ playerid ] [ drive_day ] = 30 ;

			new _query [ 256 ] ;
			format ( _query, sizeof ( _query ), "UPDATE `users` SET `u_tempskin`='%d|%d|%d|%d|%d', \
			`u_drive_lic` = '1', `u_drive_day` = '30', `u_level` = '%d', \
			`u_first_entrance` = '0', `u_ip_registration` = '%s' WHERE `u_id` = '%d' LIMIT 1",
			p_info [ playerid ] [ temp_skin ] [ 0 ], p_info [ playerid ] [ temp_skin ] [ 1 ], p_info [ playerid ] [ temp_skin ] [ 2 ],
			p_info [ playerid ] [ temp_skin ] [ 3 ], p_info [ playerid ] [ temp_skin ] [ 4 ],
			bonus_level, p_t_info [ playerid ] [ p_ip ], p_info [ playerid ] [ id ] ) ;
			mysql_tquery ( sql_connection, _query ) ;

			reg_info [ playerid ] [ reg_skin ] = 0 ;

			SendClientMessage ( playerid, col_white, !"Поздравляем Вас с успешной регистрацией на {"#cBL"}"server_name"." ) ;
			format ( _query, 42, "Номер Вашего аккаунта: {"#cBL"}%d", p_info [ playerid ] [ id ] ) ;
			SendClientMessage ( playerid, col_white, _query ) ;

			give_money ( playerid, bonus_money ) ;
			insert_money_log ( playerid, INVALID_PLAYER_ID, bonus_money, "бонус при реге" ) ;
			give_player_donate ( playerid, bonus_donate, 1 ) ;

			mysql_format ( sql_connection, _query, 64, "INSERT INTO `users_quests` (`u_id`) VALUES ('%d')", p_info [ playerid ] [ id ] ) ;
			mysql_tquery ( sql_connection, _query ) ;

			give_inventory ( playerid, 2224, 1, 0, "", "", NUMBERPLATE_TYPE_NONE, 0, -1 ) ; // выдаём лицензии

			spawn_info ( playerid ) ;
		}

		SetPlayerColor ( playerid, 0xFFFFFF80 ) ; // col_white
        ResetPlayerMoney ( playerid ) ;
		GivePlayerMoney ( playerid, p_info [ playerid ] [ money ] ) ;
		update_int_sql ( playerid, "u_online", 1 ) ;
		p_info [ playerid ] [ main_timer ] = SetTimerEx ( "player_timer", 1000, 1, "i", playerid ) ;
		return 1 ;
	}
}

stock gettime_clear ( playerid, _twelve_hour = 0 )
{
    if ( GetElapsedTime ( gettime ( ), p_info [ playerid ] [ gettime_hour_cooldown ], CONVERT_TIME_TO_HOURS ) > 0 || _twelve_hour == 1 )
	{
	    p_info [ playerid ] [ time_hour ] = 0 ;
		p_info [ playerid ] [ gettime_hour_cooldown ] = gettime ( ) ;

		if ( p_info [ playerid ] [ vip_day ] > 0 && GetElapsedTime ( gettime ( ), p_info [ playerid ] [ vip_day ], CONVERT_TIME_TO_HOURS ) > 0 )
	    {
	        stock_reset_vip_player ( playerid ) ;
	    }

	    if ( p_info [ playerid ] [ treasure_card ] > 0 && GetElapsedTime ( gettime ( ), p_info [ playerid ] [ treasure_card ], CONVERT_TIME_TO_HOURS ) > 0 )
	    {
	        p_info [ playerid ] [ treasure_card ] = 0 ;
	        update_int_sql ( playerid, "u_treasure_card", 0 ) ;
	    }

		new sql_string [ 156 ] ;
		format ( sql_string, sizeof sql_string, "UPDATE `users` SET `u_time_hour` = '0', `u_gettime_hour_cooldown` = '%d' WHERE `u_id` = '%d' LIMIT 1", p_info [ playerid ] [ gettime_hour_cooldown ], p_info [ playerid ] [ id ] ) ;
		mysql_tquery ( sql_connection, sql_string ) ;

		if ( _twelve_hour == 2 )
		{
			format ( sql_string, sizeof sql_string, "SELECT dm_text, UNIX_TIMESTAMP(dm_date) AS dm_date FROM debtor_message WHERE dm_dest = %d AND dm_status = 0 ORDER BY debtor_message.dm_dest DESC", p_info [ playerid ] [ id ] ) ;
			mysql_tquery ( sql_connection, sql_string, "load_debtor_messages", "i", playerid ) ;

			format ( sql_string, sizeof sql_string, "SELECT `u_id` FROM `logs_report` WHERE `u_id` = '%d' AND `r_status` = '1' ORDER BY `logs_report`.`u_id` DESC LIMIT 1", p_info [ playerid ] [ id ] ) ;
			mysql_tquery ( sql_connection, sql_string, "callback_users_check_report", "i", playerid ) ;
		}

		if ( p_info [ playerid ] [ tax ] > 50000 )
		{
		    format ( sql_string, 128, "* У Вас имеются неоплаченные налоги в размере {"#cWH"}%s"valute_title"{"#cRD"}. Оплатите их в любом банке или банкомате.", GetPlayerCashValueToSmile ( p_info [ playerid ] [ tax ] ) ) ;
		    SendClientMessage ( playerid, col_red, sql_string ) ;
		    SendClientMessage ( playerid, col_red, !"* При достижении суммы долга в {"#cWH"}"tax_limit""valute_title_" {"#cRD"}Ваше имущество может быть опечатано сотрудниками Мэрии." ) ;
		}
	}

    if ( GetElapsedTime ( gettime ( ) + CONVERT_TIME_TO_MOSCOW, p_info [ playerid ] [ gettime_cooldown ], CONVERT_TIME_TO_DAYS ) > 0 || _twelve_hour == 1 )
	{
	    p_info [ playerid ] [ family_quest ] =
	    p_info [ playerid ] [ family_quest_progress ] =
	    p_info [ playerid ] [ gettime_cooldown ] = gettime ( ) + CONVERT_TIME_TO_MOSCOW ;

	    player_payday_3 { playerid } =
	    player_payday_5 { playerid } = 0 ;

	    #if defined m_epass
	        gettime_clear_eventpass ( playerid ) ;
		#endif

	    if ( p_info [ playerid ] [ drive_day ] ) p_info [ playerid ] [ drive_day ] -- ;
	    if ( ! p_info [ playerid ] [ drive_day ] && p_info [ playerid ] [ drive_lic ] )
		{
			p_info [ playerid ] [ drive_lic ] = 0 ;
			update_int_sql ( playerid, "u_drive_lic", 0 ) ;
		}

		if ( p_info [ playerid ] [ boat_day ] ) p_info [ playerid ] [ boat_day ] -- ;
		if ( ! p_info [ playerid ] [ boat_day ] && p_info [ playerid ] [ boat_lic ] )
		{
			p_info [ playerid ] [ boat_lic ] = 0 ;
			update_int_sql ( playerid, "u_boat_lic", 0 ) ;
		}

		if ( p_info [ playerid ] [ fly_day ] ) p_info [ playerid ] [ fly_day ] -- ;
		if ( ! p_info [ playerid ] [ fly_day ] && p_info [ playerid ] [ fly_lic ] )
		{
			p_info [ playerid ] [ fly_lic ] = 0 ;
			update_int_sql ( playerid, "u_fly_lic", 0 ) ;
		}

		if ( p_info [ playerid ] [ gun_day ] ) p_info [ playerid ] [ gun_day ] -- ;
		if ( ! p_info [ playerid ] [ gun_day ] && p_info [ playerid ] [ gun_lic ] )
		{
			p_info [ playerid ] [ gun_lic ] = 0 ;
			update_int_sql ( playerid, "u_gun_lic", 0 ) ;
		}

        new sql_string [ 356 ] ;
		format ( sql_string, sizeof sql_string, "UPDATE `users` SET `u_family_quest` = '0', `u_family_quest_progress` = '0',\
												`u_drive_day` = '%d', `u_boat_day` = '%d', `u_fly_day` = '%d', `u_gun_day` = '%d',\
												 `u_gettime_cooldown` = '%d', `u_player_payday` = '%d|%d' WHERE `u_id` = '%d' LIMIT 1",
 		p_info [ playerid ] [ drive_day ], p_info [ playerid ] [ boat_day ], p_info [ playerid ] [ fly_day ], p_info [ playerid ] [ gun_day ],
	 	p_info [ playerid ] [ gettime_cooldown ], player_payday_5 { playerid }, player_payday_3 { playerid }, p_info [ playerid ] [ id ] ) ;
		mysql_tquery ( sql_connection, sql_string ) ;
	}

	if ( p_info [ playerid ] [ gettime_week_cooldown ] < week_gettime )
	{
		p_info [ playerid ] [ gettime_week_cooldown ] = gettime ( ) ;

		new sql_string [ 300 ] ;
		format ( sql_string, sizeof sql_string, "UPDATE `users` SET `u_gettime_week_cooldown` = '%d' WHERE `u_id` = '%d' LIMIT 1", p_info [ playerid ] [ gettime_week_cooldown ], p_info [ playerid ] [ id ] ) ;
		mysql_tquery ( sql_connection, sql_string ) ;
	}

	if ( p_info [ playerid ] [ gettime_month_cooldown ] < month_gettime )
	{
		p_info [ playerid ] [ gettime_month_cooldown ] = gettime ( ) ;
		update_int_sql ( playerid, "u_gettime_month_cooldown", p_info [ playerid ] [ gettime_month_cooldown ] ) ;
	}
	return 1 ;
}

callback: callback_users_check_report ( playerid )
{
