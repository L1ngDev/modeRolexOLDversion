			{"#cWV"}  \t Ваш никнейм:\t\t\t\t\t{FFFFFF}%s\n\
			{"#cWV"}  \t Ваш номер аккаунта:\t\t\t{FFFFFF}%d\n\
			{"#cWV"}  \t Ваш основной счёт:\t\t\t{FFFFFF}%d "donate_title"\n\
			{"#cWV"}  \t Ваш бонусный счёт:\t\t\t{FFFFFF}%d "donate_title"\n\n\
			{"#cGRDialog"}* За бонусный счёт можно приобритать позиции в разделе {"#cWV"}'Услуги' {"#cGRDialog"}с пометкой {"#cWV"}'Бонусный'{"#cGRDialog"}",
			server_bonus [ 1 ], server_bonus [ 1 ],
			p_info [ playerid ] [ name ],
			p_info [ playerid ] [ id ],
			p_info [ playerid ] [ donate ],
			p_info [ playerid ] [ donate_bonus ] ) ;
	}
	else
	{
	    format ( global_string, 1000,
		    "{"#cWV"}Донат {FFFFFF}- это необязательное пожертвование нашему проекту деньгами на поддержание\n\
	 		и развитие сервера, оплату оборудования и рекламы. Взамен Вы получаете "donate_title".\n\n\
		    {FFCC00}1 российский рубль = 1 "donate_title"\n\n\
			Чтобы получить коины нужно:\n\n\
			1.\t {FFFFFF}Зайти в {FFCC00}"site_name"\n\
			2.\t {FFFFFF}Перейти во вкладку {FFCC00}Донат\n\
			3.\t {FFFFFF}Указать свой никнейм и желаемую сумму пополнения{FFCC00}\n\
			4.\t {FFFFFF}Выбрать способ оплаты{FFCC00}\n\n\
			{"#cWV"}  \t Ваш никнейм:\t\t\t\t\t{FFFFFF}%s\n\
			{"#cWV"}  \t Ваш номер аккаунта:\t\t\t{FFFFFF}%d\n\
			{"#cWV"}  \t Ваш основной счёт:\t\t\t{FFFFFF}%d "donate_title"\n\
			{"#cWV"}  \t Ваш бонусный счёт:\t\t\t{FFFFFF}%d "donate_title"\n\n\
			{"#cGRDialog"}* За бонусный счёт можно приобритать позиции в разделе {"#cWV"}'Услуги' {"#cGRDialog"}с пометкой {"#cWV"}'Бонусный'{"#cGRDialog"}",
			p_info [ playerid ] [ name ],
			p_info [ playerid ] [ id ],
			p_info [ playerid ] [ donate ],
			p_info [ playerid ] [ donate_bonus ] ) ;
	}

	show_dialog ( playerid, d_donate_1, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Донат услуги", global_string, "Далее", "Назад" ) ;

	SendClientMessage ( playerid, col_wavy, !"* С бонусного счёта нельзя переводить в основной счёт." ) ;
