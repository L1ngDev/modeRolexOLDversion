stock show_register ( playerid )
{
	new ds_password [ 24 ], ds_email [ 32 ], ds_referal [ MAX_PLAYER_NAME ], ds_gender, ds_race, ds_skin, ds_age ;
	format ( ds_password, 24, "%s", reg_info [ playerid ][ reg_password ] ) ;
	format ( ds_email, 32, "%s", reg_info [ playerid ][ reg_email ] ) ;
	format ( ds_referal, 24, "%s", reg_info [ playerid ][ reg_referal ] ) ;
	ds_gender = reg_info [ playerid ] [ reg_gender ] ;
	ds_race = reg_info [ playerid ] [ reg_national ] ;
	ds_skin = reg_info [ playerid ] [ reg_skin ] ;
	ds_age = reg_info [ playerid ] [ reg_age ] ;

	format ( global_string, sizeof ( global_string ),"{"#cBL"}* {"#cGRDialog"}Пароль:\t%s%s\n", ( strlen ( ds_password ) > 1 ) ? ( "{"#cGN"}" ) : ( "{"#cRD"}" ), ( strlen ( ds_password ) > 1 ) ? ( ds_password ) : ( "Не задан" ) ) ;
	format ( global_string, sizeof ( global_string ),"%s{"#cBL"}* {"#cGRDialog"}Почта:\t%s%s\n", global_string, ( strlen ( ds_email ) > 1 ) ? ( "{"#cGN"}" ) : ( "{"#cRD"}" ), ( strlen ( ds_email ) > 1 ) ? ( ds_email ) : ( "Не задан" ) ) ;
	format ( global_string, sizeof ( global_string ),"%s{"#cBL"}* {"#cGRDialog"}Реферал:\t%s%s {"#cGRDialog"}(Не обязательно)\n", global_string, ( strlen ( ds_referal ) > 1 ) ? ( "{"#cGN"}" ) : ( "{"#cRD"}" ), ( strlen ( ds_referal ) > 1 ) ? ( ds_referal ) : ( "Не задан" ) ) ;
	format ( global_string, sizeof ( global_string ),"%s{"#cBL"}* {"#cGRDialog"}Возраст:\t%s%d\n", global_string, ( ds_age > 0 ) ? ( "{"#cGN"}" ) : ( "{"#cRD"}" ), ds_age ) ;
	format ( global_string, sizeof ( global_string ),"%s{"#cBL"}* {"#cGRDialog"}Пол:\t%s%s\n", global_string, ( ds_gender > 0 ) ? ( "{"#cGN"}" ) : ( "{"#cRD"}" ), ( ds_gender == 0 ) ? ( "Не задан" ) : ( ds_gender == 1 ) ? ( "Мужской" ) : ( "Женский" ) ) ;
	format ( global_string, sizeof ( global_string ),"%s{"#cBL"}* {"#cGRDialog"}Раса:\t%s%s\n", global_string, ( ds_race ) ? ( "{"#cGN"}" ) : ( "{"#cRD"}" ), ( ds_race ) ? ( race_name_str [ ds_race - 1 ] ) : ( "Не задан" ) ) ;
	format ( global_string, sizeof ( global_string ),"%s{"#cBL"}* {"#cGRDialog"}Внешность:\t%s%s\n", global_string, ( ds_skin ) ? ( "{"#cGN"}" ) : ( "{"#cRD"}" ), ( ds_skin ) ? ( "Выбрана" ) : ( "Не выбрана" ) ) ;
	if ( ds_gender && ds_race && ds_skin && ds_age && strlen ( ds_email ) > 1 && strlen ( ds_password ) > 1 ) format ( global_string, sizeof ( global_string ),"%s{"#cBL"}Продолжить регистрацию", global_string ) ;
	else format ( global_string, sizeof ( global_string ),"%s{"#cRD"}Продолжить регистрацию", global_string ) ;
	show_dialog ( playerid, d_reg_main, DIALOG_STYLE_TABLIST, "{"#cBHD"}Регистрация нового аккаунта:", global_string, "Далее", "Отмена" ) ;
	return 1 ;
}

stock show_login ( playerid )
{
    new float_time = gettime( ) - p_info [ playerid ] [ played_time ] ;

	if ( p_info [ playerid ] [ mail_auth ] )
		SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Если Вы забыли пароль от аккаунта, то нажмите {"#cBL"}\"Recovery\"{"#cGRInfo"}." ) ;

	global_string [ 0 ] = EOS ;
	format ( global_string, 512, "\
	{"#cBL"}Добро пожаловать на сервер "server_name".\n\n\
	\t{"#cBL"}*{"#cWH"} Данный аккаунт зарегистрирован.\n\
 	\t{"#cBL"}*{"#cWH"} Ваш никнейм: %s\n\
 	\t{"#cBL"}*{"#cWH"} Последний визит: %s\n\n\
	{"#cGRDialog"}* Введите Ваш пароль:", p_info [ playerid ] [ name ], check_float_time ( float_time ) ) ;
	if ( p_info [ playerid ] [ password_status ] )
	{
		if ( p_info [ playerid ] [ mail_auth ] || p_info [ playerid ] [ google_auth_status ] )
			show_dialog ( playerid, d_login, DIALOG_STYLE_INPUT, "{"#cBHD"}Авторизация", global_string, "Вход", "Recovery" ) ;

		else
			show_dialog ( playerid, d_login, DIALOG_STYLE_INPUT, "{"#cBHD"}Авторизация", global_string, "Вход", "" ) ;
	}
	else
	{
		if ( p_info [ playerid ] [ mail_auth ] || p_info [ playerid ] [ google_auth_status ] )
			show_dialog ( playerid, d_login, DIALOG_STYLE_PASSWORD, "{"#cBHD"}Авторизация", global_string, "Вход", "Recovery" ) ;

		else
			show_dialog ( playerid, d_login, DIALOG_STYLE_PASSWORD, "{"#cBHD"}Авторизация", global_string, "Вход", "" ) ;
	}
	return 1 ;
}

stock show_bad_login ( playerid )
{
    if ( GetPVarInt ( playerid, "wrong_password" ) == 4 )
	{
		show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX,"{"#cRD"}Соединение разорвано","{FFFFFF}Вы превысили максимально допустимое колличество попыток ввода пароля!","Закрыть", "") ;
		DeletePVar ( playerid, "wrong_password" ) ;
		kick_player ( playerid ) ;
		return 1 ;
	}

    new float_time = gettime( ) - p_info [ playerid ] [ played_time ], header_string [ 39 + 4 ] ;

	if ( p_info [ playerid ] [ mail_auth ] )
		SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Если Вы забыли пароль от аккаунта, то нажмите {"#cBL"}\"Recovery\"{"#cGRInfo"}." ) ;

	global_string [ 0 ] = EOS ;
	format ( global_string, 512, "\
	{"#cBL"}Добро пожаловать на сервер "server_name".\n\n\
	\t{"#cBL"}*{"#cWH"} Данный аккаунт зарегистрирован.\n\
 	\t{"#cBL"}*{"#cWH"} Ваш никнейм: %s\n\
 	\t{"#cBL"}*{"#cWH"} Последний визит: %s\n\n\
	{"#cGRDialog"}* Введите Ваш пароль:", p_info [ playerid ] [ name ], check_float_time ( float_time ) ) ;

	format ( header_string, sizeof header_string, "{"#cRD"}Осталось попыток: {"#cWH"}%d", 4 - GetPVarInt ( playerid, "wrong_password" ) ) ;
	if ( p_info [ playerid ] [ password_status ] )
	{
		if ( p_info [ playerid ] [ mail_auth ] || p_info [ playerid ] [ google_auth_status ] )
			show_dialog ( playerid, d_login, DIALOG_STYLE_INPUT, header_string, global_string, "Вход", "Recovery" ) ;

		else
			show_dialog ( playerid, d_login, DIALOG_STYLE_INPUT, header_string, global_string, "Вход", "" ) ;
	}
	else
	{
		if ( p_info [ playerid ] [ mail_auth ] || p_info [ playerid ] [ google_auth_status ] )
			show_dialog ( playerid, d_login, DIALOG_STYLE_PASSWORD, header_string, global_string, "Вход", "Recovery" ) ;

		else
			show_dialog ( playerid, d_login, DIALOG_STYLE_PASSWORD, header_string, global_string, "Вход", "" ) ;
	}
	return 1 ;
}
// -----------------------------------------------------------------------------------------------

stock show_stats ( playerid, toid )
{
	global_string [ 0 ] = EOS ;
	new line_string [ 128 ] ;

	static const mm_gender [ ] [ ] =
	{
		"мужчина",
		"женщина"
	} ;

	static const job_status [ 10 ] [ 22 ] =
	{
		"Водитель автобуса",
		"Таксист",
		"Механик",
		"Дальнобойщик",
		"Развозчик продуктов",
		"Развозчик топлива",
		"Инкассатор",
		"Пожарный",
		"Мореплаватель",
		"Вертолетчик"
	} ;

	new houses_string [ 22 * 3 ], house_data [ 22 ], count_h = 0,
		hotel_data [ 32 ],
		business_string [ 56 * 4 ], business_date [ 56 ], count_b = 0,
		garage_date [ 32 ],
		family_data [ 32 ], family_rank_data [ 32 ],
		job_data [ 22 ],
		rank_data [ 32 ], fraction_data [ 32 ],
		_hour = floatround ( p_info [ playerid ] [ hour_played ] / 3600 ) ;
	if ( Iter_Count(player_houses[playerid]) > 1 )
	{
	    foreach(new h: player_houses[playerid])
		{
		    count_h ++ ;
			if ( count_h == 1 ) format ( house_data, sizeof house_data, "дом № %d", h ) ;
			else format ( house_data, sizeof house_data, ", дом № %d", h ) ;
			strcat ( houses_string, house_data ) ;
		}
	}
	else if ( Iter_Count(player_houses[playerid]) == 1 )
	{
		new h = Iter_First(player_houses[playerid]) ;
		format ( houses_string, 32, "дом № %d", h ) ;
	}
	else format ( houses_string, 32, "отсутствует" ) ;

	if ( p_info [ playerid ] [ hotel_id ] > 0 && p_info [ playerid ] [ hotel ] > 0 )
		format ( hotel_data, sizeof ( hotel_data ), "%s (№%d)", b_info [ p_info [ playerid ] [ hotel_id ] - 1 ] [ b_name ], hotel_info [ p_info [ playerid ] [ hotel ] - 1 ] [ h_desc_id ] ) ;

	else format ( hotel_data, sizeof ( hotel_data ), "отсутствует" ) ;

	if ( Iter_Count(player_business[playerid]) )
	{
	    foreach(new b: player_business[playerid])
		{
		    count_b ++ ;
			if ( count_b == 1 ) format ( business_date, sizeof business_date, "%s (№%d)", b_info [ b - 1 ] [ b_name ], b ) ;
			else format ( business_date, sizeof business_date, ", %s (№%d)", b_info [ b - 1 ] [ b_name ], b ) ;
			strcat ( business_string, business_date ) ;
		}
	}
	else format ( business_string, 32, "отсутствует" ) ;

	if ( p_info [ playerid ] [ cellar ] != -1 )format ( garage_date, 32, "гараж № %d", p_info [ playerid ] [ cellar ] ) ;
	else format ( garage_date, 32, "отсутствует" ) ;

	if ( p_info [ playerid ] [ family ] && p_info [ playerid ] [ family_rang ] )
	{
		format ( family_data, 32, "%s", family_info [ p_info [ playerid ] [ family ] - 1 ] [ fam_name ] ) ;
		format ( family_rank_data, 32, "%s", family_rank [ p_info [ playerid ] [ family ] - 1 ] [ p_info [ playerid ] [ family_rang ] - 1 ] ) ;
	}
	else format ( family_data, 32, "отсутствует" ), format ( family_rank_data, 32, "отсутствует" ) ;

	if ( p_info [ playerid ] [ job ] != 0 && p_info [ playerid ] [ job ] < 50 )format ( job_data, sizeof ( job_data ), "%s", job_status [ p_info [ playerid ] [ job ] - 1 ] ) ;
	else format ( job_data, sizeof ( job_data ), "отсутствует" ) ;

	if ( p_info [ playerid ] [ rank ] > 0 && p_info [ playerid ] [ member ] > 0 )
	{
	    format ( fraction_data, sizeof ( fraction_data ), "%s", f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_name ] ) ;
		format ( rank_data, sizeof ( rank_data ), "%s", f_rank [ p_info [ playerid ] [ member ] - 1 ] [ p_info [ playerid ] [ rank ] - 1 ] ) ;
	}
	else format ( fraction_data, sizeof ( fraction_data ), "отсутствует" ), format ( rank_data, sizeof ( rank_data ), "отсутствует" ) ;

	format(line_string, sizeof line_string, "{"#cGRDialog"}Имя:\t{"#cWH"}%s\n", p_info [ playerid ] [ name ] );
	strcat ( global_string, line_string ) ;
	format(line_string, sizeof line_string, "{"#cGRDialog"}Номер аккаунта:\t{"#cWH"}%d\n", p_info [ playerid ] [ id ] );
	strcat ( global_string, line_string ) ;
	format(line_string, sizeof line_string, "{"#cGRDialog"}Уровень:\t{"#cWH"}%d\n", p_info [ playerid ] [ level ] );
	strcat ( global_string, line_string ) ;
	format(line_string, sizeof line_string, "{"#cGRDialog"}Очки опыта:\t{"#cWH"}%d из %d\n", p_info [ playerid ] [ exp ], ( p_info [ playerid ] [ level ] + 1 ) * 4 );
	strcat ( global_string, line_string ) ;
	format(line_string, sizeof line_string, "{"#cGRDialog"}Возраст:\t{"#cWH"}%d\n", p_info [ playerid ] [ age ] );
	strcat ( global_string, line_string ) ;
	format(line_string, sizeof line_string, "{"#cGRDialog"}Предупреждений:\t{"#cWH"}%d\n\n", p_info [ playerid ] [ p_warn ] );
	strcat ( global_string, line_string ) ;
	format(line_string, sizeof line_string, "{"#cGRDialog"}Номер телефона:\t{"#cWH"}%d\n", p_info [ playerid ] [ number ] );
	strcat ( global_string, line_string ) ;
	format(line_string, sizeof line_string, "{"#cGRDialog"}На счету телефона:\t{"#cWH"}%d\n\n", p_info [ playerid ] [ phone_balance ] );
	strcat ( global_string, line_string ) ;
	format(line_string, sizeof line_string, "{"#cGRDialog"}Уровень розыска:\t{"#cWH"}%d\n\n", p_info [ playerid ] [ wanted ] );
	strcat ( global_string, line_string ) ;
	format(line_string, sizeof line_string, "{"#cGRDialog"}Пол:\t{"#cWH"}%s\n", mm_gender [ p_info [ playerid ] [ gender ] ] );
	strcat ( global_string, line_string ) ;
	format(line_string, sizeof line_string, "{"#cGRDialog"}Работа:\t{"#cWH"}%s\n", job_data );
	strcat ( global_string, line_string ) ;
	format(line_string, sizeof line_string, "{"#cGRDialog"}Организация:\t{"#cWH"}%s\n", fraction_data );
	strcat ( global_string, line_string ) ;
	format(line_string, sizeof line_string, "{"#cGRDialog"}Ранг:\t{"#cWH"}%s\n\n", rank_data );
	strcat ( global_string, line_string ) ;
	format(line_string, sizeof line_string, "{"#cGRDialog"}Семья:\t{"#cWH"}%s\n", family_data );
	strcat ( global_string, line_string ) ;
	format(line_string, sizeof line_string, "{"#cGRDialog"}Семейный статус:\t{"#cWH"}%s\n\n", family_rank_data );
	strcat ( global_string, line_string ) ;
	format(line_string, sizeof line_string, "{"#cGRDialog"}Проживание:\t{"#cWH"}%s\n", houses_string );
	strcat ( global_string, line_string ) ;
	format(line_string, sizeof line_string, "{"#cGRDialog"}Номер в отеле:\t{"#cWH"}%s\n", hotel_data );
	strcat ( global_string, line_string ) ;
	format(line_string, sizeof line_string, "{"#cGRDialog"}Бизнес:\t{"#cWH"}%s\n", business_string );
	strcat ( global_string, line_string ) ;
	format(line_string, sizeof line_string, "{"#cGRDialog"}Гараж:\t{"#cWH"}%s\n", garage_date );
	strcat ( global_string, line_string ) ;
	format(line_string, sizeof line_string, "{"#cGRDialog"}Можно иметь домов:\t{"#cWH"}%d\n", p_info [ playerid ] [ max_house ] );
	strcat ( global_string, line_string ) ;
	format(line_string, sizeof line_string, "{"#cGRDialog"}Можно иметь бизнесов:\t{"#cWH"}%d\n", p_info [ playerid ] [ max_biz ] );
	strcat ( global_string, line_string ) ;
	format(line_string, sizeof line_string, "{"#cGRDialog"}Можно иметь транспорта:\t{"#cWH"}%d\n\n", p_info [ playerid ] [ max_veh ] );
	strcat ( global_string, line_string ) ;

	new _vip = p_info [ playerid ] [ vip ], s_year, s_month, s_day, s_hour, s_minute, s_second ;
 	if ( _vip && p_info [ playerid ] [ vip_day ] > gettime ( ) )
	{
		timestamp_to_date ( p_info [ playerid ] [ vip_day ] + CONVERT_TIME_TO_MOSCOW, s_year, s_month, s_day, s_hour, s_minute, s_second ) ;
	    if ( _vip == 1 ) format ( line_string, sizeof line_string, "{"#cGRDialog"}VIP {cd7f32}'Bronze' {"#cGRDialog"}истекает\t{cd7f32}%02d.%02d.%d в %02d:%02d:%02d\n", s_year, s_month, s_day, s_hour, s_minute, s_second ) ;
	    else if ( _vip == 2 ) format ( line_string, sizeof line_string, "{"#cGRDialog"}VIP {c8c8c8}'Silver' {"#cGRDialog"}истекает\t{c8c8c8}%02d.%02d.%d в %02d:%02d:%02d\n", s_year, s_month, s_day, s_hour, s_minute, s_second ) ;
	    else if ( _vip == 3 ) format ( line_string, sizeof line_string, "{"#cGRDialog"}VIP {c3900a}'Gold' {"#cGRDialog"}истекает\t{c3900a}%02d.%02d.%d в %02d:%02d:%02d\n", s_year, s_month, s_day, s_hour, s_minute, s_second ) ;
		strcat ( global_string, line_string ) ;
	}
	if ( p_info [ playerid ] [ crime_plus ] )
	{
		timestamp_to_date ( p_info [ playerid ] [ crime_plus_date ] + CONVERT_TIME_TO_MOSCOW, s_year, s_month, s_day, s_hour, s_minute, s_second ) ;
	    format ( line_string, sizeof line_string, "{"#cGRDialog"}Срок действия подписки истекает\t{"#cWH"}%02d.%02d.%d в %02d:%02d:%02d\n", s_year, s_month, s_day, s_hour, s_minute, s_second ) ;
		strcat ( global_string, line_string ) ;
	}

	format ( line_string, sizeof line_string, "{"#cGRDialog"}Отыграно часов\t{"#cWH"}%d\n", _hour ) ;
	strcat ( global_string, line_string ) ;

	show_dialog ( toid, d_mm_stats, DIALOG_STYLE_TABLIST, "{"#cBHD"}Статистика игрока", global_string, "Назад", "Закрыть" ) ;
	return 1 ;
}

stock show_security ( playerid )
{
    global_string [ 0 ] = EOS ;
	/*format ( global_string, 342, "{"#cBL"}1.{ffffff} Изменить пароль\t \n{"#cBL"}2.{ffffff} Графический код\t%s\n{"#cBL"}3.{ffffff} Привязка Google Authenticator\t%s\n{"#cBL"}4.{ffffff} E-Mail адрес\t%s\n{"#cBL"}5.{ffffff} Отпечаток пальца\t%s",
