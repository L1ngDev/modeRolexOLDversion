	if ( target_tie [ playerid ] != INVALID_PLAYER_ID )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы связаны." ) ;
	if ( p_info [ playerid ] [ rank ] < 2 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Доступно со 2 ранга." ) ;
	if ( sscanf ( params, "u", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /cuff [ид/имя]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете на себя надеть наручники." ) ;
	if ( target_cuff [ params [ 0 ] ] != INVALID_PLAYER_ID )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}На игрока уже надеты наручники." ) ;
	if ( IsPlayerInAnyVehicle ( params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Сперва вытащите игрока из машины." ) ;
	if ( p_info [ params [ 0 ] ] [ wanted ] < 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Человек, на которого Вы хотите надеть наручники, не находится в розыске." ) ;
    if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;

    if ( reload_police_warning ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы пытаетесь применить NonRP санкцию! Она заблокирована." ) ;

	if ( used_area [ params [ 0 ] ] != -1 )
	{
		new _a_type = area_info [ used_area [ params [ 0 ] ] ] [ a_type ] ;
		if ( _a_type == area_type_sellstatus )
		{
		    return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нельзя заковать игрока в наручники в этой зоне." ) ;
		}
	}

	player_cuff [ playerid ] = params [ 0 ] ;
	target_cuff [ params [ 0 ] ] = playerid ;
	SetPlayerAttachedObject ( params [ 0 ], 1, 19418, 6, -0.011000, 0.028000, -0.022000, -15.600012, -33.699977, -81.700035, 0.891999, 1.000000, 1.168000 ) ;
	SetPlayerSpecialAction ( params [ 0 ], SPECIAL_ACTION_CUFFED ) ;

	new scm_string [ 82 ] ;
	format ( scm_string, 82, "%s[%d] надел(а) на Вас наручники.", p_info [ playerid ] [ name ], playerid ) ;
	SendClientMessage ( params [ 0 ], col_wavy, scm_string ) ;

	format ( scm_string, sizeof ( scm_string ), "надел(-а) наручники на %s", p_info [ params [ 0 ] ] [ name ] ) ;
	me_action ( playerid, scm_string ) ;
	return true ;
}

