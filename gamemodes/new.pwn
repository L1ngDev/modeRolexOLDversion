callback: bankTicketList ( playerid, page, init )
{
    if ( init )
    {
		static const _str [ ] = "SELECT id, fine_value FROM users_tickets WHERE u_id = %d LIMIT 10 OFFSET %d" ;
		new query_string [ sizeof _str + ( 9 * 2 ) ] ;
        format ( query_string, sizeof query_string, _str, p_info [ playerid ] [ id ] , page * 10 ) ;
        mysql_tquery ( sql_connection, query_string, "bankTicketList", "iii", playerid, page, 0 ) ;
    }
    else
    {
		page_count [ playerid ] = page ;
		clear_player_listitem_values ( playerid ) ;

        new rows, fields ;
		cache_get_data ( rows, fields ) ;

		if ( ! rows )
		{
			if ( ! tablet_opened [ playerid ] ) show_deposit ( playerid ) ;
			SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Ничего не найдено." ), page_count [ playerid ] = 0 ;
			return 1 ;
		}

        new pl_ticket_id, pl_ticket_count, all_ticket_price ;

		global_string [ 0 ] = EOS ;
		strcat ( global_string, "{"#cBHD"}№ штрафа:\n{"#cBHD"}Сумма к оплате:\n" ) ;
		for ( new i = 0 ; i < rows ; i ++ )
		{
			pl_ticket_id = cache_get_field_content_int ( i, "id", sql_connection ) ;
			pl_ticket_count = cache_get_field_content_int ( i, "fine_value", sql_connection ) ;

			switch ( p_info [ playerid ] [ vip ] )
			{
				case 2: pl_ticket_count = pl_ticket_count - floatround ( ( pl_ticket_count * 30 ) / 100 ) ;
				case 3: pl_ticket_count = pl_ticket_count - floatround ( ( pl_ticket_count * 50 ) / 100 ) ;
			}

			all_ticket_price += pl_ticket_count ;

            set_player_listitem_values ( playerid, i, pl_ticket_id ) ;

			format ( global_string, sizeof global_string, "%s{"#cWH"}Штраф {"#cBL"}№%d\t{"#cWH"}Сумма: {"#cBL"}%d"valute_title_"\n", global_string, pl_ticket_id, pl_ticket_count ) ;
		}

		if ( page > 0 ) strcat ( global_string, "{"#cBL"}Предыдущая страница\n" ) ;
		if ( rows == 10 ) strcat ( global_string, "{"#cBL"}Следующая страница" ) ;

		show_dialog ( playerid, d_bankticket_list, DIALOG_STYLE_TABLIST_HEADERS, "{"#cBHD"}Штрафы", global_string, "Выбрать", "Назад" ) ;
	}
    return true ;
}

callback: callback_bankticket_info ( playerid )
{
	new rows,
		fields ;
	cache_get_data ( rows, fields ) ;
	if ( rows )
	{
		new ticket_count,
			ticket_date [ 16 ],
			ticket_reason [ 42 ] ;

		ticket_count = cache_get_field_content_int ( 0, "fine_value", sql_connection ) ;
		cache_get_field_content(0, "fine_type", ticket_reason, sql_connection, 42 ) ;
		cache_get_field_content(0, "fine_date", ticket_date, sql_connection, 16 ) ;

		switch ( p_info [ playerid ] [ vip ] )
		{
		    case 2: ticket_count = ticket_count - floatround ( ( ticket_count * 30 ) / 100 ) ;
		    case 3: ticket_count = ticket_count - floatround ( ( ticket_count * 50 ) / 100 ) ;
		}

		new dialog_string [ 186 ] ;
		format ( dialog_string, sizeof ( dialog_string ), "{FFFFFF}Сумма: {"#cBL"}%d"valute_title_"{FFFFFF}\nПричина: {"#cBL"}%s{FFFFFF}\nДата штрафа: {"#cBL"}%s",
		ticket_count, ticket_reason, ticket_date ) ;
		show_dialog ( playerid, d_bankticket_stats, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Информация о штрафе", dialog_string, "Назад", "" ) ;
	}
	if ( ! rows ) bankTicketList ( playerid, page_count [ playerid ], 1 ) ;
	return 1 ;
}

callback: callback_bankticket_payment ( playerid )
{
	new rows,
		fields ;
	cache_get_data ( rows, fields ) ;
	if ( rows )
	{
		new ticket_count, deposit_id = get_player_use_listitem ( playerid ), commision = 0 ;

		ticket_count = cache_get_field_content_int ( 0, "fine_value", sql_connection ) ;

		switch ( p_info [ playerid ] [ vip ] )
		{
		    case 2: ticket_count = ticket_count - floatround ( ( ticket_count * 30 ) / 100 ) ;
		    case 3: ticket_count = ticket_count - floatround ( ( ticket_count * 50 ) / 100 ) ;
		}

		if ( tablet_opened [ playerid ] ) commision = ( ticket_count * TABLET_BANK_COMMISION ) / 100 ;
		if ( bank_info [ playerid ] [ bi_money ] [ deposit_id ] < ticket_count + commision )
		{
			SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас не достаточно средств на банковском счёте для оплаты штрафов." ) ;

			bankTicketList ( playerid, page_count [ playerid ], 1 ) ;
			return 1 ;
		}

		new ticket_id,
			query_string [ 128 ] ;

		bank_info [ playerid ] [ bi_money ] [ deposit_id ] -= ticket_count + commision ;

		format ( query_string, sizeof ( query_string ), "UPDATE `deposit_boxes` SET `db_money` = '%d' WHERE `db_id` = '%d' LIMIT 1", bank_info [ playerid ] [ bi_money ] [ deposit_id ], bank_info [ playerid ] [ bi_id ] [ deposit_id ] ) ;
		mysql_tquery ( sql_connection, query_string, "", "" ) ;

		ticket_id = get_player_listitem_values ( playerid, GetPVarInt ( playerid, "ticket_listitem" ) ) ;
		clear_player_listitem_values ( playerid ) ;

		mysql_format ( sql_connection, query_string, sizeof query_string, "DELETE FROM `users_tickets` WHERE `id` = '%d' LIMIT 1", ticket_id ) ;
		mysql_tquery ( sql_connection, query_string, "" ) ;

		p_info [ playerid ] [ ticket_c ] -= 1 ;

		SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Штраф успешно оплачен." ) ;
		if ( ! tablet_opened [ playerid ] ) show_deposit ( playerid ) ;

		set_money_fraction ( 10, 4, ticket_count, true ) ;
	}
	else bankTicketList ( playerid, page_count [ playerid ], 1 ) ;
	return 1 ;
}

callback: callback_ticket_player ( playerid )
{
	new rows, fields;
	cache_get_data ( rows, fields ) ;
	if ( rows )
		SendClientMessage ( playerid, col_orange, !"* У Вас есть неоплаченные штрафы. Оплатите их в любом банкомате или банке." ) ;

	p_info [ playerid ] [ ticket_c ] = rows ;

	new sql_string [ 59 + 9 ] ;
	format ( sql_string, sizeof sql_string, "SELECT * FROM `users_quests` WHERE `u_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
	mysql_tquery ( sql_connection, sql_string, "callback_users_quests", "i", playerid ) ;
	return 1 ;
}

