stock show_settings_business ( playerid, business_id, select_id )
{
	global_string [ 0 ] = EOS ;
	for ( new i = 0; i < b_info [ business_id - 1 ] [ b_settings ] [ 3 ] ; i ++ )
	{
		new line_string [ 64 ] ;
		format ( line_string, 64, "{"#cBL"}%i.{"#cWH"} %s\n", i + 1, b_rank [ business_id - 1 ] [ i ] ) ;
		strcat ( global_string, line_string ) ;
	}
	if ( select_id == 0 )
	{
	    SetPVarInt ( playerid, "select_id", 0 ) ;
		show_dialog ( playerid, d_business_settings_select, DIALOG_STYLE_LIST, "{"#cBHD"}Устройство на работу", global_string, "Выбрать", "Назад" ) ;
	}
	else if ( select_id == 1 )
	{
	    SetPVarInt ( playerid, "select_id", 1 ) ;
		show_dialog ( playerid, d_business_settings_select, DIALOG_STYLE_LIST, "{"#cBHD"}Увольнение с работы", global_string, "Выбрать", "Назад" ) ;
	}
	else if ( select_id == 2 )
	{
	    SetPVarInt ( playerid, "select_id", 2 ) ;
		show_dialog ( playerid, d_business_settings_select, DIALOG_STYLE_LIST, "{"#cBHD"}Изменение должности", global_string, "Выбрать", "Назад" ) ;
	}
	else if ( select_id == 3 )
	{
	    SetPVarInt ( playerid, "select_id", 4 ) ;
		show_dialog ( playerid, d_business_settings_select, DIALOG_STYLE_LIST, "{"#cBHD"}Доступ к /bpanel", global_string, "Выбрать", "Назад" ) ;
	}
	return 1 ;
}

stock business_settings ( playerid )
{
	global_string [ 0 ] = EOS ;

    new b = p_info [ playerid ] [ business ] - 1 ;
	format ( global_string, 512, "{"#cGRDialog"}- {"#cWH"}Устройство на работу\t\t{"#cGN"}%s\n{"#cGRDialog"}- {"#cWH"}Увольнение с работы\t{"#cGN"}%s\n{"#cGRDialog"}- {"#cWH"}Изменение должности\t{"#cGN"}%s\n{"#cGRDialog"}- {"#cWH"}Доступ к /bpanel\t\t{"#cGN"}%s\n{"#cGRDialog"}- {"#cWH"}Количество должностей\t{"#cGN"}%d\n{"#cGRDialog"}- {"#cWH"}Название должностей\n{"#cGRDialog"}- {"#cWH"}Оформление рабочего чата",
	b_rank [ b ] [ b_info [ b ] [ b_settings ] [ 0 ] - 1 ],
	b_rank [ b ] [ b_info [ b ] [ b_settings ] [ 1 ] - 1 ],
	b_rank [ b ] [ b_info [ b ] [ b_settings ] [ 2 ] - 1 ],
	b_rank [ b ] [ b_info [ b ] [ b_settings ] [ 4 ] - 1 ],
	b_info [ b ] [ b_settings ] [ 3 ] ) ;

	show_dialog ( playerid, d_business_settings, DIALOG_STYLE_LIST, "{"#cBHD"}Настройки", global_string, "Выбрать", "Назад" ) ;
	return 1 ;
}

stock business_sql ( business_id )
{
    new query_string [ 144 ];
    format ( query_string, sizeof query_string, "UPDATE `businesses` SET `b_settings` = '%d|%d|%d|%d|%d|%d|%d|%d' WHERE `b_id` = '%d' LIMIT 1",
	b_info [ business_id - 1 ] [ b_settings ] [ 0 ],
	b_info [ business_id - 1 ] [ b_settings ] [ 1 ],
	b_info [ business_id - 1 ] [ b_settings ] [ 2 ],
	b_info [ business_id - 1 ] [ b_settings ] [ 3 ],
	b_info [ business_id - 1 ] [ b_settings ] [ 4 ],
	b_info [ business_id - 1 ] [ b_settings ] [ 5 ],
	b_info [ business_id - 1 ] [ b_settings ] [ 6 ],
	b_info [ business_id - 1 ] [ b_settings ] [ 7 ],
	b_info [ business_id - 1 ] [ b_id ] ) ;
 	mysql_tquery ( sql_connection, query_string ) ;
 	return 1 ;
}

stock business_personal ( playerid )
{
    new dialog_string [ 234 + 13 ], b = p_info [ playerid ] [ business ] - 1 ;
	if ( b < 0 ) return bad_exit ( playerid ) ;

	format ( dialog_string, sizeof dialog_string, "{"#cBL"}1.{"#cWH"} Получение заработной платы ({"#cGN"}%s{"#cWH"})\n{"#cBL"}2.{"#cWH"} Заработная плата\n{"#cBL"}3.{"#cWH"} Состав работников\n{"#cBL"}4.{"#cWH"} Состав работников [ {"#cGN"}ONLINE{"#cWH"} ]\n{"#cGRDialog"}Настройки", ( b_info [ b ] [ b_status_salary ] == 0 ) ? ( "В 20:00" ) : ( "Каждый час" ) ) ;
	show_dialog ( playerid, d_b_panel_personal, DIALOG_STYLE_LIST, "{"#cBHD"}Управление персоналом", dialog_string, "Выбрать", "Закрыть" ) ;
	return 1 ;
}

stock business_sound ( playerid )
{
	new dialog_string [ 156 + 12 ], b = p_info [ playerid ] [ business ] - 1, text_sound [ 12 ] ;
	switch ( b_info [ b ] [ b_radio_status ] )
	{
	    case 0: format ( text_sound, sizeof text_sound, "Отключено" ) ;
	    case 1: format ( text_sound, sizeof text_sound, "Мелодия" ) ;
	    case 2: format ( text_sound, sizeof text_sound, "Ссылка" ) ;
	}

	format ( dialog_string, sizeof dialog_string, "{"#cBL"}1.{"#cWH"} Способ проигрывания {"#cGRDialog"}({"#cGN"}%s{"#cGRDialog"})\n{"#cBL"}2.{"#cWH"} Выбрать мелодию\n{"#cBL"}3.{"#cWH"} Установить ссылку", text_sound ) ;
	show_dialog ( playerid, d_b_panel_sound, DIALOG_STYLE_LIST, "{"#cBHD"}Музыка при входе", dialog_string, "Выбрать", "Закрыть" ) ;
	return 1 ;
}

stock business_freeze ( playerid )
{
    new dialog_string [ 242 + 4 + 16 + 4 ], b = p_info [ playerid ] [ business ] - 1, s_year, s_month, s_day ;
	timestamp_to_date ( b_info [ b ] [ b_freeze_date ], s_year, s_month, s_day ) ;

	format ( dialog_string, sizeof dialog_string, "{"#cBL"}1.{"#cWH"} Заморозить {"#cGRDialog"}(Доступно: {"#cGN"}%d{"#cGRDialog"} дн.)\n{"#cBL"}2.{"#cWH"} Последняя заморозка: {"#cGN"}%02d.%02d.%d\n{"#cBL"}3.{"#cWH"} Информация\n{"#cGRDialog"}Осталось {"#cGN"}%d{"#cGRDialog"} дн. до конца заморозки", b_info [ b ] [ b_freeze_day ], s_day, s_month, s_year, b_info [ b ] [ b_freeze ] ) ;
	show_dialog ( playerid, d_b_panel_freeze, DIALOG_STYLE_LIST, "{"#cBHD"}Заморозка бизнеса", dialog_string, "Выбрать", "Закрыть" ) ;
	return 1 ;
}

alias:mm("mn", "menu")
CMD:mm ( playerid )
{
	show_mainmenu ( playerid ) ;
	return 1 ;
}

CMD:play ( playerid )
{
	if ( GetPlayerState ( playerid ) == PLAYER_STATE_DRIVER )
	{
	    new _v_id = GetPlayerVehicleID ( playerid ) ;
	    if ( veh_info [ _v_id - 1 ] [ v_owner ] == p_info [ playerid ] [ id ] )
		{
		    for ( new j = 0 ; j < MAX_DM_ZONE ; j ++ )
			{
				if ( ! IsPlayerInQuad ( playerid, anti_dm_pos [ j ] [ 0 ], anti_dm_pos [ j ] [ 1 ], anti_dm_pos [ j ] [ 2 ], anti_dm_pos [ j ] [ 3 ] ) ) continue ;

				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Запрещено устанавливать магнитофон в зелёной зоне." ) ;
				return 1 ;
			}

			new bool: find_boombox = false ;
			foreach(new i: streamed_players[playerid])
			{
				if ( ! boombox_player [ playerid ] [ b_status ] ) continue ;

				find_boombox = true ;
				break ;
			}

			if ( find_boombox == true ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Уже кто-то установил магнитофон." ) ;
			return 1 ;
		}
	}

    if ( player_device { playerid } == 2 )
	{
		show_dialog ( playerid, d_recorder, DIALOG_STYLE_LIST, "{"#cBHD"}Наушники", "{"#cBL"}1. {"#cWH"}Радио\n{"#cRD"}Отключить", "Выбор", "Выход" ) ;
		return 1 ;
	}

	show_dialog ( playerid, d_recorder, DIALOG_STYLE_LIST, "{"#cBHD"}Наушники", "{"#cBL"}1. {"#cWH"}Радио\n{"#cRD"}Отключить\n\n{"#cGRDialog"}* /recorder - установить колонку", "Выбор", "Выход" ) ;
	return 1 ;
}

stock SetAttachedBoomBox ( playerid )
{
    if ( ! IsPlayerAttachedObjectSlotUsed ( playerid, 4 ) ) SetPlayerAttachedObject ( playerid, 4, jbl_object, 5, 0.299999, 0.099999, 0.0, 0.0, -83.00, 0.0, 1.0, 1.0, 1.0);
	else if ( IsPlayerAttachedObjectSlotUsed ( playerid, 4 ) ) RemovePlayerAttachedObject ( playerid, 4 ) ;
	return 1 ;
}

