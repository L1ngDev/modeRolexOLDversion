					else
					{
						format ( line_string, sizeof line_string, "{ffffff}Одежда '%s' (%d)\n", get_skin_name ( p_info [ playerid ] [ temp_skin ] [ j ] ), p_info [ playerid ] [ temp_skin ] [ j ] ) ;
						strcat ( global_string, line_string ) ;
					}
				}
				strcat ( global_string, "Одежда организации" ) ;
				show_dialog ( playerid, d_boat_clothes, DIALOG_STYLE_LIST, "{"#cBHD"}Гардероб", global_string, "Выбрать", "Назад" ) ;
				return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}В данном слоте нет одежды." ) ;
			}
			set_skin ( playerid, p_info [ playerid ] [ temp_skin ] [ listitem ] ) ;

			new line_string [ 80 ] ;
			global_string [ 0 ] = EOS ;
			for ( new j = 0 ; j < 5 ; j ++ )
			{
				if ( p_info [ playerid ] [ temp_skin ] [ j ] == 0 )
				{
					strcat ( global_string, "{"#cGRDialog"}- Пусто\n" ) ;
				}
				else
				{
					format ( line_string, sizeof line_string, "{ffffff}Одежда '%s' (%d)\n", get_skin_name ( p_info [ playerid ] [ temp_skin ] [ j ] ), p_info [ playerid ] [ temp_skin ] [ j ] ) ;
					strcat ( global_string, line_string ) ;
				}
			}
			strcat ( global_string, "Одежда организации" ) ;
			show_dialog ( playerid, d_boat_clothes, DIALOG_STYLE_LIST, "{"#cBHD"}Гардероб", global_string, "Выбрать", "Назад" ) ;
			return 1 ;
		}
		case d_hmenu_stats:
		{
			if ( ! response ) return 1 ;
			show_hmenu ( playerid ) ;
			return 1 ;
		}
		case d_h_improvement:
		{
			if ( ! response ) return show_hmenu ( playerid ) ;
			new house_id = p_info [ playerid ] [ house ] - 1 ;
			if ( h_info [ house_id ] [ h_improve ] [ listitem ] )
			{
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас уже установлено это улучшение." ) ;
				show_hmenu ( playerid ) ;
				return 1 ;
			}
			else if ( ( ! listitem && ! h_info [ house_id ] [ h_improve ] [ listitem ] ) || ( h_info [ house_id ] [ h_improve ] [ listitem - 1 ] && ! h_info [ house_id ] [ h_improve ] [ listitem ] ) )
			{
				new mes [ 156 ] ;
				format ( mes, sizeof ( mes ), "{"#cWH"}Вы хотите купить улучшение: {"#cBL"}\"%s\"?\n\n{"#cWH"}Оно обойдется Вам в {"#cGN"}%d"valute_title"{"#cWH"}.", h_improve_name [ listitem ], h_improve_price [ listitem ] ) ;
				show_dialog ( playerid, d_h_improvement_accept, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Улучшения дома", mes, "Купить", "Отмена" ) ;
				set_player_use_listitem ( playerid, listitem ) ;
			}
			else
			{
			    new scm_string [ 144 ] ;
			    format ( scm_string, sizeof scm_string, "{"#cRInfo"}* {"#cGRInfo"}Это улучшение ещё не доступно Вам. Сперва приобретите {"#cBL"}%s{"#cGRInfo"}.", h_improve_name [ listitem - 1 ] ) ;
				SendClientMessage ( playerid, col_gray, scm_string ) ;

				show_hmenu ( playerid ) ;
			}
			return 1 ;
		}
		case d_h_improvement_accept:
		{
			new improveid = get_player_use_listitem ( playerid ) ;
			if ( ! response ) return show_hmenu ( playerid ) ;
			new price = h_improve_price [ improveid ] ;
			if ( p_info [ playerid ] [ money ] < price )
			{
				show_hmenu ( playerid ) ;
				return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас недостаточно денег." ) ;
			}
			new house_id = p_info [ playerid ] [ house ] - 1 ;
			new hintid = h_info [ house_id ] [ h_int ] - 1 ;

			switch ( improveid )
			{
				case improve_safe:
				{
					#if defined Computer
				    h_info [ house_id ] [ h_safe ] = CreateDynamic3DTextLabel ( "** Сейф **\n{"#cGR3D"}Нажмите {"#cWH3D"}Y{"#cGR3D"} для взаимодействия", col_header_3d, house_safe_pos [ hintid ] [ 0 ], house_safe_pos [ hintid ] [ 1 ], house_safe_pos [ hintid ] [ 2 ] + 0.8, 5.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, h_info [ house_id ] [ h_id ] ) ;
				    #else
				    h_info [ house_id ] [ h_safe ] = CreateDynamic3DTextLabel ( "** Сейф **", col_header_3d, house_safe_pos [ hintid ] [ 0 ], house_safe_pos [ hintid ] [ 1 ], house_safe_pos [ hintid ] [ 2 ] + 0.8, 5.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, h_info [ house_id ] [ h_id ] ) ;
				    #endif
					#if defined SAMP
					h_info [ house_id ] [ h_safe_object ] = CreateDynamicObject ( 2332, house_safe_pos [ hintid ] [ 0 ], house_safe_pos [ hintid ] [ 1 ], house_safe_pos [ hintid ] [ 2 ], house_safe_pos [ hintid ] [ 3 ], house_safe_pos [ hintid ] [ 4 ], house_safe_pos [ hintid ] [ 5 ], h_info [ house_id ] [ h_id ], house_int [ hintid ] [ hint_int ] ) ;
					#endif
				}
				case improve_freeze:
				{
					SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Для заказа продуктов используйте /service." ) ;
					#if defined Computer
				    h_info [ house_id ] [ h_fridge ] = CreateDynamic3DTextLabel ( "** Холодильник **\n{"#cGR3D"}Нажмите {"#cWH3D"}Y{"#cGR3D"} для взаимодействия", col_header_3d, house_freeze_pos [ hintid ] [ 0 ], house_freeze_pos [ hintid ] [ 1 ], house_freeze_pos [ hintid ] [ 2 ] + 0.8, 5.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, h_info [ house_id ] [ h_id ] ) ;
				    #else
				    h_info [ house_id ] [ h_fridge ] = CreateDynamic3DTextLabel ( "** Холодильник **", col_header_3d, house_freeze_pos [ hintid ] [ 0 ], house_freeze_pos [ hintid ] [ 1 ], house_freeze_pos [ hintid ] [ 2 ] + 0.8, 5.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, h_info [ house_id ] [ h_id ] ) ;
				    #endif
                    #if defined SAMP
					h_info [ house_id ] [ h_fridge_object ] = CreateDynamicObject ( 2141, house_freeze_pos [ hintid ] [ 0 ], house_freeze_pos [ hintid ] [ 1 ], house_freeze_pos [ hintid ] [ 2 ], house_freeze_pos [ hintid ] [ 3 ], house_freeze_pos [ hintid ] [ 4 ], house_freeze_pos [ hintid ] [ 5 ], h_info [ house_id ] [ h_id ], house_int [ hintid ] [ hint_int ] ) ;
                    #endif
				}
			}

			h_info [ house_id ] [ h_improve ] [ improveid ] = 1 ;
			new data [ 32 ], query [ 128 ] ;
			for ( new i = 0 ; i < 8 ; i ++ )
			{
				if ( ! i ) format ( data, sizeof ( data ),"%d", h_info [ house_id ] [ h_improve ] [ i ] ) ;
				else format ( data, sizeof ( data ),"%s|%d", data, h_info [ house_id ] [ h_improve ] [ i ] ) ;
			}
			format(query,sizeof(query),"UPDATE `houses` SET `h_improve` = '%s' WHERE `h_id` = '%d' LIMIT 1", data, house_id + 1 ) ;
			mysql_tquery ( sql_connection, query ) ;

			give_money ( playerid, -price ) ;
			insert_money_log ( playerid, INVALID_PLAYER_ID, -price, "Улучшение дома" ) ;

			SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Поздравляем, Вы купили улучшение для дома." ) ;
			if ( improveid == improve_safe )
			{
				h_info [ house_id ][ h_safe_code ] = 0 ;
				format ( query, sizeof query, "UPDATE `houses` SET `h_safe_code` = '0000' WHERE `h_id` = '%d' LIMIT 1",h_info [ house_id ] [ h_id ] ) ;
				mysql_tquery ( sql_connection, query ) ;
				SendClientMessage ( playerid, col_white, !"{"#cBInfo"}* {"#cWH"}Код сейфа по умолчанию: {"#cBL"}0000" ) ;
			}
			for ( new i = 0 ; i < 8 ; i ++ )
			{
				new c [ 7 ] ;
				if ( h_info [ house_id ] [ h_improve ] [ i ] ) c = ""#cGN"";
				else if ( ! i || h_info [ house_id ] [ h_improve ] [ i - 1 ] ) c = ""#cWH"" ;
				else c = ""#cGRDialog"" ;
				if ( ! i ) format( global_string, sizeof ( global_string ),"{%s}%d. %s", c, i + 1, h_improve_name [ i ] ) ;
				else format( global_string, sizeof ( global_string ),"%s\n{%s}%d. %s", global_string, c, i + 1, h_improve_name [ i ] ) ;
			}
			show_dialog ( playerid, d_h_improvement, DIALOG_STYLE_LIST, "{"#cBHD"}Улучшения дома", global_string, "Выбрать", "Назад" ) ;
			return 1 ;
		}
		case d_safe_pin:
		{
			if ( ! response ) return 1 ;

			new house_id = GetPVarInt ( playerid, "house_id" ) - 1, _str [ 12 ], _str2 [ 32 ] ;
			if ( strval ( inputtext ) != h_info [ house_id ] [ h_safe_code ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы ввели неправильный код от сейфа." ) ;

			safe_pin_status [ playerid ] = true ;
			if ( player_device { playerid } == 2 )
			{
			    if ( p_info [ playerid ] [ hour_played ] < FIVE_HOUR_PLAYED ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Доступно с 5 часов в игре. Используйте /mm - Информация о персонаже - Статистика персонажа." ) ;

				#if defined m_inventory_module
				    if ( used_inventory [ playerid ] == false )
				    {
						used_inventory [ playerid ] = true ;
						toggle_controlable ( playerid, false ) ;

						SetInventoryItem ( playerid ) ;
						setInventoryLayout ( playerid, 1 ) ;
						setInventoryWarehouse ( playerid, SUB_INV_HOUSE, house_id + 1 ) ;
						set_inventory_button ( playerid, SUB_INV_HOUSE ) ;
						format ( _str, sizeof _str, "%d", house_id + 1 ) ;
						format ( _str2, sizeof _str2, "%s", GetPlayerCashValueToSmile ( h_info [ house_id ] [ h_safe_data ] [ 1 ] ) ) ;
						setWarehouseInfo (
							playerid,
							"Домашний сейф",
							"Здесь хранятся предметы, которые\nв доме",
							"СЕЙФ ДОМА",
							"ДЕНЕГ В СЕФЕЙ",
							_str,
							_str2
						) ;
					}
				#endif
				return 1 ;
			}
			new line_string [ 68 ],
				gun_name [ 32 ] ;

			global_string [ 0 ] = EOS ;
			format ( global_string, 368,"{"#cWH"}Наркотики [{"#cGN"}%d грамм{"#cWH"}]\nДеньги [{"#cGN"}%d"valute_title_"{"#cWH"}]\n\n{"#cLY"}Оружие:{ffffff}\n\n", h_info [ house_id ] [ h_safe_data ] [ 0 ], h_info [ house_id ] [ h_safe_data ] [ 1 ] ) ;

			for ( new j = 0 ; j < 3 ; j ++ )
			{
				if ( h_info [ house_id ] [ h_safe_guns ] [ j ] > 38 || h_info [ house_id ] [ h_safe_guns ] [ j ] < 1 || h_info [ house_id ] [ h_safe_guns ] [ j + 3 ] == 0 )strcat ( global_string, "{"#cGRDialog"}- Пусто\n" ) ;
				else
				{
					GetWeaponName ( h_info [ house_id ] [ h_safe_guns ] [ j ], gun_name, 32 ) ;
					format ( line_string, sizeof line_string, "{"#cBL"}%s{"#cWH"}   |   {"#cBL"}%d пт.\n", gun_name, h_info [ house_id ] [ h_safe_guns ] [ j + 3 ] ) ;
					strcat ( global_string, line_string ) ;
				}
			}
			show_dialog ( playerid, d_safe, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Сейф", global_string, "Далее", "Закрыть" ) ;
			return 1 ;
		}
		case d_safe:
		{
			if ( ! response ) return 1 ;
			//show_dialog ( playerid, d_safe_access, DIALOG_STYLE_LIST, "{"#cBHD"}Сейф", "Взять деньги\nПоложить деньги\nВзять наркотики\nПоложить наркотики\nОружие\n{"#cLY"}Сменить пин-код", "Выбрать", "Закрыть" ) ;
			show_dialog ( playerid, d_safe_access, DIALOG_STYLE_LIST, "{"#cBHD"}Сейф", "Взять деньги\nПоложить деньги\n\n{"#cLY"}Сменить пин-код", "Выбрать", "Закрыть" ) ;
			return 1 ;
		}
		case d_safe_access:
		{
			if ( ! response ) return true ;
			if ( response )
			{
				switch ( listitem )
				{
					case 0:
					{
					    if ( p_info [ playerid ] [ hour_played ] < THREE_HOUR_PLAYED ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Доступно с 3 часов в игре. Используйте /mm - Информация о персонаже - Статистика персонажа." ) ;

						new string [ 94 + 9 ] ;
					    new h = GetPVarInt ( playerid, "house_id" ) - 1 ;
						format ( string, sizeof string, "{"#cWH"}В сейфе {"#cGN"}%d"valute_title"{"#cWH"}.\n\n{"#cGRDialog"}* Введите сумму, которую желаете взять:", h_info [ h ] [ h_safe_data ] [ 1 ] ) ;
						show_dialog ( playerid, d_safe_money_get, DIALOG_STYLE_INPUT, "{"#cBHD"}Взять деньги", string, "Принять", "Назад" ) ;
					}
					case 1:
					{
					    if ( p_info [ playerid ] [ hour_played ] < THREE_HOUR_PLAYED ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Доступно с 3 часов в игре. Используйте /mm - Информация о персонаже - Статистика персонажа." ) ;

					    new string [ 104 + 9 ] ;
					    new h = GetPVarInt ( playerid, "house_id" ) - 1 ;
						format ( string, sizeof string, "{"#cWH"}В сейфе {"#cGN"}%d"valute_title"{"#cWH"}.\n\n{"#cGRDialog"}* Введите сумму, которую желаете положить в сейф:", h_info [ h ] [ h_safe_data ] [ 1 ] ) ;
						show_dialog ( playerid, d_safe_money_put, DIALOG_STYLE_INPUT, "{"#cBHD"}Положить деньги", string, "Принять", "Назад" ) ;
					}
					case 2:
					{
						if ( p_info [ playerid ] [ house ] != GetPVarInt ( playerid, "house_id" ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Код от сейфа может изменить только владелец дома." ) ;
						show_dialog ( playerid, d_safe_changepin, DIALOG_STYLE_INPUT, "{"#cBHD"}Cменить пароль", "{ffffff}Введите новый пароль для сейфа:", "Принять", "Закрыть" ) ;
					}
					/*case 2:
					{
						new string [ 115 + 9 ] ;
					    new h = GetPVarInt ( playerid, "house_id" ) - 1 ;
						format ( string, sizeof string, "{"#cWH"}В сейфе {"#cGN"}%d{"#cWH"} грамм наркотиков.\n\n{"#cGRDialog"}* Введите количество, которое желаете взять:", h_info [ h ] [ h_safe_data ] [ 0 ]) ;
						show_dialog ( playerid, d_safe_drugs_get, DIALOG_STYLE_INPUT, "{"#cBHD"}Взять наркотики", string, "Принять", "Назад" ) ;
					}
					case 3:
					{
