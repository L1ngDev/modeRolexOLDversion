	}

	if ( globalchat_cooldown [ playerid ] > gettime ( ) )
	{
		new scm_string [ 81 + 9 ] ;
		format ( scm_string, sizeof ( scm_string ), "Вы уже писали в департамент. Повторно написать можно будет через %d секунд(ы).", globalchat_cooldown [ playerid ] - gettime ( ) ) ;
		SendClientMessage ( playerid,  col_light_red, scm_string ) ;
		return true ;
	}

	globalchat_cooldown [ playerid ] = gettime ( ) + 60 ;

	if ( check_advertise ( playerid, params, report_type_dn ) ) return 1 ;

	if ( sscanf ( params, "s[128]", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /dn [текст]" ) ;
	new scm_string [ 144 ] ;
	format ( scm_string, sizeof scm_string, "(( [D] (%s) %s %s[%d]: %s ))", f_info [ fraction_id - 1 ] [ f_name ], f_rank [ fraction_id - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], playerid, params [ 0 ] ) ;
	foreach(new i: logged_players) if ( 18 > p_info [ i ] [ member ] > 0 && p_info [ i ] [ settings ] [ 0 ] ) SendClientMessage ( i, 0xFF8282AA, scm_string ) ;

	format(scm_string, sizeof scm_string, "сказал(а) в рацию: {FFFFFF}(( %s ))", params [ 0 ]);
	SetPlayerChatBubble(playerid, scm_string, col_light_purple, 15.0, 10000);
	return 1 ;
}

stock show_government ( playerid )
{
	global_string [ 0 ] = EOS ;

	new fraction_id = p_info [ playerid ] [ member ] - 1 ;

	new timer_string [ 24 ], bool:timer_bool = false ;
	for ( new i = 0 ; i < max_fraction ; i ++ )
	{
	    if ( f_timer [ i ] != -1 )
	    {
	        timer_string = "{"#cRD"}Не доступно" ;
	        timer_bool = true ;
	        break ;
	    }
	}
	if ( timer_bool == false ) timer_string = "{"#cGN"}Доступно" ;

	new tm_string [ 24 ] ;
	if ( f_timer [ fraction_id ] != -1 ) format ( tm_string, sizeof tm_string, "%d мин.", f_time_timer [ fraction_id ] ) ;
	else format ( tm_string, sizeof tm_string, "none" ) ;

	format ( global_string, 156, "{"#cBL"}1. {"#cWH"}Строка новостей\n{"#cBL"}2. {"#cWH"}Опубликовать новость {"#cGRDialog"}({"#cLY"}%s{"#cGRDialog"})", ( f_timer [ fraction_id ] != -1 ) ? ( tm_string ) : ( timer_string ) ) ;
    show_dialog ( playerid, d_government, DIALOG_STYLE_LIST, "{"#cBHD"}Гос. Новости", global_string, "Выбрать", "Закрыть" ) ;
	return 1 ;
}

stock show_government_line ( playerid )
{
    global_string [ 0 ] = EOS ;
	new line_string [ 100 ],
	    fraction_id = p_info [ playerid ] [ member ] - 1 ;

	for ( new i = 0 ; i < max_gov_line ; i ++ )
	{
	    format ( line_string, sizeof line_string, "{"#cBL"}%d. {"#cWH"}%s\n", i + 1, f_gov_line [ fraction_id ] [ i ] ) ;
	    strcat ( global_string, line_string ) ;
	}
	show_dialog ( playerid, d_government_line, DIALOG_STYLE_LIST, "{"#cBHD"}Строка новостей", global_string, "Выбрать", "Закрыть" ) ;
	return 1 ;
}

callback: government_go ( fraction_id, player_id )
{
	if ( f_time_timer [ fraction_id - 1 ] > 0 )
	{
		if ( ! IsPlayerConnected ( player_id ) )
	    {
	        f_time_timer [ fraction_id - 1 ] = 0 ;
			KillTimer ( f_timer [ fraction_id - 1 ] ) ;
			f_timer [ fraction_id - 1 ] = -1 ;
	        return 1 ;
	    }

	    if ( p_info [ player_id ] [ member ] != fraction_id )
	    {
	        f_time_timer [ fraction_id - 1 ] = 0 ;
			KillTimer ( f_timer [ fraction_id - 1 ] ) ;
			f_timer [ fraction_id - 1 ] = -1 ;
	        return 1 ;
	    }

		f_time_timer [ fraction_id - 1 ] -- ;
		KillTimer ( f_timer [ fraction_id - 1 ] ) ;
		f_timer [ fraction_id - 1 ] = -1 ;

		f_timer [ fraction_id - 1 ] = SetTimerEx ( "government_go", 60 * 1000, false, "ii", fraction_id, player_id ) ;
	}
	else
	{
	    if ( ! IsPlayerConnected ( player_id ) )
	    {
	        f_time_timer [ fraction_id - 1 ] = 0 ;
			KillTimer ( f_timer [ fraction_id - 1 ] ) ;
			f_timer [ fraction_id - 1 ] = -1 ;
	        return 1 ;
	    }

	    if ( p_info [ player_id ] [ member ] != fraction_id )
	    {
	        f_time_timer [ fraction_id - 1 ] = 0 ;
			KillTimer ( f_timer [ fraction_id - 1 ] ) ;
			f_timer [ fraction_id - 1 ] = -1 ;
	        return 1 ;
	    }

	    if ( p_info [ player_id ] [ mute ] > 0 )
	    {
	        f_time_timer [ fraction_id - 1 ] = 0 ;
			KillTimer ( f_timer [ fraction_id - 1 ] ) ;
			f_timer [ fraction_id - 1 ] = -1 ;
	        return 1 ;
	    }

	    f_time_timer [ fraction_id - 1 ] = 0 ;
		KillTimer ( f_timer [ fraction_id - 1 ] ) ;
		f_timer [ fraction_id - 1 ] = -1 ;

	    new scm_string [ 144 ] ;
	   	for ( new l = 0 ; l < max_gov_line ; l ++ )
		{
			if ( ! GetString ( f_gov_line [ fraction_id - 1 ] [ l ], "-" ) )
			{
			    format ( scm_string, sizeof scm_string, "[Гос.Новости] %s [%d]: %s", p_info [ player_id ] [ name ], player_id, f_gov_line [ fraction_id - 1 ] [ l ] ) ;
			    foreach(new i: logged_players) SendClientMessage ( i, 0x4466CCFF, scm_string ) ;
			}
		}
	}
	return 1 ;
}

CMD:gov ( playerid )
{
	if ( p_info [ playerid ] [ member ] >= 18 || radio_player ( playerid ) || p_info [ playerid ] [ member ] == 0 )return 1 ;
	if ( ! is_fraction_duty { playerid } ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Не начат рабочий день." ) ;
	if ( p_info [ playerid ] [ rank ] <  f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 10 ] )
	{
	    static const _str [ ] = "{"#cRInfo"}* {"#cGRInfo"}Команда доступна с ранга %s (%d)." ;
	    new scm_string [ sizeof _str + 30 + 3 ] ;
	    format ( scm_string, sizeof scm_string, _str, f_rank [ p_info [ playerid ] [ member ] - 1 ] [ f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 10 ] - 1 ], f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 10 ] ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
		return 1 ;
	}
	if ( p_info [ playerid ] [ mute ] )
	{
		new scm_string [ 38 ] ;
		format ( scm_string, sizeof ( scm_string ),"У вас бан чата | %d секунд(ы)", p_info [ playerid ] [ mute ] ) ;
		SendClientMessage ( playerid, col_light_red, scm_string ) ;
		return false ;
	}
    show_government ( playerid ) ;
	/*if ( isnull ( params ) || params [ 0 ] == ' ' ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /gov [текст]" ) ;
	if ( check_advertise ( playerid, params ) ) return 1 ;
	foreach(new i: logged_players)
	{
		new scm_string [ 144 ] ;
		format ( scm_string, sizeof scm_string, "[Гос.Новости] %s [%d]: %s",
		p_info [ playerid ] [ name ], playerid, params ) ;
		SendClientMessage ( i, 0x4466CCFF, scm_string ) ;
	}*/
	return 1 ;
}

