CMD:give_case ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 8 ) return 1 ;
	if ( ! IsFounder ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}К сожалению, Вам данная функция не доступна." ) ;
	if ( sscanf ( params, "dd", params [ 0 ], params [ 1 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /give_case [id] [case]");
	if ( ! IsPlayerConnected ( params [ 0 ] ) && params [ 0 ] != -1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( params [ 1 ] < 1 || params [ 1 ] > 2 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Не правильно указан номер кейса." ) ;

	new _case_id ;
	if ( params [ 1 ] == 1 ) _case_id = 3 ;
	else _case_id = 58 ;

	if ( params [ 0 ] == -1 )
	{
	    foreach(new i: logged_players)
	    {
		    if ( admin_info [ i ] [ admin ] ) continue ;

		    give_treasure ( i, _case_id, 1 ) ;
		}
		return 1 ;
	}

	give_treasure ( params [ 0 ], _case_id, 1 ) ;

    new query_string [ 19 + ( MAX_PLAYER_NAME * 2 ) ] ;
	format(query_string, sizeof query_string, "%s выдал кейс %s", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ] ) ;
	WriteLog(playerid, TYPE_LOG_ADMIN, query_string);
	return 1 ;
}

CMD:moneycashgo ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 8 ) return 1 ;
	if ( ! IsFounder ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}К сожалению, Вам данная функция не доступна." ) ;

	if ( sscanf ( params, "dd", params [ 0 ], params [ 1 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /moneycashgo [id] [сумма]");
	if ( ! IsPlayerConnected ( params [ 0 ] )  ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;

	new fmt_str [ 144 ] ;
	format(fmt_str, sizeof fmt_str, "* Администратор %s[%d] выдал Вам вирты на сумму %d"valute_title". Приятного время провождения на проекте!", p_info [ playerid ] [ name ], playerid, params [ 1 ] ) ;
	SendClientMessage ( params [ 0 ], col_succes, fmt_str ) ;

	format(fmt_str, sizeof fmt_str, "* Вы выдали игроку %s[%d] вирты на сумму %d"valute_title"", p_info [ params [ 0 ] ] [ name ], params [ 0 ], params [ 1 ] ) ;
	SendClientMessage ( playerid, col_succes, fmt_str ) ;

	new sql_string [ 128 ] ;
	format(sql_string, 128, "%s выдал вирты %s (%d"valute_title")", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], params [ 1 ] ) ;
	WriteLog(playerid, TYPE_LOG_ADMIN, sql_string);

	give_money ( params [ 0 ], params [ 1 ] ) ;
	insert_money_log ( params [ 0 ], playerid, params [ 1 ], "команда денег" ) ;
	return 1;
}

CMD:wlock ( playerid )
{
	if ( ! gang_player ( playerid ) && ! mafia_player ( playerid ) ) return 1 ;
	if ( p_info [ playerid ] [ rank ] <  f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 1 ] )
	{
	    static const _str [ ] = "{"#cRInfo"}* {"#cGRInfo"}Команда доступна с ранга %s (%d)." ;
	    new scm_string [ sizeof _str + 30 + 3 ] ;
	    format ( scm_string, sizeof scm_string, _str, f_rank [ p_info [ playerid ] [ member ] - 1 ] [ f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 1 ] - 1 ], f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 1 ] ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
		return 1 ;
	}

	new sql_string [ 92 ], fraction_id = p_info [ playerid ] [ member ] ;
	if ( f_info [ fraction_id - 1 ] [ f_dorm_status ] )
	{
		f_info [ fraction_id - 1 ] [ f_dorm_status ] = 0 ;
		format ( sql_string, sizeof ( sql_string ), "UPDATE `fractions` SET `f_dorm_status` = '%d' WHERE `f_id` = '%d' LIMIT 1",
		f_info [ fraction_id - 1 ] [ f_dorm_status ], fraction_id ) ;
		mysql_tquery ( sql_connection, sql_string ) ;
		GameTextForPlayer ( playerid,"~n~~n~~n~~n~~n~~n~~n~~n~~g~ DORM UNLOCKED", 3000, 3 ) ;
		SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Склад успешно {"#cGN"}открыт{"#cWH"}." ) ;

		format ( sql_string, sizeof sql_string, "[F] %s %s[%d] открыл(а) склад.", f_rank [ fraction_id - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], playerid ) ;
		fraction_message ( fraction_id, col_lblue, sql_string ) ;
	}
	else
	{
		f_info [ fraction_id - 1 ] [ f_dorm_status ] = 1 ;
		format ( sql_string, sizeof ( sql_string ), "UPDATE `fractions` SET `f_dorm_status` = '%d' WHERE `f_id` = '%d' LIMIT 1",
		f_info [ fraction_id - 1 ] [ f_dorm_status ], fraction_id ) ;
		mysql_tquery ( sql_connection, sql_string ) ;
		GameTextForPlayer ( playerid,"~n~~n~~n~~n~~n~~n~~n~~n~~r~ DORM LOCKED", 3000, 3 ) ;
		SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Склад успешно {"#cGN"}закрыт{"#cWH"}." ) ;

		format ( sql_string, sizeof sql_string, "[F] %s %s[%d] закрыл(а) склад.", f_rank [ fraction_id - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], playerid ) ;
		fraction_message ( fraction_id, col_lblue, sql_string ) ;
	}
	return 1 ;
}

callback: start_mp ( playerid )
{
	start_mp_time -- ;
	foreach(new i:streamed_players[playerid])
	{
		if ( ! find_mp_zone ( i ) ) continue ;
		if ( ! p_t_info [ i ] [ mp_team ] ) continue ;

		switch ( start_mp_time )
		{
	   		case 0:
			{
				GameTextForPlayer ( i, "~g~~h~START", 2000, 4);
				TogglePlayerControllable ( i, 1 ) ;

				KillTimer ( start_mp_timer ) ;
			}
			case 1..5:
			{
				new td_str [ 16 ] ;
				format ( td_str, 16, "~y~%i", start_mp_time ) ;
				GameTextForPlayer ( i, td_str, 1100, 4 ) ;
			}
		}
	}
	return 1 ;
}

