	GetPVarString ( playerid, pvar_string, pl_name, MAX_PLAYER_NAME ) ;

    global_string [ 0 ] = EOS ;
	new _h_id, _h_price, line_string [ 128 ] ;
	if ( rows )
	{
		for ( new i = 0 ; i < rows ; i ++ )
		{
		    _h_id = cache_get_field_content_int ( i, "h_id", sql_connection ) ;
		    _h_price = cache_get_field_content_int ( i, "h_price", sql_connection ) ;

			set_player_listitem_values ( playerid, i, _h_id ) ;

		    format ( line_string, sizeof line_string, "{"#cWH"}%s {"#cGRDialog"}(№%d){"#cWH"} - {"#cGN"}%d"valute_title_"{"#cWH"}\n", house_classes [ house_int [ h_info [ _h_id - 1 ] [ h_int ] - 1 ] [ hint_class ] ], _h_id, _h_price ) ;
			strcat ( global_string, line_string ) ;
		}
	}
	show_dialog ( playerid, d_debtor_houses_sell, DIALOG_STYLE_LIST, "{"#cBHD"}Изъятие дома", global_string, "Выбрать", "Назад" ) ;

	return 1 ;
}

