{
	if ( admin_info [ playerid ] [ admin ] < 8 ) return 1 ;
	if ( ! IsFounder ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}К сожалению, Вам данная функция не доступна." ) ;

	for ( new b = 0 ; b < house_count ; b ++ )
	{
	    new sql_string [ 83 + 9 ] ;
	    format ( sql_string, sizeof sql_string, "SELECT `u_ip_registration`, `u_last_ip` FROM `users` WHERE `u_id` = '%d' LIMIT 1", h_info [ b ] [ h_owner ] ) ;
	    mysql_tquery ( sql_connection, sql_string, "callback_finded_twink_house", "iiii", playerid, h_info [ b ] [ h_owner ], b, 1 ) ;
	}
