			else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас нет аспирина." ) ;
			return 1 ;
		}
	}
	else if ( params [ 0 ] == 5 )
	{
		new bool: _count = false ;
		for ( new i = 0 ; i < MAX_INVENTORY_SLOTS ; i ++ )
		{
		    if ( GetUsersInventory ( playerid, INV_ITEM, i ) != 149 ) continue ;

		    prise_open ( playerid, i ) ;
		    _count = true ;
		    break ;
		}

		if ( ! _count )
		{
		    if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "У вас нет морфия.", 0, 3, CINFO_INVENTORY_ID, PICTURE_INFO_ERROR, "", "" ) ;
			else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас нет морфия." ) ;
			return 1 ;
		}
	}
	else if ( params [ 0 ] == 6 )
	{
		new bool: _count = false ;
		for ( new i = 0 ; i < MAX_INVENTORY_SLOTS ; i ++ )
		{
		    if ( GetUsersInventory ( playerid, INV_ITEM, i ) != 150 ) continue ;

		    prise_open ( playerid, i ) ;
		    _count = true ;
		    break ;
		}

		if ( ! _count )
		{
		    if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "У вас нет адреналина.", 0, 3, CINFO_INVENTORY_ID, PICTURE_INFO_ERROR, "", "" ) ;
			else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас нет адреналина." ) ;
