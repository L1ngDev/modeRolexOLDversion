#define m_anticheat
//========================================================================================================================================

#define __anti_godmode

new player_legal_gun [ MAX_PLAYERS ] ;
new player_legal_damage [ MAX_PLAYERS ] ;
new player_killed [ MAX_PLAYERS ] ;
new player_killed_sync [ MAX_PLAYERS ] ;
new Float:player_death_pos [ MAX_PLAYERS ] [ 3 ] ;

stock ArmorDamage ( playerid, attackerid, weaponid, Float: ammount )
{
	#pragma unused attackerid
	#pragma unused weaponid

	if ( p_t_info [ playerid ] [ p_armour ] <= 0 )
	           return false ;

	if ( p_t_info [ playerid ] [ p_armour ] - ammount <= 0 )
	set_armour ( playerid, 0.0 ) ;
	else
	set_armour ( playerid, p_t_info [ playerid ] [ p_armour ] - ammount ) ;

	return true ;
}

stock HealthDamage ( playerid, attackerid, weaponid, Float: ammount )
{
	#if defined debug_mode
		printf ( "[HealthDamage] health: %f", p_t_info [ playerid ] [ p_health ] ) ;
	#endif
	if ( ( p_t_info [ playerid ] [ p_health ] - ammount ) <= 0 && ! player_killed [ playerid ] )
	{
		#if defined debug_mode
			printf ( "p_t_info [ playerid ] [ p_health ] - ammount <= 0" ) ;
		#endif
		GetPlayerPos ( playerid, player_death_pos [ playerid ] [ 0 ], player_death_pos [ playerid ] [ 1 ], player_death_pos [ playerid ] [ 2 ] ) ;

		set_health ( playerid, 0.0 ) ;
		OnPlayerSyncDeath ( playerid, attackerid, weaponid ) ;
		player_killed [ playerid ] = 1 ;
	}
	else
	{
		#if defined debug_mode
			printf ( "set_health" ) ;
		#endif

		set_health ( playerid, p_t_info [ playerid ] [ p_health ] - ammount ) ;
	}

    return true ;
}

stock GiveDamageForPlayer ( playerid, attackerid, weaponid, Float: ammount )
{
	#if defined debug_mode
		printf ( "GiveDamageForPlayer" ) ;
	#endif
	if ( p_t_info [ playerid ] [ p_armour ] >= 1 )
	{
		if ( p_t_info [ playerid ] [ p_armour ] - ammount <= 0 )
		{
  			set_armour ( playerid, 0.0 ) ;
			HealthDamage ( playerid, attackerid, weaponid, ammount - p_t_info [ playerid ] [ p_armour ] ) ;
		}
		else
			ArmorDamage ( playerid, attackerid, weaponid, ammount ) ;
	}
	else
		HealthDamage ( playerid, attackerid, weaponid, ammount ) ;

	return true ;
}

stock antigm_OnPlayerSpawn ( playerid )
{
    #if defined debug_mode
		printf ( "antigm_OnPlayerSpawn" ) ;
	#endif
	SetPlayerTeam ( playerid, 1 ) ;

	player_killed [ playerid ] =
	player_killed_sync [ playerid ] = 0 ;
	return 1 ;
}

stock antigm_OnPlayerDeath ( playerid, killerid, reason )
{
	#pragma unused killerid
	#pragma unused reason

	player_killed_sync [ playerid ] = 1 ;
	return 1 ;
}

stock antigm_OnPlayerWeaponShot ( playerid, weaponid, hittype, hitid, Float: fX, Float: fY, Float: fZ )
{
    #pragma unused fX
	#pragma unused fY
	#pragma unused fZ

	#if defined debug_mode
		printf ( "[DEBUG] [antigm_OnPlayerWeaponShot] playerid:%d | weaponid:%d | hittype:%d | hitid:%d", playerid, weaponid, hittype, hitid ) ;
	#endif

    if ( hittype == BULLET_HIT_TYPE_PLAYER )
	{
		if ( IsPlayerStreamedIn ( hitid, playerid ) && IsPlayerStreamedIn ( playerid, hitid ) )
		{
			if ( GetTickCount ( ) - p_t_info [ hitid ] [ p_update ] > 1000 ) return 0 ;

	  		if ( player_killed [ playerid ] ) return 0 ;

	  		if ( ! ProxDetectorS ( 150.0, playerid, hitid ) ) return 0 ;

	  		player_legal_gun [ playerid ] = weaponid ;
	  		player_legal_damage [ playerid ] = hitid ;

		}
	}
	else if ( hittype == BULLET_HIT_TYPE_VEHICLE )
	{
		foreach(new i: streamed_players[playerid]) // logged_players
		{
			if ( GetPlayerVehicleID ( i ) == hitid )
			{
				if ( IsPlayerStreamedIn ( i, playerid ) && IsPlayerStreamedIn ( playerid, i ) )
				{
					if ( player_killed [ playerid ] ) return 0 ;


					if ( !ProxDetectorS ( 150.0, playerid, i ) ) return 0 ;

					player_legal_gun [ playerid ] = weaponid ;
					player_legal_damage [ playerid ] = i ;

				}
			}
		}
	}
	return 1 ;
}

CMD:givehours ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 7 ) return 1 ;
	if ( sscanf ( params, "ud", params [ 0 ], params [ 1 ] ) ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}Используйте: /givehours [ id ] [ часы ]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}Игрок не найден." ) ;
	if ( params [ 1 ] < 1 ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}Количество часов не может быть менее 1." ) ;

	p_info [ params [ 0 ] ] [ hour_played ] += params [ 1 ] * 3600 ;
    return 1 ;
}

CMD:coord ( playerid )
{
    if ( admin_info [ playerid ] [ admin ] < 8 ) return 1 ;

    new Float:x, Float: y, Float: z, Float: a, string [ 190 ] ;

    GetPlayerFacingAngle ( playerid, a ) ;
    GetPlayerPos ( playerid, x, y, z ) ;

    format ( string, sizeof ( string), "{"#cBInfo"}* {"#cBInfo"}X: {"#cWH"}%f | {"#cBInfo"}Y: {"#cWH"}%f | {"#cBInfo"}Z: {"#cWH"}%f | {"#cBInfo"}A: {"#cWH"}%f", x , y , z, a ) ;
    SendClientMessage ( playerid , 0xFFFFFFFF, string ) ;
    return true ;
}

new bool: nop_gm_toggled = true ;
new nop_gm_count = 0 ;
CMD:ac_nopgm ( playerid )
{
	if ( admin_info [ playerid ] [ admin ] < 8 ) return 1 ;

	if ( nop_gm_toggled == false ) nop_gm_toggled = true ;
	else nop_gm_toggled = false ;

    new line_string [ 100 ] ;
	format ( line_string, sizeof line_string, "999: %d, toggled: %d", nop_gm_count, nop_gm_toggled ) ;
	SendClientMessage ( playerid, col_white, line_string ) ;
	return 1 ;
}

new playerChangeGun [ MAX_PLAYERS ] ;
new playerWeaponShotLast [ MAX_PLAYERS ] ;
new bool: blockingShotDamage [ MAX_PLAYERS ] ;
new bool: blockingAltDamage [ MAX_PLAYERS ] ;

stock antigm_OnPlayerGiveDamage ( playerid, damagedid, Float: amount, weaponid, bodypart )
{
	#pragma unused bodypart
 	#if defined debug_mode
		printf ( "[DEBUG] [antigm_OnPlayerGiveDamage] playerid:%d | damagedid:%d | amount:%f | weaponid:%d", playerid, damagedid, amount, weaponid ) ;
	#endif

	if ( damagedid == INVALID_PLAYER_ID ) return false ;

	if ( blockingShotDamage [ playerid ] == true || GetTickCount ( ) - playerChangeGun [ playerid ] < 250 )
	{
	   	GiveDamageForPlayer ( damagedid, playerid, weaponid, 0.0 ) ;
	    return 1 ;
	}

    blockingAltDamage [ playerid ] = false ;
 	if ( p_t_info [ playerid ] [ tr_team ] < 1 && p_t_info [ playerid ] [ tr_enter ] < 1 && TeamPaint [ playerid ] < 1 && boxing_opponent [ playerid ] == INVALID_PLAYER_ID && duel_opponent [ playerid ] == INVALID_PLAYER_ID )
  	{
  	    for ( new j = 0 ; j < MAX_DM_ZONE ; j ++ )
		{
			if ( ! IsPlayerInQuad ( playerid, anti_dm_pos [ j ] [ 0 ], anti_dm_pos [ j ] [ 1 ], anti_dm_pos [ j ] [ 2 ], anti_dm_pos [ j ] [ 3 ] ) &&
				! IsPlayerInQuad ( damagedid, anti_dm_pos [ j ] [ 0 ], anti_dm_pos [ j ] [ 1 ], anti_dm_pos [ j ] [ 2 ], anti_dm_pos [ j ] [ 3 ] ) ) continue ;

			anti_dm_warning { playerid } ++ ;
			show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Предупреждение","{FFFFFF}В этом месте запрещено драться/стрелять.\n\n{"#cRD"}* В случае повторных нарушений Вы можете быть кикнуты.", "Принять", "" ) ;
			if ( anti_dm_warning { playerid } >= 5 ) SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы были кикнуты за попытки {"#cRD"}DM{"#cGRInfo"} в общественном месте."), kick_player ( playerid ) ;
			ApplyAnimation ( playerid, "FAT", "IDLE_tired", 3.0, 1, 0, 0, 0, 3000, 1 ) ;
		    GiveDamageForPlayer ( damagedid, playerid, weaponid, 0.0 ) ;
			return 1 ;
		}

		if ( GetPlayerVirtualWorld ( playerid ) > 0 || GetPlayerVirtualWorld ( damagedid ) > 0 )
		{
			if ( GetPVarInt ( playerid, "p_biz_id" ) )
			{
				new bis_int = b_info [ GetPVarInt ( playerid, "p_biz_id" ) - 1 ] [ b_int ] ;
				if ( IsPlayerInRangeOfPoint ( playerid, 100.0, b_interior [ bis_int ] [ i_position ] [ 0 ], b_interior [ bis_int ] [ i_position ] [ 1 ], b_interior [ bis_int ] [ i_position ] [ 2 ] ) )
				{
					anti_dm_warning { playerid } ++ ;
					show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Предупреждение","{FFFFFF}В этом месте запрещено драться/стрелять.\n\n{"#cRD"}* В случае повторных нарушений Вы можете быть кикнуты.", "Принять", "" ) ;
					if ( anti_dm_warning { playerid } >= 5 ) SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы были кикнуты за попытки {"#cRD"}DM{"#cGRInfo"} в общественном месте."), kick_player ( playerid ) ;
					ApplyAnimation ( playerid, "FAT", "IDLE_tired", 3.0, 1, 0, 0, 0, 3000, 1 ) ;
		    		GiveDamageForPlayer ( damagedid, playerid, weaponid, 0.0 ) ;
					return 1 ;
				}
			}
			else if ( GetPVarInt ( damagedid, "p_biz_id" ) )
			{
				new bis_int = b_info [ GetPVarInt ( damagedid, "p_biz_id" ) - 1 ] [ b_int ] ;
				if ( IsPlayerInRangeOfPoint ( damagedid, 100.0, b_interior [ bis_int ] [ i_position ] [ 0 ], b_interior [ bis_int ] [ i_position ] [ 1 ], b_interior [ bis_int ] [ i_position ] [ 2 ] ) )
				{
				    if ( b_info [ GetPVarInt ( damagedid, "p_biz_id" ) - 1 ] [ b_type ] == bizz_type_casino ) reset_player_weapon ( playerid ) ;

					anti_dm_warning { playerid } ++ ;
					show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Предупреждение","{FFFFFF}В этом месте запрещено драться/стрелять.\n\n{"#cRD"}* В случае повторных нарушений Вы можете быть кикнуты.", "Принять", "" ) ;
					if ( anti_dm_warning { playerid } >= 5 ) SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы были кикнуты за попытки {"#cRD"}DM{"#cGRInfo"} в общественном месте."), kick_player ( playerid ) ;
					ApplyAnimation ( playerid, "FAT", "IDLE_tired", 3.0, 1, 0, 0, 0, 3000, 1 ) ;
		    		GiveDamageForPlayer ( damagedid, playerid, weaponid, 0.0 ) ;
					return 1 ;
				}
			}

			if ( GetPVarInt ( playerid, "house_id" ) )
			{
			    new _h_id = GetPVarInt ( playerid, "house_id" ) ;
			    if ( h_info [ _h_id - 1 ] [ h_zz_status ] && GetPlayerVirtualWorld ( playerid ) == _h_id )
			    {
			        anti_dm_warning { playerid } ++ ;
					show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Предупреждение","{FFFFFF}В этом месте запрещено драться/стрелять.\n\n{"#cRD"}* В случае повторных нарушений Вы можете быть кикнуты.", "Принять", "" ) ;
					if ( anti_dm_warning { playerid } >= 5 ) SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы были кикнуты за попытки {"#cRD"}DM{"#cGRInfo"} в общественном месте."), kick_player ( playerid ) ;
					ApplyAnimation ( playerid, "FAT", "IDLE_tired", 3.0, 1, 0, 0, 0, 3000, 1 ) ;
		    		GiveDamageForPlayer ( damagedid, playerid, weaponid, 0.0 ) ;
					return 1 ;
				}
			}
			else if ( GetPVarInt ( damagedid, "house_id" ) )
			{
			    new _h_id = GetPVarInt ( damagedid, "house_id" ) ;
			    if ( h_info [ _h_id - 1 ] [ h_zz_status ] && GetPlayerVirtualWorld ( damagedid ) == _h_id )
			    {
			        anti_dm_warning { playerid } ++ ;
					show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Предупреждение","{FFFFFF}В этом месте запрещено драться/стрелять.\n\n{"#cRD"}* В случае повторных нарушений Вы можете быть кикнуты.", "Принять", "" ) ;
					if ( anti_dm_warning { playerid } >= 5 ) SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы были кикнуты за попытки {"#cRD"}DM{"#cGRInfo"} в общественном месте."), kick_player ( playerid ) ;
					ApplyAnimation ( playerid, "FAT", "IDLE_tired", 3.0, 1, 0, 0, 0, 3000, 1 ) ;
		    		GiveDamageForPlayer ( damagedid, playerid, weaponid, 0.0 ) ;
					return 1 ;
				}
			}
		}

		if ( p_info [ playerid ] [ hour_played ] < THREE_HOUR_PLAYED )
		{
			SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не отыграли 3 часа в игре! Вы не можете наносить урон." ) ;
		   	GiveDamageForPlayer ( damagedid, playerid, weaponid, 0.0 ) ;
			return 1 ;
		}
		if ( p_info [ damagedid ] [ hour_played ] < THREE_HOUR_PLAYED )
		{
			SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не отыграл 3 часа в игре! Вы не можете наносить урон." ) ;
		   	GiveDamageForPlayer ( damagedid, playerid, weaponid, 0.0 ) ;
			return 1 ;
		}

		if ( entered_sell_zone [ playerid ] == true || entered_sell_zone [ damagedid ] == true )
		{
		    anti_dm_warning { playerid } ++ ;
			show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Предупреждение","{FFFFFF}В этом месте запрещено драться/стрелять.\n\n{"#cRD"}* В случае повторных нарушений Вы можете быть кикнуты.", "Принять", "" ) ;
			if ( anti_dm_warning { playerid } >= 5 ) SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы были кикнуты за попытки {"#cRD"}DM{"#cGRInfo"} в общественном месте."), kick_player ( playerid ) ;
			ApplyAnimation ( playerid, "FAT", "IDLE_tired", 3.0, 1, 0, 0, 0, 3000, 1 ) ;
		   	GiveDamageForPlayer ( damagedid, playerid, weaponid, 0.0 ) ;
			return 1 ;
		}

		if ( mw_gangzone != -1 )
		{
		    if ( IsPlayerInQuad ( playerid, mw_quad [ 0 ], mw_quad [ 1 ], mw_quad [ 2 ], mw_quad [ 3 ] ) )
			{
			    if ( p_info [ playerid ] [ warblock ] > 0 )
   				{
   				    SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас имеется запрет на участие в захватах." ) ;
		    		GiveDamageForPlayer ( damagedid, playerid, weaponid, 0.0 ) ;
   				    return 1 ;
   				}
   				if ( p_info [ damagedid ] [ warblock ] > 0 )
   				{
   				    SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока имеется запрет на участие в захватах." ) ;
		    		GiveDamageForPlayer ( damagedid, playerid, weaponid, 0.0 ) ;
   				    return 1 ;
   				}

   				if ( mafia_player ( playerid ) && mafia_player ( damagedid ) && ( p_info [ playerid ] [ member ] == p_info [ damagedid ] [ member ] ||
					f_diplomacy [ p_info [ playerid ] [ member ] - 18 ] [ p_info [ damagedid ] [ member ] - 18 ] == dip_status_alliance ) )
   				{
   				    GameTextForPlayer ( playerid, "~r~STOP THE FIRE~n~~r~ON YOUR ALLIES", 2000, 3 ) ;
		    		GiveDamageForPlayer ( damagedid, playerid, weaponid, 0.0 ) ;
   				    return 1 ;
   				}
			}

			p_info [ playerid ] [ bizwar_damage ] += amount ;
		}
		if ( gz_captured != -1 )
		{
		    if ( gz_spawn_zz )
		    {
		        if ( p_info [ playerid ] [ member ] != p_info [ damagedid ] [ member ] )
		        {
	      			for ( new i = 0 ; i < gz_count ; i ++ )
					{
						if ( IsPlayerInGangZone ( playerid, i ) )
						{
							if ( gz_info [ i ] [ gz_spawn ] == 1 )
							{
								anti_dm_warning { playerid } ++ ;
								show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Предупреждение","{FFFFFF}В этом месте запрещено драться/стрелять.\n\n{"#cRD"}* В случае повторных нарушений Вы можете быть кикнуты.", "Принять", "" ) ;
								if ( anti_dm_warning { playerid } >= 5 ) SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"} Вы были кикнуты за попытки {"#cRD"}DM{"#cGRInfo"} в общественном месте."), kick_player ( playerid ) ;
								ApplyAnimation ( playerid, "FAT", "IDLE_tired", 3.0, 1, 0, 0, 0, 3000, 1);
		    					GiveDamageForPlayer ( damagedid, playerid, weaponid, 0.0 ) ;
								return 1 ;
							}
						}
				    }
				}
			}

			if ( ( IsPlayerInGangZone ( playerid, gz_captured ) || ( IsPlayerInRangeOfQuad ( playerid, gz_info [ gz_captured ] [ gz_pos ] [ 2 ], gz_info [ gz_captured ] [ gz_pos ] [ 3 ] ) < 200 || IsPlayerInRangeOfQuad ( playerid, gz_info [ gz_captured ] [ gz_pos ] [ 0 ], gz_info [ gz_captured ] [ gz_pos ] [ 1 ] ) < 200 ) ) )
			{
			    if ( p_info [ playerid ] [ warblock ] > 0 )
   				{
   				    SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас имеется запрет на участие в захватах." ) ;
		    		GiveDamageForPlayer ( damagedid, playerid, weaponid, 0.0 ) ;
   				    return 1 ;
   				}
   				if ( p_info [ damagedid ] [ warblock ] > 0 )
   				{
   				    SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока имеется запрет на участие в захватах." ) ;
		    		GiveDamageForPlayer ( damagedid, playerid, weaponid, 0.0 ) ;
   				    return 1 ;
   				}

			    if ( gang_player ( playerid ) && gang_player ( damagedid ) && ( p_info [ playerid ] [ member ] == p_info [ damagedid ] [ member ] ||
					f_diplomacy [ p_info [ playerid ] [ member ] - 18 ] [ p_info [ damagedid ] [ member ] - 18 ] == dip_status_alliance ) )
   				{
   				    GameTextForPlayer ( playerid, "~r~STOP THE FIRE~n~~r~ON YOUR ALLIES", 2000, 3 ) ;
		    		GiveDamageForPlayer ( damagedid, playerid, weaponid, 0.0 ) ;
   				    return 1 ;
   				}
			}

			p_info [ playerid ] [ capture_damage ] += amount ;

			if ( p_info [ playerid ] [ capture_status ] > 1 )
			{
			    new _string [ 16 ] ;
				format ( _string, sizeof _string, "%.2f", p_info [ playerid ] [ capture_damage ] ) ;
				PlayerTextDrawSetString ( playerid, capture_ptd [ playerid ] [ 6 ], _string ) ;
			}
		}
		if ( p_t_info [ playerid ] [ tr_team ] != 0 && p_t_info [ damagedid ] [ tr_team ] != 0 )
		{
		    if ( p_t_info [ playerid ] [ tr_team ] == p_t_info [ damagedid ] [ tr_team ] )
		    {
    			GameTextForPlayer ( playerid,"~r~STOP THE FIRE~n~~r~ON YOUR ALLIES", 2000, 3 ) ;
		   		GiveDamageForPlayer ( damagedid, playerid, weaponid, 0.0 ) ;
			    return 1 ;
			}

			p_info [ playerid ] [ training_damage ] += amount ;

			if ( p_info [ playerid ] [ training_status ] > 1 )
			{
			    new _string [ 16 ] ;
				format ( _string, sizeof _string, "%.2f", p_info [ playerid ] [ training_damage ] ) ;
				PlayerTextDrawSetString ( playerid, training_ptd [ playerid ] [ 6 ], _string ) ;
			}
		}
		if ( TeamPaint [ playerid ] != 0 && TeamPaint [ damagedid ] != 0 )
		{
		    if ( TeamPaint [ playerid ] == TeamPaint [ damagedid ] )
		    {
    			GameTextForPlayer ( playerid, "~r~STOP THE FIRE~n~~r~ON YOUR ALLIES", 2000, 3 ) ;
		    	GiveDamageForPlayer ( damagedid, playerid, weaponid, 0.0 ) ;
			    return 1 ;
			}
		}
		if ( p_info [ playerid ] [ jailed ] > 0 )
		{
			anti_dm_warning { playerid } ++ ;
			show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Предупреждение","{FFFFFF}В этом месте запрещено драться/стрелять.\n\n{"#cRD"}* В случае повторных нарушений Вы можете быть кикнуты.", "Принять", "" ) ;
			if ( anti_dm_warning { playerid } >= 5 ) SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"} Вы были кикнуты за попытки {"#cRD"}DM{"#cGRInfo"} в общественном месте."), kick_player ( playerid ) ;
			ApplyAnimation(playerid,"FAT","IDLE_tired",3.0,1,0,0,0,3000,1);
			GiveDamageForPlayer ( damagedid, playerid, weaponid, 0.0 ) ;
			return 1 ;
		}
		if ( weaponid == 9 )
		{
			if ( IsPlayerInRangeOfPoint ( playerid, 500.0, tree_unload_position [ 0 ], tree_unload_position [ 1 ], tree_unload_position [ 2 ] ) && ! IsPlayerInRangeOfPoint ( playerid, 5, tree_positions [ tree_id [ playerid ] ] [ 0 ], tree_positions [ tree_id [ playerid ] ] [ 1 ], tree_positions [ tree_id [ playerid ] ] [ 2 ] ) )
			{
				anti_dm_warning { playerid } ++ ;
				show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Предупреждение","{FFFFFF}Запрещено использовать бензопилу не по назначению.\n\n{"#cRD"}* В случае повторных нарушений Вы можете быть кикнуты.", "Принять", "" ) ;
				if ( anti_dm_warning { playerid } >= 5 ) SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"} Вы были кикнуты за попытки {"#cRD"}DM{"#cGRInfo"} в общественном месте."), kick_player ( playerid ) ;
				GiveDamageForPlayer ( damagedid, playerid, weaponid, 0.0 ) ;
				return 1 ;
			}
		}

		if ( p_t_info [ damagedid ] [ p_damage_miss ] > 0 )
		{
		    if ( gettime ( ) - p_t_info [ damagedid ] [ p_stone ] [ 3 ] > 0 )
		    {
		        p_t_info [ damagedid ] [ p_damage_miss ] = 0 ;
		    }

		    if ( random ( 5 ) == 1 )
		    {
		        SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}У игрока сработал камень времени и урон не прошёл." ) ;
		        SendClientMessage ( damagedid, col_white, !"{"#cGInfo"}* {"#cWH"}У Вас сработал камень времени и урон не прошёл." ) ;
		        GiveDamageForPlayer ( damagedid, playerid, weaponid, 0.0 ) ;
		        return 1 ;
		    }
		}

	    if ( weaponid >= 0 && weaponid <= 8 )
	    {
		    /*if ( ! ProxDetectorS ( 1.3, playerid, damagedid ) )
			{
		   		GiveDamageForPlayer ( damagedid, playerid, weaponid, 0.0 ) ;
				return 1 ;
			}*/

			new Float: _weapon_damage, Float: _damage = p_info [ playerid ] [ stats ] [ 2 ] * 0.05 ;
			switch ( weaponid )
			{
			    case 0: _weapon_damage = 1.0 ;
			    case 1: _weapon_damage = 5.0 ;
			    case 2: _weapon_damage = 5.0 ;
			    case 3: _weapon_damage = 5.0 ;
			    case 4: _weapon_damage = 5.0 ;
			    case 5: _weapon_damage = 5.0 ;
			    case 6: _weapon_damage = 5.0 ;
			    case 7: _weapon_damage = 5.0 ;
			    case 8: _weapon_damage = 5.0 ;
			}

			if ( p_t_info [ playerid ] [ p_damage_up ] > 0 )
			{
			    if ( gettime ( ) - p_t_info [ playerid ] [ p_stone ] [ 4 ] > 0 )
			    {
			        p_t_info [ playerid ] [ p_damage_up ] = 0 ;
			    }

			    _weapon_damage += 5.0 ;
			}

			if ( _damage < 1.0 ) _damage = 1.0 ;
			else if ( _damage > 10.0 ) _damage = 10.0 ;
			GiveDamageForPlayer ( damagedid, playerid, weaponid, _weapon_damage + _damage ) ;
			blockingAltDamage [ playerid ] = true ;

			if ( p_info [ playerid ] [ u_style ] [ 0 ] > 800 )
			{
			    if ( random ( 11 ) == 5 )
			    {
					ApplyAnimation ( damagedid, "CRACK", "crckdeth2", 4.0, 1, 0, 0, 0, 0 ) ;
					SetTimerEx ( "cnock_timer", 5000, false, "i", damagedid ) ;
			 		TogglePlayerControllable ( damagedid, 0 ) ;

					new _text_string [ 128 ] ;
					format ( _text_string, sizeof ( _text_string ), "{"#cBInfo"}* {"#cWH"}Вы оглушили гражданина {"#cBL"}%s{"#cWH"} на 5 секунд.", p_info [ damagedid ] [ name ] ) ;
					SendClientMessage ( playerid, col_white, _text_string ) ;

					format ( _text_string, sizeof ( _text_string ), "{"#cBInfo"}* {"#cWH"}Вы были оглушены {"#cBL"}%s{"#cWH"} на 5 секунд.", p_info [ playerid ] [ name ] ) ;
					SendClientMessage ( damagedid, col_white, _text_string ) ;
				}
			}
		}
		/*else
		{
			if ( GetPlayerDistanceFromPoint ( playerid, p_t_info [ damagedid ] [ p_pos ] [ 0 ],
														p_t_info [ damagedid ] [ p_pos ] [ 1 ],
														p_t_info [ damagedid ] [ p_pos ] [ 2 ] ) < 2 )
			{
		   		GiveDamageForPlayer ( damagedid, playerid, weaponid, 0.0 ) ;
				return 1 ;
			}
		}*/

		p_t_info [ damagedid ] [ last_gun_damage ] = weaponid ;
		p_t_info [ damagedid ] [ last_time_damage ] = gettime ( ) + 3 ;
		p_t_info [ damagedid ] [ last_time_damage_spawn ] = gettime ( ) + 15 ;
		p_t_info [ playerid ] [ last_time_give_damage ] = gettime ( ) ;

    	p_t_info [ playerid ] [ p_gun_accuracy ] ++ ;

		new Float: weapon_amount = amount ;
		switch ( weaponid )
		{
			case 22: weapon_amount = 4.0 ; // Colt
			case 23: weapon_amount = 14.0 ; // SD Pistol
			case 24:
			{
			    if ( p_info [ playerid ] [ gun_skills ] [ 1 ] < 20 )
			    	weapon_amount = 24.0 ; // Deagle

				else
					weapon_amount = 47.0 ; // Deagle
			}
			case 25:
			{
			    if ( amount <= 0.0 || amount > 30.0 ) amount = 30.0 ;
				weapon_amount = amount ; // Shotgun
			}
			case 28: weapon_amount = 6.0 ;  // Micro-Uzi
			case 29: weapon_amount = 8.0 ;  // MP5
			case 30: weapon_amount = 10.0 ; // AK-47
			case 31: weapon_amount = 10.0 ; // M4A1
			case 33: weapon_amount = 25.0 ; // Rifle
			case 34: weapon_amount = 41.0 ; // Sniper
			case 38: weapon_amount = 47.0 ; // Minigun
		}

		if ( p_t_info [ playerid ] [ p_damage_up ] > 0 )
		{
		    if ( gettime ( ) - p_t_info [ playerid ] [ p_stone ] [ 4 ] > 0 )
		    {
		        p_t_info [ playerid ] [ p_damage_up ] = 0 ;
		    }

		    weapon_amount += 5.0 ;
		}

	    if ( p_info [ playerid ] [ kolokol ] == 1 ) PlayerPlaySound ( playerid, 6401, 0.0, 0.0, 0.0 ) ;

		if ( p_info [ playerid ] [ damage_info ] == 1 && amount < 100 ) create_gd_td ( damagedid, playerid, weapon_amount, weaponid ) ;
		if ( p_info [ damagedid ] [ damage_info ] == 1 && amount < 100 ) create_td_td ( damagedid, playerid, weapon_amount, weaponid ) ;

		if ( TeamPaint [ playerid ] > 0 && TeamPaint [ damagedid ] > 0 ) PaintList [ GetPVarInt ( playerid, "OnPaint" ) ] [ DamagePoint ] += floatround ( amount ) ;

		familys_OnPlayerGiveDamage ( playerid, damagedid, weaponid, Float:amount ) ;
	}

    if ( ( ( 22 <= weaponid <= 34 ) || weaponid == 38 ) )
	{
		#if defined debug_mode
			printf ( "22 <= weaponid <= 34) || weaponid == 38" ) ;
		#endif

	    if ( IsPlayerStreamedIn ( damagedid, playerid ) && IsPlayerStreamedIn ( playerid, damagedid ) )
		{
			if ( pl_afk_time [ playerid ] > 2 || pl_afk_time [ damagedid ] > 2 )
			{
				GiveDamageForPlayer ( damagedid, playerid, weaponid, 0.0 ) ;
				return 1 ;
			}
	  		if ( player_killed [ damagedid ] )
			{
				anti_cheat ( damagedid, "nop gm", 0 ) ;
				if ( GetPlayerDistanceFromPoint ( damagedid, player_death_pos [ damagedid ] [ 0 ],
															player_death_pos [ damagedid ] [ 1 ],
															player_death_pos [ damagedid ] [ 2 ] ) > 5 )
				{
				    nop_gm_count ++ ;

				    if ( nop_gm_toggled == true ) anti_cheat ( damagedid, "nop gm", 999 ) ;
				}
			}
	  		if ( player_killed [ playerid ] ) return 0 ;

	  		if ( ! ProxDetectorS ( 150.0, playerid, damagedid ) )
			{
		   		GiveDamageForPlayer ( damagedid, playerid, weaponid, 0.0 ) ;
				return 1 ;
			}

			if ( player_device { playerid } == 2 )
			{
			    switch ( weaponid )
				{
					case 22: GiveDamageForPlayer(damagedid, playerid, weaponid, 4.0 ) ; // Colt
					case 23: GiveDamageForPlayer(damagedid, playerid, weaponid, 14.0 ) ; // SD Pistol
					case 24:
					{
					    if ( p_info [ playerid ] [ gun_skills ] [ 1 ] < 20)
					    {
					        GiveDamageForPlayer(damagedid, playerid, weaponid, 24.0 ) ; // Deagle
						}
						else
						{
							GiveDamageForPlayer(damagedid, playerid, weaponid, 47.0 ) ; // Deagle
						}
					}
					case 25:
					{
					    if ( amount <= 0.0 || amount > 30.0) amount = 30.0;
						GiveDamageForPlayer(damagedid, playerid, weaponid, amount ) ; // Shotgun
					}
					case 28: GiveDamageForPlayer(damagedid, playerid, weaponid, 6.0 ) ;  // Micro-Uzi
					case 29: GiveDamageForPlayer(damagedid, playerid, weaponid, 8.0 ) ;  // MP5
					case 30: GiveDamageForPlayer(damagedid, playerid, weaponid, 10.0 ) ; // AK-47
					case 31: GiveDamageForPlayer(damagedid, playerid, weaponid, 10.0 ) ; // M4A1
					case 33: GiveDamageForPlayer(damagedid, playerid, weaponid, 25.0 ) ; // Rifle
					case 34: GiveDamageForPlayer(damagedid, playerid, weaponid, 41.0 ) ; // Sniper
					case 38: GiveDamageForPlayer(damagedid, playerid, weaponid, 47.0 ) ; // Minigun
					default: return 1 ;
				}
				player_legal_gun [ playerid ] = 0 ;
    			player_legal_damage [ playerid ] = INVALID_PLAYER_ID ;
			}
			else if ( player_legal_gun [ playerid ] == weaponid && player_legal_damage [ playerid ] == damagedid )
			{
			    switch ( weaponid )
				{
					case 22: GiveDamageForPlayer(damagedid, playerid, weaponid, 4.0 ) ; // Colt
					case 23: GiveDamageForPlayer(damagedid, playerid, weaponid, 14.0 ) ; // SD Pistol
					case 24:
					{
					    if ( p_info [ playerid ] [ gun_skills ] [ 1 ] < 20)
					    {
					        GiveDamageForPlayer(damagedid, playerid, weaponid, 24.0 ) ; // Deagle
						}
						else
						{
							GiveDamageForPlayer(damagedid, playerid, weaponid, 47.0 ) ; // Deagle
						}
					}
					case 25:
					{
					    if ( amount <= 0.0 || amount > 30.0) amount = 30.0;
						GiveDamageForPlayer(damagedid, playerid, weaponid, amount ) ; // Shotgun
					}
					case 28: GiveDamageForPlayer(damagedid, playerid, weaponid, 6.0 ) ;  // Micro-Uzi
					case 29: GiveDamageForPlayer(damagedid, playerid, weaponid, 8.0 ) ;  // MP5
					case 30: GiveDamageForPlayer(damagedid, playerid, weaponid, 10.0 ) ; // AK-47
					case 31: GiveDamageForPlayer(damagedid, playerid, weaponid, 10.0 ) ; // M4A1
					case 33: GiveDamageForPlayer(damagedid, playerid, weaponid, 25.0 ) ; // Rifle
					case 34: GiveDamageForPlayer(damagedid, playerid, weaponid, 41.0 ) ; // Sniper
					case 38: GiveDamageForPlayer(damagedid, playerid, weaponid, 47.0 ) ; // Minigun
					default: return 1 ;
				}
				player_legal_gun [ playerid ] = 0 ;
    			player_legal_damage [ playerid ] = INVALID_PLAYER_ID ;
			}
		}
		else
		{
		    GiveDamageForPlayer ( damagedid, playerid, weaponid, 0.0 ) ;
		}
		return 1 ;
	}
	else
	{
	    if ( player_killed [ playerid ] ) return 0 ;

	    if ( amount <= 0.0 || amount > 7.0 )
		{
	 		GiveDamageForPlayer ( damagedid, playerid, weaponid, 0.0 ) ;
			return 1 ;
		}

	    if ( blockingAltDamage [ playerid ] == false && ! ProxDetectorS ( 5.0, playerid, damagedid ) )
		{
	   		GiveDamageForPlayer ( damagedid, playerid, weaponid, 0.0 ) ;
			return 1 ;
		}

		#if defined IsAntiFist
  		if ( IsAntiFist ( playerid ) ) return 1 ;
  		#endif

		GiveDamageForPlayer ( damagedid, playerid, weaponid, amount ) ;
	}
	return 1 ;
}

stock antigm_OnPlayerTakeDamage(playerid, issuerid, Float: amount, weaponid, bodypart)
{
    #pragma unused bodypart

    if ( weaponid == 49 || weaponid == 50)
	{
	    if ( amount <= 0.0) return 1;

	    if ( IsPlayerStreamedIn(issuerid, playerid ) )
	    {
	    	if ( IsPlayerInAnyVehicle(issuerid ) )
			{
			    GiveDamageForPlayer(playerid, issuerid, weaponid, amount ) ;
			}
		}
	}
	return 1 ;
}

stock antigm_OnPlayerConnect ( playerid )
{
    player_legal_damage [ playerid ] = INVALID_PLAYER_ID ;

    player_legal_gun [ playerid ] =
	player_killed [ playerid ] =
	player_killed_sync [ playerid ] = 0 ;
	return 1 ;
}

stock _CreateActor ( modelid, Float: x, Float: y, Float: z, Float: r )
{
	new actorid = CreateActor ( modelid, x, y, z, r ) ;

    GetActorInfo ( actorid, ACTOR_VEHICLE_ID ) = INVALID_VEHICLE_ID ;

    GetActorInfo ( actorid, ACTOR_ATTACK_ID ) =
    GetActorInfo ( actorid, ACTOR_NUM_ID ) = INVALID_PLAYER_ID ;

	GetActorInfo ( actorid, ACTOR_HEALTH_BAR ) = false ;
	return actorid ;
}
#define CreateActor _CreateActor

stock _DestroyActor ( actorid )
{
    actor_info [ actorid ] [ ACTOR_VEHICLE_ID ] = INVALID_VEHICLE_ID ;
	actor_info [ actorid ] [ ACTOR_HEALTH_BAR ] = false ;
	return DestroyActor ( actorid ) ;
}
#define DestroyActor _DestroyActor

stock _CreateDynamicActor ( modelid, Float: x, Float: y, Float: z, Float: r, invulnerable = true, Float: health = 100.0, worldid = -1, interiorid = -1, playerid = -1, Float: streamdistance = STREAMER_ACTOR_SD, STREAMER_TAG_AREA: areaid = STREAMER_TAG_AREA: -1, priority = 0 )
{
	new actorid = CreateDynamicActor ( modelid, x, y, z, r, invulnerable, health, worldid, interiorid, playerid, streamdistance, areaid, priority ) ;
    return actorid ;
}
#define CreateDynamicActor _CreateDynamicActor

stock _CreateDynamicObject ( model_id, Float:x_object, Float:y_object, Float:z_object, Float:rx_object, Float:ry_object, Float:rz_object, world_id = -1, interior_id = -1, player_id = -1, Float:streamdistance_object = 200.0, Float:drawdistance_object = 200.0 )
{
	new objectid = CreateDynamicObject ( model_id, x_object, y_object, z_object, rx_object, ry_object, rz_object, world_id, interior_id, player_id, streamdistance_object, drawdistance_object ) ;
    return objectid ;
}
#define CreateDynamicObject _CreateDynamicObject

new TotalMapIcon = 0 ;
stock _CreateDynamicMapIcon ( Float:x, Float:y, Float:z, type, color, worldid = -1, interiorid = -1, playerid = -1, Float:streamdistance = stream_distance_mapicon )
{
	if ( streamdistance > 500 ) streamdistance = 99999.9 ;
	new mapiconid = CreateDynamicMapIcon ( x, y, z, type, color, worldid, interiorid, playerid, streamdistance ) ;

	TotalMapIcon ++ ;
	return mapiconid ;
}
#define CreateDynamicMapIcon _CreateDynamicMapIcon

new TotalPickup = 0 ;
stock _CreateDynamicPickup ( modelid, type, Float:x, Float:y, Float:z, worldid = -1, interiorid = -1, playerid = -1, Float:streamdistance = stream_distance_pickup )
{
	new pickupid = CreateDynamicPickup ( modelid, type, x, y, z, worldid, interiorid, playerid, streamdistance ) ;

	pick_info [ pickupid ] [ pick_pos ] [ 0 ] = x ;
	pick_info [ pickupid ] [ pick_pos ] [ 1 ] = y ;
	pick_info [ pickupid ] [ pick_pos ] [ 2 ] = z ;

	TotalPickup ++ ;

	return pickupid ;
}
#define CreateDynamicPickup _CreateDynamicPickup

stock GetVehicleSpeed ( vehicleid )
{
    new Float:X, Float:Y, Float:Z, Float:_speed ;
    GetVehicleVelocity ( vehicleid, X, Y, Z ) ;
    _speed = ( ( floatsqroot ( ( X * X ) + ( Y * Y ) ) * 10 ) / 1.65 ) * 30 ;
    return floatround ( _speed, floatround_round ) ;
}

stock GetVehicleSpeed_ ( vehicleid )
{
    new Float:Px, Float:Py, Float:Pz ;
    GetVehicleVelocity ( vehicleid,Px,Py,Pz ) ;
    return floatround ( floatsqroot ( Px * Px + Py * Py + Pz * Pz ) * 100.0 ) ;
}

stock get_b_price_market ( shop_id, bizz_id )
{
	new _bz_price = b_price_market [ bizz_id ] [ shop_id ], _b_type = b_info [ bizz_id ] [ b_type ] ;
	foreach(new _b_id: business_types[_b_type])
	{
	    if ( b_price_market [ _b_id - 1 ] [ shop_id ] >= _bz_price ) continue ;

	    _bz_price = b_price_market [ _b_id - 1 ] [ shop_id ] ;
	}
	return _bz_price ;
}

stock get_player_admin_level ( u_a_name [ ] )
{
	new _adm_level = 0, _adm_count = 0 ;

	static const _str [ ] = "SELECT `u_a_level` FROM `users_admins` WHERE `u_a_name` = '%s' LIMIT 1" ;
	new query_string [ sizeof _str + 24 ] ;
	format ( query_string, sizeof ( query_string ), _str, u_a_name ) ;
	new Cache: result = mysql_query ( sql_connection, query_string ) ;
	_adm_count = cache_num_rows ( ) ;
	if ( _adm_count ) _adm_level = cache_get_field_content_int ( 0, "u_a_level", sql_connection ) ;
	cache_delete ( result ) ;
	return _adm_level ;
}

stock get_player_veh_count ( playerid )
{
	new _veh_count = 0 ;
	if ( p_info [ playerid ] [ p_veh_count ] > 0 ) _veh_count = p_info [ playerid ] [ p_veh_count ] ;
	else
	{
		static const _str [ ] = "SELECT `v_owner` FROM `users_vehicles` WHERE `v_owner` = '%d' LIMIT %d" ;
		new query_string [ sizeof _str + 11 + 4 ] ;
		format ( query_string, sizeof ( query_string ), _str, p_info [ playerid ] [ id ], p_info [ playerid ] [ max_veh ] ) ;
		new Cache: result = mysql_query ( sql_connection, query_string ) ;
		_veh_count = cache_num_rows ( ) ;
		p_info [ playerid ] [ p_veh_count ] = _veh_count ;
		cache_delete ( result ) ;
	}
	return _veh_count ;
}

new debt_business_count [ MAX_PLAYERS ],
	debt_house_count [ MAX_PLAYERS ] ;

callback: get_player_house_sellstatus ( playerid, _type )
{
    new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows )
	{
	    if ( _type == 1 )
	    {
	        SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока нет дома." ) ;

		    DeletePVar ( playerid, "debt_uid" ) ;
			DeletePVar( playerid, "ofm_listitem" ) ;
			getDebtorsInfo ( playerid, page_count [ playerid ], 1 ) ;
			return 1 ;
	    }

	    static const _str [ ] = "SELECT `b_id` FROM `businesses` WHERE `b_owner_inc` = '%d' LIMIT %d" ;
	    new query_string [ sizeof _str + 9 + 4 ] ;
		format ( query_string, sizeof ( query_string ), _str, GetPVarInt ( playerid, "debt_uid" ), max_biz_gold ) ;
		mysql_tquery ( sql_connection, query_string, "get_player_business_sellstatus", "ii", playerid, _type ) ;
		return 1 ;
	}
	if ( rows )
	{
	    new _h_id ;
	    for ( new i = 0 ; i < rows ; i ++ )
	    {
	        _h_id = cache_get_field_content_int ( i, "h_id", sql_connection ) ;

	        if ( h_info [ _h_id - 1 ] [ h_sell_status ] )
	        {
	            SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Имущество игрока уже подгатавливается к опечатке." ) ;

                DeletePVar ( playerid, "debt_uid" ) ;
				DeletePVar( playerid, "ofm_listitem" ) ;
				getDebtorsInfo ( playerid, page_count [ playerid ], 1 ) ;
				return 1 ;
			}
	    }
	}

	static const _str [ ] = "SELECT `b_id` FROM `businesses` WHERE `b_owner_inc` = '%d' LIMIT %d" ;
	new query_string [ sizeof _str + 9 + 4 ] ;
	format ( query_string, sizeof ( query_string ), _str, GetPVarInt ( playerid, "debt_uid" ), max_biz_gold ) ;
	mysql_tquery ( sql_connection, query_string, "get_player_business_sellstatus", "ii", playerid, _type ) ;
	return 1 ;
}

callback: get_player_business_sellstatus ( playerid, _type )
{
    new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows )
	{
		if ( _type == 2 )
		{
		    SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока нет бизнеса." ) ;

		    DeletePVar ( playerid, "debt_uid" ) ;
			DeletePVar( playerid, "ofm_listitem" ) ;
			getDebtorsInfo ( playerid, page_count [ playerid ], 1 ) ;
			return 1 ;
		}
	}
	if ( rows )
	{
	    new _b_id ;
	    for ( new i = 0 ; i < rows ; i ++ )
	    {
	        _b_id = cache_get_field_content_int ( i, "b_id", sql_connection ) ;

	        if ( b_info [ _b_id - 1 ] [ b_sell_status ] )
	        {
	            SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Имущество игрока уже подгатавливается к опечатке." ) ;

                DeletePVar ( playerid, "debt_uid" ) ;
				DeletePVar( playerid, "ofm_listitem" ) ;
				getDebtorsInfo ( playerid, page_count [ playerid ], 1 ) ;
				return 1 ;
			}
	    }
	}

	if ( _type == 1 )
	{
	    static const _str [ ] = "SELECT `h_id`,`h_price` FROM `houses` WHERE `h_owner` = '%d' LIMIT %d" ;
	    new query_string [ sizeof _str + 9 + 4 ] ;
		format ( query_string, sizeof query_string, _str, GetPVarInt ( playerid, "debt_uid" ), max_h_gold ) ;
		mysql_tquery ( sql_connection, query_string, "callback_debtor_houses", "i", playerid ) ;
	}
	else if ( _type == 2 )
	{
	    static const _str [ ] = "SELECT `b_id`,`b_name`,`b_price` FROM `businesses` WHERE `b_owner_inc` = '%d' LIMIT %d" ;
	    new query_string [ sizeof _str + 9 + 4 ] ;
		format ( query_string, sizeof query_string, _str, GetPVarInt ( playerid, "debt_uid" ), max_biz_gold ) ;
		mysql_tquery ( sql_connection, query_string, "callback_debtor_businesses", "i", playerid ) ;
	}
	return 1 ;
}

