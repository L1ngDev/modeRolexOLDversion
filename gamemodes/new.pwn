			insert_money_log ( playerid, INVALID_PLAYER_ID, money_count * convertion_price, "Донат валюта" ) ;
			show_donate ( playerid ) ;

			SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Донат услуга успешно приобретена." ) ;
			return 1 ;
		}
		case d_donate_talon:
