				mysql_tquery ( sql_connection, _sql_string ) ;

				new fraction_id = p_info [ playerid ] [ member ] ;
				format ( _sql_string, sizeof _sql_string, "[R] '%s' %s %s подготовил(а) имущество для опечатки.", f_info [ fraction_id - 1 ] [ f_name ], f_rank [ fraction_id - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ] ) ;
				fraction_message ( 1, col_lblue, _sql_string ) ;
				fraction_message ( 2, col_lblue, _sql_string ) ;
				fraction_message ( 3, col_lblue, _sql_string ) ;
				fraction_message ( 11, col_lblue, _sql_string ) ;

				DeletePVar ( playerid, "debt_house" ) ;
				DeletePVar ( playerid, "debt_business" ) ;
				DeletePVar ( playerid, "debt_garage" ) ;
				DeletePVar ( playerid, "debt_tax" ) ;
				DeletePVar ( playerid, "debt_uid" ) ;
				DeletePVar ( playerid, "ofm_listitem" ) ;
				getDebtorsInfo ( playerid, page_count [ playerid ], 1 ) ;
			}
