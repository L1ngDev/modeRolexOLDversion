callback: del_elections_list ( playerid, inputtext [ ] )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( rows )
	{
		new _t_string [ 108 ] ;
		format ( _t_string, 98, "DELETE FROM `elections` WHERE `e_name` = '%s' LIMIT 1", inputtext ) ;
		mysql_tquery ( sql_connection, _t_string ) ;

		format ( _t_string, 108, "{"#cBAdmin"}[A] {"#cGRAdmin"}%s удалил кандидата %s из списка.", p_info [ playerid ] [ name ], inputtext ) ;
		foreach(new i: admin_players)SendClientMessage ( i, col_admin, _t_string ) ;

		callcmd::election ( playerid ) ;
		return 1 ;
	}
	SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данный игрок не найден в списке кандидатов." ) ;
	callcmd::election ( playerid ) ;
	return 1 ;
}

callback: vote_elections_list ( playerid, inputtext [ ] )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( rows )
	{
	    new _t_string [ 128 ] ;

	    new _candidate_votes = cache_get_field_content_int ( 0, "u_vote_status", sql_connection ) ;
	    if ( _candidate_votes == 1 )
		{
			_candidate_votes = 0 ;

			format ( _t_string, sizeof _t_string, "{"#cBAdmin"}[A] {"#cGRAdmin"}%s забрал у %s возмжность выдвижения кандидатуры.", p_info [ playerid ] [ name ], inputtext ) ;
			foreach(new i: admin_players)SendClientMessage ( i, col_admin, _t_string ) ;
		}
	    else
		{
			_candidate_votes = 1 ;

			format ( _t_string, sizeof _t_string, "{"#cBAdmin"}[A] {"#cGRAdmin"}%s выдал %s возмжность выдвижения кандидатуры.", p_info [ playerid ] [ name ], inputtext ) ;
			foreach(new i: admin_players)SendClientMessage ( i, col_admin, _t_string ) ;
		}

		format ( _t_string, sizeof _t_string, "UPDATE `users` WHERE `u_name` = '%s' SET `u_vote_status` = '%d' LIMIT 1", inputtext, _candidate_votes ) ;
		mysql_tquery ( sql_connection, _t_string ) ;

		new pl_id ;
		sscanf ( inputtext, "u", pl_id ) ;
		if ( IsPlayerConnected ( pl_id ) )
		{
		    if ( _candidate_votes == 1 ) p_info [ pl_id ] [ vote_status ] = 0 ;
		    else p_info [ pl_id ] [ vote_status ] = 1 ;
		}

		callcmd::election ( playerid ) ;
		return 1 ;
	}
	SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данный игрок не найден в базе данных." ) ;
	callcmd::election ( playerid ) ;
	return 1 ;
}

callback: elections_insert ( playerid )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( rows >= 15 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Лимит кандидатов уже набран.") ;
	give_money ( playerid, -250000 ) ;
	insert_money_log ( playerid, INVALID_PLAYER_ID, -250000, "регистрация кандидата" ) ;

	new sql_string [ 76 ] ;
	format ( sql_string, sizeof ( sql_string ), "INSERT INTO `elections` (e_name) VALUES ('%s')", p_info [ playerid ] [ name ] ) ;
	mysql_tquery ( sql_connection, sql_string ) ;

	SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы успешно зарегистрировали свою кандидатуру на выборы." ) ;
	return 1 ;
}

