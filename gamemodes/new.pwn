		    SendClientMessage ( _target_cuff, col_gray, !"{"#cGInfo"}* {"#cGRInfo"}Игрок, которого Вы связали, вышел из игры." ) ;
		}
	}

    if ( p_t_info [ playerid ] [ cop_break ] != INVALID_OBJECT_ID )
	{
