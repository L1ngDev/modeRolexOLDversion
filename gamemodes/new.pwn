    		format ( query_string, sizeof query_string, "UPDATE `rent_vehicles` SET `sv_model` = '%d' WHERE `sv_id` = '%d' LIMIT 1",
      		model_business [ m_param ] [ listitem ], veh_info [ new_veh_id - 1 ] [ v_id ] ) ;
   			mysql_tquery ( sql_connection, query_string ) ;

			b_info [ bizz_id - 1 ] [ b_money ] -= GetModelPrice ( model_business [ m_param ] [ listitem ] ) * for_tax [ 2 ] ;

			new _sql_string [ 71 + 9 + 9 ] ;
			format ( _sql_string, sizeof _sql_string, "UPDATE `businesses` SET `b_money` = '%d' WHERE `b_id` = '%d' LIMIT 1",
			b_info [ bizz_id - 1 ] [ b_money ], b_info [ bizz_id - 1 ] [ b_id ] ) ;
			mysql_tquery ( sql_connection, _sql_string ) ;

			show_bpanel ( playerid ) ;
   			SendClientMessage ( playerid, col_white, !"{"#cBInfo"}* {"#cWH"}Модель автомобиля изменена." ) ;
   			return 1 ;
		}
		case d_b_improvement:
		{
			if ( ! response )
			{
				show_bpanel ( playerid ) ;
				return 1 ;
			}

			new business_id ;
			if ( p_info [ playerid ] [ b_worker ] != -1 ) business_id = p_info [ playerid ] [ b_worker ] ;
			else business_id = p_info [ playerid ] [ business ] ;

			if ( b_info [ business_id - 1 ] [ b_improve ] [ listitem ] )
			{
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас уже установлено это улучшение." ) ;
				show_b_improvment ( playerid, b_info [ business_id - 1 ] [ b_type ], business_id ) ;
				return 1 ;
			}
			new mes [ 156 ] ;
			if ( b_info [ business_id - 1 ] [ b_type ] == bizz_type_gas ) format ( mes, sizeof ( mes ), "{"#cWH"}Вы хотите купить улучшение: {"#cBL"}\"%s\"?\n\n{"#cWH"}Оно обойдется Вам в {"#cGN"}%d"valute_title".", b_improve_fuel_name [ listitem ], b_improve_price [ listitem ] ) ;
			else if ( b_info [ business_id - 1 ] [ b_type ] == bizz_type_gas ) format ( mes, sizeof ( mes ), "{"#cWH"}Вы хотите купить улучшение: {"#cBL"}\"%s\"?\n\n{"#cWH"}Оно обойдется Вам в {"#cGN"}%d"valute_title".", b_improve_truck_name [ listitem ], b_improve_price [ listitem ] ) ;
			else format ( mes, sizeof ( mes ), "{"#cWH"}Вы хотите купить улучшение: {"#cBL"}\"%s\"?\n\n{"#cWH"}Оно обойдется Вам в {"#cGN"}%d"valute_title".", b_improve_name [ listitem ], b_improve_price [ listitem ] ) ;
			show_dialog ( playerid, d_b_improvement_accept, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Улучшения бизнеса", mes, "Купить", "Отмена" ) ;
			set_player_use_listitem ( playerid, listitem ) ;
			return 1 ;
		}
		case d_b_improvement_accept:
		{
			new improveid = get_player_use_listitem ( playerid ), business_id, price = b_improve_price [ improveid ] ;
			if ( p_info [ playerid ] [ b_worker ] != -1 ) business_id = p_info [ playerid ] [ b_worker ] - 1 ;
			else business_id = p_info [ playerid ] [ business ] - 1 ;

			if ( ! response )
			{
				show_b_improvment ( playerid, b_info [ business_id ] [ b_type ], business_id + 1 ) ;
				return 1 ;
			}

			if ( p_info [ playerid ] [ money ] < price )
			{
				show_b_improvment ( playerid, b_info [ business_id ] [ b_type ], business_id + 1 ) ;
				return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас недостаточно денег." ) ;
			}

			b_info [ business_id ] [ b_improve ] [ improveid ] = 1 ;

			if ( improveid == 1 )
			{
			    if ( b_info [ business_id ] [ b_type ] == bizz_type_trucker ) SendClientMessage ( playerid, col_gray, !"* У Ваших сотрудников будет скидка в 50%% на заправках." ) ;
				else b_info [ business_id ] [ b_maxproduct ] += 10000 ;
			}
			else if ( improveid == 2 )
			{
			    if ( b_info [ business_id ] [ b_type ] == bizz_type_gas ) b_info [ business_id ] [ b_maxproduct ] += 10000 ;
				else if ( b_info [ business_id ] [ b_type ] == bizz_type_trucker ) SendClientMessage ( playerid, col_gray, !"* У Ваших сотрудников будет скидка в 50%% в магазинах 24/7." ) ;
				else SendClientMessage ( playerid, col_gray, !"* В Вашем бизнесе появилась возможность вылечиться с помощью команды {"#cGN"}/bheal{"#cGRInfo"}. Стоимость лечения: {"#cGN"}250"valute_title_"" ) ;
			}
			else if ( improveid == 3 )
			{
			    if ( b_info [ business_id ] [ b_type ] == bizz_type_trucker ) SendClientMessage ( playerid, col_gray, !"* Для Вашей транспортной компании будет индивидуальное предложение по доставке грузов." ) ;
				else
				{
					SendClientMessage ( playerid, col_gray, !"* У Вашего бизнеса появился сотрудник, который будет сам заказывать продукцию." ) ;
					SendClientMessage ( playerid, col_gray, !"* Сотрудник будет формировать заказ в начале каждого нового часа." ) ;
				}
			}

			new data [ 32 ], query [ 148 ] ;
			for ( new i = 0 ; i < MAX_B_IMPROVE ; i ++ )
			{
				if ( ! i ) format ( data, sizeof ( data ),"%d", b_info [ business_id ] [ b_improve ] [ i ] ) ;
				else format ( data, sizeof ( data ),"%s|%d", data, b_info [ business_id ] [ b_improve ] [ i ] ) ;
			}
			format ( query, sizeof ( query ), "UPDATE `businesses` SET `b_improve` = '%s',`b_maxproduct`='%d'  WHERE `b_id` = '%d' LIMIT 1", data, b_info [ business_id ] [ b_maxproduct ], business_id + 1 ) ;
			mysql_tquery ( sql_connection, query ) ;

			give_money ( playerid, -price ) ;
			insert_money_log ( playerid, INVALID_PLAYER_ID, -price, "Улучшение бизнеса" ) ;

			SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Улучшение для бизнеса приобретено." ) ;
			show_b_improvment ( playerid, b_info [ business_id ] [ b_type ], business_id + 1 ) ;
			return 1 ;
		}
		case d_bpanel_info:
		{
			if ( response ) return show_bpanel ( playerid ) ;
		}
		case d_bpanel_sell:
		{
			if ( ! response ) return 1 ;

			if ( p_t_info [ playerid ] [ owner_account ] ) return bad_owner_account ( playerid ) ;
			if ( listitem == 0 )
			{
			    if ( p_info [ playerid ] [ hour_played ] < THREE_HOUR_PLAYED ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Доступно с 3 часов в игре. Используйте /mm - Информация о персонаже - Статистика персонажа." ) ;
                show_dialog ( playerid, d_bpanel_sell_id, DIALOG_STYLE_INPUT, "{"#cBHD"}Продажа бизнеса", "{ffffff}Введите ID игрока, которому желаете продать бизнес:", "Принять", "Назад" ) ;
				return 1 ;
			}
			else if ( listitem == 1 )
			{
				new _d_str [ 300 ] ;
				format ( _d_str, sizeof _d_str, "{"#cBInfo"}* {"#cWH"}Государственная стоимость: {"#cGN"}%d"valute_title_"\n\
												{"#cBInfo"}* {"#cWH"}Цена продажи: {"#cGN"}%d"valute_title_"\n\n\
												{"#cGRDialog"}* Цена продажи может быть намного меньше\n\
												{"#cGRDialog"}* если на бизнес есть государственная наценка.\n\n\
												{"#cGRDialog"}* Вы действительно желаете продать бизнес в Собственность штата?",
				b_info [ p_info [ playerid ] [ business ] - 1 ] [ b_price ] * for_tax [ 1 ], floatround ( ( b_info [ p_info [ playerid ] [ business ] - 1 ] [ b_price ] * sell_percent ) / 100 ) ) ;
				show_dialog ( playerid, d_bpanel_sell_gov, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Продажа бизнеса", _d_str, "Продать", "Назад" ) ;
				return 1 ;
			}
		}
		case d_bpanel_sell_id:
		{
			if ( ! response )return show_dialog ( playerid, d_bpanel_sell, DIALOG_STYLE_LIST, "{"#cBHD"}Продажа бизнеса", "{"#cBL"}1.{"#cWH"} Продать игроку\n{"#cBL"}2.{"#cWH"} Продать государству", "Выбрать", "Назад" ) ;

			new pl_id = strval ( inputtext ) ;
			if ( pl_id < 0 || pl_id > MAX_PLAYERS )return show_dialog ( playerid, d_hmenu_sell_id, DIALOG_STYLE_INPUT, "{"#cBHD"}Продажа дома", "{ffffff}Введите ID игрока, которому желаете продать дом:\n\n{"#cRD"}* Данный игрок не найден.", "Принять", "Назад" ) ;
            if ( buyer_id [ playerid ] != INVALID_PLAYER_ID )return show_dialog ( playerid, d_bpanel_sell_id, DIALOG_STYLE_INPUT, "{"#cBHD"}Продажа бизнеса", "{ffffff}Введите ID игрока, которому желаете продать бизнес:\n\n{"#cRD"}* Вы уже предложили купить Ваш бизнес.", "Принять", "Назад" ) ;
			if ( ! bad_dialog ( pl_id ) || ! bad_dialog ( playerid ) ) return show_dialog ( playerid, d_bpanel_sell_id, DIALOG_STYLE_INPUT, "{"#cBHD"}Продажа бизнеса", "{ffffff}Введите ID игрока, которому желаете продать бизнес:\n\n{"#cRD"}* Игрок в данный момент не может заключить сделку(открыт диалог).", "Принять", "Назад" ) ;
			if ( ! IsPlayerConnected ( pl_id ) || p_t_info [ pl_id ] [ p_logged ] == false ) return show_dialog ( playerid, d_bpanel_sell_id, DIALOG_STYLE_INPUT, "{"#cBHD"}Продажа бизнеса", "{ffffff}Введите ID игрока, которому желаете продать бизнес:\n\n{"#cRD"}* Данный игрок не найден.", "Принять", "Назад" ) ;
			if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ pl_id ][ p_pos ] [ 0 ], p_t_info [ pl_id ][ p_pos ] [ 1 ], p_t_info [ pl_id ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( pl_id ) != GetPlayerVirtualWorld ( playerid ) )return show_dialog ( playerid, d_bpanel_sell_id, DIALOG_STYLE_INPUT, "{"#cBHD"}Продажа бизнеса", "{ffffff}Введите ID игрока, которому желаете продать бизнес:\n\n{"#cRD"}* Данный игрок слишком далеко.", "Принять", "Назад" ) ;
            if ( admin_info [ pl_id ] [ admin ] > 0 && admin_info [ pl_id ] [ admin ] < 6 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок администратор." ) ;
			if ( Iter_Count(player_business[pl_id]) >= p_info [ pl_id ] [ max_biz ] ) return show_dialog ( playerid, d_bpanel_sell_id, DIALOG_STYLE_INPUT, "{"#cBHD"}Продажа бизнеса", "{ffffff}Введите ID игрока, которому желаете продать бизнес:\n\n{"#cRD"}* У игрока уже есть бизнес.", "Принять", "Назад" ) ;
			if ( p_info [ pl_id ] [ b_worker ] != -1 )return show_dialog ( playerid, d_bpanel_sell_id, DIALOG_STYLE_INPUT, "{"#cBHD"}Продажа бизнеса", "{ffffff}Введите ID игрока, которому желаете продать бизнес:\n\n{"#cRD"}* Игрок является работником бизнеса.", "Принять", "Назад" ) ;
            if ( p_info [ pl_id ] [ hour_played ] < THREE_HOUR_PLAYED ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не отыграл 3 часа." ) ;

            if ( GetString ( p_t_info [ pl_id ] [ p_ip ], p_t_info [ playerid ] [ p_ip ] ) )
			{
				new scm_string [ 128 ] ;
				format ( scm_string, sizeof ( scm_string ), "{"#cBAdmin"}[A]{"#cGRAdmin"} %s[%d] попытка продажи бизнеса %s[%d] | same ip", p_info [ playerid ] [ name ], playerid, p_info [ pl_id ] [ name ], pl_id ) ;
				foreach(new i: admin_players)SendClientMessage ( i, col_admin, scm_string ) ;

				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Невозможно продать данному игроку." ) ;
				return 1 ;
			}

			buyer_id [ playerid ] = pl_id ;
			show_dialog ( playerid, d_bpanel_sell_price, DIALOG_STYLE_INPUT, "{"#cBHD"}Продажа бизнеса", "{ffffff}Введите сумму, за которую хотите продать бизнес:", "Принять", "Назад" ) ;
		}
		case d_bpanel_sell_price:
		{
			if ( ! response )return buyer_id [ playerid ] = INVALID_PLAYER_ID, show_dialog ( playerid, d_bpanel_sell_id, DIALOG_STYLE_INPUT, "{"#cBHD"}Продажа бизнеса", "{ffffff}Введите ID игрока, которому желаете продать бизнес:", "Принять", "Назад" ) ;
			new money_count = strval ( inputtext ) ;
			if ( money_count < 1 || money_count > 100000000 || money_count == INVALID_PRICE ) return show_dialog ( playerid, d_bpanel_sell_price, DIALOG_STYLE_INPUT, "{"#cBHD"}Продажа бизнеса", "{ffffff}Введите сумму, за которую хотите продать бизнес:\n\n{"#cGRDialog"}* Вы ввели некорректную сумму.", "Принять", "Назад" ) ;
			if ( cooldown_sentence [ playerid ] > gettime ( ) ) return show_dialog ( playerid, d_bpanel_sell_price, DIALOG_STYLE_INPUT, "{"#cBHD"}Продажа бизнеса", "{ffffff}Введите сумму, за которую хотите продать бизнес:\n\n{"#cGRDialog"}* Предложение о сделке можно отправлять один раз в {"#cRD"}45 секунд{"#cGRInfo"}.", "Принять", "Назад" ) ;

            cooldown_sentence [ playerid ] = gettime ( ) + time_sell_sentence ;

			sell_price [ playerid ] = money_count ;

			new pl_id = buyer_id [ playerid ] ;
			seller_id [ pl_id ] = playerid ;

			sell_time { playerid } =
			sell_time { pl_id } = time_sell_null ;

			show_dialog ( pl_id, d_bpanel_check, DIALOG_STYLE_LIST, "{"#cBHD"}Покупка бизнеса", "{"#cBL"}1. {"#cWH"}Приобрести\n{"#cBL"}2. {"#cWH"}Информация\n{"#cBL"}3. {"#cWH"}История дохода", "Выбрать", "Отмена" ) ;
		}
		case d_bpanel_check:
		{
		    new pl_id = seller_id [ playerid ] ;
			if ( ! response )
			{
				clear_sell_params ( playerid, pl_id ) ;
				SendClientMessage ( pl_id, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок отказался приобретать бизнес." ) ;
				return 1 ;
			}
			if ( ! IsPlayerConnected ( pl_id ) || p_t_info [ pl_id ] [ p_logged ] == false )
			{
				clear_sell_params ( playerid, pl_id ) ;
				return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Произошла ошибка при продаже бизнеса. Код: 19.") ;
			}
			new t = p_info [ pl_id ] [ business ] - 1 ;
			switch ( listitem )
			{
			    case 0:
			    {
			        global_string [ 0 ] = EOS ;
			        new money_count = sell_price [ pl_id ] ;

					format ( global_string, 128, "{ffffff}%s[%d] предлагает Вам приобрести бизнес\nНазвание: {"#cBL"}%s\n{ffffff}Цена: {"#cBL"}%s"valute_title_"",
					p_info [ pl_id ] [ name ], playerid, b_info [ t ] [ b_name ], GetPlayerCashValueToSmile ( money_count ) ) ;
					show_dialog ( playerid, d_bpanel_buy, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Покупка бизнеса", global_string, "Купить", "Отмена" ) ;
			    }
			    case 1:
			    {
			        business_information ( playerid, t, 2 ) ;
			    }
			    case 2:
			    {
			        new text_string [ 144 ] ;
					mysql_format ( sql_connection, text_string, sizeof ( text_string  ), "SELECT `bh_count`, `bh_date` FROM `businesses_history` WHERE `bh_business` = '%d' AND `bh_date` >= DATE(NOW()) - INTERVAL 7 DAY", t + 1 ) ;
					mysql_tquery ( sql_connection, text_string, "bh_story", "iii", playerid, t + 1, 2 ) ;
			    }
			}
		}
		case d_b_story_sell:
		{
		    new pl_id = seller_id [ playerid ] ;
			if ( ! response )
			{
				clear_sell_params ( playerid, pl_id ) ;
				SendClientMessage ( pl_id, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок отказался приобретать бизнес." ) ;
				return 1 ;
			}
			show_dialog ( playerid, d_bpanel_check, DIALOG_STYLE_LIST, "{"#cBHD"}Покупка бизнеса", "{"#cBL"}1. {"#cWH"}Приобрести\n{"#cBL"}2. {"#cWH"}Информация\n{"#cBL"}3. {"#cWH"}История дохода", "Выбрать", "Отмена" ) ;
		}
		case d_bpanel_buy:
		{
			new pl_id = seller_id [ playerid ] ;
			if ( ! response )
			{
				clear_sell_params ( playerid, pl_id ) ;
				SendClientMessage ( pl_id, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок отказался приобретать бизнес." ) ;
				return 1 ;
			}
			if ( ! IsPlayerConnected ( pl_id ) || p_t_info [ pl_id ] [ p_logged ] == false ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Произошла ошибка при продаже бизнеса. Код: 19.") ;
			if ( ! Iter_Count(player_business[pl_id]) )
			{
				clear_sell_params ( playerid, pl_id ) ;
				return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока нет бизнеса." ) ;
			}

			if ( Iter_Count(player_business[playerid]) >= p_info [ playerid ] [ max_biz ] )
			{
		   		clear_sell_params ( playerid, pl_id ) ;
				SendClientMessage ( pl_id, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока уже есть бизнес." ) ;
				return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас уже есть бизнес." ) ;
			}

			new _b_sell_price = sell_price [ pl_id ] ;
			if ( p_info [ playerid ] [ money ] < _b_sell_price )
			{
				clear_sell_params ( playerid, pl_id ) ;
				SendClientMessage ( pl_id, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока недостаточно средств для приобретения бизнеса." ) ;
				return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас недостаточно средств для приобретения бизнеса." ) ;
			}
			if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ pl_id ] [ p_pos ] [ 0 ], p_t_info [ pl_id ] [ p_pos ] [ 1 ], p_t_info [ pl_id ] [ p_pos ] [ 2 ] ) || p_t_info [ playerid ] [ p_data ] [ 1 ] != p_t_info [ pl_id ] [ p_data ] [ 1 ] )
			{
				clear_sell_params ( playerid, pl_id ) ;
				SendClientMessage ( pl_id, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы слишком далеко от покупателя." ) ;
				return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы слишком далеко от продавца." ) ;
			}
			if ( ! IsPlayerConnected ( pl_id ) || p_t_info [ pl_id ] [ p_logged ] == false )
			{
				clear_sell_params ( playerid, pl_id ) ;
				return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Произошла ошибка при продаже бизнеса. Код: 19.") ;
			}

			new b = p_info [ pl_id ] [ business ] - 1 ;
			format ( b_info [ b ] [ b_owner_name ], MAX_PLAYER_NAME, "%s", p_info [ playerid ] [ name ] ) ;
			b_info [ b ] [ b_owner_inc ] = p_info [ playerid ] [ id ];
			p_info [ playerid ] [ business ] = b_info [ b ] [ b_id ] ;

			p_info [ playerid ] [ b_worker ] = -1 ;
			p_info [ playerid ] [ business_rang ] = b_info [ b ] [ b_settings ] [ 3 ] ;

			new query_string [ 186 ];
			format ( query_string, sizeof query_string, "UPDATE `users` SET `u_bworker` = '-1', `u_business_rang` = '%d' WHERE `u_id` = '%d' LIMIT 1", p_info [ playerid ] [ business_rang ], p_info [ playerid ] [ id ] ) ;
			mysql_tquery ( sql_connection, query_string ) ;

			p_info [ pl_id ] [ business ] = -1 ;

			p_info [ pl_id ] [ business_rang ] = 0 ;
			update_int_sql ( pl_id, "u_business_rang", 0 ) ;

			give_money ( playerid, - _b_sell_price ) ;
			give_money ( pl_id, _b_sell_price ) ;

			Iter_Remove ( business_players[b + 1], pl_id ) ;
			Iter_Add ( business_players[b + 1], playerid ) ;

			insert_money_log ( playerid, pl_id, - _b_sell_price, "покупка бизнеса" ) ;
			insert_money_log ( pl_id, playerid, _b_sell_price, "продажа бизнеса" ) ;

			Iter_Remove(player_business[pl_id], b_info [ b ] [ b_id ]);
			Iter_Add(player_business[playerid], b_info [ b ] [ b_id ]);

			#if defined m_tablet
				deleteForSellProperty ( b_info [ b ] [ b_id ], CATEGORY_BUSINESS ) ;
			#endif

			format ( query_string, 144, "{"#cGN"}* %s{"#cWH"} продал Вам бизнес {"#cGN"}%s(№%d) {"#cWH"}за {"#cGN"}%d"valute_title"{"#cWH"}.", p_info [ pl_id ] [ name ], b_types [ b_info [ b ] [ b_type ] ], b_info [ b ] [ b_id ], _b_sell_price ) ;
			SendClientMessage ( playerid, col_white, query_string ) ;
			format( query_string, 144, "{"#cGInfo"}* {"#cWH"}Вы продали бизнес %s(№%d) {"#cGN"}%s{"#cWH"} за {"#cGN"}%d"valute_title"{"#cWH"}.", b_types [ b_info [ b ] [ b_type ] ], b_info [ b ] [ b_id ], p_info [ playerid ] [ name ], _b_sell_price ) ;
			SendClientMessage ( pl_id, col_white, query_string ) ;

			b_info [ b ] [ b_sell_status ] = 0 ;

			format ( query_string, sizeof query_string, "UPDATE `businesses` SET `b_sell_status` = '0', `b_owner_inc` = '%d' WHERE `b_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ], b_info [ b ] [ b_id ] ) ;
			mysql_tquery ( sql_connection, query_string ) ;

			update_blabel ( b ) ;

			SendClientMessage ( playerid, col_gray, !"{"#cGInfo"}* {"#cGRInfo"}Вы успешно приобрели данный бизнес. Используйте {"#cGN"}/bpanel{"#cGRInfo"} для управление бизнесом." ) ;
		 	SendClientMessage ( playerid, col_gray, !"{"#cGInfo"}* {"#cGRInfo"}Вам необходимо оплачивать налоги на недвижимость." ) ;
		 	SendClientMessage ( playerid, col_gray, !"{"#cGInfo"}* {"#cGRInfo"}Налоги списываются 1 раз в сутки. Для получения выписки рекомендуем обратиться в банк." ) ;
			PlayerPlaySound ( playerid, 1052, 0.0, 0.0, 0.0 ) ;

			if ( ! users_education [ playerid ] [ EDUCATION_BUY_BUSINESS ] )
			{
				show_window_monologue (
					playerid,
					5,
					"Поздравляю тебя с покупкой бизнеса! \
					Не забывай оплачивать налоги. Налоги на недвижимость начисляются раз в сутки. \
					Оплатить их можно в банке или банкомате. Используй /gps, чтоб найти ближайший. \
					Если сумма долга превысит "tax_limit", то сотрудники Мэрии опечатать имущество для аукциона.",
					"Местный",
					"Понял"
				) ;

				save_user_education ( playerid, EDUCATION_BUY_BUSINESS ) ;
			}

			clear_sell_params ( playerid, pl_id ) ;
			return 1 ;
		}

		case d_bpanel_sell_gov:
		{
			if ( ! response )return show_dialog ( playerid, d_bpanel_sell, DIALOG_STYLE_LIST, "{"#cBHD"}Продажа бизнеса", "{"#cBL"}1.{"#cWH"} Продать игроку\n{"#cBL"}2.{"#cWH"} Продать государству", "Выбрать", "Назад" ) ;
			new b = p_info [ playerid ] [ business ] - 1 ;
			sell_businesses ( b, playerid, true, false ) ;
			return 1 ;
		}
		case d_bpanel_fee:
		{
			if ( ! response )
			{
				show_bpanel ( playerid ) ;
				return 1 ;
			}

			new _b_id ;
			if ( p_info [ playerid ] [ b_worker ] != -1 ) _b_id = p_info [ playerid ] [ b_worker ] ;
			else _b_id = p_info [ playerid ] [ business ] ;

			new _value = strval ( inputtext ) ;
			if ( _value < 0 || _value > 5000 )
			{
				new dialog_string [ 68 ] ;
				format ( dialog_string, sizeof ( dialog_string ), "{ffffff}На данный момент цена за вход составляет %d"valute_title".", b_info [ _b_id - 1 ] [ b_fee ] ) ;
				show_dialog ( playerid, d_bpanel_fee, DIALOG_STYLE_INPUT, "{"#cBHD"}Цена за вход", dialog_string, "Принять", "Назад" ) ;
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Цена за вход не может быть меньше {"#cRD"}0"valute_title"{"#cGRInfo"} или больше {"#cRD"}5.000"valute_title"{"#cGRInfo"}." ) ;
				return 1 ;
			}

			b_info [ _b_id - 1 ] [ b_fee ] = _value ;

			new query_string [ 69 + 5 + 9 ];
			format ( query_string, sizeof query_string, "UPDATE `businesses` SET `b_fee` = '%d' WHERE `b_id` = '%d' LIMIT 1", b_info [ _b_id - 1 ] [ b_fee ], b_info [ _b_id - 1 ] [ b_id ] ) ;
			mysql_tquery ( sql_connection, query_string ) ;

			SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Цена за вход в бизнес изменена." ) ;
		}
