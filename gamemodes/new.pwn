				mysql_tquery ( sql_connection, query_string, "get_player_house_sellstatus", "ii", playerid, 2 ) ;
			}
			else if ( listitem == 2 )
			{
				new s_house_id = GetPVarInt ( playerid, "debt_garage" ) ;
				new pvar_string [ 48 ], pl_name [ MAX_PLAYER_NAME ] ;
				format ( pvar_string, sizeof ( pvar_string ), "ofm_%d", GetPVarInt ( playerid, "ofm_listitem" ) ) ;
				GetPVarString ( playerid, pvar_string, pl_name, MAX_PLAYER_NAME ) ;
				if ( s_house_id == -1 )
				{
					SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока нет гаража." ) ;

					new query_string [ 76 + 9 ] ;
					format ( query_string, sizeof query_string, "SELECT `u_id`,`u_cellar`,`u_tax` FROM `users` WHERE `u_id` = '%d' LIMIT 1", GetPVarInt ( playerid, "debt_uid" ) ) ;
					mysql_tquery ( sql_connection, query_string, "callback_debtor_property", "i", playerid ) ;
					return 1 ;
				}
				else
				{
				    if ( cellar_info [ s_house_id - 1 ] [ cl_sell_status ] )
					{
						SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Имущество уже подготавливается к опечатке." ) ;

						new query_string [ 76 + 9 ] ;
						format ( query_string, sizeof query_string, "SELECT `u_id`,`u_cellar`,`u_tax` FROM `users` WHERE `u_id` = '%d' LIMIT 1", GetPVarInt ( playerid, "debt_uid" ) ) ;
						mysql_tquery ( sql_connection, query_string, "callback_debtor_property", "i", playerid ) ;
					    return 1 ;
					}

                    cellar_info [ s_house_id - 1 ] [ cl_sell_status ] = 1 ;

                    new _sql_string [ 144 ] ;
					format ( _sql_string, sizeof( _sql_string ), "UPDATE `cellars` SET `cl_sell_status` = '1' WHERE `cl_id` = '%d' LIMIT 1", s_house_id ) ;
					mysql_tquery ( sql_connection, _sql_string ) ;

					new fraction_id = p_info [ playerid ] [ member ] ;
					format ( _sql_string, sizeof _sql_string, "[R] '%s' %s %s подготовил(а) имущество для опечатки.", f_info [ fraction_id - 1 ] [ f_name ], f_rank [ fraction_id - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ] ) ;
					fraction_message ( 1, col_lblue, _sql_string ) ;
					fraction_message ( 2, col_lblue, _sql_string ) ;
					fraction_message ( 3, col_lblue, _sql_string ) ;
					fraction_message ( 11, col_lblue, _sql_string ) ;

					DeletePVar ( playerid, "debt_house" ) ;
					DeletePVar ( playerid, "debt_business" ) ;
					DeletePVar ( playerid, "debt_garage" ) ;
					DeletePVar ( playerid, "debt_tax" ) ;
					DeletePVar ( playerid, "debt_uid" ) ;
					DeletePVar( playerid, "ofm_listitem" ) ;
					getDebtorsInfo ( playerid, page_count [ playerid ], 1 ) ;
				}
			}
			return 1 ;
		}
		case d_debtor_houses_sell:
		{
		    if ( ! response )
		    {
		        clear_player_listitem_values ( playerid ) ;
				DeletePVar ( playerid, "debt_house" ) ;
