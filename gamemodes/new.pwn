	show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Еженедельный куш", global_string, "Принять", "" ) ;
	return 1 ;
}

callback: get_player_activity_hoax ( playerid, b )
{
    new rows, fields ;
	cache_get_data ( rows, fields ) ;

	if ( rows )
	{
		if ( p_info [ playerid ] [ money ] < floatround ( GetModelPrice ( b_info [ b ] [ b_win_car ] ) / 100 ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас недостаточно средств для взноса." ) ;

	    give_money ( playerid, -floatround ( GetModelPrice ( b_info [ b ] [ b_win_car ] ) / 100 ) ) ;
	    insert_money_log ( playerid, INVALID_PLAYER_ID, -floatround ( GetModelPrice ( b_info [ b ] [ b_win_car ] ) / 100 ), "розыгрыш авто" ) ;

	    SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы приняли участие в еженедельном розыгрыше автомобиля от казино." ) ;
		casino_hoax ( playerid, b ) ;
	}
	else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы уже учавствуете в розыгрыше автомобиля в данном казино." ) ;
	return 1 ;
}

