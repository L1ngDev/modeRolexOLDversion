					SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Для получения информации о заболевании используйте /med." ) ;

					new sql_string [ 128 ] ;
					format ( sql_string, sizeof sql_string, "UPDATE `users` SET `u_disease` = '%d', `u_disease_stage` = '%d' WHERE `u_id` = '%d' LIMIT 1", p_info [ playerid ] [ p_disease ] [ 0 ], p_info [ playerid ] [ p_disease ] [ 1 ], p_info [ playerid ] [ id ] ) ;
					mysql_tquery ( sql_connection, sql_string, "", "" ) ;
				}
				else if ( p_info [ playerid ] [ p_disease ] [ 1 ] < 3 )
				{
					p_info [ playerid ] [ p_disease ] [ 1 ] ++ ;
