stock clear_sell_params ( playerid, targetid )
{
	seller_id [ playerid ] =
	buyer_id [ playerid ] =

	seller_id [ targetid ] =
	buyer_id [ targetid ] = INVALID_PLAYER_ID ;

   	sell_time { playerid } =
   	sell_time { targetid } = 0 ;

   	sell_type [ playerid ] =
   	sell_item [ playerid ] =
    sell_price [ playerid ] =

   	sell_type [ targetid ] =
  	sell_item [ targetid ] =
	sell_price [ targetid ] = -1 ;
	return 1 ;
}

stock clear_allsell_params ( playerid )
{
	seller_id [ playerid ] =
   	buyer_id [ playerid ] = INVALID_PLAYER_ID ;

   	sell_time { playerid } = 0 ;

    sell_type [ playerid ] =
   	sell_item [ playerid ] =
    sell_price [ playerid ] = -1 ;
	return 1 ;
}

