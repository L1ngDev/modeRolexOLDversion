		case d_dip_change:
		{
			if ( mw_biz != -1 || gz_captured != -1 || conf_time > 0 )
			{
				callcmd::diplomacy ( playerid ) ;

				return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Невозможно изменять дипломатию во время войны." ) ;
			}
			if ( ! response )
			{
				callcmd::diplomacy ( playerid ) ;
				return 1 ;
			}
			new fr_id = get_player_listitem_values ( playerid, GetPVarInt ( playerid, "d_listitem" ) ) ;
			clear_player_listitem_values ( playerid ) ;
			DeletePVar ( playerid, "d_listitem" ) ;

			new fraction_id = p_info [ playerid ] [ member ] ;
			if ( f_diplomacy [ fraction_id - 18 ] [ fr_id - 18 ] == listitem ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы уже находитесь в данных дипломатических отношениях." ) ;
			if ( listitem == 2 )
			{
				if ( f_diplomacy [ fraction_id - 18 ] [ fr_id - 18 ] == dip_status_alliance_get_invite )
				{
					f_diplomacy [ fraction_id - 18 ] [ fr_id - 18 ] = dip_status_alliance ;
					f_diplomacy [ fr_id - 18 ] [ fraction_id - 18 ] = dip_status_alliance ;

					new text_info [ 128 ] ;
					format ( text_info, sizeof text_info, "* [ДИПЛОМАТИЯ]: %s заключила союз с %s. (Инициатор: %s)", f_info [ fraction_id - 1 ] [ f_name ], f_info [ fr_id - 1 ] [ f_name ], p_info [ playerid ] [ name ] ) ;
					SendGangMessage ( 0xb5e8f0FF, text_info ) ;
					SendMafiaMessage ( 0xb5e8f0FF, text_info ) ;

					if ( listitem == dip_status_alliance )
					{
						new sql_string [ 74 + 9 + 9 ] ;
						mysql_format ( sql_connection, sql_string, sizeof sql_string, "DELETE FROM `f_wars` WHERE `f_org` = '%d' AND `f_to_org` = '%d' LIMIT 1",
						fraction_id, fr_id ) ;
						mysql_tquery ( sql_connection, sql_string, "", "" ) ;

						mysql_format ( sql_connection, sql_string, sizeof sql_string, "DELETE FROM `f_wars` WHERE `f_org` = '%d' AND `f_to_org` = '%d' LIMIT 1",
						fr_id, fraction_id ) ;
						mysql_tquery ( sql_connection, sql_string, "", "" ) ;
					}

					callcmd::diplomacy ( playerid ) ;

					save_diplomacy ( fraction_id ) ;
					save_diplomacy ( fr_id ) ;
					return 1 ;
				}
				f_diplomacy [ fraction_id - 18 ] [ fr_id - 18 ] = dip_status_alliance_invite ;
				f_diplomacy [ fr_id - 18 ] [ fraction_id - 18 ] = dip_status_alliance_get_invite ;

				callcmd::diplomacy ( playerid ) ;

				save_diplomacy ( fraction_id ) ;
				save_diplomacy ( fr_id ) ;
				return 1 ;
			}
			f_diplomacy [ fraction_id - 18 ] [ fr_id - 18 ] = listitem ;
			f_diplomacy [ fr_id - 18 ] [ fraction_id - 18 ] = listitem ;

			new texts_info [ 128 ] ;
			format ( texts_info, sizeof texts_info, "* [ДИПЛОМАТИЯ]: %s %s %s. (Инициатор: %s)", f_info [ fraction_id - 1 ] [ f_name ], ( listitem == 0 ) ? ( "заключила нейтралитет с" ) : ( "объявила войну" ), f_info [ fr_id - 1 ] [ f_name ], p_info [ playerid ] [ name ] ) ;
			SendGangMessage ( 0xb5e8f0FF, texts_info ) ;
			SendMafiaMessage ( 0xb5e8f0FF, texts_info ) ;

			if ( listitem == dip_status_neutral )
			{
				new sql_string [ 74 + 9 + 9 ] ;
				mysql_format ( sql_connection, sql_string, sizeof sql_string, "DELETE FROM `f_wars` WHERE `f_org` = '%d' AND `f_to_org` = '%d' LIMIT 1",
				fraction_id, fr_id ) ;
				mysql_tquery ( sql_connection, sql_string, "", "" ) ;

				mysql_format ( sql_connection, sql_string, sizeof sql_string, "DELETE FROM `f_wars` WHERE `f_org` = '%d' AND `f_to_org` = '%d' LIMIT 1",
				fr_id, fraction_id ) ;
				mysql_tquery ( sql_connection, sql_string, "", "" ) ;
			}
			else if ( listitem == dip_status_war )
			{
			    new _sql_string [ 127 + 9 + 9 ] ;
			    format ( _sql_string, sizeof _sql_string, "INSERT INTO `f_wars` (`f_org`,`f_to_org`,`f_kill`,`f_to_kill`,`f_capture`,`f_to_capture`) VALUES ('%d','%d','0','0','0','0')",
				fraction_id, fr_id ) ;
				mysql_tquery ( sql_connection, _sql_string ) ;
			}

			callcmd::diplomacy ( playerid ) ;

			save_diplomacy ( fraction_id ) ;
			save_diplomacy ( fr_id ) ;

		}
		case d_lmenu_rankname_list:
		{
			if ( ! response )return 1 ;

		    if ( admin_info [ playerid ] [ admin ] < 8 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вам необходимо пригласить главного администратора дял помощи в редактировании настроек." ) ;

			new fractionid = p_info [ playerid ] [ member ] ;
			if ( listitem == f_info [ fractionid - 1 ] [ f_rank_settings ] [ 0 ] )
			{
			    for ( new i = 0; i < f_info [ fractionid - 1 ] [ f_rank_settings ] [ 0 ] ; i ++ )
				{
			    	format ( f_rank [ fractionid - 1 ] [ i ], 30, "%s", f_default_rank [ fractionid - 1 ] [ i ] ) ;
				}

				show_setrank ( playerid ) ;
				save_setrank ( playerid ) ;

				SendClientMessage ( playerid, col_succes, !"Вы успешно восстановили названия рангов." ) ;
			    return 1 ;
			}

			SetPVarInt ( playerid, "rank_name_listitem", listitem ) ;

			global_string [ 0 ] = EOS ;
			format ( global_string, 450, "{"#cWH"}Вы собираетесь изменить следующую конфигурацию:\n\n\tОрганизация: {%s}%s\n\t{"#cWH"}Название: {"#cLY"}Название ранга\n\t{"#cWH"}Текущее значение: {"#cLY"}%s\n\t{"#cWH"}Стандартное значение: {"#cLY"}%s\n\n{"#cGRDialog"}* Введите новое значение для данной конфигурации:", f_info [ fractionid - 1 ] [ f_chat_color ], f_info [ fractionid - 1 ] [ f_name ], f_rank [ fractionid - 1 ] [ listitem ], f_default_rank [ fractionid - 1 ] [ listitem ] );
			show_dialog ( playerid, d_lmenu_rankname_set, DIALOG_STYLE_INPUT, "{"#cBHD"}Изменение конфигурации", global_string, "Выбрать", "Назад" ) ;
			return 1 ;
		}
		case d_lmenu_rankname_set:
		{
			if ( ! response ) return show_setrank ( playerid ), DeletePVar ( playerid, "rank_name_listitem" ) ;

			new fractionid = p_info [ playerid ] [ member ] ;
            new dialog_rank_id = GetPVarInt ( playerid, "rank_name_listitem" ) ;

			if ( strlen ( inputtext ) < 3 || strlen ( inputtext ) > 24 )
			{
				global_string [ 0 ] = EOS ;
				format ( global_string, 450, "{"#cWH"}Вы собираетесь изменить следующую конфигурацию:\n\n\tОрганизация: {%s}%s\n\t{"#cWH"}Название: {"#cLY"}Название ранга\n\t{"#cWH"}Текущее значение: {"#cLY"}%s\n\t{"#cWH"}Стандартное значение: {"#cLY"}%s\n\n{"#cGRDialog"}* Введите новое значение для данной конфигурации:", f_info [ fractionid - 1 ] [ f_chat_color ], f_info [ fractionid - 1 ] [ f_name ], f_rank [ fractionid - 1 ] [ dialog_rank_id ], f_default_rank [ fractionid - 1 ] [ dialog_rank_id ] );
				show_dialog ( playerid, d_lmenu_rankname_set, DIALOG_STYLE_INPUT, "{"#cBHD"}Изменение конфигурации", global_string, "Выбрать", "Назад" ) ;

				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Название ранга не может состоять менее чем из {"#cRD"}3{"#cGRInfo"} или более чем из {"#cRD"}24{"#cGRInfo"} символов!" ) ;
				return 1 ;
			}
			if ( is_text_invalid ( inputtext ) )
			{
				global_string [ 0 ] = EOS ;
				format ( global_string, 450, "{"#cWH"}Вы собираетесь изменить следующую конфигурацию:\n\n\tОрганизация: {%s}%s\n\t{"#cWH"}Название: {"#cLY"}Название ранга\n\t{"#cWH"}Текущее значение: {"#cLY"}%s\n\t{"#cWH"}Стандартное значение: {"#cLY"}%s\n\n{"#cGRDialog"}* Введите новое значение для данной конфигурации:", f_info [ fractionid - 1 ] [ f_chat_color ], f_info [ fractionid - 1 ] [ f_name ], f_rank [ fractionid - 1 ] [ dialog_rank_id ], f_default_rank [ fractionid - 1 ] [ dialog_rank_id ] );
				show_dialog ( playerid, d_lmenu_rankname_set, DIALOG_STYLE_INPUT, "{"#cBHD"}Изменение конфигурации", global_string, "Выбрать", "Назад" ) ;

				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы указали {"#cRD"}недопустимые{"#cGRInfo"} символы." ) ;
				return 1 ;
			}

			format ( f_rank [ fractionid - 1 ] [ dialog_rank_id ], 30, "%s", inputtext ) ;
			new sql_string [ 128 ] ;
			format ( sql_string, sizeof sql_string, "Вы успешно изменили название %d ранга на %s", dialog_rank_id + 1, inputtext ) ;
			SendClientMessage ( playerid, col_succes, sql_string ) ;

			format ( sql_string, sizeof sql_string, "Изменил(а) ранг №%d на %s", dialog_rank_id + 1, inputtext ) ;
			write_fraction ( playerid, fractionid, TYPE_LOG_OBWYAK, sql_string ) ;

			format( sql_string, sizeof sql_string, "{"#cBAdmin"}[A] {"#cGRAdmin"}%s изменил(а) название ранга №%d на %s.", p_info [ playerid ] [ name ], dialog_rank_id + 1, inputtext ) ;
			admin_message ( 6, col_admin, sql_string ) ;

			DeletePVar ( playerid, "rank_name_listitem" ) ;

			show_setrank ( playerid ) ;
			save_setrank ( playerid ) ;
			return 1 ;
		}
		case d_give_mc:
		{
			if ( ! response )return DeletePVar ( playerid, "mc_playerid" ) ;
			if ( listitem == 0 )
			{
				show_dialog ( playerid, d_give_mc, DIALOG_STYLE_LIST, "{"#cBHD"}Выдача мед.карты",
				"{"#cLY"}Выберите результат осмотра:\n{ffffff}Серьезно болен/больна\nНаблюдаются отклонения\nПолностью здоров(а)", "Выбрать", "Закрыть" ) ;
				return 1 ;
			}

			new pl_id = GetPVarInt ( playerid, "mc_playerid" ) ;
			if ( GetInventoryFindItem ( pl_id, SUB_INVENTORY, 2221 ) )
			{
			    SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока уже имеется медицинская карта." ) ;
				SendClientMessage ( pl_id, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас уже имеется медицинская карта." ) ;
				DeletePVar ( playerid, "mc_playerid" ) ;
				DeletePVar ( playerid, "list_item" ) ;
				return 1 ;
			}

			if ( ! IsPlayerConnected ( pl_id ) || p_t_info [ pl_id ] [ p_logged ] == false ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ), DeletePVar ( playerid, "mc_playerid" ) ;
			if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ pl_id ][ p_pos ] [ 0 ], p_t_info [ pl_id ][ p_pos ] [ 1 ], p_t_info [ pl_id ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( pl_id ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ), DeletePVar ( playerid, "mc_playerid" ) ;

			new text_string [ 107 + MAX_PLAYER_NAME + 4 + 9 ] ;

			format ( text_string, 90, "%s выдал вам медицинскую карту.", p_info [ playerid ] [ name ] ) ;
			SendClientMessage ( pl_id, col_lblue, text_string ) ;
			format ( text_string, 90, "Вы выдали медицинскую карту игроку %s.", p_info [ pl_id ] [ name ] ) ;
			SendClientMessage ( playerid, col_lblue, text_string ) ;

			format ( text_string, 24, "%d%d%d%d%d%d",
				RandomEx ( 1, 9 ), RandomEx ( 1, 9 ), RandomEx ( 1, 9 ), RandomEx ( 1, 9 ), RandomEx ( 1, 9 ), RandomEx ( 1, 9 ) ) ;
			give_inventory (
				pl_id,
				2221,
				1,
				0,
				"",
				text_string,
				NUMBERPLATE_TYPE_NONE,
				-1
			) ;

			#if defined m_fractions
			    give_emp_progress ( playerid, 2, 1 ) ;
			    if ( army_player ( pl_id ) ) give_emp_progress ( playerid, 4, 1 ) ;
			    else if ( cop_player ( pl_id ) || fbi_player ( pl_id ) ) give_emp_progress ( playerid, 5, 1 ) ;
			#endif

			DeletePVar ( playerid, "mc_playerid" ) ;
			DeletePVar ( playerid, "list_item" ) ;
			return 1 ;
		}
		case d_heal_select:
		{
		    if ( ! response )
			{
				heal_id [ playerid ] = INVALID_PLAYER_ID ;
				heal_price [ playerid ] = 0 ;
				return 1 ;
			}

			static const name_disease [ 3 ] [ 35 ] =
			{
			    "вылечится от простых заболеваний",
			    "вылечиться от наркозависимости",
			    "поставить диагноз"
			} ;

			new target_id = heal_id [ playerid ] ;
			if ( ! IsPlayerConnected ( target_id ) )
			{
			    heal_id [ playerid ] = INVALID_PLAYER_ID ;
				heal_price [ playerid ] = 0 ;
			    return 1 ;
			}

		    new dialog_string [ 166 ] ;

			format ( dialog_string, sizeof ( dialog_string ), "{"#cBL"}%s{"#cWH"} предлагает Вам {"#cGN"}%s {"#cWH"}за {"#cGN"}%d"valute_title_"",
			p_info [ playerid ] [ name ], name_disease [ listitem ], heal_price [ playerid ] ) ;
			show_dialog ( target_id, d_heal, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Медицинское обслуживание", dialog_string, "Принять", "Закрыть" ) ;

			format ( dialog_string, sizeof ( dialog_string ), "Вы предложили {"#cGN"}%s{"#cWH"} {"#cGN"}%s {"#cWH"}за {"#cGN"}%d"valute_title_"",
			p_info [ target_id ] [ name ], name_disease [ listitem ], heal_price [ playerid ] ) ;
			SendClientMessage ( playerid, col_white, dialog_string ) ;

			set_player_use_listitem ( target_id, listitem ) ;

			heal_id [ playerid ] = INVALID_PLAYER_ID ;
			heal_price [ playerid ] = 0 ;
			return 1 ;
		}
		case d_heal:
		{
			if ( ! response )
			{
    			heal_id [ playerid ] = INVALID_PLAYER_ID ;
				heal_price [ playerid ] = 0 ;
				clear_player_use_listitem ( playerid ) ;
				return 1 ;
			}

           	new target_id = heal_id [ playerid ], disease_id = get_player_use_listitem ( playerid ) ;
			clear_player_use_listitem ( playerid ) ;

			if ( ! IsPlayerConnected ( target_id ) || target_id == INVALID_PLAYER_ID )
			{
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден, либо вышел из игры." ) ;
				heal_id [ playerid ] = INVALID_PLAYER_ID ;
				heal_price [ playerid ] = 0 ;
				return 1 ;
			}
			if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ target_id ][ p_pos ] [ 0 ], p_t_info [ target_id ][ p_pos ] [ 1 ], p_t_info [ target_id ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( target_id ) != GetPlayerVirtualWorld ( playerid ) )
			{
			    SendClientMessage ( target_id, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы слишком далеко." ) ;
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;
				heal_id [ playerid ] = INVALID_PLAYER_ID ;
				heal_price [ playerid ] = 0 ;
				return 1 ;
			}
			if ( p_info [ playerid ] [ money ] < heal_price [ playerid ] )
			{
			    SendClientMessage ( target_id, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока недостаточно денег." ) ;
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас недостаточно денег." ) ;
				heal_id [ playerid ] = INVALID_PLAYER_ID ;
				heal_price [ playerid ] = 0 ;
				return 1 ;
			}

			if ( disease_id == 1 && p_info [ playerid ] [ p_disease ] [ 2 ] == 0 )
			{
			    SendClientMessage ( target_id, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не болеет наркозависимостью." ) ;
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет наркозависимости." ) ;
				heal_id [ playerid ] = INVALID_PLAYER_ID ;
				heal_price [ playerid ] = 0 ;
				return 1 ;
			}

			give_event_progress ( playerid, THE_MEDIC, 1 ) ;

			#if defined m_fractions
			    give_emp_progress ( target_id, 0, 1 ) ;
			    if ( army_player ( playerid ) ) give_emp_progress ( target_id, 4, 1 ) ;
			    else if ( cop_player ( playerid ) || fbi_player ( playerid ) ) give_emp_progress ( target_id, 5, 1 ) ;
			#endif

			if ( disease_id == 2 )
			{
			    if ( ! p_info [ playerid ] [ p_disease ] [ 0 ] ) return SendClientMessage ( target_id, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игроку не требуется обследование." ) ;

			    new t_string [ 144 ] ;
			    if ( random ( 50 ) == 1 )
			    {
			        if ( p_info [ playerid ] [ p_disease ] [ 0 ] == 5 ) p_info [ playerid ] [ p_wrong_virus ] [ 0 ] = 1 + random ( 4 ) ;
			        else if ( p_info [ playerid ] [ p_disease ] [ 0 ] == 1 ) p_info [ playerid ] [ p_wrong_virus ] [ 0 ] = 2 + random ( 4 ) ;
			        else p_info [ playerid ] [ p_wrong_virus ] [ 0 ] = ( random ( 2 ) == 0 ) ? ( p_info [ playerid ] [ p_disease ] [ 0 ] - 1 ) : ( p_info [ playerid ] [ p_disease ] [ 0 ] + 1 ) ;
			        p_info [ playerid ] [ p_wrong_virus ] [ 1 ] = 1 ;
			        p_info [ playerid ] [ p_diagnosis ] = 2 ;

			        format ( t_string, sizeof t_string, "Вам поставили диагноз '%s'.", viruses_name [ p_info [ playerid ] [ p_wrong_virus ] [ 0 ] - 1 ] ) ;
			        SendClientMessage ( playerid, col_lblue, t_string ) ;
			        format ( t_string, sizeof t_string, "Вы поставили диагноз '%s' игроку %s.",  viruses_name [ p_info [ playerid ] [ p_wrong_virus ] [ 0 ] - 1 ], p_info [ playerid ] [ name ] ) ;
			        SendClientMessage ( target_id, col_lblue, t_string ) ;
					SetPlayerChatBubble ( target_id, "осмотрел(а) пациента", col_light_purple, 13.0, 5000 ) ;

			        format ( t_string, sizeof t_string, "UPDATE `users` SET `u_diagnosis` = '2', `u_bad_disease` = '%d' WHERE `u_id` = '%d' LIMIT 1", p_info [ playerid ] [ p_wrong_virus ] [ 0 ], p_info [ playerid ] [ id ] ) ;
					mysql_tquery(sql_connection, t_string, "", "");
			    }
			    else
			    {
			        p_info [ playerid ] [ p_diagnosis ] = 1 ;

			        format ( t_string, sizeof t_string, "Вам поставили диагноз '%s'.", viruses_name [ p_info [ playerid ] [ p_disease ] [ 0 ] - 1 ] ) ;
			        SendClientMessage ( playerid, col_lblue, t_string ) ;
			        format ( t_string, sizeof t_string, "Вы поставили диагноз '%s' игроку %s.", viruses_name [ p_info [ playerid ] [ p_disease ] [ 0 ] - 1 ], p_info [ playerid ] [ name ] ) ;
			        SendClientMessage ( target_id, col_lblue, t_string ) ;
			        SetPlayerChatBubble ( target_id, "осмотрел(а) пациента", col_light_purple, 13.0, 5000 ) ;

			        format ( t_string, sizeof t_string, "UPDATE `users` SET `u_diagnosis` = '1' WHERE `u_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
					mysql_tquery(sql_connection, t_string, "", "");
			    }
			}
			else
			{
				set_health ( playerid, 100 ) ;

				static const name_disease [ 2 ] [ 22 ] =
				{
				    "простых заболеваний",
				    "наркозависимости"
				} ;

				new t_string [ 128 ] ;
				format ( t_string, sizeof ( t_string ), "%s полностью Вас вылечил(а) за %d"valute_title_" от %s.", p_info [ target_id ] [ name ], heal_price [ playerid ], name_disease [ disease_id ] ) ;
				SendClientMessage ( playerid, col_lblue, t_string ) ;

				format ( t_string, sizeof ( t_string ), "Вы полностью вылечили %s за %d"valute_title_" от %s.", p_info [ playerid ] [ name ], heal_price [ playerid ], name_disease [ disease_id ] ) ;
				SendClientMessage ( target_id, col_lblue, t_string ) ;

			    p_info [ playerid ] [ p_disease ] [ 2 ] = 0 ;

				if ( player_death_id [ playerid ] ) player_death_id [ playerid ] = 0 ;
			}
			set_money_fraction (  p_info [ target_id ] [ member ] - 1, 3, heal_price [ playerid ], true ) ;

			give_money ( playerid, -heal_price [ playerid ] ) ;
			insert_money_log ( playerid, INVALID_PLAYER_ID, -heal_price [ playerid ], "Лечение у врача" ) ;
			give_money ( target_id, heal_price [ playerid ] ) ;
			insert_money_log ( target_id, INVALID_PLAYER_ID, heal_price [ playerid ], "Лечение игрока" ) ;

			heal_id [ playerid ] = INVALID_PLAYER_ID ;
			heal_price [ playerid ] = 0 ;
			return 1 ;
		}
		case d_heal_2:
		{
			if ( ! response ) return 1 ;

			if ( p_info [ playerid ] [ money ] < governmentPrice [ GOV_EXPRESS_HEALTH ] [ GOVERNMENT_PRICE ] )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас недостаточно денег." ) ;

			give_money ( playerid, -governmentPrice [ GOV_EXPRESS_HEALTH ] [ GOVERNMENT_PRICE ] ) ;
			insert_money_log ( playerid, INVALID_PLAYER_ID, -governmentPrice [ GOV_EXPRESS_HEALTH ] [ GOVERNMENT_PRICE ], "Лечение у ресепшена" ) ;

			set_money_fraction ( 14, 3, governmentPrice [ GOV_EXPRESS_HEALTH ] [ GOVERNMENT_PRICE ], true ) ;
			set_money_fraction ( 15, 3, governmentPrice [ GOV_EXPRESS_HEALTH ] [ GOVERNMENT_PRICE ], true ) ;
			set_money_fraction ( 16, 3, governmentPrice [ GOV_EXPRESS_HEALTH ] [ GOVERNMENT_PRICE ], true ) ;

			set_health ( playerid, 100 ) ;
			give_event_progress ( playerid, THE_MEDIC, 1 ) ;

			if ( player_death_id [ playerid ] ) player_death_id [ playerid ] = 0 ;

			SendClientMessage ( playerid, col_lblue, !"Сотрудник полностью Вас вылечил." ) ;
			return 1 ;
		}
		case d_bank_ransom:
		{
            if ( ! response )
			{
			    clear_player_listitem_values ( playerid ) ;
				show_deposit ( playerid ) ;
				return 1 ;
			}
			new fraction_id = get_player_listitem_values ( playerid, listitem ) ;
			clear_player_listitem_values ( playerid ) ;

			if ( bl_info [ playerid ] [ bl_onFrac ] [ fraction_id + 1 ] )
			{
			    new text_string [ 256 ] ;
			    format ( text_string, sizeof text_string, "{"#cWH"}Вы находитесь в чёрном списке организации: {%s}%s\n{"#cWH"}Цена вынесения из чёрного списка: {"#cGN"}%d"valute_title_"\n\n{"#cWH"}Вы действительно хотите купить выход их чёрного списка?", f_info [ fraction_id ] [ f_chat_color ], f_info [ fraction_id ] [ f_name ], f_info [ fraction_id ] [ f_price_clear ] ) ;
			    show_dialog ( playerid, d_bank_ransom_buy, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Чёрный список", text_string, "Выбрать", "Назад" ) ;

			    SetPVarInt ( playerid, "fraction_id_bl", fraction_id ) ;
			}
			else show_deposit ( playerid ) ;
			return 1 ;
		}
		case d_bank_ransom_buy:
		{
		    new deposit_id = get_player_use_listitem ( playerid ), fractionid = GetPVarInt ( playerid, "fraction_id_bl" ) ;
		    DeletePVar ( playerid, "fraction_id_bl" ) ;
		    if ( ! response )
			{
				show_deposit ( playerid ) ;
				return 1 ;
			}

			if ( bank_info [ playerid ] [ bi_money ] [ deposit_id ] < f_info [ fractionid ] [ f_price_clear ] )
			{
			    show_deposit ( playerid ) ;
			    SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас недостаточно средств на счёте для выкупа из чёрного списка." ) ;
			    return 1 ;
			}

			if ( ! bl_info [ playerid ] [ bl_onFrac ] [ fractionid + 1 ] )
			{
			    show_deposit ( playerid ) ;
			    SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не находитесь в чёрном списке данной организации." ) ;
			    return 1 ;
			}

			insert_money_log ( playerid, INVALID_PLAYER_ID, -f_info [ fractionid ] [ f_price_clear ], "выкуп из ЧС [БАНК]" ) ;

			new query_string [ 144 ] ;
			bank_info [ playerid ] [ bi_money ] [ deposit_id ] -= f_info [ fractionid ] [ f_price_clear ] ;

			format ( query_string, sizeof ( query_string ), "UPDATE `deposit_boxes` SET `db_money` = '%d' WHERE `db_id` = '%d' LIMIT 1", bank_info [ playerid ] [ bi_money ] [ deposit_id ], bank_info [ playerid ] [ bi_id ] [ deposit_id ] ) ;
			mysql_tquery ( sql_connection, query_string, "", "" ) ;

			mysql_format ( sql_connection, query_string, sizeof ( query_string ),"SELECT `bl_player` FROM `fractions_blacklist` WHERE `bl_id` = '%d' AND `bl_fraction` = '%d' LIMIT 1",
			p_info [ playerid ] [ id ], fractionid + 1 ) ;
			mysql_tquery ( sql_connection, query_string, "buy_clear_bl_list", "dd", playerid, fractionid + 1 ) ;

			if ( fractionid >= 17 && fractionid <= 24 )
			{
				new text_string [ 100 ] ;
                format(text_string, sizeof text_string, "* Вы успешно купили выход из чёрного списка %s.", f_info [ fractionid ] [ f_name ] );
                SendClientMessage ( playerid, col_lblue, text_string ) ;

				format(text_string, sizeof text_string, "[F] %s купил(а) выход из чёрного списка.", p_info [ playerid ] [ name ] );
				foreach(new i: logged_players) if ( ( p_info [ i ] [ member ] == fractionid + 1 || is_control_chat { i } == fractionid + 1 || is_fraction_cover { i } == fractionid + 1  ) && p_info [ i ] [ settings ] [ 0 ] != 0 ) SendClientMessage ( i, col_lblue, text_string ) ;

				f_info [ fractionid ] [ f_money ] += f_info [ fractionid ] [ f_price_clear ] ;

				format ( query_string, 100, "UPDATE `fractions` SET `f_money` = '%d' WHERE `f_id` = '%d' LIMIT 1", f_info [ fractionid ] [ f_money ], fractionid + 1 ) ;
				mysql_tquery ( sql_connection, query_string, "", "" ) ;

				update_gdorm_text ( fractionid + 1 ) ;
			}
			else
			{
			    new text_string [ 100 ] ;
                format(text_string, sizeof text_string, "* Вы успешно купили выход из чёрного списка %s.", f_info [ fractionid ] [ f_name ] );
                SendClientMessage ( playerid, col_lblue, text_string ) ;

				format(text_string, sizeof text_string, "[R] %s купил(а) выход из чёрного списка.", p_info [ playerid ] [ name ] );
				foreach(new i: logged_players) if ( ( p_info [ i ] [ member ] == fractionid + 1 || is_control_chat { i } == fractionid + 1 || is_fraction_cover { i } == fractionid + 1  ) && p_info [ i ] [ settings ] [ 0 ] != 0 ) SendClientMessage ( i, col_lblue, text_string ) ;

				f_info [ fractionid ] [ f_money ] += f_info [ fractionid ] [ f_price_clear ] ;

				format ( query_string, 100, "UPDATE `fractions` SET `f_money` = '%d' WHERE `f_id` = '%d' LIMIT 1", f_info [ fractionid ] [ f_money ], fractionid + 1 ) ;
				mysql_tquery ( sql_connection, query_string, "", "" ) ;
			}
			show_deposit ( playerid ) ;
			return 1 ;
		}
		case d_bank_org_transit:
		{
			if ( ! response )
			{
				show_deposit ( playerid ) ;
				return 1 ;
			}
			if ( listitem == 0 ) return show_deposit ( playerid ) ;

            new fraction_id = get_player_listitem_values ( playerid, listitem - 1 ) ;
            clear_player_listitem_values ( playerid ) ;

			new d_string [ 154 + 32 ] ;
			format ( d_string, sizeof ( d_string ), "{"#cWH"}Введите сумму, которую желаете перевести на баланс {"#cBL"}%s\n\n{"#cGRDialog"}* Сумма не должна превышать 10.000.000"valute_title_" и не может быть менее 1"valute_title_"",
			f_info [ fraction_id ] [ f_name ] ) ;
			show_dialog ( playerid, d_bank_org_transitcount, DIALOG_STYLE_INPUT, "{"#cBHD"}Перевод средств", d_string, "Принять", "Назад" ) ;

            SetPVarInt ( playerid, "det_fraction", fraction_id ) ;
			return 1 ;
		}
		case d_bank_org_transitcount:
		{
			if ( ! response )
			{
				show_bank_balance ( playerid ) ;
				return 1 ;
			}
			new deposit_id = get_player_use_listitem ( playerid ), _money = strval ( inputtext ) ;
			if ( _money < 1 || _money > 10000000 )
			{
				new d_string [ 154 + 32 ],
					fraction_id = GetPVarInt ( playerid, "det_fraction" ) ;

				format ( d_string, sizeof ( d_string ), "{"#cWH"}Введите сумму, которую желаете перевести на баланс {"#cBL"}%s\n\n{"#cRD"}* Сумма не должна превышать 10.000.000"valute_title_" и не может быть менее 1"valute_title_"",
				f_info [ fraction_id ] [ f_name ] ) ;
				show_dialog ( playerid, d_bank_org_transitcount, DIALOG_STYLE_INPUT, "{"#cBHD"}Перевод средств", d_string, "Принять", "Назад" ) ;
				DeletePVar ( playerid, "det_fraction" ) ;
				return 1 ;
			}
			if ( bank_info [ playerid ] [ bi_money ] [ deposit_id ] < _money )
			{
				new d_string [ 154 + 32 ],
					fraction_id = GetPVarInt ( playerid, "det_fraction" ) ;

				format ( d_string, sizeof ( d_string ), "{"#cWH"}Введите сумму, которую желаете перевести на баланс {"#cBL"}%s\n\n{"#cRD"}* На балансе мэрии нет таких средств.",
				f_info [ fraction_id ] [ f_name ] ) ;
				show_dialog ( playerid, d_bank_org_transitcount, DIALOG_STYLE_INPUT, "{"#cBHD"}Перевод средств", d_string, "Принять", "Назад" ) ;
				DeletePVar ( playerid, "det_fraction" ) ;
				return 1 ;
			}

			insert_money_log ( playerid, INVALID_PLAYER_ID, -_money, "перевод в орг [БАНК]" ) ;

			new fraction_id = GetPVarInt ( playerid, "det_fraction" ),
				_text_string [ 144 ] ;

			bank_info [ playerid ] [ bi_money ] [ deposit_id ] -= _money ;

			format ( _text_string, sizeof ( _text_string ), "UPDATE `deposit_boxes` SET `db_money` = '%d' WHERE `db_id` = '%d' LIMIT 1", bank_info [ playerid ] [ bi_money ] [ deposit_id ], bank_info [ playerid ] [ bi_id ] [ deposit_id ] ) ;
			mysql_tquery ( sql_connection, _text_string, "", "" ) ;

			format ( _text_string, sizeof ( _text_string ), "{"#cGInfo"}* {"#cWH"}Вы успешно перевели {"#cGN"}%d"valute_title_"{"#cWH"} на баланс {"#cGN"}%s{"#cWH"}.",
			_money, f_info [ fraction_id ] [ f_name ] ) ;
			SendClientMessage ( playerid, col_white, _text_string ) ;

			format ( _text_string, sizeof ( _text_string ), "%s[%d] перевел(а) %d"valute_title_" на баланс %s", p_info [ playerid ] [ name ], playerid,  _money, f_info [ fraction_id ] [ f_name ] ) ;
			foreach(new i: logged_players) if ( fraction_id + 1 == p_info [ i ] [ member ] ) SendClientMessage ( i, 0xFF8282AA, _text_string ) ;

			set_money_fraction ( fraction_id, 2, _money, true ) ;

			show_deposit ( playerid ) ;
			DeletePVar ( playerid, "det_fraction" ) ;
		}
		case d_bank_dr:
		{
		    if ( ! response ) return 1 ;
		    switch ( listitem )
		    {
		        case 0: create_deposit ( playerid ) ;
		        case 1: delete_boxes ( playerid ) ;
		        case 2: reset_boxes ( playerid ) ;
				case 3:
				{
					show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Информация о картах", "\
						{"#cBL"}** Зарплатная **\n\n\
						{"#cWH"}На зарплатную карту каждый час будут поступать денежные средства с организации,\n\
						бизнеса и т.п. начислений, которые приравниваются к заработной плате.\n\n\
						{"#cBL"}** Накопительная **\n\n\
						{"#cWH"}По накопительной карте, каждый час, Вам будет начисляться процент на остаток на карте.\n\
						Процент может меняться в зависимости от того есть ли у Вас услуга VIP-аккаунт.\n\n\
						{"#cBL"}** Кредитная **\n\n\
						Кредитная карта нужна для того, чтоб взять кредит. Также через неё потом его гасить.\n\n\
						{"#cGRDialog"}* Хранить денежные средства можно на любой из карт.", "Принять", "" ) ;
				}
		    }
		    return 1 ;
		}
		case d_bank_delete:
		{
			if ( ! response )
			{
				clear_player_listitem_values ( playerid ) ;
				show_dr_boxes ( playerid ) ;
				return 1 ;
			}

			new line_string [ 78 ], deposit_id = get_player_listitem_values ( playerid, listitem ) ;
			clear_player_listitem_values ( playerid ) ;

			if ( bank_info [ playerid ] [ bi_credit ] [ deposit_id ] > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете закрыть счёт с активным кредитом." ) ;

			set_player_use_listitem ( playerid, deposit_id ) ;

			format ( line_string, sizeof ( line_string ), "{"#cBHD"}Подтверждение | {"#cWH"}№%d", bank_info [ playerid ] [ bi_id ] [ deposit_id ] ) ;
			show_dialog ( playerid, d_deposit_delete, DIALOG_STYLE_INPUT, line_string, "{"#cGRDialog"}* Вы действительно хотите удалить счёт?", "Принять", "Назад" ) ;
			return 1 ;
		}
		case d_bank_reset:
		{
			if ( ! response )
			{
				clear_player_listitem_values ( playerid ) ;
				show_dr_boxes ( playerid ) ;
				return 1 ;
			}
			new deposit_id = get_player_listitem_values ( playerid, listitem ) ;
			clear_player_listitem_values ( playerid ) ;

			if ( bank_info [ playerid ] [ bi_reset ] [ deposit_id ] > gettime ( ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы уже заказали перевыпуск данной карты." ) ;

			global_string [ 0 ] = EOS ;
			new _card_type [ 36 ] ;
			switch ( bank_info [ playerid ] [ bi_type ] [ deposit_id ] )
			{
	  			case 1: format ( _card_type, sizeof _card_type, "{"#cGRDialog"}Зарплатная{"#cWH"}" ) ;
		    	case 2: format ( _card_type, sizeof _card_type, "{"#cGN"}Накопительная{"#cWH"}" ) ;
			    case 3: format ( _card_type, sizeof _card_type, "{"#cYW"}Кредитная{"#cWH"}" ) ;
			}

			format ( global_string, 850, "\
				{"#cWH"}Перевыпуск карты заказывается в том случае, если Вы забыли PIN-код от своей карты.\n\
				Спустя {"#cLY"}2 дня {"#cWH"}после заказа перевыпуска карты Вам будет предоставлена\n\
				возможность ввести новый PIN-код. Отменить перевыпуск {"#cRD"}невозможно{"#cWH"}.\n\
				Во время перевыпуска доступ к карте будет заблокирован.\n\n\
				Номер карты: {"#cWV"}%d{"#cWH"}\n\
				Тип карты: {"#cOR"}%s{"#cWH"}\n\
				Баланс карты: {"#cGN"}%s"valute_title_"{"#cWH"}\n\n\
				{"#cGRDialog"}* Вы действительно хотите заказать перевыпуск карты?", bank_info [ playerid ] [ bi_id ] [ deposit_id ], _card_type, GetPlayerCashValueToSmile ( bank_info [ playerid ] [ bi_money ] [ deposit_id ] ) ) ;

			new line_string [ 78 ] ;
			format ( line_string, sizeof ( line_string ), "{"#cBHD"}Подтверждение | {"#cWH"}№%d", bank_info [ playerid ] [ bi_id ] [ deposit_id ] ) ;
			show_dialog ( playerid, d_bank_reset_enter, DIALOG_STYLE_INPUT, line_string, global_string, "Принять", "Назад" ) ;

            set_player_use_listitem ( playerid, deposit_id ) ;
			return 1 ;
		}
		case d_bank_reset_enter:
		{
		    if ( ! response )
			{
				show_dr_boxes ( playerid ) ;
				return 1 ;
			}

			new deposit_id = get_player_use_listitem ( playerid ) ;
            clear_player_use_listitem ( playerid ) ;

			new _date_reset = SetElapsedTime ( gettime ( ), 2, CONVERT_TIME_TO_DAYS ) ;
			bank_info [ playerid ] [ bi_reset ] [ deposit_id ] = _date_reset ;

			new sql_string [ 116 + 4 + 9 ] ;
			format ( sql_string, sizeof sql_string, "UPDATE `deposit_boxes` SET `db_reset` = '%d' WHERE `db_id` = '%d' LIMIT 1", _date_reset, bank_info [ playerid ] [ bi_id ] [ deposit_id ] ) ;
			mysql_tquery ( sql_connection, sql_string, "", "" ) ;
		}
		case d_bank_control_back:
		{
		    if ( ! response )
			{
				clear_player_listitem_values ( playerid ) ;
				if ( atm_used [ playerid ] > 0 ) atm_used [ playerid ] = 0, DeletePVar ( playerid, "p_biz_id" ) ;
				return 1 ;
			}

			clear_player_listitem_values ( playerid ) ;
			if ( atm_used [ playerid ] > 0 ) atm_used [ playerid ] = 0, DeletePVar ( playerid, "p_biz_id" ) ;
		}
		case d_bank_control:
		{
			if ( ! response )
			{
				clear_player_listitem_values ( playerid ) ;
				if ( atm_used [ playerid ] > 0 ) atm_used [ playerid ] = 0, DeletePVar ( playerid, "p_biz_id" ) ;
				return 1 ;
			}

			new line_string [ 78 ], deposit_id = get_player_listitem_values ( playerid, listitem ) ;
			clear_player_listitem_values ( playerid ) ;

			if ( bank_info [ playerid ] [ bi_reset ] [ deposit_id ] > gettime ( ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы заказали перевыпуск данной карты." ) ;

			format ( line_string, sizeof ( line_string ), "{"#cBHD"}Подтверждение | {"#cWH"}№%d", bank_info [ playerid ] [ bi_id ] [ deposit_id ] ) ;
			show_dialog ( playerid, d_deposit_pincode, DIALOG_STYLE_INPUT, line_string, "{"#cWH"}Введите пин-код:\n\n{"#cGRDialog"}* Если Вы забыли пин-код, то можете заказать перевыпуск карты.", "Принять", "Назад" ) ;

			set_player_use_listitem ( playerid, deposit_id ) ;
			return 1 ;
		}
		case d_deposit_pincode:
		{
			if ( ! response )
			{
				deposit_boxes ( playerid ) ;
				return 1 ;
			}

			new _pin_code = strval ( inputtext ) ;
			if ( _pin_code > 9999 || _pin_code < 1000 )
			{
				deposit_boxes ( playerid ) ;
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Неверный пин-код." ) ;
				return 1 ;
			}

			if ( _pin_code != bank_info [ playerid ] [ bi_pincode ] [ get_player_use_listitem ( playerid ) ] )
			{
				deposit_boxes ( playerid ) ;
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Неверный пин-код." ) ;
				return 1 ;
			}

			show_deposit ( playerid ) ;
			return 1 ;
		}
		case d_deposit_story:
		{
		    if ( ! response )
		    {
				clear_player_use_listitem ( playerid ) ;
		        return 1 ;
		    }

            show_deposit ( playerid ) ;
		}
		case d_row_deposit:
		{
			if ( ! response )
			{
				deposit_boxes ( playerid ) ;
				clear_player_use_listitem ( playerid ) ;
				return 1 ;
			}

			new deposit_id = get_player_use_listitem ( playerid ),
				db_money = bank_info [ playerid ] [ bi_money ] [ deposit_id ] ;
			switch ( listitem )
			{
				case 0:
				{
					new dialog_string [ 100 ] ;
					format ( dialog_string, sizeof ( dialog_string ), "{ffffff}Деньги на вашем счету: {"#cLY"}%s"valute_title"{"#cWH"}.", GetPlayerCashValue ( db_money ) ) ;
					show_dialog ( playerid, d_deposit_info, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Информация о счёте", dialog_string, "Принять", "" ) ;
				}
