}

CMD:guardclear ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 6 ) return 1 ;
	if ( sscanf ( params, "s[32]", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /guardclear [имя]" ) ;
	if ( strlen ( params [ 0 ] ) < 3 || strlen ( params [ 0 ] ) > MAX_PLAYER_NAME ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Не правильно указано имя." ) ;
	if ( admin_info [ playerid ] [ dostup ] [ 5 ] != 1 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет полномочий для просмотра информации." ) ;

 	new sql_string [ 155 + MAX_PLAYER_NAME ] ;
	format ( sql_string, sizeof sql_string, "UPDATE `users` SET `u_googleauth_status` = '0', `u_finger_status` = '0' WHERE `u_name` = '%s' LIMIT 1", params [ 0 ] ) ;
	mysql_tquery ( sql_connection, sql_string ) ;

	SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы успешно сбросили защиты на аккаунте!" ) ;
	return 1 ;
}

CMD:checkai ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 7 ) return 1 ;
	if ( sscanf ( params, "d", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /checkai [ид]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не в сети." ) ;

	CheckAndroidID ( params [ 0 ], 2 ) ;

	SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Запрос на Android ID отправлен! После успешного выполнения он будет сохранён в базу данных." ) ;
	return 1 ;
}

callback: callback_finded_twink_house ( playerid, _b_owner_inc, _house_id, _type )
{
    new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows ) return 1 ;

	new _reg_ip [ 16 ] ;
	new _last_ip [ 16 ] ;
	cache_get_field_content ( 0, "u_ip_registration", _reg_ip, sql_connection, 16 ) ;
	cache_get_field_content ( 0, "u_last_ip", _last_ip, sql_connection, 16 ) ;

	new sql_string [ 256 ] ;
  	format ( sql_string, sizeof sql_string, "SELECT `u_id` FROM `users` WHERE `u_last_date` > NOW()-INTERVAL 5 DAY AND (`u_ip_registration` = '%s' OR `u_last_ip` = '%s' OR `u_ip_registration` = '%s' OR `u_last_ip` = '%s')", _reg_ip, _last_ip, _last_ip, _reg_ip ) ;
   	mysql_tquery ( sql_connection, sql_string, "callback_finded_twink_home", "iiii", playerid, _b_owner_inc, _house_id, _type ) ;
	return 1 ;
}

callback: callback_finded_twink_home ( playerid, _b_owner_inc, _house_id, _type )
{
    new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows ) return 1 ;

	for ( new i = 0 ; i < rows ; i ++ )
	{
	    new _u_id = cache_get_field_content_int ( i, "u_id", sql_connection ) ;

	    for ( new b = 0 ; b < house_count ; b ++ )
	    {
	        if ( _b_owner_inc == _u_id ) continue ;
	        if ( h_info [ b ] [ h_owner ] != _u_id ) continue ;

	        if ( _type == 1 )
	        {
				new scm_string [ 53 + 9 ] ;
				format ( scm_string, sizeof scm_string, "Номер аккаунта %d | Проверка от номера аккаунта %d", _u_id, _b_owner_inc ) ;
				SendClientMessage ( playerid, col_white, scm_string ) ;
			}
			else if ( _type == 2 )
			{
			    sell_property ( h_info [ b ] [ h_owner ], 1, b + 1, 1, true ) ;
			}
		}
	}

	if ( _house_id + 1 < house_count )
	{
		for ( new i = _house_id + 1 ; i < house_count ; i ++ )
		{
			if ( h_info [ i ] [ h_owner ] == -1 ) continue ;

			new sql_string [ 83 + 9 ] ;
		 	format ( sql_string, sizeof sql_string, "SELECT `u_ip_registration`, `u_last_ip` FROM `users` WHERE `u_id` = '%d' LIMIT 1", h_info [ i ] [ h_owner ] ) ;
		   	mysql_tquery ( sql_connection, sql_string, "callback_finded_twink_house", "iiii", playerid, h_info [ i ] [ h_owner ], i, 2 ) ;
		   	break ;
		}
	}
	return 1 ;
}

callback: callback_finded_twink ( playerid, _b_owner_inc, _type )
{
    new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows ) return 1 ;

	new _reg_ip [ 16 ] ;
	new _last_ip [ 16 ] ;
	cache_get_field_content ( 0, "u_ip_registration", _reg_ip, sql_connection, 16 ) ;
	cache_get_field_content ( 0, "u_last_ip", _last_ip, sql_connection, 16 ) ;

	new sql_string [ 256 ] ;
  	format ( sql_string, sizeof sql_string, "SELECT `u_id` FROM `users` WHERE `u_last_date` > NOW()-INTERVAL 5 DAY AND (`u_ip_registration` = '%s' OR `u_last_ip` = '%s' OR `u_ip_registration` = '%s' OR `u_last_ip` = '%s')", _reg_ip, _last_ip, _last_ip, _reg_ip ) ;
   	mysql_tquery ( sql_connection, sql_string, "callback_finded_twink_biz", "iii", playerid, _b_owner_inc, _type ) ;
	return 1 ;
}

callback: callback_finded_twink_biz ( playerid, _b_owner_inc, _type )
{
    new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows ) return 1 ;

	for ( new i = 0 ; i < rows ; i ++ )
	{
	    new _u_id = cache_get_field_content_int ( i, "u_id", sql_connection ) ;

	    for ( new b = 0 ; b < b_count ; b ++ )
	    {
	        if ( _b_owner_inc == _u_id ) continue ;
	        if ( b_info [ b ] [ b_owner_inc ] != _u_id ) continue ;

	        if ( _type == 1 )
	        {
				new scm_string [ 53 + 9 ] ;
				format ( scm_string, sizeof scm_string, "Номер аккаунта %d | Проверка от номера аккаунта %d", _u_id, _b_owner_inc ) ;
				SendClientMessage ( playerid, col_white, scm_string ) ;
			}
			else if ( _type == 2 )
			{
			    sell_property ( b_info [ b ] [ b_owner_inc ], 1, b, 2, true ) ;
			}
		}
	}
	return 1 ;
}

callback: callback_finded_twink_cellar ( playerid, _b_owner_inc, _cl_id, _type )
{
    new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows ) return 1 ;

	new _reg_ip [ 16 ] ;
	new _last_ip [ 16 ] ;
	cache_get_field_content ( 0, "u_ip_registration", _reg_ip, sql_connection, 16 ) ;
	cache_get_field_content ( 0, "u_last_ip", _last_ip, sql_connection, 16 ) ;

	new sql_string [ 256 ] ;
  	format ( sql_string, sizeof sql_string, "SELECT `u_id` FROM `users` WHERE `u_last_date` > NOW()-INTERVAL 5 DAY AND (`u_ip_registration` = '%s' OR `u_last_ip` = '%s' OR `u_ip_registration` = '%s' OR `u_last_ip` = '%s')", _reg_ip, _last_ip, _last_ip, _reg_ip ) ;
   	mysql_tquery ( sql_connection, sql_string, "callback_finded_twink_cellars", "iiii", playerid, _b_owner_inc, _cl_id, _type ) ;
	return 1 ;
}

callback: callback_finded_twink_cellars ( playerid, _b_owner_inc, _cl_id, _type )
{
    new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows ) return 1 ;

	for ( new i = 0 ; i < rows ; i ++ )
	{
	    new _u_id = cache_get_field_content_int ( i, "u_id", sql_connection ) ;

	    for ( new b = 0 ; b < cellar_count ; b ++ )
	    {
	        if ( _b_owner_inc == _u_id ) continue ;
	        if ( cellar_info [ b ] [ cl_owner ] != _u_id ) continue ;

	        if ( _type == 1 )
	        {
				new scm_string [ 53 + 9 ] ;
				format ( scm_string, sizeof scm_string, "Номер аккаунта %d | Проверка от номера аккаунта %d", _u_id, _b_owner_inc ) ;
				SendClientMessage ( playerid, col_white, scm_string ) ;
			}
			else if ( _type == 2 )
			{
			    sell_property ( cellar_info [ b ] [ cl_owner ], 1, b + 1, 3, true ) ;
			}
		}
	}

	if ( _cl_id + 1 < cellar_count )
	{
		for ( new i = _cl_id + 1 ; i < cellar_count ; i ++ )
		{
			if ( cellar_info [ i ] [ cl_owner ] == -1 ) continue ;

			new sql_string [ 83 + 9 ] ;
		 	format ( sql_string, sizeof sql_string, "SELECT `u_ip_registration`, `u_last_ip` FROM `users` WHERE `u_id` = '%d' LIMIT 1", cellar_info [ i ] [ cl_owner ] ) ;
		   	mysql_tquery ( sql_connection, sql_string, "callback_finded_twink_cellar", "iiii", playerid, cellar_info [ i ] [ cl_owner ], i, 2 ) ;
		   	break ;
		}
	}
	return 1 ;
}

/*

    ALTER TABLE `users` ADD `u_finger_status` INT(3) NOT NULL DEFAULT '0' AFTER `u_perk_lvl`, ADD `u_finger` VARCHAR(128) CHARACTER SET utf8 COLLATE utf8_general_ci NOT NULL AFTER `u_finger_status`;
    ALTER TABLE `users` CHANGE `u_finger` `u_finger` VARCHAR(128) CHARACTER SET utf8 COLLATE utf8_general_ci NOT NULL DEFAULT 'null';

*/

CMD:myfinger ( playerid, params [ ] )
{
	#pragma unused params
	if ( admin_info [ playerid ] [ admin ] < 8 ) return 1 ;

	if ( p_info [ playerid ] [ finger ] [ 0 ] == EOS )
		return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Отпечаток устройства ещё не сохранён (u_finger пуст). Сначала зайдите обычным способом один раз, чтобы отпечаток сохранился." ) ;

	p_info [ playerid ] [ finger_status ] = 2 ;

	new sql_string [ 64 ] ;
	format ( sql_string, sizeof sql_string, "UPDATE `users` SET `u_finger_status` = '2' WHERE `u_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
	mysql_tquery ( sql_connection, sql_string ) ;

	format ( sql_string, sizeof sql_string, "{"#cGInfo"}* {"#cWH"}u_finger: %s", p_info [ playerid ] [ finger ] ) ;
	SendClientMessage ( playerid, col_white, sql_string ) ;
	SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Отпечаток устройства помечен как доверенный (u_finger_status = 2). Google Auth при входе больше не потребуется." ) ;
	return 1 ;
}

stock show_packet_finger ( playerid, _fingerId, _fingerResult, _fingerText [ ] )
{
	#if defined debug_mode
		printf ( "[show_packet_finger] Name: %s, playerid: %d, fingerId: %d, fingerResult: %d, _fingerText: %s", p_info [ playerid ] [ name ], playerid, _fingerId, _fingerResult, _fingerText ) ;
	#endif
	if ( _fingerId == 0 )
	{
	    if ( _fingerResult == 1 || _fingerResult == 2 )
	    {
		    new sql_string [ 156 ] ;
		    format ( sql_string, sizeof sql_string, "UPDATE `users` SET `u_finger` = '%s', `u_finger_status` = '1' WHERE `u_id` = '%d' LIMIT 1", _fingerText, p_info [ playerid ] [ id ] ) ;
		    mysql_tquery ( sql_connection, sql_string ) ;

		    format ( p_info [ playerid ] [ finger ], 100, "%s", _fingerText ) ;
		    p_info [ playerid ] [ finger_status ] = 1 ;
		}
		else if ( _fingerResult == 3 )
		{
	        if ( GetString ( p_info [ playerid ] [ finger ], _fingerText ) )
	        {
	            p_info [ playerid ] [ finger_status ] = 2 ;

	            new sql_string [ 64 ] ;
	            format ( sql_string, sizeof sql_string, "UPDATE `users` SET `u_finger_status` = '2' WHERE `u_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
	            mysql_tquery ( sql_connection, sql_string ) ;
			}
			else
			{
			    p_info [ playerid ] [ finger_status ] = 1 ;

			    new sql_string [ 64 ] ;
			    format ( sql_string, sizeof sql_string, "UPDATE `users` SET `u_finger_status` = '1' WHERE `u_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
			    mysql_tquery ( sql_connection, sql_string ) ;
			}
		}
	}
	return 1 ;
}

stock GetRandomWeightedNumber ( const Float: numbersWeight [ ], arrayLen = sizeof numbersWeight )
{
    new idx = 0, Float: randomValue = RandomFloat ( 1.0 ) ; // Рандомим значение от 0 до 1

	for ( new i = 0, Float: weightsSum ; i < arrayLen ; i ++ )
	{
		weightsSum += numbersWeight [ i ] ;

		if ( weightsSum >= randomValue )
        {
			idx = i ;
            break ;
		}
	}
    return idx ;
}

stock all_clear_property ( )
{
	for ( new i = 0 ; i < house_count ; i ++ )
	{
	    new s_house_id = i + 1 ;

	    new _pl_id ;
		sscanf ( h_info [ s_house_id - 1 ] [ h_owner_name ], "u", _pl_id ) ;

		if ( IsPlayerConnected ( _pl_id ) )
		{
		    sell_houses ( s_house_id - 1, -1, false, false ) ;

			new _sql_string [ 100 ] ;
            h_info [ s_house_id - 1 ] [ h_meeting ] = SetElapsedTime ( gettime ( ), random ( 24 ) + 1, CONVERT_TIME_TO_HOURS ) ;
			format ( _sql_string, sizeof( _sql_string ), "UPDATE `houses` SET `h_meeting` = '%d' WHERE `h_id` = '%d' LIMIT 1", h_info [ s_house_id - 1 ] [ h_meeting ], s_house_id ) ;
			mysql_tquery ( sql_connection, _sql_string ) ;

	        if ( h_info [ s_house_id - 1 ] [ h_podezd ] != -1 ) update_podezd ( h_info [ s_house_id - 1 ] [ h_podezd ] ) ;

			p_info [ _pl_id ] [ house ] = -1 ;
			Iter_Remove(player_houses[_pl_id], h_info [ s_house_id - 1 ] [ h_id ]);

			if ( h_info [ s_house_id - 1 ] [ h_price_ticket ] > 0 )
			{
				give_inventory (
					_pl_id,
					ITEM_FAMILY_TALON,
					h_info [ s_house_id - 1 ] [ h_price_ticket ],
					0,
					"",
					"",
					NUMBERPLATE_TYPE_NONE,
					0,
					-1
				) ;
			}
			insert_debtor_message ( "Вайп имущества", "Ваш дом был продан.\nМЫ СДЕЛАЛИ ПОЛНЫЙ ВАЙП ИМУЩЕСТВА!\nЕсли Ваше имущество было за ДОНАТ или "family_title",\nто компенсация зачислена Вам на почту (/gps - Бизнесы)", p_info [ _pl_id ] [ id ] ) ;
		}
		else
		{
			if ( h_info [ s_house_id - 1 ] [ h_price_ticket ] > 0 )
			{
				insertMarketPlace ( h_info [ s_house_id - 1 ] [ h_owner ], 252, h_info [ s_house_id - 1 ] [ h_price_ticket ], NUMBERPLATE_TYPE_NONE, 0 ) ;
			}
			insert_debtor_message ( "Вайп имущества", "Ваш дом был продан.\nМЫ СДЕЛАЛИ ПОЛНЫЙ ВАЙП ИМУЩЕСТВА!\nЕсли Ваше имущество было за ДОНАТ или "family_title",\nто компенсация зачислена Вам на почту (/gps - Бизнесы)", h_info [ s_house_id - 1 ] [ h_owner ] ) ;

			sell_houses ( s_house_id - 1, -1, false, false ) ;

            new _sql_string [ 100 ] ;
			h_info [ s_house_id - 1 ] [ h_meeting ] = SetElapsedTime ( gettime ( ), random ( 24 ) + 1, CONVERT_TIME_TO_HOURS ) ;
			format ( _sql_string, sizeof( _sql_string ), "UPDATE `houses` SET `h_meeting` = '%d' WHERE `h_id` = '%d' LIMIT 1", h_info [ s_house_id - 1 ] [ h_meeting ], s_house_id ) ;
			mysql_tquery ( sql_connection, _sql_string ) ;

	        if ( h_info [ s_house_id - 1 ] [ h_podezd ] != -1 ) update_podezd ( h_info [ s_house_id - 1 ] [ h_podezd ] ) ;
		}

		new Float: pos [ 4 ] ;
  		get_gz_pos ( h_info [ s_house_id - 1 ] [ h_pos ] [ 0 ], h_info [ s_house_id - 1 ] [ h_pos ] [ 1 ], 50.0, pos [ 0 ], pos [ 1 ], pos [ 2 ], pos [ 3 ] ) ;
		h_info [ s_house_id - 1 ] [ h_zz_area ] = CreateDynamicRectangle ( pos [ 0 ], pos [ 1 ], pos [ 2 ], pos [ 3 ], -1, -1, -1 ) ;
		area_info [ h_info [ s_house_id - 1 ] [ h_zz_area ] ] [ a_type ] = area_type_sellstatus ;
		area_info [ h_info [ s_house_id - 1 ] [ h_zz_area ] ] [ a_item ] = h_info [ s_house_id - 1 ] [ h_id ] ;
	}

	for ( new i = 0 ; i < b_count ; i ++ )
	{
	    new business_id = i ;

        new _pl_id ;
		sscanf ( b_info [ business_id ] [ b_owner_name ], "u", _pl_id ) ;

		if ( IsPlayerConnected ( _pl_id ) )
		{
		    sell_businesses ( business_id, -1, false, false ) ;

			new _sql_string [ 100 ] ;
            b_info [ business_id ] [ b_meeting ] = SetElapsedTime ( gettime ( ), random ( 24 ) + 1, CONVERT_TIME_TO_HOURS ) ;
			format ( _sql_string, sizeof( _sql_string ), "UPDATE `businesses` SET `b_meeting` = '%d' WHERE `b_id` = '%d' LIMIT 1", b_info [ business_id ] [ b_meeting ], b_info [ business_id ] [ b_id ]  ) ;
			mysql_tquery ( sql_connection, _sql_string ) ;

			p_info [ _pl_id ] [ business ] = -1 ;
			Iter_Remove(player_business[_pl_id], b_info [ business_id ][ b_id ]);

			p_info [ _pl_id ] [ business_rang ] = 0 ;
			update_int_sql ( _pl_id, "u_business_rang", 0 ) ;

			if ( b_info [ business_id ] [ b_donate_price ] > 0 )
			{
				give_player_donate ( _pl_id, b_info [ business_id ] [ b_donate_price ], 2 ) ;
			}
			insert_debtor_message ( "Вайп имущества", "Ваш дом был продан.\nМЫ СДЕЛАЛИ ПОЛНЫЙ ВАЙП ИМУЩЕСТВА!\nЕсли Ваше имущество было за ДОНАТ или "family_title",\nто компенсация зачислена Вам на почту (/gps - Бизнесы)", p_info [ _pl_id ] [ id ] ) ;
		}
		else
		{
			if ( b_info [ business_id ] [ b_donate_price ] > 0 )
			{
				update_donate_sql ( b_info [ business_id ] [ b_owner_inc ], b_info [ business_id ] [ b_donate_price ], true ) ;
			}
			insert_debtor_message ( "Вайп имущества", "Ваш бизнес был продан.\nМЫ СДЕЛАЛИ ПОЛНЫЙ ВАЙП ИМУЩЕСТВА!\nЕсли Ваше имущество было за ДОНАТ или "family_title",\nто компенсация зачислена Вам на почту (/gps - Бизнесы)", b_info [ business_id ] [ b_owner_inc ] ) ;

            sell_businesses ( business_id, -1, false, false ) ;

			new _sql_string [ 100 ] ;
			b_info [ business_id ] [ b_meeting ] = SetElapsedTime ( gettime ( ), random ( 24 ) + 1, CONVERT_TIME_TO_HOURS ) ;
			format ( _sql_string, sizeof( _sql_string ), "UPDATE `businesses` SET `b_meeting` = '%d' WHERE `b_id` = '%d' LIMIT 1", b_info [ business_id ] [ b_meeting ], b_info [ business_id ] [ b_id ]  ) ;
			mysql_tquery ( sql_connection, _sql_string ) ;
		}

		new Float: pos [ 4 ] ;
  		get_gz_pos ( b_info [ business_id ] [ b_position ] [ 0 ], b_info [ business_id ] [ b_position ] [ 1 ], 50.0, pos [ 0 ], pos [ 1 ], pos [ 2 ], pos [ 3 ] ) ;
		b_info [ business_id ] [ b_zz_area ] = CreateDynamicRectangle ( pos [ 0 ], pos [ 1 ], pos [ 2 ], pos [ 3 ], -1, -1, -1 ) ;
		area_info [ b_info [ business_id ] [ b_zz_area ] ] [ a_type ] = area_type_sellstatus ;
	}
	return 1 ;
}

CMD:testgt ( playerid )
{
	if ( admin_info [ playerid ] [ admin ] < 8 ) return 1 ;

    new s_year, s_month, s_day, s_hour, s_minute, s_second ;
	timestamp_to_date ( gettime ( ), s_year, s_month, s_day, s_hour, s_minute, s_second ) ;

	global_string [ 0 ] = EOS ;
	format ( global_string, 144, "Станет доступен %02d.%02d.%d в %02d:%02d:%02d", s_day, s_month, s_year, s_hour, s_minute, s_second ) ;
	SendClientMessage ( playerid, col_white, global_string ) ;
	return 1 ;
}

