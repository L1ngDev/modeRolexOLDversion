	        f_info [ f ] [ f_tr_health ] = _value ;

		    new sql_string [ 83 + 4 + 9 ] ;
			mysql_format(sql_connection, sql_string, sizeof sql_string, "UPDATE `fractions_training` SET `f_tr_health` = '%d' WHERE `f_id` = '%d' LIMIT 1", f_info [ f ] [ f_tr_health ], f + 1 );
			mysql_tquery(sql_connection, sql_string);

			show_training_menu ( playerid ) ;
