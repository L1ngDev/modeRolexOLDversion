				        set_pos ( playerid, duels_pos [ 0 ] [ 0 ], duels_pos [ 0 ] [ 1 ], duels_pos [ 0 ] [ 2 ], duels_pos [ 0 ] [ 3 ], duels_interior [ 0 ], _o_id + 1000 ) ;
				        set_pos ( _o_id, duels_pos [ 1 ] [ 0 ], duels_pos [ 1 ] [ 1 ], duels_pos [ 1 ] [ 2 ], duels_pos [ 1 ] [ 3 ], duels_interior [ 0 ], _o_id + 1000 ) ;
