CMD:createbusiness ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 8 )return 1 ;
	if ( ! IsFounder ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}К сожалению, Вам данная функция не доступна." ) ;

	if ( sscanf ( params, "ddds[32]", params [ 0 ], params [ 1 ], params [ 2 ], params [ 3 ] ) )
	{
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /createbusiness [тип] [цена] [инт (/intlist)] [название]" ) ;
		return 1 ;
	}
	GetPlayerPos ( playerid, b_info [ b_count ] [ b_position ] [ 0 ], b_info [ b_count ] [ b_position ] [ 1 ], b_info [ b_count ] [ b_position ] [ 2 ] ) ;
	GetPlayerFacingAngle ( playerid, b_info [ b_count ] [ b_position ] [ 3 ] ) ;

	b_info [ b_count ] [ b_id ] = b_count + 1 ;
	strcat ( b_info [ b_count ] [ b_owner_name ], "Собственность штата" ) ;
	b_info [ b_count ] [ b_owner_inc ] = -1 ;
	b_info [ b_count ] [ b_price ] = params [ 1 ] ;

	b_info [ b_count ] [ b_type ] = params [ 0 ] ;

	b_info [ b_count ] [ b_maxproduct ] = 15000 ;
	b_info [ b_count ] [ b_mafia ] = 25 ;
	format ( b_info [ b_count ] [ b_name ], 32, "%s", params [ 3 ] ) ;

	new bis_int = params [ 2 ] - 1 ;

	if ( b_info [ b_count ] [ b_type ] == bizz_type_hotel )
	{
		foreach(new b: business_types[bizz_type_hotel])
	    {
	        new bool: _find_room = false ;
	        for ( new i = 0 ; i < hotel_count ; i ++ )
	    	{
				if ( b_info [ b - 1 ] [ b_id ] != hotel_info [ i ] [ h_biz ] ) continue ;

				_find_room = true ;
				break ;
			}

			if ( _find_room == false )
			{
		        for ( new q = 1 ; q < 4 ; q ++ )
				{
					for ( new z = 0 ; z < MAX_ROOMS ; z ++ )
					{
					    new query_string [ 256 ], _desc_id = ( z + 1 ) + ( ( q - 1 ) * MAX_ROOMS ) ;
						mysql_format ( sql_connection, query_string, sizeof ( query_string  ),"INSERT INTO `hotels` (`h_vw`,`h_pos_x`,`h_pos_y`,`h_pos_z`,`h_pos_c`,`h_desc_id`,`h_biz`) VALUES ('%d','%f','%f','%f','%f','%d','%d')",
						b_info [ b_count ] [ b_id ] + q, rooms_position [ z ] [ 0 ], rooms_position [ z ] [ 1 ], rooms_position [ z ] [ 2 ], rooms_position [ z ] [ 3 ], _desc_id, b_info [ b_count ] [ b_id ] ) ;
						mysql_tquery ( sql_connection, query_string, "", "" ) ;

						hotel_count ++ ;
					}
				}
			}
	    }
   }

	new query_string [ 236 ] ;
	mysql_format ( sql_connection, query_string, sizeof ( query_string  ),"INSERT INTO `businesses` (`b_id`,`b_pos_x`,`b_pos_y`,`b_pos_z`,`b_pos_c`,`b_price`,`b_type`,`b_int`,`b_name`,`b_mafia`) VALUES ('%d','%f','%f','%f','%f','%d','%d','%d','%e','%d')",
	b_info [ b_count ] [ b_id ], b_info [ b_count ] [ b_position ] [ 0 ], b_info [ b_count ] [ b_position ] [ 1 ], b_info [ b_count ] [ b_position ] [ 2 ], b_info [ b_count ] [ b_position ] [ 3 ],
	params [ 1 ], b_info [ b_count ] [ b_type ], bis_int + 1, b_info [ b_count ] [ b_name ], b_info [ b_count ] [ b_mafia ] ) ;
	mysql_tquery ( sql_connection, query_string, "", "" ) ;

	format ( query_string, sizeof query_string, "INSERT INTO `businesses_price` (`b_id`) VALUES ('%d')", b_info [ b_count ] [ b_id ] ) ;
	mysql_query ( sql_connection, query_string, false ) ;

	b_count ++ ;

	mysql_tquery ( sql_connection, !"SELECT * FROM `businesses` ORDER BY `businesses`.`b_id` ASC", "businesses_loading" ) ;
	return 1 ;
}

CMD:close ( playerid )
{
    if ( rieltore_opened [ playerid ] )
	{
		toggle_controlable ( playerid, true ) ;
        TogglePlayerSpectating ( playerid, false ) ;

        if ( p_t_info [ playerid ] [ camera_timer ] != -1 )
		{
           	KillTimer ( p_t_info [ playerid ] [ camera_timer ] ) ;
			p_t_info [ playerid ] [ camera_timer ] = -1 ;
		}
		return 1 ;
	}
	return 1 ;
}

CMD:buygas ( playerid )
{
	if ( Iter_Count(player_business[playerid]) >= p_info [ playerid ] [ max_biz ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас уже есть бизнес." ) ;
	if ( p_info [ playerid ] [ b_worker ] != -1 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы являетесь работником бизнеса. Используйте /quitjob." ) ;
	new bool:_gas = false ;
	foreach(new b: business_types[bizz_type_gas])
	{
		if ( b_info [ b - 1 ] [ b_type ] != bizz_type_gas )continue ;
		if ( b_info [ b - 1 ] [ b_owner_inc ] != -1 )continue ;
		if ( ! IsPlayerInRangeOfPoint ( playerid, 5, b_info [ b - 1 ] [ b_position ] [ 0 ], b_info [ b - 1 ] [ b_position ] [ 1 ], b_info [ b - 1 ] [ b_position ] [ 2 ] ) ) continue ;
		_gas = true ;

		if ( b_info [ b - 1 ] [ b_auction_status ] == 1 )
		{
/*		    new line_string [ 128 ], s_year, s_month, s_day, s_hour, s_minute, s_second ;
			timestamp_to_date ( b_info [ b - 1 ] [ b_auction_date ] + CONVERT_TIME_TO_MOSCOW, s_year, s_month, s_day, s_hour, s_minute, s_second ) ;

		    global_string [ 0 ] = EOS ;
		    format ( line_string, sizeof line_string, "{"#cWH"}Недвижимость находится на аукционе до {"#cLY"}%02d.%02d.%d в %02d:00:00{"#cWH"}.\n", s_day, s_month, s_year, s_hour + 1 ) ;
		    strcat ( global_string, line_string ) ;
		    format ( line_string, sizeof line_string, "{"#cWH"}Последняя ставка составляет {"#cGN"}%s"valute_title"{"#cWH"}.\n", GetPlayerCashValue ( b_info [ b - 1 ] [ b_auction_bet ] ) ) ;
		    strcat ( global_string, line_string ) ;
		    if ( b_info [ b - 1 ] [ b_auction_player ] == p_info [ playerid ] [ id ] )
		    {
		    	strcat ( global_string, "Ваша ставка за недвижимость {"#cLY"}не была {"#cWH"}перебита.\n" ) ;
		        format ( line_string, sizeof line_string, "{"#cWH"}Поставив {"#cGN"}%s"valute_title_"{"#cWH"} Вы автоматически выиграете аукцион.\n\n", GetPlayerCashValue ( max_money ) ) ;
		    	strcat ( global_string, line_string ) ;
		    }
		    else
			{
		    	strcat ( global_string, "Вы можете перебить ставку и ожидать окончания торгов.\n" ) ;
		    	strcat ( global_string, "Если никто не перебьёт Вашу ставку, то недвижимость станет Вашей.\n" ) ;
		        format ( line_string, sizeof line_string, "{"#cWH"}Поставив {"#cGN"}%s"valute_title_"{"#cWH"} Вы автоматически выиграете аукцион.\n\n", GetPlayerCashValue ( max_money ) ) ;
			   	strcat ( global_string, line_string ) ;
			}
	   		strcat ( global_string, "{"#cGRDialog"}* Отменить ставку нельзя!\n" ) ;
		    strcat ( global_string, "{"#cGRDialog"}* Введите сумму, которую хотите поставить за недвижимость:" ) ;
		    show_dialog ( playerid, d_business_auction, DIALOG_STYLE_INPUT, "{"#cBHD"}Аукцион", global_string, "Поставить", "Закрыть" ) ;
*/
			SetPVarInt ( playerid, "p_biz_id", b ) ;
		    return 1 ;
		}

		SetPVarInt ( playerid, "p_biz_id", b ) ;
		new dialog_string [ 256 ], line_string [ 70 + 16 ], business_status [ 19 + 1 ] = "{"#cRD"}Закрыт", _str_price [ 32 ] ;
		if ( ! b_info [ b - 1 ] [ b_close ] ) business_status = "{"#cGN"}Открыт" ;
		if ( b_info [ b - 1 ] [ b_donate_price ] ) format ( _str_price, sizeof _str_price, "%s "donate_title"", GetPlayerCashValueToSmile ( b_info [ b - 1 ] [ b_donate_price ] ) ) ;
		else format ( _str_price, sizeof _str_price, "%s"valute_title_"", GetPlayerCashValueToSmile ( b_info [ b - 1 ] [ b_price ] * for_tax [ 1 ] ) ) ;
		format ( dialog_string, sizeof ( dialog_string ), "{"#cBL"}Бизнес продаётся:\n\n{"#cGRDialog"}Название:{"#cWH"} %s\n{"#cGRDialog"}Контроль:{"#cWH"} %s\n{"#cGRDialog"}Цена:{"#cWH"} %s\n{"#cGRDialog"}Состояние: %s",
		b_info [ b - 1 ] [ b_name ], f_info [ b_info [ b - 1 ] [ b_mafia ] - 1 ] [ f_name ], _str_price, business_status ) ;
        if ( b_info [ b - 1 ] [ b_meeting ] > gettime ( ) )
		{
		    new s_year, s_month, s_day, s_hour, s_minute, s_second ;
			timestamp_to_date ( b_info [ b - 1 ] [ b_meeting ] + CONVERT_TIME_TO_MOSCOW, s_year, s_month, s_day, s_hour, s_minute, s_second ) ;

			strcat ( dialog_string, "\n\n{"#cRD"}* Бизнес опечатан" ) ;
			format ( line_string, sizeof line_string, "\n{"#cRD"}* Станет доступен %02d.%02d.%d в %02d:%02d:%02d", s_day, s_month, s_year, s_hour, s_minute, s_second ) ;
			strcat ( dialog_string, line_string ) ;
		}
		show_dialog ( playerid, d_b_buy, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Информация о АЗС", dialog_string, "Купить", "Закрыть" ) ;
		break ;
	}
	if ( _gas == false )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не находитесь возле заправочной станции, которую можно купить." ) ;
	return 1 ;
}

