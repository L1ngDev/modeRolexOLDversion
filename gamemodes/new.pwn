					pickup_bizz_exit [ bis_int ] = CreateDynamicPickup ( 1318, 23, b_interior [ bis_int ] [ i_position ] [ 0 ], b_interior [ bis_int ] [ i_position ] [ 1 ], b_interior [ bis_int ] [ i_position ] [ 2 ], -1, -1 ) ;
					pick_info [ pickup_bizz_exit [ bis_int ] ] [ pick_type ] = pick_type_bexit ;

					CreateDynamic3DTextLabel ( "** Выход **", col_header_3d, b_interior [ bis_int ] [ i_position ] [ 0 ], b_interior [ bis_int ] [ i_position ] [ 1 ], b_interior [ bis_int ] [ i_position ] [ 2 ] + 0.5, 10.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, -1, -1 ) ;
				}

				new i = bank_door_id ;

				#if defined SAMP
			    robbery_door [ i ] = CreateDynamicObject(5422, robbery_doors [ i ] [ 0 ], robbery_doors [ i ] [ 1 ], robbery_doors [ i ] [ 2 ], robbery_doors [ i ] [ 3 ], robbery_doors [ i ] [ 4 ], robbery_doors [ i ] [ 5 ], b_info [ t ] [ b_id ] + 1000, 1, -1, 300.00, 300.00);
		        SetDynamicObjectMaterial(robbery_door [ i ], 0, 18027, "cj_barb2", "interiordoor1_256", 0xFFFFFFFFFFFFFFFF);
				#endif

				#if defined Computer
		        CreateDynamic3DTextLabel("** Дверь в хранилище **\n{"#cGR3D"}Нажмите {"#cWH3D"}H{"#cGR3D"} для взаимодействия", col_header_3d, robbery_doors [ i ] [ 0 ], robbery_doors [ i ] [ 1 ], robbery_doors [ i ] [ 2 ], 5.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, b_info [ t ] [ b_id ] + 1000, 1 );
		        #else
		        CreateDynamic3DTextLabel("** Дверь в хранилище **", col_header_3d, robbery_doors [ i ] [ 0 ], robbery_doors [ i ] [ 1 ], robbery_doors [ i ] [ 2 ], 5.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, b_info [ t ] [ b_id ] + 1000, 1 );
		        #endif

                bank_world [ i ] = b_info [ t ] [ b_id ] + 1000 ;
                bank_integr_id [ i ] = b_info [ t ] [ b_id ] ;

                bank_door_id ++ ;

                b_info [ t ] [ b_gas_text ] = CreateDynamic3DTextLabel ( "** Аренда транспорта **", col_header_3d, b_info [ t ] [ b_procurement ] [ 0 ], b_info [ t ] [ b_procurement ] [ 1 ], b_info [ t ] [ b_procurement ] [ 2 ] + 1.0, 3.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, -1, 0, 0 );
                b_info [ t ] [ b_pickup_gas ] = CreateDynamicPickup ( 1239, 23, b_info [ t ] [ b_procurement ] [ 0 ], b_info [ t ] [ b_procurement ] [ 1 ], b_info [ t ] [ b_procurement ] [ 2 ], 0, 0 ) ;
				pick_info [ b_info [ t ] [ b_pickup_gas ] ] [ pick_type ] = pick_type_bizcar ;
        		pick_info [ b_info [ t ] [ b_pickup_gas ] ] [ pick_item ] = b_info [ t ] [ b_id ] ;
			}
			else if ( b_info [ t ] [ b_type ] == bizz_type_food )
			{
			    create_blabel ( t ) ;

			    b_info [ t ] [ b_int ] -- ;
			    b_info [ t ] [ b_pickup_gas ] = CreateDynamicPickup ( 19094, 23, b_info [ t ] [ b_procurement ] [ 0 ], b_info [ t ] [ b_procurement ] [ 1 ], b_info [ t ] [ b_procurement ] [ 2 ], 0, 0 ) ;
                b_info [ t ] [ b_area_gas ] = CreateDynamicSphere ( b_info [ t ] [ b_procurement ] [ 0 ], b_info [ t ] [ b_procurement ] [ 1 ], b_info [ t ] [ b_procurement ] [ 2 ], 2.0, -1, -1, -1 ) ;
                area_info [ b_info [ t ] [ b_area_gas ] ] [ a_type ] = area_type_businesses_food ;
				area_info [ b_info [ t ] [ b_area_gas ] ] [ a_item ] = b_info [ t ] [ b_id ] ;
			}
			else if ( b_info [ t ] [ b_type ] == bizz_type_rentcar )
			{
				create_blabel ( t ) ;

				b_info [ t ] [ b_gas_text ] = CreateDynamic3DTextLabel ( "** Аренда транспорта **", col_header_3d, b_info [ t ] [ b_procurement ] [ 0 ], b_info [ t ] [ b_procurement ] [ 1 ], b_info [ t ] [ b_procurement ] [ 2 ] + 1.0, 3.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, -1, 0, 0 );
				b_info [ t ] [ b_pickup_gas ] = CreateDynamicPickup ( 1239, 23, b_info [ t ] [ b_procurement ] [ 0 ], b_info [ t ] [ b_procurement ] [ 1 ], b_info [ t ] [ b_procurement ] [ 2 ], 0, 0 ) ;
				pick_info [ b_info [ t ] [ b_pickup_gas ] ] [ pick_type ] = pick_type_bizcar ;
        		pick_info [ b_info [ t ] [ b_pickup_gas ] ] [ pick_item ] = b_info [ t ] [ b_id ] ;
			}
			else if ( b_info [ t ] [ b_type ] == bizz_type_trucker )
			{
				create_blabel ( t ) ;

				b_info [ t ] [ b_gas_text ] = CreateDynamic3DTextLabel ( "** Транспортная компания **\n\n{"#cGR3D"}Используйте {"#cWH"}/stoprent {"#cGR3D"}для сдачи т/с", col_header_3d, b_info [ t ] [ b_procurement ] [ 0 ], b_info [ t ] [ b_procurement ] [ 1 ], b_info [ t ] [ b_procurement ] [ 2 ] + 1.0, 3.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, -1, 0, 0 );
				b_info [ t ] [ b_pickup_gas ] = CreateDynamicPickup ( 1239, 23, b_info [ t ] [ b_procurement ] [ 0 ], b_info [ t ] [ b_procurement ] [ 1 ], b_info [ t ] [ b_procurement ] [ 2 ], 0, 0 ) ;
				pick_info [ b_info [ t ] [ b_pickup_gas ] ] [ pick_type ] = pick_type_bizcar ;
        		pick_info [ b_info [ t ] [ b_pickup_gas ] ] [ pick_item ] = b_info [ t ] [ b_id ] ;

                b_info [ t ] [ b_pickup_repair ] = CreateDynamicPickup ( 3096, 23, b_info [ t ] [ b_repair ] [ 0 ], b_info [ t ] [ b_repair ] [ 1 ], b_info [ t ] [ b_repair ] [ 2 ], 0, 0 ) ;
				b_info [ t ] [ b_area_repair ] = CreateDynamicSphere ( b_info [ t ] [ b_repair ] [ 0 ], b_info [ t ] [ b_repair ] [ 1 ], b_info [ t ] [ b_repair ] [ 2 ], 2.0, -1, -1, -1 ) ;
				area_info [ b_info [ t ] [ b_area_repair ] ] [ a_type ] = area_type_businesses_trucker ;
				area_info [ b_info [ t ] [ b_area_repair ] ] [ a_item ] = b_info [ t ] [ b_id ] ;
        		//b_info [ _b_id - 1 ] [ b_tr_prop_cd ] = random ( PROPOSAL_COOLDOWN ) + PROPOSAL_COOLDOWN ;
        		//b_info [ _b_id - 1 ] [ b_tr_proposal ] = -1 ;
			}
			else if ( b_info [ t ] [ b_type ] == bizz_type_fixcar )
			{
				create_blabel ( t ) ;

				b_info [ t ] [ b_pickup ] = CreateDynamicPickup ( 1318, 23, b_info [ t ] [ b_position ] [ 0 ], b_info [ t ] [ b_position ] [ 1 ], b_info [ t ] [ b_position ] [ 2 ], 0, 0 ) ;
				pick_info [ b_info [ t ] [ b_pickup ] ] [ pick_type ] = pick_type_bentrance ;
				pick_info [ b_info [ t ] [ b_pickup ] ] [ pick_item ] = b_info [ t ] [ b_id ] ;

				b_info [ t ] [ b_int ] -- ;
				new bis_int = b_info [ t ] [ b_int ] ;

				if ( create_pick_bizz_exit [ bis_int ] == false )
				{
				    create_pick_bizz_exit [ bis_int ] = true ;
					pickup_bizz_exit [ bis_int ] = CreateDynamicPickup ( 1318, 23, b_interior [ bis_int ] [ i_position ] [ 0 ], b_interior [ bis_int ] [ i_position ] [ 1 ], b_interior [ bis_int ] [ i_position ] [ 2 ], -1, -1 ) ;
					pick_info [ pickup_bizz_exit [ bis_int ] ] [ pick_type ] = pick_type_bexit ;

					CreateDynamic3DTextLabel ( "** Выход **", col_header_3d, b_interior [ bis_int ] [ i_position ] [ 0 ], b_interior [ bis_int ] [ i_position ] [ 1 ], b_interior [ bis_int ] [ i_position ] [ 2 ] + 0.5, 10.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, -1, -1 ) ;
				}
			}
			if ( b_info [ t ] [ b_int ] >= 0 && b_info [ t ] [ b_type ] != bizz_type_gas && b_info [ t ] [ b_type ] != bizz_type_rentcar &&
				b_info [ t ] [ b_type ] != bizz_type_trucker && b_info [ t ] [ b_type ] != bizz_type_fixcar &&
				b_info [ t ] [ b_type ] != bizz_type_electric && b_info [ t ] [ b_type ] != bizz_type_lake && b_info [ t ] [ b_type ] != bizz_type_reserve )
			{
				new bis_int = b_info [ t ][ b_int ] ;
				b_info [ t ] [ b_icon ] = CreateDynamicMapIcon ( b_info [ t ] [ b_position ] [ 0 ], b_info [ t ] [ b_position ] [ 1 ], b_info [ t ] [ b_position ] [ 2 ], b_interior [ bis_int ] [ i_map_icon ], 0, 0, 0, -1 ) ;
			}
			else
			{
				switch ( b_info [ t ] [ b_type ] )
				{
					case bizz_type_gas:
					{
					    #if defined CRMP
					    b_info [ t ] [ b_icon ] = CreateDynamicMapIcon ( b_info [ t ] [ b_position ] [ 0 ], b_info [ t ] [ b_position ] [ 1 ], b_info [ t ] [ b_position ] [ 2 ], radar_ZERO, 0, 0, 0, -1 ) ;
					    #endif

					    #if defined SAMP
						b_info [ t ] [ b_icon ] = CreateDynamicMapIcon ( b_info [ t ] [ b_position ] [ 0 ], b_info [ t ] [ b_position ] [ 1 ], b_info [ t ] [ b_position ] [ 2 ], 63, 0, 0, 0, -1 ) ;
						#endif
					}
					case bizz_type_rentcar: b_info [ t ] [ b_icon ] = CreateDynamicMapIcon ( b_info [ t ] [ b_position ] [ 0 ], b_info [ t ] [ b_position ] [ 1 ], b_info [ t ] [ b_position ] [ 2 ], 51, 0, 0, 0, -1 ) ;
                    case bizz_type_fixcar: b_info [ t ] [ b_icon ] = CreateDynamicMapIcon ( b_info [ t ] [ b_position ] [ 0 ], b_info [ t ] [ b_position ] [ 1 ], b_info [ t ] [ b_position ] [ 2 ], 27, 0, 0, 0, -1 ) ;
					case bizz_type_trucker: b_info [ t ] [ b_icon ] = CreateDynamicMapIcon ( b_info [ t ] [ b_position ] [ 0 ], b_info [ t ] [ b_position ] [ 1 ], b_info [ t ] [ b_position ] [ 2 ], 51, 0, 0, 0, -1 ) ;
					case bizz_type_electric: b_info [ t ] [ b_icon ] = CreateDynamicMapIcon ( b_info [ t ] [ b_position ] [ 0 ], b_info [ t ] [ b_position ] [ 1 ], b_info [ t ] [ b_position ] [ 2 ], 13, 0, 0, 0, -1 ) ;
					case bizz_type_lake: b_info [ t ] [ b_icon ] = CreateDynamicMapIcon ( b_info [ t ] [ b_position ] [ 0 ], b_info [ t ] [ b_position ] [ 1 ], b_info [ t ] [ b_position ] [ 2 ], 9, 0, 0, 0, -1 ) ;
					case bizz_type_reserve: b_info [ t ] [ b_icon ] = CreateDynamicMapIcon ( b_info [ t ] [ b_position ] [ 0 ], b_info [ t ] [ b_position ] [ 1 ], b_info [ t ] [ b_position ] [ 2 ], 18, 0, 0, 0, -1 ) ;
				}
			}
		}
	}

	#if defined m_ammunation
	    ammunation_create ( ) ;
	#endif

	#if defined m_coin
	    coin_businesses_loading ( ) ;
	#endif

	#if defined m_casino_roulette
		roulette_OnGameModeInit ( ) ;
	#endif

	#if defined m_casino_slots
		slots_OnGameModeInit ( ) ;
	#endif

	#if defined m_casino_blackjack
		bj_OnGameModeInit ( ) ;
	#endif

	for ( new i = 0 ; i < MAX_BONE ; i ++ )
	{
 		foreach(new b: business_types[bizz_type_casino])
   		{
			dice_info [ b ] [ i ] [ b_crupie ] = INVALID_PLAYER_ID ;
			for ( new idx = 0 ; idx < 5 ; idx ++ ) dice_info [ b ] [ i ] [ b_player ] [ idx ] = INVALID_PLAYER_ID ;
			dice_info [ b ] [ i ] [ b_started ] = 0 ;
			dice_info [ b ] [ i ] [ b_timer ] = -1 ;

			#if defined Computer
			dice_info [ b ] [ i ] [ b_text ] = CreateDynamic3DTextLabel("** Кости **\n\
																	{"#cGR3D"}Нажмите {"#cWH3D"}F{"#cGR3D"} для взаимодействия\n\n\
																	{"#cGR3D"}Крупье: {"#cWH3D"}-\n\n\
																	{"#cGR3D"}Игрок 1: {"#cWH3D"}-\n\
																	{"#cGR3D"}Игрок 2: {"#cWH3D"}-\n\
																	{"#cGR3D"}Игрок 3: {"#cWH3D"}-\n\
																	{"#cGR3D"}Игрок 4: {"#cWH3D"}-\n\
																	{"#cGR3D"}Игрок 5: {"#cWH3D"}-\n\n\
																	{"#cGR3D"}Ставка: {"#cGN3D"}0"valute_title_"\n\
																	{"#cGR3D"}Банк: {"#cGN3D"}0"valute_title_"\n\n\
																	{"#cGR3D"}Статус: {"#cRD"}Игра не начата", col_header_3d,
														dice_positions [ i ] [ 0 ], dice_positions [ i ] [ 1 ], dice_positions [ i ] [ 2 ] + 1.0,
														5.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, -1, b + 1000, -1 ) ;
			#else
			dice_info [ b ] [ i ] [ b_text ] = CreateDynamic3DTextLabel("** Кости **\n\
																	{"#cGR3D"}Крупье: {"#cWH3D"}-\n\n\
																	{"#cGR3D"}Игрок 1: {"#cWH3D"}-\n\
																	{"#cGR3D"}Игрок 2: {"#cWH3D"}-\n\
																	{"#cGR3D"}Игрок 3: {"#cWH3D"}-\n\
																	{"#cGR3D"}Игрок 4: {"#cWH3D"}-\n\
																	{"#cGR3D"}Игрок 5: {"#cWH3D"}-\n\n\
																	{"#cGR3D"}Ставка: {"#cGN3D"}0"valute_title_"\n\
																	{"#cGR3D"}Банк: {"#cGN3D"}0"valute_title_"\n\n\
																	{"#cGR3D"}Статус: {"#cRD"}Игра не начата", col_header_3d,
														dice_positions [ i ] [ 0 ], dice_positions [ i ] [ 1 ], dice_positions [ i ] [ 2 ] + 1.0,
														5.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, -1, b + 1000, -1 ) ;
			#endif

            dice_info [ b ] [ i ] [ b_area ] = CreateDynamicSphere ( dice_positions [ i ] [ 0 ], dice_positions [ i ] [ 1 ], dice_positions [ i ] [ 2 ], 3.0, b + 1000, -1, -1 ) ;
			area_info [ dice_info [ b ] [ i ] [ b_area ] ] [ a_type ] = area_type_dice ;
		}
	}

	foreach(new b: business_types[bizz_type_gym])
   	{
		for ( new i = 0 ; i < 14 ; i ++ )
		{
		    SimulatorUse [ b ] [ i ] = false ;
		}
	}

	for ( new i = 0 ; i < max_gym_bike ; i ++ )
	{
		CreateDynamic3DTextLabel("** Тренажер **\n{"#cGR3D"}Подойдите для взаимодействия", col_header_3d, gym_bike_position [ i ] [ 0 ], gym_bike_position [ i ] [ 1 ], gym_bike_position [ i ] [ 2 ], 5.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, -1, 5 );
        new _area_id = CreateDynamicSphere ( gym_bike_position [ i ] [ 0 ], gym_bike_position [ i ] [ 1 ], gym_bike_position [ i ] [ 2 ], 2.0, -1, -1, -1 ) ;
		area_info [ _area_id ] [ a_type ] = area_type_gym_bike ;
	}
	for ( new i = 0 ; i < max_gym_thread ; i ++ )
	{
		CreateDynamic3DTextLabel("** Тренажер **\n{"#cGR3D"}Подойдите для взаимодействия", col_header_3d, gym_thread_position [ i ] [ 0 ], gym_thread_position [ i ] [ 1 ], gym_thread_position [ i ] [ 2 ], 5.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, -1, 5 );
        new _area_id = CreateDynamicSphere ( gym_thread_position [ i ] [ 0 ], gym_thread_position [ i ] [ 1 ], gym_thread_position [ i ] [ 2 ], 2.0, -1, -1, -1 ) ;
		area_info [ _area_id ] [ a_type ] = area_type_gym_thread ;
	}
	for ( new i = 0 ; i < max_gym_bar ; i ++ )
	{
		CreateDynamic3DTextLabel("** Тренажер **\n{"#cGR3D"}Подойдите для взаимодействия", col_header_3d, gym_bar_position [ i ] [ 0 ], gym_bar_position [ i ] [ 1 ], gym_bar_position [ i ] [ 2 ], 5.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, -1, 5 );
        new _area_id = CreateDynamicSphere ( gym_bar_position [ i ] [ 0 ], gym_bar_position [ i ] [ 1 ], gym_bar_position [ i ] [ 2 ], 2.0, -1, -1, -1 ) ;
		area_info [ _area_id ] [ a_type ] = area_type_gym_bar ;
	}
	for ( new i = 0 ; i < max_gym_dumbbells ; i ++ )
	{
		CreateDynamic3DTextLabel("** Тренажер **\n{"#cGR3D"}Подойдите для взаимодействия", col_header_3d, gym_dumbbells_position [ i ] [ 0 ], gym_dumbbells_position [ i ] [ 1 ], gym_dumbbells_position [ i ] [ 2 ], 5.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, -1, 5 );
        new _area_id = CreateDynamicSphere ( gym_dumbbells_position [ i ] [ 0 ], gym_dumbbells_position [ i ] [ 1 ], gym_dumbbells_position [ i ] [ 2 ], 2.0, -1, -1, -1 ) ;
		area_info [ _area_id ] [ a_type ] = area_type_gym_dumbbells ;
	}

	for ( new i = 0 ; i < fraction_count ; i ++ )
	{
	    if ( i >= 17 && i <= 25 ) update_gdorm_text ( i ) ;
	}

    #if defined m_incass
	    incass_OnGameModeInit ( ) ;
	#endif

	printf ( "[SERVER] Загружено %d бизнесов. (%d ms)", b_count, GetTickCount ( ) - time ) ;

	mysql_tquery ( sql_connection, !"SELECT \
									h.*, \
									IFNULL(u.u_name, 'Собственность отеля') AS h_ownername \
									FROM hotels h \
									LEFT JOIN users u ON u.u_id = h.h_owner", "hotels_loading" ) ;

	//mysql_tquery ( sql_connection, !"SELECT * FROM `rent_vehicles`", "rent_vehicles_loading" ) ;
	mysql_tquery ( sql_connection, !"SELECT * FROM `atm`", "atm_loading" ) ;
	mysql_tquery ( sql_connection, !"SELECT * FROM `businesses_price` ORDER BY `businesses_price`.`b_id` ASC", "businesses_price_loading" ) ;
	return 1 ;
}

stock create_blabel ( b, auction_status = 0 )
{
	new _str_price [ 32 ] ;
	if ( b_info [ b ] [ b_donate_price ] ) format ( _str_price, sizeof _str_price, "%s "donate_title"", GetPlayerCashValueToSmile ( b_info [ b ] [ b_donate_price ] ) ) ;
	else format ( _str_price, sizeof _str_price, "%s"valute_title_"", GetPlayerCashValueToSmile ( b_info [ b ] [ b_price ] * for_tax [ 1 ] ) ) ;

    new label_string [ 512 ], _b_type = b_info [ b ] [ b_type ] ;
    if ( _b_type == bizz_type_drugsfarm || _b_type == bizz_type_gunfactory )
	{
		if ( b_info [ b ] [ b_owner_inc ] == -1 )
		{
			format ( label_string, sizeof ( label_string ), "{"#cWH3D"}Контроль: {%s}%s",
			f_info [ b_info [ b ] [ b_mafia ] - 1 ] [ f_chat_color ], f_info [ b_info [ b ] [ b_mafia ] - 1 ] [ f_name ] ) ;
		}
		else
		{
			format ( label_string, sizeof ( label_string ), "{"#cWH3D"}Контроль: {%s}%s",
			f_info [ b_info [ b ] [ b_mafia ] - 1 ] [ f_chat_color ], f_info [ b_info [ b ] [ b_mafia ] - 1 ] [ f_name ] ) ;
		}
	}
	else
	{
		if ( b_info [ b ] [ b_owner_inc ] == -1 )
		{
			if ( _b_type == bizz_type_carshop || _b_type == bizz_type_electric || _b_type == bizz_type_lake || _b_type == bizz_type_reserve || _b_type == bizz_type_fixcar )
			{
				format ( label_string, sizeof ( label_string ), "\
					%s (№%d)\n\
					{"#cWH3D"}Стоимость: {"#cTN3D"}%s\n\
					{"#cWH3D"}Контроль: {%s}%s\n\
					{"#cGR3D"}Бизнес продаётся (/buybiz)",
				b_types [ b_info [ b ] [ b_type ] ], b_info [ b ] [ b_id ], _str_price,
				f_info [ b_info [ b ] [ b_mafia ] - 1 ] [ f_chat_color ], f_info [ b_info [ b ] [ b_mafia ] - 1 ] [ f_name ] ) ;
			}
			else if ( _b_type == bizz_type_gas )
			{
				format ( label_string, sizeof ( label_string ), "\
					%s (№%d)\n\
					{"#cWH3D"}Стоимость: {"#cTN3D"}%s\n\
					{"#cWH3D"}Контроль: {%s}%s\n\
					{"#cGR3D"}Бизнес продаётся (/buygas)",
				b_types [ b_info [ b ] [ b_type ] ], b_info [ b ] [ b_id ], _str_price,
				f_info [ b_info [ b ] [ b_mafia ] - 1 ] [ f_chat_color ], f_info [ b_info [ b ] [ b_mafia ] - 1 ] [ f_name ] ) ;
			}
			else if ( _b_type == bizz_type_rentcar )
			{
				format ( label_string, sizeof ( label_string ), "\
					%s (№%d)\n\
					{"#cWH3D"}Стоимость: {"#cTN3D"}%s\n\
					{"#cWH3D"}Контроль: {%s}%s\n\
					{"#cGR3D"}Бизнес продаётся (/buyrent)",
				b_types [ b_info [ b ] [ b_type ] ], b_info [ b ] [ b_id ], _str_price,
				f_info [ b_info [ b ] [ b_mafia ] - 1 ] [ f_chat_color ], f_info [ b_info [ b ] [ b_mafia ] - 1 ] [ f_name ] ) ;
			}
			else
			{
				format ( label_string, sizeof ( label_string ), "\
					%s (№%d)\n\
					{"#cWH3D"}Стоимость: {"#cTN3D"}%s\n\
					{"#cWH3D"}Контроль: {%s}%s\n\
					{"#cGR3D"}Бизнес продаётся",
				b_types [ b_info [ b ] [ b_type ] ], b_info [ b ] [ b_id ], _str_price,
				f_info [ b_info [ b ] [ b_mafia ] - 1 ] [ f_chat_color ], f_info [ b_info [ b ] [ b_mafia ] - 1 ] [ f_name ] ) ;
			}
		}
		else
		{
			if ( b_info [ b ] [ b_maxproduct ] - 5000 < b_info [ b ] [ b_product ] )
			{
				format ( label_string, sizeof ( label_string ), "\
					%s (№%d)\n\
					{"#cWH3D"}Владелец: {"#cOR3D"}%s\n\
					{"#cWH3D"}Контроль: {%s}%s\n\
					{"#cWH3D"}Состояние: {"#cWH3D"}%s",
				b_types [ b_info [ b ] [ b_type ] ], b_info [ b ] [ b_id ], b_info [ b ] [ b_owner_name ],
				f_info [ b_info [ b ] [ b_mafia ] - 1 ] [ f_chat_color ], f_info [ b_info [ b ] [ b_mafia ] - 1 ] [ f_name ],
				( ! b_info [ b ] [ b_close ] ) ? ("{1a9616}Открыт") : ("{e11010}Закрыт") ) ;
			}
			else
			{
				format ( label_string, sizeof ( label_string ), "\
					%s (№%d)\n\
					{"#cWH3D"}Владелец: {"#cOR3D"}%s\n\
					{"#cWH3D"}Контроль: {%s}%s\n\
					{"#cWH3D"}Состояние: {"#cWH3D"}%s\n\n\
					{"#cWH3D"}Скупает {"#cTN3D"}%d {"#cWH"}продуктов с разгрузочной станции.\n\
					Стоимость 1-го продукта: {"#cTN3D"}%d"valute_title"{"#cWH"}.\n\
					{"#cTN3D"}Посигнальте, чтобы разгрузить продукты.",
				b_types [ b_info [ b ] [ b_type ] ], b_info [ b ] [ b_id ], b_info [ b ] [ b_owner_name ],
				f_info [ b_info [ b ] [ b_mafia ] - 1 ] [ f_chat_color ], f_info [ b_info [ b ] [ b_mafia ] - 1 ] [ f_name ],
				( ! b_info [ b ] [ b_close ] ) ? ("{1a9616}Открыт") : ("{e11010}Закрыт"), b_info [ b ] [ b_maxproduct ] - b_info [ b ] [ b_product ], b_product_price ) ;
			}
		}
	}

	if ( auction_status == 1 ) strcat ( label_string, "\n\n{"#cOR3D"}** Недвижимость на аукционе **" ) ;
	else strcat ( label_string, "" ) ;

	b_info [ b ] [ b_label ] = CreateDynamic3DTextLabel ( label_string, col_business_3d, b_info [ b ] [ b_position ] [ 0 ], b_info [ b ] [ b_position ] [ 1 ], b_info [ b ] [ b_position ] [ 2 ] + 0.7, 15.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0 ) ;
	return 1 ;
}

stock update_blabel ( b, auction_status = 0 )
{
    new _str_price [ 32 ] ;
	if ( b_info [ b ] [ b_donate_price ] ) format ( _str_price, sizeof _str_price, "%s "donate_title"", GetPlayerCashValueToSmile ( b_info [ b ] [ b_donate_price ] ) ) ;
	else format ( _str_price, sizeof _str_price, "%s"valute_title_"", GetPlayerCashValueToSmile ( b_info [ b ] [ b_price ] * for_tax [ 1 ] ) ) ;

    new label_string [ 512 ], _b_type = b_info [ b ] [ b_type ] ;
    if ( _b_type == bizz_type_drugsfarm || _b_type == bizz_type_gunfactory )
	{
		if ( b_info [ b ] [ b_owner_inc ] == -1 )
		{
			format ( label_string, sizeof ( label_string ), "{"#cWH3D"}Контроль: {%s}%s",
			f_info [ b_info [ b ] [ b_mafia ] - 1 ] [ f_chat_color ], f_info [ b_info [ b ] [ b_mafia ] - 1 ] [ f_name ] ) ;
		}
		else
		{
			format ( label_string, sizeof ( label_string ), "{"#cWH3D"}Контроль: {%s}%s",
			f_info [ b_info [ b ] [ b_mafia ] - 1 ] [ f_chat_color ], f_info [ b_info [ b ] [ b_mafia ] - 1 ] [ f_name ] ) ;
		}
	}
	else
	{
		if ( b_info [ b ] [ b_owner_inc ] == -1 )
		{
			if ( _b_type == bizz_type_carshop || _b_type == bizz_type_electric || _b_type == bizz_type_lake || _b_type == bizz_type_reserve || _b_type == bizz_type_fixcar )
			{
				format ( label_string, sizeof ( label_string ), "\
					%s (№%d)\n\
					{"#cWH3D"}Стоимость: {"#cTN3D"}%s\n\
					{"#cWH3D"}Контроль: {%s}%s\n\
					{"#cGR3D"}Бизнес продаётся (/buybiz)",
				b_types [ b_info [ b ] [ b_type ] ], b_info [ b ] [ b_id ], _str_price,
				f_info [ b_info [ b ] [ b_mafia ] - 1 ] [ f_chat_color ], f_info [ b_info [ b ] [ b_mafia ] - 1 ] [ f_name ] ) ;
			}
			else if ( _b_type == bizz_type_gas )
			{
				format ( label_string, sizeof ( label_string ), "\
					%s (№%d)\n\
					{"#cWH3D"}Стоимость: {"#cTN3D"}%s\n\
					{"#cWH3D"}Контроль: {%s}%s\n\
					{"#cGR3D"}Бизнес продаётся (/buygas)",
				b_types [ b_info [ b ] [ b_type ] ], b_info [ b ] [ b_id ], _str_price,
				f_info [ b_info [ b ] [ b_mafia ] - 1 ] [ f_chat_color ], f_info [ b_info [ b ] [ b_mafia ] - 1 ] [ f_name ] ) ;
			}
			else if ( _b_type == bizz_type_rentcar )
			{
				format ( label_string, sizeof ( label_string ), "\
					%s (№%d)\n\
					{"#cWH3D"}Стоимость: {"#cTN3D"}%s\n\
					{"#cWH3D"}Контроль: {%s}%s\n\
					{"#cGR3D"}Бизнес продаётся (/buyrent)",
				b_types [ b_info [ b ] [ b_type ] ], b_info [ b ] [ b_id ], _str_price,
				f_info [ b_info [ b ] [ b_mafia ] - 1 ] [ f_chat_color ], f_info [ b_info [ b ] [ b_mafia ] - 1 ] [ f_name ] ) ;
			}
			else
			{
				format ( label_string, sizeof ( label_string ), "\
					%s (№%d)\n\
					{"#cWH3D"}Стоимость: {"#cTN3D"}%s\n\
					{"#cWH3D"}Контроль: {%s}%s\n\
					{"#cGR3D"}Бизнес продаётся",
				b_types [ b_info [ b ] [ b_type ] ], b_info [ b ] [ b_id ], _str_price,
				f_info [ b_info [ b ] [ b_mafia ] - 1 ] [ f_chat_color ], f_info [ b_info [ b ] [ b_mafia ] - 1 ] [ f_name ] ) ;
			}
		}
		else
		{
			if ( b_info [ b ] [ b_maxproduct ] - 5000 < b_info [ b ] [ b_product ] )
			{
				format ( label_string, sizeof ( label_string ), "\
					%s (№%d)\n\
					{"#cWH3D"}Владелец: {"#cOR3D"}%s\n\
					{"#cWH3D"}Контроль: {%s}%s\n\
					{"#cWH3D"}Состояние: {"#cWH3D"}%s",
				b_types [ b_info [ b ] [ b_type ] ], b_info [ b ] [ b_id ], b_info [ b ] [ b_owner_name ],
				f_info [ b_info [ b ] [ b_mafia ] - 1 ] [ f_chat_color ], f_info [ b_info [ b ] [ b_mafia ] - 1 ] [ f_name ],
				( ! b_info [ b ] [ b_close ] ) ? ("{1a9616}Открыт") : ("{e11010}Закрыт") ) ;
			}
			else
			{
				format ( label_string, sizeof ( label_string ), "\
					%s (№%d)\n\
					{"#cWH3D"}Владелец: {"#cOR3D"}%s\n\
					{"#cWH3D"}Контроль: {%s}%s\n\
					{"#cWH3D"}Состояние: {"#cWH3D"}%s\n\n\
					{"#cWH3D"}Скупает {"#cTN3D"}%d {"#cWH"}продуктов с разгрузочной станции.\n\
					Стоимость 1-го продукта: {"#cTN3D"}%d"valute_title"{"#cWH"}.\n\
					{"#cTN3D"}Посигнальте, чтобы разгрузить продукты.",
				b_types [ b_info [ b ] [ b_type ] ], b_info [ b ] [ b_id ], b_info [ b ] [ b_owner_name ],
				f_info [ b_info [ b ] [ b_mafia ] - 1 ] [ f_chat_color ], f_info [ b_info [ b ] [ b_mafia ] - 1 ] [ f_name ],
				( ! b_info [ b ] [ b_close ] ) ? ("{1a9616}Открыт") : ("{e11010}Закрыт"), b_info [ b ] [ b_maxproduct ] - b_info [ b ] [ b_product ], b_product_price ) ;
			}
		}
	}

	if ( auction_status == 1 ) strcat ( label_string, "\n\n{"#cOR3D"}** Недвижимость на аукционе **" ) ;
	else strcat ( label_string, "" ) ;

	UpdateDynamic3DTextLabelText ( b_info [ b ] [ b_label ], col_business_3d, label_string ) ;
	return 1 ;
}

callback: unban_callback ( playerid, pl_name [ ] )
{
	new rows, fields;
	cache_get_data ( rows, fields ) ;
	if ( rows )
	{
		new _t_string [ 148 ] ;
		format ( _t_string, sizeof _t_string, "UPDATE `users_bans` SET `u_b_date` = NOW() WHERE `u_b_name` = '%s' AND `u_b_date` > NOW() LIMIT 1", pl_name ) ;
		mysql_tquery ( sql_connection, _t_string ) ;

		format ( _t_string, 128, "{"#cBAdmin"}[A] {"#cGRAdmin"}Администратор %s разблокировал аккаунт %s.", p_info [ playerid ] [ name ], pl_name ) ;
		foreach(new i: admin_players) SendClientMessage ( i, col_admin, _t_string ) ;

		format ( _t_string, 128, "%s разбанил %s", p_info [ playerid ] [ name ], pl_name ) ;
		WriteLog ( playerid, TYPE_LOG_UNBAN, _t_string ) ;
	}
	else
	{
		new _t_string [ 49 + MAX_PLAYER_NAME ] ;
		format ( _t_string, sizeof ( _t_string ), "Аккаунт %s не найден в списке заблокированных.", pl_name ) ;
		SendClientMessage ( playerid, col_gray, _t_string ) ;
	}
	return 1 ;
}

callback: offban_check_callback ( playerid, pl_name [ ], days, ban_reason [ ] )
{
	new rows, fields;
	cache_get_data ( rows, fields ) ;
	if ( ! rows )
	{
	    static const _str [ ] = "Аккаунт %s не найден в базе данных." ;
		new _t_string [ sizeof _str + 24 ] ;
		format( _t_string, sizeof ( _t_string ), _str, pl_name ) ;
		SendClientMessage ( playerid, col_gray, _t_string ) ;
		return 1 ;
	}
	else
	{
		new _t_string [ 93 + MAX_PLAYER_NAME ] ;
		format ( _t_string, sizeof ( _t_string ), "SELECT `u_b_name` FROM `users_bans` WHERE `u_b_name` = '%s' AND `u_b_date` > NOW() LIMIT 1", pl_name ) ;
		mysql_tquery ( sql_connection, _t_string, "offban_check_callback_is_banned", "isds", playerid, pl_name, days, ban_reason ) ;
		return 1 ;
	}
}

callback: offban_check_callback_is_banned ( playerid, pl_name [ ], days, ban_reason [ ] )
{
	new rows, fields;
	cache_get_data ( rows, fields ) ;
	if ( rows )
	{
		new _t_string [ 31 + MAX_PLAYER_NAME ] ;
		format ( _t_string, sizeof ( _t_string ), "Аккаунт %s уже заблокирован.", pl_name ) ;
		SendClientMessage ( playerid, col_gray, _t_string ) ;
		return 1 ;
	}
	else
	{
	    if ( reload_admin_warning ( playerid, ban_reason ) ) return 1 ;

		new _t_string [ 238 ] ;
		format ( _t_string, 144, "Администратор %s выдал оффлайн бан игроку %s на %d дней. Причина: %s", p_info [ playerid ] [ name ], pl_name, days, ban_reason ) ;
		foreach(new i: admin_players) SendClientMessage ( i, col_light_red, _t_string ) ;

		format ( _t_string, sizeof ( _t_string ), "INSERT INTO `users_bans` (`u_b_admin`,`u_b_name`,`u_b_reason`,`u_b_date`,`u_b_ndate`,`u_b_days`) VALUES ( '%s', '%s', '%s', NOW() + INTERVAL %d DAY,NOW(),'%d')", p_info [ playerid ] [ name ], pl_name, ban_reason, days, days ) ;
		mysql_tquery ( sql_connection, _t_string, "", "" ) ;

		format ( _t_string, 144, "[OFFBAN] %s забанил %s. Причина: %s", p_info [ playerid ] [ name ], pl_name, ban_reason ) ;
		WriteLog ( playerid, TYPE_LOG_BAN, _t_string ) ;
	}
	return 1 ;
}

callback: offjail_check_callback ( playerid, jname [ ], jtime, jreason [ ] )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( rows )
	{
	    if ( reload_admin_warning ( playerid, jreason ) ) return 1 ;

		new string [ 144 ] ;
		format ( string, sizeof string, "UPDATE `users` SET `u_jail` = '10', `u_jailed` = '%d' WHERE `u_name` = '%s' LIMIT 1", jtime * 60, jname ) ;
		mysql_tquery ( sql_connection, string ) ;

		format ( string, sizeof string, "{"#cGInfo"}* {"#cWH"}Вы успешно посадили игрока %s в тюрьму на %d минут. Причина: %s", jname, jtime, jreason ) ;
		SendClientMessage ( playerid, col_white, string ) ;

		format( string, sizeof string, "Администратор %s посадил в оффлайн игрока %s на %d минут. Причина: %s", p_info [ playerid ] [ name ], jname, jtime, jreason ) ;
		foreach(new i: admin_players) SendClientMessage ( i, col_light_red, string ) ;

        new _u_id = cache_get_field_content_int ( 0, "u_id", sql_connection ) ;
        format ( string, sizeof string, "Администратор %s посадил Вас в призон. Причина: %s", p_info [ playerid ] [ name ], jreason ) ;
		insert_debtor_message ( "Наказание от администратора", string, _u_id ) ;
	}
	else
	{
		new scm_string [ 34 + MAX_PLAYER_NAME ] ;
		format ( scm_string, sizeof scm_string, "Аккаунт %s не найден в базе данных.", jname ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
	}
	return 1 ;
}

callback: offmute_check_callback ( playerid, mname [ ], mtime, mreason [ ] )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( rows )
	{
	    if ( reload_admin_warning ( playerid, mreason ) ) return 1 ;

		new string [ 144 ] ;
		format ( string, sizeof string, "UPDATE `users` SET `u_mute` = '%d' WHERE `u_name` = '%s' LIMIT 1", mtime * 60, mname ) ;
		mysql_tquery ( sql_connection, string ) ;

		format ( string, sizeof string, "{"#cGInfo"}* {"#cWH"}Вы успешно выдали игроку %s мут на %d минут. Причина: %s", mname, mtime, mreason ) ;
		SendClientMessage ( playerid, col_white, string ) ;

		format( string, sizeof string, "Администратор %s выдал мут в оффлайн игроку %s на %d минут. Причина: %s", p_info [ playerid ] [ name ], mname, mtime, mreason ) ;
		foreach(new i: admin_players) SendClientMessage ( i, col_light_red, string ) ;

		new _u_id = cache_get_field_content_int ( 0, "u_id", sql_connection ) ;
		format ( string, sizeof string, "Вам был выдан мут в оффлайне от администратора %s. Причина: %s", p_info [ playerid ] [ name ], mreason ) ;
		insert_debtor_message ( "Наказание от администратора", string, _u_id ) ;
	}
	else
	{
		new scm_string [ 34 + MAX_PLAYER_NAME ] ;
		format ( scm_string, sizeof scm_string, "Аккаунт %s не найден в базе данных.", mname ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
	}
	return 1 ;
}

callback: unit_loading ( )
{
	new fields, time = GetTickCount ( ) ;
	cache_get_data ( unit_count, fields ) ;
	if ( unit_count )
	{
		for ( new i = 0 ; i < unit_count ; i ++ )
		{
		    unit_info [ i ] [ un_id ] = cache_get_field_content_int ( i, "unit_id", sql_connection ) ;

			cache_get_field_content ( i, "unit_name", unit_info [ i ] [ un_name ], sql_connection, 32 ) ;
			cache_get_field_content ( i, "unit_leader", unit_info [ i ] [ u_leader ], sql_connection, 32 ) ;

			unit_info [ i ] [ u_fraction ] = cache_get_field_content_int ( i, "unit_fraction", sql_connection ) ;
			unit_info [ i ] [ u_use_spawn ] = cache_get_field_content_int ( i, "unit_use_spawn", sql_connection ) ;

			cache_get_field_content ( i, "unit_spawn", global_string ), sscanf ( global_string, "p<|>ffffdd",
			unit_info [ i ] [ u_spawn ] [ 0 ], unit_info [ i ] [ u_spawn ] [ 1 ], unit_info [ i ] [ u_spawn ] [ 2 ],
			unit_info [ i ] [ u_spawn ] [ 3 ], unit_info [ i ] [ u_int ], unit_info [ i ] [ u_world ] ) ;

			unit_info [ i ] [ u_members ] = cache_get_field_content_int ( i, "unit_members", sql_connection ) ;
		}

		/*new dialog_string [ 72 + 4 + 4 ] ;
		for ( new i = 0 ; i < unit_count ; i ++ )
	    {
	        format ( dialog_string, sizeof ( dialog_string ),"SELECT `u_subleader` FROM `users` WHERE `u_subleader` = '%d'", i + 1 ) ;
			mysql_tquery ( sql_connection, dialog_string, "unit_loading_member", "i", i ) ;
	    }*/
	}
	printf("[SERVER] загружено %i подразделений. (%d ms)", unit_count, GetTickCount ( ) - time ) ;
	return 1 ;
}

callback: unit_loading_member ( _unit_id )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;

	new dialog_string [ 72 + 4 + 4 ] ;
	unit_info [ _unit_id ] [ u_members ] = rows ;
	format ( dialog_string, sizeof ( dialog_string ), "UPDATE `unit_settings` SET `unit_members` = '%d' WHERE `unit_id` = '%d' LIMIT 1", unit_info [ _unit_id ] [ u_members ], _unit_id + 1 ) ;
	mysql_tquery ( sql_connection, dialog_string ) ;
	return 1 ;
}

stock show_dorm ( playerid )
{
    show_dialog ( playerid, d_dorm, DIALOG_STYLE_LIST, "{"#cBHD"}Общак", "{"#cGRDialog"}- {"#cWH"}Открыть общак\n{"#cGRDialog"}- {"#cWH"}Положить деньги\n{"#cGRDialog"}- {"#cWH"}Взять деньги", "Выбрать", "Назад" ) ;
	return 1 ;
}

callback: fractions_loading ( )
{
	new fields, time = GetTickCount ( ) ;
	cache_get_data ( fraction_count, fields ) ;
	new str_to_hex [ 28 ] ;
	if ( fraction_count )
	{
		for ( new i = 0 ; i < fraction_count ; i ++ )
		{
			f_info [ i ] [ f_id ] = cache_get_field_content_int ( i, "f_id", sql_connection ) ;
			cache_get_field_content ( i, "f_name", f_info [ i ] [ f_name ], sql_connection, 48 ) ;
			cache_get_field_content ( i, "f_letter_name", f_info [ i ] [ f_letter_name ], sql_connection, 32 ) ;

			f_info [ i ] [ f_money ] = cache_get_field_content_int ( i, "f_money", sql_connection ) ;
			f_info [ i ] [ f_materials ] = cache_get_field_content_int ( i, "f_materials", sql_connection ) ;
			f_info [ i ] [ f_dorm_status ] = cache_get_field_content_int ( i, "f_dorm_status", sql_connection ) ;

			cache_get_field_content ( i, "f_chat_color", f_info [ i ] [ f_chat_color ], sql_connection, 24 ) ;
			cache_get_field_content ( i, "f_radar_color", str_to_hex, sql_connection, 24 ) ;
			f_info [ i ] [ f_radar_color ] = StrToHex ( str_to_hex ) ;
			cache_get_field_content ( i, "f_gangzone_color", str_to_hex, sql_connection, 24 ) ;
			f_info [ i ] [ f_gangzone_color ] = StrToHex ( str_to_hex ) ;

			global_string [ 0 ] = EOS ;
			cache_get_field_content ( i, "f_spawn", global_string ), sscanf ( global_string, "p<|>ffffdd",
			f_info [ i ] [ f_spawn ] [ 0 ], f_info [ i ] [ f_spawn ] [ 1 ], f_info [ i ] [ f_spawn ] [ 2 ], f_info [ i ] [ f_spawn ] [ 3 ],
			f_info [ i ] [ f_spawn_int ], f_info [ i ] [ f_spawn_virt ] ) ;

			global_string [ 0 ] = EOS ;
			if ( i > 16 && i < 25 )
			{
				cache_get_field_content ( i, "f_dip", global_string ), sscanf ( global_string, "p<|>dddddddd",
				f_diplomacy [ i - 17 ] [ 0 ], f_diplomacy [ i - 17 ] [ 1 ], f_diplomacy [ i - 17 ] [ 2 ],
				f_diplomacy [ i - 17 ] [ 3 ], f_diplomacy [ i - 17 ] [ 4 ], f_diplomacy [ i - 17 ] [ 5 ],
				f_diplomacy [ i - 17 ] [ 6 ], f_diplomacy [ i - 17 ] [ 7 ] ) ;
			}
			global_string [ 0 ] = EOS ;
			cache_get_field_content ( i, "f_ranks", global_string ), sscanf ( global_string, "p<|>s[30]s[30]s[30]s[30]s[30]s[30]s[30]s[30]s[30]s[30]s[30]s[30]s[30]s[30]s[30]s[30]s[30]s[30]s[30]s[30]s[30]s[30]s[30]s[30]",
			f_rank [ i ] [ 0 ], f_rank [ i ] [ 1 ], f_rank [ i ] [ 2 ], f_rank [ i ] [ 3 ],
			f_rank [ i ] [ 4 ], f_rank [ i ] [ 5 ], f_rank [ i ] [ 6 ], f_rank [ i ] [ 7 ],
			f_rank [ i ] [ 8 ], f_rank [ i ] [ 9 ], f_rank [ i ] [ 10 ], f_rank [ i ] [ 11 ],
			f_rank [ i ] [ 12 ], f_rank [ i ] [ 13 ], f_rank [ i ] [ 14 ], f_rank [ i ] [ 15 ],
			f_rank [ i ] [ 16 ], f_rank [ i ] [ 17 ], f_rank [ i ] [ 18 ], f_rank [ i ] [ 19 ],
			f_rank [ i ] [ 20 ], f_rank [ i ] [ 21 ], f_rank [ i ] [ 22 ], f_rank [ i ] [ 23 ] ) ;

			global_string [ 0 ] = EOS ;
			cache_get_field_content ( i, "f_default_ranks", global_string ), sscanf ( global_string, "p<|>s[30]s[30]s[30]s[30]s[30]s[30]s[30]s[30]s[30]s[30]s[30]s[30]s[30]s[30]s[30]s[30]s[30]s[30]s[30]s[30]s[30]s[30]s[30]s[30]",
			f_default_rank [ i ] [ 0 ], f_default_rank [ i ] [ 1 ], f_default_rank [ i ] [ 2 ], f_default_rank [ i ] [ 3 ],
			f_default_rank [ i ] [ 4 ], f_default_rank [ i ] [ 5 ], f_default_rank [ i ] [ 6 ], f_default_rank [ i ] [ 7 ],
			f_default_rank [ i ] [ 8 ], f_default_rank [ i ] [ 9 ], f_default_rank [ i ] [ 10 ], f_default_rank [ i ] [ 11 ],
