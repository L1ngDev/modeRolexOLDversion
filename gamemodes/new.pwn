    strcat ( global_string, line_string ) ;

	format ( line_string, sizeof line_string, "{"#cBInfo"}* {"#cWH"}Разыгрываемый еженедельный куш: {"#cGN"}%d"valute_title_"\n\n", b_info [ b ] [ b_win_prise ] ) ;
    strcat ( global_string, line_string ) ;

	strcat ( global_string, "{"#cGRDialog"}* Розыгрыш происходит еженедельно по пятницам.\n");
 	strcat ( global_string, "{"#cGRDialog"}* Время розыгрыша, который проходит в {"#cBL"}20:00{"#cGRDialog"}.\n\n" ) ;

	strcat ( global_string, "{"#cGRDialog"}* Вы так же можете принять участие за розыгрыш куша в другом казино.\n");
 	strcat ( global_string, "{"#cGRDialog"}* Если удача будет на Вашей стороне и Вы выйграете, то при входе\n");
