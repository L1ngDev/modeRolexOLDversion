stock show_blacklist ( playerid )
{
    new fraction_id ;
	if ( p_info [ playerid ] [ leader ] ) fraction_id = p_info [ playerid ] [ member ] ;
	else fraction_id = player_settings { playerid } ;

    if ( mafia_player ( playerid ) || gang_player ( playerid ) )
	{
	    global_string [ 0 ] = EOS ;
	    format ( global_string, 300, "{"#cGRDialog"}- {"#cWH"}Добавить человека в чёрный список\n{"#cGRDialog"}- {"#cWH"}Очистить черный список\n{"#cGRDialog"}- {"#cWH"}Убрать человека из черного списка\n{"#cGRDialog"}- {"#cWH"}Чёрный список игроков\n{"#cGRDialog"}- {"#cWH"}Цена выкупа: {"#cGN"}%d"valute_title_"\n{"#cGRDialog"}- {"#cWH"}Смертей для откупа кровью: {"#cGN"}%d", f_info [ fraction_id - 1 ] [ f_price_clear ], f_info [ fraction_id - 1 ] [ f_death_clear ] ) ;
		show_dialog ( playerid, d_blacklist, DIALOG_STYLE_LIST, "{"#cBHD"}Чёрный список", global_string, "Выбрать", "Назад" ) ;
	}
	else
	{
 		global_string [ 0 ] = EOS ;
	    format ( global_string, 300, "{"#cGRDialog"}- {"#cWH"}Добавить человека в чёрный список\n{"#cGRDialog"}- {"#cWH"}Очистить черный список\n{"#cGRDialog"}- {"#cWH"}Убрать человека из черного списка\n{"#cGRDialog"}- {"#cWH"}Чёрный список игроков\n{"#cGRDialog"}- {"#cWH"}Цена выкупа: {"#cGN"}%d"valute_title_"", f_info [ fraction_id - 1 ] [ f_price_clear ] ) ;
		show_dialog ( playerid, d_blacklist, DIALOG_STYLE_LIST, "{"#cBHD"}Чёрный список", global_string, "Выбрать", "Назад" ) ;
	}
	return 1 ;
}

stock set_money_fraction ( fraction_id, statistic_id, count_money, bool:status, bool:save_status = true )
{
	if ( status )
	{
	    f_info [ fraction_id ] [ f_money ] += count_money ;
		f_info [ fraction_id ] [ f_money_statistic ] [ statistic_id ] += count_money ;

		if ( save_status )
		{
			new query_string [ 100 ] ;
			mysql_format ( sql_connection, query_string, sizeof ( query_string ), "UPDATE `fractions` SET `f_money` = '%d' WHERE `f_id` = '%d' LIMIT 1",
			f_info [ fraction_id ] [ f_money ], f_info [ fraction_id ] [ f_id ] ) ;
			mysql_tquery ( sql_connection, query_string, "", "" ) ;
		}

		if ( f_info [ fraction_id ] [ f_id ] >= 18 && f_info [ fraction_id ] [ f_id ] <= 25 ) update_gdorm_text ( f_info [ fraction_id ] [ f_id ] ) ;
	}
	else
	{
	    f_info [ fraction_id ] [ f_money ] -= count_money ;
		f_info [ fraction_id ] [ f_money_statistic_minus ] [ statistic_id ] -= count_money ;

		if ( save_status )
		{
			new query_string [ 100 ] ;
			mysql_format ( sql_connection, query_string, sizeof ( query_string ), "UPDATE `fractions` SET `f_money` = '%d' WHERE `f_id` = '%d' LIMIT 1",
			f_info [ fraction_id ] [ f_money ], f_info [ fraction_id ] [ f_id ] ) ;
			mysql_tquery ( sql_connection, query_string, "", "" ) ;
		}

		if ( f_info [ fraction_id ] [ f_id ] >= 18 && f_info [ fraction_id ] [ f_id ] <= 25 ) update_gdorm_text ( f_info [ fraction_id ] [ f_id ] ) ;
	}
	return 1 ;
}

stock fractionLeaderInsert ( playerid )
{
	static const _str [ ] = "INSERT INTO `fractions_players` (`u_sql_id`,`u_leader`,`u_leader_status`,`u_member`,`u_rank`,`u_org_skin`) VALUES ('%d','%d','%d','%d','%d','%d')" ;
	new sql_string [ sizeof _str + ( 3 * 9 ) ] ;
	format ( sql_string, sizeof ( sql_string ), _str,
	p_info [ playerid ] [ id ], p_info [ playerid ] [ leader ], p_info [ playerid ] [ leader_status ], p_info [ playerid ] [ member ], p_info [ playerid ] [ rank ], p_info [ playerid ] [ org_skin ] ) ;
	mysql_tquery ( sql_connection, sql_string ) ;
	return true ;
}

stock fractionUserInsert ( playerid )
{
	static const _str [ ] = "INSERT INTO `fractions_players` (`u_sql_id`,`u_leader`,`u_member`,`u_rank`,`u_org_skin`) VALUES ('%d','NULL','%d','%d','%d')" ;
	new sql_string [ sizeof _str + ( 3 * 9 ) ] ;
	format ( sql_string, sizeof ( sql_string ), _str,
	p_info [ playerid ] [ id ], p_info [ playerid ] [ member ], p_info [ playerid ] [ rank ], p_info [ playerid ] [ org_skin ] ) ;
	mysql_tquery ( sql_connection, sql_string ) ;
	return true ;
}

callback: fractionUserLoading ( playerid, init )
{
	if ( init )
	{
		static const _str [ ] = "\
			SELECT \
				fp.*, \
				IFNULL(fp.u_leader, 0) AS u_leader, \
				IFNULL(fp.u_subleader, 0) AS u_subleader \
			FROM fractions_players fp WHERE fp.u_sql_id = %d LIMIT 1" ;
		new query_string [ sizeof _str + 9 ] ;
		format ( query_string, sizeof query_string, _str, p_info [ playerid ] [ id ] ) ;
		mysql_tquery ( sql_connection, query_string, "fractionUserLoading", "ii", playerid, false ) ;
	}
	else
	{
		new rows, fields ;
		cache_get_data ( rows, fields ) ;
		if ( ! rows )
		{
			p_info [ playerid ] [ leader ] =
			p_info [ playerid ] [ leader_status ] =
			p_info [ playerid ] [ subleader ] =
			p_info [ playerid ] [ member ] =
			p_info [ playerid ] [ rank ] =
			p_info [ playerid ] [ f_mute ] =
			p_info [ playerid ] [ f_warning ] =
			p_info [ playerid ] [ org_skin ] =
			p_info [ playerid ] [ capture_kills ] =
			p_info [ playerid ] [ bizwar_kills ] =
			p_info [ playerid ] [ arrest_count ] =
			p_info [ playerid ] [ warblock ] =

        	is_fraction_cover { playerid } =
        	is_fraction_cover_rank { playerid } =
			cover_skin [ playerid ] = 0 ;

			format ( is_fraction_cover_name [ playerid ], MAX_PLAYER_NAME, "None" ) ;
			format ( is_fraction_cover_real_name [ playerid ], MAX_PLAYER_NAME, "None" ) ;
			return false ;
		}

		p_info [ playerid ] [ leader ] = cache_get_field_content_int ( 0, "u_leader", sql_connection ) ;
		p_info [ playerid ] [ leader_status ] = cache_get_field_content_int ( 0, "u_leader_status", sql_connection ) ;

		p_info [ playerid ] [ subleader ] = cache_get_field_content_int ( 0, "u_subleader", sql_connection ) ;
		p_info [ playerid ] [ member ] = cache_get_field_content_int ( 0, "u_member", sql_connection ) ;
		p_info [ playerid ] [ org_skin ] = cache_get_field_content_int ( 0, "u_org_skin", sql_connection ) ;

		p_info [ playerid ] [ rank ] = cache_get_field_content_int ( 0, "u_rank", sql_connection ) ;
		p_info [ playerid ] [ f_mute ] = cache_get_field_content_int ( 0, "u_fmute", sql_connection ) ;
		p_info [ playerid ] [ f_warning ] = cache_get_field_content_int ( 0, "u_f_warning", sql_connection ) ;

		cache_get_field_content ( 0, "u_fraction_date", p_info [ playerid ] [ fraction_date ], sql_connection, 32 ) ;
		p_info [ playerid ] [ org_date ] = cache_get_field_content_int ( 0, "u_fraction_gettime", sql_connection ) ;

		is_fraction_cover { playerid } = cache_get_field_content_int ( 0, "u_fraction_cover", sql_connection ) ;
		is_fraction_cover_rank { playerid } = cache_get_field_content_int ( 0, "u_fraction_cover_rank", sql_connection ) ;
		is_fraction_cover_skin [ playerid ] = cache_get_field_content_int ( 0, "u_cover_skin", sql_connection ) ;
		cache_get_field_content ( 0, "u_cover_name", is_fraction_cover_name [ playerid ], sql_connection, 32 ) ;
		cache_get_field_content ( 0, "u_cover_real_name", is_fraction_cover_real_name [ playerid ], sql_connection, 32 ) ;
		if ( is_fraction_cover { playerid } != 0 && ! GetString ( is_fraction_cover_name [ playerid ], "None" ) )
		{
			Iter_Add ( fraction_players[is_fraction_cover { playerid }], playerid ) ;

			SetPlayerName ( playerid, is_fraction_cover_name [ playerid ] ) ;
			GetPlayerName ( playerid, p_info [ playerid ] [ name ], MAX_PLAYER_NAME ) ;
		}

		p_info [ playerid ] [ arrest_count ] = cache_get_field_content_int ( 0, "u_arrest_count", sql_connection ) ;
		p_info [ playerid ] [ warblock ] = cache_get_field_content_int ( 0, "u_warblock", sql_connection ) ;

		p_info [ playerid ] [ capture_kills ] = cache_get_field_content_int ( 0, "u_capture_top", sql_connection ) ;
		if ( gz_captured == -1 ) p_info [ playerid ] [ capture_kills ] = 0 ;

		p_info [ playerid ] [ m_capture_kills ] = cache_get_field_content_int ( 0, "u_m_capture_kills", sql_connection ) ;
		p_info [ playerid ] [ m_captures ] = cache_get_field_content_int ( 0, "u_m_captures", sql_connection ) ;

		p_info [ playerid ] [ bizwar_kills ] = cache_get_field_content_int ( 0, "u_bizwar_top", sql_connection ) ;

		if ( GetElapsedTime ( gettime ( ), p_info [ playerid ] [ exit_time ], CONVERT_TIME_TO_MINUTES ) > 10 )
		{
		    p_info [ playerid ] [ capture_kills ] =
		    p_info [ playerid ] [ bizwar_kills ] = 0 ;
		}
		else
		{
		    if ( gz_captured == -1 ) p_info [ playerid ] [ capture_kills ] = 0 ;
		    if ( mw_gangzone == -1 ) p_info [ playerid ] [ bizwar_kills ] = 0 ;
		}

		Iter_Add ( fraction_players[p_info[playerid][member]], playerid ) ;
	}
	return true ;
}

CMD:lmenu ( playerid )
{
	if ( ! p_info [ playerid ] [ leader ] ) return 1 ;
	ShowLeaderMenu ( playerid ) ;
	return 1 ;
}

