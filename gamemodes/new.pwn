			WriteLog ( playerid, TYPE_LOG_ROULETTE, query_string ) ;

			give_inventory ( playerid, money_count, 1, 0, "", "", NUMBERPLATE_TYPE_NONE, 0 ) ;
			format ( query_string, sizeof query_string, "* Вам в инвентарь был добавлен предмет '%s'.", item_name ( money_count ) ) ;
			SendClientMessage ( playerid, col_yellow, query_string ) ;
		}
	}
	return 1 ;
}

CMD:bizwar ( playerid )
{
    if ( ! mafia_player ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команда доступна только мафиям." ) ;

    new year,
		month,
		day,
		hour,
		minute,
		second ;

	getdate ( year, month, day ) ;
	gettime ( hour, minute, second ) ;
	FixHour ( hour ) ;

	if ( global_hour < 12 || global_hour > 22 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Захват бизнесов возможен только с 12 до 22 часов." ) ;

    new fraction_id = p_info [ playerid ] [ member ] ;
	if ( p_info [ playerid ] [ rank ] < f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 6 ] )
	{
	    static const _str [ ] = "{"#cRInfo"}* {"#cGRInfo"}Команда доступна с ранга %s (%d)." ;
	    new scm_string [ sizeof _str + 30 + 3 ] ;
	    format ( scm_string, sizeof scm_string, _str, f_rank [ fraction_id - 1 ] [ f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 6 ] - 1 ], f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 6 ] ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
		return 1 ;
	}

	if ( capture_gang_freezed [ fraction_id - 18 ] > 0 )
	{
		return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Ваша мафия заморожена, Вы не можете начать захват бизнеса." ) ;
	}

    if ( mw_biz != -1 || gz_captured != -1 || conf_time > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}В данный момент уже идет война." ) ;

	if ( mafia_cd > 0 )
	{
		new text_str [ 78 ] ;
		format ( text_str, sizeof ( text_str ), "{"#cRInfo"}* {"#cGRInfo"}Захват бизнеса будет доступен через %s.", convert_time ( mafia_cd, TYPE_TIME_SECOND ) ) ;
		return SendClientMessage ( playerid, col_gray, text_str ) ;
	}

	for ( new b = 0; b < b_count ; b ++ )
	{
		if ( IsPlayerInRangeOfPoint ( playerid , 3.0 , b_info [ b ] [ b_position ] [ 0 ] , b_info [ b ] [ b_position ] [ 1 ], b_info [ b ] [ b_position ] [ 2 ] ) )
		{
			if ( b_info [ b ] [ b_mafia ] == p_info [ playerid ] [ member ] )
			{
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете начать захват своего бизнеса." ) ;
				return 1 ;
			}

			if ( f_diplomacy [ fraction_id - 18 ] [ b_info [ b ] [ b_mafia ] - 18 ] == dip_status_alliance || f_diplomacy [ fraction_id - 18 ] [ b_info [ b ] [ b_mafia ] - 18 ] == dip_status_neutral )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете напасть на союзника." ) ;

			new owner_counts = 0 ;
			foreach(new j: fraction_players[b_info [ b ] [ b_mafia ]])
			{
				if ( b_info [ b ] [ b_mafia ] == p_info [ j ] [ member ] && p_info [ j ] [ warblock ] == 0 ) owner_counts ++ ;
			}
			if ( owner_counts < bizwar_online )
			{
			    SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игроков организации, контроллирующей бизнес, недостаточно для проведения захвата." ) ;
			    global_string [ 0 ] = EOS ;
			    format ( global_string, 128, "{"#cRInfo"}* {"#cGRInfo"}В игре {"#cRInfo"}%d чел.{"#cGRInfo"} из {"#cRInfo"}%d чел.{"#cGRInfo"} необходимым для захвата.", owner_counts, bizwar_online ) ;
				SendClientMessage ( playerid, col_gray, global_string ) ;
				return 1 ;
			}

			if ( b_info [ b ] [ b_mafia ] <= 1 )
			{
				b_info [ b ] [ b_mafia ] = p_info [ playerid ] [ member ] ;

				update_blabel ( b ) ;

				static const _str [ ] = "UPDATE `businesses` SET `b_mafia` = '%d' WHERE `b_id` = '%d' LIMIT 1" ;
				new query_string [ sizeof _str + 4 + 9 ] ;
				format ( query_string, sizeof query_string, _str, b_info [ b ] [ b_mafia ], b_info [ b ] [ b_id ] ) ;
				mysql_tquery ( sql_connection, query_string ) ;

				SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Бизнес взят под контроль." ) ;
				return 1 ;
			}

			new query_string [ 100 ] ;
			format ( query_string, sizeof ( query_string ),"UPDATE `fractions_players` SET `u_m_capture_start` = `u_m_capture_start`+1 WHERE `u_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
			mysql_tquery ( sql_connection, query_string, "", "" ) ;

			show_dialog ( playerid, d_bizwar, DIALOG_STYLE_TABLIST_HEADERS, "{"#cBHD"}Выбор места", "\
			{"#cBL"}№. Город:\t{"#cBL"}Место:\n\
			{"#cBL"}1. {"#cWH"}г. Южный\t{"#cOR"}Заброшенный склад\n\
			{"#cBL"}2. {"#cWH"}г. Лыткарино\t{"#cOR"}Свалка мусора\n\
			{"#cBL"}3. {"#cWH"}пгт. Батырево\t{"#cOR"}Сеновал", "Выбрать", "" ) ;

			SetPVarInt ( playerid, "biz_war_business", b ) ;
			/*SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Выберите на карте место для стрелы." ) ;
			SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Это должна быть территория в пригороде "city_war"." ) ;
			SetPVarInt ( playerid, "biz_war_map", 1 ) ;
			SetPVarInt ( playerid, "biz_war_business", b ) ;*/
			return 1 ;
		}
	}
	SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не у бизнеса." ) ;
	return 1 ;
}

stock rewards_promo ( playerid )
{
	if ( p_info [ playerid ] [ promo_hours ] > 0 )
	{
	    p_info [ playerid ] [ promo_hours ] -- ;
	    if ( p_info [ playerid ] [ promo_hours ] == 1 )
	    {
	        new _promo_type = p_info [ playerid ] [ promo_type ] ;
			if ( _promo_type == 1 )
			{
			    new promo_veh = p_info [ playerid ] [ promo_p_id ] ;
			    give_inventory ( playerid, promo_veh, 1, 0, "", "", NUMBERPLATE_TYPE_NONE, 0 ) ;

			    new _query [ 100 + 9 ] ;
				format ( _query, sizeof _query, "* Вам в инвентарь был добавлен предмет '%s'.", item_name ( promo_veh ) ) ;
				SendClientMessage ( playerid, col_yellow, _query ) ;
			}
			else if ( _promo_type == 2 )
			{
			    give_inventory ( playerid, p_info [ playerid ] [ promo_p_id ], 1, 0, "", "", NUMBERPLATE_TYPE_NONE, 0 ) ;

			    new _query [ 100 + 9 ] ;
				format ( _query, sizeof _query, "* Вам в инвентарь был добавлен предмет '%s'.", item_name ( p_info [ playerid ] [ promo_p_id ] ) ) ;
				SendClientMessage ( playerid, col_yellow, _query ) ;
			}
			else if ( _promo_type == 3 )
			{
			    give_inventory ( playerid, p_info [ playerid ] [ promo_p_id ], 1, 0, "", "", NUMBERPLATE_TYPE_NONE, 0 ) ;

			    new _query [ 100 + 9 ] ;
				format ( _query, sizeof _query, "* Вам был добавлен предмет 'Одежда #%d'. Откройте инвентарь, используйте /mm или радиальное меню.", p_info [ playerid ] [ promo_p_id ] ) ;
				SendClientMessage ( playerid, col_yellow, _query ) ;
			}

			p_info [ playerid ] [ promo_hours ] =
	        p_info [ playerid ] [ promo_type ] =
	        p_info [ playerid ] [ promo_p_id ] = 0 ;

	        new query_string [ 118 + 9 ] ;
			format ( query_string, sizeof query_string, "UPDATE `users` SET `u_promo_hours` = '0', `u_promo_type` = '0', `u_promo_p_id` = '0' WHERE `u_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
			mysql_tquery ( sql_connection, query_string ) ;
	    }
	    else
		{
			update_int_sql ( playerid, "u_promo_hours", p_info [ playerid ] [ promo_hours ] ) ;
		}
	}
	return 1 ;
}

stock rewards_exp ( playerid, rew_exp, bool: status = false )
{
	if ( ! rew_exp ) return 1 ;

	new _t_string [ 156 ], player_level = p_info [ playerid ] [ level ] ;

	if ( status == true ) p_info [ playerid ] [ exp ] += rew_exp ;
	else p_info [ playerid ] [ exp ] += rew_exp * p_info [ playerid ] [ multiplication ] ;
	if ( p_info [ playerid ] [ exp ] >= ( player_level + 1 ) * 4 )
	{
		p_info [ playerid ] [ exp ] -= ( player_level + 1 ) * 4 ;
		p_info [ playerid ] [ level ] ++ ;
		p_info [ playerid ] [ age ] ++ ;
		SetPlayerScore ( playerid, p_info [ playerid ] [ level ] ) ;

	    give_inventory ( playerid, 2045, 1, 0, "", "", NUMBERPLATE_TYPE_NONE, 0 ) ;
		SendClientMessage ( playerid, col_yellow, !"* Вам был добавлен предмет 'Bronze рулетка'. Откройте инвентарь, используйте /mm или радиальное меню." ) ;

		#if defined m_perks
		p_info [ playerid ] [ perks ] ++ ;
		update_int_sql ( playerid, "u_perks", p_info [ playerid ] [ perks ] ) ;
		SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы получили 1 перк, введите {"#cGN"}/mm - Статистика персонажа - Перки{"#cWH"}, чтобы улучшить персонажа." ) ;
		#endif

		SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Ваш игровой уровень повысился." ) ;
	}
 	format ( _t_string, sizeof ( _t_string ), "UPDATE `users` SET `u_level` = '%d', `u_exp` = '%d' WHERE `u_id` = '%d' LIMIT 1", p_info [ playerid ] [ level ], p_info [ playerid ] [ exp ], p_info [ playerid ] [ id ] ) ;
	mysql_tquery ( sql_connection, _t_string ) ;

	if ( player_device { playerid } == 2 && p_info [ playerid ] [ hud_id ] ) SendCheckHud ( playerid ) ;
	return 1 ;
}

stock show_promo_info ( playerid )
{
    if ( ! p_info [ playerid ] [ promo_hours ] )
	{
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет активного промокода. Следите за новостями в группе." ) ;
		show_mainmenu ( playerid ) ;
		return 1 ;
	}

	global_string [ 0 ] = EOS ;
	new line_string [ 100 ] ;
	format ( line_string, sizeof line_string, "{"#cGRDialog"}До получения промокода: {"#cWH"}%d {"#cGRDialog"}час(ов).\n", p_info [ playerid ] [ promo_hours ] ) ;
	strcat ( global_string, line_string ) ;
	if ( p_info [ playerid ] [ promo_type ] == 1 )
	{
		strcat ( global_string, "{"#cGRDialog"}Тип приза: {"#cWH"}транспорт\n" ) ;

		format ( line_string, sizeof line_string, "{"#cGRDialog"}Модель: {"#cWH"}%s (%d)\n\n", GetVehicleNameEx ( INVALID_VEHICLE_ID, p_info [ playerid ] [ promo_p_id ] ), p_info [ playerid ] [ promo_p_id ] ) ;
		strcat ( global_string, line_string ) ;
	}
	else if ( p_info [ playerid ] [ promo_type ] == 2 )
	{
		strcat ( global_string, "{"#cGRDialog"}Тип приза: {"#cWH"}аксессуар\n" ) ;

		format ( line_string, sizeof line_string, "{"#cGRDialog"}Модель: {"#cWH"}%s (%d)\n\n", get_accessorie_name ( p_info [ playerid ] [ promo_p_id ] ), p_info [ playerid ] [ promo_p_id ] ) ;
		strcat ( global_string, line_string ) ;
	}
	else if ( p_info [ playerid ] [ promo_type ] == 3 )
	{
		strcat ( global_string, "{"#cGRDialog"}Тип приза: {"#cWH"}одежда\n" ) ;

		format ( line_string, sizeof line_string, "{"#cGRDialog"}Модель: {"#cWH"}#%d\n\n", p_info [ playerid ] [ promo_p_id ] ) ;
		strcat ( global_string, line_string ) ;
	}

	strcat ( global_string, "{"#cGRDialog"}* Приз будет Вашим навсегда.\n\n" ) ;
	strcat ( global_string, "{"#cGRDialog"}* Для учитывания часа Вам нужно отыграть\n{"#cGRDialog"}* 15 минут не выходя из игры и получить PayDay." ) ;
 	show_dialog ( playerid, d_mm_bonus, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Промокод", global_string, "Назад", "" ) ;
	return 1 ;
}

