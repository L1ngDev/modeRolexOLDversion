			if ( GetInventoryFindItem ( playerid, SUB_INVENTORY, 2159 ) + d_amount > 500 ) return show_dialog ( playerid, d_drug_dealer, DIALOG_STYLE_INPUT, "{"#cBHD"}Наркоторговец", "{"#cRD"}* Вы не можете унести более 500 гр. семян.\n\n{"#cWH"}Введите количество грамм семян, которое желаете приобрести:\n\n{"#cGRDialog"}* Стоимость 1 гр. семян составляет - {"#cWH"}50"valute_title"{"#cGRDialog"}.", "Купить", "Закрыть" ) ;
			if ( p_info [ playerid ] [ money ] < d_amount * 50 ) return show_dialog ( playerid, d_drug_dealer, DIALOG_STYLE_INPUT, "{"#cBHD"}Наркоторговец", "{"#cRD"}* У Вас нет такого количества денег.\n\n{"#cWH"}Введите количество грамм семян, которое желаете приобрести:\n\n{"#cGRDialog"}* Стоимость 1 гр. семян составляет - {"#cWH"}50"valute_title"{"#cGRDialog"}.", "Купить", "Закрыть" ) ;

			give_inventory ( playerid, 2159, d_amount, 0, "", "", NUMBERPLATE_TYPE_NONE, 0 ) ;
