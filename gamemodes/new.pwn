stock STREAMER_TAG_3D_TEXT_LABEL: _CreateDynamic3DTextLabel(const text[], color, Float:x, Float:y, Float:z, Float:drawdistance, attachedplayer = INVALID_PLAYER_ID, attachedvehicle = INVALID_VEHICLE_ID, testlos = 0, worldid = -1, interiorid = -1, playerid = -1, Float:streamdistance = STREAMER_3D_TEXT_LABEL_SD, STREAMER_TAG_AREA:areaid = STREAMER_TAG_AREA:-1, priority = 0)
{
	new Text3D: labelId = CreateDynamic3DTextLabel ( text, color, x, y, z, drawdistance, attachedplayer, attachedvehicle, testlos, worldid, interiorid, playerid, streamdistance, areaid, priority ) ;
 	Streamer_ToggleItemCallbacks ( STREAMER_TYPE_3D_TEXT_LABEL, labelId, 1 ) ;
	return labelId ;
}
#define CreateDynamic3DTextLabel _CreateDynamic3DTextLabel

stock _SetVehicleToRespawn ( vehicleid, reason )
{
    #if !defined debug_mode
	#pragma unused reason
	#endif
	if ( ! IsValidVehicle ( vehicleid ) ) return 1 ;
	if ( veh_info [ vehicleid - 1 ] [ v_model ] == 450 )return printf ( "[ERROR] SetVehicleToRespawn %d trailer", vehicleid ) ;

	#if defined debug_mode
		printf ( "[SetVehicleToRespawn] vehicleid: %d, reason: %d, v_type: %d", vehicleid, reason, veh_info [ vehicleid - 1 ] [ v_type ] ) ;
	#endif

	return SetVehicleToRespawn ( vehicleid ) ;
}
#define SetVehicleToRespawn _SetVehicleToRespawn

stock _AddStaticVehicleEx ( modelid, Float:spawn_x, Float:spawn_y, Float:spawn_z, Float:z_angle, color1, color2, respawn_delay, addsiren = 0)
{
	new vehicleid = AddStaticVehicleEx ( getReplacableVehicleCreate ( modelid ), spawn_x, spawn_y, spawn_z, z_angle, color1, color2, respawn_delay, addsiren ) ;

    veh_info [ vehicleid - 1 ] [ v_model ] = modelid ;
	veh_info [ vehicleid - 1 ] [ v_color ] [ 0 ] = color1 ;
	veh_info [ vehicleid - 1 ] [ v_color ] [ 1 ] = color2 ;
	veh_info [ vehicleid - 1 ] [ v_vehicle ] = vehicleid ;

	new Float: armour = 1000.0 ;
	veh_info [ vehicleid - 1 ] [ v_health ] = armour ;
	vehicleHealth [ vehicleid ] = armour ;
	SetVehicleHealth ( vehicleid, vehicleHealth [ vehicleid ] ) ;

	new engine, lights, alarm, doors, bonnet, boot, objective ;
	GetVehicleParamsEx ( vehicleid, engine, lights, alarm, doors, bonnet, boot, objective ) ;
	SetVehicleParamsEx ( vehicleid, engine, false, false, doors, false, false, objective ) ;

	SetVehicleDataAll ( vehicleid ) ;
	return vehicleid ;
}
#define AddStaticVehicleEx _AddStaticVehicleEx

stock _CreateVehicle ( vehicletype, Float: x, Float: y, Float: z, Float: rotation, color1, color2, respawn_delay, addsiren = 0 )
{
	new vehicleid = CreateVehicle ( getReplacableVehicleCreate ( vehicletype ), x, y, z, rotation, color1, color2, respawn_delay, addsiren ) ;

    veh_info [ vehicleid - 1 ] [ v_model ] = vehicletype ;
	veh_info [ vehicleid - 1 ] [ v_color ] [ 0 ] = color1 ;
	veh_info [ vehicleid - 1 ] [ v_color ] [ 1 ] = color2 ;
	veh_info [ vehicleid - 1 ] [ v_vehicle ] = vehicleid ;

    new Float: armour = 1000.0 ;
	veh_info [ vehicleid - 1 ] [ v_health ] = armour ;
	vehicleHealth [ vehicleid ] = armour ;
	SetVehicleHealth ( vehicleid, vehicleHealth [ vehicleid ] ) ;

	new engine, lights, alarm, doors, bonnet, boot, objective ;
	GetVehicleParamsEx ( vehicleid, engine, lights, alarm, doors, bonnet, boot, objective ) ;
	SetVehicleParamsEx ( vehicleid, engine, false, false, doors, false, false, objective ) ;

	SetVehicleDataAll ( vehicleid ) ;
	return vehicleid ;
}
#define CreateVehicle _CreateVehicle

stock _DestroyVehicle ( vehicleid, reason )
{
    #if !defined debug_mode
	#pragma unused reason
	#endif

	#if defined debug_mode
		printf ( "[DestroyVehicle] vehicleid: %d, reason: %d, v_type: %d", vehicleid, reason, veh_info [ vehicleid - 1 ] [ v_type ] ) ;
	#endif
	if ( ! IsValidVehicle ( vehicleid ) ) return 1 ;

	Iter_Clear(streamed_in_vehicles[vehicleid]);

	new _car_type = veh_info [ vehicleid - 1 ] [ v_type ] ;
	veh_info [ vehicleid - 1 ] [ v_type ] = vehicle_type_none ;

	veh_info [ vehicleid - 1 ] [ v_vehicle ] = INVALID_VEHICLE_ID ;

	#if defined m_streamsource
	if ( veh_info [ vehicleid - 1 ] [ v_sound ] != INVALID_PLAYER_ID )
	{
		new playerid = veh_info [ vehicleid - 1 ] [ v_sound ] ;
		if ( g_aStreamSources [ playerid ] [ eStreamID ] != -1 )
		{
			DestroyRecorder ( playerid ) ;
		}
	}
	#endif

	veh_info [ vehicleid - 1 ] [ v_owner ] = 0 ;
	veh_info [ vehicleid - 1 ] [ v_owner_id ] = INVALID_PLAYER_ID ;

	veh_info [ vehicleid - 1 ] [ v_rank ] = 0 ;
	veh_info [ vehicleid - 1 ] [ v_millage ] = 0.0 ;
	veh_info [ vehicleid - 1 ] [ v_legal_millage ] = 0.0 ;
	veh_info [ vehicleid - 1 ] [ v_health ] = 0.0 ;

	veh_info [ vehicleid - 1 ] [ v_sell_price ] =
	veh_info [ vehicleid - 1 ] [ v_sell_slot ] =
	veh_info [ vehicleid - 1 ] [ v_sell_carmarket ] =
	veh_info [ vehicleid - 1 ] [ v_int ] =

    veh_info [ vehicleid - 1 ] [ v_turn ] =
    veh_info [ vehicleid - 1 ] [ v_loading ] =
    veh_info [ vehicleid - 1 ] [ v_owner_fam ] =
    veh_info [ vehicleid - 1 ] [ v_date_used ] =
	veh_info [ vehicleid - 1 ] [ v_fine ] =
	veh_info [ vehicleid - 1 ] [ v_cargo ] =
	veh_info [ vehicleid - 1 ] [ v_spawn_time ] =
	veh_info [ vehicleid - 1 ] [ v_fine_time ] = 0 ;

	veh_info [ vehicleid - 1 ] [ v_pos ] [ 0 ] =
	veh_info [ vehicleid - 1 ] [ v_pos ] [ 1 ] =
	veh_info [ vehicleid - 1 ] [ v_pos ] [ 2 ] = 0.0 ;

	veh_info [ vehicleid - 1 ] [ v_sound ] =
	veh_info [ vehicleid - 1 ] [ v_jackcar ] =
	veh_info [ vehicleid - 1 ] [ v_driver ] =
	veh_info [ vehicleid - 1 ] [ v_renter ] = INVALID_PLAYER_ID ;

	veh_info [ vehicleid - 1 ] [ v_plate_type ] = 1 ;

	veh_info [ vehicleid - 1 ] [ v_admin ] = false ;
	veh_info [ vehicleid - 1 ] [ v_test_drive ] = false ;

	if ( IsValidDynamic3DTextLabel ( veh_info [ vehicleid - 1 ] [ v_sell_text ] ) )
	{
		DestroyDynamic3DTextLabel ( veh_info [ vehicleid - 1 ] [ v_sell_text ] ) ;
		veh_info [ vehicleid - 1 ] [ v_sell_text ] = Text3D:INVALID_3DTEXT_ID ;
	}
	if ( IsValidDynamic3DTextLabel ( veh_info [ vehicleid - 1 ] [ v_label ] ) )
	{
		DestroyDynamic3DTextLabel ( veh_info [ vehicleid - 1 ] [ v_label ] ) ;
		veh_info [ vehicleid - 1 ] [ v_label ] = Text3D:INVALID_3DTEXT_ID ;
 	}

	if ( IsValidDynamicPickup ( veh_info [ vehicleid - 1 ] [ v_pickup ] ) )
	{
		DestroyDynamicPickup ( veh_info [ vehicleid - 1 ] [ v_pickup ] ) ;
		veh_info [ vehicleid - 1 ] [ v_pickup ] = INVALID_PICKUP_ID ;
	}

	if ( IsValidDynamicObject ( veh_info [ vehicleid - 1 ] [ v_object ] ) )
	{
		DestroyDynamicObject ( veh_info [ vehicleid - 1 ] [ v_object ] ) ;
		veh_info [ vehicleid - 1 ] [ v_object ] = INVALID_OBJECT_ID ;
	}

    if ( _car_type == vehicle_type_player && IsValidDynamicObject ( veh_info [ vehicleid - 1 ] [ v_taxi_object ] ) )
	{
		DestroyDynamicObject ( veh_info [ vehicleid - 1 ] [ v_taxi_object ] ) ;
		veh_info [ vehicleid - 1 ] [ v_taxi_object ] = INVALID_OBJECT_ID ;
	}

	veh_info [ vehicleid - 1 ] [ v_cargo ] = 0 ;
	if ( veh_info [ vehicleid - 1 ] [ v_cargo_object ] [ 0 ] != INVALID_OBJECT_ID )
	{
		for ( new j = 0 ; j < 3 ; j ++ )
		{
		    if ( veh_info [ vehicleid - 1 ] [ v_cargo_object ] [ j ] == INVALID_OBJECT_ID ) continue ;
			DestroyDynamicObject ( veh_info [ vehicleid - 1 ] [ v_cargo_object ] [ j ] ) ;
			veh_info [ vehicleid - 1 ] [ v_cargo_object ] [ j ] = INVALID_OBJECT_ID ;
		}
	}

	return DestroyVehicle ( vehicleid ) ;
}
#define DestroyVehicle _DestroyVehicle

stock _SetVehicleHealth ( vehicleid, Float: health )
{
    new ret = GetVehicleDriverIDAC ( vehicleid ) ;
    if ( ret != 0xFFFF ) playerCheckRepair { ret } = SleepTime ( ret ) ;
	vehicleHealth [ vehicleid ] = health ;

 	veh_info [ vehicleid - 1 ] [ v_health ] = health ;
	return SetVehicleHealth ( vehicleid, health ) ;
}
#define SetVehicleHealth _SetVehicleHealth

stock _RepairVehicle ( vehicleid )
{
    if ( ! IsValidVehicle ( vehicleid ) ) return 1 ;
    new ret = GetVehicleDriverIDAC ( vehicleid ) ;
    if ( ret != 0xFFFF ) playerCheckRepair { ret } = SleepTime ( ret ) ;

    new Float: armour = 1000.0 ;
	veh_info [ vehicleid - 1 ] [ v_health ] = armour ;
	vehicleHealth [ vehicleid ] = armour ;

	return RepairVehicle ( vehicleid ), SetVehicleHealth ( vehicleid, vehicleHealth [ vehicleid ] ) ;
}

#define RepairVehicle _RepairVehicle

stock VehicleSpeed ( vehicleid )
{
    new Float: X,
		Float: Y,
		Float: Z ;

    GetVehicleVelocity ( vehicleid, X, Y, Z ) ;
    return floatround ( floatsqroot( X * X + Y * Y ) * 100.0 ) ;
}

stock _PutPlayerInVehicle ( playerid, vehicleid, seatid )
{
	if ( ! IsValidVehicle ( vehicleid ) ) return 0 ;

    AC_FORPLAYER(otherid) if(IsPlayerInVehicle(otherid, vehicleid) && seatid == GetPlayerVehicleSeat(otherid)) return 0;
    playerCheckFly{playerid} = SleepTime(playerid);
    playerVehicleEnter[playerid] = vehicleid;
	playerVehicleEnterTime[playerid] = GetTickDiffAC(GetTickCount(), (SleepTime(playerid) * 1000));
	player_vehicle [ playerid ] = vehicleid ;
	eev_called { playerid } = 1 ;
	opev_vehicleid [ playerid ] = vehicleid ;
	used_enter [ playerid ] = true ;

	p_t_info [ playerid ] [ last_alt ] = GetTickCount ( ) ;

	if ( gotome_player [ playerid ] != -1 )
	{
		police_gotome [ gotome_player [ playerid ] ] = -1 ;

		cuff_x [ playerid ] = cuff_y [ playerid ] = cuff_z [ playerid ] = 0.0 ;
	}

	return PutPlayerInVehicle ( playerid, vehicleid, seatid ), true ;
}
#define PutPlayerInVehicle _PutPlayerInVehicle

stock _SetVehiclePos ( vehicleid, Float:x, Float:y, Float:z )
{
	if ( ! IsValidVehicle ( vehicleid ) ) return 1 ;

    //foreach(new i: logged_players)
    foreach(new i: streamed_in_vehicles[vehicleid])
	{
		if ( IsPlayerInVehicle ( i, vehicleid ) )
		{
			playerCheckFly{i} = SleepTime(i);

			p_t_info [ i ] [ p_tp_immune_time ] = 4 ;
			p_t_info [ i ] [ real_pos ] [ 0 ] = x ;
			p_t_info [ i ] [ real_pos ] [ 1 ] = y ;
			p_t_info [ i ] [ real_pos ] [ 2 ] = z ;

			p_t_info [ i ] [ last_alt ] = GetTickCount ( ) ;
		}
	}
	veh_info [ vehicleid - 1 ] [ v_now_pos ] [ 0 ] = x ;
 	veh_info [ vehicleid - 1 ] [ v_now_pos ] [ 1 ] = y ;
	veh_info [ vehicleid - 1 ] [ v_now_pos ] [ 2 ] = z ;
	SetVehicleHealth ( vehicleid, vehicleHealth[vehicleid] ) ;
    SetVehiclePos ( vehicleid, x, y, z ) ;
    return 1;
}
#define SetVehiclePos _SetVehiclePos

stock _RemovePlayerFromVehicle ( playerid )
{
	switch ( GetVehicleModel ( GetPlayerVehicleID ( playerid ) ) )
	{
		case 0, 441, 464, 465, 501, 564, 594: return 0 ;
	}
	playerRemoveVehicle { playerid } = ( 2 + SleepTime ( playerid ) ) ;

	new Float: pos_x, Float: pos_y, Float: pos_z ;
	GetPlayerPos ( playerid, pos_x, pos_y, pos_z ) ;

    remove_timer { playerid } = 15 ;
    RemovePlayerFromVehicle ( playerid ) ;
	return 1 ;
}

#define RemovePlayerFromVehicle _RemovePlayerFromVehicle

stock CanWeCheck ( playerid )
{
	if ( ( p_t_info [ playerid ] [ p_update ] - p_t_info [ playerid ] [ last_alt ] ) > 2000 ) return 1 ;
	return 0 ;
}

