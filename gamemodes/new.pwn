stock ShowAmmoDialog ( playerid, type )
{
    if ( type == 1 )
	{
	    if ( ! GetPVarInt ( playerid, "p_biz_id" ) ) return bad_exit ( playerid ) ;
		new b = GetPVarInt ( playerid, "p_biz_id" ) - 1 ;

		if ( mafia_player ( playerid ) )
		{
			if ( b_info [ b ] [ b_mafia ] == p_info [ playerid ] [ member ] )
			{
			    SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Этот бизнес под Вашим контролем. У Вас имеется скидка в 50%%." ) ;
			}
		}

		if ( player_device { playerid } == 2 )
		{
            show_ammo_packet ( playerid ) ;
			toggle_controlable ( playerid, false ) ;
		}
		else
		{
		    global_string [ 0 ] = EOS ;
			strcat ( global_string, "{"#cBL"}Товар:\t{"#cBL"}Цена:\n" ) ;
			for ( new i = 0 ; i < MAX_AMMO_IN_SHOP ; i ++ )
			{
			    format ( global_string, sizeof global_string, "%s{"#cGRDialog"}- {"#cWH"}%s\t{"#cGN"}%d"valute_title_"\n", global_string, b_gun_shop [ i ] [ bs_name ], b_price_market [ b ] [ i ] ) ;
			}
			show_dialog ( playerid, d_ammo_shop, DIALOG_STYLE_TABLIST_HEADERS, "{"#cBHD"}Аммуниция", global_string, "Купить", "Закрыть" ) ;
		}
	}
	else if ( type == 2 )
	{
	    new b ;
		if ( p_info [ playerid ] [ business ] ) b = p_info [ playerid ] [ business ] - 1 ;
		else b = p_info [ playerid ] [ b_worker ] - 1 ;

		global_string [ 0 ] = EOS ;
		strcat ( global_string, "{"#cBL"}Товар:\t{"#cBL"}Цена:\t{"#cBL"}Продуктов за товар:\t{"#cBL"}Прибыль с продажи:\n" ) ;
		for ( new i = 0 ; i < MAX_AMMO_IN_SHOP ; i ++ )
		{
		    format ( global_string, sizeof global_string, "%s{"#cGRDialog"}- {"#cWH"}%s\t{"#cGN"}%d"valute_title_" {"#cGRDialog"}(рек.: %d"valute_title_")\t{"#cWH"}%d ед.\t{"#cGN"}%d"valute_title_"\n",
			global_string, b_gun_shop [ i ] [ bs_name ], b_price_market [ b ] [ i ], get_b_price_market ( i, b ), b_gun_shop [ i ] [ bs_product ], floatround ( b_price_market [ b ] [ i ] - ( b_gun_shop [ i ] [ bs_product ] * 3 ) ) ) ;
		}
		show_dialog ( playerid, d_bpanel_cost_market, DIALOG_STYLE_TABLIST_HEADERS, "{"#cBHD"}Наценка на товар", global_string, "Выбрать", "Закрыть" ) ;
	}
	return 1 ;
}

