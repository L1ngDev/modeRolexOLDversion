			if ( player_duel [ playerid ] [ duel_gun ] [ 1 ] != 0 ) give_weapon(playerid, player_duel [ playerid ] [ duel_gun ] [ 1 ], 999);
			if ( player_duel [ playerid ] [ duel_gun ] [ 2 ] != 0 ) give_weapon(playerid, player_duel [ playerid ] [ duel_gun ] [ 2 ], 999);

