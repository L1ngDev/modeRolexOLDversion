			}
			if ( listitem == 0 )
			{
			    new query_string [ 62 + 9 + 4 ] ;
				format ( query_string, sizeof ( query_string ),"SELECT `h_id` FROM `houses` WHERE `h_owner` = '%d' LIMIT %d", GetPVarInt ( playerid, "debt_uid" ), max_h_gold ) ;
				mysql_tquery ( sql_connection, query_string, "get_player_house_sellstatus", "ii", playerid, 1 ) ;
