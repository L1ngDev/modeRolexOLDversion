					PutPlayerInVehicle ( playerid, veh_id, 0 ) ;
					SetPlayerArmedWeapon ( playerid, 0 ) ;
	            }
				case 3:
				{
	                if ( ! bad_dialog ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGR"}К сожалению, я не могу Вас заспавнить, т.к. у Вас открыт диалог / проходит сделка." ) ;
					if ( p_info [ playerid ] [ jailed ] > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGR"}Вы в КПЗ. Если Вы не об этом, то перефразируйте обращение." ) ;
					if ( p_t_info [ playerid ] [ last_time_damage_spawn ] > gettime ( ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGR"}К сожалению, я не могу Вас заспавнить, т.к. Вы находились / находитесь в перестрелке." ) ;
					if ( target_cuff [ playerid ] != INVALID_PLAYER_ID || target_tie [ playerid ] != INVALID_PLAYER_ID ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGR"}К сожалению, я не могу Вас заспавнить, т.к. на Вас наручники или Вы связаны." ) ;
					if ( player_tie [ playerid ] != INVALID_PLAYER_ID || player_cuff [ playerid ] != INVALID_PLAYER_ID || police_check_time [ playerid ] > gettime ( ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGR"}К сожалению, я не могу Вас заспавнить, т.к. Вы учавствуете в РП процессе." ) ;

				    new veh_id = GetPlayerVehicleID ( playerid ) ;
					if ( veh_id == 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRDialog"}Я не могу Вам помочь, т.к. Вы не в машине." ) ;
					if ( GetPlayerVehicleSeat ( playerid ) != 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRDialog"}Чтобы я помог перевернуть Ваше т/с должен обратиться сам водитель." ) ;
				    new Float: X, Float: Y, Float: Z, Float: Angle ;
					GetVehiclePos ( veh_id, X, Y, Z ) ;
					GetVehicleZAngle ( veh_id, Angle ) ;
					SetVehiclePos ( veh_id, X, Y, Z + 1.5 ) ;
					SetVehicleZAngle ( veh_id, Angle ) ;
				}
				case 4:
				{
				    new veh_id = GetPlayerVehicleID ( playerid ) ;
					if ( veh_id != 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRDialog"}Вы в машине, я не могу Вам помочь." ) ;

					new bool: _finded_cars = false ;
					foreach(new _veh_id: player_vehicles[playerid])
					{
					    if ( ! IsPlayerInRangeOfPoint ( playerid, 30.0, veh_info [ _veh_id - 1 ] [ v_now_pos ] [ 0 ], veh_info [ _veh_id - 1 ] [ v_now_pos ] [ 1 ], veh_info [ _veh_id - 1 ] [ v_now_pos ] [ 2 ] ) ) continue ;

		                veh_id = _veh_id ;
						_finded_cars = true ;
						break ;
					}

					if ( _finded_cars == true )
					{
				        new Float: veh_pos [ 3 ] ;
						GetPlayerPos ( playerid, veh_pos [ 0 ], veh_pos [ 1 ], veh_pos [ 2 ] ) ;
						SetVehiclePos ( veh_id, veh_pos [ 0 ] - 4, veh_pos [ 1 ], veh_pos [ 2 ] + 1 ) ;

						SetVehicleVirtualWorld ( veh_id, GetPlayerVirtualWorld ( playerid ) ) ;
						LinkVehicleToInterior ( veh_id, GetPlayerInterior ( playerid ) ) ;
					}
					else
					{
					    veh_id = INVALID_VEHICLE_ID ;
						if ( player_rentcar [ playerid ] != INVALID_VEHICLE_ID ) veh_id = player_rentcar [ playerid ] ;
						else
						{
						    if ( player_vehicle [ playerid ] != INVALID_VEHICLE_ID && veh_info [ player_vehicle [ playerid ] - 1 ] [ v_type ] == vehicle_type_server )
								veh_id = player_vehicle [ playerid ] ;
						}

						if ( veh_id == INVALID_VEHICLE_ID ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRDialog"}Рядом с Вами нет Вашего личного / рабочего т/с." ) ;

						if ( IsPlayerInRangeOfPoint ( playerid, 30.0, veh_info [ veh_id - 1 ] [ v_now_pos ] [ 0 ], veh_info [ veh_id - 1 ] [ v_now_pos ] [ 1 ], veh_info [ veh_id - 1 ] [ v_now_pos ] [ 2 ] ) ) // 2.5
						{
							new Float: veh_pos [ 3 ] ;
							GetPlayerPos ( playerid, veh_pos [ 0 ], veh_pos [ 1 ], veh_pos [ 2 ] ) ;
							SetVehiclePos ( veh_id, veh_pos [ 0 ] - 4, veh_pos [ 1 ], veh_pos [ 2 ] + 1 ) ;

							SetVehicleVirtualWorld ( veh_id, GetPlayerVirtualWorld ( playerid ) ) ;
							LinkVehicleToInterior ( veh_id, GetPlayerInterior ( playerid ) ) ;
							return 1 ;
						}
						else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRDialog"}Рядом с Вами нет Вашего личного / рабочего т/с." ) ;
					}
				}
				case 5:
				{
					SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRDialog"}Администрация не следит за сделками." ) ;
					SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRDialog"}Используйте /gps - Бизнесы - Риелторское агентство. Там Вы сможете совершить безопасный обмен." ) ;
				}
	        }
	        return 1 ;
	    }
	    case d_spawn_report:
	    {
	        if ( ! response ) return 1 ;

	        SpawnPlayer ( playerid ) ;
	        return 1 ;
	    }
	    case d_sp_kick:
	    {
	        if ( ! response ) return 1 ;

	        new target_id = admin_info [ playerid ] [ spectate_id ] ;
			if ( strlen ( inputtext ) < 3 || strlen ( inputtext ) > 32 )
			{
			    if ( target_id != -1 )
			    {
			        new org_string [ 48 ], rang_string [ 48 ], _f_id = p_info [ target_id ] [ member ], _rank_id = p_info [ target_id ] [ rank ] ;
			        if ( _f_id > 0 ) format ( org_string, sizeof org_string, "{%s}%s", f_info [ _f_id - 1 ] [ f_chat_color ], f_info [ _f_id - 1 ] [ f_name ] ) ;
					else format ( org_string, sizeof org_string, "{"#cRD"}Нет" ) ;

			        if ( _f_id > 0 && _rank_id > 0 ) format ( rang_string, sizeof rang_string, "%s (%d)", f_rank [ _f_id - 1 ] [ _rank_id - 1 ], _rank_id ) ;
