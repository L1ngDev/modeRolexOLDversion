	PlayerTextDrawHide ( playerid, satiery_ptd [ playerid ] [ 0 ] ) ;
	PlayerTextDrawShow ( playerid, satiery_ptd [ playerid ] [ 0 ] ) ;

	for ( new j = 0 ; j < 14 ; j ++ )
	{
		TextDrawShowForPlayer ( playerid, satiery_td [ j ] ) ;
		if ( j < 6 ) PlayerTextDrawShow ( playerid, satiery_ptd [ playerid ] [ j ] ) ;
	}
	hunger_td_active [ playerid ] = true ;

	p_t_info [ playerid ] [ hunger_timer ] = SetTimerEx ( "clear_hunger_td", 2000, false, "d", playerid ) ;
	return 1 ;
}

callback: barrier_callback ( j )
{
	barrier_status [ j ] = false ;
	MoveDynamicObject ( barrier_object [ j ], barrier_pos [ j ] [ close_bar ] [ 0 ],
												barrier_pos [ j ] [ close_bar ] [ 1 ],
												barrier_pos [ j ] [ close_bar ] [ 2 ],
												barrier_pos [ j ] [ speed_bar ],
												barrier_pos [ j ] [ close_bar ] [ 3 ],
												barrier_pos [ j ] [ close_bar ] [ 4 ],
												barrier_pos [ j ] [ close_bar ] [ 5 ] ) ;
	return 1 ;
}

callback: door_callback ( j )
{
	door_status [ j ] = false ;
	MoveDynamicObject ( door_object [ j ],
						door_pos [ j ] [ close_doors ] [ 0 ],
						door_pos [ j ] [ close_doors ] [ 1 ],
						door_pos [ j ] [ close_doors ] [ 2 ],
						door_pos [ j ] [ speed_doors ],
						door_pos [ j ] [ close_doors ] [ 3 ],
						door_pos [ j ] [ close_doors ] [ 4 ],
						door_pos [ j ] [ close_doors ] [ 5 ] ) ;
	return 1 ;
}

callback: robbery_door_close ( playerid, doors_select, _bank_id )
{
    robbery_door_open [ doors_select ] = false ;

    for ( new d = 0 ; d < sizeof bank_robbery_area ; d ++ )
    {
		if ( IsValidDynamicArea ( bank_robbery_area [ _bank_id ] [ d ] ) ) DestroyDynamicArea ( bank_robbery_area [ _bank_id ] [ d ] ) ;
		if ( IsValidDynamicPickup ( bank_robbery_pickup [ _bank_id ] [ d ] ) ) DestroyDynamicPickup ( bank_robbery_pickup [ _bank_id ] [ d ] ) ;
	}

	#if defined SAMP
	MoveDynamicObject ( doors_select, robbery_doors [ doors_select ] [ 0 ], robbery_doors [ doors_select ] [ 1 ], robbery_doors [ doors_select ] [ 2 ],
										2.0, robbery_doors [ doors_select ] [ 3 ], robbery_doors [ doors_select ] [ 4 ], robbery_doors [ doors_select ] [ 5 ] ) ;
	#endif
	return 1 ;
}

callback: getDebtorsInfo ( playerid, page, init )
{
    if ( init )
    {
		static const _str [ ] = "SELECT u_name, u_tax FROM users WHERE u_tax > "tax_limit_bit_txt" ORDER BY users.u_tax DESC LIMIT 10 OFFSET %d" ;
		new query_string [ sizeof _str + ( 9 * 2 ) ] ;
        format ( query_string, sizeof query_string, _str, page * 10 ) ;
        mysql_tquery ( sql_connection, query_string, "getDebtorsInfo", "iii", playerid, page, 0 ) ;
    }
    else
    {
		page_count [ playerid ] = page ;

        new rows, fields ;
		cache_get_data ( rows, fields ) ;

		if ( ! rows )
		{
			send_check_cinfo ( playerid, "Ничего не найдено!", 0, 3, CINFO_OTHER_ID, PICTURE_INFO_ERROR, "", "" ) ;
			return 1 ;
		}

        new playerName [ MAX_PLAYER_NAME ], taxMoney ;

		global_string [ 0 ] = EOS ;
		strcat ( global_string, "{"#cBL"}Игрок:\t{"#cBL"}Сумма долга:\n" ) ;
		for ( new i = 0 ; i < rows ; i ++ )
		{
			cache_get_field_content ( i, "u_name", playerName ) ;
			taxMoney = cache_get_field_content_int ( i, "u_tax" ) ;

			new pvar_string [ 8 ] ;
			format ( pvar_string, sizeof ( pvar_string ), "ofm_%d", i ) ;
			SetPVarString ( playerid, pvar_string, playerName ) ;

			format ( global_string, sizeof global_string, "%s{"#cWH"}%s\t{"#cTN"}%s"valute_title_"\n",
			global_string, playerName, GetPlayerCashValueToSmile ( taxMoney ) ) ;
		}

		if ( page > 0 ) strcat ( global_string, "{"#cBL"}Предыдущая страница\n" ) ;
		if ( rows == 10 ) strcat ( global_string, "{"#cBL"}Следующая страница" ) ;

		show_dialog ( playerid, d_debtors_list, DIALOG_STYLE_TABLIST_HEADERS, "{"#cBHD"}Список должников", global_string, "Выбрать", "Назад" ) ;
    }
    return true ;
}

callback: callback_debtor_info ( playerid )
{
	new pl_tax, pl_cellar, db_money ;
	pl_tax = cache_get_field_content_int ( 0, "u_tax" ) ;
	pl_cellar = cache_get_field_content_int ( 0, "u_cellar" ) ;
	db_money = cache_get_field_content_int ( 0, "db_money" ) ;

	new pvar_string [ 48 ], pl_name [ MAX_PLAYER_NAME ] ;
	format ( pvar_string, sizeof ( pvar_string ), "ofm_%d", GetPVarInt ( playerid, "ofm_listitem" ) ) ;
	GetPVarString ( playerid, pvar_string, pl_name, MAX_PLAYER_NAME ) ;

	new garage_date [ 64 ];
	if ( pl_cellar != -1 )format ( garage_date, 64, "гараж № %d (%d"valute_title_")", pl_cellar, cellar_info [ pl_cellar - 1 ] [ cl_price ] ) ;
	else format ( garage_date, 64, "отсутствует" ) ;

	global_string [ 0 ] = EOS ;
	format ( global_string, sizeof ( global_string ), "\
		{"#cWH"}Имя: {"#cGRDialog"}%s\n\
		{"#cWH"}Задолженность: {"#cGRDialog"}%d"valute_title_"\n\
		{"#cWH"}Дом: {"#cGRDialog"}%d шт.\n\
		{"#cWH"}Бизнес: {"#cGRDialog"}%d шт.\n\
		{"#cWH"}Гараж: {"#cGRDialog"}%s\n\
		{"#cWH"}Средств в банке: {"#cGRDialog"}%d"valute_title_"",
	pl_name, pl_tax, debt_house_count [ playerid ], debt_business_count [ playerid ], garage_date, db_money ) ;

	show_dialog ( playerid, d_debtor_info, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Информация об игроке", global_string, "Назад", "" ) ;
	return 1 ;
}

