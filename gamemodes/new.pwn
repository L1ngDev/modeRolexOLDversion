		WHERE TABLE_SCHEMA = '%s' AND TABLE_NAME = 'users_skins_stats'", server_info [ server_number - 1 ] [ database ] ) ;
	mysql_tquery ( sql_connection, query_string, "callback_last_users_skin" ) ;

	mysql_tquery ( sql_connection, !"SELECT * FROM `users_inventory` ORDER BY `users_inventory`.`id` DESC LIMIT 1", "callback_last_prise" ) ;
	mysql_tquery ( sql_connection, !"SELECT * FROM `users_contacts` ORDER BY `users_contacts`.`inc_id` DESC LIMIT 1", "callback_last_contacts" ) ;
	mysql_tquery ( sql_connection, !"SELECT * FROM `users_vehicles_inventory` ORDER BY `users_vehicles_inventory`.`id` DESC LIMIT 1", "callback_last_prise_vehicle" ) ;
	mysql_tquery ( sql_connection, !"SELECT * FROM `houses_inventory` ORDER BY `houses_inventory`.`id` DESC LIMIT 1", "callback_last_prise_house" ) ;
	mysql_tquery ( sql_connection, !"SELECT * FROM `fractions_inventory` ORDER BY `fractions_inventory`.`id` DESC LIMIT 1", "callback_last_prise_fractions" ) ;
	mysql_tquery ( sql_connection, !"SELECT * FROM `users_market_place` ORDER BY `users_market_place`.`id` DESC LIMIT 1", "last_market_place" ) ;

	mysql_tquery ( sql_connection, !"SELECT * FROM `punishment_kick`", "punishment_kick_loading" ) ;
	mysql_tquery ( sql_connection, !"SELECT * FROM `punishment_jail`", "punishment_jail_loading" ) ;
	mysql_tquery ( sql_connection, !"SELECT * FROM `punishment_warn`", "punishment_warn_loading" ) ;
	mysql_tquery ( sql_connection, !"SELECT * FROM `punishment_ban`", "punishment_ban_loading" ) ;
	mysql_tquery ( sql_connection, !"SELECT * FROM `punishment_mute`", "punishment_mute_loading" ) ;

	mysql_tquery ( sql_connection, !"SELECT * FROM `vehicle_handling`", "vehicle_handling_loading" ) ;
	mysql_tquery ( sql_connection, !"SELECT \
									vl.*, vc.* \
