		 	else if ( _qs == k && _qstatus == 2 ) format ( line_string, sizeof ( line_string ), "{"#cBL"}%d. {"#cWH"}%s\t%s\n", _quest_id, quest_info_2 [ k ] [ q_name ], status_names [ 2 ] ) ;
		 	else format ( line_string, sizeof ( line_string ), "{"#cBL"}%d. {"#cWH"}%s\t%s\n", _quest_id, quest_info_2 [ k ] [ q_name ], status_names [ 0 ] ) ;
			strcat ( global_string, line_string ) ;
