				        strcat ( global_string, "{"#cBInfo"}* {"#cWH"}У Вас нет дополнительных налогов за бизнес.\n" ) ;
				    }
				    else
				    {
					    foreach(new b: player_business[playerid])
					    {
					        new business_tax = floatround ( b_info [ b - 1 ] [ b_price ] / 250 ) * for_tax [ 4 ] ;
							if ( b_info [ b - 1 ] [ b_improve ] [ 0 ] ) business_tax = floatround ( b_info [ b - 1 ] [ b_price ] / 350 ) * for_tax [ 4 ] ;

					        format ( line_string, sizeof line_string, "{"#cBInfo"}* {"#cWH"}Бизнес %s (№%d) - {"#cGN"}%d"valute_title_"\n", b_types [ b_info [ b - 1 ] [ b_type ] ], b_info [ b - 1 ] [ b_id ], business_tax ) ;
					        strcat ( global_string, line_string ) ;
					    }
					}

					if ( p_info [ playerid ] [ cellar ] == -1 ) strcat ( global_string, "{"#cBInfo"}* {"#cWH"}У Вас нет дополнительных налогов за гараж.\n" ) ;
					else
					{
					    new cellar_id = p_info [ playerid ] [ cellar ] ;
						format ( line_string, sizeof line_string, "{"#cBInfo"}* {"#cWH"}Гараж №%d - {"#cGN"}%d"valute_title_"\n", cellar_info [ cellar_id - 1 ] [ cl_id ], floatround ( cellar_info [ cellar_id - 1 ] [ cl_price ] / 350 ) * for_tax [ 10 ] ) ;
					    strcat ( global_string, line_string ) ;
					}

					strcat ( global_string, "\n{"#cBL"}** Транспорт **\n\n" ) ;

					if ( ! Iter_Count(player_vehicles[playerid]) )
				    {
				        strcat ( global_string, "{"#cBInfo"}* {"#cWH"}У Вас нет дополнительных налогов за транспорт.\n" ) ;
				    }
				    else
				    {
				        new tax_player ;
					    foreach(new veh_id: player_vehicles[playerid])
					    {
					        if ( veh_info [ veh_id - 1 ] [ v_vw ] > 0 )
							{
								if ( p_info [ playerid ] [ family ] )
							    {
							    	new family_id = p_info [ playerid ] [ family ] ;
									if ( family_info [ family_id - 1 ] [ fam_enhancement ] [ 2 ] )
									{
									    tax_player = 100 * for_tax [ 5 ] ;
									}
									else tax_player = 300 * for_tax [ 5 ] ;
								}
						    	else tax_player = 300 * for_tax [ 5 ] ;
							}
						    else
							{
							    if ( p_info [ playerid ] [ family ] )
							    {
							    	new family_id = p_info [ playerid ] [ family ] ;
									if ( family_info [ family_id - 1 ] [ fam_enhancement ] [ 2 ] )
									{
									    tax_player = 300 * for_tax [ 5 ] ;
									}
									else tax_player = 700 * for_tax [ 5 ] ;
								}
						    	else tax_player = 700 * for_tax [ 5 ] ;
							}

					        format ( line_string, sizeof line_string, "{"#cBInfo"}* {"#cWH"}%s - {"#cGN"}%d"valute_title_"\n", GetVehicleNameEx ( veh_id ), tax_player ) ;
					        strcat ( global_string, line_string ) ;
					    }
					}

					strcat ( global_string, "\n{"#cRInfo"}* {"#cGRInfo"}Налог на имущество начисляется раз в сутки.\n" ) ;
					strcat ( global_string, "{"#cRInfo"}* {"#cGRInfo"}Налог на транспорт начисляется каждый час.\n\n" ) ;
					strcat ( global_string, "{"#cRInfo"}* {"#cGRInfo"}Мэрия может опечатать (подготовить к продаже) Ваше имущество\n" ) ;
					strcat ( global_string, "{"#cRInfo"}* {"#cGRInfo"}если Ваш долг по налогу превысит "tax_limit".\n" ) ;

					show_dialog ( playerid, d_bank_info, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Налогооблажение", global_string, "Назад", "Закрыть" ) ;
				}
				case 3:
		        {
		            new d_string [ 148 ] ;
					format ( d_string, sizeof ( d_string ), "{"#cWH"}Ваша задолженность по кредиту составляет {"#cBL"}%s"valute_title_"\n\n{"#cGRDialog"}* Введите сумму, которую желаете внести в счёт уплаты кредита:",
					GetPlayerCashValueToSmile ( bank_info [ playerid ] [ bi_credit ] [ get_player_use_listitem ( playerid ) ] ) ) ;
					show_dialog ( playerid, d_bank_pay_credit, DIALOG_STYLE_INPUT, "{"#cBHD"}Оплата кредита", d_string, "Принять", "Назад" ) ;
				}
			}
			return 1 ;
		}
		case d_bank_pay_credit:
		{
		    if ( ! response )
			{
			    show_debtors_bank ( playerid ) ;
			    return 1 ;
			}

			new deposit_id = get_player_use_listitem ( playerid ) ;
			new plprice = strval ( inputtext ) ;
			if ( plprice < 1 )
			{
			    new d_string [ 148 ] ;
				format ( d_string, sizeof ( d_string ), "{"#cRD"}* Сумма платежа не может быть меньше 1"valute_title_"\n\n{"#cGRDialog"}Ваша задолженность по кредиту составляет {"#cBL"}%s"valute_title_"\n\n{"#cWH"}Введите сумму, которую желаете внести в счёт уплаты кредита:",
				GetPlayerCashValueToSmile ( bank_info [ playerid ] [ bi_credit ] [ deposit_id ] ) ) ;
