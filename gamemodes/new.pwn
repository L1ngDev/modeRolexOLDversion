		    new Float: player_pos [ 3 ] ;
		    GetPlayerPos ( playerid, player_pos [ 0 ], player_pos [ 1 ], player_pos [ 2 ] ) ;
		    for ( new i = 0 ; i < MAX_ADM_PICKUP ; i ++ )
		    {
		        if ( adm_pickup [ i ] ) continue ;
		    	adm_pickup [ i ] = CreateDynamicPickup ( pickups_ids [ listitem ], 23, player_pos [ 0 ], player_pos [ 1 ], player_pos [ 2 ], -1, -1 ) ;
		    	pick_info [ adm_pickup [ i ] ] [ pick_model ] = pickups_ids [ listitem ] ;
      			pick_info [ adm_pickup [ i ] ] [ pick_type ] = pick_type_admin ;
				break ;
			}
			return 1 ;
		}
		case d_mp_pickup_delete:
		{
		    if ( ! response ) return callcmd::mp ( playerid ) ;

			new select_id = get_player_listitem_values ( playerid, listitem ) ;
			clear_player_listitem_values ( playerid ) ;

		    if ( IsValidDynamicPickup ( adm_pickup [ select_id ] ) ) DestroyDynamicPickup ( adm_pickup [ select_id ] ) ;
		    pick_info [ adm_pickup [ select_id ] ] [ pick_type ] = pick_type_none ;
		    pick_info [ adm_pickup [ select_id ] ] [ pick_model ] = 0 ;
		    adm_pickup [ select_id ] = INVALID_PICKUP_ID ;
			return 1 ;
		}
