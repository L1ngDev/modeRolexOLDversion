	#endif

	mysql_tquery ( sql_connection, !"SELECT * FROM `deposit_boxes` WHERE `db_type` = '1' ORDER BY `deposit_boxes`.`db_id` DESC LIMIT 1", "callback_pay_card" ) ;
	mysql_tquery ( sql_connection, !"SELECT * FROM `deposit_boxes` WHERE `db_type` = '2' ORDER BY `deposit_boxes`.`db_id` DESC LIMIT 1", "callback_gold_card" ) ;
	mysql_tquery ( sql_connection, !"SELECT * FROM `deposit_boxes` WHERE `db_type` = '3' ORDER BY `deposit_boxes`.`db_id` DESC LIMIT 1", "callback_credit_card" ) ;

	mysql_tquery ( sql_connection, !"SELECT * FROM `logs_report` ORDER BY `logs_report`.`r_id` DESC LIMIT 1", "callback_report" ) ;

