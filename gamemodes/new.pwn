stock clear_stoped_params ( playerid, targetid )
{
    player_cuff [ playerid ] =
	player_tie [ playerid ] =
	target_tie [ playerid ] =
	target_cuff [ targetid ] =
	player_tie [ targetid ] =
	target_tie [ targetid ] = INVALID_PLAYER_ID ;
	return 1 ;
}

