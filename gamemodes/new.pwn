			{
				show_dialog ( playerid, d_donate_sex, DIALOG_STYLE_INPUT, "{"#cBHD"}Донат услуги","{"#cRD"}* У Вас недостаточно средств для приобретения данной услуги.\n\n{"#cGRDialog"}- {"#cWH"}Смена пола:\n\n{"#cGRDialog"}* Цена: {"#cGN"}50 "donate_title"{"#cGRDialog"}.\n{"#cGRDialog"}* Вы действительно хотите сменить Ваш \"{"#cWH"}Пол{"#cGRDialog"}\"?","Принять", "Назад");
				return 1 ;
