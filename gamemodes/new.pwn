	if ( ! gang_player ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команда доступна только бандам." ) ;
	show_dialog ( playerid, d_gangtop, DIALOG_STYLE_LIST, "{"#cBHD"}Список лучших", "{"#cGRDialog"}- {"#cWH"}Лучшие стрелки\n{"#cGRDialog"}- {"#cWH"}Топ захватчиков", "Выбрать", "Назад" ) ;
