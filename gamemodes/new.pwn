						show_dialog(playerid, d_barn_take, DIALOG_STYLE_INPUT, "{"#cBHD"}Амбар", "{"#cWH"}Количество наркотиков которое хотите взять:", "Взять", "Отмена");
					}
					else
					{
						inputtext [ 1 ] = inputtext [ 0 ] * 50 ;
				   		if ( GetInventoryFindItem ( playerid, SUB_INVENTORY, 2155 ) + inputtext [ 0 ] > 500 )
				   		{
				   		    SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете иметь более 500 грамм." ) ;
