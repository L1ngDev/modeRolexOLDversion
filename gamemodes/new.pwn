{
    new rows, fields ;
	cache_get_data ( rows, fields ) ;

	new _query_string [ 144 ] ;
	if ( ! rows )
	{
	    format ( _query_string, sizeof _query_string, "INSERT INTO `users_casino` (`u_id`,`u_name`,`u_casino`,`u_activity_casino`) VALUES ('%d','%s','%d','1')",
		p_info [ playerid ] [ id ], p_info [ playerid ] [ name ], b_info [ b ] [ b_id ] ) ;
		mysql_tquery ( sql_connection, _query_string ) ;
	}
	else
	{
		format(_query_string, sizeof _query_string, "UPDATE `users_casino` SET `u_activity_casino` = `u_activity_casino`+'1' WHERE `u_id` = '%d' AND `u_casino` = '%d' LIMIT 1",
		p_info [ playerid ] [ id ], b_info [ b ] [ b_id ] ) ;
