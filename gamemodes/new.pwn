stock n_ChangeVehicleColor ( vehicleID, color1, color2 )
{
	veh_info [ vehicleID - 1 ] [ v_color ] [ 0 ] = color1 ;
	veh_info [ vehicleID - 1 ] [ v_color ] [ 1 ] = color2 ;
	return ChangeVehicleColor ( vehicleID, color1, color2 ) ;
}

stock GetVehicleColor(vehicleID, &color1, &color2)
{
	color1 = veh_info [ vehicleID - 1 ] [ v_color ] [ 0 ] ;
	color2 = veh_info [ vehicleID - 1 ] [ v_color ] [ 1 ] ;
	return 1 ;
}

stock _AddStaticVehicle ( modelid, Float: spawn_x, Float: spawn_y, Float: spawn_z, Float: z_angle, color1, color2 )
{
	new vehicleid = AddStaticVehicle ( getReplacableVehicleCreate ( modelid ), spawn_x, spawn_y, spawn_z, z_angle, color1, color2 ) ;
	veh_info [ vehicleid - 1 ] [ v_model ] = modelid ;
	veh_info [ vehicleid - 1 ] [ v_color ] [ 0 ] = color1 ;
	veh_info [ vehicleid - 1 ] [ v_color ] [ 1 ] = color2 ;
	veh_info [ vehicleid - 1 ] [ v_health ] = 1000.0 ;
	vehicleHealth [ vehicleid ] = 1000.0 ;
	SetVehicleDataAll ( vehicleid ) ;
	return vehicleid ;
}
#define AddStaticVehicle _AddStaticVehicle

stock _SetSpawnInfo ( playerid, team_player, skin_player, Float:X, Float:Y, Float:Z, Float:Angle, weapon1, weapon1_ammo, weapon2, weapon2_ammo, weapon3, weapon3_ammo )
{
    #if defined debug_mode
		printf ( "[DEBUG] [_SetSpawnInfo] playerid:%d", playerid ) ;
	#endif
    playerCheckFly{playerid} = SleepTime(playerid);
	return SetSpawnInfo ( playerid, team_player, skin_player, Float:X, Float:Y, Float:Z, Float:Angle, weapon1, weapon1_ammo, weapon2, weapon2_ammo, weapon3, weapon3_ammo ) ;
}
#define SetSpawnInfo _SetSpawnInfo

new TotalObject = 0 ;
stock _CreateObject(modelid, Float:X, Float:Y, Float:Z, Float:rX, Float:rY, Float:rZ, Float:DrawDistance = 0.0)
{
	TotalObject ++ ;
	return CreateObject(modelid, X,  Y,  Z,  rX, rY,  rZ, DrawDistance);
}
#define CreateObject _CreateObject

new bool: edit_acc [ MAX_PLAYERS ] = { false, ... } ;
new bool: editor_acc [ MAX_PLAYERS ] = { false, ... } ;

stock _SetPlayerAttachedObject ( playerid, slot_id, object_id, bone_id, Float:fOffset_X = 0.0, Float:fOffset_Y = 0.0, Float:fOffset_Z = 0.0, Float:fRot_X = 0.0, Float:fRot_Y = 0.0, Float:fRot_Z = 0.0, Float:fOffang_X = 1.0, Float:fOffang_Y = 1.0, Float:fAngle_Z = 1.0, material_color_1 = 0, material_color_2 = 0 )
{
	#if defined debug_mode
	printf ( "[SetPlayerAttachedObject] playerid:%d, slotid:%d, objectid:%d, boneid:%d, fOffset_X:%f, fOffset_Y:%f, fOffset_Z:%f, fRot_X:%f, fRot_Y:%f, fRot_Z:%f", playerid, slot_id, object_id, bone_id, fOffset_X, fOffset_Y, fOffset_Z, fRot_X, fRot_Y, fRot_Z ) ;
	#endif

	new j = -1 ;
	for ( new i = 0 ; i < MAX_ACCESORIES ; i ++ )
	{
	    if ( GetUserAccessories ( playerid, ACS_USED, i ) == 0 ) continue ;
	    if ( GetUserAccessories ( playerid, ACS_MODEL, i ) != object_id ) continue ;

	    j = i ;
	    break ;
	}

	if ( j != -1 )
	{
	    if ( GetUserAccessories ( playerid, ACS_OBJ_X, j ) + GetUserAccessories ( playerid, ACS_OBJ_Y, j ) + GetUserAccessories ( playerid, ACS_OBJ_Z, j ) != 0.0 )
    	{
			SetPlayerAttachedObject ( playerid, slot_id, object_id, bone_id,
									GetUserAccessories ( playerid, ACS_OBJ_X, j ),
									GetUserAccessories ( playerid, ACS_OBJ_Y, j ),
									GetUserAccessories ( playerid, ACS_OBJ_Z, j ),
									GetUserAccessories ( playerid, ACS_ROT_X, j ),
									GetUserAccessories ( playerid, ACS_ROT_Y, j ),
									GetUserAccessories ( playerid, ACS_ROT_Z, j ),
									fOffang_X, fOffang_Y, fAngle_Z ) ;
		}
  		else
		{
 	    	SetPlayerAttachedObject ( playerid, slot_id, object_id, bone_id, fOffset_X, fOffset_Y, fOffset_Z, fRot_X, fRot_Y, fRot_Z, fOffang_X, fOffang_Y, fAngle_Z, material_color_1, material_color_2 ) ;
		}

		if ( edit_acc [ playerid ] )
		{
		    create_type { playerid } = 50 ;
		    EditAttachedObject ( playerid, slot_id ) ;
		}
	   	return 1 ;
	}

   	return SetPlayerAttachedObject ( playerid, slot_id, object_id, bone_id, fOffset_X, fOffset_Y, fOffset_Z, fRot_X, fRot_Y, fRot_Z, fOffang_X, fOffang_Y, fAngle_Z, material_color_1, material_color_2 ) ;
}
#define SetPlayerAttachedObject _SetPlayerAttachedObject

stock give_money ( playerid, amount )
{
	if ( ( p_info [ playerid ] [ money ] + amount > max_money || p_info [ playerid ] [ money ] + amount < min_money ) && amount > 0 )
	{
	    SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Баланс не может превышать сумму в {"#cRInfo"}1.800.000.000"valute_title_"{"#cGRInfo"}!" ) ;
	    SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Получить деньги можно в любом банке на пикапе 'получение переводов'." ) ;

		if ( amount >= max_money - 500_000_000 )
		{
		    new _pay_amount = floatround ( amount / 2 ) ;
		    insert_return_money ( "Лимит средств 1", _pay_amount, p_info [ playerid ] [ id ] ) ;
		    insert_money_log ( playerid, INVALID_PLAYER_ID, _pay_amount, "Лимит средств 1" ) ;

		    insert_return_money ( "Лимит средств 2", _pay_amount, p_info [ playerid ] [ id ] ) ;
		    insert_money_log ( playerid, INVALID_PLAYER_ID, _pay_amount, "Лимит средств 2" ) ;
		}
		else
		{
			insert_return_money ( "Лимит средств", amount, p_info [ playerid ] [ id ] ) ;
			insert_money_log ( playerid, INVALID_PLAYER_ID, amount, "Лимит средств" ) ;
		}
	    return 1 ;
	}

	p_info [ playerid ] [ money ] += amount ;
	GivePlayerMoney ( playerid, amount ) ;
	update_int_sql ( playerid, "u_money", p_info [ playerid ] [ money ] ) ;

	if ( p_info [ playerid ] [ money ] >= 50000000 && p_info [ playerid ] [ money_case ] )
	{
    	if ( ! IsPlayerAttachedObjectSlotUsed ( playerid, 4 ) ) SetPlayerAttachedObject ( playerid, 4, 1210, 5, 0.299999, 0.099999, 0.0, 0.0, -83.00, 0.0, 1.0, 1.0, 1.0);
	}
	else if ( IsPlayerAttachedObjectSlotUsed ( playerid, 4 ) ) RemovePlayerAttachedObject ( playerid, 4 ) ;

	if ( amount > 0 )
	{
		new t_string [ 46 ] ;

		#if defined CRMP
		if ( player_device { playerid } == 2 )
		{
			format ( t_string, sizeof t_string, "+%d рублей", amount ) ;
			send_check_cinfo ( playerid, t_string, 0, 3, CINFO_OTHER_ID, PICTURE_INFO_SUCESS, "", "" ) ;
		}
		else
		{
		    format ( t_string, sizeof t_string, "~n~~n~~n~~n~~n~~n~~n~~n~~g~ +%d rub", amount ) ;
			GameTextForPlayer ( playerid, t_string, 3000, 3 ) ;
		}
		#else
		if ( player_device { playerid } == 2 )
		{
			format ( t_string, sizeof t_string, "+%d$", amount ) ;
			send_check_cinfo ( playerid, t_string, 0, 3, CINFO_OTHER_ID, PICTURE_INFO_PAYMENT, "", "" ) ;
		}
		else
		{
		    format ( t_string, sizeof t_string, "~n~~n~~n~~n~~n~~n~~n~~n~~g~ +%d$", amount ) ;
			GameTextForPlayer ( playerid, t_string, 3000, 3 ) ;
		}
		#endif
	}
	else
	{
	    new t_string [ 46 ] ;

		#if defined CRMP
		if ( player_device { playerid } == 2 )
		{
			format ( t_string, sizeof t_string, "%d рублей", amount ) ;
			send_check_cinfo ( playerid, t_string, 0, 3, CINFO_OTHER_ID, PICTURE_INFO_SUCESS, "", "" ) ;
		}
		else
		{
		    format ( t_string, sizeof t_string, "~n~~n~~n~~n~~n~~n~~n~~n~~r~ %d rub", amount ) ;
			GameTextForPlayer ( playerid, t_string, 3000, 3 ) ;
		}
		#else
		if ( player_device { playerid } == 2 )
		{
			format ( t_string, sizeof t_string, "%d$", amount ) ;
			send_check_cinfo ( playerid, t_string, 0, 3, CINFO_OTHER_ID, PICTURE_INFO_PAYMENT, "", "" ) ;
		}
		else
		{
		    format ( t_string, sizeof t_string, "~n~~n~~n~~n~~n~~n~~n~~n~~r~ %d$", amount ) ;
			GameTextForPlayer ( playerid, t_string, 3000, 3 ) ;
		}
		#endif
	}
	return 1 ;
}

stock insert_money_log ( playerid, from_id, money_amount, reason [ ] )
{
	global_string [ 0 ] = EOS ;
	if ( from_id == INVALID_PLAYER_ID )
	{
		format ( global_string, sizeof ( global_string ), "INSERT INTO `money_logs` (`name`,`from_name`,`money`,`player_money`,`reason`,`date`,`ip`) VALUES ('%s','server','%d','%d','%s',NOW(),'%s')",
		p_info [ playerid ] [ name ], money_amount, p_info [ playerid ] [ money ], reason, p_t_info [ playerid ] [ p_ip ] ) ;
		mysql_tquery ( sql_connection, global_string ) ;
	}
	else
	{
		format ( global_string, sizeof ( global_string ), "INSERT INTO `money_logs` (`name`,`from_name`,`money`,`player_money`,`reason`,`date`,`ip`) VALUES ('%s','%s','%d','%d','%s',NOW(),'%s')",
		p_info [ playerid ] [ name ], p_info [ from_id ] [ name ], money_amount, p_info [ playerid ] [ money ], reason, p_t_info [ playerid ] [ p_ip ] ) ;
		mysql_tquery ( sql_connection, global_string ) ;
	}
	return 1 ;
}

stock insertMoneyLogName ( playerName [ ], playerMoney, moneyAmount, playerIp [ ], reason [ ] )
{
	global_string [ 0 ] = EOS ;
	format ( global_string, sizeof ( global_string ), "INSERT INTO `money_logs` (`name`,`from_name`,`money`,`player_money`,`reason`,`date`,`ip`) VALUES ('%s','offline','%d','%d','%s',NOW(),'%s')",
	playerName, moneyAmount, playerMoney, reason, playerIp ) ;
	mysql_tquery ( sql_connection, global_string ) ;
	return 1 ;
}

stock insert_donate_log ( playerid, from_id, donate_amount, donate_count, reason [ ] )
{
	global_string [ 0 ] = EOS ;
	if ( from_id == INVALID_PLAYER_ID )
	{
		format ( global_string, sizeof ( global_string ), "INSERT INTO `money_logs` (`name`,`from_name`,`money`,`player_money`,`reason`,`date`,`ip`) VALUES ('%s','server','%d','%d','%s',NOW(),'%s')",
		p_info [ playerid ] [ name ], donate_amount, donate_count, reason, p_t_info [ playerid ] [ p_ip ] ) ;
		mysql_tquery ( sql_connection, global_string ) ;
	}
	else
	{
		format ( global_string, sizeof ( global_string ), "INSERT INTO `money_logs` (`name`,`from_name`,`money`,`player_money`,`reason`,`date`,`ip`) VALUES ('%s','%s','%d','%d','%s',NOW(),'%s')",
		p_info [ playerid ] [ name ], p_info [ from_id ] [ name ], donate_amount, donate_count, reason, p_t_info [ playerid ] [ p_ip ] ) ;
		mysql_tquery ( sql_connection, global_string ) ;
	}
	return 1 ;
}
