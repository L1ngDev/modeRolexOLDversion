	    h_info [ params [ 0 ] - 1 ] [ h_garden_position ] [ 0 ] =
	    h_info [ params [ 0 ] - 1 ] [ h_garden_position ] [ 1 ] =
	    h_info [ params [ 0 ] - 1 ] [ h_garden_position ] [ 2 ] =
	    h_info [ params [ 0 ] - 1 ] [ h_garden_position ] [ 3 ] = 0.0 ;

		if ( IsValidDynamicPickup ( h_info [ params [ 0 ] - 1 ] [ h_garden_pickup ] ) ) DestroyDynamicPickup ( h_info [ params [ 0 ] - 1 ] [ h_garden_pickup ] ) ;
	    if ( IsValidDynamic3DTextLabel ( h_info [ params [ 0 ] - 1 ] [ h_garden_label ] ) )
		{
			DestroyDynamic3DTextLabel ( h_info [ params [ 0 ] - 1 ] [ h_garden_label ] ) ;
			h_info [ params [ 0 ] - 1 ] [ h_garden_label ] = Text3D:INVALID_3DTEXT_ID ;
		}

		Iter_Remove(houses_garden, h_info [ params [ 0 ] - 1 ] [ h_id ]);
		h_info [ params [ 0 ] - 1 ] [ h_garden ] = 0 ;

		format ( scm_string, 70, "Вы убрали огород у дома №%d.", params [ 0 ] ) ;
		SendClientMessage ( playerid, col_white, scm_string ) ;
