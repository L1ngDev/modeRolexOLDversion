	LinkVehicleToInterior ( veh_id, p_t_info [ params [ 0 ] ] [ p_data ] [ 0 ] ) ;
	SetVehicleVirtualWorld ( veh_id, p_t_info [ params [ 0 ] ] [ p_data ] [ 1 ] ) ;
	PutPlayerInVehicle ( params [ 0 ], veh_id, 0 ) ;
