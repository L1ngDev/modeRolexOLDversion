stock edit_admin_punish ( playerid, _param )
{
	if ( _param == 0 )
	{
	    new _count = 1 ;
	    global_string [ 0 ] = EOS ;
		strcat ( global_string, "{"#cWH"}Создать\n" ) ;
	    for ( new i = 0 ; i < punishment_max ; i ++ )
	    {
	        if ( punish_kick [ i ] [ pun_time ] < 1 ) continue ;

	        set_player_listitem_values ( playerid, _count, i ) ;
	        _count ++ ;

	        format ( global_string, sizeof global_string, "%s{"#cBL"}%d. {"#cWH"}%s\n", global_string, _count, punish_kick [ i ] [ pun_name ] ) ;
	    }
	    show_dialog ( playerid, d_punish_kick, DIALOG_STYLE_LIST, "{"#cBHD"}Регламент /kick", global_string, "Выбрать", "Назад" ) ;
	}
	else if ( _param == 1 )
	{
	    new _count = 1 ;
	    global_string [ 0 ] = EOS ;
		strcat ( global_string, "{"#cBL"}№. Причина:\t{"#cBL"}Срок:\n" ) ;
		strcat ( global_string, "{"#cWH"}Создать\t \n" ) ;
	    for ( new i = 0 ; i < punishment_max ; i ++ )
	    {
	        if ( punish_jail [ i ] [ pun_time ] < 1 ) continue ;

