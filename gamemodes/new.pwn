callback: loadMultiplierInfo ( )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows ) return false ;

	server_bonus [ 1 ] = cache_get_field_content_int ( 0, "multiplier" ) ;

	if ( server_bonus [ 1 ] > 1 ) bonus_activated = true ;
	else bonus_activated = false ;
	return true ;
}

callback: autoschool_loading ( )
{
	new fields, rows, time = GetTickCount ( ) ;
	cache_get_data ( rows, fields ) ;

	if ( rows )
	{
	    for ( new t = 0 ; t < rows ; t ++ )
        {
			switch ( t )
			{
			    case 0..3: licenses_price_auto [ t ] = cache_get_field_content_int ( t, "var_count", sql_connection ) ;
			    case 4..7: licenses_price [ t - 4 ] = cache_get_field_content_int ( t, "var_count", sql_connection ) ;
			    case 8..11: licenses_level [ t - 8 ] = cache_get_field_content_int ( t, "var_count", sql_connection ) ;
			}
		}
	}

	text_autoschool_queue = CreateDynamic3DTextLabel ( "** Очередь на сдачу **", col_header_3d, autoschool_exam_pos [ 0 ], autoschool_exam_pos [ 1 ], autoschool_exam_pos [ 2 ] + 1.0, 38.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 1, 1 ) ;
    autoschool_playerid = INVALID_PLAYER_ID ;

	for ( new i = 0 ; i < 10 ; i ++ )
	{
	    autoschool_queue [ i ] = INVALID_PLAYER_ID ;
	}

	printf ( "[SERVER] Загружено %d параметров автошколы. (%d ms)", rows, GetTickCount ( ) - time ) ;
	return 1 ;
}

callback: server_info_loading ( )
{
	new fields, rows ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows ) return 1 ;
	gunrow = cache_get_field_content_int ( 0, "serv_nelegal_gun", sql_connection ) ;
	drugsrow = cache_get_field_content_int ( 0, "serv_nelegal_drugs", sql_connection ) ;
	return 1 ;
}

callback: government_loading ( )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows ) return false ;

	new govId ;
	for ( new i = 0 ; i < rows ; i ++ )
	{
		govId = cache_get_field_content_int ( i, "id", sql_connection ) ;
		governmentPrice [ govId - 1 ] [ GOVERNMENT_PRICE ] = cache_get_field_content_int ( i, "value", sql_connection ) ;
	}
	return true ;
}

callback: gangzones_loading ( )
{
	new fields, time = GetTickCount ( ) ;
	cache_get_data ( gz_count, fields ) ;
	if ( gz_count )
	{
        for ( new t = 0 ; t < gz_count ; t ++ )
        {
			gz_info [ t ] [ gz_id ] = cache_get_field_content_int ( t, "gz_id", sql_connection ) ;
			gz_info [ t ] [ gz_owner ] = cache_get_field_content_int ( t, "gz_owner", sql_connection ) ;
			gz_info [ t ] [ gz_spawn ] = cache_get_field_content_int ( t, "gz_spawn", sql_connection ) ;

			gz_info [ t ] [ gz_pos ] [ 0 ] = cache_get_field_content_float ( t, "gz_x", sql_connection ) ;
			gz_info [ t ] [ gz_pos ] [ 1 ] = cache_get_field_content_float ( t, "gz_y", sql_connection ) ;
			gz_info [ t ] [ gz_pos ] [ 2 ] = cache_get_field_content_float ( t, "gz_z", sql_connection ) ;
			gz_info [ t ] [ gz_pos ] [ 3 ] = cache_get_field_content_float ( t, "gz_a", sql_connection ) ;

			gz_info [ t ] [ gz_created ] = GangZoneCreate ( gz_info [ t ] [ gz_pos ] [ 0 ],
															gz_info [ t ] [ gz_pos ] [ 1 ],
															gz_info [ t ] [ gz_pos ] [ 2 ],
															gz_info [ t ] [ gz_pos ] [ 3 ] ) ;
		}
	}
	printf ( "[SERVER] Загружено %d гангзон. (%d ms)", gz_count, GetTickCount ( ) - time ) ;
	return 1 ;
}

stock show_dr_boxes ( playerid )
{
    show_dialog ( playerid, d_bank_dr, DIALOG_STYLE_LIST, "{"#cBHD"}Управление счетами", "{"#cBL"}1. {"#cWH"}Создать карту\n{"#cBL"}2. {"#cWH"}Удалить карту\n{"#cBL"}3. {"#cWH"}Перевыпустить карту\n{"#cGRDialog"}Информация о картах", "Выбрать", "Назад" ) ;
	return 1 ;
}

stock delete_boxes ( playerid )
{
    global_string [ 0 ] = EOS ;

	new line_string [ 144 ], _card_count = 0, _card_type [ 80 ] ;
	strcat ( global_string, "{"#cBL"}№ Счёта:\t{"#cBL"}Тип карты:\t{"#cBL"}Средства:\n" ) ;
    for ( new j = 0 ; j < MAX_BANK_ACCOUNT ; j ++ )
    {
    	if ( ! bank_info [ playerid ] [ bi_type ] [ j ] ) continue ;

		set_player_listitem_values ( playerid, _card_count, j ) ;
		_card_count ++ ;

        if ( bank_info [ playerid ] [ bi_reset ] [ j ] > gettime ( ) )
        {
			new s_year, s_month, s_day, s_hour, s_minute, s_second ;
			timestamp_to_date ( bank_info [ playerid ] [ bi_reset ] [ j ] + CONVERT_TIME_TO_MOSCOW, s_year, s_month, s_day, s_hour, s_minute, s_second ) ;
            format ( _card_type, sizeof _card_type, "Перевыпуск до {"#cGRDialog"}%02d.%02d.%d %02d:%02d:%02d{"#cWH"}", s_day, s_month, s_year, s_hour, s_minute, s_second ) ;
        }
        else
        {
			switch ( bank_info [ playerid ] [ bi_type ] [ j ] )
			{
	  			case 1: format ( _card_type, sizeof _card_type, "{"#cGRDialog"}Зарплатная{"#cWH"}" ) ;
		    	case 2: format ( _card_type, sizeof _card_type, "{"#cGN"}Накопительная{"#cWH"}" ) ;
			    case 3: format ( _card_type, sizeof _card_type, "{"#cYW"}Кредитная{"#cWH"}" ) ;
			}
		}

		format ( line_string, sizeof ( line_string ), "{"#cWH"}№%d\t%s\t{"#cGN"}%s"valute_title_"\n", bank_info [ playerid ] [ bi_id ] [ j ], _card_type, GetPlayerCashValue ( bank_info [ playerid ] [ bi_money ] [ j ] ) ) ;
		strcat ( global_string, line_string ) ;
	}
	if ( _card_count == 0 ) return show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Управление счетами", "{"#cRInfo"}* {"#cGRInfo"}У Вас нет счетов.\n\n{"#cGInfo"}* {"#cGRInfo"}Открыть счёт можно в любом банке (/gps - Бизнесы - Банки).\n{"#cGInfo"}* {"#cGRInfo"}По приезду Вам необходимо заказать выпуск карты.", "Выбрать", "Назад" ) ;
	show_dialog ( playerid, d_bank_delete, DIALOG_STYLE_TABLIST_HEADERS, "{"#cBHD"}Управление счетами", global_string, "Выбрать", "Назад" ) ;
	return 1 ;
}

