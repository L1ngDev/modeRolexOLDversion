					foreach(new j: admin_players) SendClientMessage ( j, col_admin, fm_string ) ;

					format ( fm_string, sizeof fm_string, "Администратор %s получил(а) выговор. Причина: игнорирование репорта", p_info [ i ] [ name ] ) ;
