				return 1 ;
			}
			else if ( _b_type == bizz_type_reserve )
			{
			    show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Охотничьи угодья", "\
				{"#cWH"}Охотничьи угодья - это полностью пассивный тип бизнеса,\n\
				который отвечает за комфортный отдых игроков на охоте.\n\n\
				Основная прибыль идёт с предоставления охотничьих услуг.", "Принять", "" ) ;
				return 1 ;
			}

     		new dialog_string [ 230 + MAX_PLAYER_NAME + 7 + 32 + 5 ], line_string [ 70 + 16 ] ;

			new business_status [ 19 + 1 ] = "{"#cRD"}Закрыт" ;
			if ( ! b_info [ t ] [ b_close ] ) business_status = "{"#cGN"}Открыт" ;
			if ( b_info [ t ] [ b_owner_inc ] == -1 )
			{
				new _str_price [ 32 ] ;
				if ( b_info [ t ] [ b_donate_price ] ) format ( _str_price, sizeof _str_price, "%s "donate_title"", GetPlayerCashValueToSmile ( b_info [ t ] [ b_donate_price ] ) ) ;
				else format ( _str_price, sizeof _str_price, "%s"valute_title_"", GetPlayerCashValueToSmile ( b_info [ t ] [ b_price ] * for_tax [ 1 ] ) ) ;

				format ( dialog_string, sizeof ( dialog_string ), "{"#cBL"}Бизнес продаётся:\n\n{"#cGRDialog"}Название:{"#cWH"} %s\n{"#cGRDialog"}Контроль:{"#cWH"} %s\n{"#cGRDialog"}Цена:{"#cWH"} %s\n{"#cGRDialog"}Состояние: %s",
				b_info [ t ] [ b_name ], f_info [ b_info [ t ] [ b_mafia ] - 1 ] [ f_name ], _str_price, business_status ) ;
				if ( b_info [ t ] [ b_meeting ] > gettime ( ) )
				{
					new s_year, s_month, s_day, s_hour, s_minute, s_second ;
					timestamp_to_date ( b_info [ t ] [ b_meeting ] + CONVERT_TIME_TO_MOSCOW, s_year, s_month, s_day, s_hour, s_minute, s_second ) ;

					strcat ( dialog_string, "\n\n{"#cRD"}* Бизнес опечатан" ) ;
					format ( line_string, sizeof line_string, "\n{"#cRD"}* Станет доступен %02d.%02d.%d в %02d:%02d:%02d", s_day, s_month, s_year, s_hour, s_minute, s_second ) ;
					strcat ( dialog_string, line_string ) ;
				}

                if ( b_info [ t ] [ b_type ] == bizz_type_bank || b_info [ t ] [ b_type ] == bizz_type_autoshop )
					show_dialog ( playerid, d_b_buy, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Информация о бизнесе", dialog_string, "Купить", "Войти" ) ;

				else
				    show_dialog ( playerid, d_b_buy, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Информация о бизнесе", dialog_string, "Купить", "Закрыть" ) ;
			}
			else
			{
				new bis_int = b_info [ t ] [ b_int ] ;
				if ( bis_int == -1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Произошла ошибка при входе в бизнес!" ) ;
				if ( b_info [ t ] [ b_close ] == 1 ||  b_info [ t ] [ b_owner_inc ] == -1 )
				{
