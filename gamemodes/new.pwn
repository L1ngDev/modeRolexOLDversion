CMD:plmenu ( playerid )
{
	if ( ! mafia_player ( playerid ) ) return 1 ;
	if ( b_info [ mafia_factory_id - 1 ] [ b_mafia ] != p_info [ playerid ] [ member ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Оружейный завод Вам не принадлежит." ) ;

	show_plant_menu ( playerid ) ;
	return 1 ;
}

stock show_plant_menu ( playerid )
{
    if ( mafia_player ( playerid ) )
    {
		new step = 0,
			line_string [ 128 ] ;

		global_string [ 0 ] = EOS ;
		strcat ( global_string, "{"#cBL"}Организация:\t{"#cBL"}Статус:\n") ;
		for ( new i = 0 ; i < 8 ; i ++ )
		{
			if ( i + 18 == p_info [ playerid ] [ member ] ) continue ;

			set_player_listitem_values ( playerid, step, i + 18 ) ;

			format ( line_string, sizeof line_string, "{%s}%s\t%s\n", f_info [ i + 17 ] [ f_chat_color ], f_info [ i + 17 ] [ f_name ], ( mafia_plant_status [ p_info [ playerid ] [ member ] - 18 ] [ i ] == 1 ) ? ( "{"#cGN"}Разрешено{"#cWH"}" ) : ( "{"#cRD"}Не разрешено{"#cWH"}" ) ) ;
			strcat ( global_string, line_string ) ;
			step ++ ;
		}
		format ( line_string, sizeof line_string, "{"#cGRDialog"}Цена за аренду:\t{"#cGN"}%d"valute_title_"\n", plant_price ) ;
		strcat ( global_string, line_string ) ;
		format ( line_string, sizeof line_string, "{"#cGRDialog"}Заказано металла:\t{"#cGN"}%d кг\n", plant_order ) ;
		strcat ( global_string, line_string ) ;
		format ( line_string, sizeof line_string, "{"#cGRDialog"}Цена за 1 кг металла:\t{"#cGN"}%d"valute_title_"\n", plant_metall_price ) ;
		strcat ( global_string, line_string ) ;
		show_dialog ( playerid, d_mafia_plant, DIALOG_STYLE_TABLIST_HEADERS, "{"#cBHD"}Завод", global_string, "Выбрать", "Закрыть" ) ;
        return 1 ;
    }
	return 1 ;
}

stock show_fraction_logs ( playerid )
{
    if ( mafia_player ( playerid ) || gang_player ( playerid ) ) show_dialog ( playerid, d_fractions_logs, DIALOG_STYLE_LIST, "{"#cBHD"}История организации", "{"#cGRDialog"}- {"#cWH"}Ранговая история\n{"#cGRDialog"}- {"#cWH"}История выговоров\n{"#cGRDialog"}- {"#cWH"}Чёрный список\n{"#cGRDialog"}- {"#cWH"}История принятий\n{"#cGRDialog"}- {"#cWH"}История увольнений\n{"#cGRDialog"}- {"#cWH"}История склада", "Выбрать", "Назад" ) ;
    else show_dialog ( playerid, d_fractions_logs, DIALOG_STYLE_LIST, "{"#cBHD"}История организации", "{"#cGRDialog"}- {"#cWH"}Ранговая история\n{"#cGRDialog"}- {"#cWH"}История выговоров\n{"#cGRDialog"}- {"#cWH"}Чёрный список\n{"#cGRDialog"}- {"#cWH"}История принятий\n{"#cGRDialog"}- {"#cWH"}История увольнений\n{"#cGRDialog"}- {"#cWH"}История действий", "Выбрать", "Назад" ) ;
	return 1 ;
}

stock leader_menu_settings ( playerid )
{
	global_string [ 0 ] = EOS ;
	new line_string [ 100 ] ;

	new f ;
	if ( p_info [ playerid ] [ leader ] > 0 ) f = p_info [ playerid ] [ member ] - 1 ;
	else f = player_settings { playerid } - 1 ;

	format ( line_string, sizeof line_string, "{"#cGRDialog"}- {"#cWH"}Прием в организацию\t{"#cGN"}%s\n", f_rank [ f ] [ f_info [ f ] [ f_rank_settings ] [ 1 ] - 1 ] ) ;
	strcat ( global_string, line_string ) ;
	format ( line_string, sizeof line_string, "{"#cGRDialog"}- {"#cWH"}Исключение из организации\t{"#cGN"}%s\n", f_rank [ f ] [ f_info [ f ] [ f_rank_settings ] [ 2 ] - 1 ] ) ;
	strcat ( global_string, line_string ) ;
	format ( line_string, sizeof line_string, "{"#cGRDialog"}- {"#cWH"}Изменение ранга\t{"#cGN"}%s\n", f_rank [ f ] [ f_info [ f ] [ f_rank_settings ] [ 3 ] - 1 ] ) ;
	strcat ( global_string, line_string ) ;
	format ( line_string, sizeof line_string, "{"#cGRDialog"}- {"#cWH"}Доступ к /f(un)mute\t{"#cGN"}%s\n", f_rank [ f ] [ f_info [ f ] [ f_rank_settings ] [ 5 ] - 1 ] ) ;
	strcat ( global_string, line_string ) ;

	if ( mafia_player ( playerid ) || gang_player ( playerid ) )
	{
		format ( line_string, sizeof line_string, "{"#cGRDialog"}- {"#cWH"}Доступ к захвату\t{"#cGN"}%s\n", f_rank [ f ] [ f_info [ f ] [ f_rank_settings ] [ 6 ] - 1 ] ) ;
		strcat ( global_string, line_string ) ;

		format ( line_string, sizeof line_string, "{"#cGRDialog"}- {"#cWH"}Доступ к общаку\t{"#cGN"}%s\n", f_rank [ f ] [ f_info [ f ] [ f_rank_settings ] [ 7 ] - 1 ] ) ;
		strcat ( global_string, line_string ) ;

		format ( line_string, sizeof line_string, "{"#cGRDialog"}- {"#cWH"}Доступ к /(un)warblock\t{"#cGN"}%s\n", f_rank [ f ] [ f_info [ f ] [ f_rank_settings ] [ 8 ] - 1 ] ) ;
		strcat ( global_string, line_string ) ;
	}

	else if ( radio_player ( playerid ) )
	{
	    format ( line_string, sizeof line_string, "{"#cGRDialog"}- {"#cWH"}Доступ к эфиру\t{"#cGN"}%s\n", f_rank [ f ] [ f_info [ f ] [ f_rank_settings ] [ 9 ] - 1 ] ) ;
		strcat ( global_string, line_string ) ;

		format ( line_string, sizeof line_string, "{"#cGRDialog"}- {"#cWH"}Доступ к /gov\t{"#cGN"}%s\n", f_rank [ f ] [ f_info [ f ] [ f_rank_settings ] [ 10 ] - 1 ] ) ;
		strcat ( global_string, line_string ) ;
	}

	else if ( cop_player ( playerid ) || fbi_player ( playerid ) || p_info [ playerid ] [ member ] == 10 )
	{
	    format ( line_string, sizeof line_string, "{"#cGRDialog"}- {"#cWH"}Доступ к /(d)epartment\t{"#cGN"}%s\n", f_rank [ f ] [ f_info [ f ] [ f_rank_settings ] [ 9 ] - 1 ] ) ;
		strcat ( global_string, line_string ) ;

		format ( line_string, sizeof line_string, "{"#cGRDialog"}- {"#cWH"}Доступ к /gov\t{"#cGN"}%s\n", f_rank [ f ] [ f_info [ f ] [ f_rank_settings ] [ 10 ] - 1 ] ) ;
		strcat ( global_string, line_string ) ;
	}

	else
	{
	    format ( line_string, sizeof line_string, "{"#cGRDialog"}- {"#cWH"}Доступ к /(d)epartment\t{"#cGN"}%s\n", f_rank [ f ] [ f_info [ f ] [ f_rank_settings ] [ 9 ] - 1 ] ) ;
		strcat ( global_string, line_string ) ;

		format ( line_string, sizeof line_string, "{"#cGRDialog"}- {"#cWH"}Доступ к /gov\t{"#cGN"}%s\n", f_rank [ f ] [ f_info [ f ] [ f_rank_settings ] [ 10 ] - 1 ] ) ;
		strcat ( global_string, line_string ) ;
	}

	format ( line_string, sizeof line_string, "{"#cGRDialog"}- {"#cWH"}Количество рангов\t{"#cGN"}%d\n", f_info [ f ] [ f_rank_settings ] [ 0 ] ) ;
	strcat ( global_string, line_string ) ;

	if ( gov_player ( playerid ) ) strcat ( global_string, "{"#cGRDialog"}- {"#cWH"}Министры\t \n" ) ;

	if ( admin_info [ playerid ] [ admin ] > 7 )
	{
		strcat ( global_string, "{"#cGRDialog"}- {"#cWH"}Изменить позицию появления\t \n" ) ;
		strcat ( global_string, "{"#cGRDialog"}- {"#cWH"}Изменить позицию общака / склада\t \n" ) ;
		strcat ( global_string, "{"#cGRDialog"}- {"#cWH"}Зона разгрузки\t \n" ) ;
	}

	show_dialog ( playerid, d_leader_settings, DIALOG_STYLE_TABLIST, "{"#cBHD"}Настройки организации", global_string, "Выбрать", "Назад" ) ;
	return 1 ;
}

stock show_settings_org ( playerid, fraction_id, select_id, bool: type_fwarn = false )
{
	global_string [ 0 ] = EOS ;
	new line_string [ 72 ] ;
	for ( new i = 0; i < f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 0 ] ; i ++ )
	{
		format ( line_string, 72, "{"#cBL"}%i. {"#cWH"}%s\n", i + 1, f_rank [ fraction_id - 1 ] [ i ] ) ;
		strcat ( global_string, line_string ) ;
	}
	if ( select_id == 0 )
	{
	    SetPVarInt ( playerid, "select_id", 1 ) ;
		show_dialog ( playerid, d_org_settings, DIALOG_STYLE_LIST, "{"#cBHD"}Приём в организацию", global_string, "Выбрать", "Назад" ) ;
	}
	else if ( select_id == 1 )
	{
	    SetPVarInt ( playerid, "select_id", 2 ) ;
		show_dialog ( playerid, d_org_settings, DIALOG_STYLE_LIST, "{"#cBHD"}Исключение из организации", global_string, "Выбрать", "Назад" ) ;
	}
    else if ( select_id == 2 )
	{
	    SetPVarInt ( playerid, "select_id", 3 ) ;
		show_dialog ( playerid, d_org_settings, DIALOG_STYLE_LIST, "{"#cBHD"}Изменение ранга", global_string, "Выбрать", "Назад" ) ;
	}
	else if ( select_id == 3 )
	{
	    SetPVarInt ( playerid, "select_id", 5 ) ;
		show_dialog ( playerid, d_org_settings, DIALOG_STYLE_LIST, "{"#cBHD"}Доступ к /f(un)mute", global_string, "Выбрать", "Назад" ) ;
	}
    else if ( select_id == 4 )
    {
        if ( gang_player ( playerid ) || mafia_player ( playerid ) )
		{
		    SetPVarInt ( playerid, "select_id", 6 ) ;
			show_dialog ( playerid, d_org_settings, DIALOG_STYLE_LIST, "{"#cBHD"}Доступ к захвату", global_string, "Выбрать", "Назад" ) ;
		}
        else if ( radio_player ( playerid ) )
		{
		    SetPVarInt ( playerid, "select_id", 9 ) ;
			show_dialog ( playerid, d_org_settings, DIALOG_STYLE_LIST, "{"#cBHD"}Доступ к эфиру", global_string, "Выбрать", "Назад" ) ;
		}
        else
		{
		    SetPVarInt ( playerid, "select_id", 9 ) ;
			show_dialog ( playerid, d_org_settings, DIALOG_STYLE_LIST, "{"#cBHD"}Доступ к /(d)epartment", global_string, "Выбрать", "Назад" ) ;
		}
	}
    else if ( select_id == 5 )
    {
        if ( gang_player ( playerid ) || mafia_player ( playerid ) )
		{
		    SetPVarInt ( playerid, "select_id", 7 ) ;
			show_dialog ( playerid, d_org_settings, DIALOG_STYLE_LIST, "{"#cBHD"}Доступ к общаку", global_string, "Выбрать", "Назад" ) ;
		}
        else
		{
		    SetPVarInt ( playerid, "select_id", 10 ) ;
			show_dialog ( playerid, d_org_settings, DIALOG_STYLE_LIST, "{"#cBHD"}Доступ к /gov", global_string, "Выбрать", "Назад" ) ;
		}
	}
	else if ( select_id == 6 )
	{
	    if ( type_fwarn == true )
	    {
	    	SetPVarInt ( playerid, "select_id", 4 ) ;
	    	show_dialog ( playerid, d_org_settings, DIALOG_STYLE_LIST, "{"#cBHD"}Доступ к /f(un)warn", global_string, "Выбрать", "Назад" ) ;
	    }
	    else
	    {
		    if ( gov_player ( playerid ) )
		    {
		        SetPVarInt ( playerid, "select_id", 6 ) ;
		    	show_dialog ( playerid, d_org_settings, DIALOG_STYLE_LIST, "{"#cBHD"}Министр здравоохранения", global_string, "Выбрать", "Назад" ) ;
				return 1 ;
		    }
		    else if ( p_info [ playerid ] [ member ] == 10 )
		    {
		        SetPVarInt ( playerid, "select_id", 6 ) ;
		    	show_dialog ( playerid, d_org_settings, DIALOG_STYLE_LIST, "{"#cBHD"}Лицензия на полеты", global_string, "Выбрать", "Назад" ) ;
				return 1 ;
		    }
		}
	}
	else if ( select_id == 7 )
	{
	    if ( gov_player ( playerid ) )
	    {
	        SetPVarInt ( playerid, "select_id", 7 ) ;
	    	show_dialog ( playerid, d_org_settings, DIALOG_STYLE_LIST, "{"#cBHD"}Министр внутренних дел", global_string, "Выбрать", "Назад" ) ;
			return 1 ;
	    }
	    else if ( p_info [ playerid ] [ member ] == 10 )
	    {
	        SetPVarInt ( playerid, "select_id", 7 ) ;
	    	show_dialog ( playerid, d_org_settings, DIALOG_STYLE_LIST, "{"#cBHD"}Лицензия на водный транспорт", global_string, "Выбрать", "Назад" ) ;
			return 1 ;
	    }
	    SetPVarInt ( playerid, "select_id", 8 ) ;
	    show_dialog ( playerid, d_org_settings, DIALOG_STYLE_LIST, "{"#cBHD"}Доступ к /(un)warblock", global_string, "Выбрать", "Назад" ) ;
	}
	else if ( select_id == 8 )
	{
	    if ( gov_player ( playerid ) )
	    {
	        SetPVarInt ( playerid, "select_id", 8 ) ;
	    	show_dialog ( playerid, d_org_settings, DIALOG_STYLE_LIST, "{"#cBHD"}Министр обороны", global_string, "Выбрать", "Назад" ) ;
			return 1 ;
	    }
	    else if ( p_info [ playerid ] [ member ] == 10 )
	    {
	        SetPVarInt ( playerid, "select_id", 8 ) ;
	    	show_dialog ( playerid, d_org_settings, DIALOG_STYLE_LIST, "{"#cBHD"}Лицензия на оружие", global_string, "Выбрать", "Назад" ) ;
			return 1 ;
	    }
	}
	else if ( select_id == 9 )
	{
	    if ( gov_player ( playerid ) && GetPVarInt ( playerid, "ministry" ) )
	    {
	        DeletePVar ( playerid, "ministry" ) ;
	        SetPVarInt ( playerid, "select_id", 12 ) ;
	    	show_dialog ( playerid, d_org_settings, DIALOG_STYLE_LIST, "{"#cBHD"}Министр юстиции", global_string, "Выбрать", "Назад" ) ;
			return 1 ;
	    }
	    SetPVarInt ( playerid, "select_id", 11 ) ;
	   	show_dialog ( playerid, d_org_settings, DIALOG_STYLE_LIST, "{"#cBHD"}Доступ к /tren_menu", global_string, "Выбрать", "Назад" ) ;
	}
	return 1 ;
}

stock show_fraction_duty ( playerid )
{
	new _fr_id = p_info [ playerid ] [ member ], _rank = p_info [ playerid ] [ rank ],
		_skin = p_info [ playerid ] [ org_skin ], _fr_skin, line_string [ 144 ], _count = 0 ;
	global_string [ 0 ] = EOS ;
	strcat ( global_string, "{"#cBL"}Одежда №:\t{"#cBL"}Пол:\t{"#cBL"}Должность:\t{"#cBL"}Статус:\n" ) ;
	for ( new i = 0 ; i < f_info [ _fr_id - 1 ] [ f_rank_settings ] [ 0 ] ; i ++ )
	{
	    _fr_skin = f_skin_rank [ _fr_id - 1 ] [ p_info [ playerid ] [ gender ] ] [ i ] ;
	    if ( _fr_skin == 1 ) continue ;

		set_player_listitem_values ( playerid, _count, i ) ;
		_count ++ ;

		if ( ! p_info [ playerid ] [ gender ] )
		{
		    if ( _skin == f_skin_rank [ _fr_id - 1 ] [ 0 ] [ i ] ) format ( line_string, sizeof line_string, "{"#cBL"}%i. {"#cWH"}Форма №%d\tМужской\t{33AAFF}%s {"#cGRDialog"}- %d ранг\t{"#cLY"}Выбрана\n", i + 1, f_skin_rank [ _fr_id - 1 ] [ 0 ] [ i ], f_rank [ _fr_id - 1 ] [ i ], i + 1 ) ;
			else format ( line_string, sizeof line_string, "{"#cBL"}%i. {"#cWH"}Форма №%d\tМужской\t{33AAFF}%s {"#cGRDialog"}- %d ранг{"#cWH"}\t%s\n", i + 1, f_skin_rank [ _fr_id - 1 ] [ 0 ] [ i ], f_rank [ _fr_id - 1 ] [ i ], i + 1, ( _rank >= i + 1 ) ? ( "{"#cGN"}Доступно" ) : ( "{"#cRD"}Недоступно" ) ) ;
		}
		else
		{
		    if ( _skin == f_skin_rank [ _fr_id - 1 ] [ 0 ] [ i ] ) format ( line_string, sizeof line_string, "{"#cBL"}%i. {"#cWH"}Форма №%d\tЖенский\t{33AAFF}%s {"#cGRDialog"}- %d ранг\t{"#cLY"}Выбрана\n", i + 1, f_skin_rank [ _fr_id - 1 ] [ 1 ] [ i ], f_rank [ _fr_id - 1 ] [ i ], i + 1 ) ;
			else format ( line_string, sizeof line_string, "{"#cBL"}%i. {"#cWH"}Форма №%d\tЖенский\t{33AAFF}%s {"#cGRDialog"}- %d ранг{"#cWH"}\t%s\n", i + 1, f_skin_rank [ _fr_id - 1 ] [ 1 ] [ i ], f_rank [ _fr_id - 1 ] [ i ], i + 1, ( _rank >= i + 1 ) ? ( "{"#cGN"}Доступно" ) : ( "{"#cRD"}Недоступно" ) ) ;
		}
		strcat ( global_string, line_string ) ;
	}
	show_dialog ( playerid, d_duty, DIALOG_STYLE_TABLIST_HEADERS, "{"#cBHD"}Раздевалка", global_string, "Выбрать", "Закрыть" ) ;
	return 1 ;
}

CMD:tren_menu ( playerid )
{
    if ( ! p_info [ playerid ] [ member ] ) return 1 ;
    if ( p_info [ playerid ] [ rank ] < f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 11 ] )
	{
	    static const _str [ ] = "{"#cRInfo"}* {"#cGRInfo"}Команда доступна с ранга %s (%d)." ;
	    new scm_string [ sizeof _str + 30 + 3 ] ;
	    format ( scm_string, sizeof scm_string, _str, f_rank [ p_info [ playerid ] [ member ] - 1 ] [ f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 11 ] - 1 ], f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 11 ] ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
		return 1 ;
	}
    show_training_menu ( playerid ) ;
	return 1 ;
}

CMD:trsetteam ( playerid, params [ ] )
{
	if ( ! p_info [ playerid ] [ member ] ) return 1 ;
	if ( p_t_info [ playerid ] [ tr_enter ] != p_info [ playerid ] [ member ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны находиться в своём тренировочном комплексе." ) ;
	if ( p_info [ playerid ] [ rank ] <  f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 11 ] )
	{
	    static const _str [ ] = "{"#cRInfo"}* {"#cGRInfo"}Команда доступна с ранга %s (%d)." ;
	    new scm_string [ sizeof _str + 30 + 3 ] ;
	    format ( scm_string, sizeof scm_string, _str, f_rank [ p_info [ playerid ] [ member ] - 1 ] [ f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 11 ] - 1 ], f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 11 ] ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
		return 1 ;
	}
	if ( sscanf ( params, "dd", params [ 0 ], params [ 1 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /trsetteam [ид] [команда]" ) ;
	if ( params [ 1 ] < 1 || params [ 1 ] > 2 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нельзя назначить менее первой или более второй команды." ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
    if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;
	if ( p_t_info [ params [ 0 ] ] [ tr_enter ] < 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не в тренировочном комплексе." ) ;

	static const _str [ ] = "%s отправил вас в команду №%d." ;
	new scm_string [ sizeof _str + 24 + 4 ] ;
	format ( scm_string, sizeof scm_string, _str, p_info [ playerid ] [ name ], params [ 1 ] ) ;
	SendClientMessage ( params [ 0 ], col_gray, scm_string ) ;

	p_t_info [ params [ 0 ] ] [ tr_team ] = params [ 1 ] ;

	new fractionid = p_t_info [ params [ 0 ] ] [ tr_enter ] ;
	new teamid = p_t_info [ params [ 0 ] ] [ tr_team ] ;
	SetPlayerSkin ( params [ 0 ], f_info [ fractionid - 1 ] [ f_tr_skin ] [ teamid - 1 ] ) ;
	return 1 ;
}

CMD:trkick ( playerid, params [ ] )
{
    if ( ! p_info [ playerid ] [ member ] ) return 1 ;
	if ( p_t_info [ playerid ] [ tr_enter ] != p_info [ playerid ] [ member ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны находиться в своём тренировочном комплексе." ) ;
	if ( p_info [ playerid ] [ rank ] <  f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 11 ] )
	{
	    static const _str [ ] = "{"#cRInfo"}* {"#cGRInfo"}Команда доступна с ранга %s (%d)." ;
	    new scm_string [ sizeof _str + 30 + 3 ] ;
	    format ( scm_string, sizeof scm_string, _str, f_rank [ p_info [ playerid ] [ member ] - 1 ] [ f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 11 ] - 1 ], f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 11 ] ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
		return 1 ;
	}
	if ( sscanf ( params, "d", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /trkick [ид]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] )  || params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( p_t_info [ playerid ] [ tr_enter ] != p_t_info [ params [ 0 ] ] [ tr_enter ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не в Вашем тренировочном центре." ) ;

	static const _str [ ] = "%s выгнал(а) Вас с тренировки." ;
	new scm_string [ sizeof _str + 24 ] ;
	format ( scm_string, sizeof scm_string, _str, p_info [ playerid ] [ name ] ) ;
	SendClientMessage ( params [ 0 ], col_gray, scm_string ) ;

	new fractionid = p_t_info [ params [ 0 ] ] [ tr_enter ] ;
   	set_pos ( params [ 0 ], f_info [ fractionid - 1 ] [ f_tr_pickup ] [ 0 ], f_info [ fractionid - 1 ] [ f_tr_pickup ] [ 1 ], f_info [ fractionid - 1 ] [ f_tr_pickup ] [ 2 ], f_info [ fractionid - 1 ] [ f_tr_pickup ] [ 3 ], f_info [ fractionid - 1 ] [ f_tr_vw ], f_info [ fractionid - 1 ] [ f_tr_int ] ) ;

	if ( tr_td_status_bool [ params [ 0 ] ] == true ) tr_td_status ( params [ 0 ], false ) ;
	tr_td_status_bool [ params [ 0 ] ] = false ;

	p_t_info [ params [ 0 ] ] [ tr_team ] =
	p_t_info [ params [ 0 ] ] [ tr_enter ] = 0 ;

    reset_player_weapon ( params [ 0 ] ) ;

	fraction_duty ( params [ 0 ] ) ;
	return 1 ;
}

CMD:trstart ( playerid, params [ ] )
{
	if ( ! p_t_info [ playerid ] [ tr_team ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не участник тренировки." ) ;
	if ( p_t_info [ playerid ] [ tr_enter ] != p_info [ playerid ] [ member ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны находиться в своём тренировочном комплексе." ) ;
	if ( p_info [ playerid ] [ rank ] <  f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 11 ] )
	{
	    static const _str [ ] = "{"#cRInfo"}* {"#cGRInfo"}Команда доступна с ранга %s (%d)." ;
	    new scm_string [ sizeof _str + 30 + 3 ] ;
	    format ( scm_string, sizeof scm_string, _str, f_rank [ p_info [ playerid ] [ member ] - 1 ] [ f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 11 ] - 1 ], f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 11 ] ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
		return 1 ;
	}
	if ( sscanf ( params, "d", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /trstart [секунды]" ) ;
	if ( params [ 0 ] < 100 || params [ 0 ] > 600 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нельзя использовать менее 100 и более 600 секунд." ) ;
    if ( time_tr_team [ p_t_info [ playerid ] [ tr_enter ] ] > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Тренировка уже запущена." ) ;

	new fraction_id = p_t_info [ playerid ] [ tr_enter ] ;
    time_tr_team [ fraction_id ] = params [ 0 ] ;

    score_tr_team [ fraction_id ] [ 0 ] =
    score_tr_team [ fraction_id ] [ 1 ] = 0 ;

    training_kills_first =
	training_kills_two = 0 ;

	format ( training_kills_first_name, 32, "None" ) ;
	format ( training_kills_two_name, 32, "None" ) ;

	foreach(new i: logged_players)
	{
		if ( p_t_info [ playerid ] [ tr_enter ] == p_t_info [ i ] [ tr_enter ] )
		{
		    if ( ! p_t_info [ i ] [ tr_team ] ) continue ;

		    p_info [ i ] [ training_kills ] =
		    p_info [ i ] [ training_death ] = 0 ;
		    p_info [ i ] [ training_damage ] = 0.0 ;

		    tr_td_status ( i, true ) ;
			tr_td_status_bool [ i ] = true ;

			new map_id = f_info [ fraction_id - 1 ] [ f_tr_map ] ;
			new team_id = p_t_info [ i ] [ tr_team ] - 1 ;
		    set_pos ( i, f_training_spawn [ fraction_id - 1 ] [ map_id - 1 ] [ team_id ] [ 0 ],
								f_training_spawn [ fraction_id - 1 ] [ map_id - 1 ] [ team_id ] [ 1 ],
								f_training_spawn [ fraction_id - 1 ] [ map_id - 1 ] [ team_id ] [ 2 ],
								f_training_spawn [ fraction_id - 1 ] [ map_id - 1 ] [ team_id ] [ 3 ],
								interior_training,
								f_info [ fraction_id - 1 ] [ f_id ] ) ;

	        for ( new g = 0 ; g < 12 ; g ++ )
			{
			    if ( ! f_info [ fraction_id - 1 ] [ f_tr_ammo ] [ g ] ) continue ;
				give_weapon ( i, f_info [ fraction_id - 1 ] [ f_tr_gun ] [ g ], f_info [ fraction_id - 1 ] [ f_tr_ammo ] [ g ] ) ;
			}
			set_health ( i, f_info [ fraction_id - 1 ] [ f_tr_health ] ) ;
		}
	}

	tren_timer [ fraction_id ] = SetTimerEx ( "trening_timer", 1000, 1, "i", fraction_id ) ;
	return 1 ;
}

stock tr_td_status ( playerid, bool:status )
{
 	if ( status )
	{
   		training_ptd[playerid][0] = CreatePlayerTextDraw(playerid, 71.0336, 245.1704, "00:00"); // 1 Box ( Time )
		PlayerTextDrawLetterSize(playerid, training_ptd[playerid][0], 0.1748, 0.7578);
		PlayerTextDrawTextSize(playerid, training_ptd[playerid][0], 0.0000, 14.0000);
		PlayerTextDrawAlignment(playerid, training_ptd[playerid][0], 2);
		PlayerTextDrawColor(playerid, training_ptd[playerid][0], -1);
		PlayerTextDrawBackgroundColor(playerid, training_ptd[playerid][0], 255);
		PlayerTextDrawFont(playerid, training_ptd[playerid][0], 1);
		PlayerTextDrawSetProportional(playerid, training_ptd[playerid][0], 1);
		PlayerTextDrawSetShadow(playerid, training_ptd[playerid][0], 0);

