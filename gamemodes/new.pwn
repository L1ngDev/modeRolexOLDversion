	}
	if ( sscanf ( params, "d", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /setskin [ид]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( p_info [ params [ 0 ] ] [ member ] != frac_id ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не состоит в Вашей организации." ) ;
	if ( ! bad_dialog ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока есть активное предложение в данный момент." ) ;
	if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;

	global_string [ 0 ] = EOS ;
	for ( new j =  0; j < max_rank ; j ++ )
	{
		if ( f_skin [ frac_id - 1 ] [ p_info [ params [ 0 ] ] [ gender ] ] [ j ] == 1 )break ;
		new line_string [ 64 ] ;
		format ( line_string, 64, "{"#cBL"}%i. {"#cWH"}Одежда №%d\n", j + 1, f_skin [ frac_id - 1 ] [ p_info [ params [ 0 ] ] [ gender ] ] [ j ] ) ;
		strcat ( global_string, line_string ) ;
	}

	buyer_id [ playerid ] = params [ 0 ] ;
	show_dialog ( playerid, d_set_fskin, DIALOG_STYLE_LIST, "{"#cBHD"}Выбор одежды", global_string, "Сменить", "Отмена" ) ;
	return 1 ;
}

CMD:break ( playerid, params [ ] )
{
	new break_id = 0 ;
 	if ( ! cop_player ( playerid ) && ! fbi_player ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команда доступна только для гос. организаций." ) ;
	if ( ! is_fraction_duty { playerid } ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Не начат рабочий день." ) ;
	if ( IsPlayerInAnyVehicle ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете использовать это в машине." ) ;
    if ( p_t_info [ playerid ] [ p_data ] [ 0 ] != 0 || p_t_info [ playerid ] [ p_data ] [ 0 ] != 0 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нельзя использовать в интерьере." ) ;
	if ( fbi_player ( playerid ) )
	{
	    if ( sscanf ( params, "d", break_id ) ) SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /break [ид] (Укажите 'ид' игрока, для того, чтоб удалить)" ) ;
	}
	if ( break_id >= 0 && IsPlayerConnected ( break_id ) )
	{
 		if ( p_t_info [ break_id ] [ cop_break ] != INVALID_OBJECT_ID )
		{
		    new Float:x, Float:y, Float:z;
		    GetDynamicObjectPos(p_t_info [ break_id ] [ cop_break ], x, y, z);
			new here_distance = (!IsPlayerInAnyVehicle(break_id)) ? floatround(GetPlayerDistanceFromPoint(break_id, x, y, z)) : floatround(GetVehicleDistanceFromPoint(GetPlayerVehicleID(break_id), x, y, z));
			if ( here_distance > 5 )
			{
			    if ( IsValidDynamicArea ( p_t_info [ playerid ] [ cop_area ] ) )
				{
					Iter_Remove(spikes_player, playerid);
					DestroyDynamicArea ( p_t_info [ playerid ] [ cop_area ] ) ;
				}
				DestroyDynamicObject ( p_t_info [ break_id ] [ cop_break ] ) ;
				p_t_info [ break_id ] [ cop_break ] = INVALID_OBJECT_ID ;

				DestroyDynamic3DTextLabel ( BlockText [ break_id ] ) ;
				BlockText [ break_id ] = Text3D:INVALID_3DTEXT_ID ;

	       		SendClientMessage ( break_id, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Установленное Вами заграждение было убрано." ) ;
	       		SendClientMessage ( playerid, col_gray, !"{"#cGInfo"}* {"#cGRInfo"}Заграждение успешно убрано." ) ;
			}
		}
		return true ;
	}
	if ( p_t_info [ playerid ] [ cop_break ] != INVALID_OBJECT_ID )
	{
	    if ( IsValidDynamicArea ( p_t_info [ playerid ] [ cop_area ] ) )
		{
			Iter_Remove(spikes_player, playerid);
			DestroyDynamicArea ( p_t_info [ playerid ] [ cop_area ] ) ;
		}
	    if ( IsValidDynamic3DTextLabel ( BlockText [ playerid ] ) )
		{
			DestroyDynamic3DTextLabel ( BlockText [ playerid ] ) ;
			BlockText [ playerid ] = Text3D:INVALID_3DTEXT_ID ;
		}
		DestroyDynamicObject ( p_t_info [ playerid ] [ cop_break ] ) ;
        p_t_info [ playerid ] [ cop_break ] = INVALID_OBJECT_ID ;

        SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Заграждение успешно убрано." ) ;
        return true ;
	}
	show_dialog ( playerid, d_cop_break, DIALOG_STYLE_LIST, "{"#cBHD"}Заграждения","{"#cBL"}1. {"#cWH"}Конусовидное ограждение\n{"#cBL"}2. {"#cWH"}Двухсекционное ограждение\n{"#cBL"}3. {"#cWH"}Стойка ограждающая\n{"#cBL"}4. {"#cWH"}Односекционное ограждение\n{"#cBL"}5. {"#cWH"}Односекционное ограждение\n{"#cBL"}6. {"#cWH"}Стойка ограждающая\n{"#cBL"}7. {"#cWH"}Шипы", "Выбрать", "Закрыть" ) ;
	return true ;
}

