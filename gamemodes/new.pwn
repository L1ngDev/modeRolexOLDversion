					query_string [ 108 ] ;

				ticket_id = get_player_listitem_values ( playerid, GetPVarInt ( playerid, "ticket_listitem" ) ) ;
				mysql_format ( sql_connection, query_string, sizeof query_string, "SELECT * FROM `users_tickets` WHERE `id` = '%d' LIMIT 1", ticket_id ) ;
				mysql_tquery ( sql_connection, query_string, "callback_bankticket_info", "i", playerid ) ;
