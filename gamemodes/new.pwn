CMD:demote ( playerid, params [ ] )
{
	if ( ! fbi_player ( playerid ) && ! gov_player ( playerid ) ) return 1 ;

	new _demoter_frac = p_info [ playerid ] [ member ] ;
	if ( p_info [ playerid ] [ rank ] <  f_info [ _demoter_frac - 1 ] [ f_rank_settings ] [ 1 ] )
	{
	    static const _str [ ] = "{"#cRInfo"}* {"#cGRInfo"}Команда доступна с ранга %s (%d)." ;
	    new scm_string [ sizeof _str + 30 + 3 ] ;
	    format ( scm_string, sizeof scm_string, _str, f_rank [ _demoter_frac - 1 ] [ f_info [ _demoter_frac - 1 ] [ f_rank_settings ] [ 1 ] - 1 ], f_info [ _demoter_frac - 1 ] [ f_rank_settings ] [ 1 ] ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
		return 1 ;
	}
	if ( sscanf ( params, "us[32]", params [ 0 ], params [ 1 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /demote [ид/имя] [причина]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете разжаловать самого себя." ) ;
    if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;
	if ( p_info [ params [ 0 ] ] [ leader ] != 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете разжаловать лидера организации." ) ;
    if ( strlen ( params [ 1 ] ) < 3 || strlen ( params [ 1 ] ) > 32 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Причина должна содержать от 3 до 32 символов." ) ;
	if ( is_text_invalid ( params [ 1 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Причина содержит некорректные символы." ) ;
	if ( demote_cooldown [ playerid ] > gettime ( ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команду можно использовать раз в 5 минут." ) ;

	if ( fbi_player ( playerid ) ) if ( ! army_player ( params [ 0 ] ) && ! cop_player ( params [ 0 ] ) && ! prison_player ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не является военным или полицейским." ) ;

	if ( _demoter_frac == 11 && p_info [ playerid ] [ rank ] == f_info [ _demoter_frac - 1 ] [ f_rank_settings ] [ 8 ] ) if ( ! army_player ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не является военным." ) ;
	else if ( _demoter_frac == 11 && p_info [ playerid ] [ rank ] == f_info [ _demoter_frac - 1 ] [ f_rank_settings ] [ 6 ] ) if ( ! medic_player ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не является сотрудником здравоохранения." ) ;
    else if ( _demoter_frac == 11 && p_info [ playerid ] [ rank ] == f_info [ _demoter_frac - 1 ] [ f_rank_settings ] [ 7 ] ) if ( ! fbi_player ( params [ 0 ] ) && ! cop_player ( params [ 0 ] ) && ! prison_player ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не является сотрудником правоохранительных органов." ) ;
    else if ( _demoter_frac == 11 && p_info [ playerid ] [ rank ] == f_info [ _demoter_frac - 1 ] [ f_rank_settings ] [ 12 ] ) if ( ! mayor_player ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не является сотрудником правительства." ) ;

    demote_cooldown [ playerid ] = gettime ( ) + 300 ;
	new fraction_id = p_info [ params [ 0 ] ] [ member ] ;
	if ( p_info [ params [ 0 ] ] [ rank ] == 1 )
	{
		new scm_string [ 266 ] ;

		format ( scm_string, 144, "[D] %s %s уволил(а) сотрудника '%s' %s. Причина: %s", f_rank [ _demoter_frac - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], f_info [ fraction_id - 1 ] [ f_name ], p_info [ params [ 0 ] ] [ name ], params [ 1 ] ) ;
		foreach(new i: logged_players) if ( 18 > p_info [ i ] [ member ] > 0 && p_info [ i ] [ settings ] [ 0 ] ) SendClientMessage ( i, 0xFF8282AA, scm_string ) ;

		insert_joblist ( params [ 0 ], params [ 1 ], LABOR_TYPE_UNINVITE, p_info [ params [ 0 ] ] [ rank ] ) ;

		format ( scm_string, 144, "Уволил(а) сотрудника %s %s. Причина: %s", f_info [ fraction_id - 1 ] [ f_name ], p_info [ params [ 0 ] ] [ name ], params [ 1 ]);
		write_fraction ( playerid, _demoter_frac, TYPE_LOG_UVAL, scm_string ) ;

		if ( fraction_id != 0 ) Iter_Remove(fraction_players[fraction_id], params[0]);

		if ( gov_player ( params [ 0 ] ) )
		{
		    if ( p_info [ params [ 0 ] ] [ rank ] == f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 6 ] ||
				p_info [ params [ 0 ] ] [ rank ] == f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 7 ] ||
				p_info [ params [ 0 ] ] [ rank ] == f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 8 ] ||
				p_info [ params [ 0 ] ] [ rank ] == f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 12 ] )
			{
			    Iter_Remove ( fraction_ministry, params [ 0 ] ) ;
			}
		}

		p_info [ params [ 0 ] ] [ member ] =
		p_info [ params [ 0 ] ] [ rank ] =
		p_info [ params [ 0 ] ] [ org_skin ] =
		p_info [ params [ 0 ] ] [ warblock ] =
		p_info [ params [ 0 ] ] [ subleader ] =
		p_info [ params [ 0 ] ] [ f_warning ] = 0 ;

		scm_string [ 0 ] = EOS ;
		format ( scm_string, sizeof scm_string, "DELETE FROM `fractions_players` WHERE `u_sql_id` = '%d' LIMIT 1", p_info [ params [ 0 ] ] [ id ] ) ;
		mysql_tquery ( sql_connection, scm_string ) ;

		if ( is_fraction_duty { params [ 0 ] } ) is_fraction_duty { params [ 0 ] } = 0 ;

		SetPlayerSkin ( params [ 0 ], p_info [ params [ 0 ] ] [ skin ] ) ;
		SetPlayerColor ( params [ 0 ], 0xFFFFFF80 ) ; // col_white
		return 1 ;
	}

	p_info [ params [ 0 ] ] [ rank ] -- ;

	new scm_string [ 144 ] ;
	format ( scm_string, sizeof scm_string, "[D] %s %s понизил(а) сотрудника '%s' %s. Причина: %s", f_rank [ _demoter_frac - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], f_info [ fraction_id - 1 ] [ f_name ], p_info [ params [ 0 ] ] [ name ], params [ 1 ] ) ;
	foreach(new i: logged_players) if ( 18 > p_info [ i ] [ member ] > 0 && p_info [ i ] [ settings ] [ 0 ] ) SendClientMessage ( i, 0xFF8282AA, scm_string ) ;

	format ( scm_string, 128, "UPDATE `fractions_players` SET `u_rank` = '%d' WHERE `u_sql_id` = '%d' LIMIT 1", p_info [ params [ 0 ] ] [ rank ], p_info [ params [ 0 ] ] [ id ] ) ;
	mysql_tquery ( sql_connection, scm_string ) ;

	format ( scm_string, 128, "Понизил(а) сотрудника %s %s. Причина: %s", f_info [ fraction_id - 1 ] [ f_letter_name ], p_info [ params [ 0 ] ] [ name ], params [ 1 ]);
	write_fraction ( playerid, _demoter_frac, TYPE_LOG_OBWYAK, scm_string ) ;
	return 1 ;
}

alias:take("frisk")
CMD:take ( playerid, params [ ] )
{
	if ( ! cop_player ( playerid ) && ! fbi_player ( playerid ) && ! prison_player ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команда доступна только для гос. организаций." ) ;
	if ( ! is_fraction_duty { playerid } ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Не начат рабочий день." ) ;
	if ( p_info [ playerid ] [ rank ] < 5 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Доступно с 5 ранга." ) ;

	if ( sscanf ( params, "u", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /take [ид/имя]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете обыскать самого себя." ) ;
    if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;
    if ( pl_afk_time [ params [ 0 ] ] > 30 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Этот игрок в AFK. Вы не можете обыскать его." ) ;
    if ( p_info [ params [ 0 ] ] [ hour_played ] < THREE_HOUR_PLAYED ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нельзя обыскивать новичков." ) ;

    if ( reload_police_warning ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы пытаетесь применить NonRP санкцию! Она заблокирована." ) ;

	new bool: _chance_mafia = false ;

    #if defined m_perks
	new _perk_stats = get_perk_info ( params [ 0 ], PERK_MAFIA ) ;
	if ( _perk_stats > 0 && random ( 100 ) < _perk_stats )
	{
		_chance_mafia = true ;
	}
	#endif

	#if defined m_fractions
	    give_emp_progress ( playerid, 0, 1 ) ;
	#endif

	#if defined m_fractions
		if ( army_player ( params [ 0 ] ) ) give_emp_progress ( playerid, 7, 1 ) ;
	#endif

	p_t_info [ playerid ] [ lic_status ] = 1 ;
	p_t_info [ playerid ] [ lic_hour ] = 0 ;
	format ( p_t_info [ playerid ] [ lic_reason ], 16, "None" ) ;

	new str_string [ 64 ] ;
	format ( str_string, sizeof ( str_string ), "достал(-а) перчатки и обыскал(-а) %s", p_info [ params [ 0 ] ] [ name ] ) ;
	me_action ( playerid, str_string ) ;

	global_string [ 0 ] = EOS ;
	new bool: find_take = false, _position_take = 1 ;

	if ( p_info [ params [ 0 ] ] [ drive_lic ] )
	{
	    p_t_info [ playerid ] [ take_position ] [ _position_take - 1 ] = 0 ;
		format ( str_string, sizeof str_string, "{"#cBL"}%d. {"#cWH"}Водительские права\n", _position_take ) ;
		strcat ( global_string, str_string ) ;

		_position_take ++ ;
		find_take = true ;
	}
	if ( p_info [ params [ 0 ] ] [ boat_lic ] )
	{
	    p_t_info [ playerid ] [ take_position ] [ _position_take - 1 ] = 1 ;
		format ( str_string, sizeof str_string, "{"#cBL"}%d. {"#cWH"}Лицензия на вод. транспорт\n", _position_take ) ;
		strcat ( global_string, str_string ) ;

		_position_take ++ ;
		find_take = true ;
	}
	if ( p_info [ params [ 0 ] ] [ fly_lic ] )
	{
	    p_t_info [ playerid ] [ take_position ] [ _position_take - 1 ] = 2 ;
		format ( str_string, sizeof str_string, "{"#cBL"}%d. {"#cWH"}Лицензия на возд. транспорт\n", _position_take ) ;
		strcat ( global_string, str_string ) ;

		_position_take ++ ;
		find_take = true ;
	}
	if ( p_info [ params [ 0 ] ] [ gun_lic ] )
	{
	    p_t_info [ playerid ] [ take_position ] [ _position_take - 1 ] = 3 ;
		format ( str_string, sizeof str_string, "{"#cBL"}%d. {"#cWH"}Лицензия на оружие\n", _position_take ) ;
		strcat ( global_string, str_string ) ;

		_position_take ++ ;
		find_take = true ;
	}

	if ( _chance_mafia == false )
	{
		new _drugs = GetInventoryFindItem ( params [ 0 ], SUB_INVENTORY, 2155 ) ;
		if ( _drugs )
		{
		    p_t_info [ playerid ] [ take_position ] [ _position_take - 1 ] = 4 ;
			format ( str_string, sizeof str_string, "{"#cBL"}%d. {"#cWH"}Наркотики {"#cGRDialog"}(%d)\n", _position_take, _drugs ) ;
			strcat ( global_string, str_string ) ;

			_position_take ++ ;
			find_take = true ;
		}
		new _ammo = GetInventoryFindItem ( params [ 0 ], SUB_INVENTORY, 2154 ) ;
		if ( _ammo )
		{
		    p_t_info [ playerid ] [ take_position ] [ _position_take - 1 ] = 5 ;
			format ( str_string, sizeof str_string, "{"#cBL"}%d. {"#cWH"}Патроны {"#cGRDialog"}(%d)\n", _position_take, _ammo ) ;
			strcat ( global_string, str_string ) ;

			_position_take ++ ;
			find_take = true ;
		}
		new _guns = GetInventoryFindItem ( params [ 0 ], SUB_INVENTORY, 2153 ) ;
		if ( _guns )
		{
		    p_t_info [ playerid ] [ take_position ] [ _position_take - 1 ] = 6 ;
			format ( str_string, sizeof str_string, "{"#cBL"}%d. {"#cWH"}Ед. оружия {"#cGRDialog"}(%d)\n", _position_take, _guns ) ;
			strcat ( global_string, str_string ) ;

			_position_take ++ ;
			find_take = true ;
		}
		new _seed = GetInventoryFindItem ( params [ 0 ], SUB_INVENTORY, 2159 ) ;
		if ( _seed )
		{
		    p_t_info [ playerid ] [ take_position ] [ _position_take - 1 ] = 7 ;
			format ( str_string, sizeof str_string, "{"#cBL"}%d. {"#cWH"}Семена {"#cGRDialog"}(%d)\n", _position_take, _seed ) ;
			strcat ( global_string, str_string ) ;

			_position_take ++ ;
			find_take = true ;
		}
	}
	for ( new j = 0 ; j < 12 ; j ++ )
	{
		if ( p_t_info [ params [ 0 ] ] [ p_gun_slot ] [ j ] != 0 && p_t_info [ params [ 0 ] ] [ p_gun_ammo ] [ j ] != 0 )
		{
		    new gun_name[ 32 ] ;
			GetWeaponName ( p_t_info [ params [ 0 ] ] [ p_gun_slot ] [ j ], gun_name, 32 ) ;

			p_t_info [ playerid ] [ take_position ] [ _position_take - 1 ] = 9 + j ;
			format ( str_string, sizeof str_string, "{"#cBL"}%d. {"#cWH"}%s {"#cGRDialog"}(%d)\n", _position_take, gun_name, p_t_info [ params [ 0 ] ] [ p_gun_ammo ] [ j ] ) ;
			strcat ( global_string, str_string ) ;

			_position_take ++ ;
			find_take = true ;
		}
	}
	if ( find_take == false ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока ничего нет." ) ;

	new header_string [ 20 + MAX_PLAYER_NAME ] ;
	format ( header_string, sizeof ( header_string ), "{"#cBHD"}Обыск %s", p_info [ params [ 0 ] ] [ name ] ) ;
	show_dialog ( playerid, d_take, DIALOG_STYLE_LIST, header_string, global_string, "Выбрать", "Закрыть" ) ;

	buyer_id [ playerid ] = params [ 0 ] ;
	return 1 ;
}

stock show_take_lic ( playerid, targetid, _lic_type )
{
    global_string [ 0 ] = EOS ;
    new line_string [ 64 ] ;

    new sanction_status [ 32 ] ;
    switch ( p_t_info [ playerid ] [ lic_status ] )
    {
        case 0: format ( sanction_status, sizeof sanction_status, "Отобрать" ) ;
        case 1: format ( sanction_status, sizeof sanction_status, "Без санкции" ) ;
        case 2: format ( sanction_status, sizeof sanction_status, "Заморозка" ) ;
        case 3: format ( sanction_status, sizeof sanction_status, "Ограничение на получение" ) ;
    }

    format ( line_string, sizeof line_string, "Санкция: {"#cGRDialog"}%s\n", sanction_status ) ;
    strcat ( global_string, line_string ) ;
    format ( line_string, sizeof line_string, "Срок санкции: {"#cGRDialog"}%d часов\n", p_t_info [ playerid ] [ lic_hour ] ) ;
    strcat ( global_string, line_string ) ;
    format ( line_string, sizeof line_string, "Причина санкции: {"#cGRDialog"}%s\n", p_t_info [ playerid ] [ lic_reason ] ) ;
    strcat ( global_string, line_string ) ;
    if ( p_t_info [ playerid ] [ lic_status ] > 1 && p_t_info [ playerid ] [ lic_hour ] > 0 && ! GetString ( p_t_info [ playerid ] [ lic_reason ], "None" ) ||
    	! GetString ( p_t_info [ playerid ] [ lic_reason ], "None" ) ) strcat ( global_string, "{"#cBL"}Продолжить\n \n" ) ;
    else strcat ( global_string, "{"#cRD"}Продолжить\n \n" ) ;

    if ( _lic_type == 1 )
    {
	    strcat ( global_string, "{"#cBL"}Действующие санкции на водительские права:\n" ) ;
		if ( ! p_info [ targetid ] [ drive_lic ] ) strcat ( global_string, "{"#cGRDialog"}Нет, можно получить\n" ) ;
		else if ( p_info [ targetid ] [ drive_lic ] == 1 )
		{
		    strcat ( global_string, "{"#cGRDialog"}Имеются, без ограничений\n" ) ;
		    format ( line_string, sizeof line_string, "{"#cGRDialog"}Срок действия: {"#cWH"}%d дн.\n", p_info [ targetid ] [ drive_day ] ) ;
		    strcat ( global_string, line_string ) ;
		}
		else if ( p_info [ targetid ] [ drive_lic ] == 2 )
		{
			strcat ( global_string, "{"#cGRDialog"}Имеются, {"#cLY"}временно заморожены\n" ) ;
		    format ( line_string, sizeof line_string, "{"#cGRDialog"}Срок действия: {"#cWH"}%d дн.\n", p_info [ targetid ] [ drive_day ] ) ;
		    strcat ( global_string, line_string ) ;
		    format ( line_string, sizeof line_string, "{"#cGRDialog"}Заморожены на {"#cWH"}%d часов\n", p_info [ targetid ] [ drive_hour ] ) ;
		    strcat ( global_string, line_string ) ;
		    format ( line_string, sizeof line_string, "{"#cGRDialog"}Причина: {"#cWH"}%s\n", p_info [ targetid ] [ drive_reason ] ) ;
		    strcat ( global_string, line_string ) ;
		}
		else if ( p_info [ targetid ] [ drive_lic ] == 3 )
		{
			strcat ( global_string, "{"#cGRDialog"}Нет, {"#cRD"}ограничение на получение\n" ) ;
		    format ( line_string, sizeof line_string, "{"#cGRDialog"}Ограничение на {"#cWH"}%d часов\n", p_info [ targetid ] [ drive_hour ] ) ;
		    strcat ( global_string, line_string ) ;
		    format ( line_string, sizeof line_string, "{"#cGRDialog"}Причина: {"#cWH"}%s\n", p_info [ targetid ] [ drive_reason ] ) ;
		    strcat ( global_string, line_string ) ;
		}
	}

	else if ( _lic_type == 2 )
    {
		strcat ( global_string, "{"#cBL"}Действующие санкции на лицензию пилота:\n" ) ;
		if ( ! p_info [ targetid ] [ fly_lic ] ) strcat ( global_string, "{"#cGRDialog"}Нет, можно получить\n" ) ;
		else if ( p_info [ targetid ] [ fly_lic ] == 1 )
		{
		    strcat ( global_string, "{"#cGRDialog"}Имеются, без ограничений\n" ) ;
		    format ( line_string, sizeof line_string, "{"#cGRDialog"}Срок действия: {"#cWH"}%d дн.\n", p_info [ targetid ] [ fly_day ] ) ;
		    strcat ( global_string, line_string ) ;
		}
		else if ( p_info [ targetid ] [ fly_lic ] == 2 )
		{
			strcat ( global_string, "{"#cGRDialog"}Имеются, {"#cLY"}временно заморожены\n" ) ;
		    format ( line_string, sizeof line_string, "{"#cGRDialog"}Срок действия: {"#cWH"}%d дн.\n", p_info [ targetid ] [ fly_day ] ) ;
		    strcat ( global_string, line_string ) ;
		    format ( line_string, sizeof line_string, "{"#cGRDialog"}Заморожены на {"#cWH"}%d часов\n", p_info [ targetid ] [ fly_hour ] ) ;
		    strcat ( global_string, line_string ) ;
		    format ( line_string, sizeof line_string, "{"#cGRDialog"}Причина: {"#cWH"}%s\n", p_info [ targetid ] [ fly_reason ] ) ;
		    strcat ( global_string, line_string ) ;
		}
		else if ( p_info [ targetid ] [ fly_lic ] == 3 )
		{
			strcat ( global_string, "{"#cGRDialog"}Нет, {"#cRD"}ограничение на получение\n" ) ;
		    format ( line_string, sizeof line_string, "{"#cGRDialog"}Ограничение на {"#cWH"}%d часов\n", p_info [ targetid ] [ fly_hour ] ) ;
		    strcat ( global_string, line_string ) ;
		    format ( line_string, sizeof line_string, "{"#cGRDialog"}Причина: {"#cWH"}%s\n", p_info [ targetid ] [ fly_reason ] ) ;
		    strcat ( global_string, line_string ) ;
		}
	}

    else if ( _lic_type == 3 )
    {
		strcat ( global_string, "{"#cBL"}Действующие санкции на лицензию на водный транспорт:\n" ) ;
		if ( ! p_info [ targetid ] [ boat_lic ] ) strcat ( global_string, "{"#cGRDialog"}Нет, можно получить\n" ) ;
		else if ( p_info [ targetid ] [ boat_lic ] == 1 )
		{
		    strcat ( global_string, "{"#cGRDialog"}Имеются, без ограничений\n" ) ;
		    format ( line_string, sizeof line_string, "{"#cGRDialog"}Срок действия: {"#cWH"}%d дн.\n", p_info [ targetid ] [ boat_day ] ) ;
		    strcat ( global_string, line_string ) ;
		}
		else if ( p_info [ targetid ] [ boat_lic ] == 2 )
		{
			strcat ( global_string, "{"#cGRDialog"}Имеются, {"#cLY"}временно заморожены\n" ) ;
		    format ( line_string, sizeof line_string, "{"#cGRDialog"}Срок действия: {"#cWH"}%d дн.\n", p_info [ targetid ] [ boat_day ] ) ;
		    strcat ( global_string, line_string ) ;
		    format ( line_string, sizeof line_string, "{"#cGRDialog"}Заморожены на {"#cWH"}%d часов\n", p_info [ targetid ] [ boat_hour ] ) ;
		    strcat ( global_string, line_string ) ;
		    format ( line_string, sizeof line_string, "{"#cGRDialog"}Причина: {"#cWH"}%s\n", p_info [ targetid ] [ boat_reason ] ) ;
		    strcat ( global_string, line_string ) ;
		}
		else if ( p_info [ targetid ] [ boat_lic ] == 3 )
		{
			strcat ( global_string, "{"#cGRDialog"}Нет, {"#cRD"}ограничение на получение\n" ) ;
		    format ( line_string, sizeof line_string, "{"#cGRDialog"}Ограничение на {"#cWH"}%d часов\n", p_info [ targetid ] [ boat_hour ] ) ;
		    strcat ( global_string, line_string ) ;
		    format ( line_string, sizeof line_string, "{"#cGRDialog"}Причина: {"#cWH"}%s\n", p_info [ targetid ] [ boat_reason ] ) ;
		    strcat ( global_string, line_string ) ;
		}
	}

    else if ( _lic_type == 4 )
    {
		strcat ( global_string, "{"#cBL"}Действующие санкции на лицензия на оружие:\n" ) ;
		if ( ! p_info [ targetid ] [ gun_lic ] ) strcat ( global_string, "{"#cGRDialog"}Нет, можно получить\n" ) ;
		else if ( p_info [ targetid ] [ gun_lic ] == 1 )
		{
		    strcat ( global_string, "{"#cGRDialog"}Имеются, без ограничений\n" ) ;
		    format ( line_string, sizeof line_string, "{"#cGRDialog"}Срок действия: {"#cWH"}%d дн.\n", p_info [ targetid ] [ gun_day ] ) ;
		    strcat ( global_string, line_string ) ;
		}
		else if ( p_info [ targetid ] [ gun_lic ] == 2 )
		{
			strcat ( global_string, "{"#cGRDialog"}Имеются, {"#cLY"}временно заморожены\n" ) ;
		    format ( line_string, sizeof line_string, "{"#cGRDialog"}Срок действия: {"#cWH"}%d дн.\n", p_info [ targetid ] [ gun_day ] ) ;
		    strcat ( global_string, line_string ) ;
		    format ( line_string, sizeof line_string, "{"#cGRDialog"}Заморожены на {"#cWH"}%d часов\n", p_info [ targetid ] [ gun_hour ] ) ;
		    strcat ( global_string, line_string ) ;
		    format ( line_string, sizeof line_string, "{"#cGRDialog"}Причина: {"#cWH"}%s\n", p_info [ targetid ] [ gun_reason ] ) ;
		    strcat ( global_string, line_string ) ;
		}
		else if ( p_info [ targetid ] [ gun_lic ] == 3 )
		{
			strcat ( global_string, "{"#cGRDialog"}Нет, {"#cRD"}ограничение на получение\n" ) ;
		    format ( line_string, sizeof line_string, "{"#cGRDialog"}Ограничение на {"#cWH"}%d часов\n", p_info [ targetid ] [ gun_hour ] ) ;
		    strcat ( global_string, line_string ) ;
		    format ( line_string, sizeof line_string, "{"#cGRDialog"}Причина: {"#cWH"}%s\n", p_info [ targetid ] [ gun_reason ] ) ;
		    strcat ( global_string, line_string ) ;
		}
	}
	new header_string [ 20 + MAX_PLAYER_NAME ] ;
	format ( header_string, sizeof ( header_string ), "{"#cBHD"}Обыск %s", p_info [ targetid ] [ name ] ) ;
	show_dialog ( playerid, d_take_lic, DIALOG_STYLE_LIST, header_string, global_string, "Выбрать", "Закрыть" ) ;
	return 1 ;
}

stock licenses_sanction ( playerid )
{
    if ( p_info [ playerid ] [ drive_lic ] == 2 )
	{
	    if ( --p_info [ playerid ] [ drive_hour ] == 0 )
	    {
            p_info [ playerid ] [ drive_lic ] = 1 ;

            new sql_string [ 100 ] ;
            format ( sql_string, sizeof sql_string, "UPDATE `users` SET `u_drive_hour` = '0', `u_drive_lic` = '1' WHERE `u_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
            mysql_tquery ( sql_connection, sql_string ) ;

            SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Санкции с водительским прав сняты, можете вновь ими пользоваться." ) ;
	    }
	    else update_int_sql ( playerid, "u_drive_hour", p_info [ playerid ] [ drive_hour ] ) ;
	}
	else if ( p_info [ playerid ] [ drive_lic ] == 3 )
	{
	    if ( --p_info [ playerid ] [ drive_hour ] == 0 )
	    {
            p_info [ playerid ] [ drive_lic ] = 0 ;

            new sql_string [ 100 ] ;
            format ( sql_string, sizeof sql_string, "UPDATE `users` SET `u_drive_hour` = '0', `u_drive_lic` = '0' WHERE `u_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
            mysql_tquery ( sql_connection, sql_string ) ;

            SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Санкции с водительским прав сняты, можете вновь их получить." ) ;
	    }
	    else update_int_sql ( playerid, "u_drive_hour", p_info [ playerid ] [ drive_hour ] ) ;
	}

    if ( p_info [ playerid ] [ fly_lic ] == 2 )
	{
	    if ( --p_info [ playerid ] [ fly_hour ] == 0 )
	    {
            p_info [ playerid ] [ fly_lic ] = 1 ;

            new sql_string [ 100 ] ;
            format ( sql_string, sizeof sql_string, "UPDATE `users` SET `u_fly_hour` = '0', `u_fly_lic` = '1' WHERE `u_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
            mysql_tquery ( sql_connection, sql_string ) ;

            SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Санкции с лицензии на возд. т/с сняты, можете вновь ей пользоваться." ) ;
	    }
	    else update_int_sql ( playerid, "u_fly_hour", p_info [ playerid ] [ fly_hour ] ) ;
	}
	else if ( p_info [ playerid ] [ fly_lic ] == 3 )
	{
	    if ( --p_info [ playerid ] [ fly_hour ] == 0 )
	    {
            p_info [ playerid ] [ fly_lic ] = 0 ;

            new sql_string [ 100 ] ;
            format ( sql_string, sizeof sql_string, "UPDATE `users` SET `u_fly_hour` = '0', `u_fly_lic` = '0' WHERE `u_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
            mysql_tquery ( sql_connection, sql_string ) ;

            SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Санкции с лицензии на возд. т/с сняты, можете вновь её получить." ) ;
	    }
	    else update_int_sql ( playerid, "u_fly_hour", p_info [ playerid ] [ fly_hour ] ) ;
	}

    if ( p_info [ playerid ] [ boat_lic ] == 2 )
	{
	    if ( --p_info [ playerid ] [ boat_hour ] == 0 )
	    {
            p_info [ playerid ] [ boat_lic ] = 1 ;

            new sql_string [ 100 ] ;
            format ( sql_string, sizeof sql_string, "UPDATE `users` SET `u_boat_hour` = '0', `u_boat_lic` = '1' WHERE `u_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
            mysql_tquery ( sql_connection, sql_string ) ;

            SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Санкции с лицензии на вод. т/с сняты, можете вновь ей пользоваться." ) ;
	    }
	    else update_int_sql ( playerid, "u_boat_hour", p_info [ playerid ] [ boat_hour ] ) ;
	}
	else if ( p_info [ playerid ] [ boat_lic ] == 3 )
	{
	    if ( --p_info [ playerid ] [ boat_hour ] == 0 )
	    {
            p_info [ playerid ] [ boat_lic ] = 0 ;

            new sql_string [ 100 ] ;
            format ( sql_string, sizeof sql_string, "UPDATE `users` SET `u_boat_hour` = '0', `u_boat_lic` = '0' WHERE `u_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
            mysql_tquery ( sql_connection, sql_string ) ;

            SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Санкции с лицензии на вод. т/с сняты, можете вновь её получить." ) ;
	    }
	    else update_int_sql ( playerid, "u_boat_hour", p_info [ playerid ] [ boat_hour ] ) ;
	}

	if ( p_info [ playerid ] [ gun_lic ] == 2 )
	{
	    if ( --p_info [ playerid ] [ gun_hour ] == 0 )
	    {
            p_info [ playerid ] [ gun_lic ] = 1 ;

            new sql_string [ 100 ] ;
            format ( sql_string, sizeof sql_string, "UPDATE `users` SET `u_gun_hour` = '0', `u_gun_lic` = '1' WHERE `u_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
            mysql_tquery ( sql_connection, sql_string ) ;

            SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Санкции с лицензии на оружие сняты, можете вновь ей пользоваться." ) ;
	    }
	    else update_int_sql ( playerid, "u_gun_hour", p_info [ playerid ] [ gun_hour ] ) ;
	}
	else if ( p_info [ playerid ] [ gun_lic ] == 3 )
	{
	    if ( --p_info [ playerid ] [ gun_hour ] == 0 )
	    {
            p_info [ playerid ] [ gun_lic ] = 0 ;

            new sql_string [ 100 ] ;
            format ( sql_string, sizeof sql_string, "UPDATE `users` SET `u_gun_hour` = '0', `u_gun_lic` = '0' WHERE `u_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
            mysql_tquery ( sql_connection, sql_string ) ;

            SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Санкции с лицензии на оружие сняты, можете вновь её получить." ) ;
	    }
	    else update_int_sql ( playerid, "u_gun_hour", p_info [ playerid ] [ gun_hour ] ) ;
	}

	return 1 ;
}

CMD:ticket ( playerid, params [ ] )
{
	if ( ! cop_player ( playerid ) && ! fbi_player ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команда доступна только для гос. организаций." ) ;
	if ( ! is_fraction_duty { playerid } ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Не начат рабочий день." ) ;
	if ( p_info [ playerid ] [ rank ] < 3 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Доступно с 3 ранга." ) ;

	if ( sscanf ( params, "uds[100]", params [ 0 ], params [ 1 ], params [ 2 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /ticket [ид/имя] [сумма] [причина]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете выписать штраф самому себе." ) ;
    if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;
	if ( strlen ( params [ 2 ] ) > 100 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Причина не может быть длиннее 100 символов." ) ;
	if ( params [ 1 ] < 1 || params [ 1 ] > 100000 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Сумма не может быть меньше {"#cRD"}1"valute_title_"{"#cGRInfo"} или больше {"#cRD"}100.000"valute_title"{"#cGRInfo"}." ) ;
    if ( pl_afk_time [ params [ 0 ] ] > 30 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Этот игрок в AFK. Вы не можете выписать штраф." ) ;
	if ( p_info [ params [ 0 ] ] [ ticket_c ] + 1 >= 30 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока максимально количество штрафов." ) ;

    if ( ! tablet_sanction [ playerid ] && reload_police_warning ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы пытаетесь применить NonRP санкцию! Она заблокирована." ) ;

    #if defined m_fractions
	    give_emp_progress ( playerid, 1, 1 ) ;
	#endif

	tablet_sanction [ playerid ] = false ;

	new scm_string [ 130 + MAX_PLAYER_NAME * 2 + 42 + 6 + 6 ] ;
	InsertNewTicket ( playerid, params [ 1 ], INVALID_VEHICLE_ID, "member" ) ;
	format ( scm_string, 144, "Вы выписали %s[%d] штраф в размере %d"valute_title". Причина: %s",
	p_info [ params [ 0 ] ] [ name ], params [ 0 ], params [ 1 ], params [ 2 ]	) ;
	SendClientMessage ( playerid, col_wavy, scm_string ) ;
	format ( scm_string, 144, "%s[%d] выписал(-а) Вам штраф в размере %d"valute_title". Причина: %s",
	p_info [ playerid ] [ name ], playerid, params [ 1 ], params [ 2 ] ) ;
	SendClientMessage ( params [ 0 ], col_wavy, scm_string ) ;
	SendClientMessage ( params [ 0 ], col_wavy, !"* Оплатить штрафы можно в любом банке или банкомате." ) ;
	SendClientMessage ( params [ 0 ], col_wavy, !"* Используйте {"#cWH"}/gps{14A3FF}, чтоб найти банк / банкомат." ) ;

	p_info [ params [ 0 ] ] [ ticket_c ] ++ ;
	return 1 ;
}

CMD:search_mobile ( playerid, params [ ] )
{
	if ( ! cop_player ( playerid ) && ! fbi_player ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команда доступна только для гос. организаций." ) ;
	if ( sscanf ( params, "u", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /search_mobile [ид/имя]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете начать поиски самого себя." ) ;
 	if ( p_info [ params [ 0 ] ] [ wanted ] == 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данный игрок не находится в розыске." ) ;

	if ( is_gps_used { playerid } )
	{
		SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}[GPS] Последняя метка уничтожена." ) ;
		DisablePlayerRaceCheckpoint ( playerid ) ;
		is_gps_used { playerid } = 0 ;
	}
	else
	{
		new scm_string [ 100 ] ;
		format ( scm_string, sizeof ( scm_string ), "{"#cGInfo"}* {"#cWH"}Вы отметили на карте {"#cGN"}%s[%i]{"#cWH"}.", p_info [ params [ 0 ] ] [ name ], params [ 0 ] ) ;
		SendClientMessage ( playerid, col_white, scm_string ) ;

		DisablePlayerRaceCheckpoint ( playerid ) ;
		SetPlayerRaceCheckpoint ( playerid, 1, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ], 0.0, 0.0, 0.0, 5 ) ;
		is_gps_used { playerid } = 1 ;
	}
	return 1 ;
}

CMD:m ( playerid, params [ ] )
{
	if ( ! cop_player ( playerid ) && ! fbi_player ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команда доступна только для гос. организаций." ) ;
	if ( ! is_fraction_duty { playerid } ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Не начат рабочий день." ) ;
	if ( p_info [ playerid ] [ mute ] )
	{
		new scm_string [ 38 ] ;
		format ( scm_string, sizeof ( scm_string ),"У вас бан чата | %d секунд(ы)", p_info [ playerid ] [ mute ] ) ;
		SendClientMessage ( playerid, col_light_red, scm_string ) ;
		return false ;
	}
	if ( isnull ( params ) || params [ 0 ] == ' ' ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /m [текст]" ) ;

	new veh_id = GetPlayerVehicleID ( playerid ) ;
	if ( veh_id == 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нужно находиться в транспорте." ) ;

	if ( veh_info [ veh_id - 1 ] [ v_type ] == vehicle_type_server && ( veh_info [ veh_id - 1 ] [ v_owner ] == 4 || veh_info [ veh_id - 1 ] [ v_owner ] == 5 || veh_info [ veh_id - 1 ] [ v_owner ] == 6 || veh_info [ veh_id - 1 ] [ v_owner ] == 7 ) )
	{
		new scm_string [ 144 ] ;
		format ( scm_string, sizeof ( scm_string ),"%s, %s (в мегафон): %s",
		f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_name ], p_info [ playerid ] [ name ], params [ 0 ] ) ;
		send_world_message ( playerid, 30.0, scm_string, col_yellow, col_yellow, col_yellow, false ) ;
	}
	return true ;
}

CMD:su ( playerid, params [ ] )
{
	if ( ! cop_player ( playerid ) && ! fbi_player ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команда доступна только для гос. организаций." ) ;
	if ( ! is_fraction_duty { playerid } ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Не начат рабочий день." ) ;
	if ( p_info [ playerid ] [ rank ] < 5 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Доступно с 5 ранга." ) ;
	if ( sscanf ( params, "uds[100]", params [ 0 ], params [ 1 ], params [ 2 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /su [ид/имя] [розыск] [причина]" ) ;
	if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете объявить в розыск самого себя." ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] )  || params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( cop_player ( params [ 0 ] ) || fbi_player ( params [ 0 ] ) || army_player ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок состоит в гос. структурах." ) ;
	if ( params [ 1 ] < 1 || params [ 1 ] > 6 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Уровень розыска должен быть от 1 до 6." ) ;
	if ( p_info [ params [ 0 ] ] [ jailed ] > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нельзя объявить в розыск заключенного." ) ;
	if ( pl_afk_time [ params [ 0 ] ] > 30 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Этот игрок в AFK. Ему нельзя выдать розыск." ) ;
	if ( p_info [ params [ 0 ] ] [ wanted ] + params [ 1 ] > 6 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете выдать игроку более 6 звёзд." ) ;
	if ( p_info [ params [ 0 ] ] [ hour_played ] < THREE_HOUR_PLAYED ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нельзя объявить в розыск новичка." ) ;
	if ( ! IsPlayerInRangeOfPoint ( playerid, 15, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;

    if ( ! tablet_sanction [ playerid ] && reload_police_warning ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы пытаетесь применить NonRP санкцию! Она заблокирована." ) ;
	if ( IsMessageReklama ( params [ 2 ] ) )
	{
	    new _max_warn = 3 ;

		#if defined m_perks
		new _perk_stats = get_perk_info ( playerid, PERK_ADMIN_FRIEND ) ;
		if ( _perk_stats > 0 ) _max_warn = _perk_stats ;
		#endif

	    if ( p_info [ playerid ] [ p_warn ] == _max_warn - 1 )
		{
			new scm_string [ 238 ] ;
			format( scm_string, 144, "Сервер заблокировал %s [3 предупреждения]. Срок: 3 дня. Причина: Некорректная причина /su", p_info [ playerid ] [ name ] ) ;
			foreach(new i: admin_players) SendClientMessage ( i, col_light_red, scm_string ) ;
			SendClientMessage ( playerid, col_light_red, scm_string ) ;

			mysql_format ( sql_connection, scm_string, sizeof ( scm_string  ), "INSERT INTO `users_bans` (`u_b_admin`,`u_b_name`,`u_b_reason`,`u_b_date`,`u_b_ndate`,`u_b_days`) VALUES ( 'Сервер', '%s', 'Некорректная причина /su', NOW() + INTERVAL 3 DAY, NOW(), '3' )", p_info [ playerid ] [ name ] ) ;
			mysql_tquery ( sql_connection, scm_string, "callback_process_ban", "i", playerid ) ;

			format ( scm_string, sizeof scm_string, "UPDATE `users_warns` SET `w_end`=NOW() WHERE `w_owner`='%d'", p_info [ playerid ] [ id ] ) ;
			mysql_tquery ( sql_connection, scm_string ) ;

		}
		else
		{
			new scm_string [ 238 ] ;
			format( scm_string, 144, "Сервер выдал предупреждение игроку %s. Причина: Некорректная причина /su", p_info [ playerid ] [ name ] ) ;
			foreach(new i: admin_players) SendClientMessage ( i, col_light_red, scm_string ) ;
			SendClientMessage ( playerid, col_light_red, scm_string ) ;

			format ( scm_string,sizeof(scm_string),"UPDATE `users_admins` SET `u_a_warns` = `u_a_warns`+1 WHERE `u_a_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
			mysql_tquery ( sql_connection, scm_string, "", "" ) ;

			format ( scm_string, sizeof ( scm_string  ), "INSERT INTO `users_warns` (`w_admin_name`,`w_name`,`w_owner`,`w_reason`,`w_date`,`w_end`) VALUES ('Сервер', '%s', '%d', 'Некорректная причина /su', NOW(), NOW() + INTERVAL 3 DAY)", p_info [ playerid ] [ name ], p_info [ playerid ] [ id ] ) ;
			mysql_tquery ( sql_connection, scm_string ) ;

			format(scm_string, 128, "Сервер выдал предупреждение %s. Причина: Некорректная причина /su", p_info [ playerid ] [ name ] ) ;
			WriteLog(playerid, TYPE_LOG_WARN, scm_string);

			if ( p_info [ playerid ] [ member ] )
			{
				new fraction_id = p_info [ playerid ] [ member ] ;
				Iter_Remove ( fraction_players[fraction_id], playerid ) ;

				f_info [ fraction_id - 1 ] [ f_members ] -- ;
				format ( scm_string, 144, "UPDATE `fractions` SET `f_members` = '%d' WHERE `f_id` = '%d' LIMIT 1", f_info [ fraction_id - 1 ] [ f_members ], fraction_id ) ;
				mysql_tquery ( sql_connection, scm_string ) ;
			}

			p_info [ playerid ] [ member ] =
			p_info [ playerid ] [ rank ] =
			p_info [ playerid ] [ org_skin ] =
			p_info [ playerid ] [ warblock ] =
			p_info [ playerid ] [ subleader ] =
			p_info [ playerid ] [ f_warning ] = 0 ;

			scm_string [ 0 ] = EOS ;
			format ( scm_string, sizeof scm_string, "DELETE FROM `fractions_players` WHERE `u_sql_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
			mysql_tquery ( sql_connection, scm_string ) ;

			kick_player ( playerid ) ;
		}
	    return 1 ;
	}

	tablet_sanction [ playerid ] = false ;
    if ( used_area [ params [ 0 ] ] != -1 )
	{
		new _a_type = area_info [ used_area [ params [ 0 ] ] ] [ a_type ] ;
		if ( _a_type == area_type_sellstatus )
		{
		    return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нельзя заковать игрока в наручники в этой зоне." ) ;
		}
	}

	new bool: to_area = true ;
	for ( new i = 0 ; i < MAX_AREA_JAIL ; i ++ )
	{
		if ( IsPlayerInRangeOfPoint ( playerid, 25, jail_arrest [ i ] [ 0 ], jail_arrest [ i ] [ 1 ], jail_arrest [ i ] [ 2 ] ) ) continue ;

		to_area = false ;
		break ;
	}
	if ( to_area == true ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете выдать розыск в участке." ) ;

	p_info [ params [ 0 ] ] [ wanted ] = params [ 1 ] ;
	SetPlayerWantedLevel( params [ 0 ], p_info [ params [ 0 ] ] [ wanted ] ) ;
	update_int_sql ( params [ 0 ], "u_wanted", params [ 1 ] ) ;

	new scm_string [ 144 ] ;
	format ( scm_string, sizeof ( scm_string ), "Вы были объявлены в розыск! Обвинитель %s. Причина: %s", p_info [ playerid ] [ name ], params [ 2 ] ) ;
	SendClientMessage ( params [ 0 ], col_light_red, scm_string ) ;
	format ( scm_string, sizeof ( scm_string ), "Ваш текущий уровень розыска: %d", p_info [ params [ 0 ] ] [ wanted ] ) ;
	SendClientMessage ( params [ 0 ], col_light_red, scm_string ) ;
	format ( scm_string, sizeof ( scm_string ), "%s был(а) объявлен(a) в розыск! Обвинитель: %s | Причина: %s | Уровень розыска: %d",
	p_info [ params [ 0 ] ] [ name ], p_info [ playerid ] [ name ], params [ 2 ], params [ 1 ] ) ;

	foreach(new i: logged_players) if ( cop_player ( i ) || fbi_player ( i ) || army_player ( i ) ) SendClientMessage ( i, col_lblue, scm_string ) ;

	SendClientMessage ( params [ 0 ], col_light_red, !"Уровень розыска можно понизить через домашний подвал, верстак в гараже." ) ;
	SendClientMessage ( params [ 0 ], col_light_red, !"Уровень розыска понижается автоматические через какое-то случайное время." ) ;
	SendClientMessage ( params [ 0 ], col_light_red, !"Также Вы можете сдаться полиции, отсидеть срок и будете чисты перед законом." ) ;

	format ( scm_string, 128, "Объявил(а) в розыск %s. Причина: %s", p_info [ params [ 0 ] ] [ name ], params [ 2 ]);
	write_fraction ( playerid, p_info [ playerid ] [ member ], TYPE_LOG_OBWYAK, scm_string ) ;
    return true ;
}

stock suspect_player ( playerid, reason_suspect [ ], wanted_point )
{
	new scm_string [ 144 ] ;
	if ( p_info [ playerid ] [ wanted ] + wanted_point < 6 ) p_info [ playerid ] [ wanted ] += wanted_point ;
	else p_info [ playerid ] [ wanted ] = 6 ;
	SetPlayerWantedLevel( playerid, p_info [ playerid ] [ wanted ] ) ;

	if ( p_info [ playerid ] [ law_obedience ] != -100 ) p_info [ playerid ] [ law_obedience ] -- ;

	format ( scm_string, sizeof ( scm_string ), "Вы были объявлены в розыск! Обвинитель Неизвестный. Причина: %s", reason_suspect ) ;
	SendClientMessage ( playerid, col_light_red, scm_string ) ;
	format ( scm_string, sizeof ( scm_string ), "Ваш текущий уровень розыска: %d", p_info [ playerid ] [ wanted ] ) ;
	SendClientMessage ( playerid, col_light_red, scm_string ) ;
	format ( scm_string, sizeof ( scm_string ), "%s был(а) объявлен(a) в розыск! Обвинитель: Неизвестный | Причина: %s | Уровень розыска: %d",
	p_info [ playerid ] [ name ], reason_suspect, p_info [ playerid ] [ wanted ] ) ;

	foreach(new i: logged_players) if ( cop_player ( i ) || fbi_player ( i ) || army_player ( i ) ) SendClientMessage ( i, col_lblue, scm_string ) ;

	SendClientMessage ( playerid, col_light_red, !"Уровень розыска можно понизить через домашний подвал, верстак в гараже." ) ;
	SendClientMessage ( playerid, col_light_red, !"Уровень розыска понижается автоматические через какое-то случайное время." ) ;
	SendClientMessage ( playerid, col_light_red, !"Также Вы можете сдаться полиции, отсидеть срок и будете чисты перед законом." ) ;

	update_int_sql ( playerid, "u_wanted", p_info [ playerid ] [ wanted ] ) ;
	return true ;
}

CMD:comp ( playerid )
{
	if ( ( ! cop_player ( playerid ) && ! fbi_player ( playerid ) ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команда доступна только для гос. организаций." ) ;
	if ( ! is_fraction_duty { playerid } ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Не начат рабочий день." ) ;
	if ( ! IsPlayerInRangeOfPoint ( playerid, 4, 608.9641, -1204.7279, 1001.4650 ) && ! IsPlayerInRangeOfPoint ( playerid, 4, 576.0718, -1204.9175, 1001.4650 ) && ! IsPlayerInRangeOfPoint ( playerid, 5, 1383.2861, -37.0734, 1504.5602 ) )
	{
		if ( player_vehicle [ playerid ] == INVALID_PLAYER_ID ) return 1 ;
		if ( veh_info [ player_vehicle [ playerid ] - 1 ] [ v_owner ] != p_info [ playerid ] [ member ] ) return 1 ;
	}
	show_dialog ( playerid, d_police_comp, DIALOG_STYLE_LIST, "{"#cBHD"}Служебный компьютер", "{"#cBL"}1. {"#cWH"}Найти преступника\n{"#cBL"}2. {"#cWH"}Досье жителей штата\n{"#cBL"}3. {"#cWH"}Слежка по номеру телефона [ {"#cGN"}FBI{"#cWH"} ]\n{"#cBL"}4. {"#cWH"}Статистика штата\n{"#cBL"}5. {"#cWH"}Прослушать телефонный разговор [ {"#cGN"}FBI{"#cWH"} ]\n{"#cBL"}6. {"#cWH"}Чёрный рынок\n{"#cBL"}7. {"#cWH"}Особо опасные преступники", "Выбрать", "Закрыть" ) ;
	return true ;
}

CMD:clear ( playerid, params [ ] )
{
	if ( ! cop_player ( playerid ) && ! fbi_player ( playerid ) )
	{
	    if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Команда доступна только для гос. организаций.", 0, 3, CINFO_OTHER_ID, PICTURE_INFO_ERROR, "", "" ) ;
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команда доступна только для гос. организаций." ) ;
		return 1 ;
	}
	if ( ! is_fraction_duty { playerid } )
	{
	    if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Вы не начали рабочий день.", 0, 3, CINFO_OTHER_ID, PICTURE_INFO_ERROR, "", "" ) ;
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не начали рабочий день." ) ;
		return 1 ;
	}
	if ( sscanf ( params, "u", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /clear [ид/имя]" ) ;
	if ( params [ 0 ] == playerid )
	{
	    if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Вы не можете убрать себя из розыска.", 0, 3, CINFO_OTHER_ID, PICTURE_INFO_ERROR, "", "" ) ;
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете убрать себя из розыска." ) ;
		return 1 ;
	}
	if ( ! IsPlayerConnected ( params [ 0 ] ) || params [ 0 ] == playerid )
	{
	    if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Игрок не найден.", 0, 3, CINFO_OTHER_ID, PICTURE_INFO_ERROR, "", "" ) ;
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
		return 1 ;
	}
	if ( p_info [ params [ 0 ] ] [ wanted ] == 0 )
	{
	    if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Игрок не находится в розыске.", 0, 3, CINFO_OTHER_ID, PICTURE_INFO_ERROR, "", "" ) ;
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не находится в розыске." ) ;
		return 1 ;
	}

    new fraction_id = p_info [ playerid ] [ member ] ;
	if ( p_info [ playerid ] [ rank ] < f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 9 ] )
	{
	    static const _str [ ] = "{"#cRInfo"}* {"#cGRInfo"}Команда доступна с ранга %s (%d)." ;
	    new scm_string [ sizeof _str + 30 + 3 ] ;
	    format ( scm_string, sizeof scm_string, _str, f_rank [ fraction_id - 1 ] [ f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 9 ] - 1 ], f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 9 ] ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
		return 1 ;
	}

	new _text_string [ 144 ] ;
    format ( _text_string, sizeof ( _text_string ),"%s %s очистил(а) Ваш розыск.",
	f_rank [ p_info [ playerid ] [ member ] - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ] ) ;
    SendClientMessage ( params [ 0 ], col_lblue, _text_string ) ;

 	format ( _text_string, sizeof ( _text_string ), "[D] (%s) %s %s очистил(а) розыск %s.",
	f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_name ], f_rank [ p_info [ playerid ] [ member ] - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ] ) ;
	foreach(new i: logged_players) if ( 18 > p_info [ i ] [ member ] > 0 ) SendClientMessage ( i, 0xFF8282AA, _text_string ) ;

	p_info [ params [ 0 ] ] [ wanted ] = 0 ;
	SetPlayerWantedLevel( params [ 0 ], p_info [ params [ 0 ] ] [ wanted ] ) ;
	update_int_sql ( params [ 0 ], "u_wanted", 0 ) ;

	format ( _text_string, 128, "Очистил розыск %s", p_info [ params [ 0 ] ] [ name ] ) ;
	write_fraction ( playerid, p_info [ playerid ] [ member ], TYPE_LOG_OBWYAK, _text_string ) ;
	return true ;
}

CMD:arrest ( playerid, params [ ] )
{
	if ( ! cop_player ( playerid ) && ! fbi_player ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команда доступна только для гос. организаций." ) ;
	if ( ! is_fraction_duty { playerid } ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Не начат рабочий день." ) ;

	new bool: to_area = false ;
	for ( new i = 0 ; i < MAX_AREA_JAIL ; i ++ )
	{
		if ( ! IsPlayerInRangeOfPoint ( playerid, 5, jail_arrest [ i ] [ 0 ], jail_arrest [ i ] [ 1 ], jail_arrest [ i ] [ 2 ] ) ) continue ;

		to_area = true ;
		break ;
	}
	if ( to_area == false ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы слишком далеко от тюрьмы." ) ;

	if ( sscanf ( params, "udd", params [ 0 ], params [ 1 ], params [ 2 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /arrest [ид/имя] [минуты] [выкуп]" ) ;
	if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете арестовать самого себя." ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] )  || params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
    if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;
	if ( p_info [ params [ 0 ] ] [ jailed ] > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок уже в тюрьме." ) ;
	if ( p_info [ params [ 0 ] ] [ wanted ] < 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данный игрок не в розыске." ) ;
	if ( cop_player ( params [ 0 ] ) || fbi_player ( params [ 0 ] ) || army_player ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок состоит в гос. структурах." ) ;
	if ( params [ 1 ] < 5 || params [ 1 ] > 60 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Время заключения не может быть меньше 5 минут или больше 60 минут." ) ;
	if ( params [ 2 ] < 0 || params [ 2 ] > 1000000 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Сумма выкупа не может быть больше {"#cRD"}1.000.000"valute_title"{"#cGRInfo"}." ) ;

	p_info [ playerid ] [ arrest_count ] ++ ;

	p_info [ params [ 0 ] ] [ bail ] = params [ 2 ] ;
	p_info [ params [ 0 ] ] [ wanted ] = 0 ;
	SetPlayerWantedLevel ( params [ 0 ], p_info [ params [ 0 ] ] [ wanted ] ) ;

	clear_stoped_params ( playerid, params [ 0 ] ) ;
	SetPlayerSpecialAction ( params [ 0 ], SPECIAL_ACTION_NONE ) ;
	RemovePlayerAttachedObject ( params [ 0 ], 1 ) ;

	new scm_string [ 144 ] ;
	if ( params [ 2 ] > 0 )
	{
		format ( scm_string, 68, "Вы были арестованы на %d минут. Залог: %d"valute_title_"", params [ 1 ], params [ 2 ] ) ;
		SendClientMessage ( params [ 0 ], col_light_red, scm_string ) ;
		format ( scm_string, sizeof ( scm_string ), "Вы арестовали %s на %d минут(ы). Залог: %d"valute_title_"", p_info [ params [ 0 ] ] [ name ], params [ 1 ], params [ 2 ] ) ;
		SendClientMessage ( playerid, col_lblue, scm_string ) ;

		format ( scm_string, 128, "Арестовал(а) %s на %d минут(ы). Залог: %d"valute_title_"", p_info [ params [ 0 ] ] [ name ], params [ 1 ], params [ 2 ]);
		write_fraction ( playerid, p_info [ playerid ] [ member ], TYPE_LOG_OBWYAK, scm_string ) ;
	}
	else
	{
		format ( scm_string, 68, "Вы были арестованы на %d минут. Залог: Без залога", params [ 1 ] ) ;
		SendClientMessage ( params [ 0 ], col_light_red, scm_string ) ;
		format ( scm_string, sizeof ( scm_string ), "Вы арестовали %s на %d минут(ы). Залог: Без залога", p_info [ params [ 0 ] ] [ name ], params [ 1 ] ) ;
		SendClientMessage ( playerid, col_lblue, scm_string ) ;

		format ( scm_string, 128, "Арестовал(а) %s на %d минут(ы). Залог: Без залога", p_info [ params [ 0 ] ] [ name ], params [ 1 ]);
		write_fraction ( playerid, p_info [ playerid ] [ member ], TYPE_LOG_OBWYAK, scm_string ) ;
	}

	format ( scm_string, 68, "Вы получили премию в размере {"#cGN"}%d"valute_title_"", WorkSalary [ 4 ] ) ;
	SendClientMessage ( playerid, col_lblue, scm_string ) ;

	format ( scm_string, sizeof scm_string, "UPDATE `fractions_players` SET `u_arrest_count` = `u_arrest_count`+'1' WHERE `u_sql_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
	mysql_tquery ( sql_connection, scm_string ) ;

	give_money(playerid, WorkSalary [ 4 ]);
	insert_money_log ( playerid, INVALID_PLAYER_ID, WorkSalary [ 4 ], "премия [4]" ) ;

	if ( gotome_player [ params [ 0 ] ] != -1 )
	{
		police_gotome [ playerid ] =
		gotome_player [ params [ 0 ] ] = -1 ;
	}

	reset_player_weapon ( params [ 0 ] ) ;

 	p_info [ params [ 0 ] ] [ jail ] = p_t_info [ playerid ] [ p_data ] [ 1 ] ;
	p_info [ params [ 0 ] ] [ jailed ] = params [ 1 ] * 60 ;

 	new random_jail_pos = random ( MAX_JAIL_SPAWN ) ;
	set_pos ( params [ 0 ], jail_spawn [ random_jail_pos ] [ 0 ],
						jail_spawn [ random_jail_pos ] [ 1 ],
						jail_spawn [ random_jail_pos ] [ 2 ],
						jail_spawn [ random_jail_pos ] [ 3 ],
						jail_interior, p_info [ params [ 0 ] ] [ jail ] ) ;

    scm_string [ 0 ] = EOS ;
    format ( scm_string, sizeof scm_string, "UPDATE `users` SET `u_bail` = '%d', `u_wanted` = '%d', `u_jail` = '%d' WHERE `u_id` = '%d' LIMIT 1",
    p_info [ params [ 0 ] ] [ bail ], p_info [ params [ 0 ] ] [ wanted ], p_info [ params [ 0 ] ] [ jail ], p_info [ params [ 0 ] ] [ id ] ) ;
    mysql_tquery ( sql_connection, scm_string ) ;
	return 1 ;
}

CMD:wanted ( playerid )
{
	if ( ! cop_player ( playerid ) && ! fbi_player ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команда доступна только для гос. организаций." ) ;
	if ( ! is_fraction_duty { playerid } ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Не начат рабочий день." ) ;
	ShowWantedList ( playerid ) ;
	return 1 ;
}

CMD:d ( playerid, params [ ] )
{
	if ( p_info [ playerid ] [ member ] >= 18 || p_info [ playerid ] [ member ] == 0 ) return 1 ;
	if ( ! is_fraction_duty { playerid } ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Не начат рабочий день." ) ;

	new fraction_id = p_info [ playerid ] [ member ] ;
	if ( p_info [ playerid ] [ rank ] <  f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 9 ] )
	{
	    static const _str [ ] = "{"#cRInfo"}* {"#cGRInfo"}Команда доступна с ранга %s (%d)." ;
	    new scm_string [ sizeof _str + 30 + 3 ] ;
	    format ( scm_string, sizeof scm_string, _str, f_rank [ fraction_id - 1 ] [ f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 9 ] - 1 ], f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 9 ] ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
		return 1 ;
	}

	if ( p_info [ playerid ] [ mute ] )
	{
		new scm_string [ 38 ] ;
		format ( scm_string, sizeof ( scm_string ), "У вас бан чата | %d секунд(ы)", p_info [ playerid ] [ mute ] ) ;
		SendClientMessage ( playerid,  col_light_red, scm_string ) ;
		return true ;
	}

	if ( globalchat_cooldown [ playerid ] > gettime ( ) )
	{
		new scm_string [ 81 + 9 ] ;
		format ( scm_string, sizeof ( scm_string ), "Вы уже писали в департамент. Повторно написать можно будет через %d секунд(ы).", globalchat_cooldown [ playerid ] - gettime ( ) ) ;
		SendClientMessage ( playerid,  col_light_red, scm_string ) ;
		return true ;
	}

	globalchat_cooldown [ playerid ] = gettime ( ) + 60 ;

	if ( check_advertise ( playerid, params, report_type_d ) ) return 1 ;

	if ( sscanf ( params, "s[128]", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /d [текст]" ) ;

	new scm_string [ 144 ] ;
	format ( scm_string, sizeof scm_string, "[D] (%s) %s %s[%d]: %s", f_info [ fraction_id - 1 ] [ f_name ], f_rank [ fraction_id - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], playerid, params [ 0 ] ) ;
	foreach(new i: logged_players) if ( 18 > p_info [ i ] [ member ] > 0 && p_info [ i ] [ settings ] [ 0 ] ) SendClientMessage ( i, 0xFF8282AA, scm_string ) ;

	format(scm_string, sizeof scm_string, "сказал(а) в рацию: {FFFFFF}%s", params [ 0 ]);
	SetPlayerChatBubble(playerid, scm_string, col_light_purple, 15.0, 10000);
	return 1 ;
}

