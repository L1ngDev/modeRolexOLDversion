stock is_ip_found ( string [ ] )
{
    new len = strlen(string), blocks, digits;
    for(new pos, bool: LastCharWasDigit; pos < len; pos++)
    {
        switch(string[pos])
        {
            case '0'..'9':
            {
                digits ++;
                if(!LastCharWasDigit) blocks ++, LastCharWasDigit = true;
            }
            default: if(LastCharWasDigit) LastCharWasDigit = false;
        }
    }
    return (digits >= 8 && blocks >= 4) ? (true) : (false);
}

stock IsMessageReklama ( string [ ] )
{
	if(strfind(string, "http",true) != -1||strfind(string, ".com",true) != -1||strfind(string, ".ru",true) != -1||strfind(string, "www.",true) != -1||strfind(string, "/q",true) != -1||strfind(string, "/quit",true) != -1||strfind(string, "mq",true) != -1
	||strfind(string, ".net",true) != -1||strfind(string, ". com",true) != -1||strfind(string, ". net",true) != -1||strfind(string, ". ru",true) != -1||strfind(string, ".ua",true) != -1||strfind(string, "маму",true) != -1||strfind(string, "мамашу",true) != -1||strfind(string, "мамки",true) != -1
	||strfind(string, ". ua",true) != -1||strfind(string, "мамку",true) != -1||strfind(string, "мамку",true) != -1||strfind(string, "рот ебал",true) != -1||strfind(string, "ебал рот",true) != -1||strfind(string, "иди нахуй",true) != -1||strfind(string, "идите нахуй",true) != -1
	||strfind(string, "мамаша",true) != -1||strfind(string, "мамашу",true) != -1||strfind(string, "sliv",true) != -1||strfind(string, "пидор",true) != -1||strfind(string, "пидоры",true) != -1||strfind(string, "иди нахуи",true) != -1||strfind(string, "идите нахуи",true) != -1
	||strfind(string, "матуха",true) != -1||strfind(string, "матуху",true) != -1||strfind(string, "хуесос",true) != -1||strfind(string, "пидорасы",true) != -1||strfind(string, "шлюх",true) != -1
	||strfind(string, "qm",true) != -1||strfind(string, "ебан",true) != -1||strfind(string, "хуил",true) != -1||(strfind(string, "хуи",true) != -1||strfind(string, "хуй",true) != -1) && strfind(string, "сос",true) != -1
	||strfind(string, "mamawa",true) != -1||strfind(string, "м а м",true) != -1||strfind(string, "m a m",true) != -1
	||strfind(string, "mamsha",true) != -1||strfind(string, "live rus",true) != -1||strfind(string, "лайв ра",true) != -1||strfind(string, "л а й в р а",true) != -1
	||strfind(string, "мама",true) != -1
	||strfind(string, "mama",true) != -1
	||strfind(string, "mamka",true) != -1
	||strfind(string, "мать ебал",true) != -1
	||strfind(string, "ебал мать",true) != -1
	||strfind(string, "address",true) != -1||strfind(string, "мамка",true) != -1||strfind(string, "мамке",true) != -1||strfind(string, "маме",true) != -1||strfind(string, "мамаше",true) != -1||strfind(string, "mamke",true) != -1||strfind(string, "mamku",true) != -1
	||strfind(string, "mamawu",true) != -1||strfind(string, "mamawe",true) != -1||strfind(string, "mamashu",true) != -1||strfind(string, "mamashe",true) != -1||strfind(string, "mat'",true) != -1||strfind(string, "matb",true) != -1||strfind(string, ". su",true) != -1
	||strfind(string, "q m",true) != -1||strfind(string, "q m",true) != -1||strfind(string, "rcon",true) != -1)
	{
		return 1 ;
	}
	return 0 ;
}

stock IsPlayerAiming(playerid)
{
	new anim = GetPlayerAnimationIndex(playerid);
	if(((anim >= 1160) && (anim <= 1163)) || (anim == 1167) || (anim == 1365) || (anim == 1643) || (anim == 1453) || (anim == 220)) return 1 ;
	return 0 ;
}

callback: death_sync ( playerid )
{
	if ( is_player_fake_spawn { playerid } == 0 ) return 1 ;
	set_health ( playerid, 10 ) ;
	return 1 ;
}

callback: OnPlayerSyncDeath ( playerid, killerid, reason )
{
	SetTimerEx ( "death_sync", 3000, false, "i", playerid ) ;
	foreach(new i: admin_players)
	{
 		SendDeathMessageToPlayer ( i, killerid, playerid, reason ) ;
	}

	if ( player_duel [ killerid ] [ duel_in_lobby ] != INVALID_PLAYER_ID )
	{
	    new target_id = player_duel [ killerid ] [ duel_in_lobby ] ;
		set_health ( killerid, player_duel [ target_id ] [ duel_hp ] ) ;
		return 1 ;
	}

	if ( TeamPaint [ playerid ] != 0 )
	{
		switch ( StartPaintBall )
		{
		    case 1:
			{
				switch ( TeamPaint [ playerid ] )
				{
					case 1: BluePlayer -- ;
					case 2: RedPlayer -- ;
				}
				TeamPaint [ playerid ] = 0 ;
				SendClientMessage ( playerid, col_yellow, !"* Вы были дисквалифицированы." ) ;
			}
			case 2:
			{
			    if ( TeamPaint [ killerid ] == 1 ) BlueScore ++ ;
				else RedScore++ ;

				PaintList [ GetPVarInt ( playerid, "OnPaint" ) ] [ DeathsPoint ] ++ ;
		        PaintList [ GetPVarInt ( killerid, "OnPaint" ) ] [ KillsPoint ] ++ ;

		        set_health ( killerid, 100 ) ;

                new text_paint [ 128 ] ;
				format(text_paint, 128, "[PaintBall]: %s[%d] убил(а) %s[%d] (RED: %d, BLUE: %d)",
				p_info [ killerid ] [ name ], killerid, p_info [ playerid ] [ name ], playerid, RedScore, BlueScore ) ;
				foreach(new i: logged_players)
				{
		      		if ( TeamPaint [ i ] > 0 )
		      		{
		      		    SendDeathMessageToPlayer ( i, killerid, playerid, reason ) ;

						SendClientMessage ( i, col_green, text_paint ) ;
					}
				}
			}
		}
 	}

	if ( player_killed [ playerid ] ) return 1 ;

	if ( bl_info [ playerid ] [ bl_onFrac ] [ p_info [ killerid ] [ member ] ] == 1 )
 	{
 	    if ( gang_player ( killerid ) || mafia_player ( killerid ) )
 	    {
 	        new fraction_id = p_info [ killerid ] [ member ], text_string [ 128 ] ;
 	        if ( bl_info [ playerid ] [ bl_kills ] [ fraction_id ] >= f_info [ fraction_id - 1 ] [ f_death_clear ] )
 	        {
		 	    format(text_string, sizeof text_string, "* Вы откупились кровью и были вычеркнуты из черного списка %s.", f_info [ fraction_id - 1 ] [ f_name ] );
				SendClientMessage ( playerid, col_lblue, text_string);
				format(text_string, sizeof text_string, "[F] %s откупился(ась) кровью и был(а) вычеркнут(а) из черного списка.", p_info [ playerid ] [ name ] );
				fraction_message ( fraction_id, col_lblue, text_string ) ;

				bl_info [ playerid ] [ bl_kills ] [ fraction_id ] =
				bl_info [ playerid ] [ bl_onFrac ] [ fraction_id ] = 0 ;

				format ( text_string, sizeof text_string, "DELETE FROM `fractions_blacklist` WHERE `bl_player` = '%d' AND `bl_fraction` = '%d' LIMIT 1", p_info [ playerid ] [ id ], fraction_id ) ;
				mysql_tquery ( sql_connection, text_string, "", "" ) ;
 	            return 1 ;
 	        }

	 	    format(text_string, sizeof text_string, "* Заплати или терпи, %s помнит о тебе. Вы можете выкупиться из чёрного списка в банке.", f_info [ fraction_id - 1 ] [ f_name ] );
			SendClientMessage ( playerid, col_lblue, text_string);
			format(text_string, sizeof text_string, "[F] %s завалил(а) %s. Крепись братва, в следующий раз терпила даст монету.", p_info [ killerid ] [ name ], p_info [ playerid ] [ name ] );
			fraction_message ( fraction_id, col_lblue, text_string ) ;

			if ( p_info [ playerid ] [ money ] > 10000 )
			{
			    give_money ( playerid, -2000 ) ;
				insert_money_log ( playerid, INVALID_PLAYER_ID, -2000, "чистка ЧС" ) ;
				format(text_string, sizeof text_string, "* При убийстве %s забрал у Вас 2.000"valute_title".", p_info [ killerid ] [ name ] );
				SendClientMessage ( playerid, col_lblue, text_string);

				give_money ( killerid, 1000 ) ;
				insert_money_log ( killerid, INVALID_PLAYER_ID, 1000, "чистка ЧС" ) ;

				set_money_fraction ( fraction_id - 1, 2, 1000, true ) ;

				bl_info [ playerid ] [ bl_kills ] [ fraction_id ] ++ ;
				Bl_Update ( playerid, fraction_id ) ;
			}
		}
 	}
 	else if ( p_info [ playerid ] [ member ] > 0 && bl_info [ killerid ] [ bl_onFrac ] [ p_info [ playerid ] [ member ] ] )
 	{
 	    if ( gang_player ( playerid ) || mafia_player ( playerid ) )
 	    {
 	        new fraction_id = p_info [ playerid ] [ member ], text_string [ 128 ] ;
	 	    format(text_string, sizeof text_string, "* Вы показали головорезам из %s кто здесь хозяин.", f_info [ fraction_id - 1 ] [ f_name ] );
			SendClientMessage ( killerid, col_lblue, text_string);
			format(text_string, sizeof text_string, "[F] %s засунул(а) ствол в задницу %s. Крепись братва, у нас тяжёлые времена.", p_info [ killerid ] [ name ], p_info [ playerid ] [ name ] );
			fraction_message ( fraction_id, col_lblue, text_string ) ;

			if ( p_info [ playerid ] [ money ] > 10000 )
			{
			    give_money ( playerid, -2000 ) ;
				insert_money_log ( playerid, INVALID_PLAYER_ID, -2000, "чистка ЧС" ) ;
				format(text_string, sizeof text_string, "* При убийстве %s забрал у Вас 2.000"valute_title".", p_info [ killerid ] [ name ] );
				SendClientMessage ( playerid, col_lblue, text_string);

				give_money ( killerid, 2000 ) ;
				insert_money_log ( killerid, INVALID_PLAYER_ID, 2000, "чистка ЧС" ) ;
			}
		}
 	}

	#if defined m_familys
	    familys_OnPlayerDeath ( playerid, killerid, reason ) ;
	#endif

	#if defined m_prison
	    prison_OnPlayerSyncDeath ( playerid, killerid ) ;
	#endif

	if ( mw_gangzone != -1 )
	{
	    if ( IsPlayerInQuad ( playerid, mw_quad [ 0 ], mw_quad [ 1 ], mw_quad [ 2 ], mw_quad [ 3 ] ) )
	    {
	        new killerfrac = p_info [ killerid ] [ member ], playerfrac = p_info [ playerid ] [ member ] ;
			if ( mafia_player ( playerid ) && mafia_player ( killerid ) && killerfrac != playerfrac )
			{
				if ( killerfrac == mw_attacker && playerfrac == mw_owner ||
				killerfrac == mw_attacker && f_diplomacy [ playerfrac - 18 ] [  mw_owner - 18 ] == dip_status_alliance ||
				f_diplomacy [ killerfrac - 18 ] [ mw_attacker - 18 ] == dip_status_alliance && playerfrac == mw_owner && f_diplomacy [ killerfrac - 18 ] [ mw_owner - 18 ] == dip_status_war ||
				f_diplomacy [ killerfrac - 18 ] [ mw_attacker - 18 ] == dip_status_alliance && f_diplomacy [ playerfrac - 18 ] [ mw_owner - 18 ] == dip_status_alliance && f_diplomacy [ killerfrac - 18 ] [ mw_owner - 18 ] == dip_status_war )
				{
					new score_kill, scm_string [ 144 ] ;
					switch ( reason )
					{
						case 0 									: score_kill += 5 ;
						case 22, 23 							: score_kill += 4 ;
						case 5, 6, 7, 10, 11, 12, 13, 14, 15	: score_kill += 10 ;
						default 								: score_kill += 1 ;
					}

					mw_attacker_points += score_kill ;

					p_info [ killerid ] [ m_capture_kills ] ++ ;
					p_info [ killerid ] [ bizwar_kills ] ++ ;
					p_info [ playerid ] [ bizwar_death ] ++ ;

					if ( zahvat_kills [ 0 ] < p_info [ killerid ] [ bizwar_kills ] )
				    {
				        zahvat_fractions [ 0 ] = p_info [ killerid ] [ member ] ;
					    zahvat_kills [ 0 ] = p_info [ killerid ] [ bizwar_kills ] ;
					    format ( zahvat_names [ 0 ], MAX_PLAYER_NAME, "%s", p_info [ killerid ] [ name ] ) ;
			   		}
				    else if ( zahvat_kills [ 1 ] < p_info [ killerid ] [ bizwar_kills ] )
				    {
				     	zahvat_fractions [ 1 ] = p_info [ killerid ] [ member ] ;
					    zahvat_kills [ 1 ] = p_info [ killerid ] [ bizwar_kills ] ;
					    format ( zahvat_names [ 1 ], MAX_PLAYER_NAME, "%s", p_info [ killerid ] [ name ] ) ;
			   		}
				    else if ( zahvat_kills [ 2 ] < p_info [ killerid ] [ bizwar_kills ] )
				    {
					    zahvat_fractions [ 2 ] = p_info [ killerid ] [ member ] ;
					    zahvat_kills [ 2 ] = p_info [ killerid ] [ bizwar_kills ] ;
					    format ( zahvat_names [ 2 ], MAX_PLAYER_NAME, "%s", p_info [ killerid ] [ name ] ) ;
				    }

					if ( killerfrac == mw_attacker && playerfrac == mw_owner )
					{
						format ( scm_string, sizeof scm_string, "[U] %s [%s] завалил(а) %s [%s] (+%d очков). Счёт: %s [%d] : [%d] %s",
						p_info [ killerid ] [ name ], f_info [ mw_attacker - 1 ] [ f_letter_name ],
						p_info [ playerid ] [ name ], f_info [ mw_owner - 1 ] [ f_letter_name ],
						score_kill, f_info [ mw_attacker - 1 ] [ f_letter_name ], mw_attacker_points,
						mw_owner_points, f_info [ mw_owner - 1 ] [ f_letter_name ] ) ;
					}

					else if ( killerfrac == mw_attacker && f_diplomacy [ playerfrac - 18 ] [  mw_owner - 18 ] == dip_status_alliance )
					{
						format ( scm_string, sizeof scm_string, "[U] %s [%s] завалил(а) %s [Альянс с %s] (+%d очков). Счёт: %s [%d] : [%d] %s",
						p_info [ killerid ] [ name ], f_info [ mw_attacker - 1 ] [ f_letter_name ],
						p_info [ playerid ] [ name ], f_info [ mw_owner - 1 ] [ f_letter_name ],
						score_kill, f_info [ mw_attacker - 1 ] [ f_letter_name ], mw_attacker_points,
						mw_owner_points, f_info [ mw_owner - 1 ] [ f_letter_name ] ) ;
					}

					else if ( f_diplomacy [ killerfrac - 18 ] [ mw_attacker - 18 ] == dip_status_alliance && playerfrac == mw_owner && f_diplomacy [ killerfrac - 18 ] [ mw_owner - 18 ] == dip_status_war )
					{
						format ( scm_string, sizeof scm_string, "[U] %s [Альянс с %s] завалил(а) %s [%s] (+%d очков). Счёт: %s [%d] : [%d] %s",
						p_info [ killerid ] [ name ], f_info [ mw_attacker - 1 ] [ f_letter_name ],
						p_info [ playerid ] [ name ], f_info [ mw_owner - 1 ] [ f_letter_name ],
						score_kill, f_info [ mw_attacker - 1 ] [ f_letter_name ], mw_attacker_points,
						mw_owner_points, f_info [ mw_owner - 1 ] [ f_letter_name ] ) ;
					}

					else if ( f_diplomacy [ killerfrac - 18 ] [ mw_attacker - 18 ] == dip_status_alliance && f_diplomacy [ playerfrac - 18 ] [ mw_owner - 18 ] == dip_status_alliance && f_diplomacy [ killerfrac - 18 ] [ mw_owner - 18 ] == dip_status_war )
					{
						format ( scm_string, sizeof scm_string, "[U] %s [Альянс с %s] завалил(а) %s [Альянс с %s] (+%d очков). Счёт: %s [%d] : [%d] %s",
						p_info [ killerid ] [ name ], f_info [ mw_attacker - 1 ] [ f_letter_name ],
						p_info [ playerid ] [ name ], f_info [ mw_owner - 1 ] [ f_letter_name ],
						score_kill, f_info [ mw_attacker - 1 ] [ f_letter_name ], mw_attacker_points,
						mw_owner_points, f_info [ mw_owner - 1 ] [ f_letter_name ] ) ;
					}

                    new _fraction_id ;
					foreach(new i: logged_players)
					{
					    if ( ! mafia_player ( i ) && ! admin_info [ i ] [ admin_settings ] [ 1 ] ) continue ;

						SendDeathMessageToPlayer ( i, killerid, playerid, reason ) ;

                        _fraction_id = p_info [ i ] [ member ] ;
						if ( admin_info [ i ] [ admin_settings ] [ 1 ] ) _fraction_id = mw_owner ;

						if ( ( f_diplomacy [ mw_owner - 18 ] [ _fraction_id - 18 ] == dip_status_alliance || is_control_chat { i } == mw_owner || _fraction_id == mw_owner ||
							f_diplomacy [ mw_attacker - 18 ] [ _fraction_id - 18 ] == dip_status_alliance || is_control_chat { i } == mw_attacker || _fraction_id == mw_attacker ) && p_info [ i ] [ settings ] [ 0 ] != 0 ) SendClientMessage ( i, f_info [ mw_attacker - 1 ] [ f_radar_color ], scm_string ) ;

						if ( player_device { i } == 2 ) showBizWar ( i ) ;
						else { }
					}

					#if defined m_fractions
					    give_emp_progress ( killerid, 0, 1 ) ;
					#endif

					checking_mafia_quest_progress ( killerid, 2, 1 ) ;
				}
				if ( killerfrac == mw_owner && playerfrac == mw_attacker ||
					killerfrac == mw_owner && f_diplomacy [ playerfrac - 18 ] [  mw_attacker - 18 ] == dip_status_alliance ||
					f_diplomacy [ killerfrac - 18 ] [ mw_owner - 18 ] == dip_status_alliance && playerfrac == mw_attacker && f_diplomacy [ killerfrac - 18 ] [ mw_attacker - 18 ] == dip_status_war ||
					f_diplomacy [ killerfrac - 18 ] [ mw_owner - 18 ] == dip_status_alliance && f_diplomacy [ playerfrac - 18 ] [ mw_attacker - 18 ] == dip_status_alliance && f_diplomacy [ killerfrac - 18 ] [ mw_attacker - 18 ] == dip_status_war )
				{
					new score_kill, scm_string [ 144 ] ;
					switch ( reason )
					{
						case 0 									: score_kill += 5 ;
						case 22, 23 							: score_kill += 4 ;
						case 5, 6, 7, 10, 11, 12, 13, 14, 15	: score_kill += 10 ;
						default 								: score_kill += 1 ;
					}

					mw_owner_points += score_kill ;

					p_info [ killerid ] [ m_capture_kills ] ++ ;
					p_info [ killerid ] [ bizwar_kills ] ++ ;
					p_info [ playerid ] [ bizwar_death ] ++ ;

					if ( zahvat_kills [ 0 ] < p_info [ killerid ] [ bizwar_kills ] )
				    {
				        zahvat_fractions [ 0 ] = p_info [ killerid ] [ member ] ;
					    zahvat_kills [ 0 ] = p_info [ killerid ] [ bizwar_kills ] ;
					    format ( zahvat_names [ 0 ], MAX_PLAYER_NAME, "%s", p_info [ killerid ] [ name ] ) ;
			   		}
				    else if ( zahvat_kills [ 1 ] < p_info [ killerid ] [ bizwar_kills ] )
				    {
				     	zahvat_fractions [ 1 ] = p_info [ killerid ] [ member ] ;
					    zahvat_kills [ 1 ] = p_info [ killerid ] [ bizwar_kills ] ;
					    format ( zahvat_names [ 1 ], MAX_PLAYER_NAME, "%s", p_info [ killerid ] [ name ] ) ;
			   		}
				    else if ( zahvat_kills [ 2 ] < p_info [ killerid ] [ bizwar_kills ] )
				    {
					    zahvat_fractions [ 2 ] = p_info [ killerid ] [ member ] ;
					    zahvat_kills [ 2 ] = p_info [ killerid ] [ bizwar_kills ] ;
					    format ( zahvat_names [ 2 ], MAX_PLAYER_NAME, "%s", p_info [ killerid ] [ name ] ) ;
				    }

					if ( killerfrac == mw_owner && playerfrac == mw_attacker )
					{
						format ( scm_string, sizeof scm_string, "[U] %s [%s] завалил(а) %s [%s] (+%d очков). Счёт: %s [%d] : [%d] %s",
						p_info [ killerid ] [ name ], f_info [ mw_owner - 1 ] [ f_letter_name ],
						p_info [ playerid ] [ name ], f_info [ mw_attacker - 1 ] [ f_letter_name ],
						score_kill, f_info [ mw_owner - 1 ] [ f_letter_name ], mw_attacker_points,
						mw_owner_points, f_info [ mw_attacker - 1 ] [ f_letter_name ] ) ;
					}

					else if ( killerfrac == mw_owner && f_diplomacy [ playerfrac - 18 ] [  mw_attacker - 18 ] == dip_status_alliance )
					{
						format ( scm_string, sizeof scm_string, "[U] %s [%s] завалил(а) %s [Альянс с %s] (+%d очков). Счёт: %s [%d] : [%d] %s",
						p_info [ killerid ] [ name ], f_info [ mw_owner - 1 ] [ f_letter_name ],
						p_info [ playerid ] [ name ], f_info [ mw_attacker - 1 ] [ f_letter_name ],
						score_kill, f_info [ mw_owner - 1 ] [ f_letter_name ], mw_attacker_points,
						mw_owner_points, f_info [ mw_attacker - 1 ] [ f_letter_name ] ) ;
					}

					else if ( f_diplomacy [ killerfrac - 18 ] [ mw_owner - 18 ] == dip_status_alliance && playerfrac == mw_attacker && f_diplomacy [ killerfrac - 18 ] [ mw_attacker - 18 ] == dip_status_war )
					{
						format ( scm_string, sizeof scm_string, "[U] %s [Альянс с %s] завалил(а) %s [%s] (+%d очков). Счёт: %s [%d] : [%d] %s",
						p_info [ killerid ] [ name ], f_info [ mw_owner - 1 ] [ f_letter_name ],
