callback: radars_loading ( )
{
	new fields, time = GetTickCount ( ) ;
	cache_get_data ( radar_count, fields ) ;
	if ( radar_count )
	{
		for ( new i = 0 ; i < radar_count ; i ++ )
		{
			radar_info [ i ] [ r_id ] = cache_get_field_content_int ( i, "r_id", sql_connection ) ;

			radar_info [ i ] [ r_type ] = cache_get_field_content_int ( i, "r_type", sql_connection ) ;
			radar_info [ i ] [ r_speed ] = cache_get_field_content_int ( i, "r_speed", sql_connection ) ;

			radar_info [ i ] [ r_x ] = cache_get_field_content_float ( i, "r_x", sql_connection ) ;
			radar_info [ i ] [ r_y ] = cache_get_field_content_float ( i, "r_y", sql_connection ) ;
			radar_info [ i ] [ r_z ] = cache_get_field_content_float ( i, "r_z", sql_connection ) ;
			radar_info [ i ] [ r_rx ] = cache_get_field_content_float ( i, "r_rx", sql_connection ) ;
			radar_info [ i ] [ r_ry ] = cache_get_field_content_float ( i, "r_ry", sql_connection ) ;
			radar_info [ i ] [ r_rz ] = cache_get_field_content_float ( i, "r_rz", sql_connection ) ;

			new radar_string [ 95 + 4 + 4 ] ;
			format(radar_string, sizeof radar_string, "Радар {"#cOR3D"}№%d{"#cWH3D"}\n\n{"#cWH3D"}Разрешенная скорость: {"#cBL3D"}%d{"#cWH3D"} км/ч", i + 1, radar_info [ i ] [ r_speed ] ) ;
			radar_info [ i ] [ r_label ] = CreateDynamic3DTextLabel ( radar_string, col_white, radar_info [ i ] [ r_x ], radar_info [ i ] [ r_y ], radar_info [ i ] [ r_z ] + 4.0, 10.0 ) ;
			radar_info [ i ] [ r_object ] = CreateDynamicObject ( 18880, radar_info [ i ] [ r_x ], radar_info [ i ] [ r_y ], radar_info [ i ] [ r_z ], radar_info [ i ] [ r_rx ], radar_info [ i ] [ r_ry ], radar_info [ i ] [ r_rz ] ) ;

			radar_info [ i ] [ r_area ] = CreateDynamicSphere ( radar_info [ i ] [ r_x ], radar_info [ i ] [ r_y ], radar_info [ i ] [ r_z ], 20.0 ) ;
			area_info [ radar_info [ i ] [ r_area ] ] [ a_type ] = area_type_radar ;
			area_info [ radar_info [ i ] [ r_area ] ] [ a_item ] = i ;

			radar_info [ i ] [ r_area_warning ] = CreateDynamicSphere ( radar_info [ i ] [ r_x ], radar_info [ i ] [ r_y ], radar_info [ i ] [ r_z ], 100.0 ) ;
			area_info [ radar_info [ i ] [ r_area_warning ] ] [ a_type ] = area_type_radar_warning ;
			area_info [ radar_info [ i ] [ r_area_warning ] ] [ a_item ] = i ;
		}
	}
	printf("[SERVER] Загружено %d радаров.(%d ms)", radar_count, GetTickCount ( ) - time ) ;
	return 1 ;
}

callback: server_raceinfo_loading ( )
{
    new rows, fields ;
	cache_get_data ( rows, fields ) ;

	new _race_name [ 24 ] ;
    new race_id = cache_get_field_content_int ( 0, "r_step", sql_connection ) ;
	cache_get_field_content ( 0, "r_name", _race_name, sql_connection, 24 ) ;

	new mysql_string [ 128 ] ;
	format ( mysql_string, sizeof mysql_string, "SELECT * FROM `src_checkpoint` WHERE `r_step` = '%d' LIMIT %d", race_id, SRC_TRECK_COUNT ) ;
	mysql_tquery ( sql_connection, mysql_string, "server_race_loading", "" ) ;

	format ( mysql_string, sizeof mysql_string, "SELECT * FROM `src_spawn_checkpoint` WHERE `r_step` = '%d' LIMIT %d", race_id, 20 ) ;
	mysql_tquery ( sql_connection, mysql_string, "server_race_spawn_loading", "" ) ;
	return 1 ;
}

