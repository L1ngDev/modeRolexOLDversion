}

CMD:gzspawn ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 7 )return 1 ;
  	if ( sscanf ( params, "d", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /gzspawn [0/1]" ) ;
    for ( new i = 0 ; i < gz_count ; i ++ )
	{
		if ( IsPlayerInGangZone ( playerid, i ) )
		{
			gz_info [ i ] [ gz_spawn ] = params [ 0 ] ;

			new scm_string [ 96 ] ;
			if ( params [ 0 ] ) format ( scm_string, sizeof ( scm_string ),"{"#cBAdmin"}[A] {"#cGRAdmin"}%s set %d gangzone type SPAWN", p_info [ playerid ] [ name ], gz_info [ i ] [ gz_id ] ) ;
			else format ( scm_string, sizeof ( scm_string ),"{"#cBAdmin"}[A] {"#cGRAdmin"}%s set %d gangzone type NON SPAWN", p_info [ playerid ] [ name ], gz_info [ i ] [ gz_id ] ) ;
			foreach(new pl_id: admin_players)
			{
				SendClientMessage ( pl_id, col_admin, scm_string ) ;
			}
			format ( scm_string, 76, "UPDATE `gangzones` SET `gz_spawn`= '%d' WHERE `gz_id` = '%d' LIMIT 1", gz_info [ i ] [ gz_spawn ], gz_info [ i ] [ gz_id ] ) ;
			mysql_tquery ( sql_connection, scm_string, "", "" ) ;
			break ;
		}
	}
	return 1 ;
}

CMD:setskin ( playerid, params [ ] )
{
	if ( p_info [ playerid ] [ member ] == 0 ) return 1 ;

	new frac_id = p_info [ playerid ] [ member ] ;
	if ( p_info [ playerid ] [ rank ] < f_info [ frac_id - 1 ] [ f_rank_settings ] [ 1 ] )
	{
