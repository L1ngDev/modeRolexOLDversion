CMD:setprocurement ( playerid, params [ ] )
{
    if ( admin_info [ playerid ] [ admin ] < 8 ) return 1 ;
    if ( ! IsFounder ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}К сожалению, Вам данная функция не доступна." ) ;
    if ( sscanf ( params, "d", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /setprocurement [id бизнеса] (только для заправок и ларьков с едой)" );
	if ( params [ 0 ] < 1 || params [ 0 ] > b_count ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Не верно указан ID бизнеса." );
    if ( b_info [ params [ 0 ] - 1 ] [ b_type ] != bizz_type_gas && b_info [ params [ 0 ] - 1 ] [ b_type ] != bizz_type_food &&
		b_info [ params [ 0 ] - 1 ] [ b_type ] != bizz_type_bank && b_info [ params [ 0 ] - 1 ] [ b_type ] != bizz_type_rentcar &&
		b_info [ params [ 0 ] - 1 ] [ b_type ] != bizz_type_bank && b_info [ params [ 0 ] - 1 ] [ b_type ] != bizz_type_trucker ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данному типу бизнеса нельзя установить доп. пикап." );

	if ( IsValidDynamicPickup ( b_info [ params [ 0 ] - 1 ] [ b_pickup_gas ] ) ) DestroyDynamicPickup ( b_info [ params [ 0 ] - 1 ] [ b_pickup_gas ] ) ;
    if ( b_info [ params [ 0 ] - 1 ] [ b_area_gas ] ) DestroyDynamicArea ( b_info [ params [ 0 ] - 1 ] [ b_area_gas ] ) ;
    if ( IsValidDynamic3DTextLabel ( b_info [ params [ 0 ] - 1 ] [ b_gas_text ] ) )
	{
		DestroyDynamic3DTextLabel ( b_info [ params [ 0 ] - 1 ] [ b_gas_text ] ) ;
		b_info [ params [ 0 ] - 1 ] [ b_gas_text ] = Text3D:INVALID_3DTEXT_ID ;
	}

    b_info [ params [ 0 ] - 1 ] [ b_area_gas ] = CreateDynamicSphere ( p_t_info [ playerid ][ p_pos ] [ 0 ], p_t_info [ playerid ][ p_pos ] [ 1 ], p_t_info [ playerid ][ p_pos ] [ 2 ], 2.0, -1, -1, -1 ) ;

	if ( b_info [ params [ 0 ] - 1 ] [ b_type ] == bizz_type_gas )
	{
		b_info [ params [ 0 ] - 1 ] [ b_pickup_gas ] = CreateDynamicPickup ( 1650, 23, p_t_info [ playerid ][ p_pos ] [ 0 ], p_t_info [ playerid ][ p_pos ] [ 1 ], p_t_info [ playerid ][ p_pos ] [ 2 ], 0, 0 ) ;
        area_info [ b_info [ params [ 0 ] - 1 ] [ b_area_gas ] ] [ a_type ] = area_type_businesses_gas ;
        area_info [ b_info [ params [ 0 ] - 1 ] [ b_area_gas ] ] [ a_item ] = b_info [ params [ 0 ] - 1 ] [ b_id ] ;
	}

    else if ( b_info [ params [ 0 ] - 1 ] [ b_type ] == bizz_type_food )
    {
		b_info [ params [ 0 ] - 1 ] [ b_pickup_gas ] = CreateDynamicPickup ( 19094, 23, p_t_info [ playerid ][ p_pos ] [ 0 ], p_t_info [ playerid ][ p_pos ] [ 1 ], p_t_info [ playerid ][ p_pos ] [ 2 ], 0, 0 ) ;
        area_info [ b_info [ params [ 0 ] - 1 ] [ b_area_gas ] ] [ a_type ] = area_type_businesses_food ;
        area_info [ b_info [ params [ 0 ] - 1 ] [ b_area_gas ] ] [ a_item ] = b_info [ params [ 0 ] - 1 ] [ b_id ] ;
	}

	else
    {
        b_info [ params [ 0 ] - 1 ] [ b_gas_text ] = CreateDynamic3DTextLabel ( "** Транспортная компания **\n\n{"#cGR3D"}Используйте {"#cWH"}/stoprent {"#cGR3D"}для сдачи т/с", col_header_3d, p_t_info [ playerid ] [ p_pos ] [ 0 ], p_t_info [ playerid ] [ p_pos ] [ 1 ], p_t_info [ playerid ] [ p_pos ] [ 2 ] + 1.0, 3.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, -1, 0, 0 );
		b_info [ params [ 0 ] - 1 ] [ b_pickup_gas ] = CreateDynamicPickup ( 1239, 23, p_t_info [ playerid ][ p_pos ] [ 0 ], p_t_info [ playerid ][ p_pos ] [ 1 ], p_t_info [ playerid ][ p_pos ] [ 2 ], 0, 0 ) ;
		pick_info [ b_info [ params [ 0 ] - 1 ] [ b_pickup_gas ] ] [ pick_type ] = pick_type_bizcar ;
        pick_info [ b_info [ params [ 0 ] - 1 ] [ b_pickup_gas ] ] [ pick_item ] = b_info [ params [ 0 ] - 1 ] [ b_id ] ;
	}

    new query_string [ 131 + ( 4 * 3 ) + 9 ] ;
	mysql_format ( sql_connection, query_string, sizeof ( query_string  ),"UPDATE `businesses` SET `b_procurement_x` = '%f', `b_procurement_y` = '%f', `b_procurement_z` = '%f' WHERE `b_id` = '%d' LIMIT 1",
	p_t_info [ playerid ][ p_pos ] [ 0 ], p_t_info [ playerid ][ p_pos ] [ 1 ], p_t_info [ playerid ][ p_pos ] [ 2 ], params [ 0 ] ) ;
	mysql_tquery ( sql_connection, query_string, "", "" ) ;
	return 1 ;
}

