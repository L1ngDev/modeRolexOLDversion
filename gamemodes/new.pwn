			format ( query_string, sizeof ( query_string ), "SELECT * FROM `users_jobinfo` WHERE `ji_uid` = '%d' AND (`ji_fraction` = '%d' OR `ji_fraction` = '%d' OR `ji_fraction` = '%d' OR `ji_fraction` = '%d' OR `ji_fraction` = '%d' OR `ji_fraction` = '%d') ORDER BY `users_jobinfo`.`ji_id` DESC LIMIT 10",
			p_info [ player_id ] [ id ], org_structure_id [ listitem ] [ 0 ], org_structure_id [ listitem ] [ 1 ], org_structure_id [ listitem ] [ 2 ], org_structure_id [ listitem ] [ 3 ], org_structure_id [ listitem ] [ 4 ], org_structure_id [ listitem ] [ 5 ] ) ;
			mysql_tquery ( sql_connection, query_string, "joblist_callback", "iii", playerid, player_id, listitem ) ;
