	if ( sscanf ( params, "dd", params [ 0 ], params [ 1 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /setvw [id] [id вирт. мира]" ) ;
	set_world ( params [ 0 ], params [ 1 ] ) ;

	new scm_string [ 128 ] ;

	format ( scm_string, sizeof ( scm_string  ),"Администратор %s[%d] переместил Вас в виртуальный мир.", p_info [ playerid ] [ name ], playerid ) ;
	SendClientMessage ( params [ 0 ], col_gray, scm_string ) ;
	format ( scm_string, sizeof ( scm_string  ),"{"#cBAdmin"}[A] {"#cGRAdmin"}%s[%d] переместил в виртуальный мир %s[%d]", p_info [ playerid ] [ name ], playerid, p_info [ params [ 0 ] ] [ name ], params [ 0 ] ) ;
	foreach(new i: admin_players)SendClientMessage ( i, col_admin, scm_string ) ;
