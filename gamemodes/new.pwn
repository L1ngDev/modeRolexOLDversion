callback: check_deposit_box ( playerid, _db_id )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows )
	{
		show_dialog ( playerid, d_deposit_transfer_id, DIALOG_STYLE_INPUT, "{"#cBHD"}Перевод", "{ffffff}Введите номер счёта:", "Принять", "Назад" ) ;
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Счёт с данным номером не найден." ) ;
		return 1 ;
	}

	new db_owner = cache_get_field_content_int ( 0, "db_owner", sql_connection ) ;

	new query_string [ 59 + 9 ] ;
	format ( query_string, sizeof ( query_string ), "SELECT `u_name` FROM `users` WHERE `u_id` = '%d' LIMIT 1", db_owner ) ;
	mysql_tquery ( sql_connection, query_string, "get_account_name_transfer", "ii", playerid, _db_id ) ;
	return 1 ;
}

callback: get_account_name_transfer ( playerid, _db_id )
{
    new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows ) return SendClientMessage ( playerid, col_gray, "{"#cRInfo"}* {"#cGRInfo"}Произошла ошибка. Попробуйте ещё раз осуществить перевод." ) ;

	new _account_name [ MAX_PLAYER_NAME ] ;
    cache_get_field_content ( 0, "u_name", _account_name, sql_connection, MAX_PLAYER_NAME ) ;

	new _t_string [ 200 ] ;
	format ( _t_string, sizeof ( _t_string ), "{"#cWH"}Счёт: {"#cWV"}№%d{"#cWH"}\nВладелец: {"#cOR"}%s{"#cWH"}\n\nВведите количество денег, которое хотите перевести:", _db_id, _account_name ) ;
	show_dialog ( playerid, d_deposit_transfer_money, DIALOG_STYLE_INPUT, "{"#cBHD"}Перевод", _t_string, "Принять", "Назад" ) ;

	SetPVarInt ( playerid, "todb_id", _db_id ) ;
	return 1 ;
}

callback: callback_deposit_transfer_set ( playerid, cardId )
{
    new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows ) return 1 ;

	new dl_id = cache_get_field_content_int ( 0, "dl_id", sql_connection ) ;
    new dl_money = cache_get_field_content_int ( 0, "dl_money", sql_connection ) ;

    new sql_string [ 128 ] ;
	format ( sql_string, sizeof sql_string, "DELETE FROM `deposit_transfer` WHERE `dl_id` = '%d' LIMIT 1", dl_id ) ;
	mysql_tquery ( sql_connection, sql_string ) ;

    bank_info [ playerid ] [ bi_money ] [ cardId ] += dl_money ;

	sql_string [ 0 ] = EOS ;
	format ( sql_string, sizeof ( sql_string ), "UPDATE `deposit_boxes` SET `db_money` = '%d' WHERE `db_id` = '%i' LIMIT 1",
	bank_info [ playerid ] [ bi_money ] [ cardId ], bank_info [ playerid ] [ bi_id ] [ cardId ] ) ;
	mysql_tquery ( sql_connection, sql_string ) ;

    insert_money_log ( playerid, INVALID_PLAYER_ID, dl_money, "получение перевода [BANK]" ) ;
    SendClientMessage ( playerid, col_succes, !"Вы успешно получили перевод." ) ;
	return 1 ;
}

callback: callback_deposit_transfer ( playerid )
{
    new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Переводов на Ваши счета не поступало." ) ;

	global_string [ 0 ] = EOS ;
	strcat ( global_string, "{"#cBHD"}Сумма:\t{"#cBHD"}Дата:\n" ) ;
	for ( new i = 0 ; i < rows ; i ++ )
	{
	    new dl_id = cache_get_field_content_int ( i, "dl_id", sql_connection ) ;
	    new dl_money = cache_get_field_content_int ( i, "dl_money", sql_connection ) ;

	    new dl_date [ 32 ] ;
	    cache_get_field_content ( i, "dl_date", dl_date, sql_connection, 32 ) ;

		set_player_listitem_values ( playerid, i, dl_id ) ;

	    format ( global_string, sizeof global_string, "%s{"#cBL"}%d. {"#cGN"}%s"valute_title"{"#cWH"}\t%s\n", global_string, i + 1, GetPlayerCashValueToSmile ( dl_money ), dl_date ) ;
	}
	show_dialog ( playerid, d_deposit_take_transfer, DIALOG_STYLE_TABLIST_HEADERS, "{"#cBHD"}Получение переводов", global_string, "Получить", "Закрыть" ) ;
	return 1 ;
}

stock create_deposit ( playerid )
{
    new _card_count = 0 ;
	for ( new i = 0 ; i < MAX_BANK_ACCOUNT ; i ++ )
	{
		if ( bank_info [ playerid ] [ bi_type ] [ i ] ) _card_count ++ ;
	}
	if ( _card_count > 9 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас уже есть 10 открытых счёта." ) ;

	global_string [ 0 ] = EOS ;
	format ( global_string, 300, "\
	{"#cBL"}Выберите тип карты\n\
	{"#cBL"}1. {"#cWH"}Зарплатная {"#cGRDialog"}({"#cGN"}%d"valute_title_"{"#cGRDialog"})\n\
	{"#cBL"}2. {"#cWH"}Накопительная {"#cGRDialog"}({"#cGN"}%d"valute_title_"{"#cGRDialog"})\n\
	{"#cBL"}3. {"#cWH"}Кредитная {"#cGRDialog"}({"#cGN"}%d"valute_title_"{"#cGRDialog"})\n\
	{"#cGRDialog"}Информация", price_pay_card, price_gold_card, price_credit_card ) ;
	show_dialog ( playerid, d_deposit_select_card, DIALOG_STYLE_LIST, "{"#cBHD"}Открытие счёта", global_string, "Принять", "Назад" ) ;
	return 1 ;
}

callback: get_banker_id ( playerid, _db_id, _todb_id, _value )
{
    new fields, rows ;
	cache_get_data ( rows, fields ) ;
	if ( rows )
	{
	    new _account_id = cache_get_field_content_int ( 0, "db_owner", sql_connection ) ;

        new query_string [ 62 + 11 ] ;
		format ( query_string, sizeof ( query_string ), "SELECT `u_last_ip` FROM `users` WHERE `u_id` = '%d' LIMIT 1", _account_id ) ;
		mysql_tquery ( sql_connection, query_string, "get_banker_ip", "iiii", playerid, _db_id, _todb_id, _value ) ;
		return 1 ;
	}

    new _deposit_num = get_player_use_listitem ( playerid ) ;
	bank_info [ playerid ] [ bi_money ] [ _deposit_num ] -= _value ;

	new dialog_string [ 178 ] ;
	format ( dialog_string, 124, "UPDATE `deposit_boxes` SET `db_money` = '%d' WHERE `db_id` = '%d' LIMIT 1", bank_info [ playerid ] [ bi_money ] [ _deposit_num ], _db_id ) ;
	mysql_tquery ( sql_connection, dialog_string ) ;

	format ( dialog_string, 144, "{"#cGInfo"}* {"#cWH"}Вы успешно перевели {"#cGN"}%s"valute_title_" {"#cWH"}на счет {"#cGN"}№%d{"#cWH"}.", GetPlayerCashValueToSmile ( _value ), _todb_id ) ;
	SendClientMessage ( playerid, col_white, dialog_string ) ;

	format ( dialog_string, sizeof dialog_string, "Перевод на счёт №%d", _todb_id ) ;
	insert_deposit_logs ( _db_id, _todb_id, _value, dialog_string, BANK_TYPE_TRANSFER_TO ) ;
	format ( dialog_string, sizeof dialog_string, "Перевод со счёта №%d", _db_id ) ;
	insert_deposit_logs ( _todb_id, _db_id, _value, dialog_string, BANK_TYPE_TRANSFER_ME ) ;

	dialog_string [ 0 ] = EOS ;
	format ( dialog_string, 144, "UPDATE `deposit_boxes` SET `db_money` = `db_money` + '%d' WHERE `db_id` = '%d' LIMIT 1", _value, _todb_id ) ;
	mysql_tquery ( sql_connection, dialog_string ) ;

	global_string [ 0 ] = EOS ;
	format ( global_string, 144, "\
		SELECT \
			u.u_name \
		FROM deposit_boxes db \
		LEFT JOIN users u ON u.u_id=db.db_owner \
		WHERE db.db_id = '%d' LIMIT 1", _todb_id ) ;
	mysql_tquery ( sql_connection, global_string, "check_owner_deposit", "iii", playerid, _todb_id, _value ) ;
	return 1 ;
}

stock insert_deposit_logs ( dl_from, dl_to, dl_money, dl_text [ ], dl_type )
{
	global_string [ 0 ] = EOS ;
	format ( global_string, 1024, "\
	INSERT INTO `deposit_logs` (`dl_from`,`dl_to`,`dl_money`,`dl_text`,`dl_type`,`dl_date`) \
	VALUES \
	('%d','%d','%d','%s','%d','%d')",
	dl_from, dl_to, dl_money, dl_text, dl_type, gettime ( ) ) ;
	mysql_tquery ( sql_connection, global_string ) ;
	return 1 ;
}

callback: get_banker_ip ( playerid, _db_id, _todb_id, _value )
{
    new fields, rows ;
	cache_get_data ( rows, fields ) ;
	if ( rows )
	{
	    new _ip_account [ 16 ] ;
	    cache_get_field_content ( 0, "u_last_ip", _ip_account, sql_connection, 16 ) ;

        if ( GetString ( _ip_account, p_t_info [ playerid ] [ p_ip ] ) )
        {
            SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете перевести своему аккаунту." ) ;
            show_deposit ( playerid ) ;
            return 1 ;
        }
	}

    new _deposit_num = get_player_use_listitem ( playerid ) ;
	bank_info [ playerid ] [ bi_money ] [ _deposit_num ] -= _value ;

	new dialog_string [ 178 ] ;
	format ( dialog_string, 124, "UPDATE `deposit_boxes` SET `db_money` = '%d' WHERE `db_id` = '%d' LIMIT 1", bank_info [ playerid ] [ bi_money ] [ _deposit_num ], _db_id ) ;
	mysql_tquery ( sql_connection, dialog_string ) ;

	format ( dialog_string, 144, "{"#cGInfo"}* {"#cWH"}Вы успешно перевели {"#cGN"}%s"valute_title_" {"#cWH"}на счет {"#cGN"}№%d{"#cWH"}.", GetPlayerCashValueToSmile ( _value ), _todb_id ) ;
	SendClientMessage ( playerid, col_white, dialog_string ) ;

	dialog_string [ 0 ] = EOS ;
	format ( dialog_string, sizeof dialog_string, "Перевод на счёт №%d", _todb_id ) ;
	insert_deposit_logs ( _db_id, _todb_id, _value, dialog_string, BANK_TYPE_TRANSFER_TO ) ;

	dialog_string [ 0 ] = EOS ;
	format ( dialog_string, sizeof dialog_string, "Перевод со счёта №%d", _db_id ) ;
	insert_deposit_logs ( _todb_id, _db_id, _value, dialog_string, BANK_TYPE_TRANSFER_ME ) ;

	dialog_string [ 0 ] = EOS ;
	format ( dialog_string, 144, "UPDATE `deposit_boxes` SET `db_money` = `db_money` + '%d' WHERE `db_id` = '%d' LIMIT 1", _value, _todb_id ) ;
	mysql_tquery ( sql_connection, dialog_string ) ;

	global_string [ 0 ] = EOS ;
	format ( global_string, 144, "\
		SELECT \
			u.u_name \
		FROM deposit_boxes db \
		LEFT JOIN users u ON u.u_id=db.db_owner \
		WHERE db.db_id = '%d' LIMIT 1", _todb_id ) ;
	mysql_tquery ( sql_connection, global_string, "check_owner_deposit", "iii", playerid, _todb_id, _value ) ;

    show_deposit ( playerid ) ;
	return 1 ;
}

stock show_deposit ( playerid )
{
    new header_string [ 78 ],
		_db_id = bank_info [ playerid ] [ bi_id ] [ get_player_use_listitem ( playerid ) ] ;

	format ( header_string, sizeof ( header_string ), "{"#cBHD"}№%d", _db_id ) ;
	show_dialog ( playerid, d_row_deposit, DIALOG_STYLE_LIST, header_string, "{"#cBL"}1.{"#cWH"} Информация о счёте\n{"#cBL"}2.{"#cWH"} Перевод средств\n{"#cBL"}3.{"#cWH"} Положить деньги\n{"#cBL"}4.{"#cWH"} Снять деньги\n{"#cBL"}5.{"#cWH"} Пополнить баланс телефона\n{"#cBL"}6.{"#cWH"} История операций\n{"#cBL"}7.{"#cWH"} Изменить PIN-код\n{"#cBL"}8.{ffffff} Оплата налогов / кредитов\n{"#cBL"}9.{ffffff} Оплата штрафов\n{"#cBL"}10.{ffffff} Баланс организаций\n{"#cBL"}11.{ffffff} Чёрный список", "Выбрать", "Назад" ) ;
	return 1 ;
}

callback: deposit_logs_callback ( playerid )
{
    new fields, rows ;
	cache_get_data ( rows, fields ) ;

	if ( ! rows )
	{
	    show_deposit ( playerid ) ;
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}История счёта пуста." ) ;
		return 1 ;
	}

	if ( rows )
	{
		global_string [ 0 ] = EOS ;

		strcat ( global_string, "{"#cBL"}Дата:\t{"#cBL"}Описание:\t{"#cBL"}Сумма:\n" ) ;
		for ( new i = 0 ; i < rows ; i ++ )
		{
			new _bh_date [ 32 ], _bh_money, line_string [ 128 ] ;

 			_bh_money = cache_get_field_content_int ( i, "dl_money", sql_connection ) ;
			cache_get_field_content ( i, "dl_date", _bh_date, sql_connection, 32 ) ;
			cache_get_field_content ( i, "dl_text", line_string, sql_connection, 128 ) ;

			format ( global_string, 128, "%s%s\t%s\t{"#cGN"}%s"valute_title_"\n{ffffff}", global_string, _bh_date, line_string, GetPlayerCashValueToSmile ( _bh_money ) ) ;
			strcat ( global_string, line_string ) ;
		}
		show_dialog ( playerid, d_deposit_story, DIALOG_STYLE_TABLIST_HEADERS, "{"#cBHD"}История счёта", global_string, "Назад", "Закрыть" ) ;
	}
	return 1 ;
}

callback: fined_player_vehicles ( playerid, _v_id, _b_marker )
{
	global_string [ 0 ] = EOS ;
	format ( global_string, 256, "SELECT uv.*, lp.* \
									FROM users_vehicles uv \
									LEFT JOIN licence_plate lp \
									ON lp.licence_plate_use_own_car_id = uv.v_id \
									WHERE `v_id` = '%d' LIMIT 1", _v_id ) ;
	mysql_tquery ( sql_connection, global_string, "load_player_vehicles", "iii", playerid, true, _b_marker ) ;

	set_player_use_listitem ( playerid, 0 ) ;
	return 1 ;
}

callback: load_player_vehicles ( playerid, bool: status, _car_marker )
{
	new fields,
		rows ;

	cache_get_data ( rows, fields ) ;
	if( rows )
	{
	    new unix_time = gettime ( ) ;
		for ( new i = 0 ; i < rows ; i++ )
		{
			new veh_id = GetVehicleID ( ) ;

			veh_info [ veh_id - 1 ] [ v_type ] = vehicle_type_player ;

			veh_info [ veh_id - 1 ] [ v_id ] = cache_get_field_content_int ( i, "v_id", sql_connection ) ;
			veh_info [ veh_id - 1 ] [ v_model ] = cache_get_field_content_int ( i, "v_model", sql_connection ) ;

			veh_info [ veh_id - 1 ] [ v_owner ] = cache_get_field_content_int ( i, "v_owner", sql_connection ) ;
			veh_info [ veh_id - 1 ] [ v_owner_id ] = playerid ;

			veh_info [ veh_id - 1 ] [ v_color ] [ 0 ] = 0 ; //cache_get_field_content_int ( i, "v_color_1", sql_connection ) ;
			veh_info [ veh_id - 1 ] [ v_color ] [ 1 ] = 0 ; //cache_get_field_content_int ( i, "v_color_2", sql_connection ) ;

			new sscanf_delimit [ 128 ] ;
			cache_get_field_content ( i, "licence_plate_country", sscanf_delimit, sql_connection, 8 ) ;
			cache_get_field_content ( i, "licence_plate_number", veh_info [ veh_id - 1 ] [ v_plate ], sql_connection, 12 ) ;
			cache_get_field_content ( i, "licence_plate_region", veh_info [ veh_id - 1 ] [ v_region ], sql_connection, 12 ) ;

			if ( GetString ( sscanf_delimit, "RU POLICE" ) ) veh_info [ veh_id - 1 ] [ v_plate_type ] = NUMBERPLATE_TYPE_RU_POLICE ;
			else if ( GetString ( sscanf_delimit, "RU" ) ) veh_info [ veh_id - 1 ] [ v_plate_type ] = NUMBERPLATE_TYPE_RUS ;
			else if ( GetString ( sscanf_delimit, "UA" ) ) veh_info [ veh_id - 1 ] [ v_plate_type ] = NUMBERPLATE_TYPE_UA ;
			else if ( GetString ( sscanf_delimit, "BY" ) ) veh_info [ veh_id - 1 ] [ v_plate_type ] = NUMBERPLATE_TYPE_BY ;
			else if ( GetString ( sscanf_delimit, "KZ" ) ) veh_info [ veh_id - 1 ] [ v_plate_type ] = NUMBERPLATE_TYPE_KZ ;
			else veh_info [ veh_id - 1 ] [ v_plate_type ] = 1 ;

			veh_info [ veh_id - 1 ] [ v_fuel ] = cache_get_field_content_float ( i,"v_fuel", sql_connection ) ;
			veh_info [ veh_id - 1 ] [ v_millage ] = cache_get_field_content_float ( i,"v_millage", sql_connection ) ;
			veh_info [ veh_id - 1 ] [ v_legal_millage ] = cache_get_field_content_float ( i,"v_legal_millage", sql_connection ) ;

			veh_info [ veh_id - 1 ] [ v_rank ] =
			veh_info [ veh_id - 1 ] [ v_sell_price ] =
			veh_info [ veh_id - 1 ] [ v_sell_slot ] =
			veh_info [ veh_id - 1 ] [ v_sell_carmarket ] = 0 ;

			veh_info [ veh_id - 1 ] [ v_pos ] [ 0 ] = cache_get_field_content_float ( i,"v_pos_x", sql_connection ) ;
			veh_info [ veh_id - 1 ] [ v_pos ] [ 1 ] = cache_get_field_content_float ( i,"v_pos_y", sql_connection ) ;
			veh_info [ veh_id - 1 ] [ v_pos ] [ 2 ] = cache_get_field_content_float ( i,"v_pos_z", sql_connection ) ;
			veh_info [ veh_id - 1 ] [ v_pos ] [ 3 ] = cache_get_field_content_float ( i,"v_pos_a", sql_connection ) ;

			veh_info [ veh_id - 1 ] [ v_vw ] = cache_get_field_content_int ( i, "v_vw", sql_connection ) ;
			veh_info [ veh_id - 1 ] [ v_int ] = cache_get_field_content_int ( i, "v_int", sql_connection ) ;

			veh_info [ veh_id - 1 ] [ v_fine ] = cache_get_field_content_int ( i, "v_fine", sql_connection ) ;

			veh_info [ veh_id - 1 ] [ v_date_used ] = cache_get_field_content_int ( i, "v_date_used", sql_connection ) ;
			if ( veh_info [ veh_id - 1 ] [ v_date_used ] > 0 )
			{
				if ( veh_info [ veh_id - 1 ] [ v_date_used ] - unix_time < 0 )
				{
				    new query_string [ 59 + 9 ] ;
	                format ( query_string, sizeof ( query_string ), "DELETE FROM `users_vehicles` WHERE `v_id` = '%d' LIMIT 1", veh_info [ veh_id - 1 ] [ v_id ] ) ;
					mysql_tquery( sql_connection, query_string ) ;

					new scm_string [ 90 + 32 ] ;
					format ( scm_string, sizeof scm_string, "Действие т/с %s подошло к концу.", GetVehicleNameEx ( veh_id ) ) ;
					insert_debtor_message ( "Транспорт", scm_string, p_info [ playerid ] [ id ] ) ;

					SendClientMessage ( playerid, col_gray, scm_string ) ;

					format ( scm_string, sizeof scm_string, "Действие т/с %s подошло к концу.", GetVehicleNameEx ( veh_id ) ) ;
					WriteLogs ( playerid, p_info [ playerid ] [ member ], TYPE_LOG_DEBTORS, scm_string ) ;

					veh_info [ veh_id - 1 ] [ v_date_used ] = 0 ;

					if ( p_info [ playerid ] [ max_veh_timeing ] > 0 )
					{
					    p_info [ playerid ] [ max_veh ] -= 1 ;
						p_info [ playerid ] [ max_veh_timeing ] -= 1 ;

						new sql_string [ 126 + 9 ] ;
						format ( sql_string, sizeof sql_string, "UPDATE `users` SET `u_maxveh` = `u_maxveh` - '1', `u_maxveh_timeing` = `u_maxveh_timeing` - '1' WHERE `u_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
						mysql_tquery ( sql_connection, sql_string ) ;
					}
					return 1 ;
				}
			}

			veh_info [ veh_id - 1 ] [ v_trunk_open ] = false ;
			veh_info [ veh_id - 1 ] [ v_trunk_load ] = false ;
            veh_plate ( veh_id ) ;

			if ( veh_info [ veh_id - 1 ] [ v_fine ] > 0 )
			{
			    if ( _car_marker < 0 ) _car_marker = 0 ;
				new _random = random ( sizeof fine_pos ) ;

				for ( new j = 0 ; j < 4 ; j ++ )
				{
				    #if defined SAMP
						veh_info [ veh_id - 1 ] [ v_pos ] [ j ] = fine_pos [ _random ] [ j ] ;
				    #else
						veh_info [ veh_id - 1 ] [ v_pos ] [ j ] = fine_pos [ _car_marker ] [ _random ] [ j ] ;
					#endif
				}

				veh_info [ veh_id - 1 ] [ v_vw ] =
				veh_info [ veh_id - 1 ] [ v_int ] = 0 ;

				new scm_string [ 286 ] ;
				format ( scm_string, sizeof scm_string, "UPDATE `users_vehicles` SET `v_fine`='0',`v_pos_x` = '%.2f', `v_pos_y` = '%.2f', `v_pos_z` = '%.2f',`v_pos_a` = '%.2f',`v_vw` = '%d',`v_int` = '%d' WHERE `v_id` = '%d' LIMIT 1",
				veh_info [ veh_id - 1 ] [ v_pos ] [ 0 ], veh_info [ veh_id - 1 ] [ v_pos ] [ 1 ], veh_info [ veh_id - 1 ] [ v_pos ] [ 2 ], veh_info [ veh_id - 1 ] [ v_pos ] [ 3 ],
				veh_info [ veh_id - 1 ] [ v_vw ], veh_info [ veh_id - 1 ] [ v_int ],
				veh_info [ veh_id - 1 ] [ v_id ] ) ;
				mysql_tquery ( sql_connection, scm_string ) ;
			}

			veh_info [ veh_id - 1 ] [ v_gps_tracker ] = cache_get_field_content_int ( i, "v_gps_tracker", sql_connection ) ;

   			if ( status )
			{
				veh_info [ veh_id - 1 ] [ v_fine_time ] = 120 ;

			    format ( sscanf_delimit, 110, "{"#cGInfo"}* %s{"#cWH"} отмечена на карте красной меткой.", GetVehicleNameEx ( veh_id ) ) ;
				SendClientMessage ( playerid, col_white, sscanf_delimit ) ;
				is_gps_used { playerid } = 1 ;

				SetPlayerRaceCheckpoint ( playerid, 1, veh_info [ veh_id - 1 ] [ v_pos ] [ 0 ], veh_info [ veh_id - 1 ] [ v_pos ] [ 1 ], veh_info [ veh_id - 1 ] [ v_pos ] [ 2 ], 0.0, 0.0, 0.0, 2.0 ) ;
			}
   			else
			{
				if ( get_player_use_listitem ( playerid ) == 1 )
				{
					veh_info [ veh_id - 1 ] [ v_pos ] [ 0 ] = p_t_info [ playerid ] [ p_pos ] [ 0 ] + 2.0 ;
					veh_info [ veh_id - 1 ] [ v_pos ] [ 1 ] = p_t_info [ playerid ] [ p_pos ] [ 1 ] + 2.0 ;
					veh_info [ veh_id - 1 ] [ v_pos ] [ 2 ] = p_t_info [ playerid ] [ p_pos ] [ 2 ] ;
					veh_info [ veh_id - 1 ] [ v_pos ] [ 3 ] = p_t_info [ playerid ] [ p_pos ] [ 3 ] ;
				}

			    format ( sscanf_delimit, 110, "{"#cGInfo"}* {"#cWH"}Вы успешно загрузили {"#cGN"}%s{"#cWH"} в игру.", GetVehicleNameEx ( veh_id ) ) ;
				SendClientMessage ( playerid, col_white, sscanf_delimit ) ;
			}

			veh_info [ veh_id - 1 ] [ v_vehicle ] = CreateVehicle ( veh_info [ veh_id - 1 ] [ v_model ], veh_info [ veh_id - 1 ] [ v_pos ] [ 0 ], veh_info [ veh_id - 1 ] [ v_pos ] [ 1 ], veh_info [ veh_id - 1 ] [ v_pos ] [ 2 ], veh_info [ veh_id - 1 ] [ v_pos ] [ 3 ], veh_info [ veh_id - 1 ] [ v_color ] [ 0 ], veh_info [ veh_id - 1 ] [ v_color ] [ 1 ], SPAWN_TIME_PLAYER_VEHICLE ) ;
			SetVehicleNumberPlate ( veh_info [ veh_id - 1 ] [ v_vehicle ], veh_info [ veh_id - 1 ] [ v_plate ] ) ;

			veh_info [ veh_id - 1 ] [ v_price ] = cache_get_field_content_int ( i, "v_price", sql_connection ) ;

			if ( veh_info [ veh_id - 1 ] [ v_int ] != 0 )LinkVehicleToInterior ( veh_info [ veh_id - 1 ] [ v_vehicle ], veh_info [ veh_id - 1 ] [ v_int ] ) ;
			if ( veh_info [ veh_id - 1 ] [ v_vw ] != 0 )SetVehicleVirtualWorld ( veh_info [ veh_id - 1 ] [ v_vehicle ], veh_info [ veh_id - 1 ] [ v_vw ] ) ;

			Iter_Add(player_vehicles[playerid], veh_info [ veh_id - 1 ] [ v_vehicle ] ) ;
			veh_info [ veh_id - 1 ] [ v_spawn_time ] = gettime ( ) + 180 ;

			new engine, lights, alarm, doors, bonnet, boot, objective ;
			veh_info [ veh_id - 1 ] [ v_locked ] = true ;
			GetVehicleParamsEx ( veh_id, engine, lights, alarm, doors, bonnet, boot, objective ) ;
			SetVehicleParamsEx ( veh_id, engine, lights, alarm, true, bonnet, boot, objective ) ;

			format ( sscanf_delimit, sizeof sscanf_delimit, "SELECT * FROM `users_vehicles_handling` WHERE `v_handling_own_car_sql_id` = '%d' LIMIT 1", veh_info [ veh_id - 1 ] [ v_id ] ) ;
			mysql_tquery ( sql_connection, sscanf_delimit, "SetHandlingToOwnableCar", "is", veh_id, "users_vehicles_handling" ) ;

			format ( sscanf_delimit, sizeof sscanf_delimit, "SELECT * FROM `users_vehicles_tuning` WHERE `v_tuning_sql_id` = '%d' LIMIT 1", veh_info [ veh_id - 1 ] [ v_id ] ) ;
			mysql_tquery ( sql_connection, sscanf_delimit, "SetTuningToOwnableCar", "is", veh_id, "users_vehicles_tuning" ) ;

			format ( sscanf_delimit, sizeof sscanf_delimit, "SELECT * FROM `users_vehicles_component` WHERE `v_component_sql_id` = '%d' LIMIT 1", veh_info [ veh_id - 1 ] [ v_id ] ) ;
			mysql_tquery ( sql_connection, sscanf_delimit, "SetComponentToOwnableCar", "is", veh_id, "users_vehicles_component" ) ;
		}
	}
	return 1 ;
}

callback: SetComponentToOwnableCar ( vehicleid, table_name [ ] )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( rows )
	{
		veh_info [ vehicleid - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_BUMPER_FRONT ] = cache_get_field_content_int ( 0, "comp_bump_front" ) ;
		veh_info [ vehicleid - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_BUMPER_REAR ] = cache_get_field_content_int ( 0, "comp_bump_rear" ) ;
		veh_info [ vehicleid - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_FENDER_FRONT ] = cache_get_field_content_int ( 0, "comp_fender_front" ) ;
		veh_info [ vehicleid - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_FENDER_REAR ] = cache_get_field_content_int ( 0, "comp_fender_rear" ) ;
		veh_info [ vehicleid - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_SPOILER ] = cache_get_field_content_int ( 0, "comp_spoiler" ) ;
		veh_info [ vehicleid - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_EXHAUST ] = cache_get_field_content_int ( 0, "comp_exhaust" ) ;
		veh_info [ vehicleid - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_ROOF ] = cache_get_field_content_int ( 0, "comp_roof" ) ;
		veh_info [ vehicleid - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_TAILLIGHTS ] = cache_get_field_content_int ( 0, "comp_taillights" ) ;
		veh_info [ vehicleid - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_HEADLIGHTS ] = cache_get_field_content_int ( 0, "comp_headlights" ) ;
		veh_info [ vehicleid - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_DIFFUSER ] = cache_get_field_content_int ( 0, "comp_diffuser" ) ;
		veh_info [ vehicleid - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_SPLITTER ] = cache_get_field_content_int ( 0, "comp_splitter" ) ;

	    if ( ! v_bike ( vehicleid ) )
		{
			foreach(new playerid: streamed_in_vehicles[vehicleid])
			{
				setCarComponent ( vehicleid, playerid ) ;
			}
		}
	}
	else
	{
		global_string [ 0 ] = EOS ;
        format ( global_string, 128, "INSERT INTO %s (v_component_sql_id) VALUES ('%d')", table_name, veh_info [ vehicleid - 1 ] [ v_id ] ) ;
        mysql_tquery ( sql_connection, global_string ) ;

		global_string [ 0 ] = EOS ;
        format ( global_string, 128, "SELECT * FROM %s WHERE v_component_sql_id = %d LIMIT 1", table_name, veh_info [ vehicleid - 1 ] [ v_id ] ) ;
        mysql_tquery ( sql_connection, global_string, "SetComponentToOwnableCar", "is", vehicleid, table_name ) ;
	}
	return true ;
}

stock SaveComponentToOwnableCar ( vehicleid, table_name [ ] )
{
	global_string [ 0 ] = EOS ;
	format ( global_string, sizeof global_string, "\
		UPDATE %s SET \
		comp_bump_front = %d, comp_bump_rear = %d, \
		comp_fender_front = %d, comp_fender_rear = %d, \
		comp_spoiler = %d, comp_exhaust = %d, \
		comp_roof = %d, comp_taillights = %d, \
		comp_headlights = %d, comp_diffuser = %d, \
		comp_splitter = %d \
		WHERE v_component_sql_id = %d LIMIT 1",
	table_name,
	veh_info [ vehicleid - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_BUMPER_FRONT ], veh_info [ vehicleid - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_BUMPER_REAR ],
	veh_info [ vehicleid - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_FENDER_FRONT ], veh_info [ vehicleid - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_FENDER_REAR ],
	veh_info [ vehicleid - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_SPOILER ], veh_info [ vehicleid - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_EXHAUST ],
	veh_info [ vehicleid - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_ROOF ], veh_info [ vehicleid - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_TAILLIGHTS ],
	veh_info [ vehicleid - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_HEADLIGHTS ], veh_info [ vehicleid - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_DIFFUSER ],
	veh_info [ vehicleid - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_SPLITTER ],
	veh_info [ vehicleid - 1 ] [ v_id ] ) ;
	mysql_tquery ( sql_connection, global_string ) ;
	return true ;
}

stock ChangeTableToComponent ( vehicleid, sql_id, table_name [ ] )
{
	global_string [ 0 ] = EOS ;
    format ( global_string, sizeof global_string, "INSERT INTO %s \
		(`v_component_sql_id`,`comp_bump_front`,`comp_bump_rear`,`comp_fender_front`,`comp_fender_rear`,`comp_spoiler`,`comp_exhaust`,`comp_roof`,`comp_taillights`,`comp_headlights`,`comp_diffuser`,`comp_splitter`) \
		VALUES \
		('%d','%d','%d','%d','%d','%d','%d','%d','%d','%d','%d','%d')",
	table_name, sql_id,
	veh_info [ vehicleid - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_BUMPER_FRONT ], veh_info [ vehicleid - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_BUMPER_REAR ],
	veh_info [ vehicleid - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_FENDER_FRONT ], veh_info [ vehicleid - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_FENDER_REAR ],
	veh_info [ vehicleid - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_SPOILER ], veh_info [ vehicleid - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_EXHAUST ],
	veh_info [ vehicleid - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_ROOF ], veh_info [ vehicleid - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_TAILLIGHTS ],
	veh_info [ vehicleid - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_HEADLIGHTS ], veh_info [ vehicleid - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_DIFFUSER ],
	veh_info [ vehicleid - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_SPLITTER ] ) ;
    mysql_tquery ( sql_connection, global_string ) ;
	return true ;
}

callback: SetTuningToOwnableCar ( vehicleid, table_name [ ] )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
    if ( rows )
    {
        veh_info [ vehicleid - 1 ] [ v_neon_type ] = cache_get_field_content_int ( 0, "v_neon_type" ) ;

        new neon_color [ 15 ] ;
        cache_get_field_content ( 0, "v_neon_color", neon_color, 15 ) ;
        sscanf ( neon_color, "p<|>ddd",
		veh_info [ vehicleid - 1 ] [ v_neon ] [ 0 ], veh_info [ vehicleid - 1 ] [ v_neon ] [ 1 ], veh_info [ vehicleid - 1 ] [ v_neon ] [ 2 ] ) ;

        new light_color [ 15 ] ;
        cache_get_field_content ( 0, "v_light_color", light_color, 15 ) ;
        sscanf ( light_color, "p<|>ddd",
		veh_info [ vehicleid - 1 ] [ v_lights_color ] [ 0 ], veh_info [ vehicleid - 1 ] [ v_lights_color ] [ 1 ], veh_info [ vehicleid - 1 ] [ v_lights_color ] [ 2 ] ) ;

        new tinting_color [ 25 ] ;
        cache_get_field_content ( 0, "v_tinting_color", tinting_color, 25 ) ;
        sscanf ( tinting_color, "p<|>dddd",
		veh_info [ vehicleid - 1 ] [ v_toner ] [ 0 ], veh_info [ vehicleid - 1 ] [ v_toner ] [ 1 ], veh_info [ vehicleid - 1 ] [ v_toner ] [ 2 ], veh_info [ vehicleid - 1 ] [ v_toner ] [ 3 ] ) ;

        new body_painting_color [ 15 ] ;
        cache_get_field_content ( 0, "v_body_painting_color", body_painting_color, 15 ) ;
        sscanf ( body_painting_color, "p<|>ddd",
		veh_info [ vehicleid - 1 ] [ v_main_color ] [ 0 ], veh_info [ vehicleid - 1 ] [ v_main_color ] [ 1 ], veh_info [ vehicleid - 1 ] [ v_main_color ] [ 2 ] ) ;

        new own_car_disk_color [ 15 ] ;
        cache_get_field_content ( 0, "v_disk_color", own_car_disk_color, 15 ) ;
        sscanf ( own_car_disk_color, "p<|>ddd",
		veh_info [ vehicleid - 1 ] [ v_disk_color ] [ 0 ], veh_info [ vehicleid - 1 ] [ v_disk_color ] [ 1 ], veh_info [ vehicleid - 1 ] [ v_disk_color ] [ 2 ] ) ;

        veh_info [ vehicleid - 1 ] [ v_vinyl ] = cache_get_field_content_int ( 0, "v_vinyl" ) ;
        veh_info [ vehicleid - 1 ] [ v_pantera_strobs ] = cache_get_field_content_int ( 0, "v_strob_light" ) ;
        veh_info [ vehicleid - 1 ] [ v_nitro ] = cache_get_field_content_int ( 0, "v_nitro" ) ;
		veh_info [ vehicleid - 1 ] [ v_disk_id ] = cache_get_field_content_int ( 0, "v_disk_id" ) ;

		foreach(new playerid: streamed_in_vehicles[vehicleid])
		{
		    sc_Handling_OnVehicleStreamIn ( vehicleid, playerid ) ;
		    sc_OnVehicleStreamIn ( vehicleid, playerid ) ;
		}
		sc_AddHandling ( vehicleid ) ;
		sc_CreateVehicle ( vehicleid ) ;
		OnVehicleIteration ( vehicleid ) ;

		if ( veh_info [ vehicleid - 1 ] [ v_disk_id ] )
			AddVehicleComponent ( veh_info [ vehicleid - 1 ] [ v_vehicle ], veh_info [ vehicleid - 1 ] [ v_disk_id ] ) ;

		if ( veh_info [ vehicleid - 1 ] [ v_nitro ] )
			AddVehicleComponent ( veh_info [ vehicleid - 1 ] [ v_vehicle ], veh_info [ vehicleid - 1 ] [ v_nitro ] ) ;
    }
    else
    {
		global_string [ 0 ] = EOS ;
        format ( global_string, 128, "INSERT INTO %s (v_tuning_sql_id) VALUES ('%d')", table_name, veh_info [ vehicleid - 1 ] [ v_id ] ) ;
        mysql_tquery ( sql_connection, global_string ) ;

		global_string [ 0 ] = EOS ;
        format ( global_string, 128, "SELECT * FROM %s WHERE v_tuning_sql_id = %d LIMIT 1", table_name, veh_info [ vehicleid - 1 ] [ v_id ] ) ;
        mysql_tquery ( sql_connection, global_string, "SetTuningToOwnableCar", "is", vehicleid, table_name ) ;
    }
    return true ;
}

stock SaveTuningToOwnableCar ( vehicleid, table_name [ ] )
{
	global_string [ 0 ] = EOS ;
	format ( global_string, sizeof global_string, "\
		UPDATE %s SET \
		v_neon_type = %d, \
		v_neon_color = '%d|%d|%d', \
		v_light_color = '%d|%d|%d', \
		v_tinting_color = '%d|%d|%d|%d', \
		v_body_painting_color = '%d|%d|%d', \
		v_disk_color = '%d|%d|%d', \
		v_vinyl = %d, \
		v_strob_light = %d, \
		v_nitro = %d, \
		v_disk_id = %d \
		WHERE v_tuning_sql_id = %d LIMIT 1",
		table_name,
		veh_info [ vehicleid - 1 ] [ v_neon_type ],
		veh_info [ vehicleid - 1 ] [ v_neon ] [ 0 ], veh_info [ vehicleid - 1 ] [ v_neon ] [ 1 ], veh_info [ vehicleid - 1 ] [ v_neon ] [ 2 ],
		veh_info [ vehicleid - 1 ] [ v_lights_color ] [ 0 ], veh_info [ vehicleid - 1 ] [ v_lights_color ] [ 1 ], veh_info [ vehicleid - 1 ] [ v_lights_color ] [ 2 ],
		veh_info [ vehicleid - 1 ] [ v_toner ] [ 0 ], veh_info [ vehicleid - 1 ] [ v_toner ] [ 1 ], veh_info [ vehicleid - 1 ] [ v_toner ] [ 2 ], veh_info [ vehicleid - 1 ] [ v_toner ] [ 3 ],
		veh_info [ vehicleid - 1 ] [ v_main_color ] [ 0 ], veh_info [ vehicleid - 1 ] [ v_main_color ] [ 1 ], veh_info [ vehicleid - 1 ] [ v_main_color ] [ 2 ],
		veh_info [ vehicleid - 1 ] [ v_disk_color ] [ 0 ], veh_info [ vehicleid - 1 ] [ v_disk_color ] [ 1 ], veh_info [ vehicleid - 1 ] [ v_disk_color ] [ 2 ],
		veh_info [ vehicleid - 1 ] [ v_vinyl ], veh_info [ vehicleid - 1 ] [ v_pantera_strobs ], veh_info [ vehicleid - 1 ] [ v_nitro ],
		veh_info [ vehicleid - 1 ] [ v_disk_id ],
		veh_info [ vehicleid - 1 ] [ v_id ] ) ;
	mysql_tquery ( sql_connection, global_string ) ;
	return true ;
}
stock ChangeTableToTuning ( vehicleid, sql_id, table_name [ ] )
{
	global_string [ 0 ] = EOS ;
	format ( global_string, sizeof global_string, "INSERT INTO %s \
		(`v_tuning_sql_id`,`v_neon_type`,`v_neon_color`,`v_light_color`,`v_tinting_color`,`v_body_painting_color`,`v_disk_color`,`v_vinyl`,`v_strob_light`,`v_nitro`,`v_disk_id`) \
		VALUES \
		('%d','%d','%d|%d|%d','%d|%d|%d','%d|%d|%d|%d','%d|%d|%d','%d|%d|%d','%d','%d','%d','%d')",
		table_name, sql_id,
		veh_info [ vehicleid - 1 ] [ v_neon_type ],
		veh_info [ vehicleid - 1 ] [ v_neon ] [ 0 ], veh_info [ vehicleid - 1 ] [ v_neon ] [ 1 ], veh_info [ vehicleid - 1 ] [ v_neon ] [ 2 ],
		veh_info [ vehicleid - 1 ] [ v_lights_color ] [ 0 ], veh_info [ vehicleid - 1 ] [ v_lights_color ] [ 1 ], veh_info [ vehicleid - 1 ] [ v_lights_color ] [ 2 ],
		veh_info [ vehicleid - 1 ] [ v_toner ] [ 0 ], veh_info [ vehicleid - 1 ] [ v_toner ] [ 1 ], veh_info [ vehicleid - 1 ] [ v_toner ] [ 2 ], veh_info [ vehicleid - 1 ] [ v_toner ] [ 3 ],
		veh_info [ vehicleid - 1 ] [ v_main_color ] [ 0 ], veh_info [ vehicleid - 1 ] [ v_main_color ] [ 1 ], veh_info [ vehicleid - 1 ] [ v_main_color ] [ 2 ],
		veh_info [ vehicleid - 1 ] [ v_disk_color ] [ 0 ], veh_info [ vehicleid - 1 ] [ v_disk_color ] [ 1 ], veh_info [ vehicleid - 1 ] [ v_disk_color ] [ 2 ],
		veh_info [ vehicleid - 1 ] [ v_vinyl ], veh_info [ vehicleid - 1 ] [ v_pantera_strobs ], veh_info [ vehicleid - 1 ] [ v_nitro ],
		veh_info [ vehicleid - 1 ] [ v_disk_id ] ) ;
	mysql_tquery ( sql_connection, global_string ) ;
	return true ;
}
callback: SetHandlingToOwnableCar ( veh_id, table_name [ ] )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows )
	{
		new modelid = getVehicleOrdinalNumber ( veh_id ) ;
		global_string [ 0 ] = EOS ;
        format
        (
            global_string, sizeof global_string,
            "INSERT INTO %s \
            (v_handling_own_car_sql_id, v_max_speed, v_acceleration, v_gear, v_engine_inertion, v_mass, \
            v_mass_turn, v_brake_deceleration, v_traction_multiplier, v_traction_loss, v_traction_bias, \
            v_sus_bias) \
            VALUES \
            ('%d', '%d', '%d', '%d', '%d', '%d', '%d', '%d', '%d', '%d', '%d', '%d')",
            table_name, veh_info [ veh_id - 1 ] [ v_id ],
            veh_handling [ modelid ] [ VEHICLE_HP_MAX_SPEED ],
            veh_handling [ modelid ] [ VEHICLE_HP_ACCELERATION ],
            veh_handling [ modelid ] [ VEHICLE_HP_GEAR ],
            veh_handling [ modelid ] [ VEHICLE_HP_ENGINE_INERTION ],
            veh_handling [ modelid ] [ VEHICLE_HP_MASS ],
            veh_handling [ modelid ] [ VEHICLE_HP_MASS_TURN ],
            veh_handling [ modelid ] [ VEHICLE_HP_BRAKE_DECELERATION ],
            veh_handling [ modelid ] [ VEHICLE_HP_TRACTION_MULTIPLIER ],
            veh_handling [ modelid ] [ VEHICLE_HP_TRACTION_LOSS ],
            veh_handling [ modelid ] [ VEHICLE_HP_TRACTION_BIAS ],
            veh_handling [ modelid ] [ VEHICLE_HP_SUS_BIAS ]
        ) ;
        mysql_tquery ( sql_connection, global_string, "OnVehicleHandlingInserted", "is", veh_id, table_name ) ;
	}
	else
	{
        veh_info [ veh_id - 1 ] [ V_HP_MAX_SPEED ] = cache_get_field_content_int ( 0, "v_max_speed" ) ;
		veh_info [ veh_id - 1 ] [ V_HP_ACCELERATION ] = cache_get_field_content_int ( 0, "v_acceleration" ) ;
		veh_info [ veh_id - 1 ] [ V_HP_GEAR ] = cache_get_field_content_int ( 0, "v_gear" ) ;
		veh_info [ veh_id - 1 ] [ V_HP_ENGINE_INERTION ] = cache_get_field_content_int ( 0, "v_engine_inertion" ) ;
		veh_info [ veh_id - 1 ] [ V_HP_MASS ] = cache_get_field_content_int ( 0, "v_mass" ) ;
		veh_info [ veh_id - 1 ] [ V_HP_MASS_TURN ] = cache_get_field_content_int ( 0, "v_mass_turn" ) ;
		veh_info [ veh_id - 1 ] [ V_HP_BRAKE_DECELERATION ] = cache_get_field_content_int ( 0, "v_brake_deceleration" ) ;
		veh_info [ veh_id - 1 ] [ V_HP_TRACTION_MULTIPLIER ] = cache_get_field_content_int ( 0, "v_traction_multiplier" ) ;
		veh_info [ veh_id - 1 ] [ V_HP_TRACTION_LOSS ] = cache_get_field_content_int ( 0, "v_traction_loss" ) ;
		veh_info [ veh_id - 1 ] [ V_HP_TRACTION_BIAS ] = cache_get_field_content_int ( 0, "v_traction_bias" ) ;
		veh_info [ veh_id - 1 ] [ V_HP_SUS_LOWER_LIMIT ] = cache_get_field_content_int ( 0, "v_sus_lower_limit" ) ;
		veh_info [ veh_id - 1 ] [ V_HP_SUS_BIAS ] = cache_get_field_content_int ( 0, "v_sus_bias" ) ;
		veh_info [ veh_id - 1 ] [ V_HP_WHEEL_SIZE ] = cache_get_field_content_int ( 0, "v_wheel_size" ) ;
		veh_info [ veh_id - 1 ] [ V_HP_WHEEL_WIDTH ] = cache_get_field_content_int ( 0, "v_wheel_width" ) ;
		veh_info [ veh_id - 1 ] [ V_HP_WHEEL_ALIGN_FRONT ] = cache_get_field_content_int ( 0, "v_wheel_align_front" ) ;
		veh_info [ veh_id - 1 ] [ V_HP_WHEEL_ALIGN_BACK ] = cache_get_field_content_int ( 0, "v_wheel_align_back" ) ;
		veh_info [ veh_id - 1 ] [ V_HP_SPACERS ] = cache_get_field_content_int ( 0, "v_spacers" ) ;

		foreach(new playerid: streamed_in_vehicles[veh_id])
		{
		    sc_Handling_OnVehicleStreamIn ( veh_id, playerid ) ;
		    sc_OnVehicleStreamIn ( veh_id, playerid ) ;
		}
		sc_AddHandling ( veh_id ) ;
		sc_CreateVehicle ( veh_id ) ;
		OnVehicleIteration ( veh_id ) ;
	}
	return 1 ;
}

callback: OnVehicleHandlingInserted ( vehicleid, table_name [ ] )
{
	global_string [ 0 ] = EOS ;
    format ( global_string, 128, "SELECT * FROM %s WHERE v_handling_own_car_sql_id = %d LIMIT 1", table_name, veh_info [ vehicleid - 1 ] [ v_id ] ) ;
    mysql_tquery ( sql_connection, global_string, "SetHandlingToOwnableCar", "is", vehicleid, table_name ) ;
    return true ;
}

stock SaveVehicleHandling ( vehicleid, table_name [ ] )
{
	
global_string [ 0 ] = EOS ;
	
format ( global_string, 1024, "INSERT INTO %s (v_handling_own_car_sql_id, v_sus_lower_limit, v_wheel_size, v_wheel_width, v_wheel_align_front, v_wheel_align_back, v_spacers) VALUES (%d, %d, %d, %d, %d, %d, %d) ON DUPLICATE KEY UPDATE v_sus_lower_limit = VALUES(v_sus_lower_limit), v_wheel_size = VALUES(v_wheel_size), v_wheel_width = VALUES(v_wheel_width), v_wheel_align_front = VALUES(v_wheel_align_front), v_wheel_align_back = VALUES(v_wheel_align_back), v_spacers = VALUES(v_spacers)",
	table_name,
	
	
veh_info [ vehicleid - 1 ] [ v_id ],
	
	
veh_info [ vehicleid - 1 ] [ V_HP_SUS_LOWER_LIMIT ],
	
	
veh_info [ vehicleid - 1 ] [ V_HP_WHEEL_SIZE ],
	
	
veh_info [ vehicleid - 1 ] [ V_HP_WHEEL_WIDTH ],
	
	
veh_info [ vehicleid - 1 ] [ V_HP_WHEEL_ALIGN_FRONT ],
	
	
veh_info [ vehicleid - 1 ] [ V_HP_WHEEL_ALIGN_BACK ],
	
	
veh_info [ vehicleid - 1 ] [ V_HP_SPACERS ] ) ;
	
mysql_tquery ( sql_connection, global_string ) ;
	
return true ;
}
stock ChangeTableToHandling ( vehicleid, sql_id, table_name [ ] )
{
	global_string [ 0 ] = EOS ;
    format
    (
        global_string, sizeof global_string,
			"INSERT INTO %s \
			(v_handling_own_car_sql_id, v_max_speed, v_acceleration, v_gear, v_engine_inertion, v_mass, \
			v_mass_turn, v_brake_deceleration, v_traction_multiplier, v_traction_loss, v_traction_bias, \
			v_sus_lower_limit, v_sus_bias, v_wheel_size, v_hp_max, v_wheel_width, v_wheel_align_front, \
			v_wheel_align_back, v_spacers) \
			VALUES \
			('%d', '%d', '%d', '%d', '%d', '%d', '%d', '%d', '%d', '%d', '%d', '%d', '%d', '%d', '%d', '%d', '%d', '%d', '%d')",
    	table_name, sql_id,
        veh_info [ vehicleid - 1 ] [ V_HP_MAX_SPEED ],
		veh_info [ vehicleid - 1 ] [ V_HP_ACCELERATION ],
		veh_info [ vehicleid - 1 ] [ V_HP_GEAR ],
		veh_info [ vehicleid - 1 ] [ V_HP_ENGINE_INERTION ],
		veh_info [ vehicleid - 1 ] [ V_HP_MASS ],
		veh_info [ vehicleid - 1 ] [ V_HP_MASS_TURN ],
		veh_info [ vehicleid - 1 ] [ V_HP_BRAKE_DECELERATION ],
		veh_info [ vehicleid - 1 ] [ V_HP_TRACTION_MULTIPLIER ],
		veh_info [ vehicleid - 1 ] [ V_HP_TRACTION_LOSS ],
		veh_info [ vehicleid - 1 ] [ V_HP_TRACTION_BIAS ],
		veh_info [ vehicleid - 1 ] [ V_HP_SUS_LOWER_LIMIT ],
		veh_info [ vehicleid - 1 ] [ V_HP_SUS_BIAS ],
		veh_info [ vehicleid - 1 ] [ V_HP_WHEEL_SIZE ],
		veh_info [ vehicleid - 1 ] [ V_HP_MAX ],
		veh_info [ vehicleid - 1 ] [ V_HP_WHEEL_WIDTH ],
		veh_info [ vehicleid - 1 ] [ V_HP_WHEEL_ALIGN_FRONT ],
		veh_info [ vehicleid - 1 ] [ V_HP_WHEEL_ALIGN_BACK ],
		veh_info [ vehicleid - 1 ] [ V_HP_SPACERS ]
    ) ;
	mysql_tquery ( sql_connection, global_string ) ;
	return true ;
}

CMD:vehdata ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 8 ) return 1 ;
	if ( GetPlayerVehicleID ( playerid ) == 0 ) return SendClientMessage ( playerid, col_gray, "{"#cRInfo"}* {"#cGRInfo"}Вы должны быть за рулём транспортного средства!" ) ;

	new modelid = getVehicleOrdinalNumber ( GetPlayerVehicleID ( playerid ) ) ;
	if ( ! veh_data [ modelid ] [ VEHICLE_FUEL_TYPE_ID ] ) return SendClientMessage ( playerid, col_gray, "{"#cRInfo"}* {"#cGRInfo"}Not database created vehicle info!" ) ;

	if ( sscanf ( params, "dd", params [ 0 ], params [ 1 ] ) )
	{
		global_string [ 0 ] = EOS ;
		format ( global_string, sizeof global_string, "\
			{"#cBHD"}:\t{"#cBHD"}:\n\
			{"#cBL"}1. {"#cWH"}VEHICLE NAME:\t%s\n\
			{"#cBL"}2. {"#cWH"}VEHICLE PRICE:\t%s\n\
			{"#cBL"}3. {"#cWH"}VEHICLE CLASS ID:\t%d\n\
			{"#cBL"}4. {"#cWH"}VEHICLE FUEL TYPE ID:\t%d\n\n\
			{"#cBL"}[CLASS - 1] {"#cWH"}LOW\n\
			{"#cBL"}[CLASS - 2] {"#cWH"}MIDDLE\n\
			{"#cBL"}[CLASS - 3] {"#cWH"}HIGH\n\
			{"#cBL"}[CLASS - 4] {"#cWH"}DONATE\n\
			{"#cBL"}[CLASS - 5] {"#cWH"}TRUCK\n\
			{"#cBL"}[CLASS - 6] {"#cWH"}BOAT\n\
			{"#cBL"}[CLASS - 7] {"#cWH"}FLY\n\
			{"#cBL"}[CLASS - 8] {"#cWH"}MOTO\n\
			{"#cBL"}[CLASS - 9] {"#cWH"}OTHER\n\n\
			{"#cBL"}[FUEL TYPE - 1] {"#cWH"}92\n\
			{"#cBL"}[FUEL TYPE - 2] {"#cWH"}95\n\
			{"#cBL"}[FUEL TYPE - 3] {"#cWH"}98\n\
			{"#cBL"}[FUEL TYPE - 4] {"#cWH"}DT\n\
			{"#cBL"}[FUEL TYPE - 5] {"#cWH"}ELECTRO\n\
			{"#cBL"}[FUEL TYPE - 6] {"#cWH"}NONE",
		veh_data [ modelid ] [ VEHICLE_NAME ],
		GetPlayerCashValueToSmile ( veh_data [ modelid ] [ VEHICLE_PRICE ] ),
		veh_data [ modelid ] [ VEHICLE_CLASS_ID ],
		veh_data [ modelid ] [ VEHICLE_FUEL_TYPE_ID ] ) ;
		show_dialog ( playerid, d_none, DIALOG_STYLE_TABLIST_HEADERS, "{"#cBHD"}Vehicle List", global_string, "Закрыть", "" ) ;

		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /vehdata [id] [value]" ) ;
	}
	else
	{
		switch ( params [ 0 ] )
		{
			case 2:
			{
				veh_data [ modelid ] [ VEHICLE_PRICE ] = params [ 1 ] ;

				global_string [ 0 ] = EOS ;
				format ( global_string, 144, "UPDATE `vehicle_list` SET `vehicle_price` = '%d' WHERE `id` = '%d' LIMIT 1",
				params [ 1 ], modelid ) ;
				mysql_tquery ( sql_connection, global_string ) ;

				global_string [ 0 ] = EOS ;
				format ( global_string, 128, "[VEHICLE_PRICE] Новое значение: %s", GetPlayerCashValueToSmile ( params [ 1 ] ) ) ;
				SendClientMessage ( playerid, col_white, global_string ) ;
			}
			case 3:
			{
				veh_data [ modelid ] [ VEHICLE_CLASS_ID ] = params [ 1 ] ;

				global_string [ 0 ] = EOS ;
				format ( global_string, 144, "UPDATE `vehicle_list` SET `vehicle_class_id` = '%d' WHERE `id` = '%d' LIMIT 1",
				params [ 1 ], modelid ) ;
				mysql_tquery ( sql_connection, global_string ) ;

				static const _classId [ ] [ 12 ] =
				{
					"LOW",
					"MIDDLE",
					"HIGH",
					"DONATE",
					"TRUCK",
					"BOAT",
					"FLY",
					"MOTO",
					"OTHER"
				} ;

				global_string [ 0 ] = EOS ;
				format ( global_string, 128, "[VEHICLE_CLASS_ID] Новое значение: %s (%d)", _classId [ params [ 1 ] - 1 ], params [ 1 ] ) ;
				SendClientMessage ( playerid, col_white, global_string ) ;
			}
			case 4:
			{
				veh_data [ modelid ] [ VEHICLE_FUEL_TYPE_ID ] = params [ 1 ] ;

				global_string [ 0 ] = EOS ;
				format ( global_string, 144, "UPDATE `vehicle_list` SET `vehicle_fuel_type_id` = '%d' WHERE `id` = '%d' LIMIT 1",
				params [ 1 ], modelid ) ;
				mysql_tquery ( sql_connection, global_string ) ;

				static const _classId [ ] [ 12 ] =
				{
					"92",
					"95",
					"98",
					"DT",
					"ELECTRO",
					"NONE"
				} ;

				global_string [ 0 ] = EOS ;
				format ( global_string, 128, "[VEHICLE_FUEL_TYPE_ID] Новое значение: %s (%d)", _classId [ params [ 1 ] - 1 ], params [ 1 ] ) ;
				SendClientMessage ( playerid, col_white, global_string ) ;
			}
		}
	}
	return 1 ;
}

CMD:handling ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 8 ) return 1 ;
	if ( GetPlayerVehicleID ( playerid ) == 0 ) return SendClientMessage ( playerid, col_gray, "{"#cRInfo"}* {"#cGRInfo"}Вы должны быть за рулём транспортного средства!" ) ;

	new modelid = getVehicleOrdinalNumber ( GetPlayerVehicleID ( playerid ) ) ;
	if ( veh_handling [ modelid ] [ VEHICLE_HP_MAX_SPEED ] < 1 ) return SendClientMessage ( playerid, col_gray, "{"#cRInfo"}* {"#cGRInfo"}Not database created handling!" ) ;

	if ( sscanf ( params, "dd", params [ 0 ], params [ 1 ] ) )
	{
		global_string [ 0 ] = EOS ;
		format ( global_string, sizeof global_string, "\
			{"#cBHD"}:\t{"#cBHD"}:\n\
			{"#cBL"}1. {"#cWH"}VEHICLE_HP_MAX_SPEED\t%d\n\
			{"#cBL"}2. {"#cWH"}VEHICLE_HP_ACCELERATION\t%d\n\
			{"#cBL"}3. {"#cWH"}VEHICLE_HP_GEAR\t%d\n\
			{"#cBL"}4. {"#cWH"}VEHICLE_HP_ENGINE_INERTION\t%d\n\
			{"#cBL"}5. {"#cWH"}VEHICLE_HP_MASS\t%d\n\
			{"#cBL"}6. {"#cWH"}VEHICLE_HP_MASS_TURN\t%d\n\
			{"#cBL"}7. {"#cWH"}VEHICLE_HP_BRAKE_DECELERATION\t%d\n\
			{"#cBL"}8. {"#cWH"}VEHICLE_HP_TRACTION_MULTIPLIER\t%d\n\
			{"#cBL"}9. {"#cWH"}VEHICLE_HP_TRACTION_LOSS\t%d\n\
			{"#cBL"}10. {"#cWH"}VEHICLE_HP_TRACTION_BIAS\t%d\n\
			{"#cBL"}11. {"#cWH"}VEHICLE_HP_SUS_LOWER_LIMIT\t%d\n\
			{"#cBL"}12. {"#cWH"}VEHICLE_HP_SUS_BIAS\t%d\n\
			{"#cBL"}13. {"#cWH"}VEHICLE_HP_WHEEL_SIZE\t%d\n\
			{"#cBL"}14. {"#cWH"}VEHICLE_HP_MAX\t%d\n\
			{"#cBL"}15. {"#cWH"}VEHICLE_HP_COUNT\t%d\n\
			{"#cBL"}16. {"#cWH"}VEHICLE_HP_WHEEL_WIDTH\t%d\n\
			{"#cBL"}17. {"#cWH"}VEHICLE_HP_WHEEL_ALIGN_FRONT\t%d\n\
			{"#cBL"}18. {"#cWH"}VEHICLE_HP_WHEEL_ALIGN_BACK\t%d\n\
			{"#cBL"}19. {"#cWH"}VEHICLE_HP_SPACERS\t%d",
		veh_handling [ modelid ] [ VEHICLE_HP_MAX_SPEED ],
		veh_handling [ modelid ] [ VEHICLE_HP_ACCELERATION ],
		veh_handling [ modelid ] [ VEHICLE_HP_GEAR ],
		veh_handling [ modelid ] [ VEHICLE_HP_ENGINE_INERTION ],
		veh_handling [ modelid ] [ VEHICLE_HP_MASS ],
		veh_handling [ modelid ] [ VEHICLE_HP_MASS_TURN ],
		veh_handling [ modelid ] [ VEHICLE_HP_BRAKE_DECELERATION ],
		veh_handling [ modelid ] [ VEHICLE_HP_TRACTION_MULTIPLIER ],
		veh_handling [ modelid ] [ VEHICLE_HP_TRACTION_LOSS ],
		veh_handling [ modelid ] [ VEHICLE_HP_TRACTION_BIAS ],
		veh_handling [ modelid ] [ VEHICLE_HP_SUS_LOWER_LIMIT ],
		veh_handling [ modelid ] [ VEHICLE_HP_SUS_BIAS ],
		veh_handling [ modelid ] [ VEHICLE_HP_WHEEL_SIZE ],
		veh_handling [ modelid ] [ VEHICLE_HP_MAX ],
		veh_handling [ modelid ] [ VEHICLE_HP_COUNT ],
		veh_handling [ modelid ] [ VEHICLE_HP_WHEEL_WIDTH ],
		veh_handling [ modelid ] [ VEHICLE_HP_WHEEL_ALIGN_FRONT ],
		veh_handling [ modelid ] [ VEHICLE_HP_WHEEL_ALIGN_BACK ],
		veh_handling [ modelid ] [ VEHICLE_HP_SPACERS ] ) ;
		show_dialog ( playerid, d_none, DIALOG_STYLE_TABLIST_HEADERS, "{"#cBHD"}Handling", global_string, "Закрыть", "" ) ;

		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /handling [id] [value * 100]" ) ;
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Мы храним целые числа, которые при передаче буду разделены на 100" ) ;
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Поэтому при установлении параметра его нужно умножить на 100 и записать получившееся число" ) ;
	}
	else
	{
		switch ( params [ 0 ] - 1 )
		{
			case VEHICLE_HP_MAX_SPEED:
			{
				veh_handling [ modelid ] [ VEHICLE_HP_MAX_SPEED ] = params [ 1 ] ;

				global_string [ 0 ] = EOS ;
				format ( global_string, 144, "UPDATE `vehicle_handling` SET `vehicle_max_speed` = '%d' WHERE `vehicle_handling_model_id` = '%d' LIMIT 1",
				params [ 1 ], modelid ) ;
