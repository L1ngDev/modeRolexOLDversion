					foreach(new j: admin_players) SendClientMessage ( j, col_admin, fm_string ) ;

					remove_admin ( i ) ;

					static const _str [ ] = "DELETE FROM `users_admins` WHERE `u_a_id` = '%d' LIMIT 1" ;
					new sql_string [ sizeof _str + 9 ] ;
