						}
					}
					if ( leaders_count )show_dialog ( playerid, d_direction_info, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Адвокаты онлайн", global_string, "Назад", "Закрыть" ) ;
					else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}В сети нет ни одного адвоката." ), show_direction ( playerid ) ;
				}
				case 6:
				{
					global_string [ 0 ] = EOS ;
					new leaders_count, job_id, line_string [ 128 ], afk_text [ 36 ], text [ 20 ] ;
					foreach(new i: logged_players)
					{
						if ( p_info [ i ] [ job ] != job_delivery ) continue ;

						if ( pl_afk_time [ i ] > 2 ) format ( afk_text, 36, " {FFB859}[AFK: %s]{"#cWH"}", convert_time ( pl_afk_time [ i ], TYPE_TIME_SECOND ) ) ;
						else format ( afk_text, 36, "" ) ;

						if ( p_info [ i ] [ number ] == 0 ) format(text, sizeof(text), "None");
						else format(text, sizeof(text), "%i", p_info [ i ] [ number ] ) ;

						if ( job_id != job_delivery )
						{
							strcat ( global_string, "{"#cLY"}Развозчики продуктов:\n" ) ;
						}
						format ( line_string, sizeof line_string, "{"#cWH"}%s%s - т. %s\n", p_info [ i ] [ name ], afk_text, text ) ;
						strcat ( global_string, line_string ) ;

						job_id = job_delivery ;
						leaders_count ++ ;
					}

					foreach(new i: logged_players)
					{
						if ( p_info [ i ] [ job ] != job_fuel_delivery ) continue ;

						if ( pl_afk_time [ i ] > 2 ) format ( afk_text, 36, " {FFB859}[AFK: %s]{"#cWH"}", convert_time ( pl_afk_time [ i ], TYPE_TIME_SECOND ) ) ;
						else format ( afk_text, 36, "" ) ;

						if ( p_info [ i ] [ number ] == 0 ) format(text, sizeof(text), "None");
						else format(text, sizeof(text), "%i", p_info [ i ] [ number ] ) ;

						if ( job_id != job_fuel_delivery )
						{
							strcat ( global_string, "\n{"#cLY"}Развозчики топлива:\n" ) ;
						}
						format ( line_string, sizeof line_string, "{"#cWH"}%s%s - т. %s\n", p_info [ i ] [ name ], afk_text, text ) ;
						strcat ( global_string, line_string ) ;

						job_id = job_fuel_delivery ;
						leaders_count ++ ;
					}
					if ( leaders_count )show_dialog ( playerid, d_direction_info, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Развозчики онлайн", global_string, "Назад", "Закрыть" ) ;
					else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}В сети нет ни одного развозчика." ), show_direction ( playerid ) ;
				}
				case 7:
				{
					global_string [ 0 ] = EOS ;
					new leaders_count, fraction_id = -1, line_string [ 128 ], afk_text [ 36 ], text [ 20 ] ;
					for ( new f = 14 ; f < 17 ; f ++ )
					{
						foreach(new i: fraction_players[f + 1])
						{
							if ( admin_info [ i ] [ admin ] ) continue ;
							if ( ! p_info [ i ] [ member ] || ! p_info [ i ] [ rank ] ) continue ;

							if ( pl_afk_time [ i ] > 2 ) format ( afk_text, 36, " {FFB859}[AFK: %s]{"#cWH"}", convert_time ( pl_afk_time [ i ], TYPE_TIME_SECOND ) ) ;
							else format ( afk_text, 36, "" ) ;

							if ( p_info [ i ] [ number ] == 0 ) format(text, sizeof(text), "None");
							else format(text, sizeof(text), "%i", p_info [ i ] [ number ] ) ;

							new _fraction_id = p_info [ i ] [ member ] ;
							if ( fraction_id != f && ! leaders_count )
							{
								format ( line_string, sizeof line_string, "{"#cLY"}%s:\n", f_info [ _fraction_id - 1 ] [ f_name ] ) ;
								strcat ( global_string, line_string ) ;
							}
							if ( fraction_id != f && leaders_count )
							{
								format ( line_string, sizeof line_string, "\n{"#cLY"}%s:\n", f_info [ _fraction_id - 1 ] [ f_name ] ) ;
								strcat ( global_string, line_string ) ;
							}
							format ( line_string, sizeof line_string, "{"#cWH"}%s%s - т. %s {"#cGRDialog"}(%s)\n", p_info [ i ] [ name ], afk_text, text, f_rank [ _fraction_id - 1 ] [ p_info [ i ] [ rank ] - 1 ] ) ;
							strcat ( global_string, line_string ) ;

							fraction_id = f ;
							leaders_count ++ ;
						}
					}

					if ( leaders_count )show_dialog ( playerid, d_direction_info, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Сотрудники больницы онлайн", global_string, "Назад", "Закрыть" ) ;
					else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}В сети нет ни одного сотрудника больницы." ), show_direction ( playerid ) ;
				}
			}
			return 1 ;
		}
		case d_direction_info:
		{
			if ( response ) return show_direction ( playerid ) ;
			return 1 ;
		}
		case d_hospital:
		{
		    if ( ! response ) return 1 ;

		    new i = area_info [ used_area [ playerid ] ] [ a_item ] ;

			entered_hospital_bed ( playerid, i ) ;
		    return 1 ;
		}
		case d_gym:
		{
		    if ( ! response ) return 1 ;
		    new _area_type = area_info [ used_area [ playerid ] ] [ a_type ] ;
		    if ( _area_type == area_type_gym_bike )
			{
				for ( new i = 0 ; i < max_gym_bike ; i ++ )
				{
			    	if ( IsPlayerInRangeOfPoint ( playerid, 1.5, gym_bike_position [ i ] [ 0 ], gym_bike_position [ i ] [ 1 ], gym_bike_position [ i ] [ 2 ] ) )
					{
					    if ( is_gym_training { playerid } == 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Сперва начните тренировку." ) ;
						if ( ! p_t_info [ playerid ] [ gym_shell ] )
						{
						    if ( SimulatorUse [ GetPVarInt ( playerid, "p_biz_id" ) ] [ i ] == true ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Тренажёр занят." ) ;
							SetPlayerPos ( playerid, gym_bike_position [ i ] [ 0 ], gym_bike_position [ i ] [ 1 ], gym_bike_position [ i ] [ 2 ] ) ;
							SetPlayerFacingAngle ( playerid, gym_bike_position [ i ] [ 3 ] ) ;
							ApplyAnimation(playerid, "GYMNASIUM", "gym_bike_geton", 4, 0, 0, 0, 1, 0);
							p_t_info [ playerid ] [ gym_shell ] = 1 ;
							p_t_info [ playerid ] [ gym_time ] = gettime ( ) + 4 ;
							SimulatorUse [ GetPVarInt ( playerid, "p_biz_id" ) ] [ i ] = true ;
							SetPVarInt ( playerid, "Simulator_ID", i ) ;
						}
						else gym_stop_used ( playerid, false ) ;
						return 1 ;
					}
				}
			}
			else if ( _area_type == area_type_gym_thread )
			{
				for ( new i = 0 ; i < max_gym_thread ; i ++ )
				{
			    	if ( IsPlayerInRangeOfPoint ( playerid, 1.5, gym_thread_position [ i ] [ 0 ], gym_thread_position [ i ] [ 1 ], gym_thread_position [ i ] [ 2 ] ) )
					{
					    if ( is_gym_training { playerid } == 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Сперва начните тренировку." ) ;
						if ( ! p_t_info [ playerid ] [ gym_shell ] )
						{
						    if ( SimulatorUse [ GetPVarInt ( playerid, "p_biz_id" ) ] [ i + max_gym_bike ] == true ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Тренажёр занят." ) ;
							SetPlayerPos ( playerid, gym_thread_position [ i ] [ 0 ], gym_thread_position [ i ] [ 1 ], gym_thread_position [ i ] [ 2 ] ) ;
							SetPlayerFacingAngle ( playerid, gym_thread_position [ i ] [ 3 ] ) ;
							ApplyAnimation(playerid, "GYMNASIUM", "gym_tread_geton", 4, 0, 0, 0, 1, 0, 1);
							p_t_info [ playerid ] [ gym_shell ] = 2 ;
							p_t_info [ playerid ] [ gym_time ] = gettime ( ) + 4 ;
							SimulatorUse [ GetPVarInt ( playerid, "p_biz_id" ) ] [ i + max_gym_bike ] = true ;
							SetPVarInt ( playerid, "Simulator_ID", i + max_gym_bike ) ;
						}
						else gym_stop_used ( playerid, false ) ;
						return 1 ;
					}
				}
			}
			else if ( _area_type == area_type_gym_bar )
			{
				for ( new i = 0 ; i < max_gym_bar ; i ++ )
				{
			    	if ( IsPlayerInRangeOfPoint ( playerid, 1.5, gym_bar_position [ i ] [ 0 ], gym_bar_position [ i ] [ 1 ], gym_bar_position [ i ] [ 2 ] ) )
					{
					    if ( is_gym_training { playerid } == 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Сперва начните тренировку." ) ;
						if ( ! p_t_info [ playerid ] [ gym_shell ] )
						{
						    if ( SimulatorUse [ GetPVarInt ( playerid, "p_biz_id" ) ] [ i + max_gym_bike + max_gym_thread ] == true ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Тренажёр занят." ) ;
							SetPlayerPos ( playerid, gym_bar_position [ i ] [ 0 ], gym_bar_position [ i ] [ 1 ], gym_bar_position [ i ] [ 2 ] ) ;
							SetPlayerFacingAngle ( playerid, gym_bar_position [ i ] [ 3 ] ) ;
							ApplyAnimation(playerid, "benchpress", "gym_bp_geton", 4, 0, 0, 0, 1, 0);
							p_t_info [ playerid ] [ gym_shell ] = 3 ;
							p_t_info [ playerid ] [ gym_time ] = gettime ( ) + 4 ;
							SimulatorUse [ GetPVarInt ( playerid, "p_biz_id" ) ] [ i + max_gym_bike + max_gym_thread ] = true ;
							SetPVarInt ( playerid, "Simulator_ID", i + max_gym_bike + max_gym_thread ) ;
							if ( ! IsPlayerAttachedObjectSlotUsed ( playerid, 3 ) ) SetPlayerAttachedObject(playerid, 3, 2913, 6, 0.033000, 0.028000, -0.104999, 5.699995, -1.999999, 0.500062, 1.000000, 1.000000, 1.000000);
						}
						else gym_stop_used ( playerid, false ) ;
						return 1 ;
					}
				}
			}
			else if ( _area_type == area_type_gym_dumbbells )
			{
		        for ( new i = 0 ; i < max_gym_dumbbells ; i ++ )
				{
			    	if ( IsPlayerInRangeOfPoint ( playerid, 1.5, gym_dumbbells_position [ i ] [ 0 ], gym_dumbbells_position [ i ] [ 1 ], gym_dumbbells_position [ i ] [ 2 ] ) )
					{
					    if ( is_gym_training { playerid } == 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Сперва начните тренировку." ) ;
						if ( ! p_t_info [ playerid ] [ gym_shell ] )
						{
						    if ( SimulatorUse [ GetPVarInt ( playerid, "p_biz_id" ) ] [ i + max_gym_bike + max_gym_thread + max_gym_bar ] == true ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Тренажёр занят." ) ;
							SetPlayerPos ( playerid, gym_dumbbells_position [ i ] [ 0 ], gym_dumbbells_position [ i ] [ 1 ], gym_dumbbells_position [ i ] [ 2 ] ) ;
							SetPlayerFacingAngle ( playerid, gym_dumbbells_position [ i ] [ 3 ] ) ;
							ApplyAnimation(playerid, "Freeweights", "gym_free_pickup", 4, 0, 0, 0, 1, 0);
							p_t_info [ playerid ] [ gym_shell ] = 4 ;
							p_t_info [ playerid ] [ gym_time ] = gettime ( ) + 4 ;
							SimulatorUse [ GetPVarInt ( playerid, "p_biz_id" ) ] [ i + max_gym_bike + max_gym_thread + max_gym_bar ] = true ;
							SetPVarInt ( playerid, "Simulator_ID", i + max_gym_bike + max_gym_thread + max_gym_bar ) ;
							if ( ! IsPlayerAttachedObjectSlotUsed ( playerid, 3 ) ) SetPlayerAttachedObject(playerid, 3, 2915, 6, 0.083999, 0.000000, -0.039999, -7.199998, -87.000038, -3.199999, 1.000000, 1.000000, 1.000000);
						}
						else gym_stop_used ( playerid, false ) ;
						return 1 ;
					}
				}
			}
		    return 1 ;
		}
		case d_gym_training:
		{
			if ( ! response ) return 1 ;
			switch ( listitem )
			{
			    case 0:
			    {
			        new b = GetPVarInt ( playerid, "p_biz_id" ) - 1,
						_price = b_price_market [ b ] [ listitem ] ;

					if ( b_info [ b ] [ b_product ] <= b_gym_product [ listitem ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}В данный момент спортивный зал не работает." ) ;
					if ( p_info [ playerid ] [ money ] < _price ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас недостаточно средст для проведения тренировки." ) ;

					give_bmoney ( b + 1, _price, b_gym_product [ listitem ] ) ;

					give_money ( playerid, -_price ) ;
					insert_money_log ( playerid, INVALID_PLAYER_ID, -_price, "Треня" ) ;

                    #if defined SAMP
					set_money_fraction ( gz_info [ 32 ] [ gz_owner ] - 1, 0, _price, true ) ;
                    #endif

					SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы начали тренировку." ) ;
					SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Используйте для тренажёров {"#cBL"}\"Y\"{"#cWH"}." ) ;
					is_gym_training { playerid } = 1 ;
					#if defined Matreshka
					SetPlayerSkin ( playerid, 85 ) ;
					#else
					SetPlayerSkin ( playerid, 81 ) ;
					#endif

					give_event_progress ( playerid, THE_GYM, 1 ) ;
			    }
			    case 1:
				{
				  	new b = GetPVarInt ( playerid, "p_biz_id" ) - 1,
						_price = b_price_market [ b ] [ listitem ] ;

					if ( b_info [ b ] [ b_product ] <= b_gym_product [ listitem ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}В данный момент спортивный зал не работает." ) ;
					if ( p_info [ playerid ] [ money ] < _price ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас недостаточно средст для проведения тренировки." ) ;

					give_bmoney ( b + 1, _price, b_gym_product [ listitem ] ) ;

					give_money ( playerid, -_price ) ;
					insert_money_log ( playerid, INVALID_PLAYER_ID, -_price, "Треня" ) ;

                    #if defined SAMP
					set_money_fraction ( gz_info [ 32 ] [ gz_owner ] - 1, 0, _price, true ) ;
					#endif

					is_gym_training { playerid } = 2 ;
					#if defined Matreshka
					SetPlayerSkin ( playerid, 42 ) ;
					#else
					SetPlayerSkin ( playerid, 80 ) ;
					#endif

					give_event_progress ( playerid, THE_GYM, 1 ) ;
					SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы начали тренировку. {"#cBL"}\"ЛКМ + F\"{"#cWH"} для отработки ударов на грушах." ) ;
				}
				case 2:
				{
				    new b = GetPVarInt ( playerid, "p_biz_id" ) - 1,
						_price = b_price_market [ b ] [ listitem ] ;

					if ( b_info [ b ] [ b_product ] <= b_gym_product [ listitem ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}В данный момент спортивный зал не работает." ) ;
					if ( p_info [ playerid ] [ money ] < _price ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас недостаточно средст для проведения тренировки." ) ;

					give_bmoney ( b + 1, _price, b_gym_product [ listitem ] ) ;

					give_money ( playerid, -_price ) ;
					insert_money_log ( playerid, INVALID_PLAYER_ID, -_price, "Треня" ) ;

					#if defined SAMP
					set_money_fraction ( gz_info [ 32 ] [ gz_owner ] - 1, 0, _price, true ) ;
					#endif

					is_gym_training { playerid } = 3 ;
					#if defined Matreshka
					SetPlayerSkin ( playerid, 42 ) ;
					#else
					SetPlayerSkin ( playerid, 80 ) ;
					#endif

					give_event_progress ( playerid, THE_GYM, 1 ) ;
					SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы начали тренировку. {"#cBL"}\"ЛКМ + F\"{"#cWH"} для отработки ударов на грушах." ) ;
				}
				case 3:
				{
				    SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы успешно завершили тренировку." ) ;
					is_gym_training { playerid } = 0 ;

					fraction_duty ( playerid ) ;
				}
			}
			return 1 ;
		}
		case d_election:
		{
			if ( ! response ) return 1 ;
			switch ( listitem )
			{
				case 0:
				{
					if ( election_status != election_status_none )
					{
						DestroyDynamicPickup ( election_pickup ) ;
						DestroyDynamic3DTextLabel ( election_text ) ;
					}
					election_pickup = -1 ;
					election_text = Text3D:-1 ;
					election_status = election_status_none ;
					new _t_string [ 108 ] ;
					format ( _t_string, 108, "{"#cBAdmin"}[A] {"#cGRAdmin"}%s установил изменил(а) статус выборов | Выборы закрыты.", p_info [ playerid ] [ name ] ) ;
					foreach(new i: admin_players)SendClientMessage ( i, col_admin, _t_string ) ;
					mysql_tquery ( sql_connection, !"UPDATE `server_variables` SET `var_count` = '0' WHERE `var_id` = '8' LIMIT 1" ) ;
				}
				case 1:
				{
					if ( election_status == election_status_none )
					{
						election_pickup = CreateDynamicPickup ( 19134, 23, -1399.8522, -1126.0061, 1520.3199 ) ;
						pick_info [ election_pickup ] [ pick_type ] = pick_type_server ;

						election_text = CreateDynamic3DTextLabel ( "** Выборы **", col_header_3d, -1399.8522, -1126.0061, 1520.3199, 20.0, -1, -1);
					}
					new _t_string [ 108 ] ;
					format ( _t_string, 108, "{"#cBAdmin"}[A] {"#cGRAdmin"}%s установил изменил(а) статус выборов | Регистрация кандидатов.", p_info [ playerid ] [ name ] ) ;
					foreach(new i: admin_players)SendClientMessage ( i, col_admin, _t_string ) ;
					election_status = election_status_register ;
					mysql_tquery ( sql_connection, !"UPDATE `server_variables` SET `var_count` = '1' WHERE `var_id` = '8' LIMIT 1" ) ;
				}
				case 2:
				{
					if ( election_status == election_status_none )
					{
						election_pickup = CreateDynamicPickup ( 19134, 23, -1399.8522, -1126.0061, 1520.3199 ) ;
						pick_info [ election_pickup ] [ pick_type ] = pick_type_server ;

						election_text = CreateDynamic3DTextLabel ( "** Выборы **", col_header_3d, -1399.8522, -1126.0061, 1520.3199, 20.0, -1, -1);
					}
					new _t_string [ 108 ] ;
					format ( _t_string, 108, "{"#cBAdmin"}[A] {"#cGRAdmin"}%s установил изменил(а) статус выборов | Голосование.", p_info [ playerid ] [ name ] ) ;
					foreach(new i: admin_players)SendClientMessage ( i, col_admin, _t_string ) ;
					election_status = election_status_vote ;
					mysql_tquery ( sql_connection, !"UPDATE `server_variables` SET `var_count` = '2' WHERE `var_id` = '8' LIMIT 1" ) ;
				}
				case 3:
				{
					new _t_string [ 62 + MAX_PLAYER_NAME ] ;
					format ( _t_string, sizeof _t_string, "{"#cBAdmin"}[A] {"#cGRAdmin"}%s очистил список кандидатов.", p_info [ playerid ] [ name ] ) ;
					foreach(new i: admin_players)SendClientMessage ( i, col_admin, _t_string ) ;
					mysql_tquery ( sql_connection, !"TRUNCATE `elections`" ) ;
					foreach(new j: logged_players)
					{
						p_info [ j ] [ vote ] = 0 ;
					}
					mysql_tquery ( sql_connection, !"UPDATE `users` SET `u_vote` = '0' WHERE `u_vote` = '1'" ) ;
				}
				case 4:
				{
					show_dialog ( playerid, d_election_delete, DIALOG_STYLE_INPUT, "{"#cBHD"}Удалить кандидата", "{ffffff}Введите имя игрока, которого хотите убрать из списка кандидатов:", "Принять", "Назад" ) ;
				}
				case 5:
				{
					show_dialog ( playerid, d_election_vote, DIALOG_STYLE_INPUT, "{"#cBHD"}Доступ к выдвижению", "{ffffff}Введите имя игрока, которому хотите дать доступ к выдвижению кандидатуры:", "Принять", "Назад" ) ;
				}
			}
			return 1 ;
		}
		case d_election_delete:
		{
			if ( ! response ) return callcmd::election ( playerid ) ;

			new _t_string [ 50 + MAX_PLAYER_NAME ] ;
			format ( _t_string, sizeof _t_string, "SELECT * FROM `elections` WHERE `e_name` = '%s'", inputtext ) ;
			mysql_tquery ( sql_connection, _t_string, "del_elections_list", "is", playerid, inputtext ) ;
			return 1 ;
		}
		case d_election_vote:
		{
			if ( ! response ) return callcmd::election ( playerid ) ;

			new _t_string [ 68 + MAX_PLAYER_NAME ] ;
			format ( _t_string, sizeof _t_string, "SELECT `u_vote_status` FROM `users` WHERE `u_name` = '%s' LIMIT 1", inputtext ) ;
			mysql_tquery ( sql_connection, _t_string, "vote_elections_list", "is", playerid, inputtext ) ;
			return 1 ;
		}
		case d_vote:
		{
			if ( ! response ) return 1 ;
			switch ( listitem )
			{
				case 0:
				{
					if ( p_info [ playerid ] [ hour_played ] < THREE_HOUR_PLAYED ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Голосование доступно только с {"#cRD"}3 {"#cGRInfo"}часов в игре.") ;
					if ( p_info [ playerid ] [ vote ] != 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы уже проголосовали." ) ;
					if ( election_status != election_status_vote ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Голосование недоступно, осуществляется регистрация кандидатов." ) ;
					mysql_tquery ( sql_connection, !"SELECT * FROM `elections` WHERE 1", "elections_list", "i", playerid ) ;
				}
				case 1:
				{
					mysql_tquery ( sql_connection, !"SELECT * FROM `elections` WHERE 1", "elections_msgbox", "i", playerid ) ;
				}
				case 2:
				{
				    if ( ! p_info [ playerid ] [ vote_status ] )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не допущены до выдвижения кандидатуры.") ;
					if ( p_info [ playerid ] [ level ] < 5 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Подача кандидатуры доступна только с {"#cRD"}5 {"#cGRInfo"}уровня.") ;
					if ( p_info [ playerid ] [ money ] < 250000 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Подача кандидатуры стоит {"#cRD"}250.000"valute_title"{"#cGRInfo"}.") ;
			   		mysql_tquery ( sql_connection, !"SELECT * FROM `elections` WHERE 1", "elections_insert", "i", playerid ) ;
				}
			}
			return 1 ;
		}
		case d_election_msgbox:
		{
			if ( ! response ) return 1 ;
			show_vote ( playerid ) ;
			return 1 ;
		}
		case d_election_list:
		{
			if ( ! response )
			{
				show_vote ( playerid ) ;
				for ( new i = 0 ; i < 15 ; i ++ )
				{
					new pvar_string [ 8 ] ;
					format ( pvar_string, sizeof ( pvar_string ), "el_%d", i ) ;
					DeletePVar ( playerid, pvar_string ) ;
				}

				return 1 ;
			}
			new _string [ 98 ],
				_c_name [ MAX_PLAYER_NAME ] ;


			format ( _string, 8, "el_%d", listitem ) ;
			GetPVarString ( playerid, _string, _c_name, MAX_PLAYER_NAME ) ;
			format ( _string, sizeof ( _string ), "{"#cGInfo"}* {"#cWH"}Вы успешно проголосовали за кандидата {"#cGN"}%s", _c_name ) ;
			SendClientMessage ( playerid, col_white, _string ) ;

			p_info [ playerid ] [ vote ] = 1 ;
			format ( _string, sizeof ( _string ), "UPDATE `elections` SET `e_votes`=`e_votes`+'1' WHERE `e_name` = '%s' LIMIT 1", _c_name ) ;
			mysql_tquery(sql_connection, _string ) ;

    		format ( _string, sizeof ( _string ), "UPDATE `users` SET `u_vote`='1' WHERE `u_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
			mysql_tquery(sql_connection, _string ) ;
			return 1 ;
		}
		case d_dice_exit:
		{
			if ( !response ) return SelectTextDraw(playerid, 0xB0C4DEFF ) ;
			return ExitBone ( playerid ), toggle_controlable ( playerid, true ) ;
		}
		case d_dice_bet:
		{
			if ( !response )
			{
				ExitBone ( playerid ) ;
				return 1 ;
			}
			if ( strval ( inputtext ) < 1000 || strval ( inputtext ) > 300000000 ) return show_dialog ( playerid, d_dice_bet, DIALOG_STYLE_INPUT, "{"#cBHD"}Установка ставки для игры","{ffffff}Введите сумму для ставки\n\n{"#cRD"}* Ставка должна быть не менее 1.000 фишек и не более 300.000.000 фишек","Далее","Отмена");
			new null = 0, b = GetPVarInt ( playerid, "p_biz_id" ), _table = player_dice_table { playerid } ;
			for ( new i ; i < 5 ; i ++ ) if ( GetPVarInt ( dice_info [ b ] [ _table - 1 ] [ b_player ] [ i ], "InGame" ) ) null ++ ;
			if ( null > 0 )
			{
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Кто-то из игроков уже поставил ставку." ) ;
				show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Кости", "{"#cRD"}* {"#cGRDialog"}Кто-то из игроков уже поставил ставку.", "Закрыть", "" ) ;
				return 1 ;
			}
			if ( dice_info [ b ] [ _table - 1 ] [ b_started ] != 0 )
			{
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете изменить ставку в процессе игры." ) ;
				show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Кости", "{"#cRD"}* {"#cGRDialog"}Вы не можете изменить ставку в процессе игры.", "Закрыть", "" ) ;
				return 1 ;
			}
			dice_info [ b ] [ _table - 1 ] [ b_bet ] = strval ( inputtext ) ;
			SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Ставка успешно установлена." ) ;
			return update_bone ( _table - 1, b ), update_bone_table ( b, _table - 1 ) ;
		}
		case d_casino_job:
		{
			if ( ! response ) return 1 ;
			/*if ( p_info [ playerid ] [ b_manager ] != GetPVarInt ( playerid, "p_biz_id" ) && p_info [ playerid ] [ b_worker ] != GetPVarInt ( playerid, "p_biz_id" ) )
				return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не являетесь сотрудником бизнеса." ) ;*/
			if ( ! player_croupier [ playerid ] )
			{
				player_croupier [ playerid ] = true ;
				SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы успешно устроились работать крупье." ) ;
				SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Ваша заработная плата будет формироваться из количества проведённых игр." ) ;
				SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Чтобы узнать команды используйте {"#cGN"}'/mm >> Список команд'{"#cWH"}." ) ;
				if ( p_info [ playerid ] [ gender ] == 0 ) SetPlayerSkin ( playerid, 189 ) ;
				else SetPlayerSkin ( playerid, 172 ) ;
			}
			else
			{
				SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы завершили рабочую смену." ) ;
				fraction_duty ( playerid ) ;
				player_croupier [ playerid ] = false ;
			}
			return 1 ;
		}
		case d_bank_info:
		{
		    if ( ! response ) return 1 ;

		    show_debtors_bank ( playerid ) ;
			return 1 ;
		}
		case d_bank_bills_info:
		{
		    if ( ! response ) return show_deposit ( playerid ) ;
		    switch ( listitem )
		    {
		        case 0:
				{
				    show_debtors_bank ( playerid ) ;
				}
		        case 1:
		        {
				    new d_string [ 148 ] ;
					format ( d_string, sizeof ( d_string ), "{"#cWH"}Ваша задолженность по налогам составляет {"#cBL"}%s"valute_title_"\n\n{"#cGRDialog"}* Введите сумму, которую желаете внести в счёт уплаты налогов:",
					GetPlayerCashValueToSmile ( p_info [ playerid ] [ tax ] ) ) ;
					show_dialog ( playerid, d_bank_bills, DIALOG_STYLE_INPUT, "{"#cBHD"}Оплата налогов", d_string, "Принять", "Назад" ) ;
				}
				case 2:
				{
				    global_string [ 0 ] = EOS ;
				    new line_string [ 64 ] ;

				    strcat ( global_string, "{"#cBL"}** Имущество **\n\n" ) ;
				    if ( ! Iter_Count(player_houses[playerid]) )
				    {
				        strcat ( global_string, "{"#cBInfo"}* {"#cWH"}У Вас нет дополнительных налогов за дом.\n" ) ;
				    }
				    else
				    {
					    foreach(new h: player_houses[playerid])
					    {
					        format ( line_string, sizeof line_string, "{"#cBInfo"}* {"#cWH"}Дом №%d - {"#cGN"}%d"valute_title_"\n", h_info [ h - 1 ] [ h_id ], floatround ( h_info [ h - 1 ] [ h_price ] / 350 ) * for_tax [ 3 ] ) ;
					        strcat ( global_string, line_string ) ;
					    }
					}

					if ( ! Iter_Count(player_business[playerid]) )
