	if ( admin_info [ playerid ] [ dostup ] [ 1 ] != 1 && admin_info [ playerid ] [ admin ] < 7 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет доступа к данной команде. Используйте /donate." ) ;

