new getto_select [ MAX_PLAYERS ] ;
new getto_status [ MAX_PLAYERS ] ;
new getto_progress [ MAX_PLAYERS ] ;

stock checking_getto_quest_progress ( playerid, quest_id, amount_plus )
{
	if ( getto_select [ playerid ] != quest_id ) return 1 ;
	if ( getto_status [ playerid ] == 1 )
	{
	    static const _quest_progress [ ] =
		{
			25,
			5,
			100,
			5000,
			10,
			3000,
			5,
			50
		} ;

		getto_progress [ playerid ] += amount_plus ;

		if ( getto_progress [ playerid ] >= _quest_progress [ quest_id ] )
		{
		    new scm_string [ 67 + 32 ] ;
		    if ( quest_id == sizeof quest_getto_info - 1 )
		    {
		        format ( scm_string, sizeof scm_string, "Задание успешно выполнено. Ваша награда: {"#cWH"}%s{"#cSucces"}.", quest_getto_info [ quest_id ] [ q_rewards ] ) ;
				SendClientMessage ( playerid, col_succes, scm_string ) ;

				SendClientMessage ( playerid, col_succes, !"Вы завершили квестовую линию. Отправляйтесь к Биг Смоуку, чтобы получить своё вознаграждение." ) ;
		    }
		    else
		    {
		        format ( scm_string, sizeof scm_string, "Задание успешно выполнено. Ваша награда: {"#cWH"}%s{"#cSucces"}.", quest_getto_info [ quest_id ] [ q_rewards ] ) ;
				SendClientMessage ( playerid, col_succes, scm_string ) ;

		        format ( scm_string, sizeof scm_string, "Следующее задание: {"#cWH"}%s{"#cSucces"}.", quest_getto_info [ quest_id + 1 ] [ q_name ] ) ;
				SendClientMessage ( playerid, col_succes, scm_string ) ;

				SendClientMessage ( playerid, col_succes, !"Отправляйтесь к Биг Смоуку, чтобы получить своё вознаграждение." ) ;
		    }

			getto_status [ playerid ] = 2 ;
			update_quest_getto ( playerid ) ;
		}
		else
		{
			update_int_sql ( playerid, "u_quest_getto_progress", getto_progress [ playerid ] ) ;
		}
	}
	return 1 ;
}

