			foreach(new i: logged_players) if ( ( p_info [ i ] [ member ] == b_info [ mafia_factory_id - 1 ] [ b_mafia ] || is_control_chat { i } == b_info [ mafia_factory_id - 1 ] [ b_mafia ] ) && p_info [ i ] [ settings ] [ 0 ] != 0 ) SendClientMessage ( i, col_lblue, scm_string ) ;

