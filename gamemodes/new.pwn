	return 1 ;
}

CMD:bc ( playerid, params [ ] )
{
    if ( p_info [ playerid ] [ mute ] )
	{
		new scm_string [ 38 ] ;
		format ( scm_string, sizeof ( scm_string  ),"У вас бан чата | %d секунд(ы)", p_info [ playerid ] [ mute ] ) ;
		SendClientMessage ( playerid, col_light_red, scm_string ) ;
		return false ;
	}

	if ( Iter_Count(player_business[playerid]) > 0 )
	{
	    if ( sscanf ( params, "ds[128]", params [ 0 ], params [ 1 ] ) )
		{
			SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /bc [id] [текст]" ) ;

			new b_string [ 64 ] ;
			foreach(new b: player_business[playerid])
			{
			    format ( b_string, sizeof b_string, "{"#cRInfo"}* {"#cGRInfo"}%s [ID: %d]", b_info [ b - 1 ] [ b_name ], b_info [ b - 1 ] [ b_id ] ) ;
			    SendClientMessage ( playerid, col_gray, b_string ) ;
			}
			return 1 ;
		}
	  	if ( check_advertise ( playerid, params [ 1 ], report_type_bc ) ) return 1 ;

	  	new bool:business_player = false ;
		foreach(new b: player_business[playerid])
		{
		    if ( b_info [ b - 1 ] [ b_id ] == params [ 0 ] )
			{
				business_player = true ;
				break ;
			}
		}
		if ( business_player == false ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Не правильно указан ID бизнеса." ) ;

  		new _t_string [ 144 ] ;
	    format(_t_string,sizeof(_t_string),"{%s}[%s] Владелец %s: %s", b_info [ params [ 0 ] - 1 ] [ b_chat_color ], b_info [ params [ 0 ] - 1 ] [ b_name ], p_info [ playerid ] [ name ], params [ 1 ] ) ;
	    business_message ( params [ 0 ], col_gray, _t_string ) ;
	    return 1 ;
	}
	else
	{
	    if ( p_info [ playerid ] [ b_worker ] < 1 || p_info [ playerid ] [ business_rang ] < 1 )
			return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не являетесь сотрудником бизнеса." ) ;

	    if ( sscanf ( params, "s[128]", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /bc [текст]" ) ;
	  	if ( check_advertise ( playerid, params [ 0 ], report_type_bc ) ) return 1 ;

		new b = p_info [ playerid ] [ b_worker ], _t_string [ 144 ] ;
	    format(_t_string,sizeof(_t_string),"{%s}[%s] %s %s: %s", b_info [ b - 1 ] [ b_chat_color ], b_info [ b - 1 ] [ b_name ], b_rank [ b - 1 ] [ p_info [ playerid ] [ business_rang ] - 1 ], p_info [ playerid ] [ name ], params [ 0 ] ) ;
	    business_message ( b, col_gray, _t_string ) ;
	}
    return 1 ;
}

CMD:brank ( playerid, params [ ] )
{
    if ( ! Iter_Count(player_business[playerid]) && p_info [ playerid ] [ b_worker ] == -1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет бизнеса или Вы не являетесь менеджером." ) ;

    if ( Iter_Count(player_business[playerid]) > 0 )
	{
	    if ( sscanf(params, "ud", params [ 0 ], params [ 1 ] ) )
		{
			SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /brank [id/имя] [id]" ) ;

			new b_string [ 64 ] ;
			foreach(new b: player_business[playerid])
			{
			    format ( b_string, sizeof b_string, "{"#cRInfo"}* {"#cGRInfo"}%s [ID: %d]", b_info [ b - 1 ] [ b_name ], b_info [ b - 1 ] [ b_id ] ) ;
			    SendClientMessage ( playerid, col_gray, b_string ) ;
			}
			return 1 ;
		}

		if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
		if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете применить это к самому себе." ) ;
		if ( Iter_Count(player_business[params [ 0 ]]) > 0 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок является владельцем бизнеса." ) ;
		if ( p_info [ params [ 0 ] ] [ b_worker ] != params [ 1 ] )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок уже является сотрудником другого бизнеса." ) ;
		if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ] [ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ] [ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;

		new bool:business_player = false ;
		foreach(new b: player_business[playerid])
		{
		    if ( b_info [ b - 1 ] [ b_id ] == params [ 1 ] )
			{
				business_player = true ;
				break ;
			}
		}
		if ( business_player == false ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Не правильно указан ID бизнеса." ) ;

		global_string [ 0 ] = EOS ;
		new line_string [ 72 ] ;
		for ( new i = 0; i < b_info [ params [ 1 ] - 1 ] [ b_settings ] [ 3 ] ; i ++ )
		{
			format ( line_string, 72, "{"#cBL"}%i. {"#cWH"}%s\n", i + 1, b_rank [ params [ 1 ] - 1 ] [ i ] ) ;
			strcat ( global_string, line_string ) ;
		}
		show_dialog ( playerid, d_business_rank, DIALOG_STYLE_LIST, "{"#cBHD"}Должность", global_string, "Выбрать", "Назад" ) ;
	}
	else
	{
	    if ( sscanf(params, "u", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /brank [id/имя]" ) ;

		if ( p_info [ playerid ] [ business_rang ] <  b_info [ p_info [ playerid ] [ b_worker ] - 1 ] [ b_settings ] [ 4 ] )
		{
		    static const _str [ ] = "{"#cRInfo"}* {"#cGRInfo"}Команда доступна с должности %s (%d)." ;
		    new scm_string [ sizeof _str + 30 + 4 ] ;
		    format ( scm_string, sizeof scm_string, _str, b_rank [ p_info [ playerid ] [ b_worker ] - 1 ] [ b_info [ p_info [ playerid ] [ b_worker ] - 1 ] [ b_settings ] [ 4 ] - 1 ], b_info [ p_info [ playerid ] [ b_worker ] - 1 ] [ b_settings ] [ 4 ] ) ;
			SendClientMessage ( playerid, col_gray, scm_string ) ;
			return 1 ;
		}

	 	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
		if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете применить это к самому себе." ) ;
		if ( Iter_Count(player_business[params [ 0 ]]) > 0 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок является владельцем бизнеса." ) ;
		if ( p_info [ params [ 0 ] ] [ b_worker ] != -1 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок уже является сотрудником." ) ;
		if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;

        global_string [ 0 ] = EOS ;
		new business_id = p_info [ playerid ] [ b_worker ], line_string [ 72 ] ;
		for ( new i = 0; i < b_info [ business_id - 1 ] [ b_settings ] [ 3 ] ; i ++ )
		{
			format ( line_string, 72, "{"#cBL"}%i. {"#cWH"}%s\n", i + 1, b_rank [ business_id - 1 ] [ i ] ) ;
			strcat ( global_string, line_string ) ;
		}
		show_dialog ( playerid, d_business_rank, DIALOG_STYLE_LIST, "{"#cBHD"}Должность", global_string, "Выбрать", "Назад" ) ;
	}

	buyer_id [ playerid ] = params [ 0 ] ;
	return 1 ;
}

CMD:binvite ( playerid, params [ ] )
{
    if ( ! Iter_Count(player_business[playerid]) && p_info [ playerid ] [ b_worker ] == -1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет бизнеса или Вы не являетесь менеджером." ) ;

    if ( Iter_Count(player_business[playerid]) > 0 )
