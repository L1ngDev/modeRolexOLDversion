					        anti_db_warning { playerid } = 0 ;
					        show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Зона контейнеров", "{FFFFFF}Вы игнорировали предупреждения по поводу зоны контейнеров,\nпоэтому Ваше т/с было отправлено на место парковки.\n\n{"#cRD"}* В случае повторных нарушений Вы можете быть кикнуты.", "Принять", "" ) ;
