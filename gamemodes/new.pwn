		case d_help_box:
		{
			if ( ! response ) return 1 ;
			callcmd::help ( playerid ) ;
			return 1 ;
		}
		case d_debtors_card:
		{
		    if ( ! response )
		    {
		        new _pvar_string [ 20 ] ;
		        for ( new i = 0 ; i < MAX_BANK_ACCOUNT ; i ++ )
				{
					format ( _pvar_string, sizeof ( _pvar_string ), "bc_%d", i ) ;
					DeletePVar ( playerid, _pvar_string ) ;

					format ( _pvar_string, sizeof ( _pvar_string ), "bm_%d", i ) ;
					DeletePVar ( playerid, _pvar_string ) ;
				}

				new pvar_string [ 38 ],
					pl_name [ MAX_PLAYER_NAME ] ;

				format ( pvar_string, sizeof ( pvar_string ), "ofm_%d", GetPVarInt ( playerid, "ofm_listitem" ) ) ;
				GetPVarString ( playerid, pvar_string, pl_name, MAX_PLAYER_NAME ) ;

				show_debtors ( playerid, pl_name ) ;
				return 1 ;
		    }

		    new pvar_string [ 20 ] ;
			format ( pvar_string, sizeof ( pvar_string ), "bc_%d", listitem ) ;
			new bank_card = GetPVarInt ( playerid, pvar_string ) ;

			format ( pvar_string, sizeof ( pvar_string ), "bm_%d", listitem ) ;
			new bank_money = GetPVarInt ( playerid, pvar_string ) ;

			for ( new i = 0 ; i < MAX_BANK_ACCOUNT ; i ++ )
			{
				format ( pvar_string, sizeof ( pvar_string ), "bc_%d", i ) ;
				DeletePVar ( playerid, pvar_string ) ;

				format ( pvar_string, sizeof ( pvar_string ), "bm_%d", i ) ;
				DeletePVar ( playerid, pvar_string ) ;
			}

			static const _str [ ] = "SELECT `u_id`,`u_name`,`u_tax` FROM `users` WHERE `u_id` = '%d' LIMIT 1" ;
			new query_string [ sizeof _str + 9 ] ;
			format ( query_string, sizeof query_string, _str, GetPVarInt ( playerid, "debt_uid" ) ) ;
			mysql_tquery ( sql_connection, query_string, "callback_debtor_bankmoney", "iii", playerid, bank_card, bank_money ) ;
			return 1 ;
		}
		case d_debtors_list:
		{
			if ( ! response )
			{
				for ( new i = 0 ; i < 10 ; i ++ )
				{
					new pvar_string [ 8 ] ;
					format ( pvar_string, sizeof ( pvar_string ), "ofm_%d", i ) ;
					DeletePVar ( playerid, pvar_string ) ;
				}
				page_count [ playerid ] = 0 ;
				page_rows [ playerid ] = 0 ;
				DeletePVar ( playerid, "ofm_listitem" ) ;
				DeletePVar ( playerid, "ofm_type" ) ;
				return 1 ;
			}

			if ( GetString ( inputtext, "Предыдущая страница" ) ) getDebtorsInfo ( playerid, page_count [ playerid ] - 1, 1 ) ;
			else if ( GetString ( inputtext, "Следующая страница" ) ) getDebtorsInfo ( playerid, page_count [ playerid ] + 1, 1 ) ;
			else
			{
				new pvar_string [ 38 ], pl_name [ MAX_PLAYER_NAME ] ;
				format ( pvar_string, 10, "ofm_%d", listitem ) ;
				GetPVarString ( playerid, pvar_string, pl_name, MAX_PLAYER_NAME ) ;
				SetPVarInt ( playerid, "ofm_listitem", listitem ) ;

				static const _str [ ] = "\
					SELECT \
						u.u_id, \
						IFNULL(SELECT COUNT(h_id) FROM houses WHERE h_owner = u.u_id), 0) AS houses_count, \
						IFNULL(SELECT COUNT(b_id) FROM businesses WHERE b_owner_inc = u.u_id), 0) AS business_count \
					FROM users u WHERE u.u_name = '%s' LIMIT 1" ;
				new query_string [ sizeof _str + MAX_PLAYER_NAME ] ;
				format ( query_string, sizeof query_string, _str, pl_name ) ;
				mysql_tquery ( sql_connection, query_string, "id_debtors", "is", playerid, pl_name ) ;
			}
			return 1 ;
		}
		case d_debtors_pl_menu:
		{
			if ( ! response )
			{
			    DeletePVar ( playerid, "debt_uid" ) ;
				DeletePVar ( playerid, "ofm_listitem" ) ;
				getDebtorsInfo ( playerid, page_count [ playerid ], 1 ) ;
				return 1 ;
			}
			switch ( listitem )
			{
				case 0:
				{
				    static const _str [ ] = "\
						SELECT \
							u.u_id, u.u_cellar, u.u_tax, \
							IFNULL((SELECT SUM(db_money) FROM deposit_boxes WHERE db_owner = u.u_id AND db_type != 3 LIMIT %d), 0) AS db_money \
						FROM users WHERE u.u_id = %d LIMIT 1" ;
					new query_string [ sizeof _str + ( 9 * 2 ) ] ;
					format ( query_string, sizeof query_string, _str, MAX_BANK_ACCOUNT, GetPVarInt ( playerid, "debt_uid" ) ) ;
					mysql_tquery ( sql_connection, query_string, "callback_debtor_info", "i", playerid ) ;
				}
				case 1:
				{
					static const _str [ ] = "\
						SELECT \
						u.u_id, u.u_tax, \
						IFNULL((SELECT SUM(db_money) FROM deposit_boxes WHERE db_owner = u.u_id AND db_type != 3 LIMIT %d), 0) AS db_money, \
						h.* \
						FROM houses h \
						LEFT JOIN users ON u.u_id=h.h_owner \
						WHERE h.h_owner = %d" ;
				    new query_string [ sizeof _str + ( 9 * 2 ) ] ;
					format ( query_string, sizeof query_string, _str, MAX_BANK_ACCOUNT, GetPVarInt ( playerid, "debt_uid" ) ) ;
					mysql_tquery ( sql_connection, query_string, "debtors_check_tax", "ii", playerid, 1 ) ;
				}
				case 2:
				{
				    static const _str [ ] = "SELECT `v_model` FROM `users_vehicles` WHERE `v_owner` = '%d' LIMIT 5" ;
					new query_string [ sizeof _str + 9 ] ;
					format ( query_string, sizeof query_string, _str, GetPVarInt ( playerid, "debt_uid" ) ) ;
					mysql_tquery ( sql_connection, query_string, "callback_debtor_car_info", "i", playerid ) ;
				}
				case 3:
				{
				    new query_string [ 58 + 9 ] ;
					format ( query_string, sizeof ( query_string ),"SELECT `u_tax` FROM `users` WHERE `u_id` = '%d' LIMIT 1", GetPVarInt ( playerid, "debt_uid" ) ) ;
					mysql_tquery ( sql_connection, query_string, "debtors_check_tax", "ii", playerid, 2 ) ;
				}
				case 4:
				{
					insert_debtor_message ( "Налоги", "Сотрудники мэрии вынесли Вам предупреждение за невыплату налогов.\n\
														В случае неоплаты налогов Вы можете потерять часть собственности!", GetPVarInt ( playerid, "debt_uid" ) ) ;

					SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Должник успешно уведомлен о его задолженностях." ) ;

					new pvar_string [ 38 ],
						pl_name [ MAX_PLAYER_NAME ] ;

					format ( pvar_string, sizeof ( pvar_string ), "ofm_%d", GetPVarInt ( playerid, "ofm_listitem" ) ) ;
					GetPVarString ( playerid, pvar_string, pl_name, MAX_PLAYER_NAME ) ;

					show_debtors ( playerid, pl_name ) ;

					write_fraction ( playerid, p_info [ playerid ] [ member ], TYPE_LOG_OBWYAK, "Уведомил(а) должника" ) ;
				}
			}
			return 1 ;
		}
