	if(strfind(ask, "инвент", true) != -1)
	{
	    if ( strfind(ask, "откр", true) != -1 ) return 116 ;
	}

	if(strfind(ask, "клад", true) != -1)
	{
	    if ( strfind(ask, "куп", true) != -1 && (strfind(ask, "лопат", true) != -1 || strfind(ask, "лапат", true) != -1) ) return 123 ;
	    if ( strfind(ask, "откр", true) != -1 || strfind(ask, "копат", true) != -1 || strfind(ask, "капат", true) != -1 ) return 84 ;
		if ( strfind(ask, "наит", true) != -1 || strfind(ask, "найт", true) != -1 || strfind(ask, "искат", true) != -1 || strfind(ask, "наход", true) != -1 ||
			strfind(ask, "узнат", true) != -1 && strfind(ask, "рядом", true) != -1 ) return 26 ;
		if ( strfind(ask, "карт", true) != -1 ) return 85 ;
	}

	if(strfind(ask, "код", true) != -1 && strfind(ask, "протек", true) != -1) return 91 ;
	if(strfind(ask, "продукт", true) != -1 && strfind(ask, "холод", true) != -1) return 129 ;

	if(strfind(ask, "менят", true) != -1 || strfind(ask, "измен", true) != -1 || strfind(ask, "выбр", true) != -1 || strfind(ask, "установ", true) != -1)
	{
	    if ( strfind(ask, "спаун", true) != -1 || strfind(ask, "спавн", true) != -1 || strfind(ask, "место", true) != -1 && strfind(ask, "появл", true) != -1 ) return 87 ;
	}

	if(strfind(ask, "купит", true) != -1 && (strfind(ask, "втор", true) != -1 || strfind(ask, "трет", true) != -1) || strfind(ask, "имет", true) != -1 && (strfind(ask, "два", true) != -1 || strfind(ask, "три", true) != -1))
	{
	    if ( strfind(ask, "дом", true) != -1 || strfind(ask, "бизнес", true) != -1 ) return 90 ;
	}

	if(strfind(ask, "ввел", true) != -1 && strfind(ask, "промо", true) != -1 && (strfind(ask, "дали", true) != -1 || strfind(ask, "выпал", true) != -1))
	{
	    if ( strfind(ask, "нигде", true) != -1 || strfind(ask, "негде", true) != -1 || strfind(ask, "где", true) != -1 || strfind(ask, "нет", true) != -1 ) return 94 ;
	}

	if(strfind(ask, "выкин", true) != -1 || strfind(ask, "вытащит", true) != -1 && strfind(ask, "из", true) != -1 || strfind(ask, "выгнат", true) != -1 || strfind(ask, "выброс", true) != -1)
	{
		if(strfind(ask, "транспорт", true) != -1 || strfind(ask, "авто", true) != -1 ||
			strfind(ask, "маш", true) != -1 || strfind(ask, "тачк", true) != -1 || strfind(ask, "мащ", true) != -1 ||
			strfind(ask, "тс", true) != -1 || strfind(ask, "т/с", true) != -1) return 97 ;
	}

	if(strfind(ask, "охот", true) != -1 && strfind(ask, "олен", true) != -1) return 104 ;

	if(strfind(ask, "устроится", true) != -1 || strfind(ask, "устроиться", true) != -1 || strfind(ask, "набор", true) != -1 || strfind(ask, "вступ", true) != -1)
	{
	    if(strfind(ask, "полиц", true) != -1 || strfind(ask, "фсб", true) != -1 || strfind(ask, "авто", true) != -1 || strfind(ask, "мэри", true) != -1) return 131 ;
	}

	if(strfind(ask, "собес", true) != -1)
	{
	    if(strfind(ask, "проход", true) != -1) return 131 ;
	}

	if(strfind(ask, "вкл", true) != -1 || strfind(ask, "выкл", true) != -1)
	{
		if(strfind(ask, "пригл", true) != -1 && (strfind(ask, "фам", true) != -1 || strfind(ask, "сем", true) != -1)) return 126 ;
	}

	if(strfind(ask, "сделк", true) != -1 || strfind(ask, "обмен", true) != -1 || strfind(ask, "треид", true) != -1 || strfind(ask, "трейд", true) != -1)
	{
		if(strfind(ask, "тп", true) != -1 || strfind(ask, "следи", true) != -1 || strfind(ask, "смотр", true) != -1 || strfind(ask, "сматр", true) != -1 || strfind(ask, "помог", true) != -1) return 106 ;
	}

	if((strfind(ask, "загн", true) != -1 || strfind(ask, "заех", true) != -1) && strfind(ask, "гидр", true) != -1)
	{
	    if(strfind(ask, "убр", true) != -1) return 157 ;
	    if(strfind(ask, "транспорт", true) != -1 || strfind(ask, "авто", true) != -1 ||
			strfind(ask, "маш", true) != -1 || strfind(ask, "тачк", true) != -1 || strfind(ask, "мащ", true) != -1 ||
			strfind(ask, "тс", true) != -1 || strfind(ask, "т/с", true) != -1)
		{
		    return 140 ;
		}
	}

	if(strfind(ask, "застрял", true) != -1 || strfind(ask, "утанул", true) != -1 || strfind(ask, "утонул", true) != -1 || strfind(ask, "достан", true) != -1 || strfind(ask, "дастан", true) != -1)
	{
	    if(strfind(ask, "транспорт", true) != -1 || strfind(ask, "авто", true) != -1 ||
			strfind(ask, "маш", true) != -1 || strfind(ask, "тачк", true) != -1 || strfind(ask, "мащ", true) != -1 ||
			strfind(ask, "тс", true) != -1 || strfind(ask, "т/с", true) != -1)
		{
	        new veh_id = GetPlayerVehicleID ( playerid ) ;
			if ( veh_id != 0 ) return 110 ;

			new bool: _finded_cars = false ;
			foreach(new _veh_id: player_vehicles[playerid])
			{
			    if ( ! IsPlayerInRangeOfPoint ( playerid, 30.0, veh_info [ _veh_id - 1 ] [ v_now_pos ] [ 0 ], veh_info [ _veh_id - 1 ] [ v_now_pos ] [ 1 ], veh_info [ _veh_id - 1 ] [ v_now_pos ] [ 2 ] ) ) continue ;

	            veh_id = _veh_id ;
				_finded_cars = true ;
				break ;
			}

			if ( _finded_cars == true )
			{
   				new Float: veh_pos [ 3 ] ;
				GetPlayerPos ( playerid, veh_pos [ 0 ], veh_pos [ 1 ], veh_pos [ 2 ] ) ;
				SetVehiclePos ( veh_id, veh_pos [ 0 ] - 4, veh_pos [ 1 ], veh_pos [ 2 ] + 1 ) ;

				SetVehicleVirtualWorld ( veh_id, GetPlayerVirtualWorld ( playerid ) ) ;
				LinkVehicleToInterior ( veh_id, GetPlayerInterior ( playerid ) ) ;
		        return 112 ;
			}
		}
	}

	if((strfind(ask, "кто", true) != -1 || strfind(ask, "где", true) != -1) && strfind(ask, "лидер", true) != -1) return 107 ;
	if(strfind(ask, "смени", true) != -1 && strfind(ask, "ник", true) != -1) return 109 ;
	if(strfind(ask, "почини", true) != -1)
	{
	    if ( GetPlayerVehicleID ( playerid ) != 0 ) return 143 ;
	}

	if(strfind(ask, "прогул", true) != -1 && strfind(ask, "рд", true) != -1) return 150 ;

	if((strfind(ask, "cпавн", true) != -1 || strfind(ask, "cпавн", true) != -1 || strfind(ask, "spawn", true) != -1) && strlen ( ask ) < 10 || strfind(ask, "спавн", true) != -1 && strfind(ask, "меня", true) != -1 || strfind(ask, "застрял", true) != -1 || strfind(ask, "заспавните", true) != -1 && strlen ( ask ) < 15 ||
		strfind(ask, "в", true) != -1 && strfind(ask, "текстур", true) != -1)
	{
		if ( ! bad_dialog ( playerid ) ) return 105 ;
		if ( p_info [ playerid ] [ jailed ] > 0 ) return 111 ;
		if ( p_t_info [ playerid ] [ last_time_damage_spawn ] > gettime ( ) ) return 100 ;
		if ( target_cuff [ playerid ] != INVALID_PLAYER_ID || target_tie [ playerid ] != INVALID_PLAYER_ID ) return 101 ;
		if ( player_tie [ playerid ] != INVALID_PLAYER_ID || player_cuff [ playerid ] != INVALID_PLAYER_ID || police_check_time [ playerid ] > gettime ( ) ) return 102 ;

		new bool: _finded_police = false ;
		foreach(new i: streamed_players[playerid])
		{
		    if ( ! cop_player ( i ) && ! fbi_player ( i ) && ! army_player ( i ) ) continue ;
		    if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ i ][ p_pos ] [ 0 ], p_t_info [ i ][ p_pos ] [ 1 ], p_t_info [ i ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( i ) != GetPlayerVirtualWorld ( playerid ) ) continue ;

		    _finded_police = true ;
		    break ;
		}

		if ( _finded_police == false )
		{
		    show_dialog ( playerid, d_spawn_report, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Место появления", "{"#cWH"}Вы хотели бы вернуться на место появления? (получить спавн)", "Да", "Нет" ) ;
			return 103 ;
		}
		else
		{
		    return 149 ;
		}
	}

    if ( ( strfind(ask, "как", true) != -1 || strfind(ask, "когда", true) != -1 || strfind(ask, "куда", true) != -1 || strfind(ask, "где", true) != -1 ) && strfind(ask, "собес", true) != -1 ) return 134 ;
	if(strfind(ask, "привет", true) != -1 || strfind(ask, "здравствуй", true) != -1
	|| strfind(ask, "здравствуйте", true) != -1) return 2 ;
	if(strfind(ask, "меня", true) != -1 && strfind(ask, "крашит", true) != -1) return 45 ;
	if((strfind(ask, "меня", true) != -1 || strfind(ask, "брат", true) != -1) && (strfind(ask, "лагает", true) != -1 || strfind(ask, "лаги", true) != -1)) return 46 ;
	if(strfind(ask, "PayDay", true) != -1)
	{
	    show_dialog ( playerid, d_report_payday, DIALOG_STYLE_LIST, "{"#cBHD"}PayDay - Ежечасовая з/п", "\
			{"#cBL"}1. {"#cWH"}Что такое PayDay\n\
			{"#cBL"}2. {"#cWH"}Какие бонусы можно получить в PayDay\n\n\
			{"#cGRDialog"}- {"#cWH"}PayDay выдаётся в начале каждого часа\n\
			{"#cGRDialog"}- {"#cWH"}Для его получения нужно отыграть за час 15 минут", "Выбрать", "Закрыть" ) ;
		return 148 ;
	}
	return 0 ;
}

