			_b_type != bizz_type_trucker && _b_type != bizz_type_electric && _b_type != bizz_type_lake &&
			_b_type != bizz_type_reserve )
			return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данный тип бизнеса приобретается через пикап входа в бизнес." ) ;

