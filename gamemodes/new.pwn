{
    global_string [ 0 ] = EOS ;
	new spawn_text [ 24 ] ;
	switch ( p_info [ playerid ] [ spawnchange ] )
	{
	    case 0: spawn_text = "На вокзале" ;
	    case 1: spawn_text = "В собственном доме" ;
	    case 2: spawn_text = "На базе организации" ;
	    case 3: spawn_text = "В личной яхте" ;
	    case 4: spawn_text = "Личный гараж" ;
	    case 5: spawn_text = "В арендованом доме" ;
	    case 6: spawn_text = "В отеле" ;
