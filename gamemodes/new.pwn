				if ( count_gold_card == 0 )
			    {
			        count_gold_card = inc_gold_card ;
			        count_gold_card ++ ;
					_card_inc = count_gold_card ;
			    }
			    else
			    {
			    	count_gold_card ++ ;
					_card_inc = count_gold_card ;
				}
			}
			else if ( _list_item == 3 )
			{
			    if ( p_info [ playerid ] [ money ] < price_credit_card ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас не достаточно средств." ), DeletePVar ( playerid, "list_item" ) ;

			    give_money ( playerid, -price_credit_card ) ;
            	insert_money_log ( playerid, INVALID_PLAYER_ID, -price_credit_card, "оформление карты" ) ;

				give_bmoney ( b + 1, price_credit_card, 0 ) ;

			    if ( count_credit_card == 0 )
			    {
			        count_credit_card = inc_credit_card ;
			        count_credit_card ++ ;
					_card_inc = count_credit_card ;
			    }
			    else
			    {
			    	count_credit_card ++ ;
					_card_inc = count_credit_card ;
				}
			}

			new query_string [ 156 ] ;
			format ( query_string, sizeof query_string, "INSERT INTO `deposit_boxes`(`db_id`,`db_owner`,`db_pincode`,`db_type`) VALUES ('%i','%i','%i','%i')", _card_inc, p_info [ playerid ] [ id ], _pin_code, _list_item ) ;
			mysql_tquery ( sql_connection, query_string, "", "" ) ;

			for ( new i = 0 ; i < MAX_BANK_ACCOUNT ; i ++ )
			{
			    if ( bank_info [ playerid ] [ bi_type ] [ i ] ) continue ;

			    bank_info [ playerid ] [ bi_id ] [ i ] = _card_inc ;
			    bank_info [ playerid ] [ bi_type ] [ i ] = _list_item ;
				bank_info [ playerid ] [ bi_pincode ] [ i ] = _pin_code ;
				bank_info [ playerid ] [ bi_owner ] [ i ] = p_info [ playerid ] [ id ] ;

				bank_info [ playerid ] [ bi_money ] [ i ] =
				bank_info [ playerid ] [ bi_reset ] [ i ] = 0 ;

				global_string [ 0 ] = EOS ;
				format ( global_string, sizeof global_string, "\
					{"#cWH"}Вы успешнейшим образом создали себе новый банковский\n\
					счёт с номером: {"#cYW"}\"%d\"{"#cWH"}.\n\n\
					PIN-код от Вашего счёта: {"#cYW"}%d{"#cWH"}.\n\n\
					{"#cYW"}Примечание: {"#cWH"}в обязательном порядке необходимо запомнить\n\
					или записать выше предоставленный специальный\n\
					секретный PIN-код от нового банковского счета. После входа\n\
					в меню управления ранее созданного банковского счёта Вы\n\
					сможете без каких-либо проблем изменить указанный\n\
					PIN-код на желаемый.\n\n\
					Стоит отметить, что мы не сможем восстановить\n\
					специальный секретный PIN-код в том, если он будет\n\
					забыт каким-либо способом, только перевыпуск карты с\n\
					сохранением всех средств. Старайтесь ставить сложные\n\
					комбинации - это поможет защитить банковский счёт от\n\
					несанкционированного доступа со стороны злоумышленников.",
					bank_info [ playerid ] [ bi_id ] [ i ], _pin_code ) ;
				show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Создание счёта", global_string, "Готово", "" ) ;
				break ;
			}

			checking_quest_progress ( playerid, 3, 1, quest_line_start ) ;
			bank_player_account [ playerid ] += 1 ;
			return 1 ;
		}
		case d_pharmshop:
		{
			if ( ! response ) return 1 ;
