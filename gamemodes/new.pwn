			    give_money ( playerid, -price_pay_card ) ;
            	insert_money_log ( playerid, INVALID_PLAYER_ID, -price_pay_card, "оформление карты" ) ;

				give_bmoney ( b + 1, price_pay_card, 0 ) ;

			    if ( count_pay_card == 0 )
			    {
			        count_pay_card = inc_pay_card ;
			        count_pay_card ++ ;
					_card_inc = count_pay_card ;
			    }
			    else
			    {
			    	count_pay_card ++ ;
					_card_inc = count_pay_card ;
				}
			}
			else if ( _list_item == 2 )
			{
			    if ( p_info [ playerid ] [ money ] < price_gold_card ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас не достаточно средств." ), DeletePVar ( playerid, "list_item" ) ;

			    give_money ( playerid, -price_gold_card ) ;
            	insert_money_log ( playerid, INVALID_PLAYER_ID, -price_gold_card, "оформление карты" ) ;

