		{
			new Float: speed = GetVehicleSpeed ( surf_ ),
				vehicle_model = GetVehicleModel ( surf_ ) ;
			switch ( vehicle_model )
			{
				case 430,446,452,453,454,472,473,478,484,493,554,543,595,422,605,600,592: { }
				default:
				{
					if ( speed > 20 )
					{
						new Float:slx, Float:sly, Float:slz;
