	new text [ 64 ], pldo [ 64 ] ;
	if ( sscanf ( params, "p<*>s[64]s[64]", text, pldo ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /todo [речь в чат*действие]" ) ;
	new scm_string [ 128 ] ;
	format ( scm_string, sizeof ( scm_string  ), "{C2A2DA}- {FFFFFF}%s {C2A2DA}- сказал %s, {C2A2DA}%s", text, p_info [ playerid ] [ name ], pldo ) ;
	send_world_message ( playerid, 50.0, scm_string, col_white, col_white, col_gray, true ) ;
	SetPlayerChatBubble ( playerid, scm_string, col_white, 50, 5000 ) ;
	return 1 ;
}

CMD:paygang ( playerid, params [ ] )
{
	if ( ! gang_player ( playerid ) && ! mafia_player ( playerid ) || ! p_info [ playerid ] [ leader ] ) return 1 ;
	if ( sscanf ( params, "d", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /paygang [сумма]" ) ;
	if ( params [ 0 ] < 1 || params [ 0 ] > 1000000 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Сумма не может быть меньше 1"valute_title_" или больше 1.000.000"valute_title_"" ) ;

	new num = 0, fraction_id = p_info [ playerid ] [ member ] ;
	foreach(new i : fraction_players[fraction_id])
	{
		if ( p_info [ i ] [ member ] != fraction_id || playerid == i ) continue ;
		num ++ ;
	}
	if ( num < paygang_online )
	{
	    SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Недостаточно сотрудников для выдачи заработной платы." ) ;

	    new scm_string [ 86 + 4 ] ;
	    format ( scm_string, sizeof scm_string, "{"#cRInfo"}* {"#cGRInfo"}Минимальное количество: {"#cRD"}%d {"#cGRInfo"}человек(а).", paygang_online ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
		return 1 ;
	}

	if ( f_info [ fraction_id - 1 ] [ f_money_limit_paygang ] + params [ 0 ] > 5000000 )
	{
		new query_string [ 91 + 9 ] ;
		format ( query_string, sizeof ( query_string ), "{"#cRInfo"}* {"#cGRInfo"}Лимит выдачи средств в сутки. Остаток: {"#cRD"}%d"valute_title_"{"#cGRInfo"}", 5000000 - f_info [ fraction_id - 1 ] [ f_money_limit_paygang ] ) ;
		SendClientMessage ( playerid, col_gray, query_string ) ;

		return 1 ;
	}

	global_string [ 0 ] = EOS ;
	format ( global_string, 200, "{"#cWH"}Вы действительно хотите выдать {"#cGN"}%d"valute_title_"{"#cWH"} игрокам, состоящим в Вашей организации?\n\n{"#cGRDialog"}* Сумма может измениться при изменении онлайна организации.", params [ 0 ] * num ) ;
	show_dialog ( playerid, d_paygang, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Выдача заработной платы", global_string, "Да", "Нет" ) ;

	set_player_use_listitem ( playerid, params [ 0 ] ) ;
	return 1 ;
}

CMD:pay ( playerid, params [ ] )
{
	if ( duel_opponent [ playerid ] != INVALID_PLAYER_ID ) return 1 ;
 	if ( sscanf ( params, "dd", params [ 0 ], params [ 1 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /pay [ид] [сумма]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] )  || params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
    if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;

	if ( p_info [ playerid ] [ hour_played ] < THREE_HOUR_PLAYED && params [ 1 ] > 500 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете передать деньги игроку больше 500"valute_title_", потому что не отыграли 3 часа." ) ;
	if ( params [ 1 ] < 1 || params [ 1 ] > 100000 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Можно передавать от {"#cRD"}1"valute_title_"{"#cGRInfo"} до {"#cRD"}100.000"valute_title"{"#cGRInfo"}." ) ;
	if ( params [ 1 ] > p_info [ playerid ] [ money ] )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Недостаточно денег для передачи." ) ;

	if ( GetString ( p_t_info [ params [ 0 ] ] [ p_ip ], p_t_info [ playerid ] [ p_ip ] ) )
	{
		new scm_string [ 128 ] ;
		format ( scm_string, sizeof ( scm_string ), "{"#cBAdmin"}[A]{"#cGRAdmin"} %s[%d] передаёт средства %s[%d] | same ip", p_info [ playerid ] [ name ], playerid, p_info [ params [ 0 ] ] [ name ], params [ 0 ] ) ;
		foreach(new i: admin_players)SendClientMessage ( i, col_admin, scm_string ) ;

		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Невозможно передать средства данному игроку." ) ;
		return 1 ;
	}

	give_money ( playerid, -params [ 1 ] ) ;
	insert_money_log ( playerid, params [ 0 ], -params [ 1 ], "команда /pay" ) ;

	give_money ( params [ 0 ], params [ 1 ] ) ;
	insert_money_log ( params [ 0 ], playerid, params [ 1 ], "команда /pay" ) ;

	give_event_progress ( playerid, BUY_PAY_FRIEND, params [ 1 ] ) ;

	new scm_string [ 128 ] ;
	format ( scm_string, sizeof ( scm_string ), "{"#cGInfo"}* {"#cWH"}%s передал вам {"#cGN"}%s"valute_title"{"#cWH"}.", p_info [ playerid ] [ name ], GetPlayerCashValueToSmile ( params [ 1 ] ) ) ;
	SendClientMessage ( params [ 0 ], col_white, scm_string ) ;

	format ( scm_string, sizeof ( scm_string ), "{"#cGInfo"}* {"#cWH"}Вы передали игроку %s {"#cGN"}%s"valute_title"{"#cWH"}.", p_info [ params [ 0 ] ] [ name ], GetPlayerCashValueToSmile ( params [ 1 ] ) ) ;
	SendClientMessage ( playerid, col_white, scm_string ) ;

	format ( scm_string, sizeof ( scm_string ), "достал(а) деньги и передал(а) их %s", p_info [ params [ 0 ] ] [ name ] ) ;
	me_action ( playerid, scm_string ) ;
	return true ;
}

CMD:createarea ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 8 ) return 1 ;
	if ( ! IsFounder ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}К сожалению, Вам данная функция не доступна." ) ;
	GetPlayerFacingAngle ( playerid, p_t_info [ playerid ] [ p_pos ] [ 3 ] ) ;
	for ( new i = 0 ; i < 4 ; i ++ )
	{
		new pvar_string [ 28 ];
		format ( pvar_string, sizeof ( pvar_string  ), "area_pos_%d", i ) ;
		SetPVarFloat ( playerid, pvar_string, p_t_info [ playerid ] [ p_pos ] [ i ] ) ;
	}
	SendClientMessage ( playerid, col_lblue, !"Переходите к следующему этапу создания (( /endarea ))" ) ;
	return true ;
}

CMD:endarea ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 8 ) return 1 ;
	if ( ! IsFounder ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}К сожалению, Вам данная функция не доступна." ) ;
	if ( area_tp_amount >= sizeof ( area_tp_info ) ) return SendClientMessage ( playerid, col_white, !"Ошибка создания телепорта. Выход за пределы area_tp_info." ) ;
	if ( sscanf(params, "dddds[32]", params [ 0 ], params [ 1 ], params [ 2 ], params [ 3 ], params [ 4 ] ) ) return SendClientMessage ( playerid, col_gray, !"Используйте: /endarea [virtual_world] [interior] [to_vw] [to_int] [название]" ) ;
	GetPlayerFacingAngle ( playerid, p_t_info [ playerid ] [ p_pos ] [ 3 ] ) ;
	area_tp_amount ++;
	area_tp_info [ area_tp_amount - 1 ] [ a_id ] = area_tp_amount ;
	for ( new i = 0 ; i < 4 ; i ++ )
	{
		new pvar_string [ 28 ];
		format ( pvar_string, sizeof ( pvar_string  ), "area_pos_%d", i ) ;
		area_tp_info [ area_tp_amount - 1 ] [ a_pos ] [ i ] = GetPVarFloat ( playerid, pvar_string ) ;
		DeletePVar ( playerid, pvar_string ) ;
		area_tp_info [ area_tp_amount - 1 ] [ a_to_pos ] [ i ] = p_t_info [ playerid ] [ p_pos ] [ i ] ;
	}

	area_tp_info [ area_tp_amount - 1 ] [ a_pick ] = 1318 ;
	area_tp_info [ area_tp_amount - 1 ] [ a_virt_world ] [ 0 ] = params [ 0 ] ;
	area_tp_info [ area_tp_amount - 1 ] [ a_virt_world ] [ 1 ] = params [ 2 ] ;

	area_tp_info [ area_tp_amount - 1 ] [ a_interior ] [ 0 ] = params [ 1 ] ;
	area_tp_info [ area_tp_amount - 1 ] [ a_interior ] [ 1 ] = params [ 3 ] ;

	format ( area_tp_info [ area_tp_amount - 1 ] [ a_name ], 32, "%s", params [ 4 ] ) ;

	area_tp_info [ area_tp_amount - 1 ] [ a_area ] [ 0 ] = CreateDynamicPickup ( 1318, 23, area_tp_info [ area_tp_amount - 1 ] [ a_pos ] [ 0  ], area_tp_info [ area_tp_amount - 1 ] [ a_pos ] [ 1  ], area_tp_info [ area_tp_amount - 1 ] [ a_pos ] [ 2  ], area_tp_info [ area_tp_amount - 1 ] [ a_virt_world ] [ 0 ] ) ;
	area_tp_info [ area_tp_amount - 1 ] [ a_area ] [ 1 ] = CreateDynamicPickup ( 1318, 23, area_tp_info [ area_tp_amount - 1 ] [ a_to_pos ] [ 0  ], area_tp_info [ area_tp_amount - 1 ] [ a_to_pos ] [ 1  ], area_tp_info [ area_tp_amount - 1 ] [ a_to_pos ] [ 2  ], area_tp_info [ area_tp_amount - 1 ] [ a_virt_world ] [ 1 ] ) ;

	pick_info [ area_tp_info [ area_tp_amount - 1 ] [ a_area ] [ 0 ] ] [ pick_type ] = pick_type_teleportation ;
	pick_info [ area_tp_info [ area_tp_amount - 1 ] [ a_area ] [ 0 ] ] [ pick_item ] = area_tp_amount ;

	pick_info [ area_tp_info [ area_tp_amount - 1 ] [ a_area ] [ 1 ] ] [ pick_type ] = pick_type_teleportation ;
	pick_info [ area_tp_info [ area_tp_amount - 1 ] [ a_area ] [ 1 ] ] [ pick_item ] = area_tp_amount ;

 	new insert_string [ 512 ] ;
	format ( insert_string, sizeof insert_string, "INSERT INTO `teleport_areas` ( `area_x`, `area_y`, `area_z`, `area_c`, `area_to_x`, `area_to_y`, `area_to_z`, `area_to_c`, `area_virtual_world`, `area_to_virtual_world`, `area_interior`, `area_to_interior`, `area_name` ) VALUES ( '%f', '%f', '%f', '%f', '%f', '%f', '%f', '%f', '%d', '%d', '%d', '%d', '%s')",
	area_tp_info [ area_tp_amount - 1 ] [ a_pos ] [ 0  ], area_tp_info [ area_tp_amount - 1 ] [ a_pos ] [ 1  ], area_tp_info [ area_tp_amount - 1 ] [ a_pos ] [ 2  ], area_tp_info [ area_tp_amount - 1 ] [ a_pos ] [ 3  ],
	area_tp_info [ area_tp_amount - 1 ] [ a_to_pos ] [ 0  ], area_tp_info [ area_tp_amount - 1 ] [ a_to_pos ] [ 1  ], area_tp_info [ area_tp_amount - 1 ] [ a_to_pos ] [ 2  ], area_tp_info [ area_tp_amount - 1 ] [ a_to_pos ] [ 3  ],
	params [ 0  ], params [ 2  ], params [ 1  ], params [ 3 ], params [ 4 ] ) ;
	mysql_tquery ( sql_connection, insert_string, "", "" ) ;

	SendClientMessage ( playerid, col_lblue, !"Динамический вход успешно создан." ) ;
	return true ;
}

CMD:gotohint ( playerid )
{
	if ( admin_info [ playerid ] [ admin ] < 8 )return 1 ;

    new String [ 150 ] ;
	global_string [ 0 ] = EOS ;
	strcat ( global_string, "{"#cBL"}ID\t{"#cBL"}Класс:\t{"#cBL"}Интерьер:\t{"#cBL"}Название:\n") ;

	for ( new i = 0 ; i < HINTS_COUNT ; i ++ )
	{
	    format ( String, sizeof String, "%d\t%s\t%d\t%s\n", i + 1, house_classes [ house_int [ i ] [ hint_class ] ], house_int [ i ] [ hint_int ], house_int [ i ] [ hint_description ] ) ;
        strcat ( global_string, String ) ;
	}
	show_dialog ( playerid, d_gotohint, DIALOG_STYLE_TABLIST_HEADERS, "{"#cBL"}Интерьеры домов", global_string, "Выбрать", "Закрыть" ) ;
	return 1 ;
}

CMD:createhouse ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 8 )return 1 ;
	if ( ! IsFounder ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}К сожалению, Вам данная функция не доступна." ) ;
	if ( sscanf ( params, "dddd", params [ 0 ], params [ 1 ], params [ 2 ] ) )
	{
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /createhouse [инт (/gotohint)] [цена] ["family_title"]" ) ;
	}
	if ( params [ 0 ] < 1 || params [ 0 ] > HINTS_COUNT ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы указали не верный ID интерьера." ) ;
	if ( params [ 1 ] < 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Цена дома не может быть меньше 1"valute_title"." ) ;
	if ( params [ 2 ] < 0 || params [ 2 ] > 50000 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Не может быть меньше 0 и более 50.000 "family_title"." ) ;
	GetPlayerPos ( playerid, h_info [ house_count ] [ h_pos ] [ 0 ], h_info [ house_count ] [ h_pos ] [ 1 ], h_info [ house_count ] [ h_pos ] [ 2 ] ) ;
	GetPlayerFacingAngle ( playerid, h_info [ house_count ] [ h_pos ] [ 3 ] ) ;

	h_info [ house_count ] [ h_id ] = house_count + 1 ;
	strcat ( h_info [ house_count ] [ h_owner_name ], "Собственность штата" ) ;
	h_info [ house_count ] [ h_owner ] = -1 ;
	h_info [ house_count ] [ h_price ] = params [ 1 ] ;
	h_info [ house_count ] [ h_int ] = params [ 0 ] ;
	h_info [ house_count ] [ h_vw ] = p_t_info [ playerid ] [ p_data ] [ 1 ] ;

	h_info [ house_count ] [ h_price_ticket ] = params [ 2 ] ;

	new query_string [ 255 ] ;
	format ( query_string, 144, "Вы успешно создали недвижимость | Дом №%d.", h_info [ house_count ] [ h_id ] ) ;
	SendClientMessage ( playerid, col_white, query_string ) ;

	mysql_format ( sql_connection, query_string, sizeof ( query_string  ),"INSERT INTO `houses` (`h_id`,`h_pos_x`,`h_pos_y`,`h_pos_z`,`h_pos_c`,`h_price`,`h_vw`,`h_int`,`h_garage`,`h_price_ticket`) VALUES ('%d','%f','%f','%f','%f','%d','%d','%d','0','%d')",
	h_info [ house_count ] [ h_id ], h_info [ house_count ] [ h_pos ] [ 0 ], h_info [ house_count ] [ h_pos ] [ 1 ], h_info [ house_count ] [ h_pos ] [ 2 ], h_info [ house_count ] [ h_pos ] [ 3 ],
	params [ 1 ], h_info [ house_count ] [ h_vw ], params [ 0 ], h_info [ house_count ] [ h_price_ticket ] ) ;
	mysql_query ( sql_connection, query_string, false ) ;

	house_count ++ ;

	mysql_tquery ( sql_connection, !"SELECT * FROM `houses` ORDER BY `houses`.`h_id` ASC", "houses_loading" ) ;
	return 1 ;
}

CMD:createcellar ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 8 )return 1 ;
	if ( ! IsFounder ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}К сожалению, Вам данная функция не доступна." ) ;
	if ( sscanf ( params, "d", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /createcellar [цена]" ) ;
	if ( params [ 1 ] < 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Цена гаража не может быть меньше 1"valute_title"." ) ;
	GetPlayerPos ( playerid, cellar_info [ cellar_count ] [ cl_pos ] [ 0 ], cellar_info [ cellar_count ] [ cl_pos ] [ 1 ], cellar_info [ cellar_count ] [ cl_pos ] [ 2 ] ) ;
	GetPlayerFacingAngle ( playerid, cellar_info [ cellar_count ] [ cl_pos ] [ 3 ] ) ;

	cellar_info [ cellar_count ] [ cl_id ] = cellar_count + 1 ;
	strcat ( cellar_info [ cellar_count ] [ cl_owner_name ], "Собственность штата" ) ;
	cellar_info [ cellar_count ] [ cl_owner ] = -1 ;
	cellar_info [ cellar_count ] [ cl_price ] = params [ 0 ] ;

	cellar_info [ cellar_count ] [ cl_pickup ] = CreateDynamicPickup ( 1239, 23, cellar_info [ cellar_count ] [ cl_pos ] [ 0 ], cellar_info [ cellar_count ] [ cl_pos ] [ 1 ], cellar_info [ cellar_count ] [ cl_pos ] [ 2 ], 0, -1 ) ;

	pick_info [ cellar_info [ cellar_count ] [ cl_pickup ] ] [ pick_type ] = pick_type_clentrance ;
	pick_info [ cellar_info [ cellar_count ] [ cl_pickup ] ] [ pick_item ] = cellar_info [ cellar_count ] [ cl_id ] ;

	new label_string [ 228 ], query_string [ 246 ] ;
	format ( label_string, sizeof ( label_string  ), "** Гараж **\n{"#cGR3D"}Номер гаража: {"#cWH3D"}%d\n\n{"#cWH3D"}Посигнальте{"#cGR3D"}, чтобы заехать", cellar_info [ cellar_count ] [ cl_id ] ) ;
	cellar_info [ cellar_count ] [ cl_label ] = CreateDynamic3DTextLabel ( label_string, col_header_3d, cellar_info [ cellar_count ] [ cl_pos ] [ 0 ], cellar_info [ cellar_count ] [ cl_pos ] [ 1 ], cellar_info [ cellar_count ] [ cl_pos ] [ 2 ] + 0.7, 4.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0 ) ;

	format ( query_string, 68, "Вы успешно создали гараж | Гараж №%d.", cellar_info [ cellar_count ] [ cl_id ] ) ;
	SendClientMessage ( playerid, col_white, query_string ) ;

	mysql_format ( sql_connection, query_string, sizeof ( query_string  ),"INSERT INTO `cellars` (`cl_pos_x`,`cl_pos_y`,`cl_pos_z`,`cl_pos_c`,`cl_price`) VALUES ('%f','%f','%f','%f','%d')",
	cellar_info [ cellar_count ] [ cl_pos ] [ 0 ], cellar_info [ cellar_count ] [ cl_pos ] [ 1 ], cellar_info [ cellar_count ] [ cl_pos ] [ 2 ], cellar_info [ cellar_count ] [ cl_pos ] [ 3 ],
	params [ 0 ] ) ;
	mysql_tquery ( sql_connection, query_string, "", "" ) ;

	cellar_count ++ ;
	return 1 ;
}

CMD:hgarage ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 8 )return 1 ;
	if ( ! IsFounder ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}К сожалению, Вам данная функция не доступна." ) ;
	if ( sscanf ( params, "dd", params [ 0 ], params [ 1 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /hgarage [ид дома] [тип гаража]" ) ;

	if ( params [ 0 ] < 1 || params [ 0 ] > house_count ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Неверный id дома." ) ;
	if ( params [ 1 ] < 0 || params [ 1 ] > 4 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Статус гаража не может быть меньше 0 и более 4." ) ;

	if ( params [ 1 ] > 0 )
	{
	    if ( GetPlayerState ( playerid ) != 2 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нужно находиться в транспорте." ) ;

	    new veh_id = GetPlayerVehicleID ( playerid ) ;

		GetVehiclePos ( veh_id, h_info [ params [ 0 ] - 1 ] [ h_v_pos ] [ 0 ], h_info [ params [ 0 ] - 1 ] [ h_v_pos ] [ 1 ], h_info [ params [ 0 ] - 1 ] [ h_v_pos ] [ 2 ] ) ;
		GetVehicleZAngle ( veh_id, h_info [ params [ 0 ] - 1 ] [ h_v_pos ] [ 3 ] ) ;

	    if ( IsValidDynamicPickup ( h_info [ params [ 0 ] - 1 ] [ h_garage_pickup ] ) ) DestroyDynamicPickup ( h_info [ params [ 0 ] - 1 ] [ h_garage_pickup ] ) ;
	    if ( IsValidDynamic3DTextLabel ( h_info [ params [ 0 ] - 1 ] [ h_garage_text ] ) )
		{
			DestroyDynamic3DTextLabel ( h_info [ params [ 0 ] - 1 ] [ h_garage_text ] ) ;
			h_info [ params [ 0 ] - 1 ] [ h_garage_text ] = Text3D:INVALID_3DTEXT_ID ;
		}

	    h_info [ params [ 0 ] - 1 ] [ h_garage_pickup ] = CreateDynamicPickup ( pickupPropertyGarage, 23, h_info [ params [ 0 ] - 1 ] [ h_v_pos ] [ 0 ], h_info [ params [ 0 ] - 1 ] [ h_v_pos ] [ 1 ], h_info [ params [ 0 ] - 1 ] [ h_v_pos ] [ 2 ], -1, -1 ) ;
		pick_info [ h_info [ params [ 0 ] - 1 ] [ h_garage_pickup ] ] [ pick_type ] = pick_type_housegarage ;
		pick_info [ h_info [ params [ 0 ] - 1 ] [ h_garage_pickup ] ] [ pick_item ] = h_info [ params [ 0 ] - 1 ] [ h_id ] ;

	    h_info [ params [ 0 ] - 1 ] [ h_garage_area ] = CreateDynamicSphere ( h_info [ params [ 0 ] - 1 ] [ h_v_pos ] [ 0 ], h_info [ params [ 0 ] - 1 ] [ h_v_pos ] [ 1 ], h_info [ params [ 0 ] - 1 ] [ h_v_pos ] [ 2 ], 3.0, -1, -1, -1 ) ;
		area_info [ h_info [ params [ 0 ] - 1 ] [ h_garage_area ] ] [ a_type ] = area_type_housegarage ;
	    area_info [ h_info [ params [ 0 ] - 1 ] [ h_garage_area ] ] [ a_item ] = h_info [ params [ 0 ] - 1 ] [ h_id ] ;

		new scm_string [ 74 + 9 ] ;
		format ( scm_string, sizeof scm_string, "** Гараж №%d **\n{"#cGR3D"}Нажмите {"#cWH3D"}Y{"#cGR3D"}, чтобы заехать", params [ 0 ] ) ;
		h_info [ params [ 0 ] - 1 ] [ h_garage_text ] = CreateDynamic3DTextLabel ( scm_string, col_header_3d,
								h_info [ params [ 0 ] - 1 ] [ h_v_pos ] [ 0 ], h_info [ params [ 0 ] - 1 ] [ h_v_pos ] [ 1 ], h_info [ params [ 0 ] - 1 ] [ h_v_pos ] [ 2 ],
								4.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, -1, -1 ) ;
	}
	else
	{
	    h_info [ params [ 0 ] - 1 ] [ h_v_pos ] [ 0 ] =
		h_info [ params [ 0 ] - 1 ] [ h_v_pos ] [ 1 ] =
		h_info [ params [ 0 ] - 1 ] [ h_v_pos ] [ 2 ] =
		h_info [ params [ 0 ] - 1 ] [ h_v_pos ] [ 3 ] = 0 ;

		if ( IsValidDynamicPickup ( h_info [ params [ 0 ] - 1 ] [ h_garage_pickup ] ) ) DestroyDynamicPickup ( h_info [ params [ 0 ] - 1 ] [ h_garage_pickup ] ) ;
		if ( IsValidDynamicArea ( h_info [ params [ 0 ] - 1 ] [ h_garage_area ] ) ) DestroyDynamicArea ( h_info [ params [ 0 ] - 1 ] [ h_garage_area ] ) ;
	    if ( IsValidDynamic3DTextLabel ( h_info [ params [ 0 ] - 1 ] [ h_garage_text ] ) )
		{
			DestroyDynamic3DTextLabel ( h_info [ params [ 0 ] - 1 ] [ h_garage_text ] ) ;
			h_info [ params [ 0 ] - 1 ] [ h_garage_text ] = Text3D:INVALID_3DTEXT_ID ;
		}
	}

	h_info [ params [ 0 ] - 1 ] [ h_garage ] = params [ 1 ] ;

	new scm_string [ 154 + ( 4 * 8 ) + 9 ] ;
	format ( scm_string, 70, "Вы установили новые координаты гаража для %d дома.", params [ 0 ] ) ;
	SendClientMessage ( playerid, col_white, scm_string ) ;

	format ( scm_string, sizeof scm_string, "UPDATE `houses` SET `h_v_pos_x` = '%.2f', `h_v_pos_y` = '%.2f', `h_v_pos_z` = '%.2f',`h_v_pos_c` = '%.2f',`h_garage` = '%d' WHERE `h_id` = '%d' LIMIT 1",
	h_info [ params [ 0 ] - 1 ] [ h_v_pos ] [ 0 ], h_info [ params [ 0 ] - 1 ] [ h_v_pos ] [ 1 ], h_info [ params [ 0 ] - 1 ] [ h_v_pos ] [ 2 ],
	h_info [ params [ 0 ] - 1 ] [ h_v_pos ] [ 3 ], params [ 1 ], params [ 0 ] ) ;
	mysql_tquery ( sql_connection, scm_string ) ;

	return 1 ;
}

