		b_info [ t ] [ b_name ], GetPlayerCashValueToSmile ( b_info [ t ] [ b_money ] ), GetPlayerCashValueToSmile ( b_info [ t ] [ b_cash_limit ] ), b_info [ t ] [ b_incass ], f_info [ b_info [ t ] [ b_mafia ] - 1 ] [ f_name ], business_status, business_tax, b_info [ t ] [ b_visitors ], car_string ) ;
	}
	else if ( _b_type == bizz_type_fixcar )
	{
		new business_tax = floatround ( b_info [ t ] [ b_cash_today ] / 500 ) * for_tax [ 4 ] ;
		if ( b_info [ t ] [ b_improve ] [ 0 ] ) business_tax = floatround ( b_info [ t ] [ b_cash_today ] / 1000 ) * for_tax [ 4 ] ;

