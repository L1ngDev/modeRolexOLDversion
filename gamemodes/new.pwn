			b_rank [ business_id - 1 ] [ 0 ], b_rank [ business_id - 1 ] [ 1 ],
			b_rank [ business_id - 1 ] [ 2 ], b_rank [ business_id - 1 ] [ 3 ],
			b_rank [ business_id - 1 ] [ 4 ], b_rank [ business_id - 1 ] [ 5 ],
			b_rank [ business_id - 1 ] [ 6 ], b_rank [ business_id - 1 ] [ 7 ],
			b_rank [ business_id - 1 ] [ 8 ], b_rank [ business_id - 1 ] [ 9 ],
			b_rank [ business_id - 1 ] [ 10 ], b_rank [ business_id - 1 ] [ 11 ],
			b_info [ business_id - 1 ] [ b_id ] ) ;
			mysql_tquery ( sql_connection, global_string, "", "" ) ;
