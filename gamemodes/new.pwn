		"{"#cBL"}** %s **{"#cGRDialog"}\n\nНа счету бизнеса: {"#cWH"}%s"valute_title_" из %s"valute_title_"{"#cGRDialog"}\nИнкассация: {"#cWH"}-%d"valute_title_"{"#cGRDialog"}\nЦена за авто: {"#cWH"}%d{"#cGRDialog"}\nКонтроль: {"#cWH"}%s{"#cGRDialog"}\nСостояние: {"#cWH"}%s{"#cGRDialog"}\nНалог в сутки: {"#cWH"}%d"valute_title_"{"#cGRDialog"}\nПосетители: {"#cWH"}%d{"#cGRDialog"} человек\n\n{"#cGRDialog"}* Налог зависит от прибыли за сутки,\n{"#cGRDialog"}* поэтому он может меняться",
		b_info [ t ] [ b_name ], GetPlayerCashValueToSmile ( b_info [ t ] [ b_money ] ), GetPlayerCashValueToSmile ( b_info [ t ] [ b_cash_limit ] ), b_info [ t ] [ b_incass ], b_info [ t ] [ b_cost ], f_info [ b_info [ t ] [ b_mafia ] - 1 ] [ f_name ], business_status, business_tax, b_info [ t ] [ b_visitors ] ) ;
	}
	else if ( _b_type == bizz_type_bank )
	{
		new business_tax = floatround ( b_info [ t ] [ b_cash_today ] / 500 ) * for_tax [ 4 ] ;
		if ( b_info [ t ] [ b_improve ] [ 0 ] ) business_tax = floatround ( b_info [ t ] [ b_cash_today ] / 1000 ) * for_tax [ 4 ] ;

		new business_status [ 19 + 1 ] = "{"#cRD"}Закрыт" ;
		if ( ! b_info [ t ] [ b_close ] ) business_status = "{"#cGN"}Открыт" ;

		new car_string [ 64 * 5 ], line_string [ 64 ] ;
		strcat ( car_string, "{"#cBL"}** Транспорт **{"#cGRDialog"}\n\n" ) ;
		foreach(new v: business_vehicles[t + 1])
		{
		    format ( line_string, sizeof line_string, "%s: {"#cWH"}%d"valute_title_"{"#cGRDialog"}\n", GetVehicleNameEx ( v ), veh_info [ v - 1 ] [ v_rent_price ] ) ;
		    strcat ( car_string, line_string ) ;
		}

		format ( dialog_string, sizeof ( dialog_string ),
		"{"#cBL"}** %s **{"#cGRDialog"}\n\nНа счету бизнеса: {"#cWH"}%s"valute_title_" из %s"valute_title_"{"#cGRDialog"}\nИнкассация: {"#cWH"}-%d"valute_title_"{"#cGRDialog"}\nКомиссия за операции: {"#cWH"}%d"valute_title_"{"#cGRDialog"}\nЦена за вход: {"#cWH"}%d"valute_title_"{"#cGRDialog"}\nКонтроль: {"#cWH"}%s{"#cGRDialog"}\nСостояние: {"#cWH"}%s{"#cGRDialog"}\nНалог в сутки: {"#cWH"}%d"valute_title_"{"#cGRDialog"}\nПосетители: {"#cWH"}%d{"#cGRDialog"} человек\n\n%s\n\n{"#cGRDialog"}* Налог зависит от прибыли за сутки,\n{"#cGRDialog"}* поэтому он может меняться",
		b_info [ t ] [ b_name ], GetPlayerCashValueToSmile ( b_info [ t ] [ b_money ] ), GetPlayerCashValueToSmile ( b_info [ t ] [ b_cash_limit ] ), b_info [ t ] [ b_incass ], b_info [ t ] [ b_cost ], b_info [ t ] [ b_fee ], f_info [ b_info [ t ] [ b_mafia ] - 1 ] [ f_name ], business_status, business_tax, b_info [ t ] [ b_visitors ], car_string ) ;
	}
	else if ( _b_type == bizz_type_food )
	{
		new business_tax = floatround ( b_info [ t ] [ b_cash_today ] / 500 ) * for_tax [ 4 ] ;
		if ( b_info [ t ] [ b_improve ] [ 0 ] ) business_tax = floatround ( b_info [ t ] [ b_cash_today ] / 1000 ) * for_tax [ 4 ] ;

