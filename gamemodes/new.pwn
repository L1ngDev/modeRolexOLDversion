						show_dialog ( playerid, d_safe_guns, DIALOG_STYLE_LIST, "{"#cBHD"}Оружие в сейфе:", string, "Выбрать", "Назад" ) ;
					}
					case 5:
					{
						if ( p_info [ playerid ] [ house ] != GetPVarInt ( playerid, "house_id" ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Код от сейфа может изменить только владелец дома." ) ;
						show_dialog ( playerid, d_safe_changepin, DIALOG_STYLE_INPUT, "{"#cBHD"}Cменить пароль", "{ffffff}Введите новый пароль для сейфа:", "Принять", "Закрыть" ) ;
					}*/
				}
			}
			return 1 ;
		}
		case d_safe_changepin:
		{
		    if ( ! response )
			{
		 		//show_dialog ( playerid, d_safe_access, DIALOG_STYLE_LIST, "{"#cBHD"}Сейф", "Взять деньги\nПоложить деньги\nВзять наркотики\nПоложить наркотики\nОружие\n{"#cLY"}Сменить пин-код", "Выбрать", "Закрыть" ) ;
                show_dialog ( playerid, d_safe_access, DIALOG_STYLE_LIST, "{"#cBHD"}Сейф", "Взять деньги\nПоложить деньги\n\n{"#cLY"}Сменить пин-код", "Выбрать", "Закрыть" ) ;
                return 1 ;
			}
			new h = GetPVarInt ( playerid, "house_id" ) - 1, _value = strval ( inputtext ) ;
			if ( _value < 1000 || _value > 9999 )
			{
				return show_dialog ( playerid, d_safe_changepin, DIALOG_STYLE_INPUT, "{"#cBHD"}Cменить пароль", "{ffffff}Введите новый пароль для сейфа.\n\n{"#cGRDialog"}* Пин-код не может начинаться с 0\n{"#cGRDialog"}* Пароль должен содержать 4 символа.", "Принять", "Закрыть" ) ;
			}
            h_info [ h ] [ h_safe_code ] = _value ;

            new query [ 128 ] ;
			format ( query, sizeof query, "UPDATE `houses` SET `h_safe_code` = '%d' WHERE `h_id` = '%d' LIMIT 1", h_info [ h ] [ h_safe_code ], h_info [ h ] [ h_id ] ) ;
			mysql_tquery ( sql_connection, query ) ;

			format ( query, sizeof query, "{"#cGInfo"}* {"#cWH"}Новый пин-код установлен | {"#cGN"}%d", _value ) ;
			SendClientMessage ( playerid, col_white, query ) ;
			//show_dialog ( playerid, d_safe_access, DIALOG_STYLE_LIST, "{"#cBHD"}Сейф", "Взять деньги\nПоложить деньги\nВзять наркотики\nПоложить наркотики\nОружие\n{"#cLY"}Сменить пин-код", "Выбрать", "Закрыть" ) ;
			show_dialog ( playerid, d_safe_access, DIALOG_STYLE_LIST, "{"#cBHD"}Сейф", "Взять деньги\nПоложить деньги\n\n{"#cLY"}Сменить пин-код", "Выбрать", "Закрыть" ) ;
			return 1 ;
		}
		case d_safe_guns:
		{
			if ( ! response ) return show_dialog ( playerid, d_safe_access, DIALOG_STYLE_LIST, "{"#cBHD"}Сейф", "Взять деньги\nПоложить деньги\nВзять наркотики\nПоложить наркотики\nОружие\n{"#cLY"}Сменить пин-код", "Выбрать", "Закрыть" ) ;
			new house_id = GetPVarInt ( playerid, "house_id" ) - 1 ;
			SetPVarInt ( playerid, "listitem", listitem ) ;
			new weaponid = GetPlayerWeapon ( playerid ) ;
			if ( h_info [ house_id ] [ h_safe_guns ] [ listitem ] == 0 )
			{
				if ( ! weaponid )
				{
					new string [ 198 ] ;
					new h = GetPVarInt ( playerid, "house_id" ) - 1 ;
					for ( new i = 0 ; i < 3 ; i ++ )
					{
						new str [ 98 ], gunname [ 32 ] ;
						if ( h_info [ h ] [ h_safe_guns ] [ i ] > 38 || h_info [ h ] [ h_safe_guns ] [ i ] < 1 || h_info [ h ] [ h_safe_guns ] [ i + 3 ] == 0 )strcat ( string, "{"#cGRDialog"}- Пусто\n" ) ;
						else
						{
							GetWeaponName ( h_info [ h ] [ h_safe_guns ] [ i ], gunname, 32 ) ;
							format ( str, sizeof str, "{"#cWH"}Оружие: {"#cBL"}%s{"#cWH"}   |   {"#cBL"}%d пт.\n", gunname, h_info [ h ] [ h_safe_guns ] [ i + 3 ] ) ;
							strcat ( string, str ) ;
						}
					}
					show_dialog ( playerid, d_safe_guns, DIALOG_STYLE_LIST, "{"#cBHD"}Оружие в сейфе:", string, "Выбрать", "Назад" ) ;
					return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Возьмите в руку оружие которое хотите положить в сейф.") ;
				}
				new string [ 110 + 9 ] ;
				format ( string, sizeof string, "{FFFFFF}В сейфе {"#cBL"}%d{FFFFFF} патронов.\n\n{"#cGRDialog"}* Введи количество, которое желаете положить:", h_info [ house_id ] [ h_safe_guns ] [ listitem + 3 ]) ;
				show_dialog ( playerid, d_safe_guns_put, DIALOG_STYLE_INPUT, "{"#cBHD"}Положить оружие", string, "Принять", "Назад" ) ;
				return false ;
			}
			if ( weaponid == h_info [ house_id ] [ h_safe_guns ] [ listitem ] )
