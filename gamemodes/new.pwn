stock usersInventoryLoading ( playerid )
{
    InventoryLoading ( p_info [ playerid ] [ id ], playerid, SUB_INVENTORY, 1 ) ;

	new sql_string [ 580 ] ;
	format ( sql_string, sizeof sql_string, "\
		SELECT \
			ua.*, \
			uaf.*, \
			IFNULL(uaf.id, 0) AS uaf_id, \
			uas.*, \
			IFNULL(uas.id, 0) AS uas_id, \
			IFNULL(ln.number, 0) AS sim_number \
		FROM users_accessories ua \
		LEFT JOIN users_accessories_float uaf ON uaf.id = ua.id \
		LEFT JOIN users_accessories_stats uas ON uas.id = ua.id \
		LEFT JOIN licence_number ln ON ln.id = ua.acs_other_id \
		WHERE ua.u_id = %d LIMIT %d", p_info [ playerid ] [ id ], MAX_ACCESORIES ) ;
	mysql_tquery ( sql_connection, sql_string, "callback_users_accessories", "i", playerid ) ;

	sql_string [ 0 ] = EOS ;
	format ( sql_string, 256, "\
		SELECT \
			uc.*, \
			us.u_name \
		FROM users_contacts uc \
		LEFT JOIN users us ON us.u_id = uc.u_id \
		WHERE uc.u_id = '%d' LIMIT %d", p_info [ playerid ] [ id ], MAX_CONTACTS ) ;
	mysql_tquery ( sql_connection, sql_string, "loaded_player_contacts", "i", playerid ) ;

	#if defined m_fishing
		FishPlayerInit ( playerid ) ;
	#endif
	return 1 ;
}

