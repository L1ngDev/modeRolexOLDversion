new bool: conf_td_status_bool [ MAX_PLAYERS ] ;
new PlayerText: conf_ptd [ MAX_PLAYERS ] ;
stock show_conf_ptd ( playerid, bool: status )
{
	if ( status )
	{
		conf_ptd [ playerid ] = CreatePlayerTextDraw(playerid, 320.000000, 90.000000, "~r~600");
		PlayerTextDrawAlignment(playerid, conf_ptd [ playerid ], 2);
		PlayerTextDrawBackgroundColor(playerid, conf_ptd [ playerid ], 255);
		PlayerTextDrawFont(playerid, conf_ptd [ playerid ], 3);
		PlayerTextDrawLetterSize(playerid, conf_ptd [ playerid ], 0.889998, 3.299998);
		PlayerTextDrawColor(playerid, conf_ptd [ playerid ], -1);
		PlayerTextDrawSetOutline(playerid, conf_ptd [ playerid ], 1);
		PlayerTextDrawSetProportional(playerid, conf_ptd [ playerid ], 0);

		PlayerTextDrawShow ( playerid, conf_ptd [ playerid ] ) ;
	}
	else
	{
		PlayerTextDrawDestroy ( playerid, conf_ptd [ playerid ] ) ;
		PlayerTextDrawHide ( playerid, conf_ptd [ playerid ] ) ;
	}
	return 1 ;
}

