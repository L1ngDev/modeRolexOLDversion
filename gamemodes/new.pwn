CMD:bizlist ( playerid )
{
    if ( ! mafia_player ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команда доступна только мафиям." ) ;

	mafiaBusinessList ( playerid, 0 ) ;
	return 1 ;
}

stock mafiaBusinessList ( playerid, page )
{
	new all_business = 0,
		count_mafia = 0,
		count_business = 0 ;

	page_count [ playerid ] = page ;

	global_string [ 0 ] = EOS ;
	strcat ( global_string, "{"#cBL"}ID. Название:\t{"#cBL"}Заработано:\t{"#cBL"}Тип бизнеса:\n" ) ;
  	for ( new b = 0 ; b < b_count ; b ++ )
	{
		if ( b_info [ b ] [ b_mafia ] != p_info [ playerid ] [ member ] ) continue ;

		all_business ++ ;

		if ( page * 20 > all_business ) continue ;
  		if ( count_business > ( page + 1 ) * 20 ) continue ;

  		set_player_listitem_values ( playerid, count_mafia, b ) ;

		count_mafia ++ ;
  		count_business ++ ;

		new _mafia_money = floatround ( ( b_info [ b ] [ b_cash_today ] / 20 ) * 100 ) ;
		format ( global_string, sizeof ( global_string ), "%s{"#cBL"}%i. {"#cWH"}%s\t{"#cGN"}%s"valute_title_"{"#cWH"}\t%s\n", global_string, count_business, b_info [ b ] [ b_name ], GetPlayerCashValueToSmile ( _mafia_money ), b_types [ b_info [ b ] [ b_type ] ] ) ;
	}

	if ( page > 0 ) strcat ( global_string, "{"#cBL"}Предыдущая страница\n" ) ;
	if ( all_business > ( page + 1 ) * 20 ) strcat ( global_string, "{"#cBL"}Следующая страница" ) ;

	static const _str [ ] = "{"#cBHD"}Бизнесы мафии ({"#cWH"}%d {"#cBHD"}из {"#cWH"}%d{"#cBHD"})" ;
	new header_string [ sizeof _str + ( 9 * 2 ) ] ;
	format ( header_string, sizeof header_string, _str, all_business, b_count ) ;
	show_dialog ( playerid, d_mw_list, DIALOG_STYLE_TABLIST_HEADERS, header_string, global_string, "Выбрать", "Закрыть" ) ;
    return true ;
}

CMD:end_cover ( playerid )
{
    if ( is_fraction_cover { playerid } != 7 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не в режиме маскировки." ) ;
    if ( is_fraction_cover { playerid } != 0 )
    {
        Iter_Remove(fraction_players[p_info [ playerid ] [ member ]], playerid);

        p_info [ playerid ] [ org_skin ] = is_fraction_cover_skin [ playerid ] ;

        p_info [ playerid ] [ member ] = is_fraction_cover { playerid } ;
        p_info [ playerid ] [ rank ] = is_fraction_cover_rank { playerid } ;

        SetPlayerName ( playerid, is_fraction_cover_real_name [ playerid ] ) ;
		GetPlayerName ( playerid, p_info [ playerid ] [ name ], MAX_PLAYER_NAME ) ;

        SetPlayerSkin ( playerid, p_info [ playerid ] [ org_skin ] ) ;
		SetPlayerColor ( playerid, f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_radar_color ] ) ;

        is_fraction_cover_skin [ playerid ] = 0 ;

        is_fraction_cover { playerid } =
        is_fraction_cover_rank { playerid } = 0 ;

		static const _str [ ] = "UPDATE `fractions_players` SET `u_org_skin` = '%d', `u_member` = '%d', `u_rank` = '%d', `u_cover_skin` = '0', `u_fraction_cover` = '0', `u_fraction_cover_rank` = '0' WHERE `u_sql_id` = '%d' LIMIT 1" ;
		new sql_string [ sizeof _str + ( 3 * 4 ) + 9 ] ;
		format ( sql_string, sizeof sql_string, _str,
		p_info [ playerid ] [ org_skin ], p_info [ playerid ] [ member ], p_info [ playerid ] [ rank ], p_info [ playerid ] [ id ] ) ;
		mysql_tquery ( sql_connection, sql_string ) ;

        is_fraction_duty { playerid } = 1 ;
        fraction_duty ( playerid ) ;

		SendClientMessage ( playerid, col_gray, !"{"#cGInfo"}* {"#cGRInfo"}Вы успешно вышли из режима маскировки." ) ;
        return 1 ;
    }
	return 1 ;
}

callback: callback_fbi_cover ( playerid, _cover_name [ ] )
{
    new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( rows )
	{
	    SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нельзя использовать уже существующий NickName для слежки." ) ;
	    show_cover ( playerid ) ;
	    return 1 ;
	}

    format ( cover_name [ GetPVarInt ( playerid, "cover_id" ) ], 32, "%s", _cover_name ) ;

	show_cover ( playerid ) ;
	return 1 ;
}

CMD:cover ( playerid, params [ ] )
{
    if ( ! fbi_player ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команда доступна только для сотрудников спец. служб." ) ;
	if ( ! is_fraction_duty { playerid } ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Не начат рабочий день." ) ;
    if ( p_info [ playerid ] [ rank ] < f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 1 ] )
    {
	    static const _str [ ] = "{"#cRInfo"}* {"#cGRInfo"}Команда доступна с ранга %s (%d)." ;
	    new scm_string [ sizeof _str + 30 + 3 ] ;
	    format ( scm_string, sizeof scm_string, _str, f_rank [ p_info [ playerid ] [ member ] - 1 ] [ f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 1 ] - 1 ], f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 1 ] ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
		return 1 ;
	}
    if ( sscanf ( params, "u", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /cover [ид/имя]" ) ;
    if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете выдать данному игроку маскировку." ) ;
	if ( ! fbi_player ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете выдать данному игроку маскировку." ) ;
	if ( p_info [ params [ 0 ] ] [ leader ] > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете выдать данному игроку маскировку." ) ;
	if ( is_fraction_cover { params [ 0 ] } )
    {
        Iter_Remove(fraction_players[p_info [ params [ 0 ] ] [ member ]], params [ 0 ]);

        p_info [ params [ 0 ] ] [ org_skin ] = is_fraction_cover_skin [ params [ 0 ] ] ;

        p_info [ params [ 0 ] ] [ member ] = is_fraction_cover { params [ 0 ] } ;
        p_info [ params [ 0 ] ] [ rank ] = is_fraction_cover_rank { params [ 0 ] } ;

        SetPlayerName ( params [ 0 ], is_fraction_cover_real_name [ params [ 0 ] ] ) ;
		GetPlayerName ( params [ 0 ], p_info [ params [ 0 ] ] [ name ], MAX_PLAYER_NAME ) ;

        SetPlayerSkin ( params [ 0 ], p_info [ params [ 0 ] ] [ org_skin ] ) ;
		SetPlayerColor ( params [ 0 ], f_info [ p_info [ params [ 0 ] ] [ member ] - 1 ] [ f_radar_color ] ) ;

        is_fraction_cover_skin [ params [ 0 ] ] = 0 ;

        is_fraction_cover { params [ 0 ] } =
        is_fraction_cover_rank { params [ 0 ] } = 0 ;

		static const _str [ ] = "UPDATE `fractions_players` SET `u_org_skin` = '%d', `u_member` = '%d', `u_rank` = '%d', `u_cover_skin` = '0', `u_fraction_cover` = '0', `u_fraction_cover_rank` = '0' WHERE `u_sql_id` = '%d' LIMIT 1" ;
        new sql_string [ sizeof _str + ( 3 * 4 ) + 9 ] ;
		format ( sql_string, sizeof sql_string, _str,
		p_info [ params [ 0 ] ] [ org_skin ], p_info [ params [ 0 ] ] [ member ], p_info [ params [ 0 ] ] [ rank ], p_info [ params [ 0 ] ] [ id ] ) ;
		mysql_tquery ( sql_connection, sql_string ) ;

        is_fraction_duty { params [ 0 ] } = 1 ;
        fraction_duty ( params [ 0 ] ) ;

		SendClientMessage ( params [ 0 ], col_gray, !"{"#cGInfo"}* {"#cGRInfo"}Вас вывели из режима маскировки." ) ;
		SendClientMessage ( playerid, col_gray, !"{"#cGInfo"}* {"#cGRInfo"}Вы успешно вывели игрока из режима маскировки." ) ;
        return 1 ;
    }

    cover_fraction [ playerid ] =
	cover_rank [ playerid ] = 0 ;
	format ( cover_name [ playerid ], MAX_PLAYER_NAME, "None" ) ;

    cover_fraction [ params [ 0 ] ] =
	cover_rank [ params [ 0 ] ] = 0 ;
	format ( cover_name [ params [ 0 ] ], MAX_PLAYER_NAME, "None" ) ;

    SetPVarInt ( playerid, "cover_id", params [ 0 ] ) ;
    show_cover ( playerid ) ;
    return 1 ;
}

stock show_cover ( playerid )
{
	new _player_id = GetPVarInt ( playerid, "cover_id" ) ;
	if ( ! IsPlayerConnected ( _player_id ) || p_info [ _player_id ] [ member ] != p_info [ playerid ] [ member ] )
	{
	    SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок покинул игру." ) ;
	    DeletePVar ( playerid, "cover_id" ) ;
	    return 1 ;
	}

    new _cover_name [ 32 ] ;
    if ( GetString ( cover_name [ _player_id ], "None" ) ) format ( _cover_name, sizeof _cover_name, "Неизвестно" ) ;
    else format ( _cover_name, sizeof _cover_name, "%s", cover_name [ _player_id ] ) ;

    new _cover_fraction [ 32 ] ;
    if ( ! cover_fraction [ _player_id ] ) format ( _cover_fraction, sizeof _cover_fraction, "Неизвестно" ) ;
    else format ( _cover_fraction, sizeof _cover_fraction, "%s", f_info [ cover_fraction [ _player_id ] - 1 ] [ f_name ] ) ;

    new _cover_rank [ 32 ] ;
    if ( ! cover_rank [ _player_id ] || ! cover_fraction [ _player_id ] ) format ( _cover_rank, sizeof _cover_rank, "Неизвестно" ) ;
    else format ( _cover_rank, sizeof _cover_rank, "%s", f_rank [ cover_fraction [ _player_id ] - 1 ] [ cover_rank [ _player_id ] - 1 ] ) ;

    global_string [ 0 ] = EOS ;
    if ( ! cover_rank [ _player_id ] || ! cover_fraction [ _player_id ] ) format ( global_string, 512, "{"#cGRDialog"}Агент: {"#cWH"}%s\n{"#cBL"}1. {"#cWH"}Поддельное имя: {"#cBL"}%s\n{"#cBL"}2. {"#cWH"}Организация: {"#cBL"}%s\n{"#cBL"}3. {"#cWH"}Должность: {"#cBL"}%s\n{"#cRD"}Замаскировать", p_info [ _player_id ] [ name ], _cover_name, _cover_fraction, _cover_rank ) ;
    else format ( global_string, 512, "{"#cGRDialog"}Агент: {"#cWH"}%s\n{"#cBL"}1. {"#cWH"}Поддельное имя: {"#cBL"}%s\n{"#cBL"}2. {"#cWH"}Организация: {"#cBL"}%s\n{"#cBL"}3. {"#cWH"}Должность: {"#cBL"}%s\n{"#cBL"}Замаскировать", p_info [ _player_id ] [ name ], _cover_name, _cover_fraction, _cover_rank ) ;
    show_dialog ( playerid, d_fbi_cover, DIALOG_STYLE_LIST, "{"#cBHD"}Маскировка", global_string, "Выбрать", "Закрыть" ) ;
	return 1 ;
}

CMD:newveh ( playerid, params [ ] )
{
    if ( admin_info [ playerid ] [ admin ] < 6 )return 1 ;
	if ( GetPlayerState ( playerid ) == PLAYER_STATE_DRIVER ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы уже за рулём." ) ;
	if ( sscanf ( params, "ddd", params [ 0 ], params [ 1 ], params [ 2 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /newveh [ид авто] [цвет 1] [цвет 2]" ) ;
	if ( admin_info [ playerid ] [ dostup ] [ 1 ] != 1 && admin_info [ playerid ] [ admin ] < 7 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет доступа к данной команде. Используйте /donate." ) ;

	if ( admin_info [ playerid ] [ admin ] < 8 )
	{
    	if ( params [ 0 ] == 406 || params [ 0 ] == 520 || params [ 0 ] == 449 || params [ 0 ] == 450 || params [ 0 ] == 537 || params [ 0 ] == 538 || params [ 0 ] == 569 || params [ 0 ] == 570 || params [ 0 ] == 590 || params [ 0 ] == 425 || params [ 0 ] == 432 ) return 1 ;
	}

    if ( ! getValidReplacableModel ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /newveh [ид авто] [цвет 1] [цвет 2]" ) ;
	if ( params [ 1 ] < 0 || params [ 1 ] > 255 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /newveh [ид авто] [цвет 1] [цвет 2]" ) ;
	if ( params [ 2 ] < 0 || params [ 2 ] > 255 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /newveh [ид авто] [цвет 1] [цвет 2]" ) ;
	new Float:player_pos [ 4 ], adm_veh ;
	GetPlayerPos ( playerid, player_pos [ 0 ], player_pos [ 1 ], player_pos [ 2 ] ) ;
	GetPlayerFacingAngle ( playerid, player_pos [ 3 ] ) ;
	if ( params [ 0 ] == 537 || params [ 0 ] == 538 ) adm_veh = AddStaticVehicleEx ( params [ 0 ], player_pos [ 0 ], player_pos [ 1 ], player_pos [ 2 ], player_pos [ 3 ], params [ 1 ], params [ 2 ], -1) ;
	else adm_veh = CreateVehicle ( params [ 0 ], player_pos [ 0 ], player_pos [ 1 ], player_pos [ 2 ], player_pos [ 3 ], params [ 1 ], params [ 2 ], -1) ;

    new engine, lights, alarm, doors, bonnet, boot, objective ;
 	veh_info [ adm_veh - 1 ] [ v_locked ] = false ;
	GetVehicleParamsEx ( adm_veh, engine, lights, alarm, doors, bonnet, boot, objective ) ;
	SetVehicleParamsEx ( adm_veh, engine, lights, alarm, false, bonnet, boot, objective ) ;

	veh_info [ adm_veh - 1 ] [ v_pos ] [ 0 ] = player_pos [ 0 ] ;
	veh_info [ adm_veh - 1 ] [ v_pos ] [ 1 ] = player_pos [ 1 ] ;
	veh_info [ adm_veh - 1 ] [ v_pos ] [ 2 ] = player_pos [ 2 ] ;

    veh_info [ adm_veh - 1 ] [ v_admin ] = true ;

	veh_info [ adm_veh - 1 ] [ v_fuel ] = 60.0 ;

	LinkVehicleToInterior ( adm_veh, p_t_info [ playerid ] [ p_data ] [ 0 ] ) ;
	SetVehicleVirtualWorld ( adm_veh, p_t_info [ playerid ] [ p_data ] [ 1 ] ) ;
	PutPlayerInVehicle ( playerid, adm_veh, 0 ) ;
	SetPlayerArmedWeapon ( playerid, 0 ) ;

	static const _str [ ] = "{"#cBAdmin"}[A] {"#cGRAdmin"}%s создал автомобиль. ID: %d | Model: %d" ;
	new scm_string [ sizeof _str + 24 + 4 + 4 ] ;
	format ( scm_string, sizeof ( scm_string  ), _str, p_info [ playerid ] [ name ], adm_veh, params [ 0 ] ) ;
	foreach(new i: admin_players) SendClientMessage ( i, col_admin, scm_string ) ;

	format ( scm_string, sizeof scm_string, "Администратор %s создал т/с %d", p_info [ playerid ] [ name ], params [ 0 ] ) ;
	WriteLog ( playerid, TYPE_LOG_ADMIN, scm_string ) ;
	return true ;
}

CMD:giveslot ( playerid, params [ ] )
{
    if ( admin_info [ playerid ] [ admin ] < 8 ) return 0 ;
    if ( ! IsFounder ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}К сожалению, Вам данная функция не доступна." ) ;
    if ( sscanf ( params, "d", params [ 0 ] ) )
		return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /giveslot [playerid]");

	if ( ! IsPlayerConnected ( params [ 0 ] ) )
		return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не подключен!" ) ;

    p_info [ params [ 0 ] ] [ max_veh ] ++ ;
    update_int_sql ( params [ 0 ], "u_maxveh", p_info [ params [ 0 ] ] [ max_veh ] ) ;

	new fmt_str [ 128 ] ;
	format(fmt_str, sizeof fmt_str, "* Администратор %s выдал Вам дополнительный слот для т/с.", p_info [ playerid ] [ name ] ) ;
	SendClientMessage ( params [ 0 ], col_succes, fmt_str ) ;

	format(fmt_str, sizeof fmt_str, "* Вы выдали игроку %s[%d] дополнительный слот для т/с.", p_info [ params [ 0 ] ] [ name ], params [ 0 ] ) ;
	SendClientMessage ( playerid, col_succes, fmt_str ) ;

	format(fmt_str, sizeof fmt_str, "%s выдал %s дополнительный слот для т/с.", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ] ) ;
	WriteLog(playerid, TYPE_LOG_ADMIN, fmt_str);
	return 1 ;
}

CMD:givecar ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 8 ) return 0 ;
    if ( ! IsFounder ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}К сожалению, Вам данная функция не доступна." ) ;
	if ( sscanf ( params, "dd", params [ 0 ], params [ 1 ] ) )
		return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /givecar [playerid] [carid]" ) ;

	if ( ! IsPlayerConnected ( params [ 0 ] ) )
		return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не подключен!" ) ;

    if ( ! getValidReplacableModel ( params [ 1 ] ) )
		return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Неправильно указан ID." ) ;

	new fmt_str [ 144 ] ;
	format(fmt_str, sizeof fmt_str, "* Администратор %s выдал Вам транспорт %s. Заберите его у автосалона.", p_info [ playerid ] [ name ], GetVehicleNameEx ( INVALID_VEHICLE_ID, params [ 1 ] ) ) ;
	SendClientMessage ( params [ 0 ], col_succes, fmt_str ) ;

	format(fmt_str, sizeof fmt_str, "* Вы выдали игроку %s[%d] транспорт %s.", p_info [ params [ 0 ] ] [ name ], params [ 0 ], GetVehicleNameEx ( INVALID_VEHICLE_ID, params [ 1 ] ) ) ;
	SendClientMessage ( playerid, col_succes, fmt_str ) ;

	format(fmt_str, sizeof fmt_str, "%s выдал %s [%s]", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], GetVehicleNameEx ( INVALID_VEHICLE_ID, params [ 1 ] ) ) ;
	WriteLog(playerid, TYPE_LOG_ADMIN, fmt_str);

	new ts_id = 0, ts_spawn_slot = random ( 5 ) ;
	new	veh_id = CreateVehicle ( params [ 1 ], t_shop_respawn [ ts_id ] [ ts_spawn_slot ] [ 0 ],
										t_shop_respawn [ ts_id ] [ ts_spawn_slot ] [ 1 ],
										t_shop_respawn [ ts_id ] [ ts_spawn_slot ] [ 2 ],
										t_shop_respawn [ ts_id ] [ ts_spawn_slot ] [ 3 ],
										1, 1, SPAWN_TIME_PLAYER_VEHICLE ) ;

    if ( p_info [ params [ 0 ] ] [ max_veh ] == get_player_veh_count ( params [ 0 ] ) )
	{
	    p_info [ params [ 0 ] ] [ max_veh ] ++ ;
	    update_int_sql ( params [ 0 ], "u_maxveh", p_info [ params [ 0 ] ] [ max_veh ] ) ;
	}

	veh_info [ veh_id - 1 ] [ v_price ] = GetModelPrice ( params [ 1 ] ) ;

	new query_string [ 300 ] ;
	mysql_format ( sql_connection, query_string, sizeof query_string, "INSERT INTO `users_vehicles`(`v_model`,`v_owner`,`v_color_1`,`v_color_2`,`v_pos_x`,`v_pos_y`,`v_pos_z`,`v_pos_a`,`v_buydate`,`v_gps_tracker`,`v_price`) VALUES ('%d','%i','1','1','%f','%f','%f','%f',NOW(),'1','%d')",
	params [ 1 ],
	p_info [ params [ 0 ] ] [ id ],
	t_shop_respawn [ ts_id ] [ ts_spawn_slot ] [ 0 ],
	t_shop_respawn [ ts_id ] [ ts_spawn_slot ] [ 1 ],
	t_shop_respawn [ ts_id ] [ ts_spawn_slot ] [ 2 ],
	t_shop_respawn [ ts_id ] [ ts_spawn_slot ] [ 3 ],
	veh_info [ veh_id - 1 ] [ v_price ] ) ;
	mysql_tquery ( sql_connection, query_string, "create_vehicle_callback", "d", veh_id ) ;

	p_info [ playerid ] [ p_veh_count ] ++ ;

	veh_info [ veh_id - 1 ] [ v_type ] = vehicle_type_player ;
	veh_info [ veh_id - 1 ] [ v_vehicle ] = veh_id ;
	format ( veh_info [ veh_id - 1 ] [ v_plate ], 12, "Transit" ) ;
	veh_info [ veh_id - 1 ] [ v_pos ] [ 0 ] = t_shop_respawn [ ts_id ] [ ts_spawn_slot ] [ 0 ] ;
	veh_info [ veh_id - 1 ] [ v_pos ] [ 1 ] = t_shop_respawn [ ts_id ] [ ts_spawn_slot ] [ 1 ] ;
	veh_info [ veh_id - 1 ] [ v_pos ] [ 2 ] = t_shop_respawn [ ts_id ] [ ts_spawn_slot ] [ 2 ] ;
	veh_info [ veh_id - 1 ] [ v_pos ] [ 3 ] = t_shop_respawn [ ts_id ] [ ts_spawn_slot ] [ 3 ] ;
	veh_info [ veh_id - 1 ] [ v_fuel ] = 100.0 ;
	veh_info [ veh_id - 1 ] [ v_millage ] = 0.0 ;
	veh_info [ veh_id - 1 ] [ v_legal_millage ] = 0.0 ;
	veh_info [ veh_id - 1 ] [ v_fine ] = 3 ;
	veh_info [ veh_id - 1 ] [ v_gps_tracker ] = 1 ;

	veh_plate ( veh_id ) ;

	MODEL_INFO [ params [ 1 ] ] [ MODEL_COUNT ] += 1 ;
	set_model_count ( params [ 1 ], MODEL_INFO [ params [ 1 ] ] [ MODEL_COUNT ] ) ;

	new engine, lights, alarm, doors, bonnet, boot, objective ;
	veh_info [ veh_id - 1 ] [ v_locked ] = true ;
	GetVehicleParamsEx ( veh_id, engine, lights, alarm, doors, bonnet, boot, objective ) ;
	SetVehicleParamsEx ( veh_id, engine, lights, alarm, true, bonnet, boot, objective ) ;

	veh_info [ veh_id - 1 ] [ v_owner ] = p_info [ params [ 0 ] ] [ id ] ;

	SetVehicleNumberPlate ( veh_info [ veh_id - 1 ] [ v_vehicle ], veh_info [ veh_id - 1 ] [ v_plate ] ) ;
	Iter_Add(player_vehicles[ params [ 0 ] ], veh_info [ veh_id - 1 ] [ v_vehicle ] ) ;
	return 1 ;
}

CMD:givedonate ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 8 ) return 0 ;
	if ( ! IsFounder ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}К сожалению, Вам данная функция не доступна." ) ;

	new
		targetid,
		_donate,
		_position ;

	if ( sscanf ( params, "ddd", targetid, _position, _donate ) )
		return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /givedonate [targetid] [bonus/main] [donate]");

	if ( ! ( 1 <= _position <= 2 ) )
		return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не правильно указали счёт!");

	if ( ! ( 10 <= _donate <= 10000 ) )
		return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Сумма доната не должна быть меньше 10 и больше 10.000 "donate_title"!");

	if ( ! IsPlayerConnected ( targetid ) )
		return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не подключен!");

	new fmt_str [ 144 ] ;

	format(fmt_str, sizeof fmt_str, "* Администратор %s[%d] выдал Вам донат на сумму %d "donate_title". Приятного время провождения на проекте!", p_info [ playerid ] [ name ], playerid, _donate ) ;
	SendClientMessage ( targetid, col_succes, fmt_str ) ;

	format(fmt_str, sizeof fmt_str, "* Вы выдали игроку %s[%d] донат на сумму %d "donate_title"", p_info [ targetid ] [ name ], targetid, _donate ) ;
	SendClientMessage ( playerid, col_succes, fmt_str);

	give_player_donate ( targetid, _donate, _position ) ;

	format(fmt_str, 128, "%s выдал %s %d "donate_title"", p_info [ playerid ] [ name ], p_info [ targetid ] [ name ], _donate ) ;
	WriteLog(playerid, TYPE_LOG_ADMIN, fmt_str);
	return 1 ;
}

CMD:delvehall ( playerid )
{
    if ( admin_info [ playerid ] [ admin ] < 5 )return 1 ;

    for ( new c = 1 ; c < MAX_VEHICLES ; c ++ )
    {
		if ( veh_info [ c - 1 ] [ v_admin ] == true )
		{
            DestroyVehicle ( c, 24 ) ;
		}
    }

	static const _str [ ] = "{"#cBAdmin"}[A] {"#cGRAdmin"}%s удалил автомобили созданные администраторами." ;
	new scm_string [ sizeof _str + 24 ] ;
	format ( scm_string, sizeof ( scm_string ), _str, p_info [ playerid ] [ name ] ) ;
	foreach(new i: admin_players) SendClientMessage ( i, col_admin, scm_string ) ;
	return true ;
}

stock reInitVehicle ( new_veh_id, veh_id )
{
	veh_info [ new_veh_id - 1 ] [ v_id ] = veh_info [ veh_id - 1 ] [ v_id ] ;
	veh_info [ new_veh_id - 1 ] [ v_pos ] [ 0 ] = veh_info [ veh_id - 1 ] [ v_pos ] [ 0 ] ;
	veh_info [ new_veh_id - 1 ] [ v_pos ] [ 1 ] = veh_info [ veh_id - 1 ] [ v_pos ] [ 1 ] ;
	veh_info [ new_veh_id - 1 ] [ v_pos ] [ 2 ] = veh_info [ veh_id - 1 ] [ v_pos ] [ 2 ] ;
	veh_info [ new_veh_id - 1 ] [ v_pos ] [ 3 ] = veh_info [ veh_id - 1 ] [ v_pos ] [ 3 ] ;

	veh_info [ new_veh_id - 1 ] [ v_owner ] = veh_info [ veh_id - 1 ] [ v_owner ] ;
	veh_info [ new_veh_id - 1 ] [ v_color ] [ 0 ] = veh_info [ veh_id - 1 ] [ v_color ] [ 0 ] ;
	veh_info [ new_veh_id - 1 ] [ v_color ] [ 1 ] = veh_info [ veh_id - 1 ] [ v_color ] [ 1 ] ;

	veh_info [ new_veh_id - 1 ] [ v_locked ] = veh_info [ veh_id - 1 ] [ v_locked ] ;

	format ( veh_info [ new_veh_id - 1 ] [ v_plate ], 12, "%s", veh_info [ veh_id - 1 ] [ v_plate ] ) ;
	format ( veh_info [ new_veh_id - 1 ] [ v_region ], 12, "%s", veh_info [ veh_id - 1 ] [ v_region ] ) ;
	veh_info [ new_veh_id - 1 ] [ v_plate_type ] = veh_info [ veh_id - 1 ] [ v_plate_type ] ;

	veh_info [ new_veh_id - 1 ] [ v_fuel ] = veh_info [ veh_id - 1 ] [ v_fuel ] ;
	veh_info [ new_veh_id - 1 ] [ v_millage ] = veh_info [ veh_id - 1 ] [ v_millage ] ;
	veh_info [ new_veh_id - 1 ] [ v_legal_millage ] = veh_info [ veh_id - 1 ] [ v_legal_millage ] ;

	reInitVehicleData ( new_veh_id, veh_id ) ;
	veh_info [ new_veh_id - 1 ] [ v_main_color ] [ 0 ] = veh_info [ veh_id - 1 ] [ v_main_color ] [ 0 ] ;
	veh_info [ new_veh_id - 1 ] [ v_main_color ] [ 1 ] = veh_info [ veh_id - 1 ] [ v_main_color ] [ 1 ] ;
	veh_info [ new_veh_id - 1 ] [ v_main_color ] [ 2 ] = veh_info [ veh_id - 1 ] [ v_main_color ] [ 2 ] ;
	veh_info [ new_veh_id - 1 ] [ v_disk_color ] [ 0 ] = veh_info [ veh_id - 1 ] [ v_disk_color ] [ 0 ] ;
	veh_info [ new_veh_id - 1 ] [ v_disk_color ] [ 1 ] = veh_info [ veh_id - 1 ] [ v_disk_color ] [ 1 ] ;
	veh_info [ new_veh_id - 1 ] [ v_disk_color ] [ 2 ] = veh_info [ veh_id - 1 ] [ v_disk_color ] [ 2 ] ;
	veh_info [ new_veh_id - 1 ] [ v_lights_color ] [ 0 ] = veh_info [ veh_id - 1 ] [ v_lights_color ] [ 0 ] ;
	veh_info [ new_veh_id - 1 ] [ v_lights_color ] [ 1 ] = veh_info [ veh_id - 1 ] [ v_lights_color ] [ 1 ] ;
	veh_info [ new_veh_id - 1 ] [ v_lights_color ] [ 2 ] = veh_info [ veh_id - 1 ] [ v_lights_color ] [ 2 ] ;
	veh_info [ new_veh_id - 1 ] [ v_neon ] [ 0 ] = veh_info [ veh_id - 1 ] [ v_neon ] [ 0 ] ;
	veh_info [ new_veh_id - 1 ] [ v_neon ] [ 1 ] = veh_info [ veh_id - 1 ] [ v_neon ] [ 1 ] ;
	veh_info [ new_veh_id - 1 ] [ v_neon ] [ 2 ] = veh_info [ veh_id - 1 ] [ v_neon ] [ 2 ] ;
	veh_info [ new_veh_id - 1 ] [ v_neon_type ] = veh_info [ veh_id - 1 ] [ v_neon_type ] ;
	veh_info [ new_veh_id - 1 ] [ v_toner ] [ 0 ] = veh_info [ veh_id - 1 ] [ v_toner ] [ 0 ] ;
	veh_info [ new_veh_id - 1 ] [ v_toner ] [ 1 ] = veh_info [ veh_id - 1 ] [ v_toner ] [ 1 ] ;
	veh_info [ new_veh_id - 1 ] [ v_toner ] [ 2 ] = veh_info [ veh_id - 1 ] [ v_toner ] [ 2 ] ;
	veh_info [ new_veh_id - 1 ] [ v_toner ] [ 3 ] = veh_info [ veh_id - 1 ] [ v_toner ] [ 3 ] ;
	veh_info [ new_veh_id - 1 ] [ v_vinyl ] = veh_info [ veh_id - 1 ] [ v_vinyl ] ;

	veh_info [ new_veh_id - 1 ] [ v_stage_speed ] = veh_info [ veh_id - 1 ] [ v_stage_speed ] ;
	veh_info [ new_veh_id - 1 ] [ v_stage_brake ] = veh_info [ veh_id - 1 ] [ v_stage_brake ] ;

	veh_info [ new_veh_id - 1 ] [ v_disk_id ] = veh_info [ veh_id - 1 ] [ v_disk_id ] ;
	veh_info [ new_veh_id - 1 ] [ v_nitro ] = veh_info [ veh_id - 1 ] [ v_nitro ] ;

	veh_info [ new_veh_id - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_BUMPER_FRONT ] = veh_info [ veh_id - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_BUMPER_FRONT ] ;
	veh_info [ new_veh_id - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_BUMPER_REAR ] = veh_info [ veh_id - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_BUMPER_REAR ] ;
	veh_info [ new_veh_id - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_FENDER_FRONT ] = veh_info [ veh_id - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_FENDER_FRONT ] ;
	veh_info [ new_veh_id - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_FENDER_REAR ] = veh_info [ veh_id - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_FENDER_REAR ] ;
	veh_info [ new_veh_id - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_SPOILER ] = veh_info [ veh_id - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_SPOILER ] ;
	veh_info [ new_veh_id - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_EXHAUST ] = veh_info [ veh_id - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_EXHAUST ] ;
	veh_info [ new_veh_id - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_ROOF ] = veh_info [ veh_id - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_ROOF ] ;
	veh_info [ new_veh_id - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_TAILLIGHTS ] = veh_info [ veh_id - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_TAILLIGHTS ] ;
	veh_info [ new_veh_id - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_HEADLIGHTS ] = veh_info [ veh_id - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_HEADLIGHTS ] ;
	veh_info [ new_veh_id - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_DIFFUSER ] = veh_info [ veh_id - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_DIFFUSER ] ;
	veh_info [ new_veh_id - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_SPLITTER ] = veh_info [ veh_id - 1 ] [ V_DUMMY_INFO ] [ CAR_COMPONENT_SPLITTER ] ;

	if ( veh_info [ new_veh_id - 1 ] [ v_disk_id ] )
		AddVehicleComponent ( veh_info [ new_veh_id - 1 ] [ v_vehicle ], veh_info [ new_veh_id - 1 ] [ v_disk_id ] ) ;

	if ( veh_info [ new_veh_id - 1 ] [ v_nitro ] )
		AddVehicleComponent ( veh_info [ new_veh_id - 1 ] [ v_vehicle ], veh_info [ new_veh_id - 1 ] [ v_nitro ] ) ;
	return 1 ;
}

stock is_ip_white_list ( server_ip [ ] )
{
	new bot_iter = - 1 ;
	for ( new j = 0 ; j < 5 ; j ++  )
	{
		if ( ! GetString ( server_ip, ip_white_list [ j ] ) ) continue ;
		bot_iter = j ;
	}
	if ( bot_iter != -1 ) return 1 ;
	return 0 ;
}

stock SaveServerOnline ( )
{
	static const _str [ ] = "UPDATE `server_online` SET `online_players` = '%d', `max_players` = '%d', `last_checked` = current_timestamp() WHERE `id` = '%d' LIMIT 1" ;
	new sql_string [ sizeof _str + ( 3 * 9 ) ] ;
    format ( sql_string, sizeof sql_string, _str, Iter_Count(logged_players), MAX_PLAYERS, server_number ) ;
    mysql_tquery ( launcher_connection, sql_string ) ;
}

