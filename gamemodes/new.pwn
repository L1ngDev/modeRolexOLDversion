					mysql_tquery ( sql_connection, sql_string ) ;

					format ( fm_string, sizeof fm_string, "Администратор %s снят(а) с поста. Причина: игнорирование репорта", p_info [ i ] [ name ] ) ;
					WriteLog ( i, TYPE_LOG_ADMIN, fm_string ) ;
				}
				else
				{
