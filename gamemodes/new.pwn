stock showCapture ( playerid )
{
	#if defined debug_packet
		printf ( "[showCapture] playerid: %d", playerid ) ;
	#endif

	new _gz_owner = gz_info [ gz_captured ] [ gz_owner ], _gz_attacker = gz_info [ gz_captured ] [ gz_attacker ] ;
	new Node: node = JSON_Object (
		"scoreFirst",			JSON_Int ( owner_points ),
		"nameFirst",			JSON_String ( f_info [ _gz_owner - 1 ] [ f_name ] ),
		"time",					JSON_Int ( gz_info [ gz_captured ] [ gz_time ] ),
		"scoreSecond",			JSON_Int ( attacker_points ),
		"nameSecond",			JSON_String ( f_info [ _gz_attacker - 1 ] [ f_name ] )
	) ;

	global_string [ 0 ] = EOS ;
	JSON_Stringify ( node, global_string, sizeof global_string ) ;
	onServerSendData ( playerid, UI_CAPTURE, 0, global_string ) ;
}

stock hideCapture ( playerid )
{
	onServerSendData ( playerid, UI_CAPTURE, 1, "" ) ;
}

