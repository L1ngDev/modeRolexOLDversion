		cache_get_field_content ( 0, "e_player", sscanf_delimit, 64 ) ;
		new Float: e_X, Float: e_Y, Float: e_Z, e_Virt, e_Int, e_HBC, e_time, e_IncID ;
		sscanf ( sscanf_delimit, "p<,>fffiiiii", e_X, e_Y, e_Z, e_Int, e_Virt, e_HBC, e_IncID, e_time ) ;
		p_info [ playerid ] [ exit_pos ] [ 0 ] = e_X ;
		p_info [ playerid ] [ exit_pos ] [ 1 ] = e_Y ;
		p_info [ playerid ] [ exit_pos ] [ 2 ] = e_Z ;
		p_info [ playerid ] [ exit_int ] = e_Int ;
		p_info [ playerid ] [ exit_world ] = e_Virt ;
		p_info [ playerid ] [ exit_type ] = e_HBC ;
		p_info [ playerid ] [ exit_inc_id ] = e_IncID ;
		p_info [ playerid ] [ exit_time ] = e_time ;

		p_info [ playerid ] [ stats ] [ 1 ] = cache_get_field_content_int ( 0, "u_stats1", sql_connection ) ;
		p_info [ playerid ] [ stats ] [ 2 ]  = cache_get_field_content_int ( 0, "u_stats2", sql_connection ) ;
		p_info [ playerid ] [ u_style ] [ 0 ] = cache_get_field_content_int ( 0, "u_style0", sql_connection ) ;
		p_info [ playerid ] [ u_style ] [ 1 ] = cache_get_field_content_int ( 0, "u_style1", sql_connection ) ;

		p_info [ playerid ] [ model_phone ] = cache_get_field_content_int ( 0, "u_model_phone", sql_connection ) ;
		p_info [ playerid ] [ sound_sms ] = cache_get_field_content_int ( 0, "u_sound_sms", sql_connection ) ;
		p_info [ playerid ] [ sound_call ] = cache_get_field_content_int ( 0, "u_sound_call", sql_connection ) ;

		p_info [ playerid ] [ wanted_result ] = cache_get_field_content_int ( 0, "u_wanted_result", sql_connection ) ;

		p_info [ playerid ] [ mask_status ] = cache_get_field_content_int ( 0, "u_mask_status", sql_connection ) ;
		p_info [ playerid ] [ spawn_status ] = cache_get_field_content_int ( 0, "u_spawn_status", sql_connection ) ;
		p_info [ playerid ] [ family_invite ] = cache_get_field_content_int ( 0, "u_family_invite", sql_connection ) ;
		p_info [ playerid ] [ freeze ] = cache_get_field_content_int ( 0, "u_freeze", sql_connection ) ;

		p_info [ playerid ] [ hotel ] = cache_get_field_content_int ( 0, "u_hotel", sql_connection ) ;
		p_info [ playerid ] [ hotel_id ] = cache_get_field_content_int ( 0, "u_hotel_id", sql_connection ) ;

		p_info [ playerid ] [ p_disease ] [ 2 ] = cache_get_field_content_int ( 0, "u_disease_2" ) ;
		p_info [ playerid ] [ p_disease ] [ 0 ] = cache_get_field_content_int ( 0, "u_disease" ) ;
	    p_info [ playerid ] [ p_disease ] [ 1 ] = cache_get_field_content_int ( 0, "u_disease_stage" ) ;
  		p_info [ playerid ] [ p_wrong_virus ] [ 0 ] = cache_get_field_content_int ( 0, "u_bad_disease" ) ;
	    p_info [ playerid ] [ p_diagnosis ] = cache_get_field_content_int ( 0, "u_diagnosis" ) ;
	    p_info [ playerid ] [ p_healing ] = cache_get_field_content_int ( 0, "u_healing" ) ;
	    p_info [ playerid ] [ p_healingTime ] = cache_get_field_content_int ( 0, "u_healing_time" ) ;

        p_info [ playerid ] [ law_obedience ] = cache_get_field_content_int ( 0, "u_law_obedience", sql_connection ) ;

        new l_guns [ 56 ], l_ammo [ 56 ] ;
		cache_get_field_content ( 0, "u_guns_relog", l_guns, sql_connection, 56 ) ;
		cache_get_field_content ( 0, "u_ammos_relog", l_ammo, sql_connection, 56 ) ;

        new g_data [ 13 ], a_data [ 13 ] ;
		sscanf ( l_guns, "p<|>a<i>[13]", g_data ) ;
		sscanf ( l_ammo, "p<|>a<i>[13]", a_data ) ;
		for ( new i = 0 ; i < 12 ; i ++ )
		{
		    if ( g_data [ i ] < 1 || a_data [ i ] < 1 ) g_data [ i ] = 0, a_data [ i ] = 0 ;
		    if ( a_data [ i ] > 500 ) a_data [ i ] = 500 ;
		    duel_guns [ playerid ] [ i ] [ 0 ] = g_data [ i ] ;
		    duel_guns [ playerid ] [ i ] [ 1 ] = a_data [ i ] ;
		}

        p_info [ playerid ] [ business_rang ] = cache_get_field_content_int ( 0, "u_business_rang", sql_connection ) ;
		p_info [ playerid ] [ b_worker ] = cache_get_field_content_int ( 0, "u_bworker", sql_connection ) ;
