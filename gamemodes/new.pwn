		case d_dr_skin:
		{
			if ( ! response ) return SelectTextDraw ( playerid, 0xB0C4DEFF ) ;
			if ( listitem == 0 )
			{
				new line_string [ 80 ] ;
				global_string [ 0 ] = EOS ;
				strcat ( global_string, "{"#cBL"}Выберите слот одежды\n" ) ;
				for ( new j = 0 ; j < 5 ; j ++ )
				{
					if ( p_info [ playerid ] [ temp_skin ] [ j ] == 0 )
					{
						strcat ( global_string, "{"#cGRDialog"}- Пусто\n" ) ;
					}
					else
					{
						format ( line_string, sizeof line_string, "{ffffff}Одежда '%s' (%d)\n", get_skin_name ( p_info [ playerid ] [ temp_skin ] [ j ] ), p_info [ playerid ] [ temp_skin ] [ j ] ) ;
						strcat ( global_string, line_string ) ;
					}
				}
				show_dialog ( playerid, d_dr_skin, DIALOG_STYLE_LIST, "{"#cBHD"}Гардероб", global_string, "Выбрать", "Назад" ) ;
				return 1 ;
			}

			if ( p_info [ playerid ] [ temp_skin ] [ listitem - 1 ] > 0 )
			{
				MODEL_INFO [ p_info [ playerid ] [ temp_skin ] [ listitem - 1 ] ] [ MODEL_COUNT ] -= 1 ;
				set_model_count ( p_info [ playerid ] [ temp_skin ] [ listitem - 1 ], MODEL_INFO [ p_info [ playerid ] [ temp_skin ] [ listitem - 1 ] ] [ MODEL_COUNT ] ) ;
			}

			set_skin ( playerid, dr_slot_model [ playerid ] [ 4 ] ) ;
			p_info [ playerid ] [ temp_skin ] [ listitem - 1 ] = dr_slot_model [ playerid ] [ 4 ] ;

			MODEL_INFO [ p_info [ playerid ] [ temp_skin ] [ listitem - 1 ] ] [ MODEL_COUNT ] += 1 ;
			set_model_count ( p_info [ playerid ] [ temp_skin ] [ listitem - 1 ], MODEL_INFO [ p_info [ playerid ] [ temp_skin ] [ listitem - 1 ] ] [ MODEL_COUNT ] ) ;

			new _query [ 126 ] ;
			format ( _query, sizeof ( _query ), "UPDATE `users` SET `u_tempskin`='%d|%d|%d|%d|%d' WHERE `u_id` = '%d' LIMIT 1",
			p_info [ playerid ] [ temp_skin ] [ 0 ], p_info [ playerid ] [ temp_skin ] [ 1 ], p_info [ playerid ] [ temp_skin ] [ 2 ],
			p_info [ playerid ] [ temp_skin ] [ 3 ], p_info [ playerid ] [ temp_skin ] [ 4 ], p_info [ playerid ] [ id ] ) ;
			mysql_tquery ( sql_connection, _query ) ;
			SelectTextDraw ( playerid, 0xB0C4DEFF ) ;
			return 1 ;
		}
		case d_lmenu_fixcar:
		{
			if ( ! response )return ShowLeaderMenu ( playerid ) ;

			new fractionid ;
			if ( p_info [ playerid ] [ leader ] ) fractionid = p_info [ playerid ] [ member ] ;
			else fractionid = player_settings { playerid } ;

			if ( listitem == 0 )
			{
				if ( f_info [ fractionid - 1 ] [ f_money ] < price_fixcar * Iter_Count(fraction_vehicles[fractionid]) )
				{
					SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}В банке организации недостаточно средств." ) ;

                    show_fixcar ( playerid, 4 ) ;
					return 1 ;
				}

				if ( Iter_Count(fraction_vehicles[fractionid]) < 1 )
				{
                    show_fixcar ( playerid, 4 ) ;
					return 1 ;
				}

				new _veh_count [ 50 ] = { INVALID_VEHICLE_ID, ... }, _slot_id = 0 ;
				foreach(new vehicleid: fraction_vehicles[fractionid])
				{
				    if ( vehicleid >= 2000 && vehicleid <= INVALID_VEHICLE_ID ) continue ;
				    if ( veh_info [ vehicleid - 1 ] [ v_type ] != vehicle_type_server ) continue ;
					if ( ! IsValidVehicle ( vehicleid ) ) continue ;
					if ( is_vehicle_occupied ( vehicleid ) != -1 ) continue ;

                    _veh_count [ _slot_id ] = vehicleid ;
                    _slot_id ++ ;
					//SetVehicleToRespawn ( vehicleid, 14 ) ;
				}

				for ( new i = 0 ; i < _slot_id ; i ++ )
				{
					if ( _veh_count [ i ] == INVALID_VEHICLE_ID ) continue ;
				    if ( veh_info [ _veh_count [ i ] - 1 ] [ v_type ] != vehicle_type_server ) continue ;
				    if ( veh_info [ _veh_count [ i ] - 1 ] [ v_owner ] != fractionid ) continue ;

					SetVehicleToRespawn ( _veh_count [ i ], 14 ) ;
				}

				new scm_string [ 128 ] ;
				if ( gang_player ( playerid ) || mafia_player ( playerid ) ) format ( scm_string, sizeof scm_string, "[F] %s %s отправил(а) весь незанятый транспорт на парковку.", f_rank [ fractionid - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ] ) ;
				else format ( scm_string, sizeof scm_string, "[R] %s %s отправил(а) весь незанятый транспорт на парковку.", f_rank [ fractionid - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ] ) ;
				fraction_message ( fractionid, col_lblue, scm_string ) ;

				SendClientMessage ( playerid, col_white, !"{"#cBInfo"}* {"#cWH"}Весь незанятый транспорт был отбуксирован." ) ;
				ShowLeaderMenu ( playerid ) ;

				set_money_fraction ( fractionid - 1, 4, price_fixcar * Iter_Count(fraction_vehicles[fractionid]), false ) ;
				return 1 ;
			}
			if ( f_info [ fractionid - 1 ] [ f_money ] < price_fixcar )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}В банке организации недостаточно средств." ) ;

			new vehicleid = get_player_listitem_values ( playerid, listitem - 1 ) ;
			set_player_use_listitem ( playerid, vehicleid ) ;
			show_menu_fixcar ( playerid, vehicleid, 4 ) ;
			return 1 ;
		}
		case d_lmenu_fixcar1:
		{
		    if ( ! response )
			{
				ShowLeaderMenu ( playerid ) ;
				return 1 ;
			}
		    switch ( listitem )
		    {
		        case 0:
		        {
		            new fraction_id ;
					if ( p_info [ playerid ] [ leader ] ) fraction_id = p_info [ playerid ] [ member ] ;
					else fraction_id = player_settings { playerid } ;

		            global_string [ 0 ] = EOS ;
					new line_string [ 72 ] ;
					for ( new i = 0; i < f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 0 ] ; i ++ )
					{
						format ( line_string, 72, "{"#cBL"}%i. {"#cWH"}%s\n", i + 1, f_rank [ fraction_id - 1 ] [ i ] ) ;
						strcat ( global_string, line_string ) ;
					}
					show_dialog ( playerid, d_lmenu_fixcar2, DIALOG_STYLE_LIST, "{"#cBHD"}Ранг доступности", global_string, "Выбрать", "Назад" ) ;
		        }
		        case 1:
		        {
		        	new vehicleid = get_player_use_listitem ( playerid ) ;
					foreach(new i: fraction_vehicles[p_info [ playerid ] [ member ]])
					{
					    if ( veh_info [ i - 1 ] [ v_type ] != vehicle_type_server ) continue ;
				    	if ( veh_info [ i - 1 ] [ v_owner ] != p_info [ playerid ] [ member ] ) continue ;
					    if ( veh_info [ i - 1 ] [ v_id ] != vehicleid ) continue ;

				    	if ( is_vehicle_occupied ( i - 1 ) != -1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Транспорт используется." ) ;

						new scm_string [ 128 ], fraction_id ;
						if ( p_info [ playerid ] [ leader ] ) fraction_id = p_info [ playerid ] [ member ] ;
						else fraction_id = player_settings { playerid } ;
						if ( gang_player ( playerid ) || mafia_player ( playerid ) ) format ( scm_string, sizeof scm_string, "[F] %s %s отправил(а) на парковку %s.", f_rank [ fraction_id - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], GetVehicleNameEx ( i ) ) ;
						else format ( scm_string, sizeof scm_string, "[R] %s %s отправил(а) на парковку %s.", f_rank [ fraction_id - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], GetVehicleNameEx ( i ) ) ;
						fraction_message ( fraction_id, col_lblue, scm_string ) ;

						SetVehicleToRespawn ( i - 1, 15 ) ;
						SendClientMessage ( playerid, col_white, !"{"#cBInfo"}* {"#cWH"}Транспорт отремонтирован и отбуксирован к месту стоянки." ) ;

						set_money_fraction ( fraction_id - 1, 4, price_fixcar, false ) ;
						break ;
					}

					ShowLeaderMenu ( playerid ) ;
		        }
		        case 2:
		        {
					new veh_id = get_player_use_listitem ( playerid ) ;

					foreach(new i: fraction_vehicles[p_info [ playerid ] [ member ]])
					{
					    if ( veh_info [ i - 1 ] [ v_type ] != vehicle_type_server ) continue ;
					    if ( veh_info [ i - 1 ] [ v_owner ] != p_info [ playerid ] [ member ] ) continue ;
					    if ( veh_info [ i - 1 ] [ v_id ] != veh_id ) continue ;

						if ( GetPlayerVehicleID ( playerid ) != i ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нужно быть в транспорте, который хотите переставить." ) ;

						GetPlayerPos ( playerid, veh_info [ i - 1 ] [ v_pos ] [ 0 ], veh_info [ i - 1 ] [ v_pos ] [ 1 ], veh_info [ i - 1 ] [ v_pos ] [ 2 ] ) ;
						GetPlayerFacingAngle ( playerid, veh_info [ i - 1 ] [ v_pos ] [ 3 ] ) ;

						new new_veh_id = CreateVehicle ( getVehicleOrdinalNumber ( i ), veh_info [ i - 1 ] [ v_pos ] [ 0 ], veh_info [ i - 1 ] [ v_pos ] [ 1 ], veh_info [ i - 1 ] [ v_pos ] [ 2 ], veh_info [ i - 1 ] [ v_pos ] [ 3 ], veh_info [ i - 1 ] [ v_color ] [ 0 ], veh_info [ i - 1 ] [ v_color ] [ 1 ], SPAWN_TIME_SERVER_VEHICLE ) ;
	     				Iter_Add ( fraction_vehicles[p_info [ playerid ] [ member ]], new_veh_id ) ;

						veh_info [ new_veh_id - 1 ] [ v_type ] = vehicle_type_server ;
						reInitVehicle ( new_veh_id, veh_id ) ;

						veh_info [ new_veh_id - 1 ] [ v_vehicle ] = new_veh_id ;

						veh_info [ new_veh_id - 1 ] [ v_vw ] = GetPlayerVirtualWorld ( playerid ) ;
						veh_info [ new_veh_id - 1 ] [ v_int ] = GetPlayerInterior ( playerid ) ;
						if ( veh_info [ new_veh_id - 1 ] [ v_int ] != 0 )LinkVehicleToInterior ( new_veh_id, veh_info [ new_veh_id - 1 ] [ v_int ] ) ;
						if ( veh_info [ new_veh_id - 1 ] [ v_vw ] != 0 )SetVehicleVirtualWorld ( new_veh_id, veh_info [ new_veh_id - 1 ] [ v_vw ] ) ;

						veh_plate ( new_veh_id ) ;

