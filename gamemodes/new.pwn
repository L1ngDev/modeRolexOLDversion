				if ( v_velo ( vehicleid ) || v_plane ( vehicleid ) || v_boat ( vehicleid ) ) return 1 ;
				toggle_lights ( playerid, vehicleid ) ;
				return 1 ;
			}

			if ( newkeys & KEY_CROUCH )
			{
			    if ( IsPlayerInAnyVehicle ( playerid ) )
				{
					if ( IsPlayerInRangeOfPoint ( playerid, 100.0, position_text_parking [ 0 ], position_text_parking [ 1 ], position_text_parking [ 2 ] ) )
					{
					    new _padik_id = GetPVarInt ( playerid, "podezd_id" ) - 1 ;
					    if ( _padik_id < 0 ) return bad_exit ( playerid ) ;

						DeletePVar ( playerid, "podezd_id" ) ;

						if ( vehicleid == 0 ) return 1 ;
					    SetVehiclePos ( vehicleid, podezd_info [ _padik_id ] [ p_v_pos ] [ 0 ], podezd_info [ _padik_id ] [ p_v_pos ] [ 1 ], podezd_info [ _padik_id ] [ p_v_pos ] [ 2 ] ) ;
						SetVehicleZAngle ( vehicleid, podezd_info [ _padik_id ] [ p_v_pos ] [ 3 ] ) ;
						set_interior ( playerid, 0 ) ;
						set_world ( playerid, 0 ) ;
						LinkVehicleToInterior( vehicleid, 0 );
						SetVehicleVirtualWorld ( vehicleid, 0 );
						SetPlayerArmedWeapon ( playerid, 0 ) ;
						return 1 ;
					}
				}
			}
     		if ( newkeys & KEY_CROUCH )
			{
			    if ( GetPlayerVehicleID ( playerid ) != 0 && GetPlayerState ( playerid ) == PLAYER_STATE_DRIVER )
				{
				    new _areaid = used_area [ playerid ] ;
				    if ( _areaid != -1 && area_info [ _areaid ] [ a_type ] == area_type_tuning )
					{
					    new i = area_info [ _areaid ] [ a_item ] ;
						new _b_id = tuning_info [ i ] [ t_b_id ] ;

			  			new _v_type = veh_info [ vehicleid - 1 ] [ v_type ] ;
						switch ( tuning_info [ i ] [ t_type ] )
						{
						    case type_default_tuning:
						    {
								if ( _v_type == vehicle_type_family )
								{
									if ( p_info [ playerid ] [ family_rang ] < family_info [ p_info [ playerid ] [ family ] - 1 ] [ fam_settings ] [ 3 ] )
										return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Семейный транспорт может тюнинговать лишь лидер семьи." ) ;
								}
								else if ( _v_type == vehicle_type_player )
								{
									if ( veh_info [ vehicleid - 1 ] [ v_owner ] != p_info [ playerid ] [ id ] )
										return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не владелец данного транспорта." ) ;
								}
								else
									return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данный транспорт нельзя тюнинговать." ) ;

								if ( get_passenger_count ( playerid ) > 0 )  return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Для начала высадите всех пассажиров из транспорта." ) ;

								if ( b_info [ _b_id - 1 ] [ b_close ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Автостанция закрыта." ) ;

								if ( v_bike ( vehicleid ) || v_velo ( vehicleid ) || v_plane ( vehicleid ) || v_boat ( vehicleid ) )
									return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Автостанция не обслуживает такие транспортные средства" ) ;

								SetPVarInt ( playerid, "p_biz_id", _b_id ) ;

								SetVehiclePos ( vehicleid, tuning_position [ 0 ], tuning_position [ 1 ], tuning_position [ 2 ] ) ;
								SetVehicleZAngle ( vehicleid, tuning_position [ 3 ] ) ;
								set_interior ( playerid, tuning_interior ) ;
								set_world ( playerid, playerid + 1 ) ;
								LinkVehicleToInterior( vehicleid, tuning_interior ) ;
								SetVehicleVirtualWorld ( vehicleid, playerid + 1 ) ;
								SetPlayerArmedWeapon ( playerid, 0 ) ;

								showTuneDialog ( playerid ) ;
								return 1 ;
							}
							case type_perfromance:
							{
								if ( _v_type == vehicle_type_family )
								{
									if ( p_info [ playerid ] [ family_rang ] < family_info [ p_info [ playerid ] [ family ] - 1 ] [ fam_settings ] [ 3 ] )
										return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Семейный транспорт может тюнинговать лишь лидер семьи." ) ;
								}
								else if ( _v_type == vehicle_type_player )
								{
									if ( veh_info [ vehicleid - 1 ] [ v_owner ] != p_info [ playerid ] [ id ] )
										return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не владелец данного транспорта." ) ;
								}
								else
									return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данный транспорт нельзя тюнинговать." ) ;

								if ( get_passenger_count ( playerid ) > 0 )  return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Для начала высадите всех пассажиров из транспорта." ) ;

								if ( b_info [ _b_id - 1 ] [ b_close ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Тюнинг-ателье закрыто." ) ;
								if ( v_bike ( vehicleid ) || v_velo ( vehicleid ) || v_plane ( vehicleid ) || v_boat ( vehicleid ) )
									return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Тюнинг-ателье не обслуживает такие транспортные средства." ) ;

								SetPVarInt ( playerid, "p_biz_id", _b_id ) ;

								SetVehiclePos ( vehicleid, tuning_position [ 0 ], tuning_position [ 1 ], tuning_position [ 2 ] ) ;
								SetVehicleZAngle ( vehicleid, tuning_position [ 3 ] ) ;
								set_interior ( playerid, tuning_interior ) ;
								set_world ( playerid, playerid + 1 ) ;
								LinkVehicleToInterior( vehicleid, tuning_interior ) ;
								SetVehicleVirtualWorld ( vehicleid, playerid + 1 ) ;
								SetPlayerArmedWeapon ( playerid, 0 ) ;

								showTuneDialog ( playerid ) ;
								return 1 ;
							}
						}
					}
					if ( GetPVarInt ( playerid, "p_biz_id" ) && GetPlayerInterior ( playerid ) == tuning_interior )
					{
					    new _b_id = GetPVarInt ( playerid, "p_biz_id" ) ;
					    DeletePVar ( playerid, "p_biz_id" ) ;
					    exit_tuning ( playerid, _b_id ) ;
						return 1 ;
					}

					if ( p_info [ playerid ] [ job ] == job_delivery )
					{
						for ( new b = 0 ; b < b_count ; b ++ )
						{
						    if ( b_info [ b ] [ b_type ] == bizz_type_gas ) continue ;
						    if ( b_info [ b ] [ b_maxproduct ] - 5000 < b_info [ b ] [ b_product ] ) continue ;
						    if ( ! IsPlayerInRangeOfPoint ( playerid, 5.0, b_info [ b ] [ b_position ] [ 0 ], b_info [ b ] [ b_position ] [ 1 ], b_info [ b ] [ b_position ] [ 2 ] ) ) continue ;

							new order_products = veh_info [ GetPlayerVehicleID ( playerid ) - 1 ] [ v_cargo ] ;
							b_info [ b ] [ b_product ] += order_products ;
							veh_info [ GetPlayerVehicleID ( playerid ) - 1 ] [ v_cargo ] = 0 ;

							new string [ 128 ], order_price = b_info [ b ] [ b_product_price ] ;
							format ( string, sizeof ( string ), "{"#cGInfo"}* {"#cWH"}Вы разгрузили {"#cGN"}%d/5000 кг.{"#cWH"} товара за {"#cGN"}%d"valute_title"{"#cWH"}.", order_products, order_products * order_price ) ;
							SendClientMessage ( playerid, col_white, string ) ;

							new _pay = ( order_products * order_price ) + ( order_products * 3 ) ;
							give_money ( playerid, _pay ) ;
							insert_money_log ( playerid, INVALID_PLAYER_ID, _pay, "доставка товаров" ) ;

							if ( b_info [ b ] [ b_money ] < order_products * order_price )
							{
							    new _pl_id ;
							    sscanf ( b_info [ b ] [ b_owner_name ], "u", _pl_id ) ;
							    if ( IsPlayerConnected ( _pl_id ) )
							    {
							        SendClientMessage ( playerid, col_red, !"* Вам завезли продукты в бизнес и в бизнесе не хватило средств для оплаты продукции." ) ;
							        SendClientMessage ( playerid, col_red, !"* Счёт за продукты добавлен Вам в виде налога." ) ;

							        p_info [ _pl_id ] [ tax ] += order_products * order_price ;
							        update_int_sql ( _pl_id, "u_tax", p_info [ _pl_id ] [ tax ] ) ;
							    }
							    else
							    {
									string [ 0 ] = EOS ;
							        format ( string, 100, "UPDATE `users` SET `u_tax` = `u_tax`+'%d' WHERE `u_id` = '%d' LIMIT 1", order_products * order_price, b_info [ b ] [ b_owner_inc ] ) ;
									mysql_tquery ( sql_connection, string ) ;

									insert_debtor_message ( "Бизнес", "Вам завезли продукты в бизнес и в бизнесе не хватило средств для оплаты продукции.\nСчёт за продукты добавлен Вам в виде налога.", b_info [ b ] [ b_owner_inc ] ) ;
							    }
							}
							else
							{
								b_info [ b ] [ b_money ] -= order_products * order_price ;

								string [ 0 ] = EOS ;
								format ( string, sizeof ( string ), "UPDATE `businesses` SET `b_money` = '%d' WHERE `b_id` = '%d' LIMIT 1", b_info [ b ] [ b_money ], b ) ;
								mysql_tquery ( sql_connection, string ) ;
							}

							give_event_progress ( playerid, THE_DELIVERY, order_products ) ;
							give_event_progress ( playerid, THE_FUEL_DELIVERY, order_products ) ;
							break ;
						}
					}
					else if ( p_info [ playerid ] [ job ] == job_fuel_delivery )
					{
						for ( new b = 0 ; b < b_count ; b ++ )
						{
						    if ( b_info [ b ] [ b_type ] != bizz_type_gas ) continue ;
						    if ( b_info [ b ] [ b_maxproduct ] - 5000 < b_info [ b ] [ b_product ] ) continue ;
						    if ( ! IsPlayerInRangeOfPoint ( playerid, 5.0, b_info [ b ] [ b_position ] [ 0 ], b_info [ b ] [ b_position ] [ 1 ], b_info [ b ] [ b_position ] [ 2 ] ) ) continue ;

							new order_products = veh_info [ GetPlayerVehicleID ( playerid ) - 1 ] [ v_cargo ] ;
							b_info [ b ] [ b_product ] += order_products ;
							veh_info [ GetPlayerVehicleID ( playerid ) - 1 ] [ v_cargo ] = 0 ;

							new string [ 128 ], order_price = b_info [ b ] [ b_product_price ] ;
							format ( string, sizeof ( string ), "{"#cGInfo"}* {"#cWH"}Вы разгрузили {"#cGN"}%d/5000 кг.{"#cWH"} товара за {"#cGN"}%d"valute_title"{"#cWH"}.", order_products, order_products * order_price ) ;
							SendClientMessage ( playerid, col_white, string ) ;

							new _pay = ( order_products * order_price ) + ( order_products * 3 ) ;
							give_money ( playerid, _pay ) ;
							insert_money_log ( playerid, INVALID_PLAYER_ID, _pay, "доставка товаров" ) ;

							if ( b_info [ b ] [ b_money ] < order_products * order_price )
							{
							    new _pl_id ;
							    sscanf ( b_info [ b ] [ b_owner_name ], "u", _pl_id ) ;
							    if ( IsPlayerConnected ( _pl_id ) )
							    {
							        SendClientMessage ( playerid, col_red, !"* Вам завезли продукты в бизнес и в бизнесе не хватило средств для оплаты продукции." ) ;
							        SendClientMessage ( playerid, col_red, !"* Счёт за продукты добавлен Вам в виде налога." ) ;

							        p_info [ _pl_id ] [ tax ] += order_products * order_price ;
							        update_int_sql ( _pl_id, "u_tax", p_info [ _pl_id ] [ tax ] ) ;
							    }
							    else
							    {
									string [ 0 ] = EOS ;
							        format ( string, 100, "UPDATE `users` SET `u_tax` = `u_tax`+'%d' WHERE `u_id` = '%d' LIMIT 1", order_products * order_price, b_info [ b ] [ b_owner_inc ] ) ;
									mysql_tquery ( sql_connection, string ) ;

									insert_debtor_message ( "Бизнес", "Вам завезли продукты в бизнес и в бизнесе не хватило средств для оплаты продукции.\nСчёт за продукты добавлен Вам в виде налога.", b_info [ b ] [ b_owner_inc ] ) ;
							    }
							}
							else
							{
								b_info [ b ] [ b_money ] -= order_products * order_price ;

								string [ 0 ] = EOS ;
								format ( string, sizeof ( string ), "UPDATE `businesses` SET `b_money` = '%d' WHERE `b_id` = '%d' LIMIT 1", b_info [ b ] [ b_money ], b ) ;
								mysql_tquery ( sql_connection, string ) ;
							}

							give_event_progress ( playerid, THE_DELIVERY, order_products ) ;
							give_event_progress ( playerid, THE_FUEL_DELIVERY, order_products ) ;
							break ;
						}
					}
				}
			}
		}
	}
	if ( newkeys & KEY_FIRE )
	{
  		if ( is_gym_training { playerid } > 1 )
		{
		    if ( GetPlayerWeapon ( playerid ) != 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}С оружием в руках нельзя тренироваться." ) ;
		    for ( new i = 0 ; i < max_gym_pear ; i ++ )
			{
			    if ( ! IsPlayerInRangeOfPoint ( playerid, 1, gym_pear_position [ i ] [ 0 ], gym_pear_position [ i ] [ 1 ], gym_pear_position [ i ] [ 2 ] ) ) continue ;

			    new chose_style = is_gym_training { playerid } - 1 ;
				if ( ! chose_style ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не начали тренировку стилей." ) ;
				if ( p_info [ playerid ] [ u_style ] [ chose_style - 1 ] < 1000 )
				{
					if ( p_t_info [ playerid ] [ gym_click ] >= 10 )
					{
						p_info [ playerid ] [ u_style ] [ chose_style - 1 ] ++ ;
						if ( chose_style == 1 )
						{
							GameTextForPlayer ( playerid, "~n~~n~~n~~n~~n~~n~~n~~n~~w~ BOXING ~g~+1", 3000, 3 ) ;
							SetPlayerFightingStyles ( playerid ) ;

							update_int_sql ( playerid, "u_style0", p_info [ playerid ] [ u_style ] [ 0 ] ) ;

							checking_quest_progress ( playerid, 1, 1, quest_line_medium ) ;
						}
						else if ( chose_style == 2 )
						{
							GameTextForPlayer ( playerid, "~n~~n~~n~~n~~n~~n~~n~~n~~w~ KUNG FU ~g~+1", 3000, 3 ) ;
							SetPlayerFightingStyles ( playerid ) ;

							update_int_sql ( playerid, "u_style1", p_info [ playerid ] [ u_style ] [ 1 ] ) ;

							checking_quest_progress ( playerid, 1, 1, quest_line_medium ) ;
						}
						p_t_info [ playerid ] [ gym_click ] = 0 ;
					}
					else p_t_info [ playerid ] [ gym_click ] ++ ;
				}
			}
		}
		else SetPlayerFightingStyles ( playerid ) ;
	}

	if(newkeys & KEY_WALK)
	{
		if ( admin_info [ playerid ] [ spectate_id ] != -1 ) return SelectTextDraw( playerid, 0xB0C4DEFF ) ;
	}

	if(newkeys & KEY_SPRINT)
	{
	    if ( rieltore_opened [ playerid ] )
		{
			toggle_controlable ( playerid, true ) ;
            TogglePlayerSpectating ( playerid, false ) ;

            if ( p_t_info [ playerid ] [ camera_timer ] != -1 )
			{
            	KillTimer ( p_t_info [ playerid ] [ camera_timer ] ) ;
				p_t_info [ playerid ] [ camera_timer ] = -1 ;
			}
			return 1 ;
		}
	}

	if ( newkeys & KEY_CTRL_BACK )
	{
		if ( p_t_info [ playerid ] [ t_robbery ] != -1 )
		{
		    new _team = p_t_info [ playerid ] [ t_robbery ] ;
		   	if ( bank_progress [ _team ] != 4 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Ваша команда ещё не собрала все нужные компоненты." ) ;

			if ( GetPlayerVirtualWorld ( playerid ) != bank_world [ _team ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Это не тот банк, который Вы должны грабить." ) ;

			for ( new i = 0 ; i < MAX_BANKS ; i ++ )
			{
				if ( robbery_door_open [ i ] ) continue ;
  				if ( ! IsPlayerInRangeOfPoint ( playerid, 5, robbery_doors [ i ] [ 0 ], robbery_doors [ i ] [ 1 ], robbery_doors [ i ] [ 2 ] ) ) continue ;
      			foreach(new t: robbery_team[_team])
			    {
					if ( action_type { t } == ACTION_BANK ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Кто-то уже взламывает дверь." ) ;

					#if defined m_action
						if ( player_device { playerid } == 2 )
					 	{
							action_type { playerid } = ACTION_BANK ;
						    actionShow ( playerid, "Взлом хранилища", 100 ) ;
					        return 1 ;
			    		}
					#endif

					action_type { playerid } = ACTION_BANK ;
					action_step { playerid } = 0 ;
					action_td_status ( playerid, true ) ;
					return 1 ;
			    }
			}
		}

		#if defined m_prison
		    if ( prison_KeyStateChange ( playerid, newkeys, oldkeys ) ) return 1 ;
		#endif

		if ( used_area [ playerid ] != -1 )
		{
		    new _area_id = used_area [ playerid ], _area_type = area_info [ _area_id ] [ a_type ] ;
			if ( _area_type == area_type_graffity )
			{
			    new _id = area_info [ _area_id ] [ a_item ] ;
			    if ( p_t_info [ playerid ] [ graffity ] != -1 ) return 1 ;
				if ( ! gang_player ( playerid ) ) return 1 ;
				if ( p_info [ playerid ] [ member ] == graf_info [ _id ] [ g_member ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Это граффити принадлежит Вашей банде." ) ;
				if ( GetPlayerWeapon ( playerid ) != 41 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас нет балончика, приобретите его в магазине 24/7." ) ;
				if ( GetPlayerAmmo ( playerid ) < 500 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас не хватает краски в балончике. (1 граффити = 500 ед. балончика)");

				if ( GetPlayerAmmo ( playerid ) == 500 )
				{
				    set_player_ammo ( playerid, 41, 0 ) ;
					SetPlayerArmedWeapon ( playerid, 0 ) ;
				}
				else set_player_ammo ( playerid, 41, GetPlayerAmmo ( playerid ) - 500 ) ;

				p_t_info [ playerid ] [ graffity ] = _id ;

				#if defined m_action
					if ( player_device { playerid } == 2 )
					{
						action_type { playerid } = ACTION_GRAFFITY ;
					    actionShow ( playerid, "Граффити", 100 ) ;
				        return 1 ;
			   		}
				#endif

				SendClientMessage ( playerid, col_gray, !"{"#cGInfo"}* {"#cGRInfo"}Вы начали рисовать граффити. Нажимайте на кнопки, которые высвечиваются у Вас на экране." ) ;

				action_type { playerid } = ACTION_GRAFFITY ;
				action_step { playerid } = 0 ;
				action_td_status ( playerid, true ) ;

				ApplyAnimation ( playerid, "SPRAYCAN", "spraycan_full", 4.0, 1, 1, 1, 0, 0, 1 ) ;
				return 1 ;
			}
			else if ( _area_type == area_type_barriers )
			{
				new j = area_info [ _area_type ] [ a_item ] ;
				if ( mafia_player ( playerid ) || gang_player ( playerid ) )
				{
				    if ( action_type { playerid } != ACTION_ARMY_GATE )
				    {
						#if defined m_action
						    if ( player_device { playerid } == 2 )
						    {
								action_type { playerid } = ACTION_ARMY_GATE ;
							    actionShow ( playerid, "Взлом ворот", 100 ) ;
						        return 1 ;
						    }
						#endif

						action_type { playerid } = ACTION_ARMY_GATE ;
						action_step { playerid } = 0 ;
						action_td_status ( playerid, true ) ;
						return 1 ;
					}
				}
				for ( new i = 0 ; i < 4 ; i ++ )
				{
				    if ( p_info [ playerid ] [ member ] != barrier_pos [ j ] [ fraction_bar ] [ i ] ) continue ;
					if ( barrier_status [ j ] == true ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Барьер уже поднят!" ) ;

					barrier_status [ j ] = true ;
                    MoveDynamicObject ( barrier_object [ j ],
										barrier_pos [ j ] [ open_bar ] [ 0 ],
										barrier_pos [ j ] [ open_bar ] [ 1 ],
										barrier_pos [ j ] [ open_bar ] [ 2 ],
										barrier_pos [ j ] [ speed_bar ],
										barrier_pos [ j ] [ open_bar ] [ 3 ],
										barrier_pos [ j ] [ open_bar ] [ 4 ],
										barrier_pos [ j ] [ open_bar ] [ 5 ] ) ;

					SetTimerEx("barrier_callback", 10000, 0, "i", j ) ;
					if ( barrier_pos [ j ] [ double_bar_id ] != -1 )
					{
					    new _double_bar_id = barrier_pos [ j ] [ double_bar_id ] ;
						MoveDynamicObject ( barrier_object [ _double_bar_id ],
											barrier_pos [ _double_bar_id ] [ open_bar ] [ 0 ],
											barrier_pos [ _double_bar_id ] [ open_bar ] [ 1 ],
											barrier_pos [ _double_bar_id ] [ open_bar ] [ 2 ],
											barrier_pos [ _double_bar_id ] [ speed_bar ],
											barrier_pos [ _double_bar_id ] [ open_bar ] [ 3 ],
											barrier_pos [ _double_bar_id ] [ open_bar ] [ 4 ],
											barrier_pos [ _double_bar_id ] [ open_bar ] [ 5 ] ) ;
						SetTimerEx("barrier_callback", 10000, 0, "i", _double_bar_id ) ;
					}

					SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Барьер опустится в течение {"#cBL"}10 секунд{"#cGRInfo"}." ) ;
					return 1 ;
				}
			}
			else if ( _area_type == area_type_doors )
			{
			    new _item = area_info [ _area_type ] [ a_item ] ;
				for ( new i = 0 ; i < 4 ; i ++ )
				{
				    if ( p_info [ playerid ] [ member ] != door_pos [ _item ] [ fraction_doors ] [ i ] ) continue ;

				    if ( door_status [ _item ] == true ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Дверь уже открыта!" ) ;

					door_status [ _item ] = true ;
					MoveDynamicObject ( door_object [ _item ],
										door_pos [ _item ] [ open_doors ] [ 0 ],
										door_pos [ _item ] [ open_doors ] [ 1 ],
										door_pos [ _item ] [ open_doors ] [ 2 ],
										door_pos [ _item ] [ speed_doors ],
										door_pos [ _item ] [ open_doors ] [ 3 ],
										door_pos [ _item ] [ open_doors ] [ 4 ],
										door_pos [ _item ] [ open_doors ] [ 5 ] ) ;

					SetTimerEx("door_callback", 10000, 0, "i", _item ) ;
					if ( door_pos [ _item ] [ double_doors_id ] != -1 )
					{
					    new _double_doors_id = door_pos [ _item ] [ double_doors_id ] ;
						MoveDynamicObject ( door_object [ _double_doors_id ],
											door_pos [ _double_doors_id ] [ open_doors ] [ 0 ],
											door_pos [ _double_doors_id ] [ open_doors ] [ 1 ],
											door_pos [ _double_doors_id ] [ open_doors ] [ 2 ],
											door_pos [ _double_doors_id ] [ speed_doors ],
											door_pos [ _double_doors_id ] [ open_doors ] [ 3 ],
											door_pos [ _double_doors_id ] [ open_doors ] [ 4 ],
											door_pos [ _double_doors_id ] [ open_doors ] [ 5 ] ) ;
						SetTimerEx("door_callback", 10000, 0, "i", _double_doors_id ) ;
					}

					SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Дверь закроется в течении {"#cBL"}10 секунд{"#cGRInfo"}." ) ;
					return 1 ;
				}
			}
		}
	}
	return 1 ;
}

public OnPlayerStateChange ( playerid, newstate, oldstate )
{
	#if defined debug_mode
		printf ( "[DEBUG] [OnPlayerStateChange] playerid:%d | newstate:%d | oldstate:%d", playerid, newstate, oldstate ) ;
	#endif

	//ac_OnPlayerStateChange ( playerid, newstate, oldstate ) ;

	/*if ( eev_called { playerid } == 0 && newstate == PLAYER_STATE_DRIVER )
	{
		new vehicle_id = GetPlayerVehicleID ( playerid ) ;
		SetVehiclePos ( vehicle_id, veh_info [ vehicle_id - 1 ] [ v_pos ] [ 0 ], veh_info [ vehicle_id - 1 ] [ v_pos ] [ 1 ], veh_info [ vehicle_id - 1 ] [ v_pos ] [ 2 ] ) ;

		anti_cheat ( playerid, "tp in car", 98 ) ;
	}*/
	if ( newstate == PLAYER_STATE_DRIVER )
    {
    	if ( ( GetTickCount ( ) - GetPVarInt ( playerid, "cartime" ) ) < 1000 )
    	{
            SetPVarInt ( playerid, "carspam", GetPVarInt ( playerid, "carspam" ) + 1 ) ;
            if ( GetPVarInt ( playerid, "carspam" ) >= 5 )
			{
            	return anti_cheat ( playerid, "car flood", 199 ) ;
            }
        }
        SetPVarInt ( playerid, "cartime", GetTickCount ( ) ) ;
    }
	if ( oldstate == PLAYER_STATE_DRIVER || oldstate == PLAYER_STATE_PASSENGER )
	{
		new Float:x, Float:y, Float:z;
		GetPlayerPos(playerid, x, y, z);
		new Float:dif = GetDistanceBetweenPoints(x, y, 0.0, p_t_info [playerid][ old_pos ][0], p_t_info [playerid][ old_pos ][1], 0.0);
		if(dif < 100)
		{
			p_t_info [ playerid ] [ old_pos ] [ 0 ] = x ;
			p_t_info [ playerid ] [ old_pos ] [ 1 ] = y ;
			p_t_info [ playerid ] [ old_pos ] [ 2 ] = z ;
		}
	}
//	if ( p_t_info [ playerid ] [ p_logged ] == false && newstate != PLAYER_STATE_SPECTATING && GetPVarInt ( playerid, "nologin_nokick" ) == 0 ) return anti_cheat ( playerid, "nologged", 122 ) ;
	if((newstate == PLAYER_STATE_PASSENGER && oldstate == PLAYER_STATE_DRIVER) || (newstate == PLAYER_STATE_DRIVER && oldstate == PLAYER_STATE_PASSENGER)) return anti_cheat ( playerid, "Seat TP", 550 ) ;

	if ( newstate == PLAYER_STATE_PASSENGER && ( GetPlayerWeapon( playerid ) == 24 || GetPlayerWeapon( playerid ) == 25 ) ) SetPlayerArmedWeapon ( playerid, 0 ) ;
	foreach(new i: admin_players)
	{
		if ( admin_info [ i ] [ spectate_id ] == playerid )
		{
			switch ( GetPlayerState ( playerid ) )
			{
				case 1:
				{
					set_interior ( i, p_t_info [ playerid ][ p_data ] [ 0 ] ) ;
					set_world ( i, p_t_info [ playerid ][ p_data ] [ 1 ] ) ;
					TogglePlayerSpectating ( i, true ) ;
					PlayerSpectatePlayer ( i, playerid ) ;
				}
				case 2:
				{
					set_interior ( i, p_t_info [ playerid ][ p_data ] [ 0 ] ) ;
					set_world ( i, p_t_info [ playerid ][ p_data ] [ 1 ] ) ;
					new veh_id = GetPlayerVehicleID ( playerid ) ;
					TogglePlayerSpectating ( i, true ) ;
					PlayerSpectateVehicle ( i, veh_id ) ;
				}
				case 3:
				{
					set_interior ( i, p_t_info [ playerid ][ p_data ] [ 0 ] ) ;
					set_world ( i, p_t_info [ playerid ][ p_data ] [ 1 ] ) ;
					new veh_id = GetPlayerVehicleID ( playerid ) ;
					TogglePlayerSpectating ( i, true ) ;
					PlayerSpectateVehicle ( i, veh_id ) ;
				}
			}
		}
	}

	switch ( newstate )
	{
		case PLAYER_STATE_PASSENGER:
		{
			remove_timer { playerid } = 0 ;
			new _v_id = GetPlayerVehicleID ( playerid ) ;
			player_last_car [ playerid ] = _v_id ;

			if ( veh_info [ _v_id - 1 ] [ v_type ] == vehicle_type_job && veh_info [ _v_id - 1 ] [ v_owner ] == job_bus && veh_info [ _v_id - 1 ] [ v_driver ] != INVALID_PLAYER_ID )
			{
				new driverid = veh_info [ _v_id - 1 ] [ v_driver ] ;
				if ( player_rentcar [ driverid ] != _v_id || ! p_t_info [ driverid ] [ pBusPrice ] ) return 1 ;
				new price = p_t_info [ driverid ] [ pBusPrice ] ;

				if ( p_info [ playerid ] [ money ] < price ) return me_action ( playerid, "показал(а) проездной водителю" ) ;
				give_money ( driverid, price ) ;
				give_money ( playerid, -price ) ;
				insert_money_log ( driverid, playerid, price, "bus driver" ) ;

				new string [ 9 ] ;
				format ( string, sizeof ( string ), "~b~+%i$", price ) ;
				GameTextForPlayer ( driverid, string, 1000, 1 ) ;
				format ( string, sizeof ( string ), "~r~-%i$", price ) ;
				GameTextForPlayer ( playerid, string, 1000, 1 ) ;
			}

			new driverid = veh_info [ _v_id - 1 ] [ v_driver ] ;
			if ( driverid != INVALID_PLAYER_ID )
			{
			    if ( p_t_info [ driverid ] [ car_audio ] )
			    {
			        new get_station [ 128 ] ;
					GetPVarString ( driverid, "BBStation", get_station, 128 ) ;
					if ( ! isnull ( get_station ) )
					{
						if ( IsPlayerAttachedObjectSlotUsed ( playerid, 1 ) ) RemovePlayerAttachedObject ( playerid, 1 ), StopAudioStreamForPlayer ( playerid ) ;
					    PlayAudioStreamForPlayer ( playerid, get_station ) ;
						SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}В транспорте включена аудио-система." ) ;
					}
				}
			}
		}
		case PLAYER_STATE_DRIVER:
		{
			if ( GetTickCount ( ) - opev_opsc_time_differ [ playerid ] < 600 && ! v_boat ( GetPlayerVehicleID ( playerid ) ) ) anti_cheat ( playerid, "tp in car", 96 ) ;
			SetPlayerArmedWeapon ( playerid, 0 ) ;
			remove_timer { playerid } = 0 ;
			new veh_id = GetPlayerVehicleID ( playerid ), _v_model = GetVehicleModelEx ( veh_id ) ;
			player_vehicle [ playerid ] = veh_id ;
			player_last_car [ playerid ] = veh_id ;

			veh_info [ veh_id - 1 ] [ v_driver ] = playerid ;

			if ( exam_vehicle [ playerid ] == veh_id || veh_id == p_t_info [ playerid ] [ pl_quest ] )
			{
				is_leave_exam_vehicle { playerid } =
				is_leave_quest_vehicle { playerid } = 0 ;
			}

			if ( _v_model == 416 || _v_model == 433 || _v_model == 482 || _v_model == 548 || _v_model == 416 )
			{
                clear_check_info ( playerid, CINFO_FRACTION_GUNS_ID ) ;
			}

	  		if ( v_boat ( veh_id ) && p_info [ playerid ] [ boat_lic ] == 0 && exam_start [ playerid ] == false )
			{
   				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас нет лицензии на водный транспорт." ) ;
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Для приобретения обратитесь к сотрудникам автошколы (/dir)." ) ;
				RemovePlayerFromVehicle ( playerid ) ;
				return 1 ;
			}

			if ( v_plane ( veh_id ) )
			{
			    if ( p_info [ playerid ] [ hour_played ] < FIVE_HOUR_PLAYED ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Управление воздушным транспортом доступно с 5 часов в игре." ) ;

				if ( p_info [ playerid ] [ fly_lic ] == 0 && exam_start [ playerid ] == false )
				{
				    SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас нет лицензии на воздушный транспорт." ) ;
					SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Для приобретения обратитесь к сотрудникам автошколы (/dir)." ) ;
					RemovePlayerFromVehicle ( playerid ) ;
					return 1 ;
				}
			}

			if ( driving_license ( veh_id ) && p_info [ playerid ] [ drive_lic ] == 0 && exam_start [ playerid ] == false )
			{
			    SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас нет водительских прав." ) ;
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Для приобретения обратитесь к сотрудникам автошколы (/dir)." ) ;
				RemovePlayerFromVehicle ( playerid ) ;
				return 1 ;
			}

			new _v_type = veh_info [ veh_id - 1 ] [ v_type ] ;

			if ( _v_type == vehicle_type_family )
			{
				#if defined m_familys
				    if ( familys_OnPlayerStateChange ( playerid, newstate, oldstate ) ) return 1 ;
				#endif

				if ( p_info [ playerid ] [ family ] > 0 )
				{
					new _vmodel = GetVehicleModel ( veh_id ) ;
					if ( _vmodel == 482 )
					{
					    if ( veh_info [ veh_id - 1 ] [ v_loading ] > 0 )
					    {
					        veh_info [ veh_id - 1 ] [ v_loading ] = 0 ;
							if ( IsValidDynamic3DTextLabel ( veh_info [ veh_id - 1 ] [ v_label ] ) )
							{
								DestroyDynamic3DTextLabel ( veh_info [ veh_id - 1 ] [ v_label ] ) ;
								veh_info [ veh_id - 1 ] [ v_label ] = Text3D:INVALID_3DTEXT_ID ;
						 	}

							if ( IsValidDynamicPickup ( veh_info [ veh_id - 1 ] [ v_pickup ] ) )
							{
								DestroyDynamicPickup ( veh_info [ veh_id - 1 ] [ v_pickup ] ) ;
								veh_info [ veh_id - 1 ] [ v_pickup ] = INVALID_PICKUP_ID ;
							}
							SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cWH"}Загрузка транспорта завершена." ) ;
					    }
					    if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Выберите действие с грузовиком:", 2, 5, CINFO_FRACTION_GUNS_ID, PICTURE_INFO_WARNING, "Загрузка", "Разгрузка" ) ;
					}
				}
			}

			else if ( _v_type == vehicle_type_job && veh_info [ veh_id - 1 ] [ v_model ] == 462 && player_rentcar [ playerid ] != veh_id )
			{
   				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данный мопед арендован другим игроком." ) ;
				RemovePlayerFromVehicle ( playerid ) ;
				return 1 ;
			}

			else if ( _v_type == vehicle_type_server )
			{
				if ( veh_info [ veh_id - 1 ] [ v_owner ] != p_info [ playerid ] [ member ] && veh_info [ veh_id - 1 ] [ v_owner ] != is_fraction_cover { playerid } )
				{
				    if ( veh_info [ veh_id - 1 ] [ v_owner ] == 10 && exam_start [ playerid ] == true )
				    {
				        exam_vehicle [ playerid ] = veh_id ;
				    	exam_cp_number { playerid } = 1 ;
						SetPlayerRaceCheckpoint ( playerid, 0, ds_checkpoints [ 0 ] [ 0 ], ds_checkpoints [ 0 ] [ 1 ], ds_checkpoints [ 0 ] [ 2 ] - 1, ds_checkpoints [ 1 ] [ 0 ], ds_checkpoints [ 1 ] [ 1 ], ds_checkpoints [ 1 ] [ 2 ], 4.0);
				        return 1 ;
					}

					RemovePlayerFromVehicle ( playerid ) ;
					SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Этот транспорт недоступен для Вас." ) ;
					return 1 ;
				}

				if ( veh_info [ veh_id - 1 ] [ v_rank ] > p_info [ playerid ] [ rank ] )
				{
					RemovePlayerFromVehicle ( playerid ) ;

					new _t_string [ 64 ] ;
					format ( _t_string, sizeof _t_string, "{"#cRInfo"}* {"#cGRInfo"}Транспорт доступен с {"#cRD"}%d{"#cGRInfo"} ранга.", veh_info [ veh_id - 1 ] [ v_rank ] ) ;
					SendClientMessage ( playerid, col_gray, _t_string ) ;
					return 1 ;
				}

				if ( veh_info [ veh_id - 1 ] [ v_subleader ] )
				{
				    if ( veh_info [ veh_id - 1 ] [ v_subleader ] != p_info [ playerid ] [ subleader ] )
				    {
						RemovePlayerFromVehicle ( playerid ) ;

						new _t_string [ 128 ] ;
						format ( _t_string, sizeof _t_string, "{"#cRInfo"}* {"#cGRInfo"}Транспорт доступен для подразделения {"#cRD"}%s{"#cGRInfo"}.", unit_info [ veh_info [ veh_id - 1 ] [ v_subleader ] - 1 ] [ un_name ] ) ;
						SendClientMessage ( playerid, col_gray, _t_string ) ;
						return 1 ;
					}
				}

				if ( gang_player ( playerid ) || mafia_player ( playerid ) )
				{
					new _vmodel = GetVehicleModel ( veh_id ) ;
					if ( _vmodel == 482 )
					{
					    if ( veh_info [ veh_id - 1 ] [ v_loading ] > 0 )
					    {
					        veh_info [ veh_id - 1 ] [ v_loading ] = 0 ;
							if ( IsValidDynamic3DTextLabel ( veh_info [ veh_id - 1 ] [ v_label ] ) )
							{
								DestroyDynamic3DTextLabel ( veh_info [ veh_id - 1 ] [ v_label ] ) ;
								veh_info [ veh_id - 1 ] [ v_label ] = Text3D:INVALID_3DTEXT_ID ;
						 	}

							if ( IsValidDynamicPickup ( veh_info [ veh_id - 1 ] [ v_pickup ] ) )
							{
								DestroyDynamicPickup ( veh_info [ veh_id - 1 ] [ v_pickup ] ) ;
								veh_info [ veh_id - 1 ] [ v_pickup ] = INVALID_PICKUP_ID ;
							}
							SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cWH"}Загрузка транспорта завершена." ) ;
					    }
					    if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Выберите действие с грузовиком:", 2, 5, CINFO_FRACTION_GUNS_ID, PICTURE_INFO_WARNING, "Загрузка", "Разгрузка" ) ;
					}
				}

				if ( medic_player ( playerid ) )
				{
					new _vmodel = GetVehicleModel ( veh_id ) ;
					if ( _vmodel == 416 )
					{
					    if ( veh_info [ veh_id - 1 ] [ v_loading ] > 0 )
					    {
					        veh_info [ veh_id - 1 ] [ v_loading ] = 0 ;
							if ( IsValidDynamic3DTextLabel ( veh_info [ veh_id - 1 ] [ v_label ] ) )
							{
								DestroyDynamic3DTextLabel ( veh_info [ veh_id - 1 ] [ v_label ] ) ;
								veh_info [ veh_id - 1 ] [ v_label ] = Text3D:INVALID_3DTEXT_ID ;
						 	}

							if ( IsValidDynamicPickup ( veh_info [ veh_id - 1 ] [ v_pickup ] ) )
							{
								DestroyDynamicPickup ( veh_info [ veh_id - 1 ] [ v_pickup ] ) ;
								veh_info [ veh_id - 1 ] [ v_pickup ] = INVALID_PICKUP_ID ;
							}
							SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cWH"}Загрузка транспорта завершена." ) ;
					    }
					    if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Выберите действие с грузовиком:", 2, 5, CINFO_FRACTION_GUNS_ID, PICTURE_INFO_WARNING, "Загрузка", "Разгрузка" ) ;
					}
				}

				if ( army_player ( playerid ) )
				{
					new _vmodel = GetVehicleModel ( veh_id ) ;
				    if ( _vmodel == 520 || _vmodel == 425 || _vmodel == 432 )
					{
						if ( WorkSalary [ 3 ] )
						{
							RemovePlayerFromVehicle ( playerid ) ;
							SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}В данный момент использование тяжёлой военной техники запрещено." ) ;
							return 1 ;
						}
					}

					if ( _vmodel == 433 || _vmodel == 482 )
					{
					    if ( veh_info [ veh_id - 1 ] [ v_loading ] > 0 )
					    {
					        veh_info [ veh_id - 1 ] [ v_loading ] = 0 ;
							if ( IsValidDynamic3DTextLabel ( veh_info [ veh_id - 1 ] [ v_label ] ) )
							{
								DestroyDynamic3DTextLabel ( veh_info [ veh_id - 1 ] [ v_label ] ) ;
								veh_info [ veh_id - 1 ] [ v_label ] = Text3D:INVALID_3DTEXT_ID ;
						 	}

							if ( IsValidDynamicPickup ( veh_info [ veh_id - 1 ] [ v_pickup ] ) )
							{
								DestroyDynamicPickup ( veh_info [ veh_id - 1 ] [ v_pickup ] ) ;
								veh_info [ veh_id - 1 ] [ v_pickup ] = INVALID_PICKUP_ID ;
							}
							SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cWH"}Загрузка транспорта завершена." ) ;
					    }
					    if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Выберите действие с грузовиком:", 2, 5, CINFO_FRACTION_GUNS_ID, PICTURE_INFO_WARNING, "Загрузка", "Разгрузка" ) ;
						else
						{
						    if ( army_player ( playerid ) ) show_dialog ( playerid, d_armpanel_load, DIALOG_STYLE_LIST, "{"#cBHD"}Загрузка оружия", "{"#cBL"}1.{"#cWH"} Загрузка с подлодки\n{"#cBL"}2.{"#cWH"} Загрузка со склада", "Выбрать", "Назад" ) ;
						}
					}
					else if ( _vmodel == 548 )
					{
					    if ( submarine_number == -1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}В данный момент подлодка не находиться в заливе." ) ;

                        if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Выберите действие с военным вертолётом:", 2, -1, CINFO_FRACTION_GUNS_ID, PICTURE_INFO_WARNING, "Прицепить", "Отцепить" ) ;
						else
						{
							SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Отправляйтесь к подлодке и зацепите один из армейских контейнеров." ) ;
							SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Для зацепки контейнера используйте клавишу {"#cGN"}Y{"#cWH"}." ) ;
						}

      					for ( new i = 0 ; i < MAX_POSITION_SUBMARINE * 2 ; i ++ )
						{
							if ( army_container_object [ i ] == 0 ) continue ;

                            SetPlayerRaceCheckpoint ( playerid, 1, army_container_pos [ i ] [ 0 ], army_container_pos [ i ] [ 1 ], army_container_pos [ i ] [ 2 ], 0.0, 0.0, 0.0, 2.0 ) ;
							break ;
						}
						is_gps_used { playerid } = 1 ;
					}
				}

				if ( cop_player ( playerid ) || fbi_player ( playerid ) )
				{
				    if ( veh_info [ veh_id - 1 ] [ v_owner ] == p_info [ playerid ] [ member ] )
				    {
				        SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Введите {"#cBL"}'/comp'{"#cGRInfo"}, чтобы включить служебный компьютер." ) ;
				    }
				}
			}

            else if ( _v_type == vehicle_type_farm )
			{
				if ( b_info [ mafia_farm_id - 1 ] [ b_mafia ] != p_info [ playerid ] [ member ] )
				{
					RemovePlayerFromVehicle ( playerid ) ;
					SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Этот транспорт недоступен для Вас." ) ;
					return 1 ;
				}
			}

			else if ( _v_type == vehicle_type_rentcar && player_rentcar [ playerid ] != veh_id )
			{
			    if ( p_info [ playerid ] [ job ] != job_incass && p_info [ playerid ] [ business ] != veh_info [ veh_id - 1 ] [ v_owner ] && veh_info [ veh_id - 1 ] [ v_model ] == incass_model_id && incass_player_rool [ playerid ] == 0 )
			    {
					RemovePlayerFromVehicle ( playerid ) ;
					SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Этот транспорт недоступен для Вас." ) ;
					return 1 ;
				}

				if ( p_info [ playerid ] [ business ] != veh_info [ veh_id - 1 ] [ v_owner ] )
					show_rent_car ( playerid, veh_info [ veh_id - 1 ] [ v_rent_price ] ) ;
				return 1 ;
			}

			else if ( _v_type == vehicle_type_job && player_rentcar [ playerid ] != veh_id )
			{
			    new _v_owner = veh_info [ veh_id - 1 ] [ v_owner ] ;
				if ( _v_owner != p_info [ playerid ] [ job ] && _v_owner != p_info [ playerid ] [ timejob ] && veh_info [ veh_id - 1 ] [ v_model ] != 462 )
				{
					static const job_status [ 10 ] [ 24 ] =
					{
						"водителем автобуса",
						"таксистом",
						"механиком",
						"дальнобойщиком",
						"развозчиком продуктов",
						"развозчиком топлива",
						"инкассатором",
						"пожарным",
						"мореплавателем",
						"вертолетчиком"
					} ;

					RemovePlayerFromVehicle ( playerid ) ;

					new _t_string [ 86 ] ;
					format ( _t_string, sizeof _t_string, "{"#cRInfo"}* {"#cGRInfo"}Вы не работаете {"#cRD"}%s{"#cGRInfo"}.", job_status [ _v_owner - 1 ] ) ;
					SendClientMessage ( playerid, col_gray, _t_string ) ;
					return 1 ;
				}
			}

			else if ( _v_type == vehicle_type_carmarket )
			{
				RemovePlayerFromVehicle ( playerid ) ;
			    SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данный транспорт выставлен на продажу, на нём нельзя ездить." ) ;
			    SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Для покупки используйте {"#cRInfo"}ALT{"#cGRInfo"} или {"#cRInfo"}иконку т/с в блоке кнопок{"#cGRInfo"}." ) ;
				return 1 ;
			}

			create_speedometr ( playerid ) ;
		}
	}
	if ( oldstate == PLAYER_STATE_DRIVER )
    {
		if ( StartRace == 2 )
		{
			if ( is_player_race_regged [ playerid ] )
			{
				DestroyVehicle ( player_race_vehicle [ playerid ], 60 ) ;
				new ch = player_race_cp [ playerid ] > 2 ? ( player_race_cp [ playerid ] - 2 ) : ( 0 ) ;
				if ( player_race_first_cp [ playerid ] >= 2 )
				{
				    set_race_pos ( playerid, race_info [ ch ] [ race_position ] [ 0 ], race_info [ ch ] [ race_position ] [ 1 ], race_info [ ch ] [ race_position ] [ 2 ], race_info [ ch ] [ race_position ] [ 3 ], 0, 0 ) ;
				    player_race_vehicle [ playerid ] = CreateVehicle ( RaceVehicle, race_info [ ch ] [ race_position ] [ 0 ], race_info [ ch ] [ race_position ] [ 1 ], race_info [ ch ] [ race_position ] [ 2 ], race_info [ ch ] [ race_position ] [ 3 ], random ( 126 ), random ( 126 ), -1 ) ;
				}
				else
				{
					set_race_pos ( playerid, race_info [ 0 ] [ race_position ] [ 0 ], race_info [ 0 ] [ race_position ] [ 1 ], race_info [ 0 ] [ race_position ] [ 2 ], race_info [ 0 ] [ race_position ] [ 3 ], 0, 0 ) ;
				    player_race_vehicle [ playerid ] = CreateVehicle ( RaceVehicle, race_info [ 0 ] [ race_position ] [ 0 ], race_info [ 0 ] [ race_position ] [ 1 ], race_info [ 0 ] [ race_position ] [ 2 ], race_info [ 0 ] [ race_position ] [ 3 ], random ( 126 ), random ( 126 ), -1 ) ;
				}
				new carrac = player_race_vehicle [ playerid ] ;
				SetVehicleVirtualWorld ( carrac, 0 ) ;
				LinkVehicleToInterior ( carrac, 0 ) ;
				PutPlayerInVehicle ( playerid, carrac, 0 ) ;
				SetVehicleParamsEx ( carrac, 1, 1, 0, 1, 0, 0, 0 ) ;
				return 1 ;
			}
		}
    }
	return 1 ;
}

public OnPlayerEnterDynamicArea ( playerid, areaid )
{
	if ( p_t_info [ playerid ] [ p_logged ] == false ) return false ;
	#if defined debug_mode
		printf ( "[DEBUG] [OnPlayerEnterDynamicArea] playerid: %d | areaid:%d", playerid, areaid ) ;
	#endif

	used_area [ playerid ] = areaid ;

	#if defined m_quest
	    if ( quest_OnPlayerEnterDynamicArea ( playerid, areaid ) ) return 1 ;
	#endif

	#if defined m_treasure
	    if ( tr_EnterDynamicArea ( playerid, areaid ) ) return 1 ;
	#endif

	#if defined m_jobs_module
	    if ( trucker_EnterDynamicArea ( playerid, areaid ) ) return 1 ;
	#endif

	#if defined m_fishing
	    if ( fishing_EnterDynamicArea ( playerid, areaid ) ) return 1 ;
	#endif

	#if defined m_trash
	    if ( trash_EnterDynamicArea ( playerid, areaid ) ) return 1 ;
	#endif

	#if defined m_epass
	    if ( epass_EnterDynamicArea ( playerid, areaid ) ) return 1 ;
	#endif

	#if defined m_prison
	    if ( prison_EnterDynamicArea ( playerid, areaid ) ) return 1 ;
	#endif

	#if defined m_coin
	    if ( coin_EnterDynamicArea ( playerid, areaid ) ) return 1 ;
	#endif

	#if defined m_familys
	    if ( family_EnterDynamicArea ( playerid, areaid ) ) return 1 ;
 	#endif

 	#if defined m_inventory_module
 	    if ( market_EnterDynamicArea ( playerid, areaid ) ) return 1 ;
	#endif

	#if defined m_incass
	    if ( incass_EnterDynamicArea ( playerid, areaid ) ) return 1 ;
	#endif

	#if defined m_details_thief
		if ( thief_EnterDynamicArea ( playerid, areaid ) ) return 1 ;
	#endif

	#if defined m_winter
		if ( winter_EnterDynamicArea ( playerid, areaid ) ) return 1 ;
	#endif

	#if defined m_fractions
		if ( fractions_EnterDynamicArea ( playerid, areaid ) ) return 1 ;
	#endif

	if ( GetPlayerState ( playerid ) == PLAYER_STATE_ONFOOT )
	{
		switch ( area_info [ areaid ] [ a_type ] )
		{
		    case area_type_antidm:
		    {
		        if ( ! player_loaded { playerid } ) return 1 ;

		        if ( player_device { playerid } == 2 && p_info [ playerid ] [ hud_id ] ) SendCheckHud ( playerid ) ;
		        else
		        {
					if ( is_player_in_dmzone { playerid } == 1 ) return 1 ;

					is_player_in_dmzone { playerid } = 1 ;
				}
				SetPlayerArmedWeapon ( playerid, 0 ) ;
				return 1 ;
		    }
			case area_type_job_factory:
			{
				if ( p_info [ playerid ] [ timejob ] != job_factory ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Для начала необходимо устроиться на работу." ) ;
				if ( IsPlayerAttachedObjectSlotUsed ( playerid, 0 ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас уже есть что-то в руках." ) ;
				have_factory_box [ playerid ] = true ;
				SetPlayerAttachedObject ( playerid, 0, 3013, 6, 0.0, 0.10, -0.2, -110.0,0.0,78.0 ) ;
				SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы взяли ящик с заготовками. Отправляйтесь к столу для укомплектовки." ) ;
				ClearAnimations ( playerid ) ;
				p_t_info [ playerid ] [ p_animation ] = true ;
				ApplyAnimation ( playerid, "CARRY", "crry_prtial", 4.1, 0, 1, 1, 1, 1 ) ;

				for ( new i = 0 ; i < MAX_GUNWORK_TABLE ; i ++ )
				{
					if ( table_area_toggled [ i ] != INVALID_PLAYER_ID ) continue ;

					SetPlayerCheckpoint ( playerid, table_areas_pos [ i ] [ 0 ], table_areas_pos [ i ] [ 1 ], table_areas_pos [ i ] [ 2 ], 2.5 ) ;
					is_checkpoint_used { playerid } = 0 ;

					SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Место свободного стола отмечено на карте." ) ;
					break ;
				}
				return 1 ;
			}
			case area_type_factory_table:
			{
			    if ( p_info [ playerid ] [ timejob ] != job_factory ) return 1 ;
				if ( IsPlayerAttachedObjectSlotUsed ( playerid, 0 ) && ! have_factory_box [ playerid ] ) return 1 ;
				if ( ! have_factory_box [ playerid ] ) return 1 ;

				new i = area_info [ areaid ] [ a_item ] ;

				if ( table_area_toggled [ i ] != INVALID_PLAYER_ID ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данный стол уже занят другим рабочим." ) ;
				ClearAnimations ( playerid ) ;
				ApplyAnimation ( playerid, "CAR_CHAT", "CAR_Sc4_BL", 4.0, 1, 1, 1, 1, 5800, 0 ) ;
				p_t_info [ playerid ] [ p_animation ] = true ;

				job_timer [ playerid ] = SetTimerEx ( "main_jobs_timer",5800,false,"i",playerid ) ;
	            /*action_type { playerid } = ACTION_FACTORY ;
				action_step { playerid } = 0 ;
				action_td_status ( playerid, true ) ;*/

				have_factory_box [ playerid ] = false ;
				factory_table_id { playerid } = i ;

				DisablePlayerCheckpoint ( playerid ) ;
				is_checkpoint_used { playerid } = 0 ;

				SetPlayerAttachedObject ( playerid, 0, 18644,5, 0.078999,0.042999, -0.012999,-3.299995,0.000000,0.000000 ) ;
				SetPlayerAttachedObject ( playerid, 1, 18635,6 ) ;
				return 1 ;
			}
			case area_type_dorm:
			{
			    if ( p_info [ playerid ] [ member ] < 1 ) return 1 ;

				if ( areaid == dorm_area [ p_info [ playerid ] [ member ] - 1 ] )
				{
				    new fraction_id = p_info [ playerid ] [ member ] ;
				    if ( ! gang_player ( playerid ) && ! mafia_player ( playerid ) )
				    {
				        #if defined m_fractions
						    if ( cop_player ( playerid ) || fbi_player ( playerid ) ) give_emp_progress ( playerid, 2, 1 ) ;
						    else if ( army_player ( playerid ) ) give_emp_progress ( playerid, 5, 1 ) ;
						#endif

				        if ( p_info [ playerid ] [ rank ] < 2 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Оружейная доступна со 2 ранга." ) ;
						if ( is_fraction_duty { playerid } != 1 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не начали рабочий день." ) ;
						if ( p_info [ playerid ] [ hour_played ] < FIVE_HOUR_PLAYED ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Доступно с 5 часов в игре. Используйте /mm - Информация о персонаже - Статистика персонажа." ) ;

						#if defined m_inventory_module
						    used_inventory [ playerid ] = true ;
							toggle_controlable ( playerid, false ) ;

							new _str [ 32 ] ;
							SetInventoryItem ( playerid ) ;
							setInventoryLayout ( playerid, 1 ) ;
							setInventoryWarehouse ( playerid, SUB_INV_FRACTION, fraction_id ) ;
							set_inventory_button ( playerid, SUB_INV_FRACTION ) ;
							format ( _str, sizeof _str, "%s", GetPlayerCashValueToSmile ( f_info [ fraction_id - 1 ] [ f_money ] ) ) ;
							setWarehouseInfo (
								playerid,
								"Склад организации",
								"Здесь хранятся предметы, которые\nв организации",
								"ОРГАНИЗАЦИЯ",
								"ДЕНЕГ В ОРГАНИЗАЦИИ",
								f_info [ fraction_id - 1 ] [ f_name ],
								_str
							) ;
						#endif
				    }
				    else
				    {
					    if ( p_info [ playerid ] [ rank ] < f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 7 ] )
					    {
						    static const _str [ ] = "{"#cRInfo"}* {"#cGRInfo"}Общак доступен с ранга %s (%d)." ;
						    new scm_string [ sizeof _str + 30 + 4 ] ;
						    format ( scm_string, sizeof scm_string, _str, f_rank [ fraction_id - 1 ] [ f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 7 ] - 1 ], f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 7 ] ) ;
							SendClientMessage ( playerid, col_gray, scm_string ) ;
							return true ;
						}

		    			show_dorm ( playerid ) ;
					}
					return true ;
				}
				else if ( confiscation_time != -1 )
				{
				    new _fr_id = -1, _slot, bool: _find = false ;
				    if ( areaid == dorm_area [ 22 ] && conf_type == 1 || areaid == dorm_area [ 23 ] && conf_type == 2 || areaid == dorm_area [ 24 ] && conf_type == 3 )
				    {
				        if ( areaid == dorm_area [ 22 ] ) _fr_id = 22 ;
				        else if ( areaid == dorm_area [ 23 ] ) _fr_id = 23 ;
				        else if ( areaid == dorm_area [ 24 ] ) _fr_id = 24 ;

				        static const _box_id [ ] [ 3 ] =
				        {
				            { 153, 100, 3 },
				            { 154, 100, 3 },
				            { 155, 100, 3 },
				            { 164, 1, 0 },
				            { 165, 1, 1 },
				            { 166, 1, 2 },
							{ 167, 1, 3 },
							{ 168, 1, 4 },
							{ 169, 1, 5 },
							{ 170, 1, 6 },
							{ 346, 10, 5 },
							{ 347, 10, 0 },
							{ 348, 10, 0 },
							{ 349, 10, 6 },
							{ 353, 10, 1 },
							{ 355, 10, 1 },
							{ 356, 10, 2 },
							{ 357, 10, 3 },
							{ 1242, 3, 4 },
							{ 1243, 3, 4 },
							{ 1244, 3, 4 }
				        } ;
				        for ( new i = 0 ; i < sizeof _box_id ; i ++ )
				        {
				            _slot = GetInventoryFindItem ( _fr_id + 1, SUB_INV_FRACTION, _box_id [ i ] [ 0 ] ) ;
							if ( _slot < _box_id [ i ] [ 1 ] ) continue ;
							if ( box_submarine [ playerid ] > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас уже есть ящик в руках. Отнесите и положите его в фургон." ) ;

							if ( IsPlayerAttachedObjectSlotUsed ( playerid, 0 ) ) RemovePlayerAttachedObject ( playerid, 0 ) ;
							SetPlayerAttachedObject ( playerid, 0, 3013, 6,0.0,0.10,-0.2, -110.0,0.0,78.0 ) ;

							have_box [ playerid ] = true ;
				            box_submarine [ playerid ] = _box_id [ i ] [ 2 ] + 1 ;

				            new scm_string [ 100 ] ;
				            format ( scm_string, sizeof scm_string, "{"#cGInfo"}* {"#cWH"}Вы взяли '{"#cGN"}%s{"#cWH"}'. Отнесите и положите его в фургон.", item_name ( _box_id [ i ] [ 0 ] ) ) ;
				            SendClientMessage ( playerid, col_white, scm_string ) ;

							ClearAnimations ( playerid ) ;
							p_t_info [ playerid ] [ p_animation ] = true ;
						    ApplyAnimation ( playerid, "CARRY", "crry_prtial", 4.1, 0, 1, 1, 1, 1 ) ;

						    clear_fraction_item ( _fr_id, _slot, _box_id [ i ] [ 1 ] ) ;

						    _find = true ;

							#if defined m_fractions
							    give_emp_progress ( playerid, 4, 1 ) ;
							#endif
						    break ;
						}

						if ( ! _find )
						{
						    SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Склад организации пусть. Конфисковать нечего." ) ;
						}
				    }
				    return 1 ;
				}
			}
			case area_type_army_mats:
			{
			    if ( steal_cooldown [ playerid ] - gettime ( ) > 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Красть боеприпасы можно 1 раз в 5 минут." ) ;

			    new bool: _family_step = false ;
			    if ( p_info [ playerid ] [ family ] )
			 	{
				  	new family_id = p_info [ playerid ] [ family ] ;
				 	if ( family_info [ family_id - 1 ] [ fam_enhancement ] [ 7 ] ) _family_step = true ;
				}

				if ( ! gang_player ( playerid ) && ! mafia_player ( playerid ) && _family_step == false ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Кража доступна только для криминальных организаций." ) ;

			    static const _box_id [ ] = { 348, 349, 355, 356 } ;
			    new i = area_info [ areaid ] [ a_item ], _random_item = _box_id [ random ( sizeof _box_id ) ], _random_count = random ( 3 ) + 1 ;
				if ( GetInventoryFindItem ( army_mats [ i ] [ army_id ], SUB_INV_FRACTION, _random_item ) > _random_count )
				{
				    clear_fraction_item ( army_mats [ i ] [ army_id ], _random_item, _random_count ) ;
				    give_inventory ( playerid, _random_item, _random_count, 0, "", "", NUMBERPLATE_TYPE_NONE, 0 ) ;

				    global_string [ 0 ] = EOS ;
				    format ( global_string, 128, "* Вам в инвентарь был добавлен предмет '%s'.", item_name ( _random_item ) ) ;
					SendClientMessage ( playerid, col_yellow, global_string ) ;
				}

				_random_count = random ( 100 ) + 25 ;
				if ( GetInventoryFindItem ( army_mats [ i ] [ army_id ], SUB_INV_FRACTION, 2154 ) > _random_count )
				{
				    clear_fraction_item ( army_mats [ i ] [ army_id ], 2154, _random_count ) ;
				    give_inventory ( playerid, 2154, _random_count, 0, "", "", NUMBERPLATE_TYPE_NONE, 0 ) ;

				    global_string [ 0 ] = EOS ;
				    format ( global_string, 128, "* Вам в инвентарь был добавлен предмет '%s'.", item_name ( 154 ) ) ;
					SendClientMessage ( playerid, col_yellow, global_string ) ;
				}

				#if defined m_fractions
				    give_emp_progress ( playerid, 3, 1 ) ;
				#endif

				steal_cooldown [ playerid ] = gettime ( ) + 300 ;
				update_int_sql ( playerid, "u_steal_cooldown", steal_cooldown [ playerid ] ) ;

				fraction_message ( army_mats [ i ] [ army_id ], col_lblue, !"* На территорию военной базы проникли злоумышленники и расхищяют склад вооружения!" ) ;
				return 1 ;
			}
			case area_type_farm_unload:
			{
			    if ( conf_time > 0 )
			    {
				    if ( fbi_player ( playerid ) )
				    {
				        if ( IsPlayerAttachedObjectSlotUsed ( playerid, 0 ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас уже есть что-то в руках." ) ;

				        //if ( AmbarDrugs > 500 ) AmbarDrugs -= 500, conf_drugs += 500 ;

						SetPlayerAttachedObject ( playerid, 0, 3013,6,0.0,0.10,-0.2, -110.0,0.0,78.0 ) ;
						have_box [ playerid ] = true ;

						SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы взяли ящик со склада. Отнесите и положите его в фуру." ) ;
			            SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}У задних дверей фуры нажмите 'Y' для того, чтобы положить ящик." ) ;
						ClearAnimations ( playerid ) ;
						p_t_info [ playerid ] [ p_animation ] = true ;
						ApplyAnimation ( playerid, "CARRY", "crry_prtial", 4.1, 0, 1, 1, 1, 1 ) ;
					}
				}
				return 1 ;
			}
			case area_type_mineral:
			{
			    if ( conf_time > 0 )
			    {
				    if ( fbi_player ( playerid ) )
				    {
				        if ( IsPlayerAttachedObjectSlotUsed ( playerid, 0 ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас уже есть что-то в руках." ) ;

				        //if ( mineral > 500 ) mineral -= 500, conf_materials += 500 ;

						SetPlayerAttachedObject ( playerid, 0, 3013,6,0.0,0.10,-0.2, -110.0,0.0,78.0 ) ;
						have_box [ playerid ] = true ;

						SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы взяли ящик со склада. Отнесите и положите его в фуру." ) ;
			            SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}У задних дверей фуры нажмите 'Y' для того, чтобы положить ящик." ) ;
						ClearAnimations ( playerid ) ;
						p_t_info [ playerid ] [ p_animation ] = true ;
						ApplyAnimation ( playerid, "CARRY", "crry_prtial", 4.1, 0, 1, 1, 1, 1 ) ;
					}
				}
				return 1 ;
			}
			case area_type_bank_robbery:
			{
			    if ( p_t_info [ playerid ] [ t_robbery ] == -1 ) return 1 ;
			    if ( steal_timer [ playerid ] != -1 ) return 1 ;
			    if ( bank_robbery_time [ p_t_info [ playerid ] [ t_robbery ] ] < 2 ) return 1 ;
			    if ( GetPlayerVirtualWorld ( playerid ) != bank_world [ p_t_info [ playerid ] [ t_robbery ] ] ) return 1 ;

			    if ( ! IsPlayerAttachedObjectSlotUsed ( playerid, 1 ) )
				{
					SetPlayerAttachedObject ( playerid, 1, 1550, 1,   0.160001, -0.234000, -0.009998, 1.100002, 95.899940, -17.500007  ) ;

					#if defined m_fractions
					    give_emp_progress ( playerid, 5, 1 ) ;
					#endif
				}

			    steal_timer [ playerid ] = SetTimerEx ( "steal_bank_money", 1000, true, "i", playerid ) ;
			    return 1 ;
			}
			case area_type_businesses_food:
			{
				new t = area_info [ areaid ] [ a_item ] - 1 ;
				if ( t < 0 ) return 1 ;

			  	if ( b_info [ t ] [ b_type ] != bizz_type_food ) return 1 ;
			    if ( areaid == b_info [ t ] [ b_area_gas ] )
				{
					if ( b_info [ t ] [ b_close ] == 1 ||  b_info [ t ] [ b_owner_inc ] == -1 )
					{
						if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Бизнес закрыт!", 0, 3, CINFO_OTHER_ID, PICTURE_INFO_ERROR, "", "" ) ;
						else GameTextForPlayer ( playerid, "~r~BUSINESS CLOSED", 2000, 4 ) ;
						return 1 ;
					}

				    SetPVarInt ( playerid, "p_biz_id", t + 1 ) ;

				    ShowCafeDialog ( playerid, 1 ) ;
					return 1 ;
				}
			}
			case area_type_boombox:
			{
			    if ( p_t_info [ playerid ] [ p_logged ] == false ) return 1 ;

			    foreach(new i: box_player)
				{
					if ( areaid == boombox_player [ i ] [ b_area ] )
					{
					    new get_station [ 128 ] ;
						GetPVarString(i, "BBStation", get_station, 128);
						if(!isnull(get_station))
						{
						    if ( player_device { playerid } == 2 )
						    {
						        #if defined m_streamsource
						            CreateStreamSource ( playerid, i ) ;
								#endif
						    }
						    else
						    {
								PlayStream ( playerid, get_station, boombox_player [ i ] [ b_pos ] [ 0 ],
																boombox_player [ i ] [ b_pos ] [ 1 ],
																boombox_player [ i ] [ b_pos ] [ 2 ], 30.0, 1 ) ;
							}

							SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Вы попали в игровую зону магнитофона." ) ;
						}
						return 1 ;
					}
				}
			    return 1 ;
			}
			case area_type_sellstatus:
			{
				entered_sell_zone [ playerid ] = true ;

				if ( is_player_in_dmzone { playerid } == 1 ) return 1 ;
				is_player_in_dmzone { playerid } = 1 ;
			    return 1 ;
			}
			case area_type_atm:
			{
				if ( player_device { playerid } == 2 )
			    	send_check_cinfo ( playerid, "Банкомат. Нажмите для взаимодействия", 1, -1, CINFO_ATM_ID, PICTURE_INFO_SUCESS, "Банкомат", "" ) ;

				else
				{
					new t = area_info [ areaid ] [ a_item ] ;

	    			atm_used [ playerid ] = t + 1 ;
				    SetPVarInt ( playerid, "p_biz_id", atm_info [ t ] [ atm_status ] ) ;

					deposit_boxes ( playerid ) ;
				}
				return 1 ;
			}
			case area_type_quest_actor:
			{
				if ( p_info [ playerid ] [ start_quest_id ] == -1 )
				{
					new j = area_info [ areaid ] [ a_item ] ;

                    new _act_type = quest_actor [ j ] [ actor_type ] ;
					if ( _act_type == 0 )
					{
						p_info [ playerid ] [ start_quest_id ] = j ;
						update_int_sql ( playerid, "u_start_quest_id", j ) ;
					}
				}

				if ( player_device { playerid } == 2 )
			    	send_check_cinfo ( playerid, "Квестовый персонаж", 1, -1, CINFO_ACTOR_ID, PICTURE_INFO_SUCESS, "Задания", "" ) ;

				else
				{
					new j = area_info [ areaid ] [ a_item ] ;

                    new _act_type = quest_actor [ j ] [ actor_type ] ;
                    show_area_quest_actor ( playerid, _act_type ) ;
				}
				return 1 ;
			}
			case area_type_hospital:
			{
				if ( player_device { playerid } == 2 )
			    	send_check_cinfo ( playerid, "Больничная койка", 1, -1, CINFO_HOSPITAL_ID, PICTURE_INFO_SUCESS, "Лечь", "" ) ;

				else
					show_dialog ( playerid, d_hospital, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Койка", "{"#cWH"}Вы хотите занять койку?", "Да", "Нет" ) ;
				return 1 ;
			}
			case area_type_dice:
			{
			    send_check_cinfo ( playerid, "Кости. Нажмите для взаимодействия", 1, -1, CINFO_DICE_ID, PICTURE_INFO_SUCESS, "Кости", "" ) ;
			    return 1 ;
			}
			case area_type_gym_bike:
			{
				if ( player_device { playerid } == 2 )
			    	send_check_cinfo ( playerid, "Тренажёр. Нажмите для взаимодействия", 1, -1, CINFO_GYMBIKE_ID, PICTURE_INFO_SUCESS, "Тренажёр", "" ) ;

				else
				    show_dialog ( playerid, d_gym, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Тренировка", "{"#cWH"}Вы хотите начать тренировку на тренажёре?", "Да", "Нет" ) ;
				return 1 ;
			}
			case area_type_gym_thread:
			{
			    if ( player_device { playerid } == 2 )
			    	send_check_cinfo ( playerid, "Тренажёр. Нажмите для взаимодействия", 1, -1, CINFO_GYMTHREAD_ID, PICTURE_INFO_SUCESS, "Тренажёр", "" ) ;

				else
				    show_dialog ( playerid, d_gym, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Тренировка", "{"#cWH"}Вы хотите начать тренировку на тренажёре?", "Да", "Нет" ) ;
				return 1 ;
			}
			case area_type_gym_bar:
			{
			    if ( player_device { playerid } == 2 )
			    	send_check_cinfo ( playerid, "Тренажёр. Нажмите для взаимодействия", 1, -1, CINFO_GYMBAR_ID, PICTURE_INFO_SUCESS, "Тренажёр", "" ) ;

				else
				    show_dialog ( playerid, d_gym, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Тренировка", "{"#cWH"}Вы хотите начать тренировку на тренажёре?", "Да", "Нет" ) ;
				return 1 ;
			}
			case area_type_gym_dumbbells:
			{
			    if ( player_device { playerid } == 2 )
			    	send_check_cinfo ( playerid, "Тренажёр. Нажмите для взаимодействия", 1, -1, CINFO_GYMDUMBBELLS_ID, PICTURE_INFO_SUCESS, "Тренажёр", "" ) ;

				else
				    show_dialog ( playerid, d_gym, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Тренировка", "{"#cWH"}Вы хотите начать тренировку на тренажёре?", "Да", "Нет" ) ;
				return 1 ;
			}
			case area_type_kamikaze:
			{

				return 1 ;
			}
			case area_type_binary:
			{

				return 1 ;
			}
			case area_type_roulette:
			{
			    send_check_cinfo ( playerid, "Рулетка. Нажмите для взаимодействия", 1, -1, CINFO_ROULETTE_ID, PICTURE_INFO_SUCESS, "Рулетка", "" ) ;
				return 1 ;
			}
			case area_type_blackjack:
			{
			    send_check_cinfo ( playerid, "BlackJack. Нажмите для взаимодействия", 1, -1, CINFO_CARDS_ID, PICTURE_INFO_SUCESS, "BlackJack", "" ) ;
			    return 1 ;
			}
			case area_type_jackpot:
			{
			    send_check_cinfo ( playerid, "Игровые автоматы. Нажмите для взаимодействия", 1, -1, CINFO_JACKPOT_ID, PICTURE_INFO_SUCESS, "Играть", "" ) ;
				return 1 ;
			}
			case area_type_barriers:
			{
				new j = area_info [ areaid ] [ a_item ] ;
				if ( mafia_player ( playerid ) || gang_player ( playerid ) )
				{
				    if ( action_type { playerid } != ACTION_ARMY_GATE )
				    {
						if ( barrier_pos [ j ] [ fraction_bar ] [ 0 ] != 8 ) return 1 ;

						global_string [ 0 ] = EOS ;
					    format ( global_string, 100, "Проезд '%s'.", barrier_pos [ j ] [ name_bar ] ) ;
						send_check_cinfo ( playerid, global_string, 1, -1, CINFO_BARRIERS_ID, PICTURE_INFO_SUCESS, "Взломать", "" ) ;
						return 1 ;
					}
				}
				for ( new i = 0 ; i < 4 ; i ++ )
				{
				    if ( p_info [ playerid ] [ member ] != barrier_pos [ j ] [ fraction_bar ] [ i ] ) continue ;
				    if ( barrier_status [ j ] == true ) continue ;

				    global_string [ 0 ] = EOS ;
				    format ( global_string, 100, "Проезд '%s'.", barrier_pos [ j ] [ name_bar ] ) ;
					send_check_cinfo ( playerid, global_string, 1, -1, CINFO_BARRIERS_ID, PICTURE_INFO_SUCESS, "Открыть", "" ) ;
					return 1 ;
				}
				return 1 ;
			}
			case area_type_doors:
			{
			    new _item = area_info [ areaid ] [ a_item ] ;
				for ( new i = 0 ; i < 4 ; i ++ )
				{
				    if ( p_info [ playerid ] [ member ] != door_pos [ _item ] [ fraction_doors ] [ i ] ) continue ;
				    if ( door_status [ _item ] == true ) return 1 ;

				    global_string [ 0 ] = EOS ;
				    format ( global_string, 100, "Дверь '%s'.", door_pos [ _item ] [ name_doors ] ) ;
					send_check_cinfo ( playerid, global_string, 1, -1, CINFO_DOORS_ID, PICTURE_INFO_SUCESS, "Открыть", "" ) ;
					return 1 ;
				}
				return 1 ;
			}
			case area_type_car_market:
			{
			    if ( player_device { playerid } != 2 )
			    {
				    show_area_carmarket ( playerid ) ;
					return 1 ;
			    }
			    if ( ! IsPlayerInRangeOfPoint ( playerid, 50.0, b_info [ carmarket_integr_id [ 0 ] - 1 ] [ b_position ] [ 0 ],
																b_info [ carmarket_integr_id [ 0 ] - 1 ] [ b_position ] [ 1 ],
																b_info [ carmarket_integr_id [ 0 ] - 1 ] [ b_position ] [ 2 ] ) ) return 1 ;

				new veh_id = INVALID_VEHICLE_ID ;
				foreach(new i: streamed_vehicles[playerid])
				{
					if ( ! IsPlayerInRangeOfPoint ( playerid, 5.0, veh_info [ i - 1 ] [ v_now_pos ] [ 0 ],
																veh_info [ i - 1 ] [ v_now_pos ] [ 1 ],
																veh_info [ i - 1 ] [ v_now_pos ] [ 2 ] ) ) continue ;

					if ( veh_info [ i - 1 ] [ v_sell_price ] < 1 ) continue ;

					veh_id = i ;
					break ;
				}

				if ( veh_id != INVALID_VEHICLE_ID && veh_info [ veh_id - 1 ] [ v_type ] == vehicle_type_carmarket )
				{
					if ( veh_info [ veh_id - 1 ] [ v_sell_price ] > 0 )
					{
					    send_check_cinfo ( playerid, "Авторынок. Нажмите для взаимодействия", 1, 5, CINFO_CAR_MARKET, PICTURE_INFO_SUCESS, "Авторынок", "" ) ;
					    return 1 ;
					}
				}
			}
			case area_type_safe:
			{
			    new _h_id = GetPVarInt ( playerid, "house_id" ) ;
			    if ( _h_id < 1 ) return bad_dialog ( playerid ) ;
			    if ( h_info [ _h_id - 1 ] [ h_improve ] [ 1 ] )
			    {
			        if ( ! h_info [ _h_id - 1 ] [ h_safe_load ] )
						InventoryLoading ( h_info [ _h_id  - 1 ] [ h_id ], _h_id , SUB_INV_HOUSE, 1 ) ;

				    if ( player_device { playerid } == 2 )
					{
						send_check_cinfo ( playerid, "Сейф. Нажмите для взаимодействия", 1, -1, CINFO_HOUSE_SAFE_ID, PICTURE_INFO_SUCESS, "Сейф", "" ) ;
					}
					else
					{
						if ( p_info [ playerid ] [ password_status ] ) show_dialog ( playerid, d_safe_pin, DIALOG_STYLE_INPUT, "{"#cBHD"}Код от сейфа", "{ffffff}Введите код от сейфа, чтобы получить доступ к содержимому:", "Принять", "Закрыть" ) ;
						else show_dialog ( playerid, d_safe_pin, DIALOG_STYLE_PASSWORD, "{"#cBHD"}Код от сейфа", "{ffffff}Введите код от сейфа, чтобы получить доступ к содержимому:", "Принять", "Закрыть" ) ;
					}
					return 1 ;
			    }
			    return 1 ;
			}
			case area_type_freeze:
			{
			    new _h_id = GetPVarInt ( playerid, "house_id" ) ;
			    if ( _h_id < 1 ) return bad_dialog ( playerid ) ;
			    if ( h_info [ _h_id - 1 ] [ h_improve ] [ 2 ] )
			    {
				    if ( player_device { playerid } == 2 )
					{
						send_check_cinfo ( playerid, "Холодильник. Нажмите для взаимодействия", 1, -1, CINFO_HOUSE_FREEZE_ID, PICTURE_INFO_SUCESS, "Холодильник", "" ) ;
                        send_check_cinfo ( playerid, "Для заказа продуктов используйте /service", 0, 3, CINFO_OTHER_ID, PICTURE_INFO_SUCESS, "", "" ) ;
					}
					else
					{
					    SendClientMessage ( playerid, col_white, !"{"#cBInfo"}* {"#cWH"}Используйте {"#cBL"}/service {"#cWH"}для заказа продуктов." ) ;
						show_dialog ( playerid, d_h_freeze, DIALOG_STYLE_LIST, "{"#cBHD"}Холодильник", "Хот-дог ({"#cRD"}-10 прод. {"#cGN"}+20 сытость{"#cWH"})\nБургер ({"#cRD"}-15 прод. {"#cGN"}+30 сытость{"#cWH"})\nПицца ({"#cRD"}-30 прод. {"#cGN"}+60 сытость{"#cWH"})", "Съесть", "Закрыть" ) ;
					}
					return 1 ;
			    }
			    return 1 ;
			}
			case area_type_cellar:
			{
			    new _h_id = GetPVarInt ( playerid, "house_id" ) ;
			    if ( _h_id < 1 ) return bad_dialog ( playerid ) ;

				send_check_cinfo ( playerid, "Подвал. Нажмите для взаимодействия", 1, -1, CINFO_HOUSE_CELLAR_ID, PICTURE_INFO_SUCESS, "Подвал", "" ) ;
			    return 1 ;
			}
			case area_type_cellar_table:
			{
			    new _c_id = GetPVarInt ( playerid, "cellar_id" ) ;
			    if ( _c_id < 0 ) return bad_dialog ( playerid ) ;

				send_check_cinfo ( playerid, "Станок. Нажмите для взаимодействия", 1, -1, CINFO_CELLAR_ID, PICTURE_INFO_SUCESS, "Станок", "" ) ;
			    return 1 ;
			}
			case area_type_forest:
			{
				if ( GetPlayerWeapon ( playerid ) != 31 ) send_check_cinfo ( playerid, "Для охоты Вам необходимо ружьё в руках!\nВозьмите его в руки или приобретите в /gps - Бизнесы - Охота и рыбалка", 0, -1, CINFO_FOREST_ID, PICTURE_INFO_WARNING, "", "" ) ;
			    return 1 ;
			}
			case area_type_dorm_unload:
			{
				if ( have_box [ playerid ] )
				{
				    new _box = box_submarine [ playerid ] - 1 ;
					RemovePlayerAttachedObject ( playerid, 0 ) ;
					ClearAnimations ( playerid ) ;
					ApplyAnimation ( playerid, "CARRY", "putdwn", 4.0, 0, 1, 1, 0, 0, 1 ) ;

					have_box [ playerid ] = false ;
					box_submarine [ playerid ] = 0 ;
					p_t_info [ playerid ] [ p_animation ] = false ;

					static const _box_id [ ] = { 164, 165, 166, 167, 168, 169, 170, 172 } ;

					new USERS_INVENTORY_STRUCT: inventoryStruct [ _:INV_STRUCTURE_MAX ] ;
					inventoryStruct [ _:INV_ITEM ] = _box_id [ _box ] ;
					inventoryStruct [ _:INV_ITEM_COUNT ] = 1 ;
					inventoryStruct [ _:INV_ITEM_TYPE ] = 0 ;
					inventoryStruct [ _:INV_ITEM_REGION ] = "" ;
					inventoryStruct [ _:INV_ITEM_PLATE ] = "" ;
					inventoryStruct [ _:INV_ITEM_PLATE_TYPE ] = NUMBERPLATE_TYPE_NONE ;
					inventoryStruct [ _:INV_ITEM_GIVE_DATE ] = 0 ;
					inventoryStruct [ _:INV_ITEM_ID ] = 0 ;
					inventoryStruct [ _:INV_ITEM_DATE ] = -1 ;
					new _slot = give_fraction_item ( area_info [ areaid ] [ a_item ], -1, inventoryStruct ) ;
					if ( _slot == -1 )
					{
						SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}На складе организации нет свободного места." ) ;
					    return 1 ;
					}

					#if defined m_fractions
					    if ( army_player ( playerid ) ) give_emp_progress ( playerid, 0, 1 ) ;
					    else if ( medic_player ( playerid ) ) give_emp_progress ( playerid, 3, 1 ) ;
					    else if ( gang_player ( playerid ) || mafia_player ( playerid ) ) give_emp_progress ( playerid, 6, 1 ) ;
					#endif
					return 1 ;
				}
				else
				{
					if ( army_player ( playerid ) && area_info [ areaid ] [ a_item ] == p_info [ playerid ] [ member ] - 1 )
					{
					    if ( p_info [ playerid ] [ hour_played ] < FIVE_HOUR_PLAYED ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Доступно с 5 часов в игре. Используйте /mm - Информация о персонаже - Статистика персонажа." ) ;

						#if defined m_inventory_module
						    used_inventory [ playerid ] = true ;
							toggle_controlable ( playerid, false ) ;

							new _f_id = p_info [ playerid ] [ member ], _str [ 32 ] ;
							SetInventoryItem ( playerid ) ;
							setInventoryLayout ( playerid, 1 ) ;
							setInventoryWarehouse ( playerid, SUB_INV_FRACTION, _f_id ) ;
							set_inventory_button ( playerid, SUB_INV_FRACTION ) ;
							format ( _str, sizeof _str, "%s", GetPlayerCashValueToSmile ( f_info [ _f_id - 1 ] [ f_money ] ) ) ;
							setWarehouseInfo (
								playerid,
								"Склад организации",
								"Здесь хранятся предметы, которые\nв организации",
								"ОРГАНИЗАЦИЯ",
								"ДЕНЕГ В _f_id",
								f_info [ _f_id - 1 ] [ f_name ],
								_str
							) ;

							send_check_cinfo ( playerid, "Выберите ящик с оружием / патронами / бронежилетами!", 0, 3, CINFO_INVENTORY_ID, PICTURE_INFO_WARNING, "", "" ) ;
						#endif
					}
					else if ( medic_player ( playerid ) && area_info [ areaid ] [ a_item ] == p_info [ playerid ] [ member ] - 1 )
					{
					    if ( p_info [ playerid ] [ hour_played ] < FIVE_HOUR_PLAYED ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Доступно с 5 часов в игре. Используйте /mm - Информация о персонаже - Статистика персонажа." ) ;

						#if defined m_inventory_module
						    used_inventory [ playerid ] = true ;
							toggle_controlable ( playerid, false ) ;

							new _f_id = p_info [ playerid ] [ member ], _str [ 32 ] ;
							SetInventoryItem ( playerid ) ;
							setInventoryLayout ( playerid, 1 ) ;
							setInventoryWarehouse ( playerid, SUB_INV_FRACTION, _f_id ) ;
							set_inventory_button ( playerid, SUB_INV_FRACTION ) ;
							format ( _str, sizeof _str, "%s", GetPlayerCashValueToSmile ( f_info [ _f_id - 1 ] [ f_money ] ) ) ;
							setWarehouseInfo (
								playerid,
								"Склад организации",
								"Здесь хранятся предметы, которые\nв организации",
								"ОРГАНИЗАЦИЯ",
								"ДЕНЕГ В _f_id",
								f_info [ _f_id - 1 ] [ f_name ],
								_str
							) ;

							send_check_cinfo ( playerid, "Выберите ящик с медикаментами!", 0, 3, CINFO_INVENTORY_ID, PICTURE_INFO_WARNING, "", "" ) ;
						#endif
					}
				    return 1 ;
				}
			}
		}
	}

	else if ( GetPlayerState ( playerid ) == PLAYER_STATE_DRIVER )
	{
	    switch ( area_info [ areaid ] [ a_type ] )
		{
		    case area_type_antidm:
		    {
		        if ( ! player_loaded { playerid } ) return 1 ;
		        if ( player_device { playerid } == 2 && p_info [ playerid ] [ hud_id ] ) SendCheckHud ( playerid ) ;
		        else
		        {
					if ( is_player_in_dmzone { playerid } == 1 ) return 1 ;

					is_player_in_dmzone { playerid } = 1 ;
				}
				SetPlayerArmedWeapon ( playerid, 0 ) ;
				return 1 ;
		    }
		    case area_type_noparking:
			{
			    if ( is_player_nonpark_zone { playerid } == 1 ) return 1 ;
				is_player_nonpark_zone { playerid } = 1 ;
				return 1 ;
			}
			case area_type_farm_unload:
			{
			    if ( mafia_player ( playerid ) )
			    {
			        new vehid = GetPlayerVehicleID ( playerid );
				    if ( GetVehicleModel ( vehid ) == 532 )
				    {
				        global_string [ 0 ] = EOS ;
						if ( ! vehid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не в машине." ) ;
						if ( veh_info [ vehid - 1 ] [ v_drugs ] <= 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}В вашей машине нету наркотиков." ) ;
						AmbarDrugs += veh_info [ vehid - 1 ] [ v_drugs ];
						format(global_string, 128, "{"#cGInfo"}* {"#cWH"}Вы привезли {"#cGN"}%i{"#cWH"} грамм.", veh_info [ vehid - 1 ] [ v_drugs ]);
						SendClientMessage ( playerid, col_white, global_string);
						format(global_string, 100, "** Амбар **\n{"#cGR3D"}Количество наркотиков: {"#cWH3D"}%d гр.", AmbarDrugs);
						UpdateDynamic3DTextLabelText(TextWarehouseAmbar, col_header_3d, global_string);

                        checking_mafia_quest_progress ( playerid, 5, veh_info [ vehid - 1 ] [ v_drugs ] ) ;

						veh_info [ vehid - 1 ] [ v_drugs ] = 0 ;
					}
					else
					{
					    if ( b_info [ mafia_farm_id - 1 ] [ b_mafia ] == p_info [ playerid ] [ member ] )
						{
					    	show_dialog ( playerid, d_barn_take, DIALOG_STYLE_INPUT, "{"#cBHD"}Амбар", "{"#cWH"}Количество наркотиков которое хотите взять:", "Взять", "Отмена");
						}
					}
				}
				return 1 ;
			}
			case area_type_priton_unload:
			{
			    if ( b_info [ mafia_farm_id - 1 ] [ b_mafia ] == p_info [ playerid ] [ member ] )
				{
					new narko_money ;
					new vehid = GetPlayerVehicleID ( playerid ) ;
					if ( ! vehid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не в машине." ) ;
					if ( veh_info [ vehid - 1 ] [ v_drugs ] <= 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}В вашей машине нету наркотиков." ) ;
					narko_money = veh_info [ vehid - 1 ] [ v_drugs ] * 15 ;
					PritonDrugs += veh_info [ vehid - 1 ] [ v_drugs ] ;

					give_money ( playerid, floatround ( narko_money / 50 ) ) ;
					insert_money_log ( playerid, INVALID_PLAYER_ID, floatround ( narko_money / 50 ), "за доставку нарко" ) ;

					new fraction_id = p_info [ playerid ] [ member ] ;
					set_money_fraction ( fraction_id - 1, 3, floatround ( narko_money / 50 ), true ) ;

					new scm_string [ 144 ] ;
					format ( scm_string, sizeof scm_string, "[F] %s %s[%d] разгрузил(а) фургон с наркотиками и заработал(а) в общак %d"valute_title".", f_rank [ fraction_id - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], playerid, narko_money ) ;
					fraction_message ( fraction_id, col_lblue, scm_string ) ;

					format(scm_string, sizeof scm_string, "{"#cGInfo"}* {"#cWH"}Вы привезли {"#cGN"}%i{"#cWH"} грамм и получили {"#cGN"}%i"valute_title_"{"#cWH"}", veh_info [ vehid - 1 ] [ v_drugs ], floatround ( narko_money / 50 ));
					SendClientMessage ( playerid, col_white, scm_string);

					veh_info [ vehid - 1 ] [ v_drugs ] = 0 ;

					format ( scm_string, 100, "** Притон **\n{"#cGR3D"}Количество наркотиков: {"#cWH3D"}%d гр.", PritonDrugs ) ;
					UpdateDynamic3DTextLabelText ( TextWarehouseAmbar, col_header_3d, scm_string ) ;
				}
				return 1 ;
			}
			case area_type_dorm_unload:
			{
				if ( GetPlayerVehicleID ( playerid ) < 1 ) return 1 ;
			    if ( veh_info [ GetPlayerVehicleID ( playerid ) - 1 ] [ v_model ] == 548 )
				{
				    SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Для отцепки контейнера используйте клавишу {"#cGN"}Y{"#cWH"}." ) ;
				    return 1 ;
				}
			}
			case area_type_businesses_gas:
			{
       			new t = area_info [ areaid ] [ a_item ] - 1 ;
       			if ( t < 0 ) return 1 ;

				if ( b_info [ t ] [ b_type ] != bizz_type_gas ) return 1 ;
			    if ( areaid == b_info [ t ] [ b_area_gas ] )
				{
					if ( b_info [ t ] [ b_owner_inc ] == -1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У данной заправки нет владельца, она не работает." ) ;

					SetPVarInt ( playerid, "f_biz", t ) ;
					toggle_controlable ( playerid, false ) ;

					new vehicleid = GetPlayerVehicleID ( playerid ),
						modelid = getVehicleOrdinalNumber ( vehicleid ),
						vehicle_fuel_type = veh_data [ modelid ] [ VEHICLE_FUEL_TYPE_ID ] ;

					if ( vehicle_fuel_type == VEHICLE_FUEL_TYPE_CHARGE ) show_window_charge_station ( playerid ) ;
					else show_window_gas_station ( playerid ) ;
					return 1 ;
				}
				else if ( areaid == b_info [ t ] [ b_area_repair ] )
				{
				    SetPVarInt ( playerid, "f_biz", t ) ;

				    if ( b_price_market [ t ] [ 5 ] < 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Цена за ремонт не назначена владельцем заправки." ) ;
					if ( b_info [ t ] [ b_owner_inc ] == -1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У данной заправки нет владельца, она не работает." ) ;

				    new dialog_string [ 102 + 9 ] ;
				    format ( dialog_string, sizeof dialog_string, "{"#cWH"}Стоимость починки: {"#cGN"}%d"valute_title_"\n\n{"#cGRDialog"}* Вы хотите починить транспортное средство?", b_price_market [ t ] [ 2 ] ) ;
					show_dialog ( playerid, d_filling_repair, DIALOG_STYLE_MSGBOX, "{"#cBL"}Заправочная станция", dialog_string, "Выбрать", "Закрыть" ) ;
					return 1 ;
				}
			}
			case area_type_businesses_trucker:
			{
       			new t = area_info [ areaid ] [ a_item ] - 1 ;
       			if ( t < 0 ) return 1 ;

				if ( b_info [ t ] [ b_type ] != bizz_type_trucker ) return 1 ;
			    if ( areaid == b_info [ t ] [ b_area_repair ] )
				{
				    if ( p_info [ playerid ] [ b_worker ] != t + 1 )
					{
						if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Вы не являетесь сотрудником данной ТК!", 0, 3, CINFO_TRUCKER_ID, PICTURE_INFO_ERROR, "", "" ) ;
						else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не являетесь сотрудником данной ТК!" ) ;
					    return 1 ;
					}

					if ( b_info [ t ] [ b_improve ] [ 2 ] < 1 )
					{
						if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Улучшение для ремонта не куплено!", 0, 3, CINFO_TRUCKER_ID, PICTURE_INFO_ERROR, "", "" ) ;
						else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Улучшение для ремонта не куплено!" ) ;
					    return 1 ;
					}

					RepairVehicle ( GetPlayerVehicleID ( playerid ) ) ;

					if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Вы починили транспортное средство.", 0, 3, CINFO_TRUCKER_ID, PICTURE_INFO_SUCESS, "", "" ) ;
					else SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы починили транспортное средство." ) ;
					return 1 ;
				}
			}
			case area_type_radar:
			{
			    if ( p_info [ playerid ] [ crime_plus ] ) return 1 ;

			    new vehicle_id = GetPlayerVehicleID ( playerid ), _v_model = getVehicleOrdinalNumber ( vehicle_id ) ;
				if ( _v_model == 596 || _v_model == 597 || _v_model == 598 || _v_model == 3296 ) return 1 ;
				if ( p_t_info [ playerid ] [ radar_time ] > GetTickCount ( ) ) return 1 ;

				p_t_info [ playerid ] [ radar_time ] = GetTickCount ( ) + 5000 ;

			    new radarId = area_info [ areaid ] [ a_item ] ;
				if ( ( ! v_velo ( vehicle_id ) && ! v_plane ( vehicle_id ) && ! v_boat ( vehicle_id ) ) && GetPlayerState ( playerid ) == PLAYER_STATE_DRIVER )
				{
				    if ( p_info [ playerid ] [ drive_lic ] > 1 )
					{
						new _random = random ( 10 ) ;
						if ( _random == 1 )
						{
						    if ( p_info [ playerid ] [ drive_lic ] == 2 ) suspect_player ( playerid, "Езда с замороженными правами", 1 ) ;
							else if ( p_info [ playerid ] [ drive_lic ] == 3 ) suspect_player ( playerid, "Езда с анулированными правами", 2 ) ;
						}
					}

					new vehicleSpeed = floatround ( GetVehicleSpeed ( vehicle_id ) ) ;
					if ( vehicleSpeed - radar_info [ radarId ] [ r_speed ] > 20 )
					{
					   	if ( ! cop_player ( playerid ) && ! fbi_player ( playerid ) )
						{
							new scm_string [ 180 + MAX_PLAYER_NAME ], _payment = floatround ( ( vehicleSpeed * radar_info [ radarId ] [ r_speed ] ) / 5 ) ;
							format ( scm_string, 128, "* Разрешенная скорость %d км/ч, вы ехали %d км/ч. Наказание: штраф в размере %d"valute_title".", radar_info [ radarId ] [ r_speed ], vehicleSpeed, _payment ) ;
							SendClientMessage ( playerid, col_wavy, scm_string ) ;

							if ( p_info [ playerid ] [ ticket_c ] + 1 >= 30 && p_info [ playerid ] [ drive_lic ] != 2 )
							{
								p_info [ playerid ] [ drive_hour ] = 3 ;
							    p_info [ playerid ] [ drive_lic ] = 2 ;

								scm_string [ 0 ] = EOS ;
								format ( scm_string, sizeof scm_string, "UPDATE `users` SET `u_drive_hour` = '3', `u_drive_lic` = '2' WHERE `u_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
								mysql_tquery ( sql_connection, scm_string ) ;

								SendClientMessage ( playerid, col_wavy, !"* Ваши права заморожены на {"#cWH"}3 часа{14A3FF}. Причина: {"#cWH"}30 штрафов{14A3FF}." ) ;
							}
							else
							{
								format ( scm_string, 128, "* У Вас {"#cWH"}%d штрафов{14A3FF}. При достижении 30 штрафов Ваши права будут заморожены.", p_info [ playerid ] [ ticket_c ] + 1 ) ;
								SendClientMessage ( playerid, col_wavy, scm_string ) ;
								SendClientMessage ( playerid, col_wavy, !"* Оплатить штрафы можно в любом банке или банкомате." ) ;
								SendClientMessage ( playerid, col_wavy, !"* Используйте {"#cWH"}/gps{14A3FF}, чтоб найти банк / банкомат." ) ;

								InsertNewTicket ( playerid, _payment, vehicle_id, "radar" ) ;
							}
						}
					}
				}
				return 1 ;
			}
			case area_type_radar_warning:
			{
			    if ( p_info [ playerid ] [ crime_plus ] ) return 1 ;

			    new vehicle_id = GetPlayerVehicleID ( playerid ), _v_model = getVehicleOrdinalNumber ( vehicle_id ) ;
				if ( _v_model == 596 || _v_model == 597 || _v_model == 598 || _v_model == 3296 ) return 1 ;

			    new radarId = area_info [ areaid ] [ a_item ] ;
				if ( ( ! v_velo ( vehicle_id ) && ! v_plane ( vehicle_id ) && ! v_boat ( vehicle_id ) ) && GetPlayerState ( playerid ) == PLAYER_STATE_DRIVER )
				{
				    showSpeedLimit ( playerid, radar_info [ radarId ] [ r_speed ] ) ;
					radar_warning [ playerid ] = true ;
				}
				return 1 ;
			}
			case area_type_boombox:
			{
			    if ( p_t_info [ playerid ] [ p_logged ] == false ) return 1 ;

			    foreach(new i: box_player)
				{
					if ( areaid == boombox_player [ i ] [ b_area ] )
					{
					    new get_station [ 128 ] ;
      					GetPVarString(i, "BBStation", get_station, 128);
						if(!isnull(get_station))
						{
							PlayStream ( playerid, get_station, boombox_player [ i ] [ b_pos ] [ 0 ],
															boombox_player [ i ] [ b_pos ] [ 1 ],
															boombox_player [ i ] [ b_pos ] [ 2 ], 30.0, 1 ) ;

							SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Вы попали в игровую зону магнитофона." ) ;
						}
						return 1 ;
					}
				}
			    return 1 ;
			}
			case area_type_spikes:
			{
			    foreach(new x: spikes_player)
				{
					if ( areaid == p_t_info [ x ] [ cop_area ] && GetPlayerState ( playerid ) == PLAYER_STATE_DRIVER )
					{
						new panels, tires, doors, lights, state_vehicle = GetPlayerVehicleID ( playerid ) ;
						GetVehicleDamageStatus ( state_vehicle, panels, doors, lights, tires ) ;
						UpdateVehicleDamageStatus ( state_vehicle, panels, doors, lights, 15 ) ;
						GameTextForPlayer ( playerid, "~r~stalling", 1000, 3 ) ;
						break ;
					}
				}
			}
   			case area_type_sellstatus:
			{
				entered_sell_zone [ playerid ] = true ;
			    return 1 ;
			}
			case area_type_tuning:
			{
				send_check_cinfo ( playerid, "СТО. Нажмите для взаимодействия", 2, -1, CINFO_TUNING_ID, PICTURE_INFO_SUCESS, "Заехать", "Отмена" ) ;
			    return 1 ;
			}
			case area_type_forest:
			{
				if ( GetPlayerWeapon ( playerid ) != 31 ) send_check_cinfo ( playerid, "Для охоты Вам необходимо ружьё в руках!\nВозьмите его в руки или приобретите в /gps - Бизнесы - Охота и рыбалка", 0, -1, CINFO_FOREST_ID, PICTURE_INFO_WARNING, "", "" ) ;
			    return 1 ;
			}
			case area_type_housegarage:
			{
				new vehicle_id = GetPlayerVehicleID ( playerid ) ;
				if ( vehicle_id != 0 )
				{
				    if ( GetPVarInt ( playerid, "house_id" ) == 0 && used_area [ playerid ] != -1 )
					{
					    new _a_type = area_info [ used_area [ playerid ] ] [ a_type ] ;
					    if ( _a_type == area_type_housegarage )
					    {
					        new h = area_info [ used_area [ playerid ] ] [ a_item ] ;
							if ( h_info [ h - 1 ] [ h_garage ] == 0 ) return 1 ;
							if ( h_info [ h - 1 ] [ h_v_pos ] [ 0 ] == 0.0 && h_info [ h - 1 ] [ h_v_pos ] [ 1 ] == 0.0 && h_info [ h - 1 ] [ h_v_pos ] [ 2 ] == 0.0 ) return 1 ;

							send_check_cinfo ( playerid, "Гараж. Нажмите для взаимодействия", 1, -1, CINFO_HOUSEGARAGE_ID, PICTURE_INFO_SUCESS, "Заехать", "" ) ;
							return 1 ;
						}
					}
				}
			}
			case area_type_cellargarage:
			{
			    if ( GetPVarInt ( playerid, "cellar_id" ) == 0 )
				{
					if ( p_info [ playerid ] [ cellar ] != -1 )
					{
					    new h = p_info [ playerid ] [ cellar ] - 1 ;
						if ( cellar_info [ h ] [ cl_pos ] [ 0 ] == 0.0 && cellar_info [ h ] [ cl_pos ] [ 1 ] == 0.0 && cellar_info [ h ] [ cl_pos ] [ 2 ] == 0.0 ) return 1 ;
						if ( ! IsPlayerInRangeOfPoint ( playerid, 5.0, cellar_info [ h ] [ cl_pos ] [ 0 ], cellar_info [ h ] [ cl_pos ] [ 1 ], cellar_info [ h ] [ cl_pos ] [ 2 ] ) ) return 1 ;

						send_check_cinfo ( playerid, "Гараж. Нажмите для взаимодействия", 1, -1, CINFO_CELLARGARAGE_ID, PICTURE_INFO_SUCESS, "Заехать", "" ) ;
						return 1 ;
					}
				}
			}
		}
	}
	return 1 ;
}

public OnPlayerLeaveDynamicArea ( playerid, areaid )
{
	used_area [ playerid ] = -1 ;

	#if defined m_jobs_module
 		if ( trucker_LeaveDynamicArea ( playerid, areaid ) ) return 1 ;
	#endif

	#if defined m_treasure
 		if ( tr_LeaveDynamicArea ( playerid, areaid ) ) return 1 ;
	#endif

	#if defined m_treasure
 		if ( trash_LeaveDynamicArea ( playerid, areaid ) ) return 1 ;
	#endif

	#if defined m_epass
	    if ( epass_LeaveDynamicArea ( playerid, areaid ) ) return 1 ;
	#endif

	#if defined m_prison
	    if ( prison_LeaveDynamicArea ( playerid, areaid ) ) return 1 ;
	#endif

	#if defined m_coin
	    if ( coin_LeaveDynamicArea ( playerid, areaid ) ) return 1 ;
	#endif

	#if defined m_inventory_module
	    if ( market_LeaveDynamicArea ( playerid, areaid ) ) return 1 ;
	#endif

	#if defined m_familys
	    if ( family_LeaveDynamicArea ( playerid, areaid ) ) return 1 ;
	#endif

	#if defined m_winter
	    if ( winter_LeaveDynamicArea ( playerid, areaid ) ) return 1 ;
	#endif

	#if defined m_fractions
		if ( fractions_LeaveDynamicArea ( playerid, areaid ) ) return 1 ;
	#endif

	if ( GetPlayerState ( playerid ) != PLAYER_STATE_SPECTATING )
	{
	    switch ( area_info [ areaid ] [ a_type ] )
	    {
	        case area_type_antidm:
		    {
		        if ( ! player_loaded { playerid } ) return 1 ;

		        if ( player_device { playerid } == 2 && p_info [ playerid ] [ hud_id ] ) SendCheckHud ( playerid ) ;
				return 1 ;
		    }
	        case area_type_bank_robbery:
			{
			    if ( steal_timer [ playerid ] != -1 )
			    {
			        KillTimer ( steal_timer [ playerid ] ) ;
			        steal_timer [ playerid ] = -1 ;
			    }
			}
	    }
	}
	switch ( area_info [ areaid ] [ a_type ] )
    {
        case area_type_noparking:
        {
            if ( GetPlayerVehicleID ( playerid ) )
            {
				new veh_id = GetPlayerVehicleID ( playerid ) ;
				veh_info [ veh_id - 1 ] [ v_fine_time ] = 0 ;
			}
		}
        case area_type_factory_table:
        {
            for ( new i = 0 ; i < MAX_GUNWORK_TABLE ; i ++ )
			{
				if ( table_area [ i ] == areaid )
				{
					table_area_toggled [ i ] = INVALID_PLAYER_ID ;
					break ;
				}
			}
        }
		case area_type_boombox:
		{
		    if ( boombox_player [ playerid ] [ b_status ] )
			{
				DestroyRecorder ( playerid ) ;
			}
			else
			{
			    if ( player_device { playerid } == 2 && g_aStreamSources [ playerid ] [ eStreamID ] != -1 && g_aStreamSources [ playerid ] [ eStreamID ] != playerid )
				{
				    #if defined m_streamsource
						DestroyStreamSource ( playerid, g_aStreamSources [ playerid ] [ eStreamID ] ) ;
					#endif
				}
				else StopStream ( playerid ) ;
			}
		    return 1 ;
		}
		case area_type_radar_warning:
		{
			if ( radar_warning [ playerid ] )
        	{
				onServerDestroy ( playerid, UI_SPEED_LIMIT ) ;
				radar_warning [ playerid ] = false ;
			}
			return 1 ;
		}
		case area_type_sellstatus:
		{
			entered_sell_zone [ playerid ] = false ;
		    return 1 ;
		}
		case area_type_atm:
		{
		    clear_check_info ( playerid, CINFO_ATM_ID ) ;
		    return 1 ;
		}
		case area_type_quest_actor:
		{
		    clear_check_info ( playerid, CINFO_ACTOR_ID ) ;
		    return 1 ;
		}
		case area_type_hospital:
		{
		    clear_check_info ( playerid, CINFO_HOSPITAL_ID ) ;
		    return 1 ;
		}
		case area_type_dice:
		{
		    clear_check_info ( playerid, CINFO_DICE_ID ) ;
		    return 1 ;
		}
		case area_type_gym_bike:
		{
		    clear_check_info ( playerid, CINFO_GYMBIKE_ID ) ;
		    return 1 ;
		}
		case area_type_gym_thread:
		{
		    clear_check_info ( playerid, CINFO_GYMTHREAD_ID ) ;
		    return 1 ;
		}
		case area_type_gym_bar:
		{
		    clear_check_info ( playerid, CINFO_GYMBAR_ID ) ;
		    return 1 ;
		}
		case area_type_gym_dumbbells:
		{
		    clear_check_info ( playerid, CINFO_GYMDUMBBELLS_ID ) ;
		    return 1 ;
		}
		case area_type_kamikaze:
		{
		    clear_check_info ( playerid, CINFO_KAMIKAZE_ID ) ;
		    return 1 ;
		}
		case area_type_binary:
		{
		    #if defined m_casino
		    	clear_check_info ( playerid, CINFO_BINARY_ID ) ;
			#endif
			return 1 ;
		}
		case area_type_roulette:
		{
		    clear_check_info ( playerid, CINFO_ROULETTE_ID ) ;
			return 1 ;
		}
		case area_type_blackjack:
		{
		    clear_check_info ( playerid, CINFO_CARDS_ID ) ;
		    return 1 ;
		}
		case area_type_jackpot:
		{
		    clear_check_info ( playerid, CINFO_JACKPOT_ID ) ;
		    return 1 ;
		}
		case area_type_barriers:
		{
		    clear_check_info ( playerid, CINFO_BARRIERS_ID ) ;
		    return 1 ;
		}
		case area_type_doors:
		{
		    clear_check_info ( playerid, CINFO_DOORS_ID ) ;
		    return 1 ;
		}
		case area_type_tuning:
		{
		    clear_check_info ( playerid, CINFO_TUNING_ID ) ;
		    return 1 ;
		}
		case area_type_safe:
		{
		    clear_check_info ( playerid, CINFO_HOUSE_SAFE_ID ) ;
		    return 1 ;
		}
		case area_type_freeze:
		{
		    clear_check_info ( playerid, CINFO_HOUSE_FREEZE_ID ) ;
		    return 1 ;
		}
		case area_type_cellar:
		{
		    clear_check_info ( playerid, CINFO_HOUSE_CELLAR_ID ) ;
		    return 1 ;
		}
		case area_type_cellar_table:
		{
		    clear_check_info ( playerid, CINFO_CELLAR_ID ) ;
		    return 1 ;
		}
		case area_type_forest:
		{
		    clear_check_info ( playerid, CINFO_FOREST_ID ) ;
		   	return 1 ;
		}
		case area_type_housegarage:
		{
		    clear_check_info ( playerid, CINFO_HOUSEGARAGE_ID ) ;
		    return 1 ;
		}
		case area_type_cellargarage:
		{
		    clear_check_info ( playerid, CINFO_CELLARGARAGE_ID ) ;
		    return 1 ;
		}
	}
	return 1 ;
}

stock antiflood_OnPlayerText ( playerid, text [ ], _type )
{
    new _a_id = used_area [ playerid ] ;
	if ( _a_id != -1 )
	{
		new _a_type = area_info [ _a_id ] [ a_type ] ;
		if ( _a_type == area_type_antidm || _a_type == area_type_sellstatus )
		{
			if ( ! IsAGoodMessage ( text ) )
			{
			    SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}В данной зоне запрещено писать капсом (слишком много больших букв)." ) ;
				return 0 ;
			}

			new _text_cooldown = 500 ;
			if ( GetString ( text, text_double_message [ playerid ] ) ) _text_cooldown = 3000 ;
			else _text_cooldown = 1000 ;

			if ( _type == 1 )
			{
			    if ( GetTickCount ( ) - text_cooldown [ playerid ] < _text_cooldown )
				{
					SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Не флудите." ) ;
					return 0 ;
				}

				format ( text_double_message [ playerid ], 144, "%s", text ) ;
				text_cooldown [ playerid ] = GetTickCount ( ) ;
			}
			else if ( _type == 2 )
			{
			    if ( GetTickCount ( ) - shout_cooldown [ playerid ] < _text_cooldown )
				{
					SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Не флудите." ) ;
					return 0 ;
				}

				format ( text_double_message [ playerid ], 144, "%s", text ) ;
				shout_cooldown [ playerid ] = GetTickCount ( ) ;
			}
		}
	}
	else
	{
		if ( _type == 1 )
		{
		    if ( GetTickCount ( ) - text_cooldown [ playerid ] < 500 )
			{
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Не флудите." ) ;
				return 0 ;
			}

			text_cooldown [ playerid ] = GetTickCount ( ) ;
		}
		else if ( _type == 2 )
		{
		    if ( GetTickCount ( ) - shout_cooldown [ playerid ] < 500 )
			{
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Не флудите." ) ;
				return 0 ;
			}

			shout_cooldown [ playerid ] = GetTickCount ( ) ;
		}
	}
	return 1 ;
}

public OnPlayerText ( playerid, text [ ] )
{
	if ( p_t_info [ playerid ] [ p_logged ] == false ) return false ;
	if ( google_checking { playerid } == 1 && p_t_info [ playerid ] [ p_dialog ] != d_googleauth_entrance ) return false ;
    if ( player_mp [ playerid ] && ! admin_mp_chat ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Запрещено использовать на мероприятии." ), false ;
	if ( p_info [ playerid ] [ mute ] )
	{
		new _t_string [ 38 ] ;
		format ( _t_string, sizeof ( _t_string ), "У Вас бан чата | %d секунд(ы)", p_info [ playerid ] [ mute ] ) ;
		SendClientMessage ( playerid, col_light_red, _t_string ) ;

		SetPlayerChatBubble ( playerid, "Пытается что-то сказать\nУ игрока блокировка чата", col_red, 15, 10000 ) ;
		return false ;
	}
	if ( check_advertise ( playerid, text, report_type_chat ) )return false ;
	if ( ! antiflood_OnPlayerText ( playerid, text, 1 ) ) return false ;

	new _t_string [ 144 ],
		t_string [ 144 ] ;

	if ( strlen ( text [ 0 ] ) > 1 )
	{
		switch ( text [ 0 ] )
	  	{
	   		case '!':
			{
				format ( _t_string, sizeof _t_string, "%s", text [ 0 + 1 ] ) ;

				new clf_string [ 100 ] ;
	   			format ( clf_string, sizeof clf_string, "%s", _t_string ) ;
			    callcmd::n ( playerid, clf_string ) ;
				return false ;
			}
		}
	}

    /*if ( strfind ( text, "!", true) != -1 )
	{
	    for ( new i = 0 ; i < strlen ( text ) ; i ++ )
	    {
	        if ( i > 0 ) break ;
	        switch ( text [ i ] )
	        {
	            case '!':
				{
					format ( _t_string, sizeof _t_string, "%s", text [ i + 1 ] ) ;

					new clf_string [ 100 ] ;
				    format ( clf_string, sizeof clf_string, "%s", _t_string ) ;
				    callcmd::n ( playerid, clf_string ) ;
					return false ;
				}
			}
		}
	}*/

	if ( is_ether { playerid } )
	{
	    if ( is_ether { playerid } == 27 )
	    {
	        new _fraction_id = is_ether { playerid } ;
	        if ( _fraction_id < 1 )
	        {
	            SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Ошибка #111. Переподключитесь к эфиру." ) ;
				is_ether { playerid } = 0 ;
				return false ;
	        }

			if ( p_info [ playerid ] [ member ] == 27 ) format ( _t_string, sizeof ( _t_string ), "< Радио %s > %s: %s", f_info [ _fraction_id - 1 ] [ f_letter_name ], p_info [ playerid ] [ name ], text ) ;
			else format ( _t_string, sizeof ( _t_string ), "< Радио %s > %s (тел.): %s", f_info [ _fraction_id - 1 ] [ f_letter_name ], p_info [ playerid ] [ name ], text ) ;

			foreach(new i: logged_players)
			{
				if ( p_info [ i ] [ radio ] != is_ether { playerid } )continue ;
				SendClientMessage ( i, 0x10ACF6FF, _t_string ) ;
			}
			return false ;
		}
	}

	if ( g_phone_call [ playerid ] [ PC_STATUS ] )
	{
		format ( _t_string, 144, "сказал(а) по телефону: {"#cWH"}%s", text ) ;
		SetPlayerChatBubble ( playerid, _t_string, col_light_purple, 5.0, 10000 ) ;

		format ( _t_string, 144, "Телефон - %s: {"#cWH"}%s", p_info [ playerid ] [ name ], text ) ;

		new phid = INVALID_PLAYER_ID,
			incomingPlayer = g_phone_call [ playerid ] [ PC_INCOMING_PLAYER ],
			outcomingPlayer = g_phone_call [ playerid ] [ PC_OUTCOMING_PLAYER ],
			incomingNumber,
			outcomingNumber ;

		if ( incomingPlayer != INVALID_PLAYER_ID )
		{
			phid = incomingPlayer ;
			incomingNumber = p_info [ phid ] [ number ] ;
		}
		else
		{
			phid = outcomingPlayer ;
			outcomingNumber = p_info [ phid ] [ number ] ;
		}

		SendClientMessage ( phid, col_yellow, _t_string ) ;
		SendClientMessage ( playerid, col_yellow, _t_string ) ;

		format ( _t_string, 144, "* [ПРОСЛУШИВАНИЕ] Телефон - %s: {"#cWH"}%s", p_info [ playerid ] [ name ], text ) ;
		foreach(new i : fraction_players[7])
		{
			if ( p_t_info [ i ] [ phone_audition ] == incomingNumber ||
				p_t_info [ i ] [ phone_audition ] == outcomingNumber )
			{
				SendClientMessage ( i, col_yellow, _t_string ) ;
			}
		}
		return false ;
	}

	if ( p_info [ playerid ] [ member ] > 0 && is_fraction_duty { playerid } )
	{
		format( _t_string, sizeof ( _t_string ), "- %s {%06x}(%s) [%d]", text, GetPlayerColor(playerid) >>> 8, p_info [ playerid ] [ name ], playerid ) ;
		format( t_string, sizeof ( t_string ), "- %s {%06x}(%s)", text, GetPlayerColor(playerid) >>> 8, p_info [ playerid ] [ name ] ) ;
	}
	else
	{
		format( _t_string, sizeof ( _t_string ), "- %s (%s) [%d]", text, p_info [ playerid ] [ name ], playerid ) ;
		format( t_string, sizeof ( t_string ), "- %s (%s)", text, p_info [ playerid ] [ name ] ) ;

	}


    if ( p_info [ playerid ] [ settings ] [ 3 ] )SendClientMessage ( playerid, col_white, _t_string ) ;
	else SendClientMessage ( playerid, col_white, t_string ) ;



	new Float: point_x,
		Float: point_y,
		Float: point_z,
		Float: distance ;
	GetPlayerPos ( playerid, point_x, point_y, point_z ) ;

	if ( Iter_Count (streamed_players[ playerid ]) != 0 )
	{
		foreach(new i: streamed_players[playerid])
		{
			if ( IsPlayerInRangeOfPoint ( i, 25.0, point_x, point_y, point_z ) && GetPlayerVirtualWorld ( i ) == GetPlayerVirtualWorld ( playerid ) )
			{
				distance = GetPlayerDistanceFromPoint ( i, point_x, point_y, point_z ) ;
				if ( distance >= 0.0 && distance < 15.0 / 3 )
				{
					if ( p_info [ i ] [ settings ] [ 3 ] )SendClientMessage ( i, col_white, _t_string ) ;
					else SendClientMessage ( i, col_white, t_string ) ;
				}
				if ( distance >= 15.0 / 3 && distance < 15.0 / 3 * 2 )
				{
					if ( p_info [ i ] [ settings ] [ 3 ] )SendClientMessage ( i, 0xCCCCCCFF, _t_string ) ;
					else SendClientMessage ( i, 0xCCCCCCFF, t_string ) ;
				}
				if ( distance >= 15.0 / 3 * 2 && distance <= 25.0 )
				{
					if ( p_info [ i ] [ settings ] [ 3 ] )SendClientMessage ( i, 0xAAAAAAFF, _t_string ) ;
					else SendClientMessage ( i, 0xAAAAAAFF, t_string ) ;
				}
			}
		}

		SetPlayerChatBubble ( playerid, text, col_white, 15, 10000 ) ;
	}

	foreach(new i: admin_players)
	{
		if ( i == playerid ) continue ;
		if ( admin_info [ i ] [ spectate_id ] != -1 )
		{
			if ( IsPlayerInRangeOfPoint ( i, 25.0, point_x, point_y, point_z ) && GetPlayerVirtualWorld ( i ) == GetPlayerVirtualWorld ( playerid ) )
			{
				distance = GetPlayerDistanceFromPoint ( i, point_x, point_y, point_z ) ;
				if ( distance >= 0.0 && distance < 15.0 / 3 )
				{
					if ( p_info [ i ] [ settings ] [ 3 ] )SendClientMessage ( i, col_white, _t_string ) ;
					else SendClientMessage ( i, col_white, t_string ) ;
				}
				if ( distance >= 15.0 / 3 && distance < 15.0 / 3 * 2 )
				{
					if ( p_info [ i ] [ settings ] [ 3 ] )SendClientMessage ( i, 0xCCCCCCFF, _t_string ) ;
					else SendClientMessage ( i, 0xCCCCCCFF, t_string ) ;
				}
				if ( distance >= 15.0 / 3 * 2 && distance <= 25.0 )
				{
					if ( p_info [ i ] [ settings ] [ 3 ] )SendClientMessage ( i, 0xAAAAAAFF, _t_string ) ;
					else SendClientMessage ( i, 0xAAAAAAFF, t_string ) ;
				}
			}
		}
	}

	if ( GetPlayerState ( playerid ) != PLAYER_STATE_ONFOOT || p_t_info [ playerid ] [ p_animation ] ||
			p_t_info [ playerid ] [ gym_shell ] || g_phone_call [ playerid ] [ PC_STATUS ] ) return 0 ;

	switch( p_info [ playerid ] [ textstyle ] )
	{
		case 0: ApplyAnimation ( playerid, "PED", "IDLE_CHAT", 4.1, 0, 1, 1, 1, 1, 1) ;
		case 1: ApplyAnimation ( playerid, "GANGS", "prtial_gngtlkA", 4.1, 0, 1, 1, 1, 1, 1) ;
		case 2: ApplyAnimation ( playerid, "GANGS", "prtial_gngtlkB", 4.1, 0, 1, 1, 1, 1, 1) ;
		case 3: ApplyAnimation ( playerid, "GANGS", "prtial_gngtlkD", 4.1, 0, 1, 1, 1, 1, 1) ;
		case 4: ApplyAnimation ( playerid, "GANGS", "prtial_gngtlkE", 4.1, 0, 1, 1, 1, 1, 1) ;
		case 5: ApplyAnimation ( playerid, "GANGS", "prtial_gngtlkF", 4.1, 0, 1, 1, 1, 1, 1) ;
		case 6: ApplyAnimation ( playerid, "GANGS", "prtial_gngtlkG", 4.1, 0, 1, 1, 1, 1, 1) ;
		default: return 0 ;
	}
	SetTimerEx ( "clear_anim", 2000, false, "d", playerid ) ;
	return 0 ;
}

public OnPlayerEnterCheckpoint ( playerid )
{
	new Float:x_p, Float:y_p, Float:y_z ;
	GetPlayerPos ( playerid, x_p, y_p, y_z ) ;
	#if defined debug_mode
		printf ( "[DEBUG] [OnPlayerEnterCheckpoint] playerid: %d %f %f %f", playerid, x_p, y_p, y_z ) ;
	#endif

	switch ( GetPlayerState ( playerid ) )
	{
		case PLAYER_STATE_ONFOOT:
		{
		    if ( is_checkpoint_used { playerid } == 0 )
			{
			    DisablePlayerCheckpoint ( playerid ) ;
				is_checkpoint_used { playerid } = 0 ;
			    return 1 ;
			}
		    else if ( is_checkpoint_used { playerid } == 1 )
			{
				if ( p_info [ playerid ] [ timejob ] == job_factory )
				{
					if ( ! IsPlayerInRangeOfPoint ( playerid, 8.0, factory_box_unload [ 0 ], factory_box_unload [ 1 ], factory_box_unload [ 2 ] ) ) return 1 ;
					if ( ! IsPlayerAttachedObjectSlotUsed ( playerid, 0 ) || have_factory_box [ playerid ] != false || IsPlayerAttachedObjectSlotUsed ( playerid, 1 ) ) return 1 ;
					ClearAnimations ( playerid ) ;
					ApplyAnimation ( playerid, "CARRY", "putdwn", 4.0, 0, 1, 1, 0, 0, 1 ) ;

					p_t_info [ playerid ] [ p_animation ] = false ;

					p_info [ playerid ] [ newbie_job_skill ] [ 3 ] += 1 * server_bonus [ 2 ] ;

					new _payment = 65 ;
					switch ( p_info [ playerid ] [ newbie_job_skill ] [ 3 ] )
					{
						/*case 0..50: _payment = 65 ;
						case 51..100: _payment = 70 ;
						case 101..150: _payment = 80 ;
						case 151..200: _payment = 90 ;
						default: _payment = 100 ;*/
						case 0..50: _payment = 65000 ;
						case 51..100: _payment = 70000 ;
						case 101..150: _payment = 80000 ;
						case 151..200: _payment = 90000 ;
						default: _payment = 100000 ;
					}

					#if defined m_perks
					new _perk_stats = get_perk_info ( playerid, PERK_JOBMAN ) ;
					if ( _perk_stats > 0 ) _payment = _payment + floatround ( ( _payment * _perk_stats ) / 100 ) ;
					#endif

					new _mathmatic = ( _payment * zp_for_gos [ 3 ] ) * server_bonus [ 3 ] ;
					p_info [ playerid ] [ salary ] += _mathmatic ;
					update_payment ( playerid, _mathmatic ) ;

					RemovePlayerAttachedObject ( playerid, 0 ) ;
					DisablePlayerCheckpoint ( playerid ) ;
					is_checkpoint_used { playerid } = 0 ;

					if ( dorm_count [ DORM_FACTORY_GUNS ] < 1000000 - 60 ) dorm_count [ DORM_FACTORY_GUNS ] += 60 ;
					else dorm_count [ DORM_FACTORY_GUNS ] += 1000000 - dorm_count [ DORM_FACTORY_GUNS ] ;

					if ( dorm_count [ DORM_FACTORY_WOOD ] > 0 ) dorm_count [ DORM_FACTORY_WOOD ] -= 25 ;
					if ( dorm_count [ DORM_FACTORY_MINE ] > 0 ) dorm_count [ DORM_FACTORY_MINE ] -= 25 ;

					new dorm_string [ 238 ] ;
					format ( dorm_string, sizeof ( dorm_string ), "** Состояние склада **\n{"#cGR3D"}Заготовки:{"#cWH"} %i / 1.000.000\n{"#cGR3D"}Металл:{"#cWH"} %i / 1.000.000\n{"#cGR3D"}Древесина:{"#cWH"} %i / 1.000.000",
																	dorm_count [ DORM_FACTORY_GUNS ],
																	dorm_count [ DORM_FACTORY_WOOD ],
																	dorm_count [ DORM_FACTORY_MINE ] ) ;
					UpdateDynamic3DTextLabelText ( dorm_text [ DORM_FACTORY ], col_header_3d, dorm_string ) ;

					SetPlayerCheckpoint ( playerid, factory_box_position [ 0 ], factory_box_position [ 1 ], factory_box_position [ 2 ], 2.5 ) ;
					is_checkpoint_used { playerid } = 0 ;
					return 1 ;
				}
			}
			else if ( is_checkpoint_used { playerid } == 2 )
			{
			    if ( p_info [ playerid ] [ timejob ] == job_miner )
				{
					new cp_id = player_miner_cp { playerid } ;

					if ( IsPlayerInRangeOfPoint ( playerid, 3.5, miner_cp [ cp_id ] [ 0 ], miner_cp [ cp_id ] [ 1 ], miner_cp [ cp_id ] [ 2 ] ) )// точки добычи
					{
						ClearAnimations ( playerid ) ;
						mining_ex [ playerid ] = true ;

						ApplyAnimation ( playerid, "BASEBALL","Bat_4", 4.1, 1, 0, 0, 1, 11000 ) ;
						p_t_info [ playerid ] [ p_animation ] = true ;

						DisablePlayerCheckpoint ( playerid ) ;
						is_checkpoint_used { playerid } = 0 ;

						job_timer [ playerid ] = SetTimerEx ( "main_jobs_timer", 5800, false, "i", playerid ) ;
					}
					else if ( IsPlayerInRangeOfPoint ( playerid, 5, miner_unload_position [ 0 ], miner_unload_position [ 1 ], miner_unload_position [ 2 ] ) )// переплавка
					{
						p_t_info [ playerid ] [ p_animation ] = false ;
						ClearAnimations ( playerid ) ;

						if ( IsPlayerAttachedObjectSlotUsed ( playerid, 2 ) ) RemovePlayerAttachedObject ( playerid, 2 ) ;
						if ( IsPlayerAttachedObjectSlotUsed ( playerid, 3 ) ) RemovePlayerAttachedObject ( playerid, 3 ) ;

                        DisablePlayerCheckpoint ( playerid ) ;
						is_checkpoint_used { playerid } = 0 ;

						p_info [ playerid ] [ newbie_job_skill ] [ 1 ] += 1 * server_bonus [ 2 ] ;

						new _payment = 65 ;
						switch ( p_info [ playerid ] [ newbie_job_skill ] [ 1 ] )
						{
							/*case 0..50: _payment = 65 ;
							case 51..100: _payment = 70 ;
							case 101..150: _payment = 80 ;
							case 151..200: _payment = 90 ;
							default: _payment = 100 ;*/
							case 0..50: _payment = 65000 ;
							case 51..100: _payment = 70000 ;
							case 101..150: _payment = 80000 ;
							case 151..200: _payment = 90000 ;
							default: _payment = 100000 ;
						}

						#if defined m_perks
						new _perk_stats = get_perk_info ( playerid, PERK_JOBMAN ) ;
						if ( _perk_stats > 0 ) _payment = _payment + floatround ( ( _payment * _perk_stats ) / 100 ) ;
						#endif

						new _mathmatic = ( _payment * zp_for_gos [ 2 ] ) * server_bonus [ 3 ] ;
						p_info [ playerid ] [ salary ] += _mathmatic ;
						update_payment ( playerid, _mathmatic ) ;

						checking_quest_progress ( playerid, 1, _mathmatic, quest_line_start ) ;

						new _t_string [ 134 ] ;
						mine_count [ MINE_UNMELTED ] += GetPVarInt ( playerid, "_mine_count" ) ;
						format ( _t_string, 134, "** Переплавка **\n{"#cGR3D"}Руда: {"#cWH"}%d кг.\n{"#cGR3D"}Металл: {"#cWH"}%d кг.", mine_count [ MINE_UNMELTED ], mine_count [ MINE_MELTED ] ) ;
						UpdateDynamic3DTextLabelText ( mine_text, col_header_3d, _t_string ) ;

						DeletePVar ( playerid, "_mine_count" ) ;

						new _random = random ( 11 ) ;
						SetPlayerCheckpoint ( playerid, miner_cp [ _random ] [ 0 ], miner_cp [ _random ] [ 1 ], miner_cp [ _random ] [ 2 ], 2.5 ) ;
						is_checkpoint_used { playerid } = 2 ;

						player_miner_cp { playerid } = _random ;

						SetPlayerAttachedObject ( playerid, 1, 18634, 14, 0.333391, 0.000000, 0.042249, 358.219909, 268.014739, 170.032974, 2.003867, 1.764811, 1.579773 ) ;
						return 1 ;
					}
				}
			}
		    else if ( is_checkpoint_used { playerid } == 3 )
			{
			    if ( factory_place { playerid } > 0 && IsPlayerInRangeOfPoint ( playerid, 10.0, -2162.3396, -264.2673, 36.5156 ) )
				{
				    new mafia_text [ 112 ] ;
					new slot = factory_slot { playerid } ;
					if ( MafiaMetal [ slot ] < 200 )
					{
					    SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Недостаточно металла на складе." ) ;
					    return 1;
					}
					MafiaMetal [ slot ] -= 200 ;
					format ( mafia_text, 110, "{%s}*** %s ***\n{"#cGR3D"}Металла: {"#cWH3D"}%i кг.", f_info [ MafiaMatsSlot [ slot ] - 1 ] [ f_chat_color ], f_info [ MafiaMatsSlot [ slot ] - 1 ] [ f_name ], MafiaMetal [ slot ] ) ;
					UpdateDynamic3DTextLabelText ( RifaKyznica [ 0 + slot ], -1, mafia_text ) ;
			        SetPlayerAttachedObject( playerid, 0, 2969, 1, 0.175578, 0.347083, 0.000000, 1.248928, 97.393852, 359.645050, 1.000000, 1.000000, 1.000000 );
				 	ApplyAnimation(playerid,"CARRY","crry_prtial",4.1,0,1,1,1,1);

				 	is_checkpoint_used { playerid } = 0 ;
					DisablePlayerCheckpoint ( playerid ) ;

			    	new i = factory_place { playerid } - 1 ;
			    	SetPlayerCheckpoint ( playerid, InFactorySF [ i ] [ 0 ], InFactorySF [ i ] [ 1 ], InFactorySF [ i ] [ 2 ], 1.4 ) ;
			    	is_checkpoint_used { playerid } = 3 ;

			    	SendClientMessage ( playerid, col_succes, !"Следуйте к вашему рабочему столу." ) ;
			    	return 1 ;
				}
				else if ( factory_place { playerid } > 0 && IsPlayerInRangeOfPoint ( playerid, 3.0, InFactorySF [ factory_place { playerid } - 1 ] [ 0 ], InFactorySF [ factory_place { playerid } - 1 ] [ 1 ], InFactorySF [ factory_place { playerid } - 1 ] [ 2 ] ) )
				{
				    if ( IsPlayerAttachedObjectSlotUsed ( playerid, 0 ) ) RemovePlayerAttachedObject ( playerid, 0 ) ;
					ClearAnimations ( playerid ) ;
					ApplyAnimation( playerid, "BUDDY", "buddy_reload", 4.1, 0, 1, 1, 1, 0 ) ;
					SetPlayerAttachedObject( playerid, 0, 355, 14, 0.301943, 0.011442, 0.010348, 106.050292, 330.509094, 3.293162, 1.000000, 1.000000, 1.000000 ) ;

					#if defined m_action
						if ( player_device { playerid } == 2 )
						{
							action_type { playerid } = ACTION_PLANT ;
						    actionShow ( playerid, "Сборка оружия", 100 ) ;
       						return 1 ;
	    				}
					#endif

					action_type { playerid } = ACTION_PLANT ;
					action_step { playerid } = 0 ;
					action_td_status ( playerid, true ) ;

                    is_checkpoint_used { playerid } = 0 ;
					DisablePlayerCheckpoint ( playerid ) ;
					return 1 ;
				}
			}
			else if ( is_checkpoint_used { playerid } == 4 )
			{
				if ( p_info [ playerid ] [ timejob ] == job_sawmil && IsPlayerInRangeOfPoint ( playerid, 3.0, tree_unload_position [ 0 ], tree_unload_position [ 1 ], tree_unload_position [ 2 ] ) )
				{
				    is_checkpoint_used { playerid } = 0 ;
					DisablePlayerCheckpoint ( playerid ) ;
					RemovePlayerAttachedObject ( playerid, 3 ) ;

					p_info [ playerid ] [ newbie_job_skill ] [ 2 ] += 1 * server_bonus [ 2 ] ;

					new _payment = 65 ;
					switch ( p_info [ playerid ] [ newbie_job_skill ] [ 2 ] )
					{
						/*case 0..50: _payment = 65 ;
						case 51..100: _payment = 70 ;
						case 101..150: _payment = 80 ;
						case 151..200: _payment = 90 ;
						default: _payment = 100 ;*/
						case 0..50: _payment = 65000 ;
						case 51..100: _payment = 70000 ;
						case 101..150: _payment = 80000 ;
						case 151..200: _payment = 90000 ;
						default: _payment = 100000 ;
					}

					#if defined m_perks
					new _perk_stats = get_perk_info ( playerid, PERK_JOBMAN ) ;
					if ( _perk_stats > 0 ) _payment = _payment + floatround ( ( _payment * _perk_stats ) / 100 ) ;
					#endif

					new _mathmatic = ( _payment * zp_for_gos [ 4 ] ) * server_bonus [ 3 ] ;
					p_info [ playerid ] [ salary ] += _mathmatic ;
					update_payment ( playerid, _mathmatic ) ;

					checking_quest_progress ( playerid, 0, _mathmatic, quest_line_start ) ;

					ClearAnimations ( playerid ) ;

					ApplyAnimation ( playerid, "CARRY", "putdwn", 4.0, 0, 1, 1, 0, 0, 1 ) ;

					tree_id [ playerid ] = 0 ;
					tree_process [ playerid ] = 0 ;
					tree_status [ playerid ] = false ;

					tree_id [ playerid ] = tree_count ;

					new dorm_string [ 72 ] ;
					dorm_count [ DORM_SAWMILL ] += 30 + random ( 30 ) ;
					format ( dorm_string, 72, "** Древесина **\n{"#cGR3D"}Кол-во на складе:{"#cWH"} %i кг.", dorm_count [ DORM_SAWMILL ] ) ;
					UpdateDynamic3DTextLabelText ( dorm_text [ DORM_SAWMILL ], col_header_3d, dorm_string ) ;

					tree_count ++ ;
					reset_tree ( ) ;

					SetPlayerCheckpoint ( playerid, tree_positions [ tree_id [ playerid ] ] [ 0 ], tree_positions [ tree_id [ playerid ] ] [ 1 ], tree_positions [ tree_id [ playerid ] ] [ 2 ], 3.0 ) ;
                    is_checkpoint_used { playerid } = 4 ;
					return 1 ;
				}
			}
		}
	}
	return 1 ;
}

public OnPlayerEnterVehicle ( playerid, vehicleid, ispassenger )
{
	#if defined debug_mode
		printf ( "[DEBUG] [OnPlayerEnterVehicle] playerid:%d | vehicleid:%d | ispassenger:%d", playerid, vehicleid, ispassenger ) ;
	#endif
	//ac_OnPlayerEnterVehicle ( playerid, vehicleid, ispassenger) ;
	eev_called { playerid } = 1 ;

	#if defined m_delivery
	    delivery_EnterVehicle ( playerid ) ;
	#endif

	#if defined m_jobs_module
		taxi_OnPlayerEnterVehicle ( playerid, vehicleid ) ;
	#endif

	#if defined m_guards_module
		guards_OnPlayerEnterVehicle ( playerid, vehicleid ) ;
	#endif

	if ( have_box [ playerid ] )
	{
		if ( job_timer [ playerid ] != -1 )KillTimer ( job_timer [ playerid ] ) ;
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы уронили коробку. Попробуйте еще раз." ) ;

		RemovePlayerAttachedObject ( playerid, 0 ) ;
		have_box [ playerid ] = false ;
		p_t_info [ playerid ] [ p_animation ] = false ;

		DisablePlayerCheckpoint ( playerid ) ;

		ClearAnimations ( playerid ) ;
		ApplyAnimation ( playerid, "PED","IDLE_tired", 4.1, 0, 1, 1, 0, 1 ) ;
		box_submarine [ playerid ] = 0 ;
		return 1 ;
	}

	/*if ( ! ispassenger && veh_info [ vehicleid - 1 ] [ v_driver ] != INVALID_PLAYER_ID )
	{
		new Float:X, Float:Y, Float:Z ;
		GetPlayerPos ( playerid, X, Y, Z ) ;
		SetPlayerPos ( playerid, X, Y, Z ) ;

		SendClientMessage ( playerid, col_red, !"* Водительское место в т/с занято." ) ;
	    return 1 ;
	}*/

	opev_opsc_time_differ [ playerid ] = GetTickCount ( ) ;

	opev_vehicleid [ playerid ] = vehicleid ;
	exv_called { playerid } = 0 ;
	new Float:veh_x, Float:veh_y, Float:veh_z ;
	GetVehiclePos ( vehicleid, veh_x, veh_y, veh_z ) ;

	new Float:opev_distance ;
	opev_distance = GetPlayerDistanceFromPoint ( playerid, veh_x, veh_y, veh_z ) ;

	if ( opev_distance < 0.35 && GetVehicleModel ( vehicleid ) != 93 && player_device { playerid } == 1 ) anti_cheat ( playerid, "tp in car", 95 ) ;

	opev_vehicleid [ playerid ] = vehicleid ;
	used_enter [ playerid ] = true ;
 	return 1 ;
}

public OnPlayerExitVehicle ( playerid, vehicleid )
{
	#if defined debug_mode
		printf ( "[DEBUG] [OnPlayerExitVehicle] playerid:%d | vehicleid:%d ", playerid, vehicleid ) ;
	#endif
	exv_called { playerid } = 1 ;
	opev_opsc_time_differ [ playerid ] = 0 ;

	#if defined m_delivery
	    delivery_ExitVehicle ( playerid ) ;
	#endif

	#if defined m_guards_module
		guards_OnPlayerExitVehicle ( playerid, vehicleid ) ;
	#endif

	if ( p_t_info [ playerid ] [ car_audio ] )
	{
	    foreach(new i: streamed_players[playerid])
		{
			if ( GetPlayerVehicleID ( playerid ) == GetPlayerVehicleID ( i ) )
			{
   				StopAudioStreamForPlayer ( i ) ;
		    	SendClientMessage ( i, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Аудио-система в транспорте отключена." ) ;
			}
		}
	    p_t_info [ playerid ] [ car_audio ] = false ;
	    DeletePVar ( playerid, "BBStation" ) ;
	}
	StopAudioStreamForPlayer ( playerid ) ;

	if ( p_t_info [ playerid ] [ pl_veh ] != INVALID_VEHICLE_ID )
	{
		DestroyVehicle ( p_t_info [ playerid ] [ pl_veh ], 61 ) ;
		p_t_info [ playerid ] [ pl_veh ] = INVALID_VEHICLE_ID ;

		if ( IsValidDynamicObject ( p_t_info [ playerid ] [ pl_object ] ) )
		{
			DestroyDynamicObject ( p_t_info [ playerid ] [ pl_object ] ) ;
			p_t_info [ playerid ] [ pl_object ] = INVALID_OBJECT_ID ;
		}

		if ( IsValidDynamic3DTextLabel ( p_t_info [ playerid ] [ pl_label ] ) )
		{
			DestroyDynamic3DTextLabel ( p_t_info [ playerid ] [ pl_label ] ) ;
			p_t_info [ playerid ] [ pl_label ] = Text3D:INVALID_3DTEXT_ID ;
		}
	}

	if ( p_t_info [ playerid ] [ test_drive ] != INVALID_VEHICLE_ID )
	{
	    DestroyVehicle ( p_t_info [ playerid ] [ test_drive ], 100 ) ;
	    p_t_info [ playerid ] [ test_drive ] = INVALID_VEHICLE_ID ;
		exit_test_drive ( playerid ) ;
	}

	if ( exam_vehicle [ playerid ] != INVALID_VEHICLE_ID )
	{
		is_leave_exam_vehicle { playerid } = 15 ;
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас есть {"#cRD"}15 секунд{"#cGRInfo"} для возврата в транспорт, иначе экзамен будет провален." ) ;
		GameTextForPlayer ( playerid, "~r~15", 5000, 6 ) ;

		new engine, lights, alarm, doors, bonnet, boot, objective ;
		veh_info [ exam_vehicle [ playerid ] - 1 ] [ v_locked ] = false ;
		GetVehicleParamsEx ( exam_vehicle [ playerid ], engine, lights, alarm, doors, bonnet, boot, objective ) ;
		SetVehicleParamsEx ( exam_vehicle [ playerid ], engine, lights, alarm, false, bonnet, boot, objective ) ;
	}

	#if defined m_familys
	    familys_OnPlayerExitVehicle ( playerid, vehicleid ) ;
	#endif

	if ( p_t_info [ playerid ] [ player_station ] != -1 )
	{
	    new driverid = veh_info [ vehicleid - 1 ] [ v_driver ] ;
	    if ( driverid == playerid || p_info [ driverid ] [ job ] == job_bus || p_info [ driverid ] [ job ] == job_taxi ) { }
		else
		{
	    	SetPVarInt ( playerid, "driverid", driverid ) ;
			show_dialog ( playerid, d_busstation_exit, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Перевозка", "{"#cWH"}Вас довезли до места, до которого Вам было нужно?", "Да", "Нет" ) ;
		}
	}

	/*if ( GetPlayerState ( playerid ) == PLAYER_STATE_DRIVER )
	{
	    if ( used_area [ playerid ] != -1 )
	    {
	    	if ( area_info [ used_area [ playerid ] ] [ a_type ] == area_type_noparking && veh_info [ vehicleid - 1 ] [ v_model ] != 462 &&
				( veh_info [ vehicleid - 1 ] [ v_type ] == vehicle_type_player || veh_info [ vehicleid - 1 ] [ v_type ] == vehicle_type_job ) )
	    	{
	    	    SendClientMessage ( playerid, col_red, "* Вы припарковали транспорт в зоне запрета парковки, он будет отправлен на место парковки через минуту." ) ;
				veh_info [ vehicleid - 1 ] [ v_time_spawn ] = 60 ;
	    	}
		}
	}*/

	player_vehicle [ playerid ] = INVALID_VEHICLE_ID ;
	veh_info [ vehicleid - 1 ] [ v_spawn_time ] = gettime ( ) + 180 ;

	if ( GetPlayerState ( playerid ) == PLAYER_STATE_DRIVER )
	{
	    /*if ( veh_info [ vehicleid - 1 ] [ v_type ] == vehicle_type_player && used_area [ playerid ] != -1 )
		{
			if ( veh_info [ vehicleid - 1 ] [ v_spawn_time ] < gettime ( ) && ! v_plane ( vehicleid ) && ! v_boat ( vehicleid ) )
			{
			    new _a_type = area_info [ used_area [ playerid ] ] [ a_type ] ;
				if ( _a_type == area_type_noparking )
				{
				    SendClientMessage ( playerid, col_red, !"* Вы припарковали транспорт в зоне запрета парковки." ) ;
				    SendClientMessage ( playerid, col_red, !"* Он будет отправлен на место парковки через 3 минуты бездействия." ) ;
				}
			}
		}*/
		veh_info [ vehicleid - 1 ] [ v_driver ] = INVALID_PLAYER_ID ;
	}
	return 1 ;
}

new bool: player_vehicle_damage [ MAX_PLAYERS ] ;
stock create_speedometr ( playerid )
{
	new _v_id = GetPlayerVehicleID ( playerid ) ;
	if ( GetPlayerVehicleID ( playerid ) == 0 ) return 1 ;
	if ( p_t_info [ playerid ] [ pl_veh ] != INVALID_VEHICLE_ID )
	{
		if ( p_t_info [ playerid ] [ pl_object ] != INVALID_OBJECT_ID ) return 1 ;

	    new veh_model = GetVehicleModelEx ( p_t_info [ playerid ] [ pl_veh ] ) ;
	    if ( veh_model == 487 )
		{
			if ( player_device { playerid } == 2 ) SendSpeedometr ( playerid, _v_id, false ) ;
			return 1 ;
		}
	}
	if ( v_velo ( _v_id ) || v_boat ( _v_id ) || v_plane ( _v_id ) )
	{
	    new engine, lights, alarm, doors, bonnet, boot, objective ;
		GetVehicleParamsEx ( _v_id, engine, lights, alarm, doors, bonnet, boot, objective ) ;

		if ( engine == VEHICLE_PARAMS_UNSET || engine == VEHICLE_PARAMS_OFF ) SetVehicleParamsEx ( _v_id, VEHICLE_PARAMS_ON, lights, alarm, doors, bonnet, boot, objective ) ;
		if ( player_device { playerid } == 2 ) SendSpeedometr ( playerid, _v_id, false ) ;
		return 1 ;
	}
    if ( speed_timer [ playerid ] == -1 )
	{
	    player_vehicle_damage [ playerid ] = false ;

		if ( player_device { playerid } == 2 ) SendSpeedometr ( playerid, _v_id, true ) ;
		else speedometr_status ( playerid, true ) ;

		speed_timer [ playerid ] = SetTimerEx ( "UpdatePlayerSpeedometr", 400, true, "i", playerid ) ;
		if ( player_device { playerid } == 2 && p_info [ playerid ] [ hud_id ] )
	  	{
			SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Нажмите на {"#cBL"}\"спидометр\"{"#cGRInfo"} или введите {"#cBL"}\"/en\"{"#cGRInfo"}, чтобы завести двигатель." ) ;
			SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Панель управления транспортом: {"#cBL"}\"/cpanel\"{"#cGRInfo"}." ) ;
		}
		else
		{
			SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Нажмите {"#cBL"}\"CTRL\"{"#cGRInfo"}, чтобы завести двигатель. Панель управления транспортом: {"#cBL"}\"/cpanel\"{"#cGRInfo"}." ) ;
			SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Нажмите {"#cBL"}\"H\"{"#cGRInfo"}, чтобы открыть багажник. Вы должны находиться у багажника." ) ;
		}
	}
	return 1 ;
}

stock kill_speedometr ( playerid )
{
	if ( speed_timer [ playerid ] != -1 )
	{
		speedometr_status ( playerid, false ) ;
		KillTimer ( speed_timer [ playerid ] ) ;
		speed_timer [ playerid ] = -1 ;
	}

	p_t_info [ playerid ] [ old_fuel ] =
    p_t_info [ playerid ] [ old_health ] =
    p_t_info [ playerid ] [ old_millage ] = 0 ;

    if ( p_t_info [ playerid ] [ test_drive ] != INVALID_VEHICLE_ID )
	{
	    DestroyVehicle ( p_t_info [ playerid ] [ test_drive ], 62 ) ;
	    p_t_info [ playerid ] [ test_drive ] = INVALID_VEHICLE_ID ;
		exit_test_drive ( playerid ) ;
	}
	if ( p_t_info [ playerid ] [ pl_veh ] != INVALID_VEHICLE_ID )
	{
		DestroyVehicle ( p_t_info [ playerid ] [ pl_veh ], 63 ) ;
		p_t_info [ playerid ] [ pl_veh ] = INVALID_VEHICLE_ID ;

		if ( IsValidDynamicObject ( p_t_info [ playerid ] [ pl_object ] ) )
		{
			DestroyDynamicObject ( p_t_info [ playerid ] [ pl_object ] ) ;
			p_t_info [ playerid ] [ pl_object ] = INVALID_OBJECT_ID ;
		}

		if ( IsValidDynamic3DTextLabel ( p_t_info [ playerid ] [ pl_label ] ) )
		{
			DestroyDynamic3DTextLabel ( p_t_info [ playerid ] [ pl_label ] ) ;
			p_t_info [ playerid ] [ pl_label ] = Text3D:INVALID_3DTEXT_ID ;
		}
	}
	return 1 ;
}

callback: UpdatePlayerSpeedometr ( playerid )
{
	new vehicleid = GetPlayerVehicleID ( playerid ) ;
	if ( GetPlayerState ( playerid ) == PLAYER_STATE_DRIVER && vehicleid > 0 )
	{
		new Float:_coord [ 3 ];
		GetVehicleVelocity ( vehicleid,_coord[0],_coord[1],_coord[2]);
		new Float:v_speed = floatsqroot(floatpower(floatabs(_coord[0]), 2.0) + floatpower(floatabs(_coord[1]), 2.0) + floatpower(floatabs(_coord[2]), 2.0)) * 100.3  ;

		// Rental scooters use the CRMP stock limit (model 462: 120 km/h).
		if ( veh_info [ vehicleid - 1 ] [ v_type ] == vehicle_type_rentcar_faggio )
		{
			new Float:max_faggio_speed = float ( max_veh_speed ( faggio_model ) ) ;
			if ( v_speed > max_faggio_speed )
			{
				SetVehicleSpeed ( vehicleid, max_faggio_speed ) ;
				v_speed = max_faggio_speed ;
			}
		}
		new Float:veh_health_now ;
		GetVehicleHealth( vehicleid, veh_health_now ) ;
		GetVehicleRotation ( vehicleid, _coord [ 0 ], _coord [ 1 ],_coord [ 2 ] ) ;

		if ( veh_info [ vehicleid - 1 ] [ v_ems ] == true )
		{
			if ( v_speed > 30 ) SetVehicleSpeed ( vehicleid, 30 ) ;
			veh_info [ vehicleid - 1 ] [ v_old_zangle ] = _coord [ 2 ] ;
		}

		new Float: _v_health ;
		GetVehicleHealth ( vehicleid, _v_health ) ;

		if ( _v_health < 350 )
	  	{
	  	    if ( player_vehicle_damage [ playerid ] == false )
	  	    {
	  	        player_vehicle_damage [ playerid ] = true ;
	  	        SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Ваш транспорт сильно повреждён и не может быстро ехать!" ) ;
	  	        SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте {"#cRInfo"}/gps - Найти ближайшую заправку{"#cGRInfo"}, чтобы починить транспорт." ) ;
	  	        SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте {"#cRInfo"}/gps - Найти ближайший 24/7{"#cGRInfo"}, чтобы купить рем. комплект." ) ;
	  	        SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте {"#cRInfo"}/service{"#cGRInfo"} или {"#cRInfo"}/dir{"#cGRInfo"} для вызова механика." ) ;
				if ( GetInventoryFindItem ( playerid, SUB_INVENTORY, 2156 ) > 0 ) SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}У Вас есть рем. комплект! Введите {"#cGN"}/repcar{"#cWH"}, чтобы использовать." ) ;
			}
	    	if ( v_speed > 30 ) SetVehicleSpeed ( vehicleid, 30 ) ;
	   	}

		veh_info [ vehicleid - 1 ] [ v_old_zangle ] = _coord [ 2 ] ;
		veh_info [ vehicleid - 1 ] [ v_health ] = veh_health_now ;
		veh_info [ vehicleid - 1 ] [ v_old_speed ] = v_speed ;

		/*#if defined SAMP
		if ( veh_info [ vehicleid - 1 ] [ v_brake_boost ] > 0 && GetVehicleSpeed ( vehicleid ) > 300 )anti_cheat ( playerid, "speed hack (3)", 301 ) ; // 260
		else if ( veh_info [ vehicleid - 1 ] [ v_brake_boost ] == 0 && GetVehicleSpeed ( vehicleid ) > 280 )anti_cheat ( playerid, "speed hack (4)", 302 ) ; // 230
		#else
		if ( veh_info [ vehicleid - 1 ] [ v_brake_boost ] > 0 && GetVehicleSpeed ( vehicleid ) > 320 )anti_cheat ( playerid, "speed hack (3)", 301 ) ; // 260
		else if ( veh_info [ vehicleid - 1 ] [ v_brake_boost ] == 0 && GetVehicleSpeed ( vehicleid ) > 300 )anti_cheat ( playerid, "speed hack (4)", 302 ) ; // 230
		#endif*/

		new engine, lights, alarm, doors, bonnet, boot, objective ;
		GetVehicleParamsEx ( vehicleid, engine, lights, alarm, doors, bonnet, boot, objective ) ;

		if ( veh_info [ vehicleid - 1 ] [ v_fuel ] < 1 && engine == VEHICLE_PARAMS_ON )
			SetVehicleParamsEx ( vehicleid, VEHICLE_PARAMS_OFF, lights, alarm, doors, bonnet, boot, objective ) ;

		if ( player_device { playerid } == 2 ) { }
		else
		{
			new td_string [ 24 ] ;
			format ( td_string, sizeof ( td_string ), "%d", GetVehicleSpeed ( vehicleid ) ) ;
			PlayerTextDrawSetString ( playerid, ptd_sp [ playerid ] [ 0 ], td_string ) ;

			if ( floatround ( veh_info [ vehicleid - 1 ] [ v_fuel ] ) != p_t_info [ playerid ] [ old_fuel ] )
			{
				format ( td_string, sizeof ( td_string ), "FUEL:_%dL.", floatround ( veh_info [ vehicleid - 1 ] [ v_fuel ] ) ) ;
				PlayerTextDrawSetString ( playerid, ptd_sp [ playerid ] [ 5 ], td_string ) ;

				new Float:td_x = veh_info [ vehicleid - 1 ] [ v_fuel ] * 0.439 ;
				PlayerTextDrawTextSize(playerid, ptd_sp [ playerid ] [ 6 ], td_x, 1.6598 ) ;
				PlayerTextDrawHide ( playerid, ptd_sp [ playerid ] [ 6 ] ) ;
				PlayerTextDrawShow ( playerid, ptd_sp [ playerid ] [ 6 ] ) ;

				p_t_info [ playerid ] [ old_fuel ] = floatround ( veh_info [ vehicleid - 1 ] [ v_fuel ] ) ;
			}

			if ( floatround ( _v_health ) != p_t_info [ playerid ] [ old_health ] )
			{
				format ( td_string, sizeof ( td_string ), "HEALTH:_%d_HP", floatround ( _v_health ) ) ;
				PlayerTextDrawSetString ( playerid, ptd_sp [ playerid ] [ 7 ], td_string ) ;

				p_t_info [ playerid ] [ old_health ] = floatround ( _v_health ) ;
			}

			if ( floatround ( veh_info [ vehicleid - 1 ] [ v_millage ] ) != p_t_info [ playerid ] [ old_millage ] )
			{
				format ( td_string, sizeof ( td_string ), "%d", floatround ( veh_info [ vehicleid - 1 ] [ v_millage ] ) ) ;
				PlayerTextDrawSetString ( playerid, ptd_sp [ playerid ] [ 1 ], td_string ) ;

				p_t_info [ playerid ] [ old_millage ] = floatround ( veh_info [ vehicleid - 1 ] [ v_millage ] ) ;
			}
		}
	}
	else
	{
		kill_speedometr ( playerid ) ;
	}
	return 1 ;
}

public OnPlayerPickUpDynamicPickup ( playerid, pickupid )
{
    #if defined debug_mode
		printf ( "[DEBUG] [OnPlayerPickUpDynamicPickup] playerid:%d, pickupid:%d, pick_type:%d", playerid, pickupid, pick_info [ pickupid ] [ pick_type ] ) ;
	#endif

	if ( GetTickCount ( ) - teleport_tick [ playerid ] < 3000 || p_t_info [ playerid ] [ pickup_id ] == pickupid ) return 1 ;
	if ( p_t_info [ playerid ] [ p_dialog ] != -1 || p_t_info [ playerid ] [ p_logged ] == false ) return 1 ;

	teleport_tick [ playerid ] = GetTickCount ( ) ;
	p_t_info [ playerid ] [ pickup_id ] = pickupid ;

	if ( GetPlayerState ( playerid ) == PLAYER_STATE_DRIVER )
	{
		return true ;
	}

	#if defined m_quest
	    if ( quest_PickUpDynamicPickup ( playerid, pickupid ) ) return 1 ;
	#endif

	#if defined m_garage_auction
	    if ( garage_auction_DynamicPickup ( playerid, pickupid ) ) return 1 ;
	#endif

	#if defined m_pickup_car
	    if ( pc_DynamicPickup ( playerid, pickupid ) ) return 1 ;
	#endif

	#if defined m_familys
	    if ( familys_DynamicPickup ( playerid, pickupid ) ) return 1 ;
	#endif

	#if defined m_incass
	    if ( incass_DynamicPickup ( playerid, pickupid ) ) return 1 ;
	#endif

	#if defined m_garden
	    if ( garden_DynamicPickup ( playerid, pickupid ) ) return 1 ;
	#endif

	#if defined m_delivery
	    if ( delivery_DynamicPickup ( playerid, pickupid ) ) return 1 ;
	#endif

	#if defined m_jobs_module
		if ( jobs_DynamicPickup ( playerid, pickupid ) ) return 1 ;
	#endif

	switch ( pick_info [ pickupid ] [ pick_type ] )
	{
		case pick_type_server:
		{
			if ( pickupid == tree_pick [ tree_id [ playerid ] ] )
			{
				ApplyAnimation ( playerid, "CARRY", "crry_prtial", 4.1, 0, 1, 1, 1, 1 ) ;
				p_t_info [ playerid ] [ p_animation ] = true ;
				SetPlayerAttachedObject ( playerid, 3, 1463, 5, 0.045000, 0.152000, 0.217000, 100.199966, -176.199951, 102.500015, 0.567000, 0.327000, 0.516000 ) ;

				SetPlayerCheckpoint ( playerid, tree_unload_position [ 0 ], tree_unload_position [ 1 ], tree_unload_position [ 2 ], 3.0 ) ;
				is_checkpoint_used { playerid } = 4 ;

				tree_status [ playerid ] = true ;

				SetPlayerArmedWeapon ( playerid, 0 ) ;
				if ( IsValidDynamicPickup ( pickupid ) ) DestroyDynamicPickup ( pickupid ) ;

				give_event_progress ( playerid, THE_SAWMILL, 1 ) ;
				return 1 ;
			}
			else if ( pickupid == election_pickup )
			{
				show_dialog ( playerid, d_vote, DIALOG_STYLE_LIST, "{"#cBHD"}Выборы", "{"#cGRDialog"}- {"#cWH"}Голосование\n{"#cGRDialog"}- {"#cWH"}Список кандидатов\n{"#cGRDialog"}- {"#cWH"}Подать кандидатуру - {"#cGN"}250.000"valute_title_"", "Выбрать", "Закрыть" ) ;
				return 1 ;
			}
		}
		case pick_type_vehicle_gun:
		{
		    new _v_id = pick_info [ pickupid ] [ pick_item ] ;
		    if ( veh_info [ _v_id - 1 ] [ v_loading ] == 1 )
		    {
		        if ( have_box [ playerid ] )
				{
				    new _box = box_submarine [ playerid ] - 1 ;
					RemovePlayerAttachedObject ( playerid, 0 ) ;
					ClearAnimations ( playerid ) ;
					ApplyAnimation ( playerid, "CARRY", "putdwn", 4.0, 0, 1, 1, 0, 0, 1 ) ;

					have_box [ playerid ] = false ;
					box_submarine [ playerid ] = 0 ;
					p_t_info [ playerid ] [ p_animation ] = false ;

					static const _box_id [ ] = { 164, 165, 166, 167, 168, 169, 170, 172 } ;

					new USERS_INVENTORY_STRUCT: inventoryStruct [ _:INV_STRUCTURE_MAX ] ;
					inventoryStruct [ _:INV_ITEM ] = _box_id [ _box ] ;
					inventoryStruct [ _:INV_ITEM_COUNT ] = 1 ;
					inventoryStruct [ _:INV_ITEM_TYPE ] = 0 ;
					inventoryStruct [ _:INV_ITEM_REGION ] = "" ;
					inventoryStruct [ _:INV_ITEM_PLATE ] = "" ;
					inventoryStruct [ _:INV_ITEM_PLATE_TYPE ] = NUMBERPLATE_TYPE_NONE ;
					inventoryStruct [ _:INV_ITEM_GIVE_DATE ] = 0 ;
					inventoryStruct [ _:INV_ITEM_ID ] = 0 ;
					inventoryStruct [ _:INV_ITEM_DATE ] = -1 ;
					new _slot = give_vehicle_item ( _v_id, -1, inventoryStruct ) ;
					if ( _slot == -1 )
					{
						SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}В багажнике транспорта нет свободного места." ) ;
					    return 1 ;
					}
					return 1 ;
				}
				else
				{
					SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет ящика в руках." ) ;
					return 1 ;
				}
		    }
			else if ( veh_info [ _v_id - 1 ] [ v_loading ] == 2 )
			{
			    if ( have_box [ playerid ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы уже взяли ящик." ) ;

				static const _box_id [ ] = { 164, 165, 166, 167, 168, 169, 170, 172 } ;
				new _box = -1, _count = 0 ;
				for ( new i = 0 ; i < sizeof _box_id ; i ++ )
				{
				    _count = GetInventoryFindItem ( _v_id, SUB_INV_VEHICLE, _box_id [ i ] ) ;
					if ( _count > 0 )
					{
						_box = i ;
						clear_vehicle_item ( _v_id, _box_id [ i ], 1 ) ;
					    break ;
					}
				}
				if ( _box == -1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}В багажнике нет ящиков." ) ;

			    if ( IsPlayerAttachedObjectSlotUsed ( playerid, 0 ) ) RemovePlayerAttachedObject ( playerid, 0 ) ;
				SetPlayerAttachedObject ( playerid, 0, 3013, 6,0.0,0.10,-0.2, -110.0,0.0,78.0 ) ;

				have_box [ playerid ] = true ;
	            box_submarine [ playerid ] = _box + 1 ;

	            new scm_string [ 100 ] ;
	            format ( scm_string, sizeof scm_string, "{"#cGInfo"}* {"#cWH"}Вы взяли '{"#cGN"}%s{"#cWH"}'. Отнесите и положите его на склад.", item_name ( _box_id [ _box ] ) ) ;
	            SendClientMessage ( playerid, col_white, scm_string ) ;

				ClearAnimations ( playerid ) ;
				p_t_info [ playerid ] [ p_animation ] = true ;
			    ApplyAnimation ( playerid, "CARRY", "crry_prtial", 4.1, 0, 1, 1, 1, 1 ) ;
			}
		    return 1 ;
		}
		case pick_type_teleportation:
		{
			new ars_id, sec_id ;

			new i = pick_info [ pickupid ] [ pick_item ] - 1 ;
		    if ( i < 0 ) return 1 ;

			if ( area_tp_info [ i ] [ a_area ] [ 0 ] == pickupid )
			{
				ars_id = i ;
				sec_id = 1 ;
			}
			else if ( area_tp_info [ i ] [ a_area ] [ 1 ] == pickupid )
			{
				ars_id = i ;
				sec_id = 0 ;
			}

			#if defined debug_mode
				printf ( "[DEBUG] [OnPlayerPickUpDynamicPickup] area_name: %s, area_id: %d", area_tp_info [ ars_id ] [ a_name ], area_tp_info [ ars_id ] [ a_id ] ) ;
			#endif

			switch ( area_tp_info [ ars_id ] [ a_id ] )
			{
				case 1:
				{
				    new _b_id = GetPVarInt ( playerid, "p_biz_id" ) ;
				    if ( _b_id < 1 ) return bad_exit ( playerid ) ;

					if ( b_info [ _b_id - 1 ] [ b_type ] == bizz_type_shop )
					{
						ShowShopDialog ( playerid, 1 ) ;
						used_shop_product [ playerid ] = true ;
					}
					else if ( b_info [ _b_id - 1 ] [ b_type ] == bizz_type_pharm ) ShowPharmDialog ( playerid, 1 ) ;
					else if ( b_info [ _b_id - 1 ] [ b_type ] == bizz_type_fish ) ShowFishingDialog ( playerid, 1 ) ;
					else if ( b_info [ _b_id - 1 ] [ b_type ] == bizz_type_market_place ) ShowMarketPlaceDialog ( playerid, 1 ) ;
					else if ( b_info [ _b_id - 1 ] [ b_type ] == bizz_type_workshop ) ShowWorkShopDialog ( playerid, 1 ) ;
					return 1 ;
				}

				case 2:
				{
