new bool: ac_rapid = false, ac_rapid_count = 0 ;
CMD:rapidtog ( playerid )
{
	if ( admin_info [ playerid ] [ admin ] < 8 ) return 1 ;

	if ( ac_rapid == false ) ac_rapid = true ;
	else ac_rapid = false ;

	new scm_string [ 100 ] ;
	format ( scm_string, sizeof scm_string, "ac_rapid: %d, ac_rapid_count: %d", ac_rapid, ac_rapid_count ) ;
	SendClientMessage ( playerid, col_white, scm_string ) ;
	return 1 ;
}

public OnPlayerWeaponShot ( playerid, weaponid, hittype, hitid, Float:fX, Float:fY, Float:fZ )
{
	#if defined debug_mode
		printf ( "[DEBUG] [OnPlayerWeaponShot] %d | %d | %d | %f | %f | %f", weaponid, hittype, hitid, Float:fX, Float:fY, Float:fZ ) ;
	#endif

	new Float:z;
 	GetPlayerPos(playerid, z, z, z);

	if(!(-20000.0 <= z <= 20000.0))
		return 0;

    if(weaponid > 46)
	{
		anti_cheat ( playerid, "no_fire_gun", 22 ) ;
		return 0;
	}
    if(!((22 <= weaponid <= 34) || weaponid == 38))
    {
		anti_cheat ( playerid, "no_fire_gun", 20 ) ;
		return 0;
	}

	if ( ( ( 22 <= weaponid <= 34 ) || weaponid == 38 ) )
	{
		new ac_count = WeaponReload [ weaponid - 22 ] ;
		if ( GetPlayerVehicleID ( playerid ) )
		{
			if ( 22 <= weaponid <= 24 || 26 <= weaponid <= 32 ) ac_count = 150 ;
		    else ac_count = 900 ;
	    }

	    if ( GetTickCount ( ) - playerWeaponShotLast [ playerid ] < ac_count )
		{
		    blockingShotDamage [ playerid ] = true ;
		    return 0 ;
		}

		blockingShotDamage [ playerid ] = false ;
		playerWeaponShotLast [ playerid ] = GetTickCount ( ) ;
	}

	if ( ac_rapid == true )
	{
		if(hittype == BULLET_HIT_TYPE_PLAYER || hittype == BULLET_HIT_TYPE_VEHICLE)
		{
			if ((floatabs(fX) >= 10.0) || (floatabs(fY) >= 10.0) || (floatabs(fZ) >= 10.0)|| (floatabs(fX) <= -10.0) || (floatabs(fY) <= -10.0) || (floatabs(fZ) <= -10.0) )
			{
				ac_rapid_count ++ ;
				return 0;
			}
		}
		if(hittype == BULLET_HIT_TYPE_PLAYER || hittype == BULLET_HIT_TYPE_VEHICLE)
		{
			static Float:oldX[MAX_PLAYERS], Float:oldY[MAX_PLAYERS], Float:oldZ[MAX_PLAYERS], t[MAX_PLAYERS];
			if(fX == 0.0 || fY == 0.0 || fZ == 0.0)
			{
				ac_rapid_count ++ ;
				return 0 ;
			}
			if(fX == oldX[playerid] && fY == oldY[playerid] && fZ == oldZ[playerid])
			{
				ac_rapid_count ++ ;
				return 0;
			}
			oldX[playerid] = fX; oldY[playerid] = fY; oldZ[playerid] = fZ;
			if ( weaponid != 0 )
			{
				if(GetTickCount() - t[playerid] < HitTimeTable[weaponid + TABLE_OFFSET] - 75)
				{
					t[playerid] = GetTickCount();
					ac_rapid_count ++ ;
					return 0;
				}
				t[playerid] = GetTickCount();
			}
		}
	}

	new Float: pos_x, Float:pos_y, Float:pos_z ;
	GetPlayerPos ( playerid, pos_x, pos_y, pos_z ) ;
    new Float:pos_px, Float:pos_py, Float:pos_pz, Float:pos_sx, Float:pos_sy, Float:pos_sz;
	GetPlayerLastShotVectors(playerid, pos_px, pos_py, pos_pz, pos_sx, pos_sy, pos_sz);

	if ( pos_z == pos_pz ) anti_cheat ( playerid, "silent aim", 102 ) ;
	if ( hittype == BULLET_HIT_TYPE_PLAYER )
	{
		new Float:HitPosX, Float:HitPosY, Float:HitPosZ, Float:Temp;
		GetPlayerLastShotVectors(playerid, Temp, Temp, Temp, HitPosX, HitPosY, HitPosZ);
		if(!IsPlayerInRangeOfPoint(playerid, 3.0, HitPosX, HitPosY, HitPosZ) && !IsPlayerFacingCoords(playerid, HitPosX, HitPosY, MAX_DIST))
		{
			if ( ++ aim_warnings [ playerid ] > 2 )
			{
				anti_cheat ( playerid, "silent aim", 0 ) ;
			}
		}
		else aim_warnings [ playerid ] = 0;
	}
	else aim_warnings [ playerid ] = 0 ;

	p_t_info [ playerid ] [ p_shot_time ] = GetTickCount ( ) ;

	new slot = get_weapon_slot ( weaponid ) ;
	if ( p_t_info [ playerid ] [ p_gun_slot ] [ slot ] == 0 && p_t_info [ playerid ] [ p_tp_immune_time ] < 1 )return anti_cheat ( playerid, "DGun", 11 ), false ;

    #if defined __anti_godmode
	antigm_OnPlayerWeaponShot(playerid, weaponid, hittype, hitid, fX, fY, fZ);
	#endif

	p_t_info [ playerid ] [ p_gun_shots ] ++ ;

    if ( weaponid == 23 && ( cop_player ( playerid ) || fbi_player ( playerid ) || mayor_player ( playerid ) ) )
    {
        new _tazer_time = gettime ( ) + 60 ;

        #if defined m_perks
		new _perk_stats = get_perk_info ( playerid, PERK_TAZER ) ;
		if ( _perk_stats > 0 ) _tazer_time = gettime ( ) + _perk_stats ;
		#endif

		if ( tazer_time [ playerid ] > gettime ( ) )
		{
			new scm_string [ 104 + 4 ] ;
			format ( scm_string, sizeof scm_string, "{"#cRInfo"}* {"#cGRInfo"}Электрошокер перезаряжается! Время перезарядки составляет {"#cRInfo"}%d сек.", _tazer_time - gettime ( ) ) ;
			SendClientMessage ( playerid, col_gray, scm_string ) ;
		}
		else
		{
		    tazer_time [ playerid ] = _tazer_time ;

			if ( hittype == BULLET_HIT_TYPE_PLAYER && IsPlayerConnected ( hitid ) )
			{
				if ( target_cuff [ hitid ] == INVALID_PLAYER_ID && is_tazered { hitid } == 0 && GetPlayerState ( hitid ) == PLAYER_STATE_ONFOOT )
				{
				    if ( ! reload_police_warning ( playerid ) )
				    {
						ApplyAnimation ( hitid, "CRACK", "crckdeth2", 4.0, 1, 0, 0, 0, 0 ) ;
						SetTimerEx ( "untazer_timer", 15000, false, "i", hitid ) ;
					 	TogglePlayerControllable ( hitid, 0 ) ;
					   	is_tazered { hitid } = 1 ;

						new _text_string [ 128 ] ;
						format ( _text_string, sizeof ( _text_string ), "{"#cBInfo"}* {"#cWH"}Вы оглушили гражданина {"#cBL"}%s{"#cWH"} на 15 секунд.", p_info [ hitid ] [ name ] ) ;
						SendClientMessage ( playerid, col_white, _text_string ) ;

						format ( _text_string, sizeof ( _text_string ), "{"#cBInfo"}* {"#cWH"}Вы были оглушены {"#cBL"}%s{"#cWH"} на 15 секунд.", p_info [ playerid ] [ name ] ) ;
						SendClientMessage ( hitid, col_white, _text_string ) ;
					}
					else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы пытаетесь применить NonRP санкцию! Она заблокирована." ) ;
			  	}
			}
			else if ( hittype == BULLET_HIT_TYPE_VEHICLE )
			{
		 		SetTimerEx ( "un_ems_timer", 25000, false, "i", hitid ) ;
				veh_info [ hitid - 1 ] [ v_ems ] = true ;

				if ( veh_info [ hitid - 1 ] [ v_driver ] != INVALID_PLAYER_ID )
				{
					SendClientMessage ( veh_info [ hitid - 1 ] [ v_driver ], col_white, !"{"#cBInfo"}* {"#cWH"}Ваш автомобиль был поражён системой ЭМИ." ) ;
				}
			}
		}
	}

	if ( p_t_info [ playerid ] [ p_gun_ammo ] [ slot ] <= -7 && GetPlayerWeapon ( playerid ) != 0 )return anti_cheat ( playerid, "бесконечные патроны (OPWS)", 15 ), false ;

	p_t_info [ playerid ] [ p_gun_ammo ] [ slot ] -- ;

	new _skill_id = -1 ;
	if ( TeamPaint [ playerid ] == 0 )
	{
		switch ( weaponid )
		{
			case 23: _skill_id = 0 ;
			case 24: _skill_id = 1 ;
			case 25: _skill_id = 2 ;
			case 29: _skill_id = 3 ;
			case 30: _skill_id = 4 ;
			case 31: _skill_id = 5 ;
			case 33: _skill_id = 6 ;
		}
	}

	if ( _skill_id != -1 && p_info [ playerid ] [ gun_skills ] [ _skill_id ] < 100 )
	{
		gun_skill_up { playerid } += 1 * server_bonus [ 5 ] ;
		if ( gun_skill_up { playerid } >= 12 )
		{
			gun_skill_up { playerid } = 0 ;
			p_info [ playerid ] [ gun_skills ] [ _skill_id ] ++ ;

			new _query [ 96 ] ;
			if ( _skill_id == 0 ) format ( _query, 72, "~n~~n~~n~~n~~g~+1 ~w~SKILLS SD PISTOL ~n~ALL: ~g~ %i/100", p_info [ playerid ] [ gun_skills ] [ _skill_id ] ) ;
			else if ( _skill_id == 1 ) format ( _query, 72, "~n~~n~~n~~n~~g~+1 ~w~SKILLS DEAGLE ~n~ALL: ~g~ %i/100", p_info [ playerid ] [ gun_skills ] [ _skill_id ] ) ;
			else if ( _skill_id == 2 ) format ( _query, 72, "~n~~n~~n~~n~~g~+1 ~w~SKILLS SHOTGUN ~n~ALL: ~g~ %i/100", p_info [ playerid ] [ gun_skills ] [ _skill_id ] ) ;
			else if ( _skill_id == 3 ) format ( _query, 72, "~n~~n~~n~~n~~g~+1 ~w~SKILLS MP5 ~n~ALL: ~g~ %i/100", p_info [ playerid ] [ gun_skills ] [ _skill_id ] ) ;
			else if ( _skill_id == 4 ) format ( _query, 72, "~n~~n~~n~~n~~g~+1 ~w~SKILLS AK47 ~n~ALL: ~g~ %i/100", p_info [ playerid ] [ gun_skills ] [ _skill_id ] ) ;
			else if ( _skill_id == 5 ) format ( _query, 72, "~n~~n~~n~~n~~g~+1 ~w~SKILLS M4 ~n~ALL: ~g~ %i/100", p_info [ playerid ] [ gun_skills ] [ _skill_id ] ) ;
			else if ( _skill_id == 6 ) format ( _query, 72, "~n~~n~~n~~n~~g~+1 ~w~SKILLS RIFLE ~n~ALL: ~g~ %i/100", p_info [ playerid ] [ gun_skills ] [ _skill_id ] ) ;
			GameTextForPlayer ( playerid, _query, 2000, 5 ) ;

			format ( _query, sizeof ( _query ), "UPDATE `users` SET `u_skills`='%d|%d|%d|%d|%d|%d|%d' WHERE `u_id` = '%d' LIMIT 1",
			p_info [ playerid ] [ gun_skills ] [ 0 ], p_info [ playerid ] [ gun_skills ] [ 1 ], p_info [ playerid ] [ gun_skills ] [ 2 ],
			p_info [ playerid ] [ gun_skills ] [ 3 ], p_info [ playerid ] [ gun_skills ] [ 4 ], p_info [ playerid ] [ gun_skills ] [ 5 ],
			p_info [ playerid ] [ gun_skills ] [ 6 ], p_info [ playerid ] [ id ] ) ;
			mysql_tquery ( sql_connection, _query ) ;
			SetPlayerSkills ( playerid ) ;
		}
	}
	return 1 ;
}

public OnUnoccupiedVehicleUpdate ( vehicleid, playerid, passenger_seat, Float:new_x, Float:new_y, Float:new_z, Float:vel_x, Float:vel_y, Float:vel_z )
{
	#if defined debug_mode
		printf ( "[DEBUG] [OnUnoccupiedVehicleUpdate] vehicleid:%d | playerid:%d | passenger_seat:%d", vehicleid, playerid, passenger_seat ) ;
