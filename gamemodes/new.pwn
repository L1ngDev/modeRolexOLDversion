			if ( veh_info [ GetPlayerVehicleID ( playerid ) - 1 ] [ v_locked ] ) PlayerTextDrawColor(playerid, ptd_sp [ playerid ] [ 4 ], -1523963137);
			else PlayerTextDrawColor(playerid, ptd_sp [ playerid ] [ 4 ], 8388863);

	        new td_string [ 48 ], vehicleid = GetPlayerVehicleID ( playerid ) ;
