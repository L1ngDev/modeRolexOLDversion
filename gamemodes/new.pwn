		 	else if ( _qs == k && _qstatus == 1 ) format ( line_string, sizeof ( line_string ), "{"#cBL"}%d. {"#cWH"}%s\t%s\n", _quest_id, quest_info_3 [ k ] [ q_name ], status_names [ 1 ] ) ;
		 	else if ( _qs == k && _qstatus == 2 ) format ( line_string, sizeof ( line_string ), "{"#cBL"}%d. {"#cWH"}%s\t%s\n", _quest_id, quest_info_3 [ k ] [ q_name ], status_names [ 2 ] ) ;
