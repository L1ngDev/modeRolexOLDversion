				SetVehicleToRespawn ( veh_id, 8 ) ;
				RemovePlayerFromVehicle ( playerid ) ;
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы уже арендуете транспорт, сначала откажитесь от старого {"#cRD"}/stoprent" ) ;
				return 1 ;
			}
			if ( p_info [ playerid ] [ money ] < 250 )
			{
				SetVehicleToRespawn ( veh_id, 9 ) ;
				RemovePlayerFromVehicle ( playerid ) ;
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Аренда данного транспорта стоит {"#cRD"}250"valute_title_"" ) ;
				return 1 ;
			}

			if ( veh_info [ veh_id - 1 ] [ v_type ] == vehicle_type_rentcar && veh_info [ veh_id - 1 ] [ v_owner ] == job_trucker )
			{
				new veh_model = GetVehicleModel ( veh_id ) ;
				if ( veh_model == 514 && p_info [ playerid ] [ truck_skill ] < 200000 )
				{
					SetVehicleToRespawn ( veh_id, 10 ) ;
					RemovePlayerFromVehicle ( playerid ) ;
					SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас недостаточно опыта для управления данным грузовиком." ) ;
					return 1 ;
				}
				else if ( veh_model == 515 && p_info [ playerid ] [ truck_skill ] < 1500000 )
				{
					SetVehicleToRespawn ( veh_id, 11 ) ;
					RemovePlayerFromVehicle ( playerid ) ;
					SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас недостаточно опыта для управления данным грузовиком." ) ;
					return 1 ;
				}
			}

			if ( veh_info [ veh_id - 1 ] [ v_renter ] != INVALID_PLAYER_ID )
			{
				SetVehicleToRespawn ( veh_id, 100 ) ;
				RemovePlayerFromVehicle ( playerid ) ;
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данный транспорт уже кем-то арендован." ) ;
				return 1 ;
			}

			if ( veh_info [ veh_id - 1 ] [ v_rent_price ] > 0 )
			{
				new _rent_price = veh_info [ veh_id - 1 ] [ v_rent_price ] ;
			    if ( p_info [ playerid ] [ money ] < _rent_price )
				{
					SetVehicleToRespawn ( veh_id, 101 ) ;
					RemovePlayerFromVehicle ( playerid ) ;

					new scm_string [ 84 + 9 ] ;
					format ( scm_string, sizeof scm_string, "{"#cRInfo"}* {"#cGRInfo"}Аренда данного транспорта стоит {"#cRD"}%d"valute_title"{"#cGRInfo"}.", _rent_price ) ;
					SendClientMessage ( playerid, col_gray, scm_string ) ;
					return 1 ;
			    }

			    if ( veh_info [ veh_id - 1 ] [ v_model ] == incass_model_id )
				{
				    if ( p_info [ playerid ] [ incass_invite ] == INVALID_PLAYER_ID )
				    {
						SetVehicleToRespawn ( veh_id, 102 ) ;
				        RemovePlayerFromVehicle ( playerid ) ;
				        SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет напарника!" ) ;
				        return 1 ;
				    }
				    new _targetid = p_info [ playerid ] [ incass_invite ] ;
					player_rentcar [ _targetid ] = veh_id ;
					SendClientMessage ( _targetid, col_white, !"{"#cGInfo"}* {"#cWH"}Ваш напарник арендовал транспорт! Садитесь в транспорт." ) ;
				}

				give_bmoney ( veh_info [ veh_id - 1 ] [ v_owner ], _rent_price, 0 ) ;

				create_speedometr ( playerid ) ;

			    give_money ( playerid, -_rent_price ) ;
			    insert_money_log ( playerid, INVALID_PLAYER_ID, -_rent_price, "аренда т/с (Бизнес)" ) ;

				player_rentcar [ playerid ] = veh_id ;
				veh_info [ veh_id - 1 ] [ v_renter ] = playerid ;

				SetPlayerRaceCheckpoint ( playerid, 1, veh_info [ veh_id - 1 ] [ v_pos ] [ 0 ], veh_info [ veh_id - 1 ] [ v_pos ] [ 1 ], veh_info [ veh_id - 1 ] [ v_pos ] [ 2 ], 0.0, 0.0, 0.0, 2.0 ) ;
				SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}[GPS] - Метка установлена." ) ;
				is_gps_used { playerid } = 1 ;

				SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы успешно арендовали транспорт. Используйте {"#cGN"}/rlock (/rlk){"#cWH"}, чтобы закрыть его." ) ;
               	SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вам доступен багажник транспорта. Для отмены аренды транспорта используйте {"#cGN"}/stoprent{"#cWH"}." ) ;
				return 1 ;
			}
			else
			{
				give_money ( playerid, -250 ) ;
				insert_money_log ( playerid, INVALID_PLAYER_ID, -250, "аренда т/с" ) ;

				veh_info [ veh_id - 1 ] [ v_renter ] = playerid ;
				player_rentcar [ playerid ] = veh_id ;
				SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы успешно арендовали транспорт. Используйте {"#cGN"}/rlock (/rlk){"#cWH"}, чтобы закрыть его." ) ;
			}

			switch ( veh_info [ veh_id - 1 ] [ v_owner ] )
			{
				case job_bus: callcmd::route ( playerid ) ;
				case job_taxi: SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Используйте {"#cGN"}/taxi{"#cWH"} для установки таксы." ) ;
				case job_mechanic: SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Используйте {"#cGN"}/mech{"#cWH"} для начала работы." ) ;
				case job_trucker: SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Используйте {"#cGN"}/tpanel{"#cWH"} для начала работы." ) ;
				case job_delivery: SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Используйте {"#cGN"}/delivery{"#cWH"} для начала доставки." ) ;
				case job_fuel_delivery: SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Используйте {"#cGN"}/delivery{"#cWH"} для начала доставки." ) ;
			}
			create_speedometr ( playerid ) ;
		}
		case d_bus_admin:
		{
		    if ( ! response ) return 1 ;

		    if ( ! strcmp("Создать маршрут", inputtext ) )
			{
				mysql_tquery ( sql_connection, "INSERT INTO `bus_first_settings` (`b_name`,`b_price`) VALUES ('none','1000')" ) ;

				bus_first_count ++ ;

				format ( bus_info [ bus_first_count ] [ bus_name ], 32, "none" ) ;
				bus_info [ bus_first_count ] [ bus_price ] = 1000 ;
			    return 1 ;
			}

		    set_player_use_listitem ( playerid, listitem ) ;
		    show_admin_route ( playerid ) ;
		}
		case d_bus_admin_1:
		{
		    if ( ! response ) return callcmd::createroute ( playerid ) ;
		    switch ( listitem )
		    {
		        case 0:
		        {
		            new line_string [ 156 ], _route_id = get_player_use_listitem ( playerid ) ;
		            format ( line_string, sizeof line_string, "{"#cBL"}* {"#cGRDialog"}Название рейса: {"#cWH"}%s\n{"#cBL"}* {"#cGRDialog"}Оплата за рейс: {"#cWH"}%d"valute_title_"\n\n{"#cGRDialog"}* Введите заработную плату рейса:", bus_info [ _route_id ] [ bus_name ], bus_info [ _route_id ] [ bus_price ] ) ;
		            show_dialog(playerid, d_bus_admin_price, DIALOG_STYLE_INPUT, "{"#cBHD"}Цена за рейс", line_string, "Принять", "Отмена" ) ;
		        }
		        case 1:
		        {
		            new line_string [ 156 ], _route_id = get_player_use_listitem ( playerid ) ;
		            format ( line_string, sizeof line_string, "{"#cBL"}* {"#cGRDialog"}Название рейса: {"#cWH"}%s\n{"#cBL"}* {"#cGRDialog"}Оплата за рейс: {"#cWH"}%d"valute_title_"\n\n{"#cGRDialog"}* Введите новое название рейса:", bus_info [ _route_id ] [ bus_name ], bus_info [ _route_id ] [ bus_price ] ) ;
		            show_dialog(playerid, d_bus_admin_name, DIALOG_STYLE_INPUT, "{"#cBHD"}Название рейса", line_string, "Принять", "Отмена" ) ;
		        }
		        case 2:
		        {
					global_string [ 0 ] = EOS ;
					new _route_id = get_player_use_listitem ( playerid ), _count_route = 0 ;
					page_count [ playerid ] = 1 ;

					new line_string [ 27 + 2 + 20 ], row_count = 0 ;
					for ( new i = 0 ; i < bus_count ; i ++ )
					{
						if ( bus_info [ i ] [ bus_step ] != _route_id ) continue ;

						_count_route ++ ;

						if ( row_count > 20 ) continue ;

						set_player_listitem_values ( playerid, row_count, i ) ;

						format ( line_string, sizeof line_string, "{"#cBL"}%d.{"#cWH"} %s\n", _count_route, ( bus_info [ i ] [ bus_stop ] == 1 ) ? ( "{"#cLY"}Остановка" ) : ( "Чекпоинт" ) ) ;
						strcat ( global_string, line_string ) ;

						row_count ++ ;
					}

					page_rows [ playerid ] = _count_route ;
					if ( page_count [ playerid ] > 1 )
					{
						strcat ( global_string, "{"#cBL"}Предыдущая страница\t \n" ) ;
						set_player_use_page ( playerid, row_count, 0 ) ;
						row_count ++ ;
					}
					if ( ofm_formula ( page_count [ playerid ] ) < page_rows [ playerid ] )
					{
						strcat ( global_string, "{"#cBL"}Следующая страница\t \n" ) ;
						set_player_use_page ( playerid, row_count, 1 ) ;
					}

					if ( _route_id == bus_first_count )
					{
						strcat ( global_string, "{"#cRD"}Удалить чекпоинт\n" ) ;
						strcat ( global_string, "{"#cGRDialog"}Добавить чекпоинт" ) ;
					}
					show_dialog(playerid, d_bus_admin_route, DIALOG_STYLE_LIST, "{"#cBHD"}Движение", global_string, "Выбрать", "Отмена" ) ;
				}
		    }
		}
		case d_bus_admin_price:
		{
		    if ( ! response ) return show_admin_route ( playerid ) ;

		    new price = strval ( inputtext ) ;
			if ( price < 1 || price > 100000 )
			{
				new line_string [ 156 ], _route_id = get_player_use_listitem ( playerid ) ;
		        format ( line_string, sizeof line_string, "{"#cBL"}* {"#cGRDialog"}Название рейса: {"#cWH"}%s\n{"#cBL"}* {"#cGRDialog"}Оплата за рейс: {"#cWH"}%d"valute_title_"\n\n{"#cGRDialog"}* Введите заработную плату рейса:", bus_info [ _route_id ] [ bus_name ], bus_info [ _route_id ] [ bus_price ] ) ;
		        show_dialog(playerid, d_bus_admin_price, DIALOG_STYLE_INPUT, "{"#cBHD"}Цена за рейс", line_string, "Принять", "Отмена" ) ;
