				insert_debtor_message ( "Банк", scm_string, b_info [ _b_id - 1 ] [ b_owner_inc ] ) ;
			}

			b_info [ _b_id - 1 ] [ b_money ] += plprice ;

			format ( scm_string, sizeof scm_string, "UPDATE `businesses` SET `b_money` = '%d' WHERE `b_id` = '%d' LIMIT 1", b_info [ _b_id - 1 ] [ b_money ], b_info [ _b_id - 1 ] [ b_id ] ) ;
			mysql_tquery ( sql_connection, scm_string ) ;

			format ( scm_string, 156, "UPDATE `deposit_boxes` SET `db_money` = '%d', `db_credit` = '%d' WHERE `db_id` = '%d' LIMIT 1", bank_info [ playerid ] [ bi_money ] [ deposit_id ], bank_info [ playerid ] [ bi_credit ] [ deposit_id ], bank_info [ playerid ] [ bi_id ] [ deposit_id ] ) ;
			mysql_tquery ( sql_connection, scm_string, "", "" ) ;

			if ( ! bank_info [ playerid ] [ bi_credit ] [ deposit_id ] )
			{
			    bank_info [ playerid ] [ bi_credit ] [ deposit_id ] =
			    bank_info [ playerid ] [ bi_pledge ] [ deposit_id ] =
			    bank_info [ playerid ] [ bi_pledge_type ] [ deposit_id ] =
			    bank_info [ playerid ] [ bi_credit_day ] [ deposit_id ] =
			    bank_info [ playerid ] [ bi_credit_card ] [ deposit_id ] = 0 ;

			    bank_info [ playerid ] [ bi_creditor ] [ deposit_id ] = -1 ;

			    format ( scm_string, sizeof scm_string, "UPDATE `deposit_boxes` SET `db_credit_day` = '0', `db_creditor` = '-1', `db_pledge` = '0', `db_pledge_type` = '0', `db_credit` = '0', `db_credit_card` = '0' WHERE `db_id` = '%d' LIMIT 1", bank_info [ playerid ] [ bi_id ] [ deposit_id ] ) ;
				mysql_tquery ( sql_connection, scm_string ) ;

				clear_for_tax ( playerid, 2 ) ;
			}

			format ( scm_string, 144, "{"#cGInfo"}* {"#cWH"}Вы внесли {"#cGN"}%d"valute_title_"{"#cWH"} в счёт кредита. Осталось погасить ещё {"#cGN"}%d"valute_title"{"#cWH"}.",
			plprice, bank_info [ playerid ] [ bi_credit ] [ deposit_id ] ) ;
			SendClientMessage ( playerid, col_white, scm_string ) ;

			show_debtors_bank ( playerid ) ;
			return 1 ;
