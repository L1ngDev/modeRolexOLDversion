	    	if ( --p_info[playerid ] [ p_healingTime ] == 1 )
		    {
	     		SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Действие лекарств закончилось." ) ;

				p_info [ playerid ] [ p_healingTime ] = 0 ;
				p_info [ playerid ] [ p_healing ] ++ ;

				new sql_string [ 200 ] ;
	   			if ( p_info [ playerid ] [ p_healing ] == p_info [ playerid ] [ p_disease ] [ 1 ] + 2 )
			    {
		      		if ( p_info [ playerid ] [ p_diagnosis ] == 2 )
				    {
	        			SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Вам был поставлен {"#cRD"}неверный диагноз{"#cGRInfo"} - лечение не помогло. Пройдите обследоваие снова." ) ;

	                    p_info [ playerid ] [ p_diagnosis ] =
					   	p_info [ playerid ] [ p_wrong_virus ] [ 0 ] =
	              		p_info [ playerid ] [ p_healing ] = 0 ;

						format ( sql_string, 100, "UPDATE `users` SET `u_diagnosis` = '0', `u_healing` = '0' WHERE `u_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
						mysql_tquery ( sql_connection, sql_string ) ;
				    }
	       			else
	          		{
	      				p_info [ playerid ] [ p_disease ] [ 0 ] =
	          			p_info [ playerid ] [ p_disease ] [ 1 ] =
	             		p_info [ playerid ] [ p_wrong_virus ] [ 0 ] =
	               		p_info [ playerid ] [ p_diagnosis ] =
	                	p_info [ playerid ] [ p_healing ] =
		                p_info [ playerid ] [ p_healingTime ] =
		                p_info [ playerid ] [ p_vitaminsTime ] = 0 ;

		                SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Вы полностью вылечились!" ) ;
						format ( sql_string, sizeof sql_string, "UPDATE `users` SET `u_disease` = '0', `u_disease_stage` = '0', `u_bad_disease` = '0', `u_healing_time` = '0', `u_diagnosis` = '0', `u_healing` = '0' WHERE `u_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
						mysql_tquery ( sql_connection, sql_string ) ;
			       	}
			    }
			}
		}

		#if defined m_familys
		    familys_player_timer ( playerid, 30 ) ;
		#endif

		#if defined m_prison
		    prison_player_timer ( playerid ) ;
		#endif

		#if defined m_donate
		    donate_player_timer ( playerid, 60 ) ;
		#endif

		#if defined m_jobs_module
		    trucker_player_timer ( playerid, 60 ) ;
		#endif

		p_info [ playerid ] [ hour_played ] += 60 ;
	}

	#if defined m_jobs_module
	    trucker_player_timer ( playerid, 1 ) ;
		taxi_player_timer ( playerid ) ;
	#endif

	#if defined m_quest
	    quest_player_timer ( playerid ) ;
	#endif
	return 1 ;
}

stock greenzone_player_timer ( playerid )
{
	new _a_id = -1 ;
	for ( new j = 0 ; j < MAX_DM_ZONE ; j ++ )
	{
		if ( ! IsPlayerInQuad ( playerid, anti_dm_pos [ j ] [ 0 ], anti_dm_pos [ j ] [ 1 ], anti_dm_pos [ j ] [ 2 ], anti_dm_pos [ j ] [ 3 ] ) ) continue ;

        _a_id = j ;
        break ;
	}

	if ( _a_id == -1 ) return 1 ;
	new _a_type = area_info [ _a_id ] [ a_type ] ;
