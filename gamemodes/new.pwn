				    if ( sp_timer [ playerid ] > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вашей помощи уже ожидает игрок, которому Вы ранее сказали о слежке." ) ;
					SendClientMessage ( playerid, col_orange, !"* Вы ответили на оффлайн репорт тем, что придёте и поможете. Вы молодец!" ) ;
					SendClientMessage ( playerid, col_orange, !"* У Вас есть 3 минуты, чтоб придти и помочь игроку. Используйте /goto или /sp." ) ;
					sp_timer [ playerid ] = 180 ;
				}

				new scm_string [ 144 ] ;
			    format ( scm_string, sizeof ( scm_string  ), "* [ОТВЕТ]: %s[%i] (жалоба №%i):{"#cWH"} %s", p_info [ playerid ] [ name ], playerid, _r_id, inputtext ) ;
				foreach(new i: admin_players) SendClientMessage ( i, 0xcec710FF, scm_string ) ;

				format ( scm_string,sizeof(scm_string), "UPDATE `users_admins` SET `u_a_reports` = `u_a_reports`+1 WHERE `u_a_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
				mysql_tquery ( sql_connection, scm_string ) ;

				admin_info [ playerid ] [ report ] ++ ;

			    if ( offline_report ) update_report ( playerid, inputtext, _r_id, 1 ) ;
			    callcmd::areport ( playerid ) ;
			}
			return 1 ;
	    }
	    case d_report_player_select:
		{
		    if ( ! response )
		    {
		        if ( GetPVarInt ( playerid, "select_status" ) != 0 )
		        {
			        new sql_string [ 72 + 9 ] ;
					format ( sql_string, sizeof sql_string, "UPDATE `logs_report` SET `r_status` = '2' WHERE `r_id` = '%d' LIMIT 1", GetPVarInt ( playerid, "select_id" ) ) ;
					mysql_tquery ( sql_connection, sql_string, "", "" ) ;
				}
				if ( report_id [ playerid ] == GetPVarInt ( playerid, "select_id" ) ) report_id [ playerid ] = -1 ;

		        DeletePVar ( playerid, "select_status" ) ;
		        DeletePVar ( playerid, "select_id" ) ;
		        callcmd::checkreport ( playerid ) ;
		        return 1 ;
		    }

			static const _str [ ] = "DELETE FROM `logs_report` WHERE `r_id` = '%d' LIMIT 1" ;
		    new sql_string [ sizeof _str + 11 ] ;
			format ( sql_string, sizeof sql_string, _str, GetPVarInt ( playerid, "select_id" ) ) ;
			mysql_tquery ( sql_connection, sql_string, "", "" ) ;

			DeletePVar ( playerid, "select_status" ) ;
			DeletePVar ( playerid, "select_id" ) ;

			callcmd::checkreport ( playerid ) ;
			return 1 ;
		}
	    case d_report_player:
		{
			if ( ! response )
			{
			    for ( new i = 0 ; i < 10 ; i ++ )
				{
					new pvar_string [ 8 ] ;
					format ( pvar_string, sizeof ( pvar_string ), "vrl_%d", i ) ;
					DeletePVar ( playerid, pvar_string ) ;

					format ( pvar_string, sizeof ( pvar_string ), "vr_%d", i ) ;
					DeletePVar ( playerid, pvar_string ) ;
				}
				return 1 ;
			}

			new pvar_string [ 16 ] ;
			format ( pvar_string, 16, "vrl_%d", listitem ) ;
			new select_id = GetPVarInt ( playerid, pvar_string ) ;
			SetPVarInt ( playerid, "select_id", select_id ) ;

			format ( pvar_string, 16, "vr_%d", listitem ) ;
			new select_status = GetPVarInt ( playerid, pvar_string ) ;
			SetPVarInt ( playerid, "select_status", select_status ) ;

			for ( new i = 0 ; i < 10 ; i ++ )
			{
				format ( pvar_string, sizeof ( pvar_string ), "vrl_%d", i ) ;
				DeletePVar ( playerid, pvar_string ) ;

				format ( pvar_string, sizeof ( pvar_string ), "vr_%d", i ) ;
				DeletePVar ( playerid, pvar_string ) ;
			}

			new sql_string [ 186 ] ;
			format ( sql_string, sizeof sql_string, "SELECT `r_id`, `r_status`, `u_name`, `date`, `text`, `a_name`, `a_date`, `a_text` FROM `logs_report` WHERE `r_id` = '%d' LIMIT 1", select_id ) ;
			mysql_tquery ( sql_connection, sql_string, "callback_report_check_info", "i", playerid ) ;
			return 1 ;
		}
	    case d_player_click:
	    {
	        if ( ! response ) return DeletePVar ( playerid, "target_id" ) ;

	        new _pl_id = GetPVarInt ( playerid, "target_id" ) ;

			switch ( listitem )
			{
			    case 0: show_stats ( _pl_id, playerid ), DeletePVar ( playerid, "target_id" ) ;
			    case 1: show_pass ( _pl_id, playerid ), DeletePVar ( playerid, "target_id" ) ;
			    case 2:
			    {
			        new clf_string [ 6 ] ;
				    format ( clf_string, sizeof clf_string, "%d", _pl_id ) ;
					callcmd::sp ( playerid, clf_string ) ;

					DeletePVar ( playerid, "target_id" ) ;
			    }
			    case 3:
			    {
			        new clf_string [ 6 ] ;
				    format ( clf_string, sizeof clf_string, "%d", _pl_id ) ;
					callcmd::goto ( playerid, clf_string ) ;

					DeletePVar ( playerid, "target_id" ) ;
			    }
			    case 4:
			    {
			        new clf_string [ 6 ] ;
				    format ( clf_string, sizeof clf_string, "%d", _pl_id ) ;
					callcmd::gethere ( playerid, clf_string ) ;

					DeletePVar ( playerid, "target_id" ) ;
			    }
			    case 5: show_dialog ( playerid, d_player_click_skin, DIALOG_STYLE_INPUT, "{"#cBHD"}Выберите действие", "{"#cWH"}Укажите ID скина, который хотите выдать:", "Выбрать", "Закрыть" ) ;
			    case 6:
			    {
			        new veh_id = player_vehicle [ _pl_id ] ;
					if ( veh_id == INVALID_VEHICLE_ID )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок должен находиться в транспорте." ), DeletePVar ( playerid, "target_id" ) ;
					RepairVehicle ( veh_id ) ;
					veh_info [ veh_id - 1 ] [ v_fuel ] = 100.0 ;
					DeletePVar ( playerid, "target_id" ) ;
			    }
				case 7: show_dialog ( playerid, d_player_click_car, DIALOG_STYLE_INPUT, "{"#cBHD"}Выберите действие", "{"#cWH"}Укажите ID транспорта, который хотите выдать:", "Выбрать", "Закрыть" ) ;
				case 8:
				{
				    new sql_string [ 65 + 9 + 4 ] ;
					format ( sql_string, sizeof sql_string, "SELECT * FROM `users_vehicles` WHERE `v_owner` = '%d' LIMIT %d", p_info [ _pl_id ] [ id ], p_info [ _pl_id ] [ max_veh ] ) ;
					mysql_tquery ( sql_connection, sql_string, "load_fine_admin_vehicles", "ii", playerid, _pl_id ) ;

					DeletePVar ( playerid, "target_id" ) ;
				}
				case 9: show_dialog ( playerid, d_player_click_stskin, DIALOG_STYLE_INPUT, "{"#cBHD"}Выберите действие", "{"#cWH"}Укажите ID скина, который хотите выдать:", "Выбрать", "Закрыть" ) ;
				case 10:
				{
				    new line_string [ 80 ] ;
					global_string [ 0 ] = EOS ;
					for ( new j = 0 ; j < 5 ; j ++ )
					{
						if ( p_info [ _pl_id ] [ temp_skin ] [ j ] == 0 )
						{
							strcat ( global_string, "{"#cGRDialog"}- Пусто\n" ) ;
						}
						else
						{
							format ( line_string, sizeof line_string, "{ffffff}Одежда '%s' (%d)\n", get_skin_name ( p_info [ playerid ] [ temp_skin ] [ j ] ), p_info [ playerid ] [ temp_skin ] [ j ] ) ;
							strcat ( global_string, line_string ) ;
						}
					}
					strcat ( global_string, "Одежда организации" ) ;
					show_dialog ( playerid, d_none, DIALOG_STYLE_LIST, "{"#cBHD"}Гардероб", global_string, "Закрыть", "" ) ;

					DeletePVar ( playerid, "target_id" ) ;
				}
				case 11:
			    {
			        new clf_string [ 6 ] ;
				    format ( clf_string, sizeof clf_string, "%d", _pl_id ) ;
					callcmd::satiety ( playerid, clf_string ) ;

					DeletePVar ( playerid, "target_id" ) ;
			    }
			    case 12:
			    {
			        if ( p_info [ _pl_id ] [ p_warn ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока имеются предупреждения." ) ;
					if ( p_info [ _pl_id ] [ member ] > 0 || p_info [ _pl_id ] [ leader ] > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок состоит в организации." ) ;

					global_string [ 0 ] = EOS ;
					new line_string [ 100 ] ;
					for ( new j = 0; j < fraction_count ; j ++ )
					{
						format ( line_string, sizeof line_string, "{ffffff}ID:%d - {%s}%s\n", j + 1, f_info [ j ] [ f_chat_color ], f_info [ j ] [ f_name ] ) ;
						strcat ( global_string, line_string ) ;
					}
					show_dialog ( playerid, d_makeleader, DIALOG_STYLE_LIST, "{"#cBHD"}Список организаций", global_string, "Выбрать", "Закрыть" ) ;

					SetPVarInt ( playerid, "player_id", _pl_id ) ;

					DeletePVar ( playerid, "target_id" ) ;
			    }
				case 13:
				{
				    new sql_string [ 356 ] ;
					mysql_format ( sql_connection, sql_string, 356, "SELECT `u_id`,`u_name`,`u_last_date`,`u_online`,`u_level`,`u_money`,`u_admin` FROM `users` WHERE `u_last_ip` = '%s' OR `u_ip_registration` = '%s' LIMIT 25",
					p_t_info [ _pl_id ] [ p_ip ], p_t_info [ _pl_id ] [ p_reg_ip ] ) ;
					mysql_tquery ( sql_connection, sql_string, "cmd_ipaccounts_callback", "i", playerid ) ;

					DeletePVar ( playerid, "target_id" ) ;
				}
			}
			return 1 ;
	    }
	    case d_player_click_stskin:
	    {
	        if ( ! response ) return DeletePVar ( playerid, "target_id" ) ;

            new _pl_id = GetPVarInt ( playerid, "target_id" ) ;
	        if ( strval ( inputtext ) < 1 || strval ( inputtext ) > 299 )
	        {
	            show_dialog ( playerid, d_player_click_stskin, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Выберите действие", "{"#cRD"}* Нельзя менее 1 и более 299\n\n{"#cWH"}Укажите ID скина, который хотите выдать:", "Выбрать", "Закрыть" ) ;
	            return 1 ;
	        }

	        new clf_string [ 6 ] ;
		    format ( clf_string, sizeof clf_string, "%d %d", _pl_id, strval ( inputtext ) ) ;
			callcmd::changeskin ( playerid, clf_string ) ;

			DeletePVar ( playerid, "target_id" ) ;
			return 1 ;
	    }
	    case d_player_click_car:
	    {
	        if ( ! response ) return DeletePVar ( playerid, "target_id" ) ;

	        new _pl_id = GetPVarInt ( playerid, "target_id" ) ;
	        if ( strval ( inputtext ) < 400 || strval ( inputtext ) > 611 )
	        {
	            show_dialog ( playerid, d_player_click_car, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Выберите действие", "{"#cRD"}* Нельзя менее 400 и более 611\n\n{"#cWH"}Укажите ID транспорта, который хотите выдать:", "Выбрать", "Закрыть" ) ;
	            return 1 ;
	        }

	        new clf_string [ 16 ] ;
		    format ( clf_string, sizeof clf_string, "%d %d 1 1", _pl_id, strval ( inputtext ) ) ;
			callcmd::plveh ( playerid, clf_string ) ;

			DeletePVar ( playerid, "target_id" ) ;
			return 1 ;
		}
	    case d_player_click_skin:
	    {
	        if ( ! response ) return DeletePVar ( playerid, "target_id" ) ;

	        new _pl_id = GetPVarInt ( playerid, "target_id" ) ;
	        if ( strval ( inputtext ) < 1 || strval ( inputtext ) > 299 )
	        {
	            show_dialog ( playerid, d_player_click_skin, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Выберите действие", "{"#cRD"}* Нельзя менее 1 и более 299\n\n{"#cWH"}Укажите ID скина, который хотите выдать:", "Выбрать", "Закрыть" ) ;
	            return 1 ;
	        }

	        new clf_string [ 6 ] ;
		    format ( clf_string, sizeof clf_string, "%d %d", _pl_id, strval ( inputtext ) ) ;
			callcmd::skin ( playerid, clf_string ) ;

			DeletePVar ( playerid, "target_id" ) ;
			return 1 ;
	    }
	    case d_phone_click:
	    {
	        if ( ! response ) return DeletePVar ( playerid, "player_number" ) ;

	        new _value = GetPVarInt ( playerid, "player_number" ) ;
	        DeletePVar ( playerid, "player_number" ) ;

	        for ( new i = 0 ; i < MAX_CONTACTS ; i ++ )
			{
			    if ( users_contacts [ playerid ] [ i ] [ uc_inc ] == -1 ) continue ;
			    if ( users_contacts [ playerid ] [ i ] [ uc_number ] != p_info [ _value ] [ number ] ) continue ;

			    SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данный номер телефона уже есть в Вашей телефонной книге." ) ;
			    return 1 ;
			}

			new bool: _free_cont = false ;
			for ( new i = 0 ; i < MAX_CONTACTS ; i ++ )
			{
			    if ( users_contacts [ playerid ] [ i ] [ uc_inc ] != -1 ) continue ;

				contacts_inc_id ++ ;
			    users_contacts [ playerid ] [ i ] [ uc_inc ] = contacts_inc_id ;
			    users_contacts [ playerid ] [ i ] [ uc_id ] = p_info [ _value ] [ id ] ;
			    users_contacts [ playerid ] [ i ] [ uc_number ] = p_info [ _value ] [ number ] ;
				users_contacts [ playerid ] [ i ] [ uc_skin ] = getNewSkinModel ( _value ) ;

			    format ( users_contacts [ playerid ] [ i ] [ uc_name ], MAX_PLAYER_NAME, "%s", p_info [ _value ] [ name ] ) ;
			    format ( users_contacts [ playerid ] [ i ] [ uc_subname ], MAX_PLAYER_NAME, "%s", p_info [ _value ] [ name ] ) ;

				new query_string [ 300 ] ;
			   	format ( query_string, sizeof query_string, "INSERT INTO `users_contacts` (`inc_id`,`u_id`,`u_c_id`,`u_c_number`,`u_c_skin`) VALUES ('%d','%d','%d','%d','%d')",
			 	users_contacts [ playerid ] [ i ] [ uc_inc ], p_info [ playerid ] [ id ], p_info [ _value ] [ id ], p_info [ _value ] [ number ], getNewSkinModel ( _value ) ) ;
				mysql_tquery ( sql_connection, query_string ) ;

				_free_cont = true ;

				SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы добавили контакт в телефонную книгу! Используйте /phone." ) ;
			    break ;
			}

			if ( _free_cont == false ) SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас записано максимальное число контактов!" ) ;
			return 1 ;
	    }
		case d_government_line:
		{
		    if ( ! response ) return show_government ( playerid ) ;

		    new f = p_info [ playerid ] [ member ] - 1 ;

		    global_string [ 0 ] = EOS ;
			format ( global_string, 480, "{"#cWH"}Вы собираетесь изменить следующую конфигурацию:\n\n\tОрганизация: {%s}%s\n\t{"#cWH"}Название: {"#cLY"}Строка новостей\n\t{"#cWH"}Текущее значение: {"#cLY"}%s\n\t{"#cWH"}Для очистки строки введите: {"#cLY"}- (прочерк)\n\n{"#cGRDialog"}* Введите новое значение для данной конфигурации:", f_info [ f ] [ f_chat_color ], f_info [ f ] [ f_name ], f_gov_line [ f ] [ listitem ] ) ;
			show_dialog ( playerid, d_government_line_set, DIALOG_STYLE_INPUT, "{"#cBHD"}Изменение конфигурации", global_string, "Выбрать", "Назад" ) ;

			SetPVarInt ( playerid, "list_item", listitem ) ;
			return 1 ;
		}
		case d_government_line_set:
		{
		    if ( ! response ) return show_government_line ( playerid ), DeletePVar ( playerid, "list_item" ) ;

			new list_item = GetPVarInt ( playerid, "list_item" ) ;
		    if ( ( strlen ( inputtext ) < 10 || strlen ( inputtext ) > 100 ) && ! GetString ( inputtext, "-" ) )
		    {
		        new f = p_info [ playerid ] [ member ] - 1 ;

		    	global_string [ 0 ] = EOS ;
				format ( global_string, 480, "{"#cWH"}Вы собираетесь изменить следующую конфигурацию:\n\n\tОрганизация: {%s}%s\n\t{"#cWH"}Название: {"#cLY"}Строка новостей\n\t{"#cWH"}Текущее значение: {"#cLY"}%s\n\t{"#cWH"}Для очистки строки введите: {"#cLY"}- (прочерк)\n\n{"#cGRDialog"}* Введите новое значение для данной конфигурации:", f_info [ f ] [ f_chat_color ], f_info [ f ] [ f_name ], f_gov_line [ f ] [ list_item ] ) ;
				show_dialog ( playerid, d_government_line_set, DIALOG_STYLE_INPUT, "{"#cBHD"}Изменение конфигурации", global_string, "Выбрать", "Назад" ) ;

				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Минимальное количество символов {"#cRD"}10{"#cGRInfo"}, а максимальное {"#cRD"}100{"#cGRInfo"}." ) ;
				return 1 ;
		    }
		    if ( check_advertise ( playerid, inputtext, report_type_gov ) || reload_gov_warning ( playerid, inputtext ) )
		    {
		        new f = p_info [ playerid ] [ member ] - 1 ;

		    	global_string [ 0 ] = EOS ;
				format(global_string, 480, "{"#cWH"}Вы собираетесь изменить следующую конфигурацию:\n\n\tОрганизация: {%s}%s\n\t{"#cWH"}Название: {"#cLY"}Строка новостей\n\t{"#cWH"}Текущее значение: {"#cLY"}%s\n\t{"#cWH"}Для очистки строки введите: {"#cLY"}- (прочерк)\n\n{"#cGRDialog"}* Введите новое значение для данной конфигурации:", f_info [ f ] [ f_chat_color ], f_info [ f ] [ f_name ], f_gov_line [ f ] [ list_item ] );
				show_dialog(playerid, d_government_line_set, DIALOG_STYLE_INPUT, "{"#cBHD"}Изменение конфигурации", global_string, "Выбрать", "Назад" ) ;
				return 1 ;
		    }
		    if ( is_text_invalid ( inputtext ) && ! GetString ( inputtext, "-" ) )
		    {
		        new f = p_info [ playerid ] [ member ] - 1 ;

		    	global_string [ 0 ] = EOS ;
				format(global_string, 480, "{"#cWH"}Вы собираетесь изменить следующую конфигурацию:\n\n\tОрганизация: {%s}%s\n\t{"#cWH"}Название: {"#cLY"}Строка новостей\n\t{"#cWH"}Текущее значение: {"#cLY"}%s\n\t{"#cWH"}Для очистки строки введите: {"#cLY"}- (прочерк)\n\n{"#cGRDialog"}* Введите новое значение для данной конфигурации:", f_info [ f ] [ f_chat_color ], f_info [ f ] [ f_name ], f_gov_line [ f ] [ list_item ] );
				show_dialog(playerid, d_government_line_set, DIALOG_STYLE_INPUT, "{"#cBHD"}Изменение конфигурации", global_string, "Выбрать", "Назад" ) ;

				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы указали {"#cRD"}недопустимые{"#cGRInfo"} символы." ) ;
				return 1 ;
		    }

		    new f = p_info [ playerid ] [ member ] - 1 ;
		    format ( f_gov_line [ f ] [ list_item ], 100, "%s", inputtext ) ;

		    static const _str [ ] = "UPDATE `fractions` SET `f_gov_line_%d` = '%s' WHERE `f_id` = '%d' LIMIT 1" ;
		    new _sql_string [ sizeof _str + 4 + 100 + 4 ] ;
			format ( _sql_string, sizeof _sql_string, _str, list_item, f_gov_line [ f ] [ list_item ], f_info [ f ] [ f_id ] ) ;
			mysql_tquery ( sql_connection, _sql_string, "", "" ) ;

			format ( _sql_string, sizeof _sql_string, "%s гос. волну на: %s", p_info [ playerid ] [ name ], f_gov_line [ f ] [ list_item ] ) ;
			WriteLogs ( playerid, f + 1, TYPE_LOG_LMENU, _sql_string ) ;

		    show_government_line ( playerid ) ;
		    DeletePVar ( playerid, "list_item" ) ;
			return 1 ;
		}
	    case d_government:
	    {
	        if ( ! response ) return 1 ;
	        switch ( listitem )
	        {
	            case 0:
				{
				    if ( admin_info [ playerid ] [ admin ] < 6 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Доступно только администраторам." ) ;

					show_government_line ( playerid ) ;
				}
				case 1:
	            {
	                new f = p_info [ playerid ] [ member ] - 1 ;
	                if ( f_time_timer [ f ] > 0 )
	                {
	                    f_time_timer [ f ] = 0 ;
						KillTimer ( f_timer [ f ] ) ;
						f_timer [ f ] = -1 ;

						new scm_string [ 144 ] ;
						format ( scm_string, sizeof scm_string, "[D] (%s) %s %s[%d] освободил(а) волну государственных новостей!", f_info [ f ] [ f_name ], f_rank [ f ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], playerid ) ;
						foreach(new i: logged_players) if ( 18 > p_info [ i ] [ member ] > 0 && p_info [ i ] [ settings ] [ 0 ] ) SendClientMessage ( i, 0xFF8282AA, scm_string ) ;

                        scm_string [ 0 ] = EOS ;
						format ( scm_string, sizeof scm_string, "(%s) %s освободил(а) волну государственных новостей!", f_info [ f ] [ f_name ], p_info [ playerid ] [ name ] ) ;
						WriteLogs ( playerid, f + 1, TYPE_LOG_LMENU, scm_string ) ;

						day_government [ f ] -= 1 ;

						SetPlayerChatBubble ( playerid, "сказал(а) в рацию: {FFFFFF}освободил(а) волну государственных новостей!", col_light_purple, 15.0, 10000 ) ;

						show_government ( playerid ) ;
	                }
	                else
	                {
		                new count_gov = 0 ;
					    for ( new i = 0 ; i < max_gov_line ; i ++ )
					    {
					        if ( GetString ( f_gov_line [ f ] [ i ], "-" ) ) count_gov ++ ;
					    }
					    if ( count_gov == max_gov_line ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет заполненных строк." ) ;

					    for ( new i = 0 ; i < max_fraction ; i ++ )
					    {
					        if ( f_time_timer [ i ] > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Одна из организаций уже заняла волну." ) ;
						}

					    new scm_string [ 144 ] ;
						format ( scm_string, sizeof scm_string, "[D] (%s) %s %s[%d] занял(а) волну государственных новостей!", f_info [ f ] [ f_name ], f_rank [ f ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], playerid ) ;
						foreach(new i: logged_players) if ( 18 > p_info [ i ] [ member ] > 0 && p_info [ i ] [ settings ] [ 0 ] ) SendClientMessage ( i, 0xFF8282AA, scm_string ) ;

                        scm_string [ 0 ] = EOS ;
						format ( scm_string, sizeof scm_string, "(%s) %s занял(а) волну государственных новостей!", f_info [ f ] [ f_name ], p_info [ playerid ] [ name ] ) ;
						WriteLogs ( playerid, f + 1, TYPE_LOG_LMENU, scm_string ) ;

						day_government [ f ] += 1 ;

						SetPlayerChatBubble ( playerid, "сказал(а) в рацию: {FFFFFF}занял(а) волну государственных новостей!", col_light_purple, 15.0, 10000 ) ;

					    f_time_timer [ f ] = 5 ;
			            f_timer [ f ] = SetTimerEx ( "government_go", 60 * 1000, false, "ii", f + 1, playerid ) ;

			            show_government ( playerid ) ;
					}
	            }
	        }
			return 1 ;
	    }
	    case d_duel_select:
	    {
	        if ( ! response ) return clear_player_listitem_values ( playerid ) ;
	        if ( listitem == 0 ) return ShowPlayerDuelInfo ( playerid ) ;
			else
			{
			    new target_id = get_player_listitem_values ( playerid, listitem - 1 ) ;
			    clear_player_listitem_values ( playerid ) ;

				if ( player_duel [ target_id ] [ duel_player_lobby ] == player_duel [ target_id ] [ duel_max_players ] )
				{
				    show_duel ( playerid ) ;
				    SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}В лобби максимальное количество игроков!" ) ;
				    return 1 ;
				}
				player_duel [ target_id ] [ duel_player_lobby ] ++ ;

				GetPlayerPos ( playerid, last_coord [ playerid ] [ 0 ], last_coord [ playerid ] [ 1 ], last_coord [ playerid ] [ 2 ] ) ;
				GetPlayerFacingAngle ( playerid, last_coord [ playerid ] [ 3 ] ) ;

				last_virt [ playerid ] = GetPlayerVirtualWorld ( playerid ) ;
		    	last_int [ playerid ] = GetPlayerInterior ( playerid ) ;

			    player_duel [ playerid ] [ duel_in_lobby ] = target_id ;
			    switch ( player_duel [ target_id ] [ duel_map ] )
				{
				    case 1:
				    {
				        if ( random ( 2 ) == 0 ) set_pos ( playerid, duels_pos [ 0 ] [ 0 ], duels_pos [ 0 ] [ 1 ], duels_pos [ 0 ] [ 2 ], duels_pos [ 0 ] [ 3 ], duels_interior [ 0 ], target_id + 1000 ) ;
				        else set_pos ( playerid, duels_pos [ 1 ] [ 0 ], duels_pos [ 1 ] [ 1 ], duels_pos [ 1 ] [ 2 ], duels_pos [ 1 ] [ 3 ], duels_interior [ 0 ], target_id + 1000 ) ;
				    }
				    case 2:
				    {
				        if ( random ( 2 ) == 0 ) set_pos ( playerid, duels_pos [ 2 ] [ 0 ], duels_pos [ 2 ] [ 1 ], duels_pos [ 2 ] [ 2 ], duels_pos [ 2 ] [ 3 ], duels_interior [ 1 ], target_id + 1000 ) ;
				        else set_pos ( playerid, duels_pos [ 3 ] [ 0 ], duels_pos [ 3 ] [ 1 ], duels_pos [ 3 ] [ 2 ], duels_pos [ 3 ] [ 3 ], duels_interior [ 1 ], target_id + 1000 ) ;
				    }
				    case 3:
				    {
				        if ( random ( 2 ) == 0 ) set_pos ( playerid, duels_pos [ 4 ] [ 0 ], duels_pos [ 4 ] [ 1 ], duels_pos [ 4 ] [ 2 ], duels_pos [ 4 ] [ 3 ], duels_interior [ 2 ], target_id + 1000 ) ;
				        else set_pos ( playerid, duels_pos [ 5 ] [ 0 ], duels_pos [ 5 ] [ 1 ], duels_pos [ 5 ] [ 2 ], duels_pos [ 5 ] [ 3 ], duels_interior [ 2 ], target_id + 1000 ) ;
				    }
				}

				set_health ( playerid, player_duel [ target_id ] [ duel_hp ] ) ;
	            set_armour ( playerid, 0.0 ) ;

	            for ( new i = 0 ; i < 12 ; i ++ )
				{
					duel_guns [ playerid ] [ i ] [ 0 ] = p_t_info [ playerid ] [ p_gun_slot ] [ i ] ;
					duel_guns [ playerid ] [ i ] [ 1 ] = p_t_info [ playerid ] [ p_gun_ammo ] [ i ] ;
				}
				reset_player_weapon ( playerid ) ;

				if ( player_duel [ target_id ] [ duel_gun ] [ 0 ] != 0 ) give_weapon(playerid, player_duel [ target_id ] [ duel_gun ] [ 0 ], 999);
				if ( player_duel [ target_id ] [ duel_gun ] [ 1 ] != 0 ) give_weapon(playerid, player_duel [ target_id ] [ duel_gun ] [ 1 ], 999);
				if ( player_duel [ target_id ] [ duel_gun ] [ 2 ] != 0 ) give_weapon(playerid, player_duel [ target_id ] [ duel_gun ] [ 2 ], 999);

				SendClientMessage ( playerid, col_yellow, !"* Для выхода из лобби используйте: /exitlobby" ) ;
			}
			return 1 ;
	    }
 		case d_duel:
		{
			if ( response )
		    {
		        switch ( listitem )
		        {
		            case 0: // Карта
		            {
			    		show_dialog(playerid, d_duel_card, DIALOG_STYLE_LIST, "{"#cBHD"}Выбор карты", "{"#cBL"}1. {"#cWH"}Две стороны\n{"#cBL"}2. {"#cWH"}Железный корт\n{"#cBL"}3. {"#cWH"}Четыре стены", "Выбор","Отмена");
		            }
		            case 1: // Оружие
		            {
		                ShowWeaponSelect ( playerid ) ;
		            }
		            case 2: // HP
		            {
		       			show_dialog(playerid, d_duel_hp, DIALOG_STYLE_INPUT, "{"#cBHD"}Установка HP",  "{"#cWH"}Укажите, какое количество {"#cGN"}HP{"#cWH"}\nдолжно выдаться Вам и сопернику: {"#cLY"}(5-160hp)", "Готово", "Назад");
		            }
		            case 3: // Пригласить игрока
					{
		                global_string [ 0 ] = EOS ;
		                new line_string [ 64 ] ;

						new TotalPla ;
						foreach(new i: streamed_players[playerid])
						{
						    if(i == playerid) continue;

							set_player_listitem_values ( playerid, TotalPla, i ) ;

							TotalPla ++;
							if ( TotalPla == 20 ) break ;

							format ( line_string, sizeof line_string, "%s[%d]\n", p_info [ i ] [ name ], i ) ;
							strcat ( global_string, line_string ) ;
						}
						if(TotalPla == 0)
						{
		                    show_dialog(playerid, d_duel_back, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Выбор соперника", "{"#cWH"}Нет поблизости игроков, с которыми можно начать дуэль!", "Принять", "");
						}
						else
						{
						    SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Если Вы хотите создать лобби, то тогда не нужно выбирать соперника, оставьте поле пустым." ) ;
						    show_dialog(playerid, d_duel_opponent, DIALOG_STYLE_LIST, "{"#cBHD"}Выбор соперника", global_string, "Выбрать", "Назад");
						}
					}
					case 4: // Ставка
					{
		       			show_dialog(playerid, d_duel_money, DIALOG_STYLE_INPUT, "{"#cBHD"}Денежная ставка", "{"#cWH"}Сколько денег хотите поставить на свой выигрыш.\nУчтите, что у второго игрока должно хватать денег,\nчтобы начать дуэль с Вами: {"#cBL"}(100"valute_title_" - 50.000"valute_title_")", "Готово", "Назад");
					}
					case 5: // Игроки
					{
		       			show_dialog(playerid, d_duel_players, DIALOG_STYLE_INPUT, "{"#cBHD"}Максимальное количество игроков", "{"#cWH"}Сколько игроков Вы готовы принять в лобби?\n\n{"#cGRDialog"}* Введите максимальное количество игроков:", "Готово", "Назад");
					}
		            case 6: // Начать
		            {
						if ( player_duel [ playerid ] [ duel_map ] == 0 ) return show_dialog(playerid, d_duel_back, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Начало дуэли", "{"#cWH"}Вы не выбрали карту для дуэли!", "Принять", "");
						if( player_duel [ playerid ] [ duel_gun ] [ 0 ] == 0 &&
							player_duel [ playerid ] [ duel_gun ] [ 1 ] == 0 &&
							player_duel [ playerid ] [ duel_gun ] [ 2 ] == 0 ) return show_dialog(playerid, d_duel_back, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Начало дуэли", "{"#cWH"}Вы не выбрали оружие!", "Принять", "");

						new playa = player_duel [ playerid ] [ duel_player ] ;

						if ( playa != INVALID_PLAYER_ID )
						{
							if ( player_duel [ playa ] [ duel_create ] == true ) return show_dialog(playerid, d_duel_back, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Начало дуэли", "{"#cWH"}Этот игрок сейчас создает дуэль!", "Принять", "");
						}
						if ( ! player_duel [ playerid ] [ duel_max_players ] && ! IsPlayerConnected ( playa ) ) return show_dialog(playerid, d_duel_back, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Начало дуэли", "{"#cWH"}Соперник покинул сервер!", "Принять", "");
						if ( player_duel [ playerid ] [ duel_money ] < 1 ) return show_dialog(playerid, d_duel_back, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Начало дуэли", "{"#cWH"}Вы не сделали ставку!", "Принять", "");

						new map [ 40 ] ;
						switch ( player_duel [ playerid ] [ duel_map ] )
						{
						    case 1: map = "Две стороны";
						    case 2: map = "Железный корт";
						    case 3: map = "Четыре стены";
						}

						new Guns [ 100 ], gunname [ 32 ], bool: _select_weapon = false ;
						for ( new i = 0 ; i < 3 ; i ++ )
						{
						    if ( ! player_duel [ playerid ] [ duel_gun ] [ i ] ) continue ;
						    GetWeaponName ( player_duel [ playerid ] [ duel_gun ] [ i ], gunname, 32 ) ;
							if ( _select_weapon == false ) format ( Guns, sizeof ( Guns ), "%s%s", Guns, gunname ) ;
							else format ( Guns, sizeof ( Guns ), "%s, %s", Guns, gunname ) ;

							_select_weapon = true ;
						}

						new dialog_string [ 356 ] ;
						if ( playa == INVALID_PLAYER_ID )
						{
						    if ( player_duel [ playerid ] [ duel_max_players ] < 2 ) return show_dialog(playerid, d_duel_back, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Начало дуэли", "{"#cWH"}Вы не указали максимальное количество игроков!", "Принять", "");

						    format(dialog_string, sizeof ( dialog_string ), "\
							{"#cWH"}Вы собираетесь создать {"#cBL"}лобби{"#cWH"}!\n\n\
							Карта:\t\t\t{"#cBL"}%s{"#cWH"}\n\
							Оружие:\t\t{"#cBL"}%s{"#cWH"}\n\
							Ставка:\t\t{"#cGN"}%d"valute_title_"{"#cWH"}\n\
							Спавн HP:\t\t{"#cBL"}%.1f{"#cWH"}\n\
							Максимум игроков:\t{"#cBL"}%d",
							map, Guns, player_duel [ playerid ] [ duel_money ], player_duel [ playerid ] [ duel_hp ], player_duel [ playerid ] [ duel_max_players ] ) ;

							show_dialog(playerid, d_duel_lobby, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Создать лобби", dialog_string, "Принять", "Отказать");
						}
						else
						{
						    format(dialog_string, sizeof ( dialog_string ), "\
							{"#cBL"}%s {"#cWH"}предлагает Вам дуэль!\n\n\
							Карта:\t\t{"#cBL"}%s{"#cWH"}\n\
							Оружие:\t{"#cBL"}%s{"#cWH"}\n\
							Ставка:\t{"#cGN"}%d"valute_title_"{"#cWH"}\n\
							Спавн HP:\t{"#cBL"}%.1f",
							p_info [ playerid ] [ name ], map, Guns, player_duel [ playerid ] [ duel_money ], player_duel [ playerid ] [ duel_hp ] ) ;

							show_dialog(playa, d_duel_invite, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Вам предлагают дуэль", dialog_string, "Принять", "Отказать");

	      					player_duel [ playa ] [ duel_player ] = playerid ;

							SendClientMessage ( playerid, col_green, "Ожидайте ответа от соперника..." ) ;
						}
		            }
		        }
		    }
		    else ClearPVars_Duel ( playerid ) ;
		    return 1 ;
		}
		case d_duel_card:
		{
			if ( response ) player_duel [ playerid ] [ duel_map ] = listitem + 1 ;
			ShowPlayerDuelInfo ( playerid ) ;
			return 1 ;
		}
		case d_duel_gun:
		{
			if ( response )
			{
				player_duel [ playerid ] [ duel_weapon ] = listitem ;
				show_dialog(playerid, d_duel_gun_2, DIALOG_STYLE_LIST, "{"#cBHD"}Выбор оружия", "{"#cBL"}1. {"#cWH"}Бита\n{"#cBL"}2. {"#cWH"}9mm\n{"#cBL"}3. {"#cWH"}Deagle\n{"#cBL"}4. {"#cWH"}Shotgun\n{"#cBL"}5. {"#cWH"}MP5\n{"#cBL"}6. {"#cWH"}AK-47\n{"#cBL"}7. {"#cWH"}M4\n{"#cGRDialog"}Убрать", "Выбор","Назад");
			}
			else
			{
			    ShowPlayerDuelInfo ( playerid ) ;
			}
			return 1 ;
		}
		case d_duel_gun_2:
		{
			if ( response )
			{
				new slot_weapon = player_duel [ playerid ] [ duel_weapon ] ;
				switch ( listitem )
				{
				    case 0: player_duel [ playerid ] [ duel_gun ] [ slot_weapon ] = 5 ;
				    case 1: player_duel [ playerid ] [ duel_gun ] [ slot_weapon ] = 22 ;
				    case 2: player_duel [ playerid ] [ duel_gun ] [ slot_weapon ] = 24 ;
				    case 3: player_duel [ playerid ] [ duel_gun ] [ slot_weapon ] = 25 ;
				    case 4: player_duel [ playerid ] [ duel_gun ] [ slot_weapon ] = 29 ;
				    case 5: player_duel [ playerid ] [ duel_gun ] [ slot_weapon ] = 30 ;
				    case 6: player_duel [ playerid ] [ duel_gun ] [ slot_weapon ] = 31 ;
				    case 7: player_duel [ playerid ] [ duel_gun ] [ slot_weapon ] = 0 ;
				}
			}
			ShowWeaponSelect ( playerid ) ;
			return 1 ;
		}
		case d_duel_hp:
		{
			if ( response )
			{
				new Float:d_hp = floatstr ( inputtext ) ;

				if ( d_hp < 5.0 || d_hp > 160.0 ) return show_dialog(playerid, d_duel_hp, DIALOG_STYLE_INPUT, "{"#cBHD"}Установка HP", "{"#cWH"}Укажите, какое количество {"#cGN"}HP{"#cWH"}\nдолжно выдаться Вам и сопернику: {"#cBL"}(5-150hp)", "Готово", "Назад");

				player_duel [ playerid ] [ duel_hp ] = d_hp ;

				ShowPlayerDuelInfo ( playerid ) ;
			}
			else
			{
			    ShowPlayerDuelInfo ( playerid ) ;
			}
			return 1 ;
		}
		case d_duel_opponent:
		{
			if(response)
			{
				new _o_id = get_player_listitem_values ( playerid, listitem ) ;

				clear_player_listitem_values ( playerid ) ;

			    if ( ! IsPlayerConnected ( _o_id ) ) return show_dialog(playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Произошла ошибка", "{"#cWH"}Этот игрок вышел с сервера!", "Принять", "");

				player_duel [ playerid ] [ duel_player ] = _o_id ;
				ShowPlayerDuelInfo ( playerid ) ;
			}
			else
			{
		        ShowPlayerDuelInfo ( playerid ) ;
			}
			return 1 ;
		}
		case d_duel_back:
		{
		    ShowPlayerDuelInfo ( playerid ) ;
		    return 1 ;
		}
		case d_duel_money:
		{
			if(response)
			{
			    new _value = strval ( inputtext ) ;
			    if ( _value < 100 || _value > 50000 ) return show_dialog(playerid, d_duel_money, DIALOG_STYLE_INPUT, "{"#cBHD"}Денежная ставка",  "{"#cWH"}Сколько денег хотите поставить на свой выигрыш.\nУчтите, что у второго игрока должно хватать денег,\nчтобы начать дуэль с Вами: {"#cBL"}(100"valute_title_" - 50.000"valute_title_")", "Готово", "Назад");
				if ( p_info [ playerid ] [ money ] < _value ) return show_dialog(playerid, d_duel_money, DIALOG_STYLE_INPUT, "{"#cBHD"}Денежная ставка",  "{"#cWH"}Сколько денег хотите поставить на свой выигрыш.\nУчтите, что у второго игрока должно хватать денег,\nчтобы начать дуэль с Вами: {"#cRD"}(У Вас нет столько денег)", "Готово", "Назад");

				player_duel [ playerid ] [ duel_money ] = _value ;

				ShowPlayerDuelInfo ( playerid ) ;
			}
			else
			{
			    ShowPlayerDuelInfo ( playerid ) ;
			}
			return 1 ;
		}
		case d_duel_players:
		{
			if ( response )
			{
			    new _value = strval ( inputtext ) ;
			    if ( _value < 2 || _value > 6 ) return show_dialog(playerid, d_duel_players, DIALOG_STYLE_INPUT, "{"#cBHD"}Максимальное количество игроков", "{"#cRD"}* Минимум 2 игрока, максимум 6.\n\n{"#cWH"}Сколько игроков Вы готовы принять в лобби?\n\n{"#cGRDialog"}* Введите максимальное количество игроков:", "Готово", "Назад");

				player_duel [ playerid ] [ duel_max_players ] = _value ;

				ShowPlayerDuelInfo ( playerid ) ;
			}
			else
			{
			    ShowPlayerDuelInfo ( playerid ) ;
			}
			return 1 ;
		}
		case d_duel_invite:
		{
			new _o_id = player_duel [ playerid ] [ duel_player ] ;
			if ( response )
			{
			    if ( player_duel [ _o_id ] [ duel_player ] != playerid )
			    {
				    ClearPVars_Duel ( _o_id ) ;
		        	ClearPVars_Duel ( playerid ) ;

				    show_dialog(_o_id, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Дуэль отменена", "{"#cWH"}Нельзя приглашать сразу несколько человек!", "Принять", "");
					return show_dialog(playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Дуэль отменена", "{"#cWH"}Нельзя приглашать сразу несколько человек!", "Принять", "");
			    }
				if ( ! IsPlayerConnected ( _o_id ) )
				{
				    ClearPVars_Duel ( playerid ) ;
					return show_dialog(playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Дуэль отменена", "{"#cWH"}Соперник покинул сервер!", "Принять", "");
				}
				if ( ! IsPlayerInRangeOfPoint ( playerid, 10, p_t_info [ _o_id ][ p_pos ] [ 0 ], p_t_info [ _o_id ] [ p_pos ] [ 1 ], p_t_info [ _o_id ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( _o_id ) != GetPlayerVirtualWorld ( playerid ) )
				{
				    ClearPVars_Duel ( playerid ) ;
					return show_dialog(playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Дуэль отменена", "{"#cWH"}Соперник не рядом с Вами!", "Принять", "");
				}
				if ( p_info [ _o_id ] [ money ] < player_duel [ _o_id ] [ duel_money ] )
				{
				    ClearPVars_Duel ( _o_id ) ;
		        	ClearPVars_Duel ( playerid ) ;

				    show_dialog(_o_id, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Дуэль отменена", "{"#cWH"}У Вас нет денег для ставки", "Принять", "");
					return show_dialog(playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Дуэль отменена", "{"#cWH"}У соперника нет денег для ставки", "Принять", "");
				}
				if ( p_info [ playerid ] [ money ] < player_duel [ _o_id ] [ duel_money ] )
				{
				    ClearPVars_Duel ( _o_id ) ;
		        	ClearPVars_Duel ( playerid ) ;
				    show_dialog(_o_id, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Дуэль отменена", "{"#cWH"}У соперника нет денег для ставки!", "Принять", "");
					return show_dialog(playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Дуэль отменена", "{"#cWH"}У Вас нет денег для ставки!", "Принять", "");
				}

				for ( new i = 0 ; i < 12 ; i ++ )
				{
					duel_guns [ playerid ] [ i ] [ 0 ] = p_t_info [ playerid ] [ p_gun_slot ] [ i ] ;
					duel_guns [ playerid ] [ i ] [ 1 ] = p_t_info [ playerid ] [ p_gun_ammo ] [ i ] ;
				}
				reset_player_weapon ( playerid ) ;
				reset_player_weapon ( _o_id ) ;

				SetCameraBehindPlayer ( playerid ) ;
				SetCameraBehindPlayer ( _o_id ) ;

                duel_opponent [ playerid ] = _o_id ;
				duel_opponent [ _o_id ] = playerid ;

				player_duel [ playerid ] [ duel_money ] = player_duel [ _o_id ] [ duel_money ] ;

				give_money ( playerid, -player_duel [ playerid ] [ duel_money ] ) ;
				give_money ( duel_opponent [ playerid ], -player_duel [ playerid ] [ duel_money ] ) ;
				insert_money_log ( playerid, INVALID_PLAYER_ID, player_duel [ playerid ] [ duel_money ], "дуэль ставка" ) ;
				insert_money_log ( duel_opponent [ playerid ], INVALID_PLAYER_ID, player_duel [ playerid ] [ duel_money ], "дуэль ставка" ) ;

				GetPlayerPos ( playerid, last_coord [ playerid ] [ 0 ], last_coord [ playerid ] [ 1 ], last_coord [ playerid ] [ 2 ] ) ;
				GetPlayerFacingAngle ( playerid, last_coord [ playerid ] [ 3 ] ) ;

				last_virt [ playerid ] = GetPlayerVirtualWorld ( playerid ) ;
		    	last_int [ playerid ] = GetPlayerInterior ( playerid ) ;

	    	    GetPlayerPos ( _o_id, last_coord [ _o_id ] [ 0 ], last_coord [ _o_id ] [ 1 ], last_coord [ _o_id ] [ 2 ] ) ;
				GetPlayerFacingAngle ( _o_id, last_coord [ _o_id ] [ 3 ] ) ;

				last_virt [ _o_id ] = GetPlayerVirtualWorld ( _o_id ) ;
		    	last_int [ _o_id ] = GetPlayerInterior ( _o_id ) ;

				switch ( player_duel [ _o_id ] [ duel_map ] )
				{
				    case 1:
