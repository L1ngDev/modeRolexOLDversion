CMD:stcapture ( playerid )
{
	if ( admin_info [ playerid ] [ admin ] < 2 ) return 1 ;
	global_string [ 0 ] = EOS ;
	format ( global_string, 600, "{"#cBL"}** Статистика за последний каптур **\n\n\
	{%s}%s{"#cWH"} - warn: %d, kick: %d, ban: %d\n\
	{%s}%s{"#cWH"} - warn: %d, kick: %d, ban: %d\n\
	{%s}%s{"#cWH"} - warn: %d, kick: %d, ban: %d\n\
	{%s}%s{"#cWH"} - warn: %d, kick: %d, ban: %d\n\
	{%s}%s{"#cWH"} - warn: %d, kick: %d, ban: %d\n\
	\n{"#cBL"}** Статистика последней войны за бизнес **\n\n\
	{%s}%s{"#cWH"} - warn: %d, kick: %d, ban: %d\n\
	{%s}%s{"#cWH"} - warn: %d, kick: %d, ban: %d\n\
	{%s}%s{"#cWH"} - warn: %d, kick: %d, ban: %d",
	f_info [ 17 ] [ f_chat_color ], f_info [ 17 ] [ f_name ], f_warn [ 18 ], f_kick [ 18 ], f_ban [ 18 ],
	f_info [ 18 ] [ f_chat_color ], f_info [ 18 ] [ f_name ], f_warn [ 19 ], f_kick [ 19 ], f_ban [ 19 ],
	f_info [ 19 ] [ f_chat_color ], f_info [ 19 ] [ f_name ], f_warn [ 20 ], f_kick [ 20 ], f_ban [ 20 ],
	f_info [ 20 ] [ f_chat_color ], f_info [ 20 ] [ f_name ], f_warn [ 21 ], f_kick [ 21 ], f_ban [ 21 ],
	f_info [ 21 ] [ f_chat_color ], f_info [ 21 ] [ f_name ], f_warn [ 22 ], f_kick [ 22 ], f_ban [ 22 ],
	f_info [ 22 ] [ f_chat_color ], f_info [ 22 ] [ f_name ], f_warn [ 23 ], f_kick [ 23 ], f_ban [ 23 ],
	f_info [ 23 ] [ f_chat_color ], f_info [ 23 ] [ f_name ], f_warn [ 24 ], f_kick [ 24 ], f_ban [ 24 ],
	f_info [ 24 ] [ f_chat_color ], f_info [ 24 ] [ f_name ], f_warn [ 25 ], f_kick [ 25 ], f_ban [ 25 ] ) ;
	show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Статистика захватов", global_string, "Закрыть", "" ) ;
