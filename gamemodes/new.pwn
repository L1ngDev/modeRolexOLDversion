					new sql_string [ 80 + 4 + 9 ] ;
					format ( sql_string, sizeof sql_string, "UPDATE `users` SET `u_disease_stage` = '%d' WHERE `u_id` = '%d' LIMIT 1", p_info [ playerid ] [ p_disease ] [ 1 ], p_info [ playerid ] [ id ] ) ;
					mysql_tquery ( sql_connection, sql_string ) ;
