	SetPlayerSkillLevel ( playerid, WEAPONSKILL_SHOTGUN, p_info [ playerid ] [ gun_skills ] [ 2 ] * 10 ) ;
	SetPlayerSkillLevel ( playerid, WEAPONSKILL_MP5, p_info [ playerid ] [ gun_skills ] [ 3 ] * 10 ) ;
	SetPlayerSkillLevel ( playerid, WEAPONSKILL_AK47, p_info [ playerid ] [ gun_skills ] [ 4 ] * 10 ) ;
	SetPlayerSkillLevel ( playerid, WEAPONSKILL_M4, p_info [ playerid ] [ gun_skills ] [ 5 ] * 10 ) ;
	SetPlayerSkillLevel ( playerid, WEAPONSKILL_SNIPERRIFLE, p_info [ playerid ] [ gun_skills ] [ 6 ] * 10 ) ;
	return 1 ;
}

stock ToDevelopSkills ( slashes, points )
{
	new _str [ 149 ], Slash [ 2 ] = "|", Point [ 2 ] = "." ;
	for ( new i = 0 ; i < slashes ; i ++ ) strcat ( _str, Slash ) ;
	for ( new i = 0 ; i < points ; i ++ ) strcat ( _str, Point ) ;
	return _str ;
}

stock GetPlayerCashValueToSmile ( intenger )
{
	new fmt_money [ 42 ] ;

	if ( 0 <= intenger <= 999 )
	{
		new dolar = intenger % 1000 ;

		format ( fmt_money, sizeof fmt_money, "%d", dolar ) ;
	}
	else if ( 1000 <= intenger <= 999999 )
	{
		new tis = ( intenger % 1000000 ) / 1000 ;
		new dolar = intenger % 1000 ;

		format ( fmt_money, sizeof fmt_money, "%d.%03i", tis, dolar ) ;
	}
	else if ( 1000000 <= intenger <= 999999999 )
	{
		new milion = ( intenger % 1000000000 ) / 1000000 ;
		new tis = ( intenger % 1000000 ) / 1000 ;
		new dolar = intenger % 1000 ;

		format ( fmt_money, sizeof fmt_money, "%d.%03i.%03i", milion, tis, dolar ) ;
	}
	else if ( 1000000000 <= intenger <= 2_147_000_000 )
	{
	    new miliard = intenger / 1000000000 ;
		new milion = ( intenger % 1000000000 ) / 1000000 ;
		new tis = ( intenger % 1000000 ) / 1000 ;
		new dolar = intenger % 1000 ;

		format ( fmt_money, sizeof fmt_money, "%d.%03i.%03i.%03i", miliard, milion, tis, dolar ) ;
	}

	return fmt_money ;
}

stock GetPlayerCashValue ( intenger )
{
    new fmt_money [ 42 ] ;

	if ( 0 <= intenger <= 999 )
	{
		new dolar = intenger % 1000 ;

		format ( fmt_money, sizeof fmt_money, "%d", dolar ) ;
	}
	else if ( 1000 <= intenger <= 999999 )
	{
		new tis = ( intenger % 1000000 ) / 1000 ;
		new dolar = intenger % 1000 ;

		format ( fmt_money, sizeof fmt_money, "%d тыс. %d", tis, dolar ) ;
	}
	else if ( 1000000 <= intenger <= 999999999 )
	{
		new milion = ( intenger % 1000000000 ) / 1000000 ;
		new tis = ( intenger % 1000000 ) / 1000 ;
		new dolar = intenger % 1000 ;

		format ( fmt_money, sizeof fmt_money, "%d млн. %d тыс. %d", milion, tis, dolar ) ;
	}
	else if ( 1000000000 <= intenger <= 2_147_000_000 )
	{
	    new miliard = intenger / 1000000000 ;
		new milion = ( intenger % 1000000000 ) / 1000000 ;
		new tis = ( intenger % 1000000 ) / 1000 ;
		new dolar = intenger % 1000 ;

		format ( fmt_money, sizeof fmt_money, "%d млрд. %d млн. %d тыс. %d", miliard, milion, tis, dolar ) ;
	}

	return fmt_money ;
}

stock driving_license ( carid )
{
	switch ( GetVehicleModel ( carid ) )
	{
		case 400..416,418..424,426..429,431..445,449,451,455,456,458,459,461: return 1;
		case 463,466..468,470,471,474,475,477..480,482,483,485,486,489..492,494..496,498..508: return 1;
		case 514..518,521..531,533..537,539..547,549..551,554..562,564..568,572..576,578..583,585..589,596..605,609: return 1;
	}
	return 0 ;
}

ShowTestQuestion ( playerid, begin, end, dialogid, q = -1 )
{
	if ( q == -1 ) q = RandomEx ( begin, end ) ;
	SetPVarInt ( playerid, "pTestQNumber", q + 1 ) ;
	global_string [ 0 ] = EOS ;
	format ( global_string, 300, "{"#cBL"}%s\n{"#cWH"}* %s\n* %s\n* %s\n* %s", gExamQuestions [ q ], gExamAnswers [ q ] [ 0 ], gExamAnswers [ q ] [ 1 ], gExamAnswers [ q ] [ 2 ], gExamAnswers [ q ] [ 3 ] ) ;
	show_dialog ( playerid, dialogid, DIALOG_STYLE_LIST, "{"#cBHD"}Школа вождения", global_string, "Далее", "Отмена" ) ;
	return 1 ;
}

stock SetNextBusCP ( playerid, pos )
{
	new type = 0 ;
	if ( pos + 1 >= bus_count || bus_info [ pos ] [ bus_step ] != bus_info [ pos + 1 ] [ bus_step ] ) return bus_delivery ( playerid ) ;
	if ( bus_info [ pos ] [ bus_stop ] == 1 ) type = 1 ;
	SetPlayerRaceCheckpoint(playerid, type, bus_info [ pos ] [ bus_position ] [ 0 ], bus_info [ pos ] [ bus_position ] [ 1 ], bus_info [ pos ] [ bus_position ] [ 2 ], bus_info [ pos + 1 ] [ bus_position ] [ 0 ], bus_info [ pos + 1 ] [ bus_position ] [ 1 ], bus_info [ pos + 1 ] [ bus_position ] [ 2 ], 4.0 ) ;
	return 1 ;
}

callback: BusStop ( playerid )
{
	new pos = p_t_info  [ playerid ] [ pBusPos ] ;
	if ( bus_info [ pos ] [ bus_step ] != bus_info [ pos + 1 ] [ bus_step ] )
	{
	    bus_delivery ( playerid ) ;
		return 1 ;
	}
	else p_t_info  [ playerid ] [ pBusPos ] ++ ;
	SetNextBusCP ( playerid, p_t_info  [ playerid ] [ pBusPos ] ) ;
	return 1;
}

callback: BusSpawn ( playerid )
{
	DisablePlayerRaceCheckpoint ( playerid ) ;
	player_rentcar [ playerid ] = INVALID_VEHICLE_ID ;

	p_t_info  [ playerid ] [ pBusRoute ] =
	p_t_info  [ playerid ] [ pBusPos ] =
	p_t_info  [ playerid ] [ pBusPrice ] = 0 ;

	if ( IsValidDynamic3DTextLabel ( p_t_info  [ playerid ] [ pBusText] ) ) DestroyDynamic3DTextLabel ( p_t_info  [ playerid ] [ pBusText] ) ;
	p_t_info [ playerid ] [ pBusText ] = Text3D:INVALID_3DTEXT_ID ;

	new __t_string [ 64 ] ;
	format ( __t_string, sizeof ( __t_string ), "{"#cGInfo"}* {"#cWH"}Заработано: {"#cGN"}%d"valute_title_"", p_info [ playerid ] [ salary ] ) ;
	SendClientMessage ( playerid, col_white, __t_string ) ;
	return 1 ;
}

stock bus_delivery ( playerid )
{
	checking_quest_progress ( playerid, 3, bus_info [ p_t_info [ playerid ] [ pBusRoute ] ] [ bus_price ], quest_line_medium ) ;

	p_info  [ playerid ] [ salary ] += bus_info [ p_t_info [ playerid ] [ pBusRoute ] ] [ bus_price ] * zp_for_gos [ 7 ] ;

   	p_t_info  [ playerid ] [ pBusRoute ] =
	p_t_info  [ playerid ] [ pBusPos ] = 0  ;

	p_info [ playerid ] [ bus_skill ] += 10 * server_bonus [ 2 ] ;
	update_int_sql ( playerid, "u_bskill", p_info [ playerid ] [ bus_skill ] ) ;

	new __t_string [ 64 ] ;
	format ( __t_string, sizeof ( __t_string ), "{"#cGInfo"}* {"#cWH"}Заработано: {"#cGN"}%d"valute_title_"", p_info [ playerid ] [ salary ] ) ;
	SendClientMessage ( playerid, col_white, __t_string ) ;
	SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Используйте /route, чтобы выбрать рейс." ) ;
	return 1 ;
}

stock GetSpeed ( playerid )
{
	new Float:_v_velocity[3];
	if (IsPlayerInAnyVehicle(playerid))
	{
		GetVehicleVelocity(GetPlayerVehicleID(playerid),_v_velocity[0],_v_velocity[1],_v_velocity[2] ) ;
	}
	else
	{
		GetPlayerVelocity(playerid,_v_velocity[0],_v_velocity[1],_v_velocity[2] ) ;
	}
	return floatround ( floatsqroot(floatpower(floatabs(_v_velocity[0]), 2.0) + floatpower(floatabs(_v_velocity[1]), 2.0) + floatpower(floatabs(_v_velocity[2]), 2.0)) * 100.3 ) ;
}

stock SetVehicleSpeed ( vehicleid, Float:speed )
{
    new Float:_v_velocity [ 4 ] ;
    GetVehicleZAngle ( vehicleid, _v_velocity [ 0 ] ) ;
    GetVehicleVelocity ( vehicleid, _v_velocity [ 1 ], _v_velocity [ 2 ], _v_velocity [ 3 ] ) ;
    SetVehicleVelocity ( vehicleid, floatsin ( -_v_velocity [ 0 ], degrees ) * ( speed / 99 ), floatcos ( -_v_velocity [ 0 ], degrees ) * ( speed / 99 ), _v_velocity [ 3 ] ) ;
    return true ;
}

stock GetVehicleRotation(vehicleid,&Float:rx,&Float:ry,&Float:rz)
{
	new Float:qw,Float:qx,Float:qy,Float:qz;
	GetVehicleRotationQuat(vehicleid,qw,qx,qy,qz ) ;
	rx = asin(2*qy*qz-2*qx*qw ) ;
	ry = -atan2(qx*qz+qy*qw,0.5-qx*qx-qy*qy ) ;
	rz = -atan2(qx*qy+qz*qw,0.5-qx*qx-qz*qz ) ;
}

stock IsVehicleDrivingBackwards ( vehicleid )
{
    new Float:float_var [ 3 ] ;
    if(GetVehicleVelocity(vehicleid, float_var [ 1 ], float_var [ 2 ], float_var [ 0 ] ) )
	{
        GetVehicleZAngle ( vehicleid, float_var[0] ) ;
        if(float_var[0] < 90) {
            if(float_var[1] > 0 && float_var[2] < 0) return true ;
        }
        else if(float_var[0] < 180) {
            if(float_var[1] > 0 && float_var[2] > 0) return true ;
        }
        else if(float_var[0] < 270) {
            if(float_var[1] < 0 && float_var[2] > 0) return true ;
        }
        else if(float_var[1] < 0 && float_var[2] < 0) return true ;
    }
    return false ;
}

callback: cnock_timer ( playerid )
{
   	ClearAnimations ( playerid ) ;
 	TogglePlayerControllable ( playerid, true ) ;
	return 1 ;
}

callback: untazer_timer ( playerid )
{
   	ClearAnimations ( playerid ) ;
 	TogglePlayerControllable ( playerid, true ) ;
 	is_tazered { playerid } = 0 ;
	return 1 ;
}

callback: un_ems_timer ( vehicleid )
{
	veh_info [ vehicleid - 1 ] [ v_ems ] = false ;
	return 1 ;
}

stock update_gdorm_text ( fractionid )
{
	if ( fractionid < 18 ) return 1 ;
	new t_string [ 300 ], gang_gz_count ;
	if ( fractionid >= 18 && fractionid <= 22 )
	{
	    for ( new i = 0 ; i < gz_count ; i ++ )
		{
			if ( gz_info [ i ] [ gz_owner ] == fractionid ) gang_gz_count ++ ;
		}

		format ( t_string,sizeof ( t_string ),"\
		*** Общак %s ***\n\n\
		{"#cWH3D"}Количество территорий:{"#cOR3D"} \t%d\n\
		{"#cWH3D"}Деньги:{"#cOR3D"} \t%s"valute_title_"",
		f_info [ fractionid - 1 ] [ f_name ], gang_gz_count,
		GetPlayerCashValue ( f_info [ fractionid - 1 ] [ f_money ] ) ) ;
	}
	else
	{
	    for ( new i = 0 ; i < b_count ; i ++ )
		{
			if ( b_info [ i ] [ b_mafia ] == fractionid ) gang_gz_count ++ ;
		}

		format ( t_string,sizeof ( t_string ),"\
		*** Общак %s ***\n\n\
		{"#cWH3D"}Количество бизнесов:{"#cOR3D"} \t%d\n\
		{"#cWH3D"}Деньги:{"#cOR3D"} \t%s"valute_title_"",
		f_info [ fractionid - 1 ] [ f_name ], gang_gz_count,
		GetPlayerCashValue ( f_info [ fractionid - 1 ] [ f_money ] ) ) ;
	}

	UpdateDynamic3DTextLabelText( gdorm_text [ fractionid - 1 ], col_header_3d, t_string ) ;
	return 1 ;
}

stock IsPlayerToSquare(playerid,Float:min_x,Float:min_y,Float:max_x,Float:max_y)
{
	new Float:xxp,Float:yyp,Float:zzp;
	GetPlayerPos(playerid,xxp,yyp,zzp ) ;
	if((xxp <= max_x && xxp >= min_x) && (yyp <= max_y && yyp >= min_y)) return 1;
	return 0 ;
}

stock update_action_step ( playerid )
{
	if ( action_step { playerid } > 100 ) action_step { playerid } = 100 ;

	new Float:td_x = 0.898 * action_step { playerid } ;
	PlayerTextDrawTextSize(playerid, action_ptd [ playerid ] [ 1 ], td_x, 3.4298 ) ;
	PlayerTextDrawHide ( playerid, action_ptd [ playerid ] [ 1 ] ) ;
	PlayerTextDrawShow ( playerid, action_ptd [ playerid ] [ 1 ] ) ;
	return 1 ;
}

stock action_td_status ( playerid, bool:status )
{
	if ( status )
	{
		toggle_controlable ( playerid, false ) ;

		action_ptd [ playerid ] [ 0 ] = CreatePlayerTextDraw(playerid, 320.6666, 398.1667, "N"); // Keyword
		PlayerTextDrawLetterSize(playerid, action_ptd [ playerid ] [ 0 ], 0.3846, 1.5211);
		PlayerTextDrawAlignment(playerid, action_ptd [ playerid ] [ 0 ], 2);
		PlayerTextDrawColor(playerid, action_ptd [ playerid ] [ 0 ], color_textdraw);
		PlayerTextDrawBackgroundColor(playerid, action_ptd [ playerid ] [ 0 ], 255);
		PlayerTextDrawFont(playerid, action_ptd [ playerid ] [ 0 ], 1);
		PlayerTextDrawSetProportional(playerid, action_ptd [ playerid ] [ 0 ], 1);
		PlayerTextDrawSetShadow(playerid, action_ptd [ playerid ] [ 0 ], 0);

		action_ptd [ playerid ] [ 1 ] = CreatePlayerTextDraw(playerid, 275.5999, 426.2593, "ld_spac:white"); // Progress
		PlayerTextDrawTextSize(playerid, action_ptd [ playerid ] [ 1 ], action_step { playerid } * 0.898, 3.4298);
		PlayerTextDrawAlignment(playerid, action_ptd [ playerid ] [ 1 ], 1);
		PlayerTextDrawColor(playerid, action_ptd [ playerid ] [ 1 ], color_textdraw);
		PlayerTextDrawBackgroundColor(playerid, action_ptd [ playerid ] [ 1 ], 255);
		PlayerTextDrawFont(playerid, action_ptd [ playerid ] [ 1 ], 4);
		PlayerTextDrawSetProportional(playerid, action_ptd [ playerid ] [ 1 ], 0);
		PlayerTextDrawSetShadow(playerid, action_ptd [ playerid ] [ 1 ], 0);

		switch ( random ( 5 ) )
		{
			case 0..2:action_key [ playerid ] = KEY_YES, PlayerTextDrawSetString ( playerid, action_ptd [ playerid ] [ 0 ], "~g~Y" ) ;
			case 3..5:action_key [ playerid ] = KEY_NO, PlayerTextDrawSetString ( playerid, action_ptd [ playerid ] [ 0 ], "~r~N" ) ;
		}
		for ( new i = 0 ; i < 15 ; i ++ )
		{
			if ( i < 2 ) PlayerTextDrawShow ( playerid, action_ptd [ playerid ] [ i ] ) ;
			TextDrawShowForPlayer ( playerid, action_td [ i ] ) ;
		}
	}
	else
	{
		toggle_controlable ( playerid, true ) ;
		if ( action_ptd [ playerid ] [ 0 ] != PlayerText:-1 )
		{
			for ( new i = 0 ; i < 15 ; i ++ )
			{
			    if ( i < 2 )
			    {
					PlayerTextDrawDestroy ( playerid, action_ptd [ playerid ] [ i ] ) ;
					action_ptd [ playerid ] [ i ] = PlayerText:-1;
				}
				TextDrawHideForPlayer ( playerid, action_td [ i ] ) ;
			}
		}
		action_type { playerid } =
		action_step { playerid } =
		action_key [ playerid ] = 0 ;
	}
	return 1 ;
}

stock checking_action_type ( playerid, _action_type )
{
    switch ( _action_type )
	{
		case ACTION_CELLAR:
		{
			new h = GetPVarInt ( playerid, "house_id" ) - 1 ;
			if ( h == -1 )
			{
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Попробуйте переработать семяна снова." ) ;
				action_step { playerid } = 0 ;
				action_td_status ( playerid, false ) ;
				return 1 ;
			}
			if ( h_info [ h ] [ h_seed_result ] > 15 )
			{
				new seed_count = RandomEx ( 6, 15 ) ;
				new seed_count_give = RandomEx ( 6, 25 ) ;

				h_info [ h ] [ h_seed_result ] -= seed_count ;
				give_inventory ( playerid, 2155, seed_count_give, 0, "", "", NUMBERPLATE_TYPE_NONE, 0 ) ;

				new d_string [ 106 + 4 + 4 ] ;
				format ( d_string, sizeof d_string, "{"#cGInfo"}* {"#cWH"}Вы переработали {"#cGN"}%i гр.{"#cWH"} урожая в {"#cGN"}%i гр.{"#cWH"}наркотиков.", seed_count, seed_count_give ) ;
				SendClientMessage ( playerid, col_white, d_string ) ;
			}
			else
			{
				new seed_count = h_info [ h ] [ h_seed_result ] ;
				new seed_count_give = RandomEx ( 1, 15 ) ;

				h_info [ h ] [ h_seed_result ] = 0 ;
				give_inventory ( playerid, 2155, seed_count_give, 0, "", "", NUMBERPLATE_TYPE_NONE, 0 ) ;

				new d_string [ 106 + 4 + 4 ] ;
				format ( d_string, sizeof d_string, "{"#cGInfo"}* {"#cWH"}Вы переработали {"#cGN"}%i гр.{"#cWH"} урожая в {"#cGN"}%i гр.{"#cWH"} наркотиков.", seed_count, seed_count_give ) ;
				SendClientMessage ( playerid, col_white, d_string ) ;
			}
		}
		case ACTION_CLCELLAR:
		{
			new h = GetPVarInt ( playerid, "cellar_id" ) - 1 ;
			if ( h == -1 )
			{
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Попробуйте переработать семяна снова." ) ;
				action_step { playerid } = 0 ;
				action_td_status ( playerid, false ) ;
				return 1 ;
			}
			if ( cellar_info [ h ] [ cl_seed_result ] > 15 )
			{
				new seed_count = RandomEx ( 6, 15 ) ;
				new seed_count_give = RandomEx ( 6, 25 ) ;

				cellar_info [ h ] [ cl_seed_result ] -= seed_count ;
				give_inventory ( playerid, 2155, seed_count_give, 0, "", "", NUMBERPLATE_TYPE_NONE, 0 ) ;

				new d_string [ 106 + 4 + 4 ] ;
				format ( d_string, sizeof d_string, "{"#cGInfo"}* {"#cWH"}Вы переработали {"#cGN"}%i гр.{"#cWH"} урожая в {"#cGN"}%i гр.{"#cWH"} наркотиков.", seed_count, seed_count_give ) ;
				SendClientMessage ( playerid, col_white, d_string ) ;

				checking_getto_quest_progress ( playerid, 5, seed_count_give ) ;
			}
			else
			{
				new seed_count = cellar_info [ h ] [ cl_seed_result ] ;
				new seed_count_give = RandomEx ( 1, 15 ) ;

				cellar_info [ h ] [ cl_seed_result ] = 0 ;
				give_inventory ( playerid, 2155, seed_count_give, 0, "", "", NUMBERPLATE_TYPE_NONE, 0 ) ;

				new d_string [ 106 + 4 + 4 ] ;
				format ( d_string, sizeof d_string, "{"#cGInfo"}* {"#cWH"}Вы переработали {"#cGN"}%d гр.{"#cWH"} урожая в {"#cGN"}%i гр.{"#cWH"} наркотиков.", seed_count, seed_count_give ) ;
				SendClientMessage ( playerid, col_white, d_string ) ;

                checking_getto_quest_progress ( playerid, 5, seed_count_give ) ;
			}
		}
		case ACTION_FACTORY:
		{
			RemovePlayerAttachedObject ( playerid, 0 ) ;
			RemovePlayerAttachedObject ( playerid, 1 ) ;

			ClearAnimations ( playerid ) ;
			table_area_toggled [ factory_table_id { playerid } ] = INVALID_PLAYER_ID ;

			if( ! IsPlayerInDynamicArea ( playerid, table_area [ factory_table_id { playerid } ] ) )
			{
				factory_table_id { playerid } = 0 ;
				ApplyAnimation(playerid,"CARRY","crry_prtial", 4.1, 0, 1, 1, 1, 1 ) ;
				SetTimerEx ( "carry_timer", 500, false, "d", playerid ) ;
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Запчасть оказалась бракованной. Пожалуйста, повторите попытку." ) ;
			}
			else
			{
				factory_table_id { playerid } = 0 ;

				if ( random ( 100 ) > 5 )
				{
					SetPlayerAttachedObject ( playerid, 0, 3013, 6, 0.0, 0.10, -0.2, -110.0, 0.0, 78.0 ) ;
					SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы собрали запчасти. Отнесите их на склад." ) ;

					p_t_info [ playerid ] [ p_animation ] = true ;

					SetPlayerCheckpoint ( playerid, factory_box_unload [ 0 ], factory_box_unload [ 1 ], factory_box_unload [ 2 ], 4.0 ) ;
					is_checkpoint_used { playerid } = 1 ;

					ApplyAnimation(playerid,"CARRY","crry_prtial", 4.1, 0, 1, 1, 1, 1 ) ;
					SetTimerEx ( "carry_timer", 500, false, "d", playerid ) ;

					give_event_progress ( playerid, THE_FACTORY, 1 ) ;
				}
				else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Запчасть оказалась бракованной. Пожалуйста, повторите попытку сбора." ) ;
			}
		}
		case ACTION_ARMY_GATE:
		{
		    if ( used_area [ playerid ] != -1 )
			{
			    if ( area_info [ used_area [ playerid ] ] [ a_type ] == area_type_barriers )
			    {
					new j = area_info [ used_area [ playerid ] ] [ a_item ] ;
					if ( barrier_status [ j ] == true ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Барьер уже поднят!" ) ;

					barrier_status [ j ] = true ;
                    MoveDynamicObject ( barrier_object [ j ],
										barrier_pos [ j ] [ open_bar ] [ 0 ],
										barrier_pos [ j ] [ open_bar ] [ 1 ],
										barrier_pos [ j ] [ open_bar ] [ 2 ],
										barrier_pos [ j ] [ speed_bar ],
										barrier_pos [ j ] [ open_bar ] [ 3 ],
										barrier_pos [ j ] [ open_bar ] [ 4 ],
										barrier_pos [ j ] [ open_bar ] [ 5 ] ) ;

					SetTimerEx("barrier_callback", 10000, 0, "i", j ) ;
					if ( barrier_pos [ j ] [ double_bar_id ] != -1 )
					{
					    new _double_bar_id = barrier_pos [ j ] [ double_bar_id ] ;
						MoveDynamicObject ( barrier_object [ _double_bar_id ],
											barrier_pos [ _double_bar_id ] [ open_bar ] [ 0 ],
											barrier_pos [ _double_bar_id ] [ open_bar ] [ 1 ],
											barrier_pos [ _double_bar_id ] [ open_bar ] [ 2 ],
											barrier_pos [ _double_bar_id ] [ speed_bar ],
											barrier_pos [ _double_bar_id ] [ open_bar ] [ 3 ],
											barrier_pos [ _double_bar_id ] [ open_bar ] [ 4 ],
											barrier_pos [ _double_bar_id ] [ open_bar ] [ 5 ] ) ;
						SetTimerEx("barrier_callback", 10000, 0, "i", _double_bar_id ) ;
					}

					SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Барьер опустится в течение {"#cBL"}10 секунд{"#cGRInfo"}." ) ;
				}
			}

			action_td_status ( playerid, false ) ;
		}
		case ACTION_JACKCAR:
		{
			new veh_id = GetPVarInt ( playerid, "CarJack" ) ;

			PlayerPlaySound ( playerid, 1145, 0.0, 0.0, 0.0 ) ;
			toggle_locked ( playerid, veh_id, 1 ) ;
			SendClientMessage ( playerid, col_gray, !"{"#cGInfo"}* {"#cGRInfo"}Вы успешно взломали замок." ) ;

			if ( p_t_info [ playerid ] [ t_robbery ] != -1 )
			{
				new _team = p_t_info [ playerid ] [ t_robbery ] ;

				if ( bank_vehicle [ _team ] == veh_id )
				{
					if ( bank_progress [ _team ] == 3 )
					{
						bank_progress [ _team ] = 4 ;
						step_bank_robbery ( _team, bank_progress [ _team ] ) ;

						bank_robbery_time [ _team ] = 600 ;
						bank_robbery_timer [ _team ] = SetTimerEx ( "timer_bank_robbery", 1000, true, "i", _team ) ;

						foreach(new i: robbery_team[_team])
						{
							PlayerTextDrawSetString ( i, robbery_ptd [ i ] [ 9 ], "+" ) ;
						}

						static const _str [ ] = "* [ROBBERY] %s[%d] угнал(а) транспорт! Задачи обновлены. (/ba_robbery)" ;
                        new line_string [ sizeof _str + 24 + 4 ] ;
						format ( line_string, sizeof line_string, _str, p_info [ playerid ] [ name ], playerid ) ;
						robbery_message ( _team, col_lblue, line_string ) ;
					}
					action_td_status ( playerid, false ) ;
					return 1 ;
				}
			}

			new engine, lights, alarm, doors, bonnet, boot, objective ;
			GetVehicleParamsEx ( veh_id, engine, lights, alarm, doors, bonnet, boot, objective ) ;

			SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Место утилизации автомобиля отмечено у Вас на карте." ) ;

			new _position = random ( MAX_URGENT_POSITION ) ;
			SetPlayerRaceCheckpoint ( playerid, 1, urgent_position [ _position ] [ 0 ], urgent_position [ _position ] [ 1 ], urgent_position [ _position ] [ 2 ], 0.0, 0.0, 0.0, 5 ) ;
			is_gps_used { playerid } = 2 ;

			if ( p_t_info [ playerid ] [ c_pos_toggled ] != -1 )
			{
				if ( p_info [ playerid ] [ jackcar_skill ] < 51 ) ls_place_toggled [ p_t_info [ playerid ] [ c_pos_toggled ] ] = false ;
				else if ( p_info [ playerid ] [ jackcar_skill ] > 50 && p_info [ playerid ] [ jackcar_skill ] < 101 ) sf_place_toggled [ p_t_info [ playerid ] [ c_pos_toggled ] ] = false ;
				else if ( p_info [ playerid ] [ jackcar_skill ] > 100 && p_info [ playerid ] [ jackcar_skill ] < 151 ) lv_place_toggled [ p_t_info [ playerid ] [ c_pos_toggled ] ] = false ;
				else premium_place_toggled [ p_t_info [ playerid ] [ c_pos_toggled ] ] = false ;
				p_t_info [ playerid ] [ c_pos_toggled ] = -1 ;
			}
			action_td_status ( playerid, false ) ;
		}
		case ACTION_JACK_IN_CAR:
		{
			new vid = GetPVarInt ( playerid, "CarJack" ) ;
			new engine, lights, alarm, doors, bonnet, boot, objective ;
			GetVehicleParamsEx ( vid, engine, lights, alarm, doors, bonnet, boot, objective ) ;

			if ( engine == VEHICLE_PARAMS_UNSET || engine == VEHICLE_PARAMS_OFF )
			{
				if ( veh_info [ vid - 1 ] [ v_fuel ] < 1 )
				{
					SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас закончилось топливо в автомобиле. Используйте {"#cWH"}'/service'{"#cGRInfo"} чтобы вызвать механика!" ) ;
					return SetVehicleParamsEx ( vid, VEHICLE_PARAMS_OFF, lights, alarm, doors, bonnet, boot, objective ) ;
				}
				else SetVehicleParamsEx ( vid, VEHICLE_PARAMS_ON, lights, alarm, doors, bonnet, boot, objective ) ;

				me_action( playerid, "завел(а) двигатель" ) ;
				speedometr_status ( playerid, true ) ;

				if ( player_device { playerid } != 2 )
				{
					PlayerTextDrawHide ( playerid, ptd_sp [ playerid ] [ 2 ] ) ;
					PlayerTextDrawColor ( playerid, ptd_sp [ playerid ] [ 2 ], 8388863 ) ;
					PlayerTextDrawShow ( playerid, ptd_sp [ playerid ] [ 2 ] ) ;
				}
			}

			SendClientMessage ( playerid, col_gray, !"{"#cGInfo"}* {"#cGRInfo"}Вы успешно завели т/с." ) ;
			SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Место утилизации автомобиля отмечено у Вас на карте." ) ;

			new _position = random ( MAX_URGENT_POSITION ) ;
			SetPlayerRaceCheckpoint ( playerid, 1, urgent_position [ _position ] [ 0 ], urgent_position [ _position ] [ 1 ], urgent_position [ _position ] [ 2 ], 0.0, 0.0, 0.0, 5 ) ;
			is_gps_used { playerid } = 2 ;

			if ( p_t_info [ playerid ] [ c_pos_toggled ] != -1 )
			{
	            if ( p_info [ playerid ] [ jackcar_skill ] < 51 ) ls_place_toggled [ p_t_info [ playerid ] [ c_pos_toggled ] ] = false ;
				else if ( p_info [ playerid ] [ jackcar_skill ] > 50 && p_info [ playerid ] [ jackcar_skill ] < 101 ) sf_place_toggled [ p_t_info [ playerid ] [ c_pos_toggled ] ] = false ;
				else if ( p_info [ playerid ] [ jackcar_skill ] > 100 && p_info [ playerid ] [ jackcar_skill ] < 151 ) lv_place_toggled [ p_t_info [ playerid ] [ c_pos_toggled ] ] = false ;
				else premium_place_toggled [ p_t_info [ playerid ] [ c_pos_toggled ] ] = false ;
				p_t_info [ playerid ] [ c_pos_toggled ] = -1 ;
			}

			action_td_status ( playerid, false ) ;
		}
		case ACTION_GRAFFITY:
		{
			new object ;
			switch ( p_info [ playerid ] [ member ] )
			{
				case 0: object = 1525 ;
				case 18: object = 18659 ;
				case 22: object = 18661 ;
				case 21: object = 18663 ;
				case 19: object = 18664 ;
				case 20: object = 18665 ;
			}

			new _gr_id = p_t_info [ playerid ] [ graffity ] ;
			DestroyDynamicObject ( graf_info [ _gr_id ] [ g_object ] ) ;
			graf_info [ _gr_id ] [ g_object ] = CreateDynamicObject ( object, graf_info [ _gr_id ] [ gr_x ] [ 0 ],
																			graf_info [ _gr_id ] [ gr_x ] [ 1 ],
																			graf_info [ _gr_id ] [ gr_x ] [ 2 ],
																			graf_info [ _gr_id ] [ gr_x ] [ 3 ],
																			graf_info [ _gr_id ] [ gr_x ] [ 4 ],
																			graf_info [ _gr_id ] [ gr_x ] [ 5 ] ) ;
			graf_info [ _gr_id ] [ g_member ] = p_info [ playerid ] [ member ] ;

			GameTextForPlayer ( playerid, "~y~READY", 3000, 3 ) ;
			ClearAnimations ( playerid ) ;

			new sql_string [ 69 + 9 + 9 ] ;
			format ( sql_string, sizeof sql_string, "UPDATE `grafity` SET `g_member` = '%d' WHERE `g_id` = '%d' LIMIT 1", graf_info [ _gr_id ] [ g_member ], graf_info [ _gr_id ] [ g_id ] ) ;
			mysql_tquery ( sql_connection, sql_string, "", "" ) ;

			p_t_info [ playerid ] [ graffity ] = -1 ;

			checking_getto_quest_progress ( playerid, 0, 1 ) ;

			action_td_status ( playerid, false ) ;
		}
		case ACTION_FAM_GRAFFITY:
		{
			#if defined m_familys
			    graffity_painted ( playerid ) ;
			#endif
		}
		case ACTION_PLANT:
		{
			if ( IsPlayerAttachedObjectSlotUsed ( playerid, 0 ) ) RemovePlayerAttachedObject ( playerid, 0 ) ;
			SetPlayerAttachedObject ( playerid, 0, 3013, 6,0.0,0.10,-0.2, -110.0,0.0,78.0 ) ;
			have_box [ playerid ] = true ;

			SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы взяли ящик с патронами. Отнесите и положите его в фургон." ) ;
			SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}У задних дверей фургона нажмите 'Y' для того, чтобы положить ящик с патронами." ) ;
			ClearAnimations ( playerid ) ;
			p_t_info [ playerid ] [ p_animation ] = true ;
			ApplyAnimation(playerid,"CARRY","crry_prtial", 4.1, 0, 1, 1, 1, 1 ) ;

			checking_mafia_quest_progress ( playerid, 0, 1 ) ;

			DisablePlayerCheckpoint ( playerid ) ;

			action_td_status ( playerid, false ) ;
		}
		case ACTION_BANK:
		{
			new _team = p_t_info [ playerid ] [ t_robbery ] ;
			if ( _team != -1 )
			{
				for ( new i = 0 ; i < MAX_BANKS ; i ++ )
				{
					if ( IsPlayerInRangeOfPoint ( playerid, 5, robbery_doors [ i ] [ 0 ], robbery_doors [ i ] [ 1 ], robbery_doors [ i ] [ 2 ] ) && GetPlayerVirtualWorld ( playerid ) == bank_world [ _team ] )
					{
						robbery_door_open [ i ] = true ;

						#if defined SAMP
						MoveDynamicObject ( robbery_door [ i ], robbery_doors [ i ] [ 0 ], robbery_doors [ i ] [ 1 ], robbery_doors [ i ] [ 2 ] - 5, 2.0, robbery_doors [ i ] [ 3 ], robbery_doors [ i ] [ 4 ], robbery_doors [ i ] [ 5 ] ) ;
						#endif

						for ( new d = 0 ; d < sizeof bank_robbery_area ; d ++ )
						{
							bank_robbery_area [ i ] [ d ] = CreateDynamicSphere ( bank_robbery_pick [ d ] [ 0 ], bank_robbery_pick [ d ] [ 1 ], bank_robbery_pick [ d ] [ 2 ], 2.0, bank_world [ i ], -1, -1 ) ;
							area_info [ bank_robbery_area [ i ] [ d ] ] [ a_type ] = area_type_bank_robbery ;
							bank_robbery_pickup [ i ] [ d ] = CreateDynamicPickup ( 1212, 23, bank_robbery_pick [ d ] [ 0 ], bank_robbery_pick [ d ] [ 1 ], bank_robbery_pick [ d ] [ 2 ], -1, bank_world [ i ] ) ;
						}

	                    SetTimerEx("robbery_door_close", 60000 * 15, 0, "iii", playerid, robbery_door [ i ], i ) ;
						break ;
					}
				}

				foreach(new t: robbery_team[_team])
				{
					suspect_player ( t, "Взлом хранилища", 3 ) ;
				}
			}

			action_td_status ( playerid, false ) ;
		}
		case ACTION_PRISON_ELECTRIC:
		{
		    #if defined m_prison
		        check_electric_status ( playerid ) ;
			#endif
		}
	}

	action_step { playerid } = 0 ;
	action_td_status ( playerid, false ) ;
	return 1 ;
}

stock GetCoordBootVehicle ( vehicleid, & Float:x, & Float:y, & Float:z)
{
    new Float:angle,Float:distance;
    GetVehicleModelInfo(GetVehicleModel(vehicleid), 1, x, distance, z ) ;
    distance = distance/2 + 0.1;
    GetVehiclePos(vehicleid, x, y, z ) ;
    GetVehicleZAngle(vehicleid, angle ) ;
    x += (distance * floatsin(-angle+180, degrees) ) ;
    y += (distance * floatcos(-angle+180, degrees) ) ;
    return 1 ;
}

stock fraction_message ( fraction_stk, color, text [ ] )
{
	foreach(new i: fraction_players[fraction_stk])
	{
	    if ( ( p_info [ i ] [ member ] == fraction_stk ) && p_info [ i ] [ settings ] [ 0 ] != 0 ) SendClientMessage ( i, color, text ) ;
	}

	foreach(new i: admin_players)
	{
	    if ( is_control_chat { i } == fraction_stk ) SendClientMessage ( i, color, text ) ;
	}

	foreach(new i: fraction_players[7])
	{
	    if ( is_fraction_cover { i } == fraction_stk ) SendClientMessage ( i, color, text ) ;
	}

	foreach(new i: fraction_ministry)
	{
	    if ( player_ssf { i } == fraction_stk ) SendClientMessage ( i, color, text ) ;
	}
	return 1 ;
}

stock business_message ( business_stk, color, text [ ] )
{
	foreach(new i: business_players[business_stk])
	{
	    SendClientMessage ( i, color, text ) ;
	}
	return 1 ;
}

stock robbery_message ( robbery_stk, color, text [ ] )
{
	if ( robbery_stk == -1 ) return 1 ;
	foreach(new i: robbery_team[robbery_stk])
	{
	    SendClientMessage ( i, color, text ) ;
	}
	return 1 ;
}

stock admin_message ( params_stk, color, text [ ] )
{
    foreach(new i: admin_players)
	{
	    if ( ! admin_info [ i ] [ admin_settings ] [ params_stk ] ) continue ;
		SendClientMessage ( i, color, text ) ;
	}
	return 1 ;
}

stock dice_ptd_status ( playerid, bool:status )
{
	if ( status )
	{
	 	new table [ 24 ], _b_id = GetPVarInt ( playerid, "p_biz_id" ), _stol_id = player_dice_table { playerid } - 1 ;
		if ( _stol_id + 1 == 1 ) table = "DICE_TABLE_1" ;
		else if ( _stol_id + 1 == 2 ) table = "DICE_TABLE_2" ;
		else if ( _stol_id + 1 == 3 ) table = "DICE_TABLE_3" ;
		else if ( _stol_id + 1 == 4 ) table = "DICE_TABLE_4" ;

		new Player1 [ MAX_PLAYER_NAME + 4 ], Player2 [ MAX_PLAYER_NAME + 4 ], Player3 [ MAX_PLAYER_NAME + 4 ], Player4 [ MAX_PLAYER_NAME + 4 ], Player5 [ MAX_PLAYER_NAME + 4 ] ;
	    if ( dice_info [ _b_id ] [ _stol_id ] [ b_player ] [ 0 ] == INVALID_PLAYER_ID )
		{
			if ( ! player_croupier [ playerid ] ) dice_info [ _b_id ] [ _stol_id ] [ b_player ] [ 0 ] = playerid, format ( Player1, sizeof ( Player1 ), "1. %s", p_info [ dice_info [ _b_id ] [ _stol_id ] [ b_player ] [ 0 ] ] [ name ] ) ;
			else if ( player_croupier [ playerid ] ) format ( Player1, sizeof ( Player1 ), "1. -----" ) ;
		}
		else if ( dice_info [ _b_id ] [ _stol_id ] [ b_player ] [ 0 ] != playerid ) format ( Player1, sizeof ( Player1 ), "1. %s", p_info [ dice_info [ _b_id ] [ _stol_id ] [ b_player ] [ 0 ] ] [ name ] ) ;
		else if ( dice_info [ _b_id ] [ _stol_id ] [ b_player ] [ 0 ] == INVALID_PLAYER_ID ) format ( Player1, sizeof ( Player1 ), "1. -----" ) ;

		if ( dice_info [ _b_id ] [ _stol_id ] [ b_player ] [ 1 ] == INVALID_PLAYER_ID && dice_info [ _b_id ] [ _stol_id ] [ b_player ] [ 0 ] != playerid )
		{
			if ( ! player_croupier [ playerid ] ) dice_info [ _b_id ] [ _stol_id ] [ b_player ] [ 1 ] = playerid, format ( Player2, sizeof ( Player2 ), "2. %s", p_info [ dice_info [ _b_id ] [ _stol_id ] [ b_player ] [ 1 ] ] [ name ] ) ;
	        else if ( player_croupier [ playerid ] ) format ( Player2, sizeof ( Player2 ), "2. -----" ) ;
		}
		else if ( dice_info [ _b_id ] [ _stol_id ] [ b_player ] [ 1 ] != playerid && dice_info [ _b_id ] [ _stol_id ] [ b_player ] [ 1 ] != INVALID_PLAYER_ID ) format ( Player2, sizeof ( Player2 ), "2. %s", p_info [ dice_info [ _b_id ] [ _stol_id ] [ b_player ] [ 1 ] ] [ name ] ) ;
		else if ( dice_info [ _b_id ] [ _stol_id ] [ b_player ] [ 1 ] == INVALID_PLAYER_ID ) format ( Player2, sizeof ( Player2 ), "2. -----" ) ;

		if ( dice_info [ _b_id ] [ _stol_id ] [ b_player ] [ 2 ] == INVALID_PLAYER_ID && dice_info [ _b_id ] [ _stol_id ] [ b_player ] [ 0 ] != playerid && dice_info [ _b_id ] [ _stol_id ] [ b_player ][ 1 ] != playerid )
		{
			if ( ! player_croupier [ playerid ] ) dice_info [ _b_id ] [ _stol_id ] [ b_player ] [ 2 ] = playerid, format ( Player3, sizeof ( Player3 ), "3. %s", p_info [ dice_info [ _b_id ] [ _stol_id ] [ b_player ] [ 2 ] ] [ name ] ) ;
	        else if ( player_croupier [ playerid ] ) format ( Player3, sizeof ( Player3 ), "3. -----" ) ;
		}
		else if ( dice_info [ _b_id ] [ _stol_id ] [ b_player ] [ 2 ] != playerid && dice_info [ _b_id ] [ _stol_id ] [ b_player ] [ 2 ] != INVALID_PLAYER_ID) format ( Player3, sizeof ( Player3 ), "3. %s", p_info [ dice_info [ _b_id ] [ _stol_id ] [ b_player ] [ 2 ] ] [ name ] ) ;
		else if ( dice_info [ _b_id ] [ _stol_id ] [ b_player ] [ 2 ] == INVALID_PLAYER_ID ) format ( Player3, sizeof ( Player3 ), "3. -----" ) ;

		if ( dice_info [ _b_id ] [ _stol_id ] [ b_player ] [ 3 ] == INVALID_PLAYER_ID && dice_info [ _b_id ] [ _stol_id ] [ b_player ] [ 0 ] != playerid && dice_info [ _b_id ] [ _stol_id ] [ b_player ] [ 1 ] != playerid && dice_info [ _b_id ] [ _stol_id ] [ b_player ] [ 2 ] != playerid )
		{
			if ( ! player_croupier [ playerid ] ) dice_info [ _b_id ] [ _stol_id ] [ b_player ] [ 3 ] = playerid, format ( Player4, sizeof ( Player4 ), "4. %s", p_info [ dice_info [ _b_id ] [ _stol_id ] [ b_player ] [ 3 ] ] [ name ] ) ;
	        else if ( player_croupier [ playerid ] ) format ( Player4, sizeof ( Player4 ), "4. -----" ) ;
		}
		else if ( dice_info [ _b_id ] [ _stol_id ] [ b_player ] [ 3 ] != playerid && dice_info  [ _b_id ] [ _stol_id ] [ b_player ] [ 3 ] != INVALID_PLAYER_ID ) format ( Player4, sizeof ( Player4 ), "4. %s", p_info [ dice_info [ _b_id ] [ _stol_id ] [ b_player ] [ 3 ] ] [ name ] ) ;
		else if ( dice_info [ _b_id ] [ _stol_id ] [ b_player ] [ 3 ] == INVALID_PLAYER_ID ) format ( Player4, sizeof ( Player4 ), "4. -----" ) ;

		if ( dice_info [ _b_id ] [ _stol_id ] [ b_player ] [ 4 ] == INVALID_PLAYER_ID && dice_info [ _b_id ] [ _stol_id ] [ b_player ] [ 0 ] != playerid && dice_info [ _b_id ] [ _stol_id ] [ b_player ][ 1 ] != playerid && dice_info [ _b_id ] [ _stol_id ] [ b_player ][ 2 ] != playerid && dice_info [ _b_id ] [ _stol_id ] [ b_player ][ 3 ] != playerid )
		{
			if ( ! player_croupier [ playerid ] ) dice_info [ _b_id ] [ _stol_id ] [ b_player ] [ 4 ] = playerid, format ( Player5, sizeof ( Player5 ), "5. %s", p_info [ dice_info [ _b_id ] [ _stol_id ] [ b_player ] [ 4 ] ] [ name ] ) ;
	        else if ( player_croupier [ playerid ] ) format ( Player5, sizeof ( Player5 ), "5. -----" ) ;
		}
		else if ( dice_info [ _b_id ] [ _stol_id ] [ b_player ] [ 4 ] != playerid && dice_info [ _b_id ] [ _stol_id ] [ b_player ] [ 4 ] != INVALID_PLAYER_ID ) format ( Player5, sizeof ( Player5 ), "5. %s", p_info [ dice_info [ _b_id ] [ _stol_id ] [ b_player ] [ 4 ] ] [ name ] ) ;
		else if ( dice_info [ _b_id ] [ _stol_id ] [ b_player ] [ 4 ] == INVALID_PLAYER_ID ) format ( Player5, sizeof ( Player5 ), "5. -----" ) ;

		if ( player_device { playerid } == 2 )
		{
			if ( player_croupier [ playerid ] )
			{
				updateCasinoButton ( playerid, "КРУТИТЬ" ) ;

				new biz_id = GetPVarInt ( playerid, "p_biz_id" ),
					_table = player_dice_table { playerid },
					null = 0 ;

				for ( new i = 0 ; i < 5 ; i++ ) if ( GetPVarInt ( dice_info [ biz_id ] [ _table - 1 ] [ b_player ] [ i ], "InGame" ) ) null ++ ;
				if ( null > 0 )
				{
					SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}В данный момент вы не можете изменить ставку." ) ;
					ExitBone ( playerid ) ;
				}
				show_dialog ( playerid, d_dice_bet, DIALOG_STYLE_INPUT, "{"#cBHD"}Установка ставки для игры","{ffffff}Введите сумму для ставки\n\n{"#cGRDialog"}* Ставка должна быть не менее 1.000"valute_title_" и не более 300.000.000"valute_title_"","Далее","Отмена");
			}
			else updateCasinoButton ( playerid, "ПОСТАВИТЬ" ) ;
			toggle_controlable ( playerid, false ) ;
		}
		else
		{
		    dice_ptd[playerid][11] = CreatePlayerTextDraw(playerid, 556.6666, 119.5664, table); // пусто
			PlayerTextDrawLetterSize(playerid, dice_ptd[playerid][11], 0.2578, 1.0522);
			PlayerTextDrawAlignment(playerid, dice_ptd[playerid][11], 2);
			PlayerTextDrawColor(playerid, dice_ptd[playerid][11], color_server);
			PlayerTextDrawBackgroundColor(playerid, dice_ptd[playerid][11], 255);
			PlayerTextDrawFont(playerid, dice_ptd[playerid][11], 1);
			PlayerTextDrawSetProportional(playerid, dice_ptd[playerid][11], 1);
			PlayerTextDrawSetShadow(playerid, dice_ptd[playerid][11], 0);

		  	dice_ptd[playerid][0] = CreatePlayerTextDraw(playerid, 549.8681, 147.1885, Player1); // First Player
			PlayerTextDrawLetterSize(playerid, dice_ptd[playerid][0], 0.1333, 0.9569);
			PlayerTextDrawAlignment(playerid, dice_ptd[playerid][0], 2);
			PlayerTextDrawColor(playerid, dice_ptd[playerid][0], -2139062017);
			PlayerTextDrawBackgroundColor(playerid, dice_ptd[playerid][0], 255);
			PlayerTextDrawFont(playerid, dice_ptd[playerid][0], 2);
			PlayerTextDrawSetProportional(playerid, dice_ptd[playerid][0], 1);
			PlayerTextDrawSetShadow(playerid, dice_ptd[playerid][0], 0);

			dice_ptd[playerid][1] = CreatePlayerTextDraw(playerid, 592.3662, 146.3179, "0"); // First Player
			PlayerTextDrawLetterSize(playerid, dice_ptd[playerid][1], 0.1799, 1.1395);
			PlayerTextDrawAlignment(playerid, dice_ptd[playerid][1], 2);
			PlayerTextDrawColor(playerid, dice_ptd[playerid][1], color_black_box);
			PlayerTextDrawBackgroundColor(playerid, dice_ptd[playerid][1], 255);
			PlayerTextDrawFont(playerid, dice_ptd[playerid][1], 2);
			PlayerTextDrawSetProportional(playerid, dice_ptd[playerid][1], 1);
			PlayerTextDrawSetShadow(playerid, dice_ptd[playerid][1], 0);

			dice_ptd[playerid][2] = CreatePlayerTextDraw(playerid, 549.8681, 169.4900, Player2); // Second Player
			PlayerTextDrawLetterSize(playerid, dice_ptd[playerid][2], 0.1333, 0.9569);
			PlayerTextDrawAlignment(playerid, dice_ptd[playerid][2], 2);
			PlayerTextDrawColor(playerid, dice_ptd[playerid][2], -2139062017);
			PlayerTextDrawBackgroundColor(playerid, dice_ptd[playerid][2], 255);
			PlayerTextDrawFont(playerid, dice_ptd[playerid][2], 2);
			PlayerTextDrawSetProportional(playerid, dice_ptd[playerid][2], 1);
			PlayerTextDrawSetShadow(playerid, dice_ptd[playerid][2], 0);

			dice_ptd[playerid][3] = CreatePlayerTextDraw(playerid, 592.3662, 168.6195, "0"); // Second Player
			PlayerTextDrawLetterSize(playerid, dice_ptd[playerid][3], 0.1799, 1.1395);
			PlayerTextDrawAlignment(playerid, dice_ptd[playerid][3], 2);
			PlayerTextDrawColor(playerid, dice_ptd[playerid][3], color_black_box);
			PlayerTextDrawBackgroundColor(playerid, dice_ptd[playerid][3], 255);
			PlayerTextDrawFont(playerid, dice_ptd[playerid][3], 2);
			PlayerTextDrawSetProportional(playerid, dice_ptd[playerid][3], 1);
			PlayerTextDrawSetShadow(playerid, dice_ptd[playerid][3], 0);

			dice_ptd[playerid][4] = CreatePlayerTextDraw(playerid, 549.8681, 190.9913, Player3); // Three Player
			PlayerTextDrawLetterSize(playerid, dice_ptd[playerid][4], 0.1333, 0.9569);
			PlayerTextDrawAlignment(playerid, dice_ptd[playerid][4], 2);
			PlayerTextDrawColor(playerid, dice_ptd[playerid][4], -2139062017);
			PlayerTextDrawBackgroundColor(playerid, dice_ptd[playerid][4], 255);
			PlayerTextDrawFont(playerid, dice_ptd[playerid][4], 2);
			PlayerTextDrawSetProportional(playerid, dice_ptd[playerid][4], 1);
			PlayerTextDrawSetShadow(playerid, dice_ptd[playerid][4], 0);

			dice_ptd[playerid][5] = CreatePlayerTextDraw(playerid, 592.3662, 190.1208, "0"); // Three Player
			PlayerTextDrawLetterSize(playerid, dice_ptd[playerid][5], 0.1799, 1.1395);
			PlayerTextDrawAlignment(playerid, dice_ptd[playerid][5], 2);
			PlayerTextDrawColor(playerid, dice_ptd[playerid][5], color_black_box);
			PlayerTextDrawBackgroundColor(playerid, dice_ptd[playerid][5], 255);
			PlayerTextDrawFont(playerid, dice_ptd[playerid][5], 2);
			PlayerTextDrawSetProportional(playerid, dice_ptd[playerid][5], 1);
			PlayerTextDrawSetShadow(playerid, dice_ptd[playerid][5], 0);

			dice_ptd[playerid][6] = CreatePlayerTextDraw(playerid, 549.8681, 212.4927, Player4); // Four Player
			PlayerTextDrawLetterSize(playerid, dice_ptd[playerid][6], 0.1333, 0.9569);
			PlayerTextDrawAlignment(playerid, dice_ptd[playerid][6], 2);
			PlayerTextDrawColor(playerid, dice_ptd[playerid][6], -2139062017);
			PlayerTextDrawBackgroundColor(playerid, dice_ptd[playerid][6], 255);
			PlayerTextDrawFont(playerid, dice_ptd[playerid][6], 2);
			PlayerTextDrawSetProportional(playerid, dice_ptd[playerid][6], 1);
			PlayerTextDrawSetShadow(playerid, dice_ptd[playerid][6], 0);

			dice_ptd[playerid][7] = CreatePlayerTextDraw(playerid, 592.3662, 211.6221, "0"); // Four Player
			PlayerTextDrawLetterSize(playerid, dice_ptd[playerid][7], 0.1799, 1.1395);
			PlayerTextDrawAlignment(playerid, dice_ptd[playerid][7], 2);
			PlayerTextDrawColor(playerid, dice_ptd[playerid][7], color_black_box);
			PlayerTextDrawBackgroundColor(playerid, dice_ptd[playerid][7], 255);
			PlayerTextDrawFont(playerid, dice_ptd[playerid][7], 2);
			PlayerTextDrawSetProportional(playerid, dice_ptd[playerid][7], 1);
			PlayerTextDrawSetShadow(playerid, dice_ptd[playerid][7], 0);

			dice_ptd[playerid][8] = CreatePlayerTextDraw(playerid, 549.8681, 235.3941, Player5); // Five Player
			PlayerTextDrawLetterSize(playerid, dice_ptd[playerid][8], 0.1333, 0.9569);
			PlayerTextDrawAlignment(playerid, dice_ptd[playerid][8], 2);
			PlayerTextDrawColor(playerid, dice_ptd[playerid][8], -2139062017);
			PlayerTextDrawBackgroundColor(playerid, dice_ptd[playerid][8], 255);
			PlayerTextDrawFont(playerid, dice_ptd[playerid][8], 2);
			PlayerTextDrawSetProportional(playerid, dice_ptd[playerid][8], 1);
			PlayerTextDrawSetShadow(playerid, dice_ptd[playerid][8], 0);

			dice_ptd[playerid][9] = CreatePlayerTextDraw(playerid, 592.3662, 234.5234, "0"); // Five Player
			PlayerTextDrawLetterSize(playerid, dice_ptd[playerid][9], 0.1799, 1.1395);
			PlayerTextDrawAlignment(playerid, dice_ptd[playerid][9], 2);
			PlayerTextDrawColor(playerid, dice_ptd[playerid][9], color_black_box);
			PlayerTextDrawBackgroundColor(playerid, dice_ptd[playerid][9], 255);
			PlayerTextDrawFont(playerid, dice_ptd[playerid][9], 2);
			PlayerTextDrawSetProportional(playerid, dice_ptd[playerid][9], 1);
			PlayerTextDrawSetShadow(playerid, dice_ptd[playerid][9], 0);

			new string [ 64 ] ;
			format ( string, sizeof string, "BET:_%d$~N~BANK:_%d$~n~MONEY:_%d$", dice_info [ _b_id ] [ _stol_id ] [ b_bet ], dice_info [ _b_id ] [ _stol_id ] [ b_bank ], p_info [ playerid ] [ money ] ) ;
			dice_ptd[playerid][10] = CreatePlayerTextDraw(playerid, 557.3997, 260.7149, string); // пусто
			PlayerTextDrawLetterSize(playerid, dice_ptd[playerid][10], 0.1659, 0.9983);
			PlayerTextDrawAlignment(playerid, dice_ptd[playerid][10], 2);
			PlayerTextDrawColor(playerid, dice_ptd[playerid][10], color_textdraw);
			PlayerTextDrawBackgroundColor(playerid, dice_ptd[playerid][10], 255);
			PlayerTextDrawFont(playerid, dice_ptd[playerid][10], 2);
			PlayerTextDrawSetProportional(playerid, dice_ptd[playerid][10], 1);
			PlayerTextDrawSetShadow(playerid, dice_ptd[playerid][10], 0);

			for ( new i = 0 ; i < 70 ; i ++ )
			{
			    TextDrawShowForPlayer ( playerid, dice_td [ i ] ) ;

				if ( i < 12 ) PlayerTextDrawShow(playerid, dice_ptd [ playerid ] [ i ] ) ;
			}
		}

		SelectTextDraw ( playerid, 0xB0C4DEFF ) ;
		return 1 ;
	}
	else
	{
		if ( player_device { playerid } == 2 )
	    {
			onServerDestroy ( playerid, UI_CASINO_DICE ) ;
			toggle_controlable ( playerid, true ) ;
	    }
	    else
	    {
	        for ( new i = 0 ; i < 70 ; i ++ )
			{
			    TextDrawHideForPlayer ( playerid, dice_td [ i ] ) ;

			    if ( i < 12 )
			    {
					PlayerTextDrawDestroy ( playerid, dice_ptd [ playerid ] [ i ] ) ;
					dice_ptd [ playerid ] [ i ] = PlayerText:-1 ;
				}
			}
	    }

		player_dice_table { playerid } = 0 ;
		DeletePVar ( playerid, "InGame" ) ;
		CancelSelectTextDraw ( playerid ) ;
	}
	return true ;
}

stock ExitBone ( playerid )
{
	new null [ 2 ] = 0, biz_id = GetPVarInt ( playerid, "p_biz_id" ), stol_id = player_dice_table { playerid } ;

	if ( stol_id < 1 ) stol_id = IsPlayerNearDice ( playerid ) ;

	if ( GetPVarInt ( playerid, "InGame" ) && dice_info [ biz_id ] [ stol_id - 1 ] [ b_started ] <= 0 )
	{
		give_money ( playerid, dice_info [ biz_id ] [ stol_id - 1 ] [ b_bet ] ) ;
		dice_info [ biz_id ] [ stol_id - 1 ] [ b_bank ] -= dice_info [ biz_id ] [ stol_id - 1 ] [ b_bet ] ;
	}
	for ( new g = 0 ; g < MAX_PLAYER_DICE - 1 ; g ++ )
	{
		new i = dice_info [ biz_id ] [ stol_id - 1 ] [ b_player ] [ g ] ;
		if ( i < 0 || i == INVALID_PLAYER_ID || ! IsPlayerConnected ( i ) )
		{
		    dice_info [ biz_id ] [ stol_id - 1 ] [ b_player ] [ g ] = INVALID_PLAYER_ID ;
			continue ;
		}

		if ( player_dice_table { i } == stol_id && i != playerid && GetPVarInt ( i, "InGame" ) == 1 ) null [ 0 ] ++ ;
		if ( player_dice_table { i } == stol_id && i != playerid && GetPVarInt ( i, "InGame" ) > 1 ) null [ 1 ] ++ ;
	}
	if ( null [ 0 ] == 0 && null [ 1 ] > 0 ) ShowItog ( stol_id - 1, biz_id ) ;
	if ( dice_info [ biz_id ] [ stol_id - 1 ] [ b_crupie ] == playerid ) dice_info [ biz_id ] [ stol_id - 1 ] [ b_crupie ] = INVALID_PLAYER_ID ;
	for ( new i_ = 0 ; i_ != 5 ; i_++ ) if ( dice_info [ biz_id ] [ stol_id - 1  ][ b_player ] [ i_ ] == playerid ) dice_info [ biz_id ] [ stol_id - 1 ] [ b_player ] [ i_ ] = INVALID_PLAYER_ID ;
	update_bone ( stol_id - 1, biz_id ) ;
	update_bone_table ( biz_id, stol_id - 1 ) ;

	dice_ptd_status ( playerid, false ) ;
	return true ;
}

stock update_bone_table ( biz_id, _table )
{
    global_string [ 0 ] = EOS ;

    new Gambler_1 [ MAX_PLAYER_NAME ],
        Gambler_2 [ MAX_PLAYER_NAME ],
        Gambler_3 [ MAX_PLAYER_NAME ],
        Gambler_4 [ MAX_PLAYER_NAME ],
        Gambler_5 [ MAX_PLAYER_NAME ],
		_Croupie [ MAX_PLAYER_NAME ],
		_c_status [ 48 ] ;

	if ( ! dice_info [ biz_id ] [ _table ] [ b_started ] ) _c_status = "{"#cRD"}Игра не начата" ;
	else format ( _c_status, sizeof _c_status, "{"#cLY"}%d сек.", dice_info [ biz_id ] [ _table ] [ b_started ] ) ;

    if ( dice_info [ biz_id ] [ _table ] [ b_crupie ] == INVALID_PLAYER_ID ) format ( _Croupie, sizeof _Croupie, "-" ) ;
    else format ( _Croupie, sizeof _Croupie, "%s", p_info [ dice_info [ biz_id ] [ _table ] [ b_crupie ] ] [ name ] ) ;

    if ( dice_info [ biz_id ] [ _table ] [ b_player ] [ 0 ] == INVALID_PLAYER_ID ) format ( Gambler_1, sizeof Gambler_1, "-" ) ;
	else format ( Gambler_1, sizeof Gambler_1, "%s", p_info [ dice_info [ biz_id ] [ _table ] [ b_player ] [ 0 ] ] [ name ] ) ;

    if ( dice_info [ biz_id ] [ _table ] [ b_player ] [ 1 ] == INVALID_PLAYER_ID ) format ( Gambler_2, sizeof Gambler_2, "-" ) ;
	else format ( Gambler_2, sizeof Gambler_2, "%s", p_info [ dice_info [ biz_id ] [ _table ] [ b_player ] [ 1 ] ] [ name ] ) ;

    if ( dice_info [ biz_id ] [ _table ] [ b_player ] [ 2 ] == INVALID_PLAYER_ID ) format ( Gambler_3, sizeof Gambler_3, "-" ) ;
	else format ( Gambler_3, sizeof Gambler_3, "%s", p_info [ dice_info [ biz_id ] [ _table ] [ b_player ] [ 2 ] ] [ name ] ) ;

    if ( dice_info [ biz_id ] [ _table ] [ b_player ] [ 3 ] == INVALID_PLAYER_ID ) format ( Gambler_4, sizeof Gambler_4, "-" ) ;
	else format ( Gambler_4, sizeof Gambler_4, "%s", p_info [ dice_info [ biz_id ] [ _table ] [ b_player ] [ 3 ] ] [ name ] ) ;

    if ( dice_info [ biz_id ] [ _table ] [ b_player ] [ 4 ] == INVALID_PLAYER_ID ) format ( Gambler_5, sizeof Gambler_5, "-" ) ;
	else format ( Gambler_5, sizeof Gambler_5, "%s", p_info [ dice_info [ biz_id ] [ _table ] [ b_player ] [ 4 ] ] [ name ] ) ;

	#if defined Computer
	format ( global_string, 512, "** Кости **\n\
								{"#cGR3D"}Нажмите {"#cWH3D"}F{"#cGR3D"} для взаимодействия\n\n\
								{"#cGR3D"}Крупье: {"#cWH3D"}%s\n\n\
								{"#cGR3D"}Игрок 1: {"#cWH3D"}%s\n\
								{"#cGR3D"}Игрок 2: {"#cWH3D"}%s\n\
								{"#cGR3D"}Игрок 3: {"#cWH3D"}%s\n\
								{"#cGR3D"}Игрок 4: {"#cWH3D"}%s\n\
								{"#cGR3D"}Игрок 5: {"#cWH3D"}%s\n\n\
								{"#cGR3D"}Ставка: {"#cGN3D"}%d"valute_title_"\n\
								{"#cGR3D"}Банк: {"#cGN3D"}%d"valute_title_"\n\n\
								{"#cGR3D"}Статус: %s", _Croupie, Gambler_1, Gambler_2, Gambler_3, Gambler_4, Gambler_5,
								dice_info [ biz_id ] [ _table ] [ b_bet ], dice_info [ biz_id ] [ _table ] [ b_bank ], _c_status ) ;
	#else
	format ( global_string, 512, "** Кости **\n\
								{"#cGR3D"}Крупье: {"#cWH3D"}%s\n\n\
								{"#cGR3D"}Игрок 1: {"#cWH3D"}%s\n\
								{"#cGR3D"}Игрок 2: {"#cWH3D"}%s\n\
								{"#cGR3D"}Игрок 3: {"#cWH3D"}%s\n\
								{"#cGR3D"}Игрок 4: {"#cWH3D"}%s\n\
								{"#cGR3D"}Игрок 5: {"#cWH3D"}%s\n\n\
								{"#cGR3D"}Ставка: {"#cGN3D"}%d"valute_title_"\n\
								{"#cGR3D"}Банк: {"#cGN3D"}%d"valute_title_"\n\n\
								{"#cGR3D"}Статус: %s", _Croupie, Gambler_1, Gambler_2, Gambler_3, Gambler_4, Gambler_5,
								dice_info [ biz_id ] [ _table ] [ b_bet ], dice_info [ biz_id ] [ _table ] [ b_bank ], _c_status ) ;
	#endif
	UpdateDynamic3DTextLabelText ( dice_info [ biz_id ] [ _table ] [ b_text ], col_header_3d, global_string ) ;
	return 1 ;
}

stock update_bone ( idx, b_idx )
{
	new i ;
	for ( new g = 0 ; g < MAX_PLAYER_DICE ; g ++ )
	{
		if ( g == MAX_PLAYER_DICE - 1 ) i = dice_info [ b_idx ] [ idx ] [ b_crupie ] ;
		else i = dice_info [ b_idx ] [ idx ] [ b_player ] [ g ] ;
		if ( ! IsPlayerConnected ( i ) || i < 0 || i == INVALID_PLAYER_ID ) continue ;

		if ( player_dice_table { i } - 1 == idx )
		{
		   	new td_str [ 64 ] ;
			if ( player_device { i } == 2 ) updateDiceChips ( i ) ;
			else
			{
				format ( td_str, sizeof td_str, "BET:_%d$~N~BANK:_%d$~n~MONEY:_%d$", dice_info [ b_idx ] [ idx ] [ b_bet ], dice_info [ b_idx ] [ idx ] [ b_bank ], p_info [ i ] [ money ] ) ;
            	PlayerTextDrawSetString ( i, dice_ptd [ i ] [ 10 ], td_str ) ;
			}

			for ( new i_ = 0 ; i_ < 5 ; i_ ++ )
			{
				if ( dice_info [ b_idx ] [ idx ] [ b_player ] [ i_ ] != INVALID_PLAYER_ID )
				{
					if ( player_device { i } == 2 ) update_window_place ( i, i_, b_idx, idx + 1 ) ;
					else
					{
					    format ( td_str, sizeof( td_str ), "%s", p_info [ dice_info [ b_idx ] [ idx ] [ b_player ] [ i_ ] ] [ name ] ) ;
						PlayerTextDrawSetString ( i, dice_ptd [ i ] [ i_ * 2 ], td_str ) ;

						new in_game_stat = GetPVarInt ( dice_info [ b_idx ] [ idx ] [ b_player ] [ i_ ], "InGame" ) ;
						if ( in_game_stat > 0 )
						{
						    PlayerTextDrawHide(i, dice_ptd [ i ] [ i_ * 2 ]);
							PlayerTextDrawColor(i, dice_ptd [ i ] [ i_ * 2 ], color_textdraw);
							PlayerTextDrawShow(i, dice_ptd [ i ] [ i_ * 2 ]);
						}
						else
						{
						    PlayerTextDrawHide(i, dice_ptd [ i ] [ i_ * 2 ]);
							PlayerTextDrawColor(i, dice_ptd [ i ] [ i_ * 2 ], -2139062017);
							PlayerTextDrawShow(i, dice_ptd [ i ] [ i_ * 2 ]);
						}

						if ( in_game_stat > 1 )
						{
							format ( td_str, sizeof( td_str ), "%d", in_game_stat ) ;
							PlayerTextDrawSetString ( i, dice_ptd [ i ] [ ( i_ * 2 ) + 1 ], td_str ) ;
						}
						else PlayerTextDrawSetString ( i, dice_ptd [ i ] [ ( i_ * 2 ) + 1 ], "0" ) ;
					}
				}
				else
				{
					if ( player_device { i } == 2 ) update_window_free_place ( i, i_, b_idx, idx + 1 ) ;
					else
					{
					    PlayerTextDrawSetString ( i, dice_ptd [ i ] [ i_ * 2 ], "-----" ) ;

						PlayerTextDrawHide(i, dice_ptd [ i ] [ i_ * 2 ]);
						PlayerTextDrawColor(i, dice_ptd [ i ] [ i_ * 2 ], -2139062017);
						PlayerTextDrawShow(i, dice_ptd [ i ] [ i_ * 2 ]);

						PlayerTextDrawSetString ( i, dice_ptd [ i ] [ ( i_ * 2 ) + 1 ], "0" ) ;
					}
				}
			}
		}
	}
	return true ;
}

callback: dice_timer ( businesses_id, table_id )
{
    if ( dice_info [ businesses_id ] [ table_id ] [ b_started ] > 0 )
	{
		dice_info [ businesses_id ] [ table_id ] [ b_started ] -- ;
		new gt_string [ 8 ] ;

		new g ;
		for ( new q = 0 ; q < MAX_PLAYER_DICE ; q ++ )
		{
			if ( q == MAX_PLAYER_DICE - 1 ) g = dice_info [ businesses_id ] [ table_id ] [ b_crupie ] ;
			else g = dice_info [ businesses_id ] [ table_id ] [ b_player ] [ q ] ;
			if ( ! IsPlayerConnected ( g ) ) continue ;

			if ( player_dice_table { g } - 1 == table_id && GetPVarInt ( g, "p_biz_id" ) == businesses_id && ( GetPVarInt ( g, "InGame" ) || dice_info [ businesses_id ] [ table_id ] [ b_crupie ] == g ) )
			{
				if ( dice_info [ businesses_id ] [ table_id ] [ b_started ] == 1 && GetPVarInt ( g, "InGame" ) == 1 )
				{
					SetPVarInt ( g, "InGame", random ( 11 ) + 2 ) ;
					update_bone ( table_id, businesses_id ) ;

					if ( player_device { g } == 2 )
					{
						format ( gt_string, sizeof gt_string, "%s", convert_time ( dice_info [ businesses_id ] [ table_id ] [ b_started ], TYPE_TIME_SECOND ) ) ;
						updateCasinoState ( g, gt_string ) ;
					}
					else
					{
					    format ( gt_string, 6, "~g~%i", dice_info [ businesses_id ] [ table_id ] [ b_started ] ) ;
						GameTextForPlayer ( g, gt_string, 1200, 6 ) ;
					}
				}
				else if ( dice_info [ businesses_id ] [ table_id ] [ b_started ] > 1 )
				{
					if ( player_device { g } == 2 )
					{
						format ( gt_string, sizeof gt_string, "%s", convert_time ( dice_info [ businesses_id ] [ table_id ] [ b_started ], TYPE_TIME_SECOND ) ) ;
						updateCasinoState ( g, gt_string ) ;
					}
					else
					{
					    format ( gt_string, 6, "~g~%i", dice_info [ businesses_id ] [ table_id ] [ b_started ] ) ;
						GameTextForPlayer ( g, gt_string, 1200, 6 ) ;
					}
     				update_bone_table ( businesses_id, table_id ) ;
				}
			}
		}

		if ( dice_info [ businesses_id ] [ table_id ] [ b_started ] == 0 ) ShowItog ( table_id, businesses_id ) ;
	}
	return 1 ;
}

stock ShowItog ( idx, b_idx )
{
	new itog [ 3 ] = -1 ;

	itog [ 0 ] = -1 ; itog [ 1 ] = -1 ; itog [ 2 ] = -1 ;
 	for ( new g = 0 ; g < MAX_PLAYER_DICE - 1 ; g ++ )
	{
		new i = dice_info [ b_idx ] [ idx ] [ b_player ] [ g ] ;
		if ( ! IsPlayerConnected ( i ) ) continue ;

		if ( player_dice_table { i } - 1 == idx && GetPVarInt ( i, "p_biz_id" ) == b_idx && GetPVarInt ( i, "InGame" ) > 1 && GetPVarInt ( i, "InGame" ) > itog [ 0 ] ) itog [ 0 ] = GetPVarInt ( i, "InGame" ), itog [ 1 ] = i ;
		if ( player_dice_table { i } - 1 == idx && GetPVarInt ( i, "p_biz_id" ) == b_idx && GetPVarInt ( i, "InGame" ) > 1 && i != itog [ 1 ] && GetPVarInt ( i, "InGame" ) == itog [ 0 ] ) itog [ 2 ] = i ;
	}
	if ( itog [ 2 ] > -1 )
	{
	    for ( new g = 0 ; g < MAX_PLAYER_DICE - 1 ; g ++ )
		{
			new i = dice_info [ b_idx ] [ idx ] [ b_player ] [ g ] ;
			if ( ! IsPlayerConnected ( i ) ) continue ;

			if ( player_dice_table { i } - 1 == idx && GetPVarInt ( i, "p_biz_id" ) == b_idx && GetPVarInt ( i, "InGame" ) > 1 && GetPVarInt ( i, "InGame" ) == itog [ 0 ] )
			{
				SetPVarInt ( i, "InGame", 1 ) ;
				dice_info [ b_idx ] [ idx ] [ b_started ] = 30 ;
				SendClientMessage ( i, col_casino, !"Вы попали в следующий раунд. У вас есть 30 секунд, чтобы бросить кости." ) ;
			}
			else if ( player_dice_table { i } - 1 == idx && GetPVarInt ( i, "p_biz_id" ) == b_idx )
			{
				DeletePVar ( i, "InGame" ) ;

				for ( new i_ = 0 ; i_ < 5 ; i_ ++ )
				{
					if ( dice_info [ b_idx ] [ idx ] [ b_player ] [ i_ ] == i )
					{
						dice_info [ b_idx ] [ idx ] [ b_player ] [ i_ ] = INVALID_PLAYER_ID ;
						update_bone ( idx, b_idx ) ;
						break ;
					}
				}
			}
		}
		update_bone ( idx, b_idx ) ;
	}
	else if ( itog [ 1 ] > -1 && dice_info [ b_idx ] [ idx ] [ b_bank ] > 0 )
	{
		new  string [ 65 + MAX_PLAYER_NAME + 2 + 9 ], for_casino_money = floatround ( ( dice_info [ b_idx ] [ idx ] [ b_bank ] * 0.01 ) / 100 ) ;
		format ( string, sizeof ( string ), "%s побеждает. Колличество очков: %i. Банк составил %d фишек.", p_info [ itog [ 1 ] ] [ name ], itog [ 0 ], dice_info [ b_idx ] [ idx ] [ b_bank ] ) ;
		if ( dice_info [ b_idx ] [ idx ] [ b_crupie ] != INVALID_PLAYER_ID )
		{
			new crupie_id = dice_info [ b_idx ] [ idx ] [ b_crupie ] ;
			give_inventory (
				crupie_id,
				ITEM_CASINO_CHIPS,
				for_casino_money,
				0,
				"",
				"",
				NUMBERPLATE_TYPE_NONE,
				0
			) ;
			insert_money_log ( crupie_id, INVALID_PLAYER_ID, for_casino_money, "крупье кости (сумма в фишках)" ) ;
		}

		new _count = dice_info [ b_idx ] [ idx ] [ b_bank ] - floatround ( ( dice_info [ b_idx ] [ idx ] [ b_bank ] * 20 ) / 100 ) ;
		give_inventory (
			itog [ 1 ],
			ITEM_CASINO_CHIPS,
			_count,
			0,
			"",
			"",
			NUMBERPLATE_TYPE_NONE,
			0
		) ;
		insert_money_log ( itog [ 1 ], INVALID_PLAYER_ID, _count, "победа кости (сумма в фишках)" ) ;
		update_activity_casino ( itog [ 1 ], GetPVarInt ( itog [ 1 ], "p_biz_id" ) - 1 ) ;

		new b = GetPVarInt ( itog [ 1 ], "p_biz_id" ) - 1, _b_bet = dice_info [ b_idx ] [ idx ] [ b_bet ] ;
		b_info [ b ] [ b_win_prise ] += for_casino_money ;
		give_bmoney ( b + 1, for_casino_money, 5 ) ;

		dice_info [ b_idx ] [ idx ] [ b_started ] =
		dice_info [ b_idx ] [ idx ] [ b_bet ] =
		dice_info [ b_idx ] [ idx ] [ b_bank ] = 0 ;

		if ( dice_info [ b_idx ] [ idx ] [ b_timer ] != -1 )
		{
		    KillTimer ( dice_info [ b_idx ] [ idx ] [ b_timer ] ) ;
		    dice_info [ b_idx ] [ idx ] [ b_timer ] = -1 ;
		}

		new i ;
		for ( new g = 0 ; g < MAX_PLAYER_DICE ; g ++ )
		{
		    if ( g == MAX_PLAYER_DICE - 1 ) i = dice_info [ b_idx ] [ idx ] [ b_crupie ] ;
			else i = dice_info [ b_idx ] [ idx ] [ b_player ] [ g ] ;
			if ( ! IsPlayerConnected ( i ) ) continue ;

            give_event_progress ( i, THE_CASINO, 1 ) ;

			DeletePVar ( i, "InGame" ) ;
			update_bone ( idx, b_idx ) ;
			SendClientMessage ( i, col_casino, string ) ;

			if ( player_dice_table { i } - 1 == idx && GetPVarInt ( i, "p_biz_id" ) == b_idx && itog [ 1 ] != i )
			{
				insert_money_log ( i, itog [ 1 ], -_b_bet, "проигрыш кости (сумма в фишках)" ) ;
			}
			if ( player_dice_table { i } - 1 == idx && GetPVarInt ( i, "p_biz_id" ) == b_idx && IsPlayerNearDice ( i ) != idx )
			{
				if ( GetPVarInt ( i, "InGame" ) && dice_info [ b_idx ] [ idx ] [ b_started ] <= 0 )
				{
					give_inventory (
						i,
						ITEM_CASINO_CHIPS,
						dice_info [ b_idx ] [ idx ] [ b_bet ],
						0,
						"",
						"",
						NUMBERPLATE_TYPE_NONE,
						0
					) ;
					dice_info [ b_idx ] [ idx ] [ b_bank ] -= dice_info [ b_idx ] [ idx ] [ b_bet ] ;
				}
				if ( dice_info [ b_idx ] [ idx ] [ b_crupie ] == i )
				{
					dice_info [ b_idx ] [ idx ] [ b_crupie ] = INVALID_PLAYER_ID ;
				}
				for ( new i_ = 0 ; i_ < 5 ; i_ ++ )
				{
					if ( dice_info [ b_idx ] [ idx ] [ b_player ] [ i_ ] == i )
					{
						dice_info [ b_idx ] [ idx ] [ b_player ] [ i_ ] = INVALID_PLAYER_ID ;
						update_bone ( idx, b_idx ) ;
					}
				}

                update_bone_table ( b_idx, idx ) ;
				dice_ptd_status ( i, false ) ;
			}
		}
	}
	return true ;
}

stock IsPlayerNearDice ( playerid )
{
	for ( new i = 0 ; i < MAX_BONE ; i ++ ) if ( IsPlayerInRangeOfPoint ( playerid, 2.0, dice_positions [ i ] [ 0 ], dice_positions [ i ] [ 1 ], dice_positions [ i ] [ 2 ] ) ) return i ;
	return -1 ;
}

stock show_payment ( playerid )
{
	payment_ptd [ playerid ] [ 0 ] = CreatePlayerTextDraw(playerid, 63.3330, 279.5997, "0"); // пусто
	PlayerTextDrawLetterSize(playerid, payment_ptd [ playerid ] [ 0 ], 0.1972, 0.9236);
	PlayerTextDrawAlignment(playerid, payment_ptd [ playerid ] [ 0 ], 1);
	PlayerTextDrawColor(playerid, payment_ptd [ playerid ] [ 0 ], -1061109505);
	PlayerTextDrawBackgroundColor(playerid, payment_ptd [ playerid ] [ 0 ], 255);
	PlayerTextDrawFont(playerid, payment_ptd [ playerid ] [ 0 ], 1);
	PlayerTextDrawSetProportional(playerid, payment_ptd [ playerid ] [ 0 ], 1);
	PlayerTextDrawSetShadow(playerid, payment_ptd [ playerid ] [ 0 ], 0);

	PlayerTextDrawShow ( playerid, payment_ptd [ playerid ] [ 0 ] ) ;

	payment_ptd [ playerid ] [ 1 ] = CreatePlayerTextDraw(playerid, 128.9999, 277.9400, "+$0"); // пусто
	PlayerTextDrawLetterSize(playerid, payment_ptd [ playerid ] [ 1 ], 0.1419, 0.6915);
	PlayerTextDrawAlignment(playerid, payment_ptd [ playerid ] [ 1 ], 2);
	PlayerTextDrawColor(playerid, payment_ptd [ playerid ] [ 1 ], 1111638783);
	PlayerTextDrawBackgroundColor(playerid, payment_ptd [ playerid ] [ 1 ], 255);
	PlayerTextDrawFont(playerid, payment_ptd [ playerid ] [ 1 ], 1);
	PlayerTextDrawSetProportional(playerid, payment_ptd [ playerid ] [ 1 ], 1);
	PlayerTextDrawSetShadow(playerid, payment_ptd [ playerid ] [ 1 ], 0);

 	for ( new j = 0 ; j < 14 ; j ++ )
	{
		TextDrawShowForPlayer ( playerid, payment_td [ j ] ) ;
	}
	return 1 ;
}

stock hide_payment ( playerid )
{
    for ( new j = 0 ; j < 14 ; j ++ )
	{
	    TextDrawHideForPlayer ( playerid, payment_td [ j ] ) ;
	}

	for ( new j = 0 ; j < 2 ; j ++ )
	{
		PlayerTextDrawDestroy ( playerid, payment_ptd [ playerid ] [ j ] ) ;
		payment_ptd [ playerid ] [ j ] = PlayerText:-1;
	}
	return 1 ;
}

stock update_payment ( playerid, money_count )
{
	new td_string [ 16 ] ;
	format ( td_string, sizeof ( td_string ), "%d", p_info [ playerid ] [ salary ] ) ;
	PlayerTextDrawSetString ( playerid, payment_ptd [ playerid ] [ 0 ], td_string ) ;

	format ( td_string, sizeof ( td_string ), "+$%d", money_count ) ;
	PlayerTextDrawSetString ( playerid, payment_ptd [ playerid ] [ 1 ], td_string ) ;
	PlayerTextDrawShow ( playerid, payment_ptd [ playerid ] [ 1 ] ) ;

	SetTimerEx ( "hide_payment_timer", 2000, false, "d", playerid ) ;
	return 1 ;
}

callback: hide_payment_timer ( playerid )
{
	if ( payment_ptd [ playerid ] [ 1 ] != PlayerText:-1 )
	{
		PlayerTextDrawHide ( playerid, payment_ptd [ playerid ] [ 1 ] ) ;
	}
	return 1 ;
}

stock fraction_duty ( playerid )
{
    if ( is_fraction_duty { playerid } == 1 )
	{
	    new _frac_id = p_info [ playerid ] [ member ] ;
	    if ( _frac_id > 0 )
	    {
			SetPlayerSkin ( playerid, p_info [ playerid ] [ org_skin ] ) ;
			SetPlayerColor ( playerid, f_info [ _frac_id - 1 ] [ f_radar_color ] ) ;
		}
		else
		{
		    //SetPlayerSkin ( playerid, p_info [ playerid ] [ skin ] ) ;
		    SetPlayerSkin ( playerid, getNewSkinModel ( playerid ) ) ;
			SetPlayerColor ( playerid, 0xFFFFFF80 ) ;
		}
	}
	else
	{
		//SetPlayerSkin ( playerid, p_info [ playerid ] [ skin ] ) ;
		SetPlayerSkin ( playerid, getNewSkinModel ( playerid ) ) ;
		SetPlayerColor ( playerid, 0xFFFFFF80 ) ;
	}
	return 1 ;
}

stock fraction_color ( playerid )
{
    if ( is_fraction_duty { playerid } == 1 )
	{
	    new _frac_id = p_info [ playerid ] [ member ] ;
	    if ( _frac_id > 0 ) SetPlayerColor ( playerid, f_info [ _frac_id - 1 ] [ f_radar_color ] ) ;
		else SetPlayerColor ( playerid, 0xFFFFFF80 ) ;
	}
	else SetPlayerColor ( playerid, 0xFFFFFF80 ) ;
	return 1 ;
}

stock get_passenger_count ( playerid )
{
	new passenger_count = 0,
		vehicleid = GetPlayerVehicleID ( playerid ) ;

	foreach ( new i:streamed_players[playerid])
	{
		if ( GetPlayerState ( i ) == PLAYER_STATE_PASSENGER && GetPlayerVehicleID ( i ) == vehicleid ) passenger_count ++ ;
	}
	return passenger_count ;
}

stock IsARPName ( Name [ ] )
{
	new simb_, RP_Name[2][24];
	new playerid;
	for(new i = 0;i < strlen(Name);i ++)
	{
	    if(Name[i] == '_') simb_ ++;
	}
	if(simb_ != 1) return false ;
	sscanf(Name,"p<_>s[24]s[24]",RP_Name[0],RP_Name[1]);
	if( !IsAGoodName(RP_Name[0]) || !IsAGoodName(RP_Name[1]) ) return false ;
	if( IsPlayerNPC(playerid)) return true ;
	return true ;
}

stock IsAGoodName ( Name [ ] )
{
	new playerid;
	new NameChars;
	if(IsPlayerNPC(playerid))return 1;
	if(strlen(Name) < 2) return false ;
	if(Name[0] < 'A' || Name[0] > 'Z') return false ;
	for(new i = 1;i < strlen(Name);i ++)
	{
	    if(Name[i] < 'a' || Name[i] > 'z')
		{
		    if(Name[i] >= 'A' && Name[i] <= 'Z') NameChars ++;
		    else return false ;
		}
	    if(NameChars > 1) return false ;
	}
	return true ;
}

stock IsAGoodMessage ( text [ ] )
{
	new NameChars ;
	if ( strlen ( text ) < 3 ) return true ;
	for ( new i = 1 ; i < strlen ( text ) ; i ++ )
	{
	    if ( text [ i ] >= 'A' && text [ i ] <= 'Z' || text [ i ] >= 'А' && text [ i ] <= 'Я' ) NameChars ++ ;
	    if ( NameChars > 4 ) return false ;
	}
	return true ;
}

