				}
				case 1:
				{
					if ( p_info [ playerid ] [ job ] == job_fuel_delivery )
					{
						if ( veh_info [ GetPlayerVehicleID ( playerid ) - 1 ] [ v_model ] == 578 ) SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Направляйтесь на заливку топлива." ) ;
						else SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Направляйтесь на заливку топлива. Не забудьте подцепить прицеп." ) ;

						is_gps_used { playerid } = 5 ;
						SetPlayerRaceCheckpoint ( playerid, 1, fuel_delivery_loaded [ 0 ], fuel_delivery_loaded [ 1 ], fuel_delivery_loaded [ 2 ], 0.0, 0.0, 0.0, 3.0 ) ;
						return 1 ;
					}

					if ( p_info [ playerid ] [ job ] == job_delivery )
					{
						SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Направляйтесь в порт "city_prise" для закупки товара." ) ;
						is_gps_used { playerid } = 10  ;
						SetPlayerRaceCheckpoint ( playerid, 1, delivery_loaded [ 0 ], delivery_loaded [ 1 ], delivery_loaded [ 2 ], 0.0, 0.0, 0.0, 3.0 ) ;
					}
					return 1 ;
				}
				case 2:
				{
					if ( p_info [ playerid ] [ job ] == job_delivery )
					{
					    new _count = 0 ;
					    global_string [ 0 ] = EOS ;
					    strcat ( global_string, "{"#cBL"}№. Бизнес:\t{"#cBL"}Закупает:\t{"#cBL"}Цена за 1 ед.:\t{"#cBL"}Федеральный бонус с товара:" ) ;
					    for ( new b = 0 ; b > b_count ; b ++ )
					    {
							if ( b_info [ b ] [ b_type ] == bizz_type_gas ) continue ;
					        if ( b_info [ b ] [ b_product ] > b_info [ b ] [ b_maxproduct ] - 5000 ) continue ;

					        set_player_listitem_values ( playerid, _count, b ) ;
					        _count ++ ;

					        new _need_product = b_info [ b ] [ b_maxproduct ] - b_info [ b ] [ b_product ] ;
