		case d_mp:
		{
			if ( ! response ) return 1 ;
			switch ( listitem )
		   	{
		   	    case 0:
		   	    {
		   	        if ( admin_mp_tp )
		   	        {
		   	            admin_mp_tp = 0 ;

		   	            static const _str [ ] = "{"#cBAdmin"}[A] {"#cGRAdmin"}%s[%d] закрыл телепорт." ;
		   	            new scm_string [ sizeof _str + 24 + 4 ] ;
						format ( scm_string, sizeof ( scm_string  ), _str, p_info [ playerid ] [ name ], playerid ) ;
						admin_message ( 4, col_admin, scm_string ) ;
		   	        }
		   	        else
		   	        {
		   	            admin_mp_tp = 1 ;

						static const _str [ ] = "{"#cBAdmin"}[A] {"#cGRAdmin"}%s[%d] открыл телепорт." ;
		   	            new scm_string [ sizeof _str + 24 + 4 ] ;
