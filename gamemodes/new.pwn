stock show_mp_team ( playerid )
{
    global_string [ 0 ] = EOS ;
    format ( global_string, 356, "{"#cBL"}1. {"#cWH"}Поделить {"#cBL"}ВСЕХ {"#cWH"}игроков на команды\n\
    								{"#cBL"}2. {"#cWH"}Выборочно поделить на команды\n\
    								{"#cBL"}3. {"#cWH"}Начать обратный отсчёт для команд\n\
									{"#cBL"}4. {"#cWH"}Одежда команды №1 {"#cGRDialog"}({"#cBL"}%d{"#cGRDialog"})\n\
									{"#cBL"}5. {"#cWH"}Одежда команды №2 {"#cGRDialog"}({"#cBL"}%d{"#cGRDialog"})\n\
									{"#cGRDialog"}Расформировать команды", admin_mp_tskin, admin_mp_tskin2 ) ;
    show_dialog ( playerid, d_mp_team, DIALOG_STYLE_LIST, "{"#cBHD"}Меню команд", global_string, "Выбрать", "Отмена");
	return 1 ;
}

stock show_mp_settings ( playerid )
{
    global_string [ 0 ] = EOS ;
   	format ( global_string, 760, "{"#cBL"}1. {"#cWH"}Выдача по %s\n\
	   								{"#cBL"}2. {"#cWH"}Зона %s\n\
									{"#cBL"}3. {"#cWH"}Пополнение здоровья %s (аптечки, наркотики)\n\
									{"#cBL"}4. {"#cWH"}Здоровье при телепортации {"#cGRDialog"}({"#cBL"}%d HP{"#cGRDialog"})\n\
								 	{"#cBL"}5. {"#cWH"}Броня при телепортации {"#cGRDialog"}({"#cBL"}%d ARM{"#cGRDialog"})\n\
									{"#cBL"}6. {"#cWH"}Минимальный уровень {"#cGRDialog"}({"#cBL"}%d LVL{"#cGRDialog"})\n\
									{"#cBL"}7. {"#cWH"}Максимальный уровень {"#cGRDialog"}({"#cBL"}%d LVL{"#cGRDialog"})\n\
									{"#cBL"}8. {"#cWH"}Вместимость игроков {"#cGRDialog"}({"#cBL"}%d{"#cGRDialog"})\n\
									{"#cBL"}9. {"#cWH"}%s оружие при телепортации\n\
									{"#cBL"}10. {"#cWH"}Чат для игроков %s\n\
									{"#cGRDialog"}Сбросить всё",
	( admin_mp_zone_set ) ? ( "{"#cGN"}зоне{"#cWH"}" ) : ( "{"#cRD"}радиусу{"#cWH"}" ), ( admin_mp_zone ) ? ( "{"#cGN"}включена{"#cWH"}" ) : ( "{"#cRD"}выключена{"#cWH"}" ), ( admin_mp_heal ) ? ( "{"#cGN"}разрешено{"#cWH"}" ) : ( "{"#cRD"}запрещено{"#cWH"}" ), admin_mp_hp, admin_mp_arm, admin_mp_min_lvl, admin_mp_max_lvl, admin_mp_max_players, ( admin_mp_gun ) ? ( "{"#cGN"}Сохранять{"#cWH"}" ) : ( "{"#cRD"}Не сохранять{"#cWH"}" ), ( admin_mp_chat ) ? ( "{"#cGN"}включен{"#cWH"}" ) : ( "{"#cRD"}выключен{"#cWH"}" ) ) ;
   	show_dialog ( playerid, d_mp_settings, DIALOG_STYLE_LIST, "{"#cBHD"}Настройки", global_string, "Выбрать", "Отмена");
	return 1 ;
}

stock find_mp_zone ( playerid )
{
	if ( admin_mp_zone )
	{
	    if ( ! IsPlayerInRangeOfPoint ( playerid, 50, admin_mp_zone_coord [ 0 ], admin_mp_zone_coord [ 1 ], admin_mp_zone_coord [ 2 ] ) || GetPlayerVirtualWorld ( playerid ) != admin_mp_virt ) return 0 ;
	}
	return 1 ;
}

CMD:startmp ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 5 ) return 1 ;

	new quantity_player, name_mp [ 32 ] ;
	if ( sscanf ( params, "ds[32]", quantity_player, name_mp ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /startmp [Кол-во игроков] [Название мероприятия]" ) ;

    if( admin_mp_tp )
       return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Уже идет сбор игроков на мероприятие." ) ;
    if ( quantity_player > 500 )
       return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Максимальное число игроков на мероприятии: 500." ) ;
    if ( ! ( 1 <= strlen ( params ) <= 32 ) )
       return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Слишком длинное название мероприятия." ) ;

    new string [ 128 ] ;
    format ( string, sizeof ( string ), "* Администратор %s запустил сбор игроков на мероприятие '%s'. Максимум: %d чел.", p_info [ playerid ] [ name ], name_mp, quantity_player ) ;
    SendClientMessageToAll ( col_yellow, string ) ;

    admin_mp_max_players = quantity_player ;

    GetPlayerPos ( playerid, admin_mp_pos [ 0 ], admin_mp_pos [ 1 ], admin_mp_pos [ 2 ] ) ;
    GetPlayerFacingAngle ( playerid, admin_mp_pos [ 3 ] ) ;

    admin_mp_int = GetPlayerInterior ( playerid ) ;
    admin_mp_virt = GetPlayerVirtualWorld ( playerid ) ;

    admin_mp_tp = 1 ;

    return SendClientMessageToAll ( col_yellow, !"* Введите /gomp для телепорта на мероприятие" ) ;
}

CMD:stopmp ( playerid )
{
	if ( admin_info [ playerid ] [ admin ] < 5 ) return 1 ;
    if ( admin_mp_tp ) SendClientMessageToAll ( col_yellow, !"* Сбор игроков на мероприятие остановлен администратором." ), admin_mp_tp = 0, player_in_mp = 0 ;
    else if ( ! admin_mp_tp ) SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Сбор игроков не запущен." ) ;
    return 1 ;
}

CMD:gomp ( playerid )
{
	if ( ! admin_mp_tp ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Сбор игроков не запущен." ) ;
    if ( p_info [ playerid ] [ jailed ] > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нельзя учавствовать в мероприятии находясь в заключении." ) ;
	if ( p_info [ playerid ] [ level ] < admin_mp_min_lvl || p_info [ playerid ] [ level ] > admin_mp_max_lvl ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете попасть на мероприятие из-за игрового уровня." ) ;
	if ( player_in_mp + 1 > admin_mp_max_players ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}На мероприятии максимальное количество участников." ) ;

	set_health ( playerid, admin_mp_hp ) ;
	set_armour ( playerid, admin_mp_arm ) ;
	if ( ! admin_mp_gun ) reset_player_weapon ( playerid ) ;

	player_in_mp ++ ;

	player_mp [ playerid ] = true ;
    SendClientMessage ( playerid, col_yellow, !"* Вы были телепортированы на мероприятие, ожидайте команд администрации." ) ;
    SendClientMessage ( playerid, col_yellow, !"* Если Вы хотите уйти с мероприятия, то используйте /back." ) ;

    GetPlayerPos ( playerid, last_coord [ playerid ] [ 0 ], last_coord [ playerid ] [ 1 ], last_coord [ playerid ] [ 2 ] ) ;
    GetPlayerFacingAngle ( playerid, last_coord [ playerid ] [ 3 ] ) ;

    last_virt [ playerid ] = GetPlayerVirtualWorld ( playerid ) ;
    last_int [ playerid ] = GetPlayerInterior ( playerid ) ;

    set_pos ( playerid, admin_mp_pos [ 0 ], admin_mp_pos [ 1 ], admin_mp_pos [ 2 ], admin_mp_pos [ 3 ], admin_mp_int, admin_mp_virt ) ;
    return 1 ;
}

CMD:back ( playerid )
{
	if ( ! player_mp [ playerid ] ) return 1 ;

	player_mp [ playerid ] = false ;
	p_t_info [ playerid ] [ mp_team ] = 0 ;
	SendClientMessage ( playerid, col_yellow, !"* Вы покинули мероприятие." ) ;
	set_pos ( playerid, last_coord [ playerid ] [ 0 ], last_coord [ playerid ] [ 1 ], last_coord [ playerid ] [ 2 ], last_coord [ playerid ] [ 3 ], last_int [ playerid ], last_virt [ playerid ] ) ;

    reset_player_weapon ( playerid ) ;
	return 1 ;
}

CMD:antidmid ( playerid )
{
	for ( new j = 0 ; j < MAX_DM_ZONE ; j ++ )
	{
		if ( ! IsPlayerInQuad ( playerid, anti_dm_pos [ j ] [ 0 ], anti_dm_pos [ j ] [ 1 ], anti_dm_pos [ j ] [ 2 ], anti_dm_pos [ j ] [ 3 ] ) )continue ;

		new scm_string [ 47 + 9 ] ;
		format ( scm_string, sizeof scm_string, "{"#cBInfo"}* {"#cGRInfo"}Green Zone ID: %d.", j ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
	}
	return 1 ;
}

CMD:antipark ( playerid )
{
	for ( new j = 0 ; j < MAX_NONPARKING_ZONES ; j ++ )
	{
		if ( ! IsPlayerInQuad ( playerid, non_parking_pos [ j ] [ 0 ], non_parking_pos [ j ] [ 1 ], non_parking_pos [ j ] [ 2 ], non_parking_pos [ j ] [ 3 ] ) )continue ;

		new scm_string [ 47 + 9 ] ;
		format ( scm_string, sizeof scm_string, "{"#cBInfo"}* {"#cGRInfo"}NoPark Zone ID: %d.", j ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
	}
	return 1 ;
}

CMD:dmgstat ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 1 ) return 1 ;
	if ( sscanf ( params, "u", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /dmgstat [ид]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] )  ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;

	global_string [ 0 ] = EOS ;
	format ( global_string, 140, "{"#cWH"}tick differ: %d\nkilled: %d",
	GetTickCount ( ) - p_t_info [ params [ 0 ] ] [ p_update ], player_killed [ params [ 0 ] ] ) ;
	show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Статистика урона", global_string, "Закрыть", "" ) ;
	return 1 ;
}

CMD:eject ( playerid, params [ ] )
{
	if ( ! IsPlayerInAnyVehicle ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны находиться в транспорте." ) ;
	else if ( GetPlayerState ( playerid ) != PLAYER_STATE_DRIVER ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны находиться за рулём." ) ;
	if ( sscanf ( params, "u", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /eject [ид/имя]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] )  ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;

	if ( playerid == params [ 0 ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Ты не можешь выкинуть себя." ) ;
	if ( ! IsPlayerInVehicle ( params [ 0 ], player_vehicle [ playerid ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок должен находиться в вашем транспорте." ) ;

	new string [ 100 ] ;
	format(string, sizeof(string), "{"#cGInfo"}* {"#cWH"}Вы выкинули из транспорта {"#cGN"}%s", p_info [ params [ 0 ] ] [ name ]);
	SendClientMessage ( playerid, col_white, string);
	format(string, sizeof(string), "{"#cGN"}* %s{"#cWH"} выкинул(-a) Вас из транспорта", p_info [ playerid ] [ name ] );
	SendClientMessage(params[0], col_white, string);

	format(string, sizeof(string), "выкинул(-а) из транспорта %s", p_info [ params [ 0 ] ] [ name ] ) ;
	me_action ( playerid, string ) ;

	RemovePlayerFromVehicle ( params [ 0 ] ) ;
	return 1 ;
}

alias:usecanister("fuelcar", "fillcar")
CMD:usecanister ( playerid )
{
	if ( target_cuff [ playerid ] != INVALID_PLAYER_ID )
	{
		if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Вы в наручниках.", 0, 3, CINFO_INVENTORY_ID, PICTURE_INFO_ERROR, "", "" ) ;
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы в наручниках." ) ;
		return 1 ;
	}
	if ( target_tie [ playerid ] != INVALID_PLAYER_ID )
	{
		if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Вы связаны.", 0, 3, CINFO_INVENTORY_ID, PICTURE_INFO_ERROR, "", "" ) ;
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы связаны." ) ;
		return 1 ;
	}
	if ( GetInventoryFindItem ( playerid, SUB_INVENTORY, 2157 ) < 1 )
	{
		if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "У вас нет канистры с бензином.", 0, 3, CINFO_INVENTORY_ID, PICTURE_INFO_ERROR, "", "" ) ;
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас нет канистры с бензином." ) ;
		return 1 ;
	}
	if ( ! IsPlayerInAnyVehicle ( playerid ) )
	{
		if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Вы должны быть за рулём транспортного средства.", 0, 3, CINFO_INVENTORY_ID, PICTURE_INFO_ERROR, "", "" ) ;
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны быть за рулём транспортного средства." ) ;
		return 1 ;
	}
	if ( GetVehicleSpeed ( player_vehicle [ playerid ] ) > 5 )
	{
		if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Нельзя использовать канистру с бензином на ходу.", 0, 3, CINFO_INVENTORY_ID, PICTURE_INFO_ERROR, "", "" ) ;
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нельзя использовать канистру с бензином на ходу." ) ;
		return 1 ;
	}

	new vehicle_id = GetPlayerVehicleID ( playerid ) - 1 ;

	if ( veh_info [ vehicle_id ] [ v_fuel ] > 99 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Ваш бак полон." ) ;
	veh_info [ vehicle_id ] [ v_fuel ] += 15 ;
	if ( veh_info [ vehicle_id ] [ v_fuel ] > 100 ) veh_info [ vehicle_id ] [ v_fuel ] = 100 ;
	if ( player_device { playerid } == 2 )
	{
		SendSpeedometr ( playerid, GetPlayerVehicleID ( playerid ), true ) ;
		send_check_cinfo ( playerid, "Вы успешно заправили свой транспорт.", 0, 3, CINFO_INVENTORY_ID, PICTURE_INFO_SUCESS, "", "" ) ;
	}
    else SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы успешно заправили свой транспорт." ) ;

    give_event_progress ( playerid, THE_FILLING, 1 ) ;

	me_action ( playerid, "заправил(-а) свою машину" ) ;
	clear_inventory ( playerid, 2157, 1 ) ;
	return 1 ;
}

