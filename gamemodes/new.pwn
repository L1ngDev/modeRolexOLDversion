		RifaKyznica[1] = CreateDynamic3DTextLabel ( "** Пусто **", col_header_3d, -2155.4519, -266.0216, 37.9203, 50.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, -1, -1 ) ;
		RifaKyznica[2] = CreateDynamic3DTextLabel ( "** Пусто **", col_header_3d, -2158.8604, -266.0407, 37.9203, 50.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, -1, -1 ) ;
