	}
	return 1 ;
}
callback: healme_attach ( playerid ) return RemovePlayerAttachedObject ( playerid, 2 ) ;

alias:repairkit("repcar", "remcar", "repaircar")
CMD:repairkit ( playerid )
{
	if ( target_cuff [ playerid ] != INVALID_PLAYER_ID )
	{
		if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Вы в наручниках.", 0, 3, CINFO_INVENTORY_ID, PICTURE_INFO_ERROR, "", "" ) ;
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы в наручниках." ) ;
		return 1 ;
	}
	if ( target_tie [ playerid ] != INVALID_PLAYER_ID )
	{
		if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Вы связаны.", 0, 3, CINFO_INVENTORY_ID, PICTURE_INFO_ERROR, "", "" ) ;
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы связаны." ) ;
		return 1 ;
	}
	if ( GetInventoryFindItem ( playerid, SUB_INVENTORY, 2156 ) < 1 )
	{
		if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "У вас нет ремонтного набора.", 0, 3, CINFO_INVENTORY_ID, PICTURE_INFO_ERROR, "", "" ) ;
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас нет ремонтного набора." ) ;
		return 1 ;
	}
	if ( GetPlayerState ( playerid ) != PLAYER_STATE_DRIVER )
	{
		if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Вы должны быть за рулём транспортного средства.", 0, 3, CINFO_INVENTORY_ID, PICTURE_INFO_ERROR, "", "" ) ;
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны быть за рулём транспортного средства." ) ;
		return 1 ;
	}
	if ( GetVehicleSpeed ( player_vehicle [ playerid ] ) > 5 )
	{
		if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Нельзя использовать ремонтный набор на ходу.", 0, 3, CINFO_INVENTORY_ID, PICTURE_INFO_ERROR, "", "" ) ;
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нельзя использовать ремонтный набор на ходу." ) ;
		return 1 ;
	}

	if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Вы успешно починили свой транспорт.", 0, 3, CINFO_INVENTORY_ID, PICTURE_INFO_SUCESS, "", "" ) ;
    else SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы успешно починили свой транспорт." ) ;
    RepairVehicle ( GetPlayerVehicleID ( playerid ) ) ;

	me_action ( playerid, "отремонтировал(-а) свою машину" ) ;
	clear_inventory ( playerid, 2156, 1 ) ;
	return 1 ;
}

CMD:tie ( playerid, params [ ] )
{
	if ( ! mafia_player ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команда доступна только для криминальных организаций." ) ;
	if ( GetInventoryFindItem ( playerid, SUB_INVENTORY, 2160 ) < 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас нет верёвки." ) ;
	if ( p_info [ playerid ] [ jailed ] > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы сидите в тюрьме." ) ;
	if ( target_cuff [ playerid ] != INVALID_PLAYER_ID )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы в наручниках." ) ;
	if ( target_tie [ playerid ] != INVALID_PLAYER_ID )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы связаны." ) ;
	if ( sscanf ( params, "u", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /tie [ид/имя]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете себя связать." ) ;
    if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;

    for ( new j = 0 ; j < MAX_DM_ZONE ; j ++ )
	{
		if ( ! IsPlayerInQuad ( playerid, anti_dm_pos [ j ] [ 0 ], anti_dm_pos [ j ] [ 1 ], anti_dm_pos [ j ] [ 2 ], anti_dm_pos [ j ] [ 3 ] ) ) continue ;

		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Запрещено связывать в зелёных зонах." ) ;
		return 1 ;
	}

	clear_inventory ( playerid, 2160, 1 ) ;

	player_tie [ playerid ] = params [ 0 ] ;
	target_tie [ params [ 0 ] ] = playerid ;
	SetPlayerSpecialAction ( params [ 0 ], SPECIAL_ACTION_CUFFED ) ;
	return true ;
}

CMD:untie ( playerid, params [ ] )
{
	if ( target_cuff [ playerid ] != INVALID_PLAYER_ID )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы в наручниках." ) ;
	if ( target_tie [ playerid ] != INVALID_PLAYER_ID )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы связаны." ) ;
	if ( sscanf ( params, "u", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /untie [ид/имя]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете себя развязать." ) ;
    if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;

	clear_stoped_params ( playerid, params [ 0 ] ) ;

	SetPlayerSpecialAction ( params [ 0 ], SPECIAL_ACTION_NONE ) ;

	if ( gotome_player [ params [ 0 ] ] != -1 )
	{
	    police_gotome [ playerid ] =
	    gotome_player [ params [ 0 ] ] = -1 ;
	    ClearAnimations ( params [ 0 ], true ) ;

		cuff_x [ params [ 0 ] ] = cuff_y [ params [ 0 ] ] = cuff_z [ params [ 0 ] ] = 0.0 ;
		return 1 ;
	}
	return true ;
}

CMD:gotome ( playerid, params [ ] )
{
	if ( ! cop_player ( playerid ) && ! fbi_player ( playerid ) && ! mafia_player ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команда доступна только для криминальных и гос. организаций." ) ;
	if ( target_cuff [ playerid ] != INVALID_PLAYER_ID )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы в наручниках." ) ;
	if ( target_tie [ playerid ] != INVALID_PLAYER_ID )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы связаны." ) ;
	if ( police_gotome [ playerid ] != -1 )
	{
		new pl_id = police_gotome [ playerid ] - 1 ;

        police_gotome [ playerid ] =
		gotome_player [ pl_id ] = -1 ;

	    ClearAnimations ( pl_id, true ) ;
		new scm_string [ 50 + MAX_PLAYER_NAME ] ;
		format ( scm_string, sizeof ( scm_string ), "{"#cGInfo"}* {"#cWH"}Вы отпустили {"#cGN"}%s{"#cWH"}.", p_info [ pl_id ] [ name ] ) ;
		SendClientMessage ( playerid, col_white, scm_string ) ;

		cuff_x [ pl_id ] = cuff_y [ pl_id ] = cuff_z [ pl_id ] = 0.0 ;
		return 1;
	}

	if ( sscanf ( params, "u", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /gotome [ид/имя]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете потащить самого себя." ) ;

	if ( p_info [ params [ 0 ] ] [ jailed ] > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок находится в тюрьме." ) ;
	if ( target_cuff [ params [ 0 ] ] == INVALID_PLAYER_ID && target_tie [ params [ 0 ] ] == INVALID_PLAYER_ID )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок должен быть в наручниках или связан." ) ;

	if ( IsPlayerInAnyVehicle ( playerid ) || IsPlayerInAnyVehicle ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы или Ваша цель находитесь в транспорте." ) ;
    if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;

    police_gotome [ playerid ] = params [ 0 ] + 1 ;
    gotome_player [ params [ 0 ] ] = playerid ;

	new scm_string [ 58 + MAX_PLAYER_NAME ] ;
	format ( scm_string, sizeof ( scm_string ), "{"#cGInfo"}* {"#cWH"}Вы повели {"#cGN"}%s{"#cWH"} за собой.", p_info [ params [ 0 ] ] [ name ] ) ;
	SendClientMessage ( playerid, col_white, scm_string ) ;
    return 1 ;
}

CMD:pull ( playerid, params [ ] )
{
	if ( ! cop_player ( playerid )  && ! fbi_player ( playerid ) && ! mafia_player ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команда доступна только для криминальных и гос. организаций." ) ;
	if ( sscanf ( params, "u", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /pull [ид/имя]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете применить это к самому себе." ) ;
	if ( ! IsPlayerInAnyVehicle ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Ваша цель не находитесь в транспорте." ) ;
	if ( IsPlayerInAnyVehicle ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы находитесь в транспорте." ) ;

	if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;

	toggle_controlable ( params [ 0 ], false ) ;

	pull_timer [ playerid ] = SetTimerEx ( "pull_timers", 1000, 0, "iii", playerid, params [ 0 ], 1 ) ;

	ApplyAnimation(playerid, "PED", "CAR_OPEN_LHS", 4.0, 0, 0, 0, 0, 0, 1);

	new scm_string [ 62 + ( MAX_PLAYER_NAME * 2 ) ] ;
	format ( scm_string, sizeof ( scm_string ), "%s открыл(а) дверь автомобиля и вытащил(а) %s из транспорта", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ] ) ;
	SetPlayerChatBubble(playerid, scm_string, 0xDD90FFFF, 10.0, 10000 ) ;
	return 1 ;
}

callback: pull_timers ( playerid, targetid, type )
{
	if ( type == 1 )
	{
	    KillTimer ( pull_timer [ playerid ] ) ;
	    pull_timer [ playerid ] = -1 ;

    	if ( IsPlayerConnected ( targetid ) )
		{
		    ApplyAnimation(playerid, "PED", "CAR_PULLOUT_LHS", 4.0, 0, 0, 0, 0, 0, 1);
			pull_timer [ playerid ] = SetTimerEx ( "pull_timers", 1500, 0, "iii", playerid, targetid, 2 ) ;
		}
    	return 1 ;
	}
	else if ( type == 2 )
	{
	    KillTimer ( pull_timer [ playerid ] ) ;
	    pull_timer [ playerid ] = -1 ;
	    ClearAnimations ( playerid ) ;

	    if ( IsPlayerConnected ( targetid ) )
		{
			RemovePlayerFromVehicle ( targetid ) ;
			toggle_controlable ( targetid, true ) ;
		}
	}
	return 1 ;
}

CMD:push ( playerid, params [ ] )
{
	if ( ! cop_player ( playerid )  && ! fbi_player ( playerid ) && ! mafia_player ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команда доступна только для криминальных и гос. организаций." ) ;
	if ( sscanf ( params, "u", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /push [ид/имя]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете применить это к самому себе." ) ;
	if ( IsPlayerInAnyVehicle ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Ваша цель уже находитесь в транспорте." ) ;
	if ( target_cuff [ params [ 0 ] ] == INVALID_PLAYER_ID && target_tie [ params [ 0 ] ] == INVALID_PLAYER_ID )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок должен быть в наручниках или связан." ) ;

	if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;

	new veh_id = GetPlayerNearestVehicle ( playerid ) ;
	if ( veh_id != INVALID_VEHICLE_ID )
	{
		if ( veh_info [ veh_id - 1 ] [ v_type ] != vehicle_type_server || veh_info [ veh_id - 1 ] [ v_owner ] != p_info [ playerid ] [ member ] )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны быть возле служебного транспорта." ) ;
		new seatid = GetVehicleFreeSeat ( veh_id ) ;
		if ( seatid != -1 )
		{
			PutPlayerInVehicle ( params [ 0 ], veh_id, seatid ) ;
			new scm_string [ 46 + ( MAX_PLAYER_NAME * 2 ) ] ;
			format ( scm_string, sizeof ( scm_string ), "%s заломал%s руки %s и посадил%s в транспорт.", p_info [ playerid ] [ name ], (p_info [ playerid ] [ gender ]==1)?(""):("а"), p_info [ params [ 0 ] ] [ name ], (p_info [ playerid ] [ gender ]==1)?(""):("а") ) ;
			SetPlayerChatBubble(playerid, scm_string,0xDD90FFFF, 10.0, 10000 ) ;

			if ( gotome_player [ params [ 0 ] ] != -1 )
			{
			    police_gotome [ playerid ] =
			    gotome_player [ params [ 0 ] ] = -1 ;
			    ClearAnimations ( params [ 0 ], true ) ;

				cuff_x [ params [ 0 ] ] = cuff_y [ params [ 0 ] ] = cuff_z [ params [ 0 ] ] = 0.0 ;
			}
		}
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}В ближайшем транспорте нет свободных мест." ) ;
	}
	else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Возле вас нет транспорта." ) ;
	return 1 ;
}

CMD:mask ( playerid )
{
	if ( GetInventoryFindItem ( playerid, SUB_INVENTORY, 2158 ) < 1 )
	{
		if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "У Вас нет маски.", 0, 3, CINFO_INVENTORY_ID, PICTURE_INFO_ERROR, "", "" ) ;
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет маски." ) ;
		return 1 ;
	}
	if ( p_info [ playerid ] [ masked ] )
	{
		if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Вы уже надели маску.", 0, 3, CINFO_INVENTORY_ID, PICTURE_INFO_ERROR, "", "" ) ;
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы уже надели маску." ) ;
		return 1 ;
	}
	if ( target_cuff [ playerid ] != INVALID_PLAYER_ID )
	{
		if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Вы в наручниках.", 0, 3, CINFO_INVENTORY_ID, PICTURE_INFO_ERROR, "", "" ) ;
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы в наручниках." ) ;
		return 1 ;
	}
	if ( target_tie [ playerid ] != INVALID_PLAYER_ID )
	{
		if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Вы связаны.", 0, 3, CINFO_INVENTORY_ID, PICTURE_INFO_ERROR, "", "" ) ;
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы связаны." ) ;
		return 1 ;
	}

	clear_inventory ( playerid, 2158, 1 ) ;

	SetPlayerColor ( playerid, 0x7a766700 ) ;
	SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы надели маску. Ваше местоположение скрыто. Используйте {"#cGN"}/unmask{"#cWH"}, чтобы снять маску." ) ;
 	GameTextForPlayer(playerid, "~b~Invisible on", 5000, 3);
  	if ( GetPlayerState ( playerid ) == PLAYER_STATE_ONFOOT )ApplyAnimation(playerid, "shop","ROB_Shifty",4.0,0,0,0,0,0,1);
    if ( p_info [ playerid ] [ mask_status ] ) SetPlayerAttachedObject(playerid, 3, 19801, 2, 0.070999, 0.013999, -0.002000, 0.200000, 82.699996, -178.600021, 1.366999, 1.424000, 1.263000);
	SetPlayerChatBubble(playerid, "Надевает маску", 0xDD90FFFF, 30.0, 10000 ) ;
	if ( ! p_info [ playerid ] [ enhancement ] [ 3 ] )
	{
		if ( p_info [ playerid ] [ family ] )
	    {
		   	new family_id = p_info [ playerid ] [ family ] ;
		   	if ( family_info [ family_id - 1 ] [ fam_enhancement ] [ 3 ] )
		   	{
		   	    p_info [ playerid ] [ masked ] = 1800 ;
		   	}
		   	else p_info [ playerid ] [ masked ] = 900 ;
		}
		else p_info [ playerid ] [ masked ] = 900 ;
	}
	else
	{
		if ( p_info [ playerid ] [ family ] )
	    {
		   	new family_id = p_info [ playerid ] [ family ] ;
		   	if ( family_info [ family_id - 1 ] [ fam_enhancement ] [ 3 ] )
		   	{
		   	    p_info [ playerid ] [ masked ] = 3600 ;
		   	}
		   	else p_info [ playerid ] [ masked ] = 1800 ;
		}
		else p_info [ playerid ] [ masked ] = 1800 ;
	}
	return 1 ;
}

CMD:unmask ( playerid )
{
	if ( ! p_info [ playerid ] [ masked ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не в маске." ) ;

 	fraction_color ( playerid ) ;

	SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы сняли маску." ) ;
	if ( ! p_info [ playerid ] [ mask_status ] ) RemovePlayerAttachedObject(playerid, 3);
	p_info [ playerid ] [ masked ] = 0 ;
	return 1 ;
}

CMD:usedrugs ( playerid )
{
    if ( player_mp [ playerid ] && ! admin_mp_heal )
	{
		if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Запрещено использовать на мероприятии.", 0, 3, CINFO_INVENTORY_ID, PICTURE_INFO_ERROR, "", "" ) ;
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Запрещено использовать на мероприятии." ) ;
		return 1 ;
	}
    if ( target_cuff [ playerid ] != INVALID_PLAYER_ID )
	{
		if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Вы в наручниках.", 0, 3, CINFO_INVENTORY_ID, PICTURE_INFO_ERROR, "", "" ) ;
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы в наручниках." ) ;
		return 1 ;
	}
	if ( target_tie [ playerid ] != INVALID_PLAYER_ID )
	{
		if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Вы связаны.", 0, 3, CINFO_INVENTORY_ID, PICTURE_INFO_ERROR, "", "" ) ;
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы связаны." ) ;
		return 1 ;
	}

	new _drugs = GetInventoryFindItem ( playerid, SUB_INVENTORY, 2155 ) ;
	if ( _drugs < 1 )
	{
		if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "У Вас нет наркотиков.", 0, 3, CINFO_INVENTORY_ID, PICTURE_INFO_ERROR, "", "" ) ;
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет наркотиков." ) ;
		return 1 ;
	}
	if ( ! p_info [ playerid ] [ crime_plus ] && is_drug_effect { playerid } >= 1 )
	{
		if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Вы употребляете наркотики слишком часто.", 0, 3, CINFO_INVENTORY_ID, PICTURE_INFO_ERROR, "", "" ) ;
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы употребляете наркотики слишком часто." ) ;
		return 1 ;
	}

	new Float: drug_health = 15, drug_effect = 60 ;
    if ( GetPlayerState ( playerid ) == PLAYER_STATE_ONFOOT )
	{
		ApplyAnimation ( playerid, "SMOKING", "M_smk_drag", 4.1, 0, 0, 0, 0, 0, 1 ) ;
		p_t_info [ playerid ] [ knock_anim ] [ 0 ] = 1 ;
		p_t_info [ playerid ] [ p_animation ] = true ;
	}

	#if defined m_perks
	new _perk_stats = get_perk_info ( playerid, PERK_TORCHOK ) ;
	if ( _perk_stats > 0 )
	{
		drug_health = _perk_stats ;
        drug_effect -= _perk_stats ;
	}
	#endif

	SetPlayerTime ( playerid, 17, 0 ) ;
	SetPlayerDrunkLevel ( playerid, 3000 ) ;
	SetPlayerWeather ( playerid, - 68 ) ;

	new Float:pl_health ;
	GetPlayerHealth ( playerid, pl_health ) ;
	if ( pl_health + drug_health > 160 ) set_health ( playerid, 160 ) ;
	else set_health ( playerid, pl_health + drug_health ) ;

    is_drug_effect { playerid } = drug_effect ;
	p_info [ playerid ] [ p_disease ] [ 2 ] += random ( 50 ) + 10 ;
	clear_inventory ( playerid, 2155, 1 ) ;

	new scm_string [ 98 + 3 ] ;
	format ( scm_string, sizeof scm_string, "{"#cGInfo"}* {"#cWH"}Вы пополнили здоровье на 15 пунктов. Уровень здоровья: {"#cGN"}%d{"#cWH"}.", ( pl_health + 15 > 160 ) ? ( 160 ) : ( floatround ( pl_health + 15 ) ) ) ;
	SendClientMessage ( playerid, col_white, scm_string ) ;
	format ( scm_string, 35, "~y~you have~n~~b~%d~g~ drugs", _drugs - 1 ) ;
	GameTextForPlayer ( playerid, scm_string, 2000, 1 ) ;

	me_action ( playerid, "принимает дозу наркотиков" ) ;
	return 1 ;
}

CMD:sellzone ( playerid, params [ ] )
{
    for ( new i = 0 ; i < gz_count ; i ++ )
	{
		if ( IsPlayerInGangZone ( playerid, i ) )
		{
			if ( p_info [ playerid ] [ leader ] != gz_info [ i ] [ gz_owner ] || gz_info [ i ] [ gz_owner ] != p_info [ playerid ] [ member ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не на своей территории.") ;
			if ( sscanf ( params, "ud", params [ 0 ], params [ 1 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /sellzone [id/имя] [цена]") ;
			if ( params [ 1 ] < 20000 || params [ 1 ] > 500000 || params [ 1 ] == INVALID_PRICE ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Цена должна быть от {"#cRD"}20.000"valute_title_"{"#cGRInfo"} до {"#cRD"}500.000"valute_title"{"#cGRInfo"}." ) ;
			if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
			if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете применить это к самому себе." ) ;
			if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;
			if ( ! bad_dialog ( params [ 0 ] ) || ! bad_dialog ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Недоступно в данный момент.") ;
			if ( p_info [ params [ 0 ] ] [ member ] == p_info [ playerid ] [ member ] )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Невозможно продать территорию члену Вашей банды.") ;
			if ( ! gang_player ( params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Территорию возможно продать только бандиту.") ;
			if ( cooldown_sentence [ playerid ] > gettime ( ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Предложение о сделке можно отправлять один раз в {"#cRD"}45 секунд{"#cGRInfo"}." ) ;

            cooldown_sentence [ playerid ] = gettime ( ) + time_sell_sentence ;

			buyer_id [ playerid ] = params [ 0 ] ;
			sell_price [ playerid ] = params [ 1 ] ;
			sell_item [ playerid ] = i ;
			seller_id [ params [ 0 ] ] = playerid ;

            sell_time { playerid } =
			sell_time { params [ 0 ] } = time_sell_null ;

			new dialog_string [ 90 + MAX_PLAYER_NAME + 32 + 1 + 6 ] ;
			format ( dialog_string, sizeof ( dialog_string  ), "{"#cBL"}%s {FFFFFF}предлагает Вам приобрести территорию \"{%s}%s\"{ffffff} за {"#cGN"}%s"valute_title_"",
			p_info [ playerid ] [ name ], f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_chat_color ], f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_name ], GetPlayerCashValueToSmile ( params [ 1 ] ) ) ;
			show_dialog ( params [ 0 ], d_gz_sell_accept, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Покупка территории", dialog_string, "Купить", "Отмена" ) ;

			format ( dialog_string, sizeof ( dialog_string  ), "{"#cBInfo"}* {"#cWH"}Вы предложили {"#cBL"}%s{"#cWH"} приобрести территорию \"{%s}%s\"{ffffff} за {"#cBL"}%s"valute_title_"",
			p_info [ params [ 0 ] ] [ name ], f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_chat_color ], f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_name ], GetPlayerCashValueToSmile ( params [ 1 ] ) ) ;
			SendClientMessage ( playerid, col_white, dialog_string ) ;
		}
	}
	return true ;
}

CMD:hi ( playerid, params [ ] )
{
	if ( p_info [ playerid ] [ jailed ] > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы в тюрьме." ) ;
	if ( sscanf ( params, "d", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /hi [id/имя]") ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете применить это к самому себе." ) ;
	if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;
	if ( ! bad_dialog ( params [ 0 ] ) || ! bad_dialog ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Недоступно в данный момент." ) ;
	if ( p_info [ params [ 0 ] ] [ jailed ] > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок в тюрьме." ) ;
	if ( cooldown_sentence [ playerid ] > gettime ( ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Предложение о сделке можно отправлять один раз в {"#cRD"}45 секунд{"#cGRInfo"}." ) ;

    cooldown_sentence [ playerid ] = gettime ( ) + time_sell_sentence ;

	buyer_id [ playerid ] = params [ 0 ] ;
	sell_price [ playerid ] = params [ 1 ] ;
	seller_id [ params [ 0 ] ] = playerid ;

	sell_time { playerid } =
	sell_time { params [ 0 ] } = time_sell_null ;

	new dialog_string [ 108 + MAX_PLAYER_NAME + 32 + 1 + 6 ] ;
	format ( dialog_string, sizeof ( dialog_string  ), "{"#cBL"}%s {FFFFFF}предлагает Вам пожать руку.",
	p_info [ playerid ] [ name ] ) ;
	show_dialog ( params [ 0 ], d_hi, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Рукопожатие", dialog_string, "Пожать", "Отмена" ) ;

	format ( dialog_string, sizeof ( dialog_string  ), "{"#cGInfo"}* {"#cWH"}Вы предложили {"#cBL"}%s {FFFFFF}пожать руку.",
	p_info [ params [ 0 ] ] [ name ] ) ;
	SendClientMessage ( playerid, col_white, dialog_string ) ;
	return true ;
}

CMD:kiss ( playerid, params [ ] )
{
	if ( p_info [ playerid ] [ jailed ] > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы в тюрьме." ) ;
