		    format ( bonus_text, sizeof bonus_text, "{"#cGRInfo"}- {"#cWH"}Скилл оружия {"#cGN"}x%d за выстрел.", server_bonus [ 5 ] ) ;
		    SendClientMessage ( playerid, col_gray, bonus_text ) ;
