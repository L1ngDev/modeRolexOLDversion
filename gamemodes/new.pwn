/*

	Актёры

*/

#undef MAX_ACTORS
#define MAX_ACTORS	200

enum
{
	ACTOR_TYPE_STRIPER = 1,
	ACTOR_TYPE_DEER = 2,
	ACTOR_TYPE_ZOMBIE = 3,
	ACTOR_TYPE_TAXI = 4,
	ACTOR_TYPE_GUARD = 5
} ;

enum ACTOR_INFO
{
    ACTOR_TIME,
    ACTOR_TYPE,
	ACTOR_NUM_ID,
	ACTOR_VEHICLE_ID,
	ACTOR_ATTACK_ID,
	ACTOR_NAME [ MAX_PLAYER_NAME ],

	bool: ACTOR_HEALTH_BAR,

	Float: ACTOR_POS [ 4 ]
} ;
new actor_info [ MAX_ACTORS ] [ ACTOR_INFO ] ;

#define GetActorInfo(%0,%1)		actor_info[%0][%1]
#define GetPosActor(%0,%1)		actor_info[%0][ACTOR_POS][%1]

new player_trailer [ MAX_PLAYERS ] ;

enum
{
	NUMBERPLATE_TYPE_NONE = 0,
	NUMBERPLATE_TYPE_RUS = 2,
	NUMBERPLATE_TYPE_UA,
	NUMBERPLATE_TYPE_BY,
	NUMBERPLATE_TYPE_KZ,
	NUMBERPLATE_TYPE_RU_POLICE,
	NUMBERPLATE_TYPE_TAX,
	NUMBERPLATE_TYPE_GOS
} ;

stock plate_number1 ( _p_type, _p_name [ ], _p_region [ ] )
{
	new scm_string [ 32 ] ;
	switch ( _p_type )
	{
	    case 1: format ( scm_string, sizeof scm_string, "Transit" ) ;
	    case 2: format ( scm_string, sizeof scm_string, "RU %s %s", _p_name, _p_region ) ;
	    case 3: format ( scm_string, sizeof scm_string, "UA %s", _p_name ) ;
	    case 4: format ( scm_string, sizeof scm_string, "BU %s", _p_name ) ;
	    case 5: format ( scm_string, sizeof scm_string, "KZ %s", _p_name ) ;
	    case 6: format ( scm_string, sizeof scm_string, "Police %s %s", _p_name, _p_region ) ;
	}
	return scm_string ;
}
