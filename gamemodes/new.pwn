			"{"#cBL"}1.{"#cRD"} Закрыть двери дома\n{"#cBL"}2.{ffffff} Информация о доме\n{"#cBL"}3.{ffffff} Улучшения\n{"#cBL"}4.{ffffff} Гардероб\n{"#cBL"}5.{ffffff} Подселить человека\n{"#cBL"}6.{ffffff} Управление арендой дома\n{"#cBL"}7.{ffffff} Продать дом\n{"#cBL"}8.{ffffff} Приостановление\n{"#cBL"}9.{ffffff} Подвальное помещение", "Выбрать", "Закрыть" ) ;
		}
		else
		{
			show_dialog ( playerid, d_hmenu, DIALOG_STYLE_LIST, "{"#cBHD"}Управление домом",
			"{"#cBL"}1.{"#cRD"} Закрыть двери дома\n{"#cBL"}2.{ffffff} Информация о доме\n{"#cBL"}3.{ffffff} Улучшения\n{"#cBL"}4.{ffffff} Гардероб\n{"#cBL"}5.{ffffff} Подселить человека\n{"#cBL"}6.{ffffff} Управление арендой дома\n{"#cBL"}7.{ffffff} Продать дом\n{"#cBL"}8.{ffffff} Приостановление\n{"#cBL"}9.{ffffff} Подвальное помещение\n{"#cBL"}10.{ffffff} Выйти в гараж", "Выбрать", "Закрыть" ) ;
