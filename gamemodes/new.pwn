			{
			    show_dialog ( playerid, d_donate_talon, DIALOG_STYLE_INPUT, "{"#cBHD"}Донат услуги","{"#cRD"}* Сумма не может быть меньше 10 или больше 10.000 "donate_title".\n\n{"#cGRDialog"}- {"#cWH"}Семейные талоны:\n\n{"#cGRDialog"}* Курс семейных талонов: {"#cGN"}1 "family_title_abb"{"#cGRDialog"} = {"#cGN"}"conv_fam_text_price" "donate_title_abb"{"#cGRDialog"}.\n{"#cGRDialog"}* Введите количество "donate_title" Вы хотите обменять на \"{"#cWH"}"family_title"{"#cGRDialog"}\".","Принять", "Назад");
				return 1 ;
			}
			if ( p_info [ playerid ] [ donate ] < money_count * convertion_fam_price )
			{
			    show_dialog ( playerid, d_donate_talon, DIALOG_STYLE_INPUT, "{"#cBHD"}Донат услуги","{"#cRD"}* У Вас недостаточно средств для приобретения "family_title".\n\n{"#cGRDialog"}- {"#cWH"}Семейные талоны:\n\n{"#cGRDialog"}* Курс семейных талонов: {"#cGN"}1 "family_title_abb"{"#cGRDialog"} = {"#cGN"}"conv_fam_text_price" "donate_title_abb"{"#cGRDialog"}.\n{"#cGRDialog"}* Введите количество "donate_title" Вы хотите обменять на \"{"#cWH"}"family_title"{"#cGRDialog"}\".","Принять", "Назад");
				return 1 ;
			}

			set_player_donate ( playerid, ( money_count * convertion_fam_price ), 2 ) ;
			insert_money_log ( playerid, INVALID_PLAYER_ID, money_count * convertion_fam_price, "(donate) "family_title"" ) ;

			give_inventory (
				playerid,
				ITEM_FAMILY_TALON,
				money_count,
				0,
				"",
				"",
				NUMBERPLATE_TYPE_NONE,
				0,
				-1
			) ;

			show_donate ( playerid ) ;
			SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Донат услуга успешно приобретена." ) ;
			return 1 ;
		}
		case d_donate_rename:
		{
			if ( ! response )return show_donate ( playerid ) ;

			if ( ! get_player_donate ( playerid, 100, 2 ) )
			{
				show_dialog ( playerid, d_donate_rename, DIALOG_STYLE_INPUT, "{"#cBHD"}Донат услуги","{"#cRD"}* У Вас недостаточно средств для приобретения данной услуги.\n\n{"#cGRDialog"}- {"#cWH"}Смена Ник-Нейма:\n\n{"#cGRDialog"}* Цена: {"#cGN"}100 "donate_title"{"#cGRDialog"}.\n{"#cGRDialog"}* Вы действительно хотите сменить Ваш \"{"#cWH"}Ник-Нейм{"#cGRDialog"}\".","Принять", "Назад");
