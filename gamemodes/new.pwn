		{
			format ( bonus_text, sizeof bonus_text, "{"#cGRInfo"}- {"#cWH"}Опыт {"#cGN"}x%d в PayDay.", server_bonus [ 0 ] ) ;
		   	SendClientMessage ( playerid, col_gray, bonus_text ) ;
		}
