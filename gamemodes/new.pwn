stock auto_clear ( )
{
	new sql_string [ 128 ] ;
	format ( sql_string, sizeof sql_string, "DELETE FROM `users_messages` WHERE `timestamp` < '%d'", gettime ( ) - ( 86400 * 30 ) ) ;
	mysql_tquery ( sql_connection, sql_string ) ;
	format ( sql_string, sizeof sql_string, "DELETE FROM `deposit_logs` WHERE `dl_date` < '%d'", gettime ( ) - ( 86400 * 30 ) ) ;
	mysql_tquery ( sql_connection, sql_string ) ;

	mysql_tquery ( sql_connection, "DELETE FROM `users_jobinfo` WHERE `ji_date` < NOW()-INTERVAL 90 DAY" ) ;

	mysql_tquery ( sql_connection, "DELETE FROM `users_online` WHERE `date` < NOW()-INTERVAL 30 DAY" ) ;
	mysql_tquery ( sql_connection, "DELETE FROM `deposit_transfer` WHERE `dl_date` < NOW()-INTERVAL 30 DAY" ) ;

	mysql_tquery ( sql_connection, "DELETE FROM `money_logs` WHERE `date` < NOW()-INTERVAL 20 DAY" ) ;
	mysql_tquery ( sql_connection, "DELETE FROM `logs_all` WHERE `date` < NOW()-INTERVAL 20 DAY" ) ;
	mysql_tquery ( sql_connection, "DELETE FROM `users_complaints` WHERE `u_date` < NOW()-INTERVAL 20 DAY" ) ;
	mysql_tquery ( sql_connection, "DELETE FROM `businesses_history` WHERE `bh_date` < NOW()-INTERVAL 20 DAY" ) ;
	mysql_tquery ( sql_connection, "DELETE FROM `users_report` WHERE `date` < NOW()-INTERVAL 20 DAY" ) ;

	mysql_tquery ( sql_connection, "DELETE FROM `debtor_message` WHERE `dm_date` < NOW()-INTERVAL 10 DAY" ) ;
	mysql_tquery ( sql_connection, "DELETE FROM `users_history` WHERE `uh_date` < NOW()-INTERVAL 10 DAY" ) ;
	mysql_tquery ( sql_connection, "DELETE FROM `logs_report` WHERE `date` < NOW()-INTERVAL 10 DAY" ) ;
	mysql_tquery ( sql_connection, "DELETE FROM `logs_fractions` WHERE `date` < NOW()-INTERVAL 10 DAY" ) ;
	mysql_tquery ( sql_connection, "DELETE FROM `logs_family` WHERE `date` < NOW()-INTERVAL 10 DAY" ) ;

	mysql_tquery ( sql_connection, "DELETE FROM `users_case_storage` WHERE `date` < NOW()" ) ;
	return 1 ;
}

stock admin_clear ( )
{
    mysql_tquery ( sql_connection, "TRUNCATE `debtor_message`" ) ;
	mysql_tquery ( sql_connection, "TRUNCATE `money_logs`" ) ;
	mysql_tquery ( sql_connection, "TRUNCATE `logs_fractions`" ) ;
