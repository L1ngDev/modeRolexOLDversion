		rows ;

	cache_get_data ( rows, fields ) ;
	if( rows ) SendClientMessage ( playerid, col_orange, !"* Администрация ответила на Вашу жалобу! Используйте /checkrep, чтобы посмотреть ответ." ) ;
	return 1 ;
}

callback: callback_users_deposit_boxes ( playerid )
{
    new fields,
		rows ;

	cache_get_data ( rows, fields ) ;

	for ( new i = 0 ; i < MAX_BANK_ACCOUNT ; i ++ )
	{
  		bank_info [ playerid ] [ bi_id ] [ i ] =
		bank_info [ playerid ] [ bi_type ] [ i ] =
		bank_info [ playerid ] [ bi_pincode ] [ i ] =
		bank_info [ playerid ] [ bi_money ] [ i ] =
		bank_info [ playerid ] [ bi_credit ] [ i ] =
		bank_info [ playerid ] [ bi_pledge_type ] [ i ] =
		bank_info [ playerid ] [ bi_pledge ] [ i ] =
		bank_info [ playerid ] [ bi_reset ] [ i ] =
		bank_info [ playerid ] [ bi_credit_day ] [ i ] =
		bank_info [ playerid ] [ bi_credit_card ] [ i ] = 0 ;

		bank_info [ playerid ] [ bi_owner ] [ i ] =
		bank_info [ playerid ] [ bi_creditor ] [ i ] = -1 ;
	}

	if ( rows )
	{
		for ( new i = 0 ; i < rows ; i ++ )
		{
			bank_info [ playerid ] [ bi_id ] [ i ] = cache_get_field_content_int ( i, "db_id", sql_connection ) ;
			bank_info [ playerid ] [ bi_type ] [ i ] = cache_get_field_content_int ( i, "db_type", sql_connection ) ;
			bank_info [ playerid ] [ bi_owner ] [ i ] = cache_get_field_content_int ( i, "db_owner", sql_connection ) ;
			bank_info [ playerid ] [ bi_pincode ] [ i ] = cache_get_field_content_int ( i, "db_pincode", sql_connection ) ;
			bank_info [ playerid ] [ bi_money ] [ i ] = cache_get_field_content_int ( i, "db_money", sql_connection ) ;
			bank_info [ playerid ] [ bi_credit ] [ i ] = cache_get_field_content_int ( i, "db_credit", sql_connection ) ;
			bank_info [ playerid ] [ bi_pledge_type ] [ i ] = cache_get_field_content_int ( i, "db_pledge_type", sql_connection ) ;
			bank_info [ playerid ] [ bi_pledge ] [ i ] = cache_get_field_content_int ( i, "db_pledge", sql_connection ) ;
			bank_info [ playerid ] [ bi_reset ] [ i ] = cache_get_field_content_int ( i, "db_reset", sql_connection ) ;
			bank_info [ playerid ] [ bi_credit_day ] [ i ] = cache_get_field_content_int ( i, "db_credit_day", sql_connection ) ;
			bank_info [ playerid ] [ bi_credit_card ] [ i ] = cache_get_field_content_int ( i, "db_credit_card", sql_connection ) ;
			bank_info [ playerid ] [ bi_creditor ] [ i ] = cache_get_field_content_int ( i, "db_creditor", sql_connection ) ;

			if ( bank_info [ playerid ] [ bi_reset ] [ i ] != 0 && bank_info [ playerid ] [ bi_reset ] [ i ] < gettime ( ) )
			{
				new scm_string [ 96 + ( 2 * 9 ) ] ;
				new _new_password = random ( 8000 ) + 1000 ;
				format ( scm_string, sizeof scm_string, "Карта №%d перевыпущена! Пароль: %d.", bank_info [ playerid ] [ bi_id ] [ i ], _new_password ) ;
				insert_debtor_message ( "Банк", scm_string, p_info [ playerid ] [ id ] ) ;
				SendClientMessage ( playerid, col_white, scm_string ) ;

				format ( scm_string, sizeof scm_string, "UPDATE `deposit_boxes` SET `db_reset` = '0', `db_pincode` = '%d' WHERE `db_id` = '%d' LIMIT 1", _new_password, bank_info [ playerid ] [ bi_id ] [ i ] ) ;
				mysql_tquery ( sql_connection, scm_string ) ;
			}
		}
	}

	bank_player_account [ playerid ] = rows ;
	return 1 ;
}

callback: callback_users_accessories ( playerid )
{
	for ( new i = 0 ; i < 10 ; i ++ )
 	{
		if ( IsPlayerAttachedObjectSlotUsed ( playerid, i ) ) RemovePlayerAttachedObject ( playerid, i ) ;
  	}

	for ( new j = 0 ; j < MAX_ACCESORIES ; j ++ )
	{
		USER_ACCESSORIES [ playerid ] [ j ] = clearAccessoriesStruct ;
	}

    new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( rows )
	{
	    new unix_time = gettime ( ), sscanf_delimit [ 128 ], slotId ;
		for ( new i = 0 ; i < rows ; i ++ )
		{
			slotId = cache_get_field_content_int ( i, "acs_slot_id", sql_connection ) ;
			GetUserAccessories ( playerid, ACS_ID, slotId ) = cache_get_field_content_int ( i, "id", sql_connection ) ;
			GetUserAccessories ( playerid, ACS_MODEL, slotId ) = cache_get_field_content_int ( i, "acs_model_id", sql_connection ) ;
			GetUserAccessories ( playerid, ACS_USED, slotId ) = cache_get_field_content_int ( i, "acs_used", sql_connection ) ;
			GetUserAccessories ( playerid, ACS_DATE, slotId ) = cache_get_field_content_int ( i, "acs_date", sql_connection ) ;
			GetUserAccessories ( playerid, ACS_ITEM_ID, slotId ) = cache_get_field_content_int ( i, "acs_other_id", sql_connection ) ;
			GetUserAccessories ( playerid, ACS_COUNT, slotId ) = cache_get_field_content_int ( i, "sim_number", sql_connection ) ;

			if ( cache_get_field_content_int ( i, "uaf_id", sql_connection ) )
			{
				cache_get_field_content ( i, "acs_position", sscanf_delimit, sql_connection ) ;
				sscanf ( sscanf_delimit, "p<|>ffffff",
				GetUserAccessories ( playerid, ACS_OBJ_X, slotId ), GetUserAccessories ( playerid, ACS_OBJ_Y, slotId ), GetUserAccessories ( playerid, ACS_OBJ_Z, slotId ),
				GetUserAccessories ( playerid, ACS_ROT_X, slotId ), GetUserAccessories ( playerid, ACS_ROT_Y, slotId ), GetUserAccessories ( playerid, ACS_ROT_Z, slotId ) ) ;
			}

			if ( cache_get_field_content_int ( i, "uas_id", sql_connection ) )
			{
				GetUserAccessories ( playerid, ACS_LEVEL, slotId ) = cache_get_field_content_int ( i, "acs_level", sql_connection ) ;
				GetUserAccessories ( playerid, ACS_STRIPE, slotId ) = cache_get_field_content_int ( i, "acs_stripe", sql_connection ) ;
				GetUserAccessories ( playerid, ACS_WEAR, slotId ) = cache_get_field_content_int ( i, "acs_wear", sql_connection ) ;
			}

			if ( GetUserAccessories ( playerid, ACS_MODEL, slotId ) == ITEM_SIM_CARD || GetUserAccessories ( playerid, ACS_MODEL, slotId ) == 255 )
			{
				p_info [ playerid ] [ number ] = GetUserAccessories ( playerid, ACS_COUNT, slotId ) ;
			}

			if ( GetUserAccessories ( playerid, ACS_DATE, slotId ) != -1 )
			{
			    if ( GetUserAccessories ( playerid, ACS_DATE, slotId ) - unix_time < 0 )
			    {
			        new _acc_model = GetUserAccessories ( playerid, ACS_MODEL, slotId ) ;
					clear_accessories ( playerid, GetUserAccessories ( playerid, ACS_ID, slotId ) ) ;
					dropped_accessories ( GetUserAccessories ( playerid, ACS_ID, slotId ) ) ;

					new scm_string [ 90 + 32 ] ;
					format ( scm_string, sizeof scm_string, "Действие аксессуара %s подошло к концу.", get_accessorie_name ( _acc_model ) ) ;
					insert_debtor_message ( "Аксессуар", scm_string, p_info [ playerid ] [ id ] ) ;

					format ( scm_string, 100, "закончился срок %s", get_accessorie_name ( _acc_model ) ) ;
					WriteLog ( playerid, TYPE_LOG_ACESSORIES, scm_string ) ;
				}
			}
		}

		foreach(new forplayerid: streamed_players[playerid])
		{
			SetPlayerWeaponTexture ( playerid, forplayerid ) ;
		}
		SetPlayerWeaponTexture ( playerid, playerid ) ;
		attachUserAccessories ( playerid ) ;
	}

	SetInventoryCacheAcs ( playerid ) ;
	return 1 ;
}

stock load_player_business ( playerid )
{
    for ( new i = 0 ; i < b_count ; i ++ )
	{
	    if ( b_info [ i ] [ b_owner_inc ] != p_info [ playerid ] [ id ] ) continue ;

		new business_id = b_info [ i ] [ b_id ] ;
		Iter_Add(player_business[playerid], business_id);
		Iter_Add(business_players[business_id], playerid);

		if ( Iter_Count(player_business[playerid]) >= p_info [ playerid ] [ max_biz ] ) break ;
	}

	p_info [ playerid ] [ business ] = -1 ;
	return 1 ;
}

stock load_player_houses ( playerid )
{
    for ( new i = 0 ; i < house_count ; i++ )
	{
	    if ( h_info [ i ] [ h_owner ] != p_info [ playerid ] [ id ] ) continue ;

		new houses_id = h_info [ i ] [ h_id ] ;
		Iter_Add(player_houses[playerid], houses_id);

		if ( Iter_Count(player_houses[playerid]) >= p_info [ playerid ] [ max_house ] ) break ;
	}

	if ( p_info [ playerid ] [ house ] != -1 )
	{
		if ( ! Iter_Count(player_houses[playerid]) ) p_info [ playerid ] [ house ] = -1 ;
		else
		{
			new _c_house = 0 ;
		    foreach(new h: player_houses[playerid])
		    {
		        if ( p_info [ playerid ] [ house ] != h_info [ h - 1 ] [ h_id ] ) _c_house ++ ;
		    }

            if ( Iter_Count(player_houses[playerid]) == _c_house ) p_info [ playerid ] [ house ] = -1 ;
		}
	}
	else
	{
	    if ( Iter_Count(player_houses[playerid]) > 0 )
	    {
	    	p_info [ playerid ] [ house ] = Iter_First(player_houses[playerid]) ;
	    	update_int_sql ( playerid, "u_house", p_info [ playerid ] [ house ] ) ;
		}
	}
	return 1 ;
}

callback: users_vehicles_loading ( )
{
	new fields,
		rows ;

	cache_get_data ( rows, fields ) ;
	if( rows )
	{
		for ( new i = 0 ; i < rows ; i ++ )
		{
			new veh_id = GetVehicleID ( ) ;

			veh_info [ veh_id - 1 ] [ v_type ] = vehicle_type_carmarket ;

			veh_info [ veh_id - 1 ] [ v_id ] = cache_get_field_content_int ( i, "v_id", sql_connection ) ;
			veh_info [ veh_id - 1 ] [ v_model ] = cache_get_field_content_int ( i, "v_model", sql_connection ) ;
			veh_info [ veh_id - 1 ] [ v_owner ] = cache_get_field_content_int ( i, "v_owner", sql_connection ) ;
			veh_info [ veh_id - 1 ] [ v_color ] [ 0 ] = 0 ; //cache_get_field_content_int ( i, "v_color_1", sql_connection ) ;
			veh_info [ veh_id - 1 ] [ v_color ] [ 1 ] = 0 ; //cache_get_field_content_int ( i, "v_color_2", sql_connection ) ;

			new sscanf_delimit [ 126 ] ;
			cache_get_field_content ( i, "licence_plate_country", sscanf_delimit, sql_connection, 8 ) ;
			cache_get_field_content ( i, "licence_plate_number", veh_info [ veh_id - 1 ] [ v_plate ], sql_connection, 12 ) ;
			cache_get_field_content ( i, "licence_plate_region", veh_info [ veh_id - 1 ] [ v_region ], sql_connection, 12 ) ;

			if ( GetString ( sscanf_delimit, "RU POLICE" ) ) veh_info [ veh_id - 1 ] [ v_plate_type ] = NUMBERPLATE_TYPE_RU_POLICE ;
			else if ( GetString ( sscanf_delimit, "RU" ) ) veh_info [ veh_id - 1 ] [ v_plate_type ] = NUMBERPLATE_TYPE_RUS ;
			else if ( GetString ( sscanf_delimit, "UA" ) ) veh_info [ veh_id - 1 ] [ v_plate_type ] = NUMBERPLATE_TYPE_UA ;
			else if ( GetString ( sscanf_delimit, "BY" ) ) veh_info [ veh_id - 1 ] [ v_plate_type ] = NUMBERPLATE_TYPE_BY ;
			else if ( GetString ( sscanf_delimit, "KZ" ) ) veh_info [ veh_id - 1 ] [ v_plate_type ] = NUMBERPLATE_TYPE_KZ ;
			else veh_info [ veh_id - 1 ] [ v_plate_type ] = 1 ;

			veh_info [ veh_id - 1 ] [ v_fuel ] = cache_get_field_content_float ( i,"v_fuel", sql_connection ) ;
			veh_info [ veh_id - 1 ] [ v_millage ] = cache_get_field_content_float ( i,"v_millage", sql_connection ) ;
			veh_info [ veh_id - 1 ] [ v_legal_millage ] = cache_get_field_content_float ( i,"v_legal_millage", sql_connection ) ;

			veh_info [ veh_id - 1 ] [ v_rank ] = 0 ;

			veh_info [ veh_id - 1 ] [ v_pos ] [ 0 ] = cache_get_field_content_float ( i,"v_pos_x", sql_connection ) ;
			veh_info [ veh_id - 1 ] [ v_pos ] [ 1 ] = cache_get_field_content_float ( i,"v_pos_y", sql_connection ) ;
			veh_info [ veh_id - 1 ] [ v_pos ] [ 2 ] = cache_get_field_content_float ( i,"v_pos_z", sql_connection ) ;
			veh_info [ veh_id - 1 ] [ v_pos ] [ 3 ] = cache_get_field_content_float ( i,"v_pos_a", sql_connection ) ;

			veh_info [ veh_id - 1 ] [ v_sell_slot ] = cache_get_field_content_int ( i, "v_sell_slot", sql_connection ) ;
			veh_info [ veh_id - 1 ] [ v_sell_price ] = cache_get_field_content_int ( i, "v_sell_price", sql_connection ) ;
			veh_info [ veh_id - 1 ] [ v_sell_carmarket ] = cache_get_field_content_int ( i, "v_sell_carmarket", sql_connection ) ;

			veh_info [ veh_id - 1 ] [ v_price ] = cache_get_field_content_int ( i, "v_price", sql_connection ) ;

			veh_info [ veh_id - 1 ] [ v_pos ] [ 0 ] = car_market_pos [ veh_info [ veh_id - 1 ] [ v_sell_slot ] ] [ 0 ] ;
			veh_info [ veh_id - 1 ] [ v_pos ] [ 1 ] = car_market_pos [ veh_info [ veh_id - 1 ] [ v_sell_slot ] ] [ 1 ] ;
			veh_info [ veh_id - 1 ] [ v_pos ] [ 2 ] = car_market_pos [ veh_info [ veh_id - 1 ] [ v_sell_slot ] ] [ 2 ] ;
			veh_info [ veh_id - 1 ] [ v_pos ] [ 3 ] = car_market_pos [ veh_info [ veh_id - 1 ] [ v_sell_slot ] ] [ 3 ] ;

			veh_info [ veh_id - 1 ] [ v_vehicle ] = CreateVehicle ( veh_info [ veh_id - 1 ] [ v_model ], veh_info [ veh_id - 1 ] [ v_pos ] [ 0 ], veh_info [ veh_id - 1 ] [ v_pos ] [ 1 ], veh_info [ veh_id - 1 ] [ v_pos ] [ 2 ], veh_info [ veh_id - 1 ] [ v_pos ] [ 3 ], veh_info [ veh_id - 1 ] [ v_color ] [ 0 ], veh_info [ veh_id - 1 ] [ v_color ] [ 1 ], -1 ) ;
			SetVehicleNumberPlate ( veh_info [ veh_id - 1 ] [ v_vehicle ], veh_info [ veh_id - 1 ] [ v_plate ] ) ;

			global_string [ 0 ] = EOS ;
			format ( global_string, 300,"** Машина продаётся **\n{"#cGR3D"}Модель: {"#cWH3D"}%s\n{"#cGR3D"}Цена: {"#cWH3D"}%d"valute_title_"\n{"#cGR3D"}Номер: {"#cWH3D"}%s\n{"#cGR3D"}Пробег: {"#cWH3D"}%d км.\n\n{"#cGR3D"}Подойдите для взаимодействия",
			GetVehicleNameEx ( veh_id ),
			veh_info [ veh_id - 1 ] [ v_sell_price ],
			plate_number ( veh_id ),
			floatround ( veh_info [ veh_id - 1 ] [ v_millage ] ) ) ;
			if ( ! IsValidDynamic3DTextLabel ( veh_info [ veh_id - 1 ] [ v_sell_text ] ) )
			{
				veh_info [ veh_id - 1 ] [ v_sell_text ] = CreateDynamic3DTextLabel ( global_string, col_header_3d, 0.0, 0.0, 0.2, 5.0, INVALID_PLAYER_ID, veh_info [ veh_id - 1 ] [ v_vehicle ] ) ;
			}

			car_market_slotes_toggled [ veh_info [ veh_id - 1 ] [ v_sell_slot ] ] = true ;

			new engine, lights, alarm, doors, bonnet, boot, objective ;
			veh_info [ veh_id - 1 ] [ v_locked ] = false ;
			GetVehicleParamsEx ( veh_id, engine, lights, alarm, doors, bonnet, boot, objective ) ;
			SetVehicleParamsEx ( veh_id, engine, lights, alarm, false, bonnet, boot, objective ) ;

			format ( sscanf_delimit, sizeof sscanf_delimit, "SELECT * FROM `users_vehicles_handling` WHERE `v_handling_own_car_sql_id` = '%d' LIMIT 1", veh_info [ veh_id - 1 ] [ v_id ] ) ;
			mysql_tquery ( sql_connection, sscanf_delimit, "SetHandlingToOwnableCar", "is", veh_id, "users_vehicles_handling" ) ;

			format ( sscanf_delimit, sizeof sscanf_delimit, "SELECT * FROM `users_vehicles_tuning` WHERE `v_tuning_sql_id` = '%d' LIMIT 1", veh_info [ veh_id - 1 ] [ v_id ] ) ;
			mysql_tquery ( sql_connection, sscanf_delimit, "SetTuningToOwnableCar", "is", veh_id, "users_vehicles_tuning" ) ;

			format ( sscanf_delimit, sizeof sscanf_delimit, "SELECT * FROM `users_vehicles_component` WHERE `v_component_sql_id` = '%d' LIMIT 1", veh_info [ veh_id - 1 ] [ v_id ] ) ;
			mysql_tquery ( sql_connection, sscanf_delimit, "SetComponentToOwnableCar", "is", veh_id, "users_vehicles_component" ) ;

		}
	}
	return 1 ;
}

callback: check_referal ( playerid, inputtext [ ] )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows )
	{
		show_dialog ( playerid, d_reg_referal, DIALOG_STYLE_INPUT, "{"#cBHD"}Регистрация нового аккаунта -{"#cWH"} Реферал:", "{"#cWH"}Пожалуйста введите имя игрока, который пригласил Вас на данный сервер\n\n{"#cGRDialog"}* Для регистрации ник указывать не обязательно\n{"#cGRDialog"}* По достижению Вами 3 уровня игрок получит денежное вознаграждение\n\n{"#cRD"}* Ошибка! Данного аккаунта не существует.", "Далее", "Назад" ) ;
		return 1 ;
	}
	format ( reg_info [ playerid ] [ reg_referal ], MAX_PLAYER_NAME, "%s", inputtext ) ;
	reg_info [ playerid ] [ reg_referal_id ] = cache_get_field_content_int ( 0, "u_id", sql_connection ) ;

	show_register ( playerid ) ;
	return 1 ;
}

callback: callback_check_model ( _item_id )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;

	new _u_count = cache_get_field_content_int ( 0, "u_count" ) ;
	new _h_count = cache_get_field_content_int ( 0, "h_count" ) ;
	new _v_count = cache_get_field_content_int ( 0, "v_count" ) ;
	new _fam_count = cache_get_field_content_int ( 0, "fam_count" ) ;
	new _f_count = cache_get_field_content_int ( 0, "f_count" ) ;
	new _v_model = cache_get_field_content_int ( 0, "v_model" ) ;

	if ( MODEL_INFO [ _item_id ] [ MODEL_STATUS ] )
	{
		MODEL_INFO [ _item_id ] [ MODEL_STATUS ] = 0 ;

		static const _str [ ] = "UPDATE `model_info` SET `mi_status` = '0' WHERE `mi_model` = '%d' LIMIT 1" ;
		new sql_string [ sizeof _str + ( 2 * 9 ) ] ;
		format ( sql_string, sizeof sql_string, _str, _item_id ) ;
		mysql_tquery ( sql_connection, sql_string ) ;
	}

	new all_count = _u_count + _h_count + _v_count + _fam_count + _f_count + _v_model ;
	set_model_count ( _item_id, all_count ) ;
}

stock get_model_count ( _item_id )
{
	if ( MODEL_INFO [ _item_id ] [ MODEL_STATUS ] )
	{
		global_string [ 0 ] = EOS ;
		format ( global_string, sizeof global_string, "\
		SELECT \
			(SELECT IFNULL(SUM(inv_count), 0) FROM users_inventory WHERE inv_item = mi.mi_model) AS u_count, \
			(SELECT IFNULL(SUM(inv_count), 0) FROM houses_inventory WHERE inv_item = mi.mi_model) AS h_count, \
			(SELECT IFNULL(SUM(inv_count), 0) FROM users_vehicles_inventory WHERE inv_item = mi.mi_model) AS v_count, \
			(SELECT IFNULL(SUM(inv_count), 0) FROM familys_inventory WHERE inv_item = mi.mi_model) AS fam_count, \
			(SELECT IFNULL(SUM(inv_count), 0) FROM fractions_inventory WHERE inv_item = mi.mi_model) AS f_count, \
			(SELECT COUNT(v_model) FROM users_vehicles WHERE v_model = mi.mi_model) AS v_model \
		FROM model_info mi \
		WHERE mi.mi_model = %d", _item_id ) ;
		mysql_tquery ( sql_connection, global_string, "callback_check_model", "i", _item_id ) ;
	}

	return MODEL_INFO [ _item_id ] [ MODEL_COUNT ] ;
}

stock set_model_count ( modelId, modelCount )
{
    MODEL_INFO [ modelId ] [ MODEL_COUNT ] = modelCount ;

    static const _str [ ] = "UPDATE `model_info` SET `mi_count` = '%d' WHERE `mi_model` = '%d' LIMIT 1" ;
    new sql_string [ sizeof _str + ( 2 * 9 ) ] ;
    format ( sql_string, sizeof sql_string, _str, modelCount, modelId ) ;
    mysql_tquery ( sql_connection, sql_string ) ;

	if ( MODEL_INFO [ modelId ] [ MODEL_STATUS ] )
	{
		global_string [ 0 ] = EOS ;
		format ( global_string, sizeof global_string, "\
		SELECT \
			(SELECT IFNULL(SUM(inv_count), 0) FROM users_inventory WHERE inv_item = mi.mi_model) AS u_count, \
			(SELECT IFNULL(SUM(inv_count), 0) FROM houses_inventory WHERE inv_item = mi.mi_model) AS h_count, \
			(SELECT IFNULL(SUM(inv_count), 0) FROM users_vehicles_inventory WHERE inv_item = mi.mi_model) AS v_count, \
			(SELECT IFNULL(SUM(inv_count), 0) FROM familys_inventory WHERE inv_item = mi.mi_model) AS fam_count, \
			(SELECT IFNULL(SUM(inv_count), 0) FROM fractions_inventory WHERE inv_item = mi.mi_model) AS f_count, \
			(SELECT COUNT(v_model) FROM users_vehicles WHERE v_model = mi.mi_model) AS v_model \
		FROM model_info mi \
		WHERE mi.mi_model = %d", modelId ) ;
		mysql_tquery ( sql_connection, global_string, "callback_check_model", "i", modelId ) ;
	}
	return 1 ;
}

callback: model_info_loading ( )
{
    new rows, fields, time = GetTickCount ( ) ;
	cache_get_data ( rows, fields ) ;

	if ( rows )
	{
	    new _id ;
		for ( new i = 0 ; i < rows ; i ++ )
		{
		    _id = cache_get_field_content_int ( i, "mi_model", sql_connection ) ;
		    MODEL_INFO [ _id ] [ MODEL_COUNT ] = cache_get_field_content_int ( i, "mi_count", sql_connection ) ;
		    MODEL_INFO [ _id ] [ MODEL_STATUS ] = cache_get_field_content_int ( i, "mi_status", sql_connection ) ;

			MODEL_INFO [ _id ] [ MODEL_RENDER ] = -1 ;
			MODEL_INFO [ rows ] [ MODEL_TYPE ] [ 0 ] =
			MODEL_INFO [ rows ] [ MODEL_TYPE ] [ 1 ] =
			MODEL_INFO [ rows ] [ MODEL_TYPE ] [ 2 ] =
			MODEL_INFO [ rows ] [ MODEL_TYPE ] [ 3 ] =
			MODEL_INFO [ rows ] [ MODEL_TYPE ] [ 4 ] = 0 ;
		}
	}

	printf ( "[SERVER] Загружено %d информации об объектах. (%d ms)", rows, GetTickCount ( ) - time ) ;

	new line_string [ 144 ] ;
	if ( rows < MAX_MODEL_INFO )
	{
	   	MODEL_INFO [ rows ] [ MODEL_COUNT ] = 0 ;
		MODEL_INFO [ rows ] [ MODEL_RENDER ] = -1 ;
		for ( new i = 0 ; i < 5 ; i ++ ) MODEL_INFO [ rows ] [ MODEL_TYPE ] [ i ] = 0 ;

	    format ( line_string, sizeof line_string, "INSERT INTO `model_info` (`mi_id`,`mi_count`,`mi_model`) VALUES ('%d','0','%d')", rows + 1, rows + 1 ) ;
		mysql_tquery ( sql_connection, line_string ) ;

		SetTimerEx ( "model_info_insert", 2, false, "i", rows + 1 ) ;
	}

	for ( new i = 0 ; i < MAX_VEHICLE_MODELS ; i ++ )
  	{
		if ( ! veh_data [ i ] [ VEHICLE_CLASS_ID ] ) continue ;
		if ( veh_data [ i ] [ VEHICLE_CLASS_ID ] == VEHICLE_CLASS_DONATE ) continue ;

		model_info_type ( i, MODEL_TYPE_SHOP ) ;
		model_info_render ( i, MODEL_RENDER_VEHICLE ) ;
	}

	for ( new i = 0 ; i < MAX_SKIN_IN_SHOP ; i ++ )
  	{
		if ( shop_skins [ 0 ] [ i ] != 0 )
		{
			model_info_type ( shop_skins [ 0 ] [ i ], MODEL_TYPE_SHOP ) ;
			model_info_render ( shop_skins [ 0 ] [ i ], MODEL_RENDER_SKIN ) ;
		}
		if ( shop_skins [ 1 ] [ i ] != 0 )
		{
			model_info_type ( shop_skins [ 1 ] [ i ], MODEL_TYPE_SHOP ) ;
			model_info_render ( shop_skins [ 1 ] [ i ], MODEL_RENDER_SKIN ) ;
		}
	}

	for ( new i = 0 ; i < 14 ; i ++ )
  	{
  	    for ( new q = 0 ; q < 100 ; q ++ )
  	    {
			if ( accessories_items [ i ] [ q ] == 1 ) break ;

			model_info_type ( accessories_items [ i ] [ q ], MODEL_TYPE_SHOP ) ;
			model_info_render ( accessories_items [ i ] [ q ], MODEL_RENDER_OBJECT ) ;
		}
	}

	for ( new i = 0 ; i < sizeof donate_vehicles ; i ++ )
  	{
		model_info_type ( donate_vehicles [ i ] [ ModelId ], MODEL_TYPE_DONATE ) ;
		model_info_render ( donate_vehicles [ i ] [ ModelId ], MODEL_RENDER_VEHICLE ) ;
	}
	for ( new i = 0 ; i < sizeof donate_acs ; i ++ )
  	{
		model_info_type ( donate_acs [ i ] [ ModelId ], MODEL_TYPE_DONATE ) ;
		model_info_render ( donate_acs [ i ] [ ModelId ], MODEL_RENDER_OBJECT ) ;
	}
	for ( new i = 0 ; i < sizeof donate_skins ; i ++ )
  	{
		model_info_type ( donate_skins [ i ] [ ModelId ], MODEL_TYPE_DONATE ) ;
		model_info_render ( donate_skins [ i ] [ ModelId ], MODEL_RENDER_SKIN ) ;
	}
	for ( new i = 0 ; i < sizeof donate_services ; i ++ )
  	{
		model_info_type ( donate_services [ i ] [ ModelId ], MODEL_TYPE_DONATE ) ;
		model_info_render ( donate_services [ i ] [ ModelId ], MODEL_NO_RENDER ) ;
	}

	for ( new i = 0 ; i < MAX_CRAFT ; i ++ )
	{
		if ( craft_info [ i ] [ c_type ] == 1 )
		{
			model_info_type ( craft_info [ i ] [ c_item ], MODEL_TYPE_CRAFT ) ;
			model_info_render ( craft_info [ i ] [ c_item ], MODEL_RENDER_VEHICLE ) ;
		}
		else if ( craft_info [ i ] [ c_type ] == 2 )
		{
			model_info_type ( craft_info [ i ] [ c_give_item ], MODEL_TYPE_CRAFT ) ;
			model_info_render ( craft_info [ i ] [ c_give_item ], MODEL_RENDER_SKIN ) ;
		}
		else if ( craft_info [ i ] [ c_type ] == 0 )
		{
			model_info_type ( craft_info [ i ] [ c_item ], MODEL_TYPE_CRAFT ) ;
			model_info_render ( craft_info [ i ] [ c_item ], MODEL_RENDER_OBJECT ) ;
		}
		else
		{
			model_info_type ( craft_info [ i ] [ c_item ], MODEL_TYPE_CRAFT ) ;
			model_info_render ( craft_info [ i ] [ c_item ], MODEL_NO_RENDER ) ;
		}
	}

	for ( new i = 0 ; i < MAX_FAMILY_TRADE_ITEM ; i ++ )
	{
		if ( family_trade [ i ] [ family_render_type ] == 1 )
		{
			model_info_type ( family_trade [ i ] [ family_prise ], MODEL_TYPE_FAMILY ) ;
			model_info_render ( family_trade [ i ] [ family_prise ], MODEL_RENDER_VEHICLE ) ;
		}
		else if ( family_trade [ i ] [ family_render_type ] == 2 )
		{
			model_info_type ( family_trade [ i ] [ family_prise ], MODEL_TYPE_FAMILY ) ;
			model_info_render ( family_trade [ i ] [ family_prise ], MODEL_RENDER_SKIN ) ;
		}
		else if ( family_trade [ i ] [ family_render_type ] == 0 )
		{
			model_info_type ( family_trade [ i ] [ family_prise ], MODEL_TYPE_FAMILY ) ;
			model_info_render ( family_trade [ i ] [ family_prise ], MODEL_RENDER_OBJECT ) ;
		}
		else
		{
			model_info_type ( family_trade [ i ] [ family_prise ], MODEL_TYPE_FAMILY ) ;
			model_info_render ( family_trade [ i ] [ family_prise ], MODEL_NO_RENDER ) ;
		}
	}
	mysql_tquery ( sql_connection, !"SELECT * FROM `model_stats`", "model_stats_loading" ) ;
	return 1 ;
}

callback: model_stats_loading ( )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows ) return false ;

	new modelId ;
	for ( new i = 0 ; i < rows ; i ++ )
	{
		modelId = cache_get_field_content_int ( i, "mi_id", sql_connection ) ;
		GetModelStatsMax ( modelId ) = 0 ;

		global_string [ 0 ] = EOS ;
		cache_get_field_content ( i, "mi_special", global_string, sql_connection ) ;
		JsonConvertModelStats ( global_string, "special_upgrade", ACS_STATS_SPECIAL, modelId ) ;

		global_string [ 0 ] = EOS ;
		cache_get_field_content ( i, "mi_weapon", global_string, sql_connection ) ;
		JsonConvertModelStats ( global_string, "weapon_upgrade", ACS_STATS_WEAPON, modelId ) ;

		global_string [ 0 ] = EOS ;
		cache_get_field_content ( i, "mi_resources", global_string, sql_connection ) ;
		JsonConvertModelStats ( global_string, "res_upgrade", -1, modelId ) ;

		global_string [ 0 ] = EOS ;
		cache_get_field_content ( i, "mi_chance", global_string, sql_connection ) ;
		JsonConvertModelStats ( global_string, "chance_upgrade", -2, modelId ) ;

		global_string [ 0 ] = EOS ;
		cache_get_field_content ( i, "mi_lucky", global_string, sql_connection ) ;
		JsonConvertModelStats ( global_string, "lucky_upgrade", ACS_STATS_LUCKY, modelId ) ;

		global_string [ 0 ] = EOS ;
		cache_get_field_content ( i, "mi_damage", global_string, sql_connection ) ;
		JsonConvertModelStats ( global_string, "damage_upgrade", ACS_STATS_DAMAGE, modelId ) ;

		global_string [ 0 ] = EOS ;
		cache_get_field_content ( i, "mi_guard", global_string, sql_connection ) ;
		JsonConvertModelStats ( global_string, "guard_upgrade", ACS_STATS_GUARD, modelId ) ;

		global_string [ 0 ] = EOS ;
		cache_get_field_content ( i, "mi_critical", global_string, sql_connection ) ;
		JsonConvertModelStats ( global_string, "critical_upgrade", ACS_STATS_CRITICAL, modelId ) ;

		global_string [ 0 ] = EOS ;
		cache_get_field_content ( i, "mi_max_hp", global_string, sql_connection ) ;
		JsonConvertModelStats ( global_string, "max_hp_upgrade", ACS_STATS_MAX_HP, modelId ) ;

		global_string [ 0 ] = EOS ;
		cache_get_field_content ( i, "mi_max_arm", global_string, sql_connection ) ;
		JsonConvertModelStats ( global_string, "max_arm_upgrade", ACS_STATS_MAX_ARM, modelId ) ;

		global_string [ 0 ] = EOS ;
		cache_get_field_content ( i, "mi_refl", global_string, sql_connection ) ;
		JsonConvertModelStats ( global_string, "refl_upgrade", ACS_STATS_REFL, modelId ) ;

		global_string [ 0 ] = EOS ;
		cache_get_field_content ( i, "mi_bleeding", global_string, sql_connection ) ;
		JsonConvertModelStats ( global_string, "bleeding_upgrade", ACS_STATS_BLEEDING, modelId ) ;

		global_string [ 0 ] = EOS ;
		cache_get_field_content ( i, "mi_repair", global_string, sql_connection ) ;
		JsonConvertModelStats ( global_string, "repair_upgrade", ACS_STATS_REPAIR, modelId ) ;

		GetModelWearMax ( modelId ) = cache_get_field_content_int ( i, "mi_wear", sql_connection ) ;
	}
	return true ;
}

stock JsonConvertModelStats ( data [ ], nameUpgrade [ ], upgradeId, modelId )
{
	new idx = 0 ;
	if ( strlen ( data ) > 5 )
	{
		new Node: json, Node: nodeIterate, Node: nodeWrite ;
		JSON_Parse ( data, json ) ;

		JSON_GetArray ( json, nameUpgrade, nodeIterate ) ;

		while ( ! JSON_ArrayObject ( nodeIterate, idx, nodeWrite ) )
		{
			if ( upgradeId == -1 )
			{
				JSON_GetInt ( nodeWrite, "item_1", GetModelStatsRes ( modelId, idx, 0 ) ) ;
				JSON_GetInt ( nodeWrite, "count_1", GetModelStatsResCount ( modelId, idx, 0 ) ) ;
				JSON_GetInt ( nodeWrite, "item_2", GetModelStatsRes ( modelId, idx, 1 ) ) ;
				JSON_GetInt ( nodeWrite, "count_2", GetModelStatsResCount ( modelId, idx, 1 ) ) ;
			}
			else if ( upgradeId == ACS_STATS_REPAIR )
			{
				JSON_GetInt ( nodeWrite, "item_1", GetModelRepairRes ( modelId, 0 ) ) ;
				JSON_GetInt ( nodeWrite, "count_1", GetModelRepairResCount ( modelId, 0 ) ) ;
				JSON_GetInt ( nodeWrite, "item_2", GetModelRepairRes ( modelId, 1 ) ) ;
				JSON_GetInt ( nodeWrite, "count_2", GetModelRepairResCount ( modelId, 1 ) ) ;
			}
			else if ( upgradeId == -2 )
			{
				JSON_GetInt ( nodeWrite, "stats", GetModelStatsChance ( modelId, idx ) ) ;
			}
			else
			{
				JSON_GetInt ( nodeWrite, "level", GetModelStatsLevel ( upgradeId, modelId, idx ) ) ;
				JSON_GetInt ( nodeWrite, "stats", GetModelStatsInfo ( upgradeId, modelId, idx ) ) ;
			}
			idx ++ ;
		}
		GetModelStatsMax ( modelId ) = idx ;
	}

	if ( upgradeId >= 0 )
	{
		for ( new i = idx ; i < MAX_MODEL_STATS ; i ++ )
		{
			GetModelStatsLevel ( upgradeId, modelId, i ) =
			GetModelStatsInfo ( upgradeId, modelId, i ) = -1 ;
		}
	}
	return true ;
}

stock get_model_type ( _model_id, _id )
{
	return MODEL_INFO [ _model_id ] [ MODEL_TYPE ] [ _id ] ;
}

stock model_info_type ( _model_id, _type )
{
	for ( new i = 0 ; i < 5 ; i ++ )
	{
	    if ( MODEL_INFO [ _model_id ] [ MODEL_TYPE ] [ i ] != 0 ) continue ;

	    MODEL_INFO [ _model_id ] [ MODEL_TYPE ] [ i ] = _type ;
	    break ;
	}
	return 1 ;
}

stock get_model_render ( _model_id )
{
	return MODEL_INFO [ _model_id ] [ MODEL_RENDER ] ;
}

stock model_info_render ( _model_id, _type )
{
    MODEL_INFO [ _model_id ] [ MODEL_RENDER ] = _type ;
	return 1 ;
}

callback: model_info_insert ( _count )
{
	if ( _count >= MAX_MODEL_INFO ) return 1 ;
	MODEL_INFO [ _count ] [ MODEL_COUNT ] = 0 ;
	MODEL_INFO [ _count ] [ MODEL_RENDER ] = -1 ;
	for ( new i = 0 ; i < 5 ; i ++ ) MODEL_INFO [ _count ] [ MODEL_TYPE ] [ i ] = 0 ;

	new line_string [ 144 ] ;
   	format ( line_string, sizeof line_string, "INSERT INTO `model_info` (`mi_id`,`mi_count`,`mi_model`) VALUES ('%d','0','%d')", _count + 1, _count + 1 ) ;
	mysql_tquery ( sql_connection, line_string ) ;

	SetTimerEx ( "model_info_insert", 2, false, "i", _count + 1 ) ;
	return 1 ;
}

