					f_info [ i ] [ f_name ] ) ;

					gdorm_text [ i ] = CreateDynamic3DTextLabel ( t_string, col_header_3d, dorm_pos [ i ] [ 0 ], dorm_pos [ i ] [ 1 ], dorm_pos [ i ] [ 2 ] + 1, 10.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, dorm_virt [ i ], dorm_int [ i ] ) ;
				}
			}
		}

		static const _str_army [ ] = "*** Склад %s ***\n{"#cGR3D"}Встаньте на пикап для кражи боеприпасов" ;
		new t_string [ sizeof _str_army + 32 ] ;
