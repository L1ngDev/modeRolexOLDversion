CMD:free ( playerid, params [ ] )
{
	if ( ! gov_player ( playerid ) && ! mayor_player ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команда доступна только для сотрудников правительства." ) ;
	if ( p_info [ playerid ] [ rank ] != 3 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данная команда доступна на должности адвоката." ) ;
	if ( sscanf ( params, "ud", params [ 0 ], params [ 1 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /free [id/имя] [цена]") ;

	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете применить это к самому себе." ) ;
	if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;
	if ( ! bad_dialog ( params [ 0 ] ) || ! bad_dialog ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Недоступно в данный момент.") ;
    if ( p_info [ params [ 0 ] ] [ jail ] < 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не находится в заключении." ) ;
    if ( params [ 1 ] < 1 || params [ 1 ] > 100000 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Стоимость услуг должна составлять от {"#cRD"}1"valute_title_"{"#cGRInfo"} до {"#cRD"}100.000"valute_title"{"#cGRInfo"}." ) ;
	if ( cooldown_sentence [ playerid ] > gettime ( ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Предложение о сделке можно отправлять один раз в {"#cRD"}45 секунд{"#cGRInfo"}." ) ;

    cooldown_sentence [ playerid ] = gettime ( ) + time_sell_sentence ;

	buyer_id [ playerid ] = params [ 0 ] ;
	sell_price [ playerid ] = params [ 1 ] ;
	seller_id [ params [ 0 ] ] = playerid ;

	sell_time { playerid } =
	sell_time { params [ 0 ] } = time_sell_null ;

	new dialog_string [ 90 + MAX_PLAYER_NAME + 32 + 1 + 6 ] ;
	format ( dialog_string, sizeof ( dialog_string  ), "Вы предложили {"#cGN"}%s{"#cWH"} услуги адвоката за {"#cGN"}%d"valute_title_"",
	p_info [ params [ 0 ] ] [ name ], params [ 1 ] ) ;
	SendClientMessage ( params [ 0 ], -1, dialog_string ) ;

	format ( dialog_string, sizeof ( dialog_string  ), "{"#cBL"}%s {FFFFFF}предлагает Вам услуги адвоката за {"#cBL"}%d"valute_title_"\n\n{"#cGRDialog"}* Срок Вашего заключения будет сокращён на 65 процентов.",
	p_info [ playerid ] [ name ], params [ 1 ] ) ;
	show_dialog ( params [ 0 ], d_free_accept, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Услуги адвоката", dialog_string, "Принять", "Отмена" ) ;
	return 1 ;
}

CMD:sellplates ( playerid, params [ ] )
{
	if ( ! cop_player ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команда доступна только для полиции." ) ;
    if ( p_info [ playerid ] [ hour_played ] < THREE_HOUR_PLAYED ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Доступно с 3 часов в игре. Используйте /mm - Информация о персонаже - Статистика персонажа." ) ;
    if ( p_info [ playerid ] [ rank ] < 5 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Доступно с 5 ранга." ) ;
	if ( sscanf ( params, "ud", params [ 0 ], params [ 1 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /sellplates [id/имя] [цена]") ;
	if ( params [ 1 ] < 1 || params [ 1 ] > 10000 || params [ 1 ] == INVALID_PRICE ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Цена должна быть от {"#cRD"}1"valute_title_"{"#cGRInfo"} до {"#cRD"}10.000"valute_title"{"#cGRInfo"}." ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете применить это к самому себе." ) ;
	if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;
	if ( ! bad_dialog ( params [ 0 ] ) || ! bad_dialog ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Недоступно в данный момент.") ;
    if ( p_info [ params [ 0 ] ] [ hour_played ] < THREE_HOUR_PLAYED ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не отыграл 3 часа." ) ;
	if ( cooldown_sentence [ playerid ] > gettime ( ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Предложение о сделке можно отправлять один раз в {"#cRD"}45 секунд{"#cGRInfo"}." ) ;

	cooldown_sentence [ playerid ] = gettime ( ) + time_sell_sentence ;

	buyer_id [ playerid ] = params [ 0 ] ;
	sell_price [ playerid ] = params [ 1 ] ;
	seller_id [ params [ 0 ] ] = playerid ;

	sell_time { playerid } =
	sell_time { params [ 0 ] } = time_sell_null ;

	new dialog_string [ 156 ] ;
	format ( dialog_string, sizeof ( dialog_string ), "{"#cBL"}%s {FFFFFF}предлагает Вам приобрести {"#cWV"}попытку подбора номеров {FFFFFF} за {"#cGN"}%d"valute_title_"",
	p_info [ playerid ] [ name ], params [ 1 ] ) ;
	show_dialog ( params [ 0 ], d_plates_sell_accept, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Покупка попытки подбора номера", dialog_string, "Купить", "Отмена" ) ;
	return true ;
}

CMD:ram ( playerid )
{
	if ( ! cop_player ( playerid ) && ! fbi_player ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команда доступна только для гос. организаций." ) ;
	new is_near_house = -1 ;
	for ( new h = 0 ; h < house_count ; h ++ )
	{
		if ( ! IsPlayerInRangeOfPoint ( playerid, 4.0, h_info [ h ] [ h_pos ] [ 0 ], h_info [ h ] [ h_pos ] [ 1 ], h_info [ h ] [ h_pos ] [ 2 ] ) ) continue ;
  		is_near_house = h ;
		SetPVarInt ( playerid, "house_id", h + 1 ) ;
		new hint = h_info [ h ] [ h_int ] - 1 ;
		set_pos ( playerid, house_int [ hint ] [ hint_position ] [ 0 ], house_int [ hint ] [ hint_position ] [ 1 ], house_int [ hint ] [ hint_position ] [ 2 ], house_int [ hint ] [ hint_position ] [ 3 ], house_int [ hint ] [ hint_int ], h_info [ h ] [ h_id ] ) ;
		break ;
	}
	if ( is_near_house == -1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны находиться возле дома." ) ;

	static const _str [ ] = "{"#cGInfo"}* {"#cWH"}Вы выбили дверь дома. Владелец дома {"#cGN"}%s" ;
	new scm_string [ sizeof _str + 24 ] ;
	format ( scm_string, sizeof ( scm_string ), _str, h_info [ is_near_house ] [ h_owner_name ] ) ;
	SendClientMessage ( playerid, col_white, scm_string ) ;

	me_action ( playerid, "выбил(-а) дверь дома" ) ;
	return 1 ;
}

