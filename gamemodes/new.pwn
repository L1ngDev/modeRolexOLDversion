    	format ( scm_string, sizeof ( scm_string ), "{"#cBAdmin"}[A] {"#cGRAdmin"}%d вопросов ожидает ответа более 40 минут. Используйте (/arep).", rows ) ;
    	foreach(new i: admin_players)SendClientMessage ( i, col_admin, scm_string ) ;
