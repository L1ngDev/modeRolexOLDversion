stock sell_debtors ( playerid, type = 0 )
{
	if ( type == 1 )
	{
	    new _pl_id, s_house_id = p_t_info [ playerid ] [ debt_house ],
			debt_id = h_info [ s_house_id - 1 ] [ h_owner ] ;

        if ( ! h_info [ s_house_id - 1 ] [ h_sell_status ] )
		{
			SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данную недвижимость уже опечатали." ) ;

			p_t_info [ playerid ] [ debt_house ] = -1 ;
			return 1 ;
        }

		sscanf ( h_info [ s_house_id - 1 ] [ h_owner_name ], "u", _pl_id ) ;

		new scm_string [ 144 ] ;
		format ( scm_string, sizeof scm_string, "Опечатал(а) имущество должника %s (Дом №%d)", h_info [ s_house_id - 1 ] [ h_owner_name ], h_info [ s_house_id - 1 ] [ h_id ]);
		write_fraction ( playerid, p_info [ playerid ] [ member ], TYPE_LOG_OBWYAK, scm_string ) ;

		#if defined m_fractions
			   give_emp_progress ( playerid, 0, 1 ) ;
		#endif

		if ( IsPlayerConnected ( _pl_id ) )
		{
		    sell_houses ( s_house_id - 1, -1, false, false ) ;

			new _sql_string [ 100 ] ;
            h_info [ s_house_id - 1 ] [ h_meeting ] = SetElapsedTime ( gettime ( ), random ( 24 ) + 1, CONVERT_TIME_TO_HOURS ) ;
			format ( _sql_string, sizeof( _sql_string ), "UPDATE `houses` SET `h_meeting` = '%d' WHERE `h_id` = '%d' LIMIT 1", h_info [ s_house_id - 1 ] [ h_meeting ], s_house_id ) ;
			mysql_tquery ( sql_connection, _sql_string ) ;

	        if ( h_info [ s_house_id - 1 ] [ h_podezd ] != -1 ) update_podezd ( h_info [ s_house_id - 1 ] [ h_podezd ] ) ;

			p_info [ _pl_id ] [ house ] = -1 ;
			Iter_Remove(player_houses[_pl_id], h_info [ s_house_id - 1 ] [ h_id ]);

			SendClientMessage ( _pl_id, col_gray, !"* Сотрудники мэрии изъяли Вашу недвижимость в счёт оплаты долгов." ) ;
			SendClientMessage ( _pl_id, col_gray, !"* Остаточная стоимость была переведена на Ваш банковский счёт." ) ;

			new _text_string [ 148 ] ;
			new _debt_tax = GetPVarInt ( playerid, "debt_tax" ) ;
			if ( h_info [ s_house_id - 1 ] [ h_price ] > _debt_tax )
			{
				format(_text_string, 128, "UPDATE `users` SET `u_tax` = '0' WHERE `u_id` = '%d' LIMIT 1", debt_id ) ;
				mysql_tquery ( sql_connection, _text_string ) ;

                insert_return_money ( "Продажа дома (опечатка)", h_info [ s_house_id - 1 ] [ h_price ] - _debt_tax, debt_id ) ;

				p_info [ _pl_id ] [ tax ] = 0 ;
			}
			else
			{
				format(_text_string, 128, "UPDATE `users` SET `u_tax` = `u_tax`-'%d' WHERE `u_id` = '%d' LIMIT 1",
				h_info [ s_house_id - 1 ] [ h_price ], debt_id ) ;
				mysql_tquery ( sql_connection, _text_string ) ;

				p_info [ _pl_id ] [ tax ] -= h_info [ s_house_id - 1 ] [ h_price ] ;
			}
		}
		else
		{
			sell_houses ( s_house_id - 1, -1, false, false ) ;

            new _sql_string [ 100 ] ;
			h_info [ s_house_id - 1 ] [ h_meeting ] = SetElapsedTime ( gettime ( ), random ( 24 ) + 1, CONVERT_TIME_TO_HOURS ) ;
			format ( _sql_string, sizeof( _sql_string ), "UPDATE `houses` SET `h_meeting` = '%d' WHERE `h_id` = '%d' LIMIT 1", h_info [ s_house_id - 1 ] [ h_meeting ], s_house_id ) ;
			mysql_tquery ( sql_connection, _sql_string ) ;


	        if ( h_info [ s_house_id - 1 ] [ h_podezd ] != -1 ) update_podezd ( h_info [ s_house_id - 1 ] [ h_podezd ] ) ;

			insert_debtor_message ( "Налоги", "Ваш дом был изъят сотрудниками мэрии в счёт оплаты налогов.\n\
												Остаточная стоимость была переведена на Ваш банковский счёт.", debt_id ) ;

            new _text_string [ 148 ] ;
			new _debt_tax = GetPVarInt ( playerid, "debt_tax" ) ;
			if ( h_info [ s_house_id - 1 ] [ h_price ] > _debt_tax )
			{
			    _text_string [ 0 ] = EOS ;
				format ( _text_string, 128, "UPDATE `users` SET `u_tax` = '0' WHERE `u_id` = '%d' LIMIT 1", debt_id ) ;
				mysql_tquery ( sql_connection, _text_string ) ;

				insert_return_money ( "Продажа дома (опечатка)", h_info [ s_house_id - 1 ] [ h_price ] - _debt_tax, debt_id ) ;
			}
			else
			{
			    _text_string [ 0 ] = EOS ;
				format ( _text_string, 128, "UPDATE `users` SET `u_tax` = `u_tax`-'%d' WHERE `u_id` = '%d' LIMIT 1",
				h_info [ s_house_id - 1 ] [ h_price ], debt_id ) ;
				mysql_tquery ( sql_connection, _text_string ) ;
			}
		}

		new Float: pos [ 4 ] ;
  		get_gz_pos ( h_info [ s_house_id - 1 ] [ h_pos ] [ 0 ], h_info [ s_house_id - 1 ] [ h_pos ] [ 1 ], 50.0, pos [ 0 ], pos [ 1 ], pos [ 2 ], pos [ 3 ] ) ;
		h_info [ s_house_id - 1 ] [ h_zz_area ] = CreateDynamicRectangle ( pos [ 0 ], pos [ 1 ], pos [ 2 ], pos [ 3 ], -1, -1, -1 ) ;
		area_info [ h_info [ s_house_id - 1 ] [ h_zz_area ] ] [ a_type ] = area_type_sellstatus ;
		area_info [ h_info [ s_house_id - 1 ] [ h_zz_area ] ] [ a_item ] = h_info [ s_house_id - 1 ] [ h_id ] ;

		new _value = floatround ( ( h_info [ s_house_id - 1 ] [ h_price ] * 5 ) / 100 ) ;
		give_money ( playerid, _value ) ;
		insert_money_log ( playerid, INVALID_PLAYER_ID, _value, "опечатка дома" ) ;

		p_t_info [ playerid ] [ debt_house ] = -1 ;

		clear_fam_house ( playerid, s_house_id, 1 ) ;

        format ( scm_string, sizeof ( scm_string ), "< Радио %s > Государственные изменения: Опечатан дом №%d.", f_info [ 26 ] [ f_letter_name ], h_info [ s_house_id - 1 ] [ h_id ] ) ;
		foreach(new i: logged_players) if ( p_info [ i ] [ radio ] == 27 ) SendClientMessage ( i, 0x10ACF6FF, scm_string ) ;

		SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Вы опечатали имущество." ) ;
	}
	else if ( type == 2 )
	{
		new _pl_id, business_id = p_t_info [ playerid ] [ debt_business ] - 1,
		    debt_id = b_info [ business_id ] [ b_owner_inc ] ;

        if ( ! b_info [ business_id ] [ b_sell_status ] )
		{
			SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данную недвижимость уже опечатали." ) ;
			p_t_info [ playerid ] [ debt_business ] = -1 ;
			return 1 ;
        }

		sscanf ( b_info [ business_id ] [ b_owner_name ], "u", _pl_id ) ;

		new scm_string [ 144 ] ;
		format ( scm_string, sizeof scm_string, "Опечатал(а) имущество должника %s (%s)", b_info [ business_id ] [ b_owner_name ], b_types [ b_info [ business_id ] [ b_type ] ] ) ;
		write_fraction ( playerid, p_info [ playerid ] [ member ], TYPE_LOG_OBWYAK, scm_string ) ;

        #if defined m_fractions
			   give_emp_progress ( playerid, 0, 1 ) ;
		#endif

		if ( IsPlayerConnected ( _pl_id ) )
		{
		    sell_businesses ( business_id, -1, false, false ) ;

			new _sql_string [ 100 ] ;
            b_info [ business_id ] [ b_meeting ] = SetElapsedTime ( gettime ( ), random ( 24 ) + 1, CONVERT_TIME_TO_HOURS ) ;
			format ( _sql_string, sizeof( _sql_string ), "UPDATE `businesses` SET `b_meeting` = '%d' WHERE `b_id` = '%d' LIMIT 1", b_info [ business_id ] [ b_meeting ], b_info [ business_id ] [ b_id ]  ) ;
			mysql_tquery ( sql_connection, _sql_string ) ;

            new query_string [ 148 + MAX_PLAYER_NAME + 1 ] ;
			new _debt_tax = GetPVarInt ( playerid, "debt_tax" ) ;
			if ( b_info [ business_id ] [ b_price ] > _debt_tax )
			{
				format(query_string, 166, "UPDATE `users` SET `u_tax` = '0' WHERE `u_id` = '%d' LIMIT 1", debt_id ) ;
				mysql_tquery ( sql_connection, query_string ) ;

				insert_return_money ( "Продажа бизнеса (опечатка)", b_info [ business_id ] [ b_price ] - _debt_tax, debt_id ) ;

				p_info [ _pl_id ] [ tax ] = 0 ;
			}
			else
			{
				format(query_string, 166, "UPDATE `users` SET `u_tax` = `u_tax`-'%d' WHERE `u_id` = '%d' LIMIT 1",
				b_info [ business_id ] [ b_price ], debt_id ) ;
				mysql_tquery ( sql_connection, query_string ) ;

				p_info [ _pl_id ] [ tax ] -= b_info [ business_id ] [ b_price ] ;
			}

			p_info [ _pl_id ] [ business ] = -1 ;
			Iter_Remove(player_business[_pl_id], b_info [ business_id ][ b_id ]);

			p_info [ _pl_id ] [ business_rang ] = 0 ;
			update_int_sql ( _pl_id, "u_business_rang", 0 ) ;

			SendClientMessage ( _pl_id, col_gray, !"* Сотрудники мэрии изъяли Вашу недвижимость в счёт оплаты долгов." ) ;
			SendClientMessage ( _pl_id, col_gray, !"* Остаточная стоимость была переведена на Ваш банковский счёт." ) ;
		}
		else
		{
            sell_businesses ( business_id, -1, false, false ) ;

			new _sql_string [ 100 ] ;
			b_info [ business_id ] [ b_meeting ] = SetElapsedTime ( gettime ( ), random ( 24 ) + 1, CONVERT_TIME_TO_HOURS ) ;
			format ( _sql_string, sizeof( _sql_string ), "UPDATE `businesses` SET `b_meeting` = '%d' WHERE `b_id` = '%d' LIMIT 1", b_info [ business_id ] [ b_meeting ], b_info [ business_id ] [ b_id ]  ) ;
			mysql_tquery ( sql_connection, _sql_string ) ;

			new _query_string [ 148 + MAX_PLAYER_NAME + 1 ] ;
			new __debt_tax = GetPVarInt ( playerid, "debt_tax" ) ;
			if ( b_info [ business_id ] [ b_price ] > __debt_tax )
			{
				format(_query_string, 128, "UPDATE `users` SET `u_tax` = '0' WHERE `u_id` = '%d' LIMIT 1", debt_id ) ;
				mysql_tquery ( sql_connection, _query_string ) ;

				insert_return_money ( "Продажа бизнеса (опечатка)", b_info [ business_id ] [ b_price ] - __debt_tax, debt_id ) ;
			}
			else
			{
				format(_query_string, 128, "UPDATE `users` SET `u_tax` = `u_tax`-'%d' WHERE `u_id` = '%d' LIMIT 1",
				b_info [ business_id ] [ b_price ], debt_id ) ;
				mysql_tquery ( sql_connection, _query_string ) ;
			}

			insert_debtor_message ( "Налоги", "Ваш бизнес был изъят сотрудниками мэрии в счёт оплаты налогов.\n\
											Остаточная стоимость была переведена на Ваш банковский счёт.", debt_id ) ;
		}

		new Float: pos [ 4 ] ;
  		get_gz_pos ( b_info [ business_id ] [ b_position ] [ 0 ], b_info [ business_id ] [ b_position ] [ 1 ], 50.0, pos [ 0 ], pos [ 1 ], pos [ 2 ], pos [ 3 ] ) ;
		b_info [ business_id ] [ b_zz_area ] = CreateDynamicRectangle ( pos [ 0 ], pos [ 1 ], pos [ 2 ], pos [ 3 ], -1, -1, -1 ) ;
		area_info [ b_info [ business_id ] [ b_zz_area ] ] [ a_type ] = area_type_sellstatus ;

		new _value = floatround ( ( b_info [ business_id ] [ b_price ] * 5 ) / 100 ) ;
		give_money ( playerid, _value ) ;
		insert_money_log ( playerid, INVALID_PLAYER_ID, _value, "опечатка бизнеса" ) ;

    	p_t_info [ playerid ] [ debt_business ] = -1 ;

		format ( scm_string, sizeof ( scm_string ), "< Радио %s > Государственные изменения: Опечатан бизнес '%s' (%s).", f_info [ 26 ] [ f_letter_name ], b_info [ business_id ] [ b_name ], b_types [ b_info [ business_id ] [ b_type ] ] ) ;
		foreach(new i: logged_players) if ( p_info [ i ] [ radio ] == 27 ) SendClientMessage ( i, 0x10ACF6FF, scm_string ) ;

		SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Вы опечатали имущество." ) ;
	}
	else if ( type == 3 )
	{
	    new _pl_id, s_house_id = p_t_info [ playerid ] [ debt_cellar ],
		    debt_id = cellar_info [ s_house_id - 1 ] [ cl_owner ] ;

        if ( ! cellar_info [ s_house_id - 1 ] [ cl_sell_status ] )
		{
			SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данную недвижимость уже опечатали." ) ;
			p_t_info [ playerid ] [ debt_cellar ] = -1 ;
			return 1 ;
        }

        #if defined m_fractions
			   give_emp_progress ( playerid, 0, 1 ) ;
		#endif

		sscanf ( cellar_info [ s_house_id - 1 ] [ cl_owner_name ], "u", _pl_id ) ;
		if ( IsPlayerConnected ( _pl_id ) )
		{
		    format ( cellar_info [ s_house_id - 1 ] [ cl_owner_name ], MAX_PLAYER_NAME, "Собственность штата" ) ;

			cellar_info [ s_house_id - 1 ] [ cl_owner ] = -1 ;
			cellar_info [ s_house_id - 1 ] [ cl_closed ] = 0 ;
			cellar_info [ s_house_id - 1 ] [ cl_sell_status ] = 0 ;

			new _sql_string [ 100 ] ;
			format ( _sql_string, sizeof( _sql_string ), "UPDATE `cellars` SET `cl_sell_status` = '0' WHERE `cl_id` = '%d' LIMIT 1", cellar_info [ s_house_id - 1 ] [ cl_id ] ) ;
			mysql_tquery ( sql_connection, _sql_string ) ;

			cellar_info [ s_house_id - 1 ] [ cl_meeting ] = SetElapsedTime ( gettime ( ), random ( 24 ) + 1, CONVERT_TIME_TO_HOURS ) ;
			format ( _sql_string, sizeof( _sql_string ), "UPDATE `cellars` SET `cl_meeting` = '%d' WHERE `cl_id` = '%d' LIMIT 1", cellar_info [ s_house_id - 1 ] [ cl_meeting ], cellar_info [ s_house_id - 1 ] [ cl_id ] ) ;
			mysql_tquery ( sql_connection, _sql_string ) ;

			save_cellar ( s_house_id - 1 ) ;

			p_info [ _pl_id ] [ cellar ] = -1 ;

			SendClientMessage ( _pl_id, col_gray, !"* Сотрудники мэрии изъяли Вашу недвижимость в счёт оплаты долгов." ) ;
			SendClientMessage ( _pl_id, col_gray, !"* Остаточная стоимость была переведена на Ваш банковский счёт." ) ;

			p_info [ _pl_id ] [ max_veh ] -= 1 ;

			new _text_string [ 186 ] ;
			new _debt_tax = GetPVarInt ( playerid, "debt_tax" ) ;
			if ( cellar_info [ s_house_id - 1 ] [ cl_price ] > _debt_tax )
			{
				format(_text_string, sizeof _text_string, "UPDATE `users` SET `u_tax` = '0', `u_cellar` = '-1', `u_maxveh` = `u_maxveh` - '1' WHERE `u_id` = '%d' LIMIT 1", debt_id ) ;
				mysql_tquery ( sql_connection, _text_string ) ;

                insert_return_money ( "Продажа гаража (опечатка)", cellar_info [ s_house_id - 1 ] [ cl_price ] - _debt_tax, debt_id ) ;

				p_info [ _pl_id ] [ tax ] = 0 ;
			}
			else
			{
				format(_text_string, sizeof _text_string, "UPDATE `users` SET `u_tax` = `u_tax`-'%d', `u_cellar` = '-1' WHERE `u_id` = '%d' LIMIT 1",
				cellar_info [ s_house_id - 1 ] [ cl_price ], debt_id ) ;
				mysql_tquery ( sql_connection, _text_string ) ;

				p_info [ _pl_id ] [ tax ] -= cellar_info [ s_house_id - 1 ] [ cl_price ] ;
			}
		}
		else
		{
			format ( cellar_info [ s_house_id - 1 ] [ cl_owner_name ], MAX_PLAYER_NAME, "Собственность штата" ) ;

			cellar_info [ s_house_id - 1 ] [ cl_owner ] = -1 ;
			cellar_info [ s_house_id - 1 ] [ cl_closed ] = 0 ;
			cellar_info [ s_house_id - 1 ] [ cl_sell_status ] = 0 ;

			new _sql_string [ 128 ] ;
			format ( _sql_string, sizeof( _sql_string ), "UPDATE `cellars` SET `cl_sell_status` = '0' WHERE `cl_id` = '%d' LIMIT 1", cellar_info [ s_house_id - 1 ] [ cl_id ] ) ;
			mysql_tquery ( sql_connection, _sql_string ) ;

			cellar_info [ s_house_id - 1 ] [ cl_meeting ] = SetElapsedTime ( gettime ( ), random ( 24 ) + 1, CONVERT_TIME_TO_HOURS ) ;
			format ( _sql_string, sizeof( _sql_string ), "UPDATE `cellars` SET `cl_meeting` = '%d' WHERE `cl_id` = '%d' LIMIT 1", cellar_info [ s_house_id - 1 ] [ cl_meeting ], cellar_info [ s_house_id - 1 ] [ cl_id ] ) ;
			mysql_tquery ( sql_connection, _sql_string ) ;

			for(new i = 0; i < 4 ; i++)
			{
				cellar_info [ s_house_id - 1 ] [ cl_improve ] [ i ] = 0 ;
			}
			format ( _sql_string, sizeof( _sql_string ),"UPDATE `cellars` SET `cl_improve` = '0|0|0|0' WHERE `cl_id` = '%d' LIMIT 1", cellar_info [ s_house_id - 1 ] [ cl_id ] ) ;
			mysql_tquery ( sql_connection, _sql_string ) ;

			save_cellar ( s_house_id - 1 ) ;

			insert_debtor_message ( "Налоги", "Ваш гараж был изъят сотрудниками мэрии в счёт оплаты налогов.\n\
											Остаточная стоимость была переведена на Ваш банковский счёт.", debt_id ) ;

            new _text_string [ 140 ] ;
			new _debt_tax = GetPVarInt ( playerid, "debt_tax" ) ;
			if ( cellar_info [ s_house_id - 1 ] [ cl_price ] > _debt_tax )
			{
				format ( _text_string, sizeof _text_string, "UPDATE `users` SET `u_tax` = '0',`u_cellar`='-1' WHERE `u_id` = '%d' LIMIT 1", debt_id ) ;
				mysql_tquery ( sql_connection, _text_string ) ;

				format ( _text_string, sizeof _text_string, "UPDATE `users` SET `u_maxveh` = `u_maxveh` - '1' WHERE `u_id` = '%d' LIMIT 1", debt_id ) ;
				mysql_tquery ( sql_connection, _text_string ) ;

                insert_return_money ( "Продажа гаража (опечатка)", cellar_info [ s_house_id - 1 ] [ cl_price ] - _debt_tax, debt_id ) ;
			}
			else
			{
				format ( _text_string, sizeof _text_string, "UPDATE `users` SET `u_tax` = `u_tax`-'%d',`u_cellar`='-1' WHERE `u_id` = '%d' LIMIT 1",
				cellar_info [ s_house_id - 1 ] [ cl_price ], debt_id ) ;
				mysql_tquery ( sql_connection, _text_string ) ;

				format ( _text_string, sizeof _text_string, "UPDATE `users` SET `u_maxveh` = `u_maxveh` - '1' WHERE `u_id` = '%d' LIMIT 1", debt_id ) ;
				mysql_tquery ( sql_connection, _text_string ) ;
			}
		}
		new scm_string [ 128 ] ;
		format ( scm_string, sizeof scm_string, "Опечатал(а) имущество должника (Гараж №%d)", cellar_info [ s_house_id - 1 ] [ cl_id ]);
		write_fraction ( playerid, p_info [ playerid ] [ member ], TYPE_LOG_OBWYAK, scm_string ) ;

		new _value = floatround ( ( cellar_info [ s_house_id - 1 ] [ cl_price ] * 5 ) / 100 ) ;
		give_money ( playerid, _value ) ;
		insert_money_log ( playerid, INVALID_PLAYER_ID, _value, "опечатка гаража" ) ;

    	p_t_info [ playerid ] [ debt_cellar ] = -1 ;

        format ( scm_string, sizeof ( scm_string ), "< Радио %s > Государственные изменения: Опечатан гараж №%d.", f_info [ 26 ] [ f_letter_name ], cellar_info [ s_house_id - 1 ] [ cl_id ] ) ;
		foreach(new i: logged_players) if ( p_info [ i ] [ radio ] == 27 ) SendClientMessage ( i, 0x10ACF6FF, scm_string ) ;

		SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Вы опечатали имущество." ) ;
	}
	return 1 ;
}

stock show_pass_give ( playerid )
{
	global_string [ 0 ] = EOS ;
	format ( global_string, 130, "{"#cBL"}1. {"#cWH"}Пожертвовать\n{"#cBL"}2. {"#cWH"}Топ пожертвований\n{"#cGRDialog"}Всего пожертвовано: {"#cGN"}%d"valute_title_"", p_info [ playerid ] [ charity ] ) ;
    show_dialog(playerid, d_charity, DIALOG_STYLE_LIST, "{"#cBHD"}Меню пожертвований", global_string, "Выбрать", "Закрыть" ) ;
	return 1 ;
}

stock GetSquare3DPos ( Float:x, Float:y, Float: z, Float:radius, &Float:minx, &Float:miny, &Float: minz, &Float:maxx, &Float:maxy, &Float:maxz )
{
	minx = x - radius ;
	miny = y - radius ;
	minz = z - radius ;
	maxx = x + radius ;
	maxy = y + radius ;
	maxz = z + radius ;
	return true ;
}

stock show_fixcar ( playerid, type )
{
	if ( type == 2 )
	{
	    global_string [ 0 ] = EOS ;
	    new line_string [ 128 ], bizz_id = p_info [ playerid ] [ business ], row_count = 1 ;
		format ( line_string, sizeof line_string, "{"#cWH"}Буксировка всего транспорта\t{"#cGN"}%d"valute_title_"\n", price_fixcar * Iter_Count(business_vehicles[bizz_id]) ) ;
		strcat ( global_string, line_string ) ;

		new veh_point = 0 ;
	    foreach(new vehicleid: business_vehicles[bizz_id])
	    {
			if ( ! IsValidVehicle ( vehicleid ) ) continue ;

			veh_point ++ ;
			row_count ++ ;
			format ( line_string, sizeof ( line_string ), "{"#cWH"}%d. %s\t{"#cGN"}%d"valute_title_"{"#cWH"} {"#cGRDialog"}({"#cGN"}%d"valute_title_"{"#cGRDialog"}) %s\n", veh_point, GetVehicleNameEx ( vehicleid ), veh_info [ vehicleid - 1 ] [ v_rent_price ], price_fixcar, ( GetPlayerVehicleID ( playerid ) == vehicleid ) ? ( "{"#cGRDialog"}* Вы находитесь в этом транспорте" ) : ( "" ) ) ;
			strcat ( global_string, line_string ) ;
		}

		strcat ( global_string, "{"#cGRDialog"}Покупка транспорта" ) ;
		set_player_use_page ( playerid, row_count, 0 ) ;

		show_dialog ( playerid, d_biz_fixcar, DIALOG_STYLE_TABLIST, "{"#cBHD"}Управление автопарком", global_string, "Выбрать", "Назад" ) ;
	}
	else if ( type == 4 )
	{
	    new fraction_id ;
		if ( p_info [ playerid ] [ leader ] ) fraction_id = p_info [ playerid ] [ member ] ;
		else fraction_id = player_settings { playerid } ;

	    new mysql_string [ 123 + 9 ] ;
	    format ( mysql_string, sizeof mysql_string, "SELECT `sv_id`, `sv_model`, `sv_rank`, `sv_subleader` FROM `server_vehicles` WHERE `sv_type` = '1' AND `sv_owner` = '%d'", fraction_id ) ;
	    mysql_tquery ( sql_connection, mysql_string, "callback_lmenu_fixcar", "i", playerid ) ;
	}
	else if ( type == 5 )
	{
		new family_id = p_info [ playerid ] [ family ] ;

		global_string [ 0 ] = EOS ;
		new line_string [ 128 ] ;
		format ( line_string, sizeof line_string, "{"#cWH"}Буксировка всего транспорта\t{"#cGN"}%d"valute_title_"\n", price_fixcar * Iter_Count(family_vehicles[family_id]) ) ;
		strcat ( global_string, line_string ) ;

		new veh_point = 0 ;
		foreach(new vehicleid: family_vehicles[family_id])
		{
			if ( ! IsValidVehicle ( vehicleid ) ) continue ;
			if ( veh_info [ vehicleid - 1 ] [ v_type ] != vehicle_type_family ) continue ;

			set_player_listitem_values ( playerid, veh_point, vehicleid ) ;
   			veh_point ++ ;

   			format ( line_string, sizeof ( line_string ), "{"#cWH"}%d. %s\t{"#cGN"}%d"valute_title_" %s\n", veh_point, GetVehicleNameEx ( vehicleid ), price_fixcar, ( GetPlayerVehicleID ( playerid ) == vehicleid ) ? ( "{"#cGRDialog"}* Вы находитесь в этом транспорте" ) : ( "" ) ) ;
			strcat ( global_string, line_string ) ;
		}

		show_dialog ( playerid, d_fam_fixcar, DIALOG_STYLE_TABLIST, "{"#cBHD"}Управление автопарком", global_string, "Выбрать", "Назад" ) ;
	}
	return 1 ;
}

callback: callback_lmenu_fixcar ( playerid )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;

	global_string [ 0 ] = EOS ;
	new sv_id, sv_model, sv_rank, sv_subleader, _unit_name [ 32 ], _fr_id = p_info [ playerid ] [ member ], line_string [ 128 ] ;
	strcat ( global_string, "{"#cBL"}№. Название:\t{"#cBL"}Должность:\t{"#cBL"}Подразделение:\n" ) ;
	format ( line_string, sizeof line_string, "{"#cWH"}Буксировка всего транспорта\t{"#cGN"}%d"valute_title_"\n", price_fixcar * Iter_Count(fraction_vehicles[_fr_id]) ) ;
	strcat ( global_string, line_string ) ;
	for ( new i = 0 ; i < rows ; i ++ )
	{
		sv_id = cache_get_field_content_int ( i, "sv_id", sql_connection ) ;
		sv_model = cache_get_field_content_int ( i, "sv_model", sql_connection ) ;
		sv_rank = cache_get_field_content_int ( i, "sv_rank", sql_connection ) ;
		sv_subleader = cache_get_field_content_int ( i, "sv_subleader", sql_connection ) ;

		set_player_listitem_values ( playerid, i, sv_id ) ;

		if ( sv_subleader > 0 ) format ( _unit_name, sizeof _unit_name, "{"#cLY"}%s", unit_info [ sv_subleader - 1 ] [ un_name ] ) ;
		else format ( _unit_name, sizeof _unit_name, "{"#cRD"}Нет" ) ;

		format ( line_string, sizeof line_string, "{"#cBL"}%d. {"#cWH"}%s\t{33AAFF}%s {"#cGRDialog"}- %d ранг{"#cWH"}\t%s\n", sv_id, GetVehicleNameEx ( INVALID_VEHICLE_ID, sv_model ), f_rank [ _fr_id - 1 ] [ sv_rank - 1 ], sv_rank, _unit_name ) ;
		strcat ( global_string, line_string ) ;
	}

	show_dialog ( playerid, d_lmenu_fixcar, DIALOG_STYLE_TABLIST_HEADERS, "{"#cBHD"}Транспорт", global_string, "Выбрать", "Назад" ) ;
	return 1 ;
}

stock show_menu_fixcar ( playerid, vehicleid, type )
{
    global_string [ 0 ] = EOS ;

	if ( type == 2 )
	{
	    format ( global_string, 512, "\
					{"#cGRDialog"}- {"#cWH"}Отбуксировать\n\
					{"#cGRDialog"}- {"#cWH"}Стоимость аренды {"#cGRDialog"}({"#cGN"}%d"valute_title_"{"#cGRDialog"})\n\
					{"#cGRDialog"}- {"#cWH"}Изменить позицию автомобиля\n\
					{"#cGRDialog"}- {"#cWH"}Модель автомобиля {"#cGRDialog"}({"#cGN"}%s{"#cGRDialog"})\n\
					{"#cGRDialog"}- {"#cWH"}Отметить на GPS\n\
					{"#cGRDialog"}- {"#cWH"}Продать", veh_info [ vehicleid - 1 ] [ v_rent_price ], GetVehicleNameEx ( vehicleid ) ) ;
		show_dialog ( playerid, d_biz_fixcar1, DIALOG_STYLE_LIST, "{"#cBHD"}Настройки автомобиля", global_string, "Выбрать", "Назад" ) ;
	}

	else if ( type == 4 )
	{
	    new fractionid ;
		if ( p_info [ playerid ] [ leader ] ) fractionid = p_info [ playerid ] [ member ] ;
		else fractionid = player_settings { playerid } ;

		new bool: _find_car = false ;
		foreach(new i: fraction_vehicles[fractionid])
		{
			if ( veh_info [ i - 1 ] [ v_type ] != vehicle_type_server ) continue ;
		    if ( veh_info [ i - 1 ] [ v_owner ] != p_info [ playerid ] [ member ] ) continue ;
		   	if ( veh_info [ i - 1 ] [ v_id ] != vehicleid ) continue ;

			if ( veh_info [ i - 1 ] [ v_rank ] < 1 ) veh_info [ i - 1 ] [ v_rank ] = 1 ;

			new _unit_name [ 32 ] ;
			if ( veh_info [ i - 1 ] [ v_subleader ] > 0 ) format ( _unit_name, sizeof _unit_name, "%s", unit_info [ veh_info [ i - 1 ] [ v_subleader ] - 1 ] [ un_name ] ) ;
			else format ( _unit_name, sizeof _unit_name, "{"#cRD"}Нет" ) ;

			format ( global_string, 512, "\
						{"#cGRDialog"}- {"#cWH"}Ранг доступности {"#cGRDialog"}({"#cGN"}%s{"#cGRDialog"})\n\
						{"#cGRDialog"}- {"#cWH"}Отбуксировать\n\
						{"#cGRDialog"}- {"#cWH"}Изменить позицию автомобиля\n\
						{"#cGRDialog"}- {"#cWH"}Модель автомобиля {"#cGRDialog"}({"#cGN"}%s{"#cGRDialog"})\n\
						{"#cGRDialog"}- {"#cWH"}Отметить на GPS\n\
						{"#cGRDialog"}- {"#cWH"}Подразделение {"#cGRDialog"}({"#cGN"}%s{"#cGRDialog"})",
			f_rank [ fractionid - 1 ] [ veh_info [ i - 1 ] [ v_rank ] - 1 ], GetVehicleNameEx ( i ), _unit_name ) ;

			show_dialog ( playerid, d_lmenu_fixcar1, DIALOG_STYLE_LIST, "{"#cBHD"}Настройки автомобиля", global_string, "Выбрать", "Назад" ) ;

			_find_car = true ;
			break ;
		}

		if ( ! _find_car )
		{
			show_dialog ( playerid, d_lmenu_fixcar1, DIALOG_STYLE_LIST, "{"#cBHD"}Настройки автомобиля", "\
						{"#cGRDialog"}- {"#cWH"}Ранг доступности\n\
						{"#cGRDialog"}- {"#cWH"}Отбуксировать\n\
						{"#cGRDialog"}- {"#cWH"}Изменить позицию автомобиля\n\
						{"#cGRDialog"}- {"#cWH"}Модель автомобиля\n\
						{"#cGRDialog"}- {"#cWH"}Отметить на GPS\n\
						{"#cGRDialog"}- {"#cWH"}Подразделение", "Выбрать", "Назад" ) ;
		}
	}

	else if ( type == 5 )
	{
	    new family_id = p_info [ playerid ] [ family ] ;
	    if ( veh_info [ vehicleid - 1 ] [ v_type ] != vehicle_type_family )
	    {
	        SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Произошла ошибка. Код ошибки: not_family_car." ) ;
	        show_fixcar ( playerid, 5 ) ;
	        return 1 ;
	    }

		format ( global_string, 512, "\
					{"#cGRDialog"}- {"#cWH"}Ранг доступности {"#cGRDialog"}({"#cGN"}%s{"#cGRDialog"})\n\
					{"#cGRDialog"}- {"#cWH"}Отбуксировать\n\
					{"#cGRDialog"}- {"#cWH"}Изменить позицию автомобиля\n\
					{"#cGRDialog"}- {"#cWH"}Отметить на GPS\n\
					{"#cGRDialog"}- {"#cWH"}Продать",
		family_rank [ family_id - 1 ] [ veh_info [ vehicleid - 1 ] [ v_rank ] - 1 ] ) ;
		show_dialog ( playerid, d_fam_fixcar1, DIALOG_STYLE_LIST, "{"#cBHD"}Настройки автомобиля", global_string, "Выбрать", "Назад" ) ;
	}

	else if ( type == 7 )
	{
		format ( global_string, 200, "\
					{"#cGRDialog"}- {"#cWH"}Отбуксировать\n\
					{"#cGRDialog"}- {"#cWH"}Изменить позицию автомобиля\n\
					{"#cGRDialog"}- {"#cWH"}Отметить на GPS" ) ;
		show_dialog ( playerid, d_fixcar_house1, DIALOG_STYLE_LIST, "{"#cBHD"}Настройки автомобиля", global_string, "Выбрать", "Назад" ) ;
	}

	set_player_use_listitem ( playerid, vehicleid ) ;
	return 1 ;
}

stock bad_exit ( playerid )
{
	if ( ! player_loaded { playerid } || p_t_info [ playerid ] [ p_tp_immune_time ] > 0 ) return 1 ;

	SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Произошла ошибка. Обратитесь к администрации." ) ;

	new scm_string [ 144 ] ;
	format ( scm_string, sizeof scm_string, "{"#cBAdmin"}[A] {"#cGRAdmin"}%s[%d] застрял на выходе. Введите {"#cBAdmin"}\"/spawn [ %d ]\"{"#cGRAdmin"}.", p_info [ playerid ] [ name ], playerid, playerid ) ;
	foreach(new i: admin_players)
	{
	    if ( admin_info [ i ] [ admin ] < 3 ) continue ;

		SendClientMessage ( i, col_admin, scm_string ) ;
	}
	return 1 ;
}

stock bad_owner_account ( playerid )
{
	show_dialog ( playerid, d_accept_account, DIALOG_STYLE_LIST, "{"#cBHD"}Подтверждение аккаунта", "{"#cBL"}1. {"#cWH"}Подтвердить по дате регистрации\n{"#cBL"}2. {"#cWH"}Подтвердить по почте\n{"#cBL"}Информация", "Выбрать", "Закрыть" ) ;

	new scm_string [ 80 + 32 + 4 ] ;
	format ( scm_string, sizeof scm_string, "{"#cRD"}* WARNING (Подозрение во взломе) %s[%d] пытается продать имущество.", p_info [ playerid ] [ name ], playerid ) ;
	foreach(new i: admin_players)
	{
	    if ( admin_info [ i ] [ admin ] < 3 ) continue ;

		SendClientMessage ( i, col_admin, scm_string ) ;
	}
	return 1 ;
}

stock bad_dialog ( playerid )
{
    if ( p_t_info [ playerid ] [ p_dialog ] != -1 || dr_ptd_model [ playerid ] [ 4 ] != PlayerText:-1 ||
		player_dice_table { playerid } ||
		sell_time { playerid } > 0 ||
		trade_rielt [ playerid ] [ trade_id ] != INVALID_PLAYER_ID ||
		used_inventory [ playerid ] == true ) return 0 ;

    return 1 ;
}

stock bad_inventory ( playerid )
{
    if ( p_t_info [ playerid ] [ p_dialog ] != -1 || dr_ptd_model [ playerid ] [ 4 ] != PlayerText:-1 ||
		player_dice_table { playerid } ||
		sell_time { playerid } > 0 ||
		trade_rielt [ playerid ] [ trade_id ] != INVALID_PLAYER_ID ) return 0 ;

    return 1 ;
}

stock accept_buy_accessories ( playerid )
{
    new _shop_id = GetPVarInt ( playerid, "p_acc_listitem" ), _acc_id = GetPVarInt ( playerid, "p_acc_id" ) ;
    if ( _shop_id < 0 ) return 1 ;
	if ( p_info [ playerid ] [ money ] < accessories_items_price [ _shop_id - 1 ] [ _acc_id ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас недостаточно средств для приобретения аксессуара.") ;

	new _price = accessories_items_price [ _shop_id - 1 ] [ _acc_id ] ;
	give_money ( playerid, -_price ) ;
	insert_money_log ( playerid, INVALID_PLAYER_ID, -_price, "Покупка аксессуара" ) ;

	new b = GetPVarInt ( playerid, "p_biz_id" ) - 1 ;
	give_bmoney ( b + 1, floatround ( _price * 0.03 ), RandomEx ( 100, 170 ) ) ;

	give_inventory ( playerid, accessories_items [ _shop_id - 1 ] [ _acc_id ], 1, 0, "", "", NUMBERPLATE_TYPE_NONE, 0 ) ;

	DeletePVar ( playerid, "p_acc_id" ) ;
	DeletePVar ( playerid, "p_acc_listitem" ) ;
	DeletePVar ( playerid, "p_acc_view" ) ;

	TogglePlayerControllable ( playerid, true ) ;
	SetCameraBehindPlayer ( playerid ) ;

	if ( IsValidDynamicPickup ( acs_pickup [ playerid ] ) ) DestroyDynamicPickup ( acs_pickup [ playerid ] ) ;
	for ( new i = 5 ; i < 10 ; i ++ ) if ( IsPlayerAttachedObjectSlotUsed ( playerid, i ) ) RemovePlayerAttachedObject ( playerid, i ) ;
	attachUserAccessories ( playerid ) ;

	if ( player_device { playerid } == 2 ) show_packet_clothes ( playerid, 3, "" ) ;
	else show_skinshop_ptd ( playerid, 2, false ) ;

	set_world ( playerid, b_info [ b ] [ b_id ] + 1000 ) ;
	SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы успешно приобрели аксессуар. Используйте {"#cBL"}\"/mm - Инвентарь - Подарочный инвентарь\"{"#cWH"}." ) ;
	return 1 ;
}

stock close_buy_accessories ( playerid )
{
    DeletePVar ( playerid, "p_acc_id" ) ;
	DeletePVar ( playerid, "p_acc_listitem" ) ;
	DeletePVar ( playerid, "p_acc_view" ) ;

	TogglePlayerControllable ( playerid, true ) ;
	SetCameraBehindPlayer ( playerid ) ;

	set_world ( playerid, b_info [ GetPVarInt ( playerid, "p_biz_id" ) - 1 ] [ b_id ] + 1000 ) ;

	show_skinshop_ptd ( playerid, 2, false ) ;

	if ( IsValidDynamicPickup ( acs_pickup [ playerid ] ) ) DestroyDynamicPickup ( acs_pickup [ playerid ] ) ;
	for ( new i = 5 ; i < 10 ; i ++ ) if ( IsPlayerAttachedObjectSlotUsed ( playerid, i ) ) RemovePlayerAttachedObject ( playerid, i ) ;
	attachUserAccessories ( playerid ) ;
	return 1 ;
}

stock accept_buy_skins ( playerid )
{
	new _d_str [ 104 + 9 ] ;
	format ( _d_str, sizeof _d_str, "{ffffff}Стоимость:\t{"#cBL"}%d"valute_title_"\n\n{"#cGRDialog"}* Вы действительно желаете приобрести данную одежду?", shop_skins_price [ p_info [ playerid ] [ gender ] ] [ GetPVarInt ( playerid, "skin_select_number" ) ] ) ;
	show_dialog ( playerid, d_buy_skin, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Покупка одежды", _d_str, "Купить", "Назад" ) ;
	return 1 ;
}

stock close_buy_skins ( playerid )
{
    DeletePVar ( playerid, "skin_select_number" ) ;
	p_skin_shop [ playerid ] = false ;

	TogglePlayerControllable ( playerid, true ) ;
	SetCameraBehindPlayer ( playerid ) ;

	show_skinshop_ptd ( playerid, 1, false ) ;

	fraction_duty ( playerid ) ;

	set_world ( playerid, b_info [ GetPVarInt ( playerid, "p_biz_id" ) - 1 ] [ b_id ] + 1000 ) ;
	return 1 ;
}

callback: Duel_Count(playerid, count)
{
	if ( player_duel [ playerid ] [ duel_on ] == false ) return 1 ;
    new opponent_id = duel_opponent [ playerid ] ;

	switch ( count )
	{
	    case 3:
		{
			GameTextForPlayer(playerid, "~g~3", 1100, 6);
			GameTextForPlayer(opponent_id, "~g~3", 1100, 6);

			PlayerPlaySound(opponent_id, 1056, 0.0, 0.0, 0.0);
			PlayerPlaySound(playerid, 1056, 0.0, 0.0, 0.0);
		}
	    case 2:
		{
			GameTextForPlayer(playerid, "~g~2", 1100, 6);
			GameTextForPlayer(opponent_id, "~g~2", 1100, 6);

			PlayerPlaySound(opponent_id, 1056, 0.0, 0.0, 0.0);
			PlayerPlaySound(playerid, 1056, 0.0, 0.0, 0.0);
		}
	    case 1:
		{
			GameTextForPlayer(playerid, "~g~1", 1100, 6);
			GameTextForPlayer(opponent_id, "~g~1", 1100, 6);

			PlayerPlaySound(opponent_id, 1056, 0.0, 0.0, 0.0);
			PlayerPlaySound(playerid, 1056, 0.0, 0.0, 0.0);
		}
	    case 0:
	    {
			GameTextForPlayer(playerid, "~g~GO!!!", 2000, 6);
			GameTextForPlayer(opponent_id, "~g~GO!!!", 2000, 6);

			PlayerPlaySound(opponent_id, 1057, 0.0, 0.0, 0.0);
			PlayerPlaySound(playerid, 1057, 0.0, 0.0, 0.0);

            toggle_controlable ( opponent_id, true ) ;
			toggle_controlable ( playerid, true ) ;

			if ( player_duel [ opponent_id ] [ duel_gun ] [ 0 ] != 0 )
			{
   				give_weapon(opponent_id, player_duel [ opponent_id ] [ duel_gun ] [ 0 ], 999);
			    give_weapon(playerid, player_duel [ opponent_id ] [ duel_gun ] [ 0 ], 999);
			}
			if ( player_duel [ opponent_id ] [ duel_gun ] [ 1 ] != 0 )
			{
   				give_weapon(opponent_id, player_duel [ opponent_id ] [ duel_gun ] [ 1 ], 999);
			    give_weapon(playerid, player_duel [ opponent_id ] [ duel_gun ] [ 1 ], 999);
			}
			if ( player_duel [ opponent_id ] [ duel_gun ] [ 2 ] != 0 )
			{
   				give_weapon(opponent_id, player_duel [ opponent_id ] [ duel_gun ] [ 2 ], 999);
			    give_weapon(playerid, player_duel [ opponent_id ] [ duel_gun ] [ 2 ], 999);
			}
	    }
	}
	return 1 ;
}

stock ShowWeaponSelect ( playerid )
{
	new str [ 256 ] ;

	new Gun1 [ 42 ] = { "{"#cRD"}Не выбрано" } ;
	new Gun2 [ 42 ] = { "{"#cRD"}Не выбрано" } ;
	new Gun3 [ 42 ] = { "{"#cRD"}Не выбрано" } ;

	new gunname [ 32 ] ;
	if ( player_duel [ playerid ] [ duel_gun ] [ 0 ] != 0 )
	{
		GetWeaponName ( player_duel [ playerid ] [ duel_gun ] [ 0 ], gunname, 32);
		format(Gun1, sizeof(Gun1), "{"#cBL"}%s", gunname);
	}
	if ( player_duel [ playerid ] [ duel_gun ] [ 1 ] != 0 )
	{
		GetWeaponName ( player_duel [ playerid ] [ duel_gun ] [ 1 ], gunname, 32);
		format(Gun2, sizeof(Gun2), "{"#cBL"}%s", gunname);
	}
	if ( player_duel [ playerid ] [ duel_gun ] [ 2 ] != 0 )
	{
		GetWeaponName ( player_duel [ playerid ] [ duel_gun ] [ 2 ], gunname, 32);
		format(Gun3, sizeof(Gun3), "{"#cBL"}%s", gunname);
	}

	format(str, sizeof(str), "\
	Оружие 1:\t%s{"#cWH"}\n\
	Оружие 2:\t%s{"#cWH"}\n\
	Оружие 3:\t%s\
	", Gun1, Gun2, Gun3);
	return show_dialog(playerid, d_duel_gun, DIALOG_STYLE_LIST, "{"#cBHD"}Выбор оружия", str, "Выбор","Назад");
}

stock ShowPlayerDuelInfo ( playerid )
{
	new str [ 270 ] ;
	new map [ 20 ] ;

	switch ( player_duel [ playerid ] [ duel_map ] )
	{
	    case 1: map = "Две стороны";
	    case 2: map = "Железный корт";
	    case 3: map = "Четыре стены";
	}

	new Guns [ 100 ], gunname [ 32 ], bool: _select_weapon = false ;
	for ( new i = 0 ; i < 3 ; i ++ )
	{
	    if ( ! player_duel [ playerid ] [ duel_gun ] [ i ] ) continue ;
	    GetWeaponName ( player_duel [ playerid ] [ duel_gun ] [ i ], gunname, 32 ) ;
		if ( _select_weapon == false ) format ( Guns, sizeof ( Guns ), "%s%s", Guns, gunname ) ;
		else format ( Guns, sizeof ( Guns ), "%s, %s", Guns, gunname ) ;

		_select_weapon = true ;
	}

	new PlayerName[ 40 ] ;
	new d_play = player_duel [ playerid ] [ duel_player ] ;
	if ( d_play == INVALID_PLAYER_ID || ! IsPlayerConnected ( d_play ) )
	{
	    PlayerName = "{"#cRD"}Не доступен";
	}
	else
	{
		format ( PlayerName, sizeof ( PlayerName ), "{"#cBL"}%s", p_info [ d_play ] [ name ] ) ;
	}

	if ( player_duel [ playerid ] [ duel_money ] > 0 && ( IsPlayerConnected ( d_play ) || player_duel [ playerid ] [ duel_max_players ] != 0 ) && player_duel [ playerid ] [ duel_map ] && player_duel [ playerid ] [ duel_gun ] [ 0 ] > 0 )
	{
		format(str, sizeof(str), "\
		Выбрать карту\t{"#cBL"}%s{"#cWH"}\n\
		Выбрать оружие\t{"#cBL"}%s{"#cWH"}\n\
		Установить HP\t{"#cBL"}%.1f{"#cWH"}\n\
		Ваш соперник\t%s{"#cWH"}\n\
		Ставка\t{"#cGN"}%d"valute_title_"{"#cWH"}\n\
		Максимальное число участников\t{"#cGN"}%d\n\
		{"#cBL"}Начать\t ", map, Guns, player_duel [ playerid ] [ duel_hp ], PlayerName, player_duel [ playerid ] [ duel_money ], player_duel [ playerid ] [ duel_max_players ] ) ;
	}
	else
	{
	    format(str, sizeof(str), "\
		Выбрать карту\t{"#cBL"}%s{"#cWH"}\n\
		Выбрать оружие\t{"#cBL"}%s{"#cWH"}\n\
		Установить HP\t{"#cBL"}%.1f{"#cWH"}\n\
		Ваш соперник\t%s{"#cWH"}\n\
		Ставка\t{"#cGN"}%d"valute_title_"{"#cWH"}\n\
		Максимальное число участников\t{"#cBL"}%d\n\
		{"#cGRDialog"}Начать\t ", map, Guns, player_duel [ playerid ] [ duel_hp ], PlayerName, player_duel [ playerid ] [ duel_money ], player_duel [ playerid ] [ duel_max_players ] ) ;
	}

	return show_dialog ( playerid, d_duel, DIALOG_STYLE_TABLIST, "{"#cBHD"}Создание дуэли", str, "Выбор", "Отмена" ) ;
}

stock check_float_time ( _time )
{
	new _date [ 24 ] ;
    if ( _time > ( 24 * 365 ) * 3600 ) format ( _date, sizeof _date, "%d лет назад", floatround ( _time / ( ( 24 * 365 ) * 3600 ) ) ) ;
	else if ( _time > 24 * 3600 ) format ( _date, sizeof _date, "%d дн. назад", floatround ( _time / ( 24 * 3600 ) ) ) ;
    else if ( _time > 3600 ) format ( _date, sizeof _date, "%d ч. назад", floatround ( _time / 3600 ) ) ;
  	else if ( _time > 60 ) format ( _date, sizeof _date, "%d мин. назад", floatround ( _time / 60 ) ) ;
   	else if ( _time > 1 ) format ( _date, sizeof _date, "%d сек. назад", _time ) ;
	return _date ;
}

stock show_debtors_bank ( playerid )
{
    new dialog_string [ 256 ] ;
	format ( dialog_string, sizeof dialog_string, "{"#cGRDialog"}- {"#cWH"}Задолженность: {"#cGN"}%d"valute_title_"\n{"#cBL"}1. {"#cWH"}Оплатить налоги\n{"#cBL"}2. {"#cWH"}Налогооблажение\n{"#cBL"}3. {"#cWH"}Оплатить кредит", p_info [ playerid ] [ tax ] ) ;
	show_dialog ( playerid, d_bank_bills_info, DIALOG_STYLE_LIST, "{"#cBHD"}Налоги", dialog_string, "Выбрать", "Назад" ) ;
	return 1 ;
}

stock clear_for_tax ( playerid, type_clear )
{
	if ( type_clear == 1 )
	{
		if ( p_info [ playerid ] [ cellar ] != -1 )
		{
		    new _cl_id = p_info [ playerid ] [ cellar ] ;
		    if ( cellar_info [ _cl_id - 1 ] [ cl_sell_status ] == 1 )
			{
	  			cellar_info [ _cl_id - 1 ] [ cl_sell_status ] = 0 ;

				static const _str [ ] = "UPDATE `cellars` SET `cl_sell_status` = '0' WHERE `cl_id` = '%d' LIMIT 1" ;
				new _sql_string [ sizeof _str + 9 ] ;
				format ( _sql_string, sizeof( _sql_string ), _str, cellar_info [ _cl_id - 1 ] [ cl_id ] ) ;
				mysql_tquery ( sql_connection, _sql_string ) ;
			}
		}

		if ( Iter_Count(player_houses[playerid]) > 0 )
		{
		    foreach(new h: player_houses[playerid])
		    {
				if ( h_info [ h - 1 ] [ h_sell_status ] == 1 )
				{
		  			h_info [ h - 1 ] [ h_sell_status ] = 0 ;

					static const _str [ ] = "UPDATE `houses` SET `h_sell_status` = '0' WHERE `h_id` = '%d' LIMIT 1" ;
					new _sql_string [ sizeof _str + 9 ] ;
					format ( _sql_string, sizeof( _sql_string ), _str, h_info [ h - 1 ] [ h_id ] ) ;
					mysql_tquery ( sql_connection, _sql_string ) ;
				}
			}
		}

		if ( Iter_Count(player_business[playerid]) > 0 )
		{
		    foreach(new b: player_business[playerid])
		    {
	     		if ( b_info [ b - 1 ] [ b_sell_status ] == 1 )
				{
	                b_info [ b - 1 ] [ b_sell_status ] = 0 ;

					static const _str [ ] = "UPDATE `businesses` SET `b_sell_status` = '0' WHERE `b_id` = '%d' LIMIT 1" ;
	                new _sql_string [ sizeof _str + 9 ] ;
					format ( _sql_string, sizeof( _sql_string ), _str, b_info [ b - 1 ] [ b_id ] ) ;
					mysql_tquery ( sql_connection, _sql_string ) ;
				}
			}
		}
	}
	else if ( type_clear == 2 )
	{
		if ( p_info [ playerid ] [ cellar ] != -1 )
		{
		    new _cl_id = p_info [ playerid ] [ cellar ] ;
		    if ( cellar_info [ _cl_id - 1 ] [ cl_sell_status ] == 2 )
			{
	  			cellar_info [ _cl_id - 1 ] [ cl_sell_status ] = 0 ;

				static const _str [ ] = "UPDATE `cellars` SET `cl_sell_status` = '0' WHERE `cl_id` = '%d' LIMIT 1" ;
				new _sql_string [ sizeof _str + 9 ] ;
				format ( _sql_string, sizeof( _sql_string ), _str, cellar_info [ _cl_id - 1 ] [ cl_id ] ) ;
				mysql_tquery ( sql_connection, _sql_string ) ;
			}
		}

		if ( Iter_Count(player_houses[playerid]) > 0 )
		{
		    foreach(new h: player_houses[playerid])
		    {
				if ( h_info [ h - 1 ] [ h_sell_status ] == 2 )
				{
		  			h_info [ h - 1 ] [ h_sell_status ] = 0 ;

					static const _str [ ] = "UPDATE `houses` SET `h_sell_status` = '0' WHERE `h_id` = '%d' LIMIT 1" ;
					new _sql_string [ sizeof _str + 9 ] ;
					format ( _sql_string, sizeof( _sql_string ), _str, h_info [ h - 1 ] [ h_id ] ) ;
					mysql_tquery ( sql_connection, _sql_string ) ;
				}
			}
		}

		if ( Iter_Count(player_business[playerid]) > 0 )
		{
		    foreach(new b: player_business[playerid])
		    {
	     		if ( b_info [ b - 1 ] [ b_sell_status ] == 2 )
				{
	                b_info [ b - 1 ] [ b_sell_status ] = 0 ;

					static const _str [ ] = "UPDATE `businesses` SET `b_sell_status` = '0' WHERE `b_id` = '%d' LIMIT 1" ;
	                new _sql_string [ sizeof _str + 9 ] ;
					format ( _sql_string, sizeof( _sql_string ), _str, b_info [ b - 1 ] [ b_id ] ) ;
					mysql_tquery ( sql_connection, _sql_string ) ;
				}
			}
		}
	}
	return 1 ;
}

stock show_rent_car ( playerid, _rent_price )
{
	new dialog_string [ 256 ] ;
	format ( dialog_string, sizeof dialog_string, "{"#cWH"}Стоимость аренды: {"#cGN"}%d"valute_title_"\n\n\
													{"#cGRDialog"}* Транспорт пропадёт после респавна.\n\
													{"#cGRDialog"}* Вы сможете использовать багажник транспорта.\n\
													{"#cGRDialog"}* Для открытия или закрытия используйте {"#cRD"}/rlock (/rlk){"#cWH"}.\n\n\
													{"#cGRDialog"}* Вы действительно желаете арендовать данный транспорт?", _rent_price ) ;
 	show_dialog ( playerid, d_rent_car, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Аренда транспорта", dialog_string, "Аренда", "Отмена" ) ;
	return 1 ;
}

stock accept_rent_faggio ( playerid )
{
    if ( player_rentcar [ playerid ] != INVALID_VEHICLE_ID ) return RemovePlayerFromVehicle ( playerid ), SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы уже арендуете транспорт, сначала откажитесь от старого {"#cRD"}/stoprent" ) ;
	if ( p_info [ playerid ] [ money ] < 50 ) return RemovePlayerFromVehicle ( playerid ), SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Аренда скутера стоит {"#cRD"}50"valute_title_"" ) ;

	for ( new j = 0 ; j < sizeof faggio_spawn ; j ++ )
	{
		if ( ! IsPlayerInRangeOfPoint ( playerid, 15, faggio_spawn [ j ] [ 0 ], faggio_spawn [ j ] [ 1 ], faggio_spawn [ j ] [ 2 ] ) ) continue ;
		new _vehicle_id = CreateVehicle ( faggio_model, faggio_spawn [ j ] [ 0 ], faggio_spawn [ j ] [ 1 ], faggio_spawn [ j ] [ 2 ], faggio_spawn [ j ] [ 3 ], 1, 1, 300 ) ;

		// CreateVehicle can reuse a slot that previously belonged to a tuned car.
		// Initialize all handling fields so a rental Faggio never inherits Stage 3.
		veh_info [ _vehicle_id - 1 ] [ v_color ] [ 0 ] = 1 ;
		veh_info [ _vehicle_id - 1 ] [ v_color ] [ 1 ] = 1 ;
		SetVehicleDataAll ( _vehicle_id ) ;

		veh_info [ _vehicle_id - 1 ] [ v_type ] = vehicle_type_rentcar_faggio ;
		veh_info [ _vehicle_id - 1 ] [ v_fuel ] = 60 ;
		veh_info [ _vehicle_id - 1 ] [ v_renter ] = playerid ;
		sc_ResetHandling ( _vehicle_id ) ;

		SetVehicleNumberPlate ( _vehicle_id, "Faggio" ) ;
		give_money ( playerid, -50 ) ;
		player_rentcar [ playerid ] = _vehicle_id ;
		PutPlayerInVehicle ( playerid, _vehicle_id, 0 ) ;

		new engine, lights, alarm, doors, bonnet, boot, objective ;
		GetVehicleParamsEx ( _vehicle_id, engine, lights, alarm, doors, bonnet, boot, objective ) ;
		SetVehicleParamsEx ( _vehicle_id, VEHICLE_PARAMS_OFF, lights, alarm, doors, bonnet, boot, objective ) ;

        toggle_engine ( playerid, _vehicle_id ) ;
		toggle_locked ( playerid, _vehicle_id, 1 ) ;

		SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы успешно арендовали транспорт. Используйте {"#cGN"}/rlock (/rlk){"#cWH"}, чтобы закрыть его." ) ;
		return 1 ;
	}

	#if defined m_quest_menu
		if ( ! users_education [ playerid ] [ EDUCATION_SPEEDOMETR ] )
		{
			show_window_monologue (
				playerid,
				5,
				"Для взаимодействия с транспортом достаточно нажать на спидометр. \
				Если ты нажмёшь на спидометр, то откроется меню взаимодействия. \
				Можно взаимодействовать альтернативно - нажать на модель машины, отпустить и зажать её и \
				тогда откроется радиальное меню.",
				"Местный",
				"Понял"
			) ;

			save_user_education ( playerid, EDUCATION_SPEEDOMETR ) ;
		}
	#endif
	return 1 ;
}

stock Float:DistanceCameraTargetToLocation ( Float:CamX, Float:CamY, Float:CamZ, Float:ObjX, Float:ObjY, Float:ObjZ, Float:FrX, Float:FrY, Float:FrZ )
{
	new Float:TGTDistance;
	TGTDistance = floatsqroot((CamX - ObjX) * (CamX - ObjX) + (CamY - ObjY) * (CamY - ObjY) + (CamZ - ObjZ) * (CamZ - ObjZ));
	new Float:tmpX, Float:tmpY, Float:tmpZ;
	tmpX = FrX * TGTDistance + CamX;
	tmpY = FrY * TGTDistance + CamY;
	tmpZ = FrZ * TGTDistance + CamZ;
	return floatsqroot((tmpX - ObjX) * (tmpX - ObjX) + (tmpY - ObjY) * (tmpY - ObjY) + (tmpZ - ObjZ) * (tmpZ - ObjZ));
}

stock Float:GetPointAngleToPoint ( Float:x2, Float:y2, Float:X, Float:Y )
{
	new Float:DX, Float:DY;
	new Float:angle;
	DX = floatabs(floatsub(x2,X));
	DY = floatabs(floatsub(y2,Y));
	if (DY == 0.0 || DX == 0.0)
	{
		if(DY == 0 && DX > 0) angle = 0.0;
		else if(DY == 0 && DX < 0) angle = 180.0;
		else if(DY > 0 && DX == 0) angle = 90.0;
		else if(DY < 0 && DX == 0) angle = 270.0;
		else if(DY == 0 && DX == 0) angle = 0.0;
	}
	else
	{
		angle = atan(DX/DY);
		if(X > x2 && Y <= y2) angle += 90.0;
		else if(X <= x2 && Y < y2) angle = floatsub(90.0, angle);
		else if(X < x2 && Y >= y2) angle -= 90.0;
		else if(X >= x2 && Y > y2) angle = floatsub(270.0, angle);
	}
	return floatadd(angle, 90.0);
}

stock GetXYInFrontOfPoint ( &Float:x, &Float:y, Float:angle, Float:distance )
{
	x += (distance * floatsin(-angle, degrees));
	y += (distance * floatcos(-angle, degrees));
}

stock IsPlayerAimingAt ( playerid, Float:x, Float:y, Float:z, Float:radius )
{
	new Float:camera_x, Float: camera_y, Float:camera_z, Float:vector_x, Float:vector_y, Float:vector_z;
	GetPlayerCameraPos(playerid, camera_x, camera_y, camera_z);
	GetPlayerCameraFrontVector(playerid, vector_x, vector_y, vector_z);
	new Float:vertical, Float:horizontal;
	switch ( GetPlayerWeapon ( playerid ) )
	{
		case 34,35,36: { if ( DistanceCameraTargetToLocation ( camera_x, camera_y, camera_z, x, y, z, vector_x, vector_y, vector_z ) < radius ) return true ; return false ; }
		case 30,31: { vertical = 4.0; horizontal = -1.6; }
		case 33: { vertical = 2.7; horizontal = -1.0; }
		default: { vertical = 6.0; horizontal = -2.2; }
	}
	new Float:angle = GetPointAngleToPoint(0, 0, floatsqroot(vector_x*vector_x+vector_y*vector_y), vector_z) - 270.0;
	new Float:resize_x, Float:resize_y, Float:resize_z = floatsin(angle+vertical, degrees);
	GetXYInFrontOfPoint(resize_x, resize_y, GetPointAngleToPoint(0, 0, vector_x, vector_y)+horizontal, floatcos(angle+vertical, degrees));
	if (DistanceCameraTargetToLocation(camera_x, camera_y, camera_z, x, y, z, resize_x, resize_y, resize_z) < radius) return true ;
	return false ;
}

stock GetVehicleRoofPos ( vehicleid, &Float:x, &Float:y, &Float:z )
{
	new Float:Vehicle_Size [ 3 ] ;
	GetVehicleModelInfo ( veh_info [ vehicleid - 1 ] [ v_model ], VEHICLE_MODEL_INFO_SIZE, Vehicle_Size [ 0 ], Vehicle_Size [ 1 ], Vehicle_Size [ 2 ] ) ;
	GetVehiclePos ( vehicleid, x, y, z ) ;
	z += Vehicle_Size [ 2 ] / 2 ;
	return 1 ;
}

stock getPlayerAccessories ( playerid, itemId )
{
	for ( new i = 0 ; i < MAX_ACCESORIES ; i ++ )
	{
		if ( GetUserAccessories ( playerid, ACS_MODEL, i ) != itemId ) continue ;

		return true ;
	}
	return false ;
}

stock getFreeSlotAccessories ( playerid )
{
	for ( new i = 0 ; i < MAX_ACCESORIES ; i ++ )
	{
		if ( GetUserAccessories ( playerid, ACS_MODEL, i ) != 0 ) continue ;

		return i ;
	}
	return -1 ;
}

stock give_accessories ( playerid, slotId, USER_ACCESSORIES_STRUCT: acsStruct [ ] )
{
	if ( GetUserAccessories ( playerid, ACS_ID, slotId ) ) return -1 ;

	GetUserAccessories ( playerid, ACS_MODEL, slotId ) = acsStruct [ _:ACS_MODEL ] ;
	GetUserAccessories ( playerid, ACS_COUNT, slotId ) = acsStruct [ _:ACS_COUNT ] ;
	GetUserAccessories ( playerid, ACS_ITEM_ID, slotId ) = acsStruct [ _:ACS_ITEM_ID ] ;
	if ( acsStruct [ _:ACS_MODEL ] == ITEM_SIM_CARD )
	{
		GetUserAccessories ( playerid, ACS_USED, slotId ) = 1 ;
		p_info [ playerid ] [ number ] = acsStruct [ _:ACS_COUNT ] ;
	}
	else if ( weapon_skins ( acsStruct [ _:ACS_MODEL ] ) )
	{
		foreach(new i: streamed_players[playerid])
		{
			if ( player_device { i } != 2 ) continue ;

			SetPlayerWeaponTexture ( playerid, i ) ;
		}
		SetPlayerWeaponTexture ( playerid, playerid ) ;
	}
	else
	{
		GetUserAccessories ( playerid, ACS_USED, slotId ) = 1 ;
	}

	if ( acsStruct [ _:ACS_MODEL ] == ITEM_SIM_CARD && ! acsStruct [ _:ACS_ITEM_ID ] )
	{
		simcard_inc_id ++ ;
		GetUserAccessories ( playerid, ACS_ITEM_ID, slotId ) = simcard_inc_id ;

		static const _str [ ] = "INSERT INTO licence_number (id,number) VALUES (%d,%d)" ;
		new sql_string [ sizeof _str + ( 9 * 2 ) ] ;
		format ( sql_string, sizeof sql_string, _str, simcard_inc_id, acsStruct [ _:ACS_COUNT ] ) ;
		mysql_tquery ( sql_connection, sql_string ) ;
	}

	new _query [ 256 ] ;
	if ( acsStruct [ _:ACS_DATE ] != -1 )
	{
		if ( ! acsStruct [ _:ACS_ID ] )
		{
			acc_inc_id ++ ;
			GetUserAccessories ( playerid, ACS_ID, slotId ) = acc_inc_id ;
		}
		else GetUserAccessories ( playerid, ACS_ID, slotId ) = acsStruct [ _:ACS_ID ] ;

		GetUserAccessories ( playerid, ACS_DATE, slotId ) = SetElapsedTime ( gettime ( ), acsStruct [ _:ACS_DATE ], CONVERT_TIME_TO_DAYS ) ;
		format ( _query, sizeof _query, "INSERT INTO `users_accessories` (`id`,`u_id`,`acs_slot_id`,`acs_model_id`,`acs_used`,`acs_other_id`,`acs_date`) VALUES ('%d','%d','%d','%d','%d','%d','%d')",
		GetUserAccessories ( playerid, ACS_ID, slotId ),
		p_info [ playerid ] [ id ],
		slotId,
		GetUserAccessories ( playerid, ACS_MODEL, slotId ),
		GetUserAccessories ( playerid, ACS_USED, slotId ),
		GetUserAccessories ( playerid, ACS_ITEM_ID, slotId ),
		GetUserAccessories ( playerid, ACS_DATE, slotId ) ) ;
		mysql_tquery ( sql_connection, _query ) ;
	}
	else
	{
		if ( ! acsStruct [ _:ACS_ID ] )
		{
			acc_inc_id ++ ;
			GetUserAccessories ( playerid, ACS_ID, slotId ) = acc_inc_id ;
		}
		else GetUserAccessories ( playerid, ACS_ID, slotId ) = acsStruct [ _:ACS_ID ] ;

	    GetUserAccessories ( playerid, ACS_DATE, slotId ) = acsStruct [ _:ACS_DATE ] ;
		format ( _query, sizeof _query, "INSERT INTO `users_accessories` (`id`,`u_id`,`acs_slot_id`,`acs_model_id`,`acs_used`,`acs_other_id`,`acs_date`) VALUES ('%d','%d','%d','%d','%d','%d','%d')",
		GetUserAccessories ( playerid, ACS_ID, slotId ),
		p_info [ playerid ] [ id ],
		slotId,
		GetUserAccessories ( playerid, ACS_MODEL, slotId ),
		GetUserAccessories ( playerid, ACS_USED, slotId ),
		GetUserAccessories ( playerid, ACS_ITEM_ID, slotId ),
		GetUserAccessories ( playerid, ACS_DATE, slotId ) ) ;
		mysql_tquery ( sql_connection, _query ) ;
	}

	if ( ! acsStruct [ _:ACS_ID ] )
	{
		insertAccessoriesFloat ( acc_inc_id ) ;
		insertAccessoriesStats ( acc_inc_id, acsStruct [ _:ACS_WEAR ] ) ;
	}

	GetUserAccessories ( playerid, ACS_OBJ_X, slotId ) = acsStruct [ _:ACS_OBJ_X ] ;
	GetUserAccessories ( playerid, ACS_OBJ_Y, slotId ) = acsStruct [ _:ACS_OBJ_Y ] ;
	GetUserAccessories ( playerid, ACS_OBJ_Z, slotId ) = acsStruct [ _:ACS_OBJ_Z ] ;
	GetUserAccessories ( playerid, ACS_ROT_X, slotId ) = acsStruct [ _:ACS_ROT_X ] ;
	GetUserAccessories ( playerid, ACS_ROT_Y, slotId ) = acsStruct [ _:ACS_ROT_Y ] ;
	GetUserAccessories ( playerid, ACS_ROT_Z, slotId ) = acsStruct [ _:ACS_ROT_Z ] ;

	attachUserAccessories ( playerid ) ;

	new modelId = acsStruct [ _:ACS_MODEL ] ;
	MODEL_INFO [ modelId ] [ MODEL_COUNT ] += 1 ;
	set_model_count ( modelId, MODEL_INFO [ modelId ] [ MODEL_COUNT ] ) ;

	updateInventoryAcsSlot ( playerid, slotId ) ;
	return GetUserAccessories ( playerid, ACS_ID, slotId ) ;
}

stock updateInventoryAcsSlot ( playerid, _slot )
{
	#if defined m_inventory_module
		if ( used_inventory [ playerid ] == true ) SetInventoryAcsID ( playerid, _slot ) ;
	#endif

	SetInventoryCacheAcsItem ( playerid, _slot ) ;
	return 1 ;
}

