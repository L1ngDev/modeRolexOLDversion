	CreateDynamic3DTextLabel("** Служебный компьютер **\n{"#cGR3D"}Введите {"#cWH3D"}'/comp'{"#cGR3D"}, чтобы включить", col_header_3d, 1380.9210, -37.0730, 1504.5602, 8.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, -1, -1 ) ;
	CreateDynamic3DTextLabel("** Служебный компьютер **\n{"#cGR3D"}Введите {"#cWH3D"}'/comp'{"#cGR3D"}, чтобы включить", col_header_3d, 1383.2861, -37.0734, 1504.5602, 8.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, -1, -1 ) ;
    CreateDynamic3DTextLabel("** Служебный компьютер **\n{"#cGR3D"}Введите {"#cWH3D"}'/comp'{"#cGR3D"}, чтобы включить", col_header_3d, 1385.5956, -37.0715, 1504.5602, 8.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, -1, -1 ) ;
	CreateDynamic3DTextLabel("** Служебный компьютер **\n{"#cGR3D"}Введите {"#cWH3D"}'/comp'{"#cGR3D"}, чтобы включить", col_header_3d, 1387.8903, -37.0715, 1504.5602, 8.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, -1, -1 ) ;
	//FBI
	CreateDynamic3DTextLabel("** Служебный компьютер **\n{"#cGR3D"}Введите {"#cWH3D"}'/comp'{"#cGR3D"}, чтобы включить", col_header_3d, 607.1599, -1206.0690, 1001.4650, 8.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, -1, -1 ) ;
	CreateDynamic3DTextLabel("** Служебный компьютер **\n{"#cGR3D"}Введите {"#cWH3D"}'/comp'{"#cGR3D"}, чтобы включить", col_header_3d, 610.8777, -1206.0696, 1001.4650, 8.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, -1, -1 ) ;
	CreateDynamic3DTextLabel("** Служебный компьютер **\n{"#cGR3D"}Введите {"#cWH3D"}'/comp'{"#cGR3D"}, чтобы включить", col_header_3d, 610.9747, -1203.4637, 1001.4650, 8.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, -1, -1 ) ;
	CreateDynamic3DTextLabel("** Служебный компьютер **\n{"#cGR3D"}Введите {"#cWH3D"}'/comp'{"#cGR3D"}, чтобы включить", col_header_3d, 607.3376, -1203.4639, 1001.4650, 8.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, -1, -1 ) ;
	CreateDynamic3DTextLabel("** Служебный компьютер **\n{"#cGR3D"}Введите {"#cWH3D"}'/comp'{"#cGR3D"}, чтобы включить", col_header_3d, 577.9346, -1203.3937, 1001.4650, 8.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, -1, -1 ) ;
	CreateDynamic3DTextLabel("** Служебный компьютер **\n{"#cGR3D"}Введите {"#cWH3D"}'/comp'{"#cGR3D"}, чтобы включить", col_header_3d, 574.2775, -1203.3943, 1001.4650, 8.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, -1, -1 ) ;
	CreateDynamic3DTextLabel("** Служебный компьютер **\n{"#cGR3D"}Введите {"#cWH3D"}'/comp'{"#cGR3D"}, чтобы включить", col_header_3d, 574.0429, -1205.9985, 1001.4650, 8.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, -1, -1 ) ;
	CreateDynamic3DTextLabel("** Служебный компьютер **\n{"#cGR3D"}Введите {"#cWH3D"}'/comp'{"#cGR3D"}, чтобы включить", col_header_3d, 577.7523, -1205.9994, 1001.4650, 8.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, -1, -1 ) ;

	actorid = CreateActor(153, 1514.2454, 1986.7888, 1046.6246, 88.5103);
	SetActorVirtualWorld ( actorid, 1 ) ;
	ApplyActorAnimation(actorid, "ped", "SEAT_IDLE", 4.1, 1, 0, 0, 0, 0);

	actorid = CreateActor(153, 1882.3779, 1477.6686, 103.2237, 272.3721);
	SetActorVirtualWorld ( actorid, 1 ) ;
	ApplyActorAnimation(actorid, "ped", "SEAT_IDLE", 4.1, 1, 0, 0, 0, 0);

	for ( new j = 0 ; j < MAX_DECORATION ; j ++ )
	{
		actorid = CreateActor ( actor_decor [ j ] [ actor_skin ],
								actor_decor [ j ] [ actor_pos ] [ 0 ],
								actor_decor [ j ] [ actor_pos ] [ 1 ],
								actor_decor [ j ] [ actor_pos ] [ 2 ],
								actor_decor [ j ] [ actor_pos ] [ 3 ] ) ;

	    SetActorVirtualWorld ( actorid, actor_decor [ j ] [ actor_world ] ) ;

	    if ( ! GetString ( actor_decor [ j ] [ actor_anim ], "none" ) )
			ApplyActorAnimation ( actorid, actor_decor [ j ] [ actor_anim ],  actor_decor [ j ] [ actor_anim_lib ],  4.1,  1,  1,  1,  1,  1 ) ;

		if ( object_decor [ j ] [ object_decor_id ] != -1 )
		{
			CreateDynamicObject ( object_decor [ j ] [ object_decor_id ], object_decor [ j ] [ object_pos ] [ 0 ],
																	object_decor [ j ] [ object_pos ] [ 1 ],
																	object_decor [ j ] [ object_pos ] [ 2 ],
																	object_decor [ j ] [ object_pos ] [ 3 ],
																	object_decor [ j ] [ object_pos ] [ 4 ],
																	object_decor [ j ] [ object_pos ] [ 5 ],
																 	object_decor [ j ] [ object_world ], object_decor [ j ] [ object_int ], -1, 300.00, 300.00);
		}
	}

	for ( new j = 0 ; j < MAX_QUEST_ACTORS ; j ++ )
	{
	    global_string [ 0 ] = EOS ;
		format ( global_string, 128, "** %s **\n{"#cGR3D"}Подойдите для взаимодействия", quest_actor [ j ] [ actor_name ] ) ;
		CreateDynamic3DTextLabel ( global_string, col_header_3d, quest_actor [ j ] [ actor_pos ] [ 0 ], quest_actor [ j ] [ actor_pos ] [ 1 ], quest_actor [ j ] [ actor_pos ] [ 2 ], 10.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, quest_actor [ j ] [ actor_world ], quest_actor [ j ] [ actor_interior ] ) ;

		actorid = CreateActor ( quest_actor [ j ] [ actor_skin ],
								quest_actor [ j ] [ actor_pos ] [ 0 ],
								quest_actor [ j ] [ actor_pos ] [ 1 ],
								quest_actor [ j ] [ actor_pos ] [ 2 ],
								quest_actor [ j ] [ actor_pos ] [ 3 ] ) ;

        SetActorVirtualWorld ( actorid, quest_actor [ j ] [ actor_world ] ) ;

        quest_actor_area [ j ] = CreateDynamicSphere ( quest_actor [ j ] [ actor_pos ] [ 0 ], quest_actor [ j ] [ actor_pos ] [ 1 ], quest_actor [ j ] [ actor_pos ] [ 2 ], 3.0, -1, -1, -1 ) ;
		area_info [ quest_actor_area [ j ] ] [ a_type ] = area_type_quest_actor ;
		area_info [ quest_actor_area [ j ] ] [ a_item ] = j ;

        if ( GetString ( quest_actor [ j ] [ actor_anim ], "none" ) ) continue ;
		ApplyActorAnimation ( actorid, quest_actor [ j ] [ actor_anim ],  quest_actor [ j ] [ actor_anim_lib ],  4.1,  1,  1,  1,  1,  1 ) ;
	}

	for ( new j = 0 ; j < MAX_BARRIERS ; j ++ )
	{
	    barrier_status [ j ] = false ;
		barrier_object [ j ] = CreateDynamicObject ( barrier_pos [ j ] [ object_bar ],
													barrier_pos [ j ] [ close_bar ] [ 0 ],
													barrier_pos [ j ] [ close_bar ] [ 1 ],
													barrier_pos [ j ] [ close_bar ] [ 2 ],
													barrier_pos [ j ] [ close_bar ] [ 3 ],
													barrier_pos [ j ] [ close_bar ] [ 4 ],
													barrier_pos [ j ] [ close_bar ] [ 5 ] ) ;

        barrier_area [ j ] = CreateDynamicSphere ( barrier_pos [ j ] [ label_bar ] [ 0 ], barrier_pos [ j ] [ label_bar ] [ 1 ], barrier_pos [ j ] [ label_bar ] [ 2 ], 10.0, -1, -1, -1 ) ;
		area_info [ barrier_area [ j ] ] [ a_type ] = area_type_barriers ;
		area_info [ barrier_area [ j ] ] [ a_item ] = j ;

		if ( barrier_pos [ j ] [ label_brs ] == true )
		{
			CreateDynamic3DTextLabel("** Барьер (для сотрудников) **\n{"#cGR3D"}Подойдите / посигнальте для взаимодействия", col_header_3d,
												barrier_pos [ j ] [ label_bar ] [ 0 ], barrier_pos [ j ] [ label_bar ] [ 1 ], barrier_pos [ j ] [ label_bar ] [ 2 ],
												15.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0 ) ;
		}

		if ( barrier_pos [ j ] [ type_bar ] == 2 )
		{
		    CreateDynamicObject ( 966,
								barrier_pos [ j ] [ place_bar ] [ 0 ],
								barrier_pos [ j ] [ place_bar ] [ 1 ],
								barrier_pos [ j ] [ place_bar ] [ 2 ],
								barrier_pos [ j ] [ place_bar ] [ 3 ],
								barrier_pos [ j ] [ place_bar ] [ 4 ],
								barrier_pos [ j ] [ place_bar ] [ 5 ] ) ;
		}
	}

    for ( new j = 0 ; j < MAX_DOORS ; j ++ )
	{
	    door_status [ j ] = false ;
	    door_area [ j ] = CreateDynamicSphere ( door_pos [ j ] [ label_doors ] [ 0 ], door_pos [ j ] [ label_doors ] [ 1 ], door_pos [ j ] [ label_doors ] [ 2 ], 3.0, door_pos [ j ] [ vw_doors ], door_pos [ j ] [ int_doors ], -1 ) ;
		area_info [ door_area [ j ] ] [ a_type ] = area_type_doors ;
		area_info [ door_area [ j ] ] [ a_item ] = j ;

		door_object [ j ] = CreateDynamicObject ( door_pos [ j ] [ object_doors ],
												door_pos [ j ] [ close_doors ] [ 0 ],
												door_pos [ j ] [ close_doors ] [ 1 ],
												door_pos [ j ] [ close_doors ] [ 2 ],
												door_pos [ j ] [ close_doors ] [ 3 ],
												door_pos [ j ] [ close_doors ] [ 4 ],
												door_pos [ j ] [ close_doors ] [ 5 ],
												door_pos [ j ] [ vw_doors ], door_pos [ j ] [ int_doors ] ) ;

		if ( door_pos [ j ] [ label_drs ] == true )
		{
			CreateDynamic3DTextLabel("** Дверь (для сотрудников) **\n{"#cGR3D"}Подойдите для взаимодействия", col_header_3d,
										door_pos [ j ] [ label_doors ] [ 0 ], door_pos [ j ] [ label_doors ] [ 1 ], door_pos [ j ] [ label_doors ] [ 2 ],
										5.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, door_pos [ j ] [ vw_doors ], door_pos [ j ] [ int_doors ] ) ;
		}
	}

	for ( new i = 0 ; i < CAR_MARKET_SLOTS ; i ++ )
	{
	    if ( car_market_pos [ i ] [ 0 ] == 0.0 ) continue ;

		car_market_area [ i ] = CreateDynamicSphere ( car_market_pos [ i ] [ 0 ], car_market_pos [ i ] [ 1 ], car_market_pos [ i ] [ 2 ], 5.0, -1, -1, -1 ) ;
		area_info [ car_market_area [ i ] ] [ a_type ] = area_type_car_market ;
		area_info [ car_market_area [ i ] ] [ a_item ] = i ;
	}

	for ( new j = 0 ; j < MAX_DM_ZONE ; j ++ )
	{
		anti_dm_area [ j ] = CreateDynamicRectangle ( anti_dm_pos [ j ] [ 0 ], anti_dm_pos [ j ] [ 1 ], anti_dm_pos [ j ] [ 2 ], anti_dm_pos [ j ] [ 3 ], anti_dm_data [ j ] [ 0 ], anti_dm_data [ j ] [ 1 ], -1 ) ;
		area_info [ anti_dm_area [ j ] ] [ a_type ] = area_type_antidm ;
		area_info [ anti_dm_area [ j ] ] [ a_item ] = j ;
	}

	for ( new j = 0 ; j < MAX_NONPARKING_ZONES ; j ++ )
	{
		non_parking_area [ j ] = CreateDynamicRectangle ( non_parking_pos [ j ] [ 0 ], non_parking_pos [ j ] [ 1 ], non_parking_pos [ j ] [ 2 ], non_parking_pos [ j ] [ 3 ], 0, 0, -1 ) ;
		area_info [ non_parking_area [ j ] ] [ a_type ] = area_type_noparking ;
		area_info [ non_parking_area [ j ] ] [ a_item ] = j ;
	}
	return 1 ;
}

callback: loading_server ( )
{
    printf ( "[SERVER] Пикапов: %d.", TotalPickup ) ;
    printf ( "[SERVER] Иконок на карте: %d.", TotalMapIcon ) ;
    printf ( "[SERVER] Динамических зон: %d.", CountDynamicAreas ( ) ) ;
    printf ( "[SERVER] 3D текстов: %d.", CountDynamic3DTextLabels ( ) ) ;

	printf ( "[SERVER] Динамических объектов: %d.", CountDynamicObjects ( ) ) ;
	printf ( "[SERVER] Статических объектов: %d.", TotalObject ) ;

	Streamer_SetVisibleItems( STREAMER_TYPE_OBJECT, MAX_OBJECTS - TotalObject ) ;

	printf ( "[SERVER] Видимых объектов (стример): %d.", Streamer_GetVisibleItems ( STREAMER_TYPE_OBJECT ) ) ;

    printf ( "[SERVER] Загрузка игрового режима заняла: %d ms.", GetTickCount ( ) - loading_time ) ;
	return 1 ;
}

public OnGameModeExit ( )
{
    mysql_close ( sql_connection ) ;
    mysql_close ( launcher_connection ) ;

    if ( gstream ) SvDeleteStream ( gstream ) ;
	return 1 ;
}

stock reset_tree ( )
{
    if ( tree_count >= 16 )
	{
		for ( new i = 0 ; i < sizeof ( tree_positions ) ; i ++ )
		{
			if ( tree_object [ i ] != INVALID_OBJECT_ID ) DestroyDynamicObject ( tree_object [ i ] ) ;
			if ( IsValidDynamicPickup ( tree_pick [ i ] ) ) DestroyDynamicPickup ( tree_pick [ i ] ) ;

			tree_object [ i ] = CreateDynamicObjectEx ( 618, tree_positions [ i ] [ 0 ], tree_positions [ i ] [ 1 ], tree_positions [ i ] [ 2 ] - 1.5, tree_positions [ i ] [ 3 ], tree_positions [ i ] [ 4 ], tree_positions [ i ] [ 5 ] ) ;
			#if defined SAMP
				SetDynamicObjectMaterial ( tree_object [ i ], 0, -1, "none", "none", 0xFFFFFFFF ) ;
			#endif
		}
		tree_count = 0 ;
	}
	return 1 ;
}

public OnRconCommand(cmd[])
{
	return 1 ;
}

public OnRconLoginAttempt(ip[], password[], success)
{
	return 1 ;
}

public OnQueryError ( errorid, error [ ], callback [ ], query [ ], connectionHandle )
{
	print ( "[OnQueryError] SQL ERROR. QUERY:" ) ;
	printf ( "0) OnQueryError | error: %s", error ) ;
	printf ( "1) OnQueryError | callback: %s", callback ) ;
	printf ( "2) OnQueryError | query: %s", query ) ;
	printf ( "3) OnQueryError | errorid: %d", errorid ) ;
	return 1 ;
}

stock head_menu ( playerid )
{
	if ( ! mafia_player ( playerid ) ) return 1 ;
    show_dialog ( playerid, d_contract, DIALOG_STYLE_LIST, "{"#cBHD"}Заказное убийство", "{"#cBL"}1. {"#cWH"}Доступные контракты\n{"#cBL"}2. {"#cWH"}Информация о заказе\n{"#cBL"}3. {"#cWH"}Поиск заказа", "Выбрать", "Назад" ) ;
	return 1 ;
}

stock searching_head ( playerid )
{
	new _id_head = 0 ;
	new line_string [ 128 ] ;
	global_string [ 0 ] = EOS ;
	foreach(new i: logged_players)
	{
		if ( p_info [ i ] [ head_value ] > 0 && c_info [ i ] [ c_player ] == INVALID_PLAYER_ID )
		{
		    if ( playerid == i ) continue ;
		    if ( p_info [ playerid ] [ member ] == p_info [ i ] [ member ] ) continue ;

		    if ( _id_head >= 20 ) break ;

			set_player_listitem_values ( playerid, _id_head, i ) ;

			_id_head ++ ;

			format ( line_string, sizeof line_string, "{"#cBL"}%i. {"#cWH"}%s[%d] - {"#cBL"}%d"valute_title_"\n", _id_head, p_info [ i ] [ name ], i, p_info [ i ] [ head_value ] ) ;
			strcat ( global_string, line_string ) ;
		}
	}
	if ( _id_head == 0 ) return show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Доступные контракты", "{"#cWH"}Нету доступных контрактов.", "Закрыть", "" ) ;
	show_dialog ( playerid, d_contract_select, DIALOG_STYLE_LIST, "{"#cBHD"}Доступные контракты", global_string, "Выбрать", "Назад" ) ;
	return 1 ;
}

stock clear_jackcar_player ( playerid )
{
    if ( p_t_info [ playerid ] [ c_vehicle ] != INVALID_VEHICLE_ID )
	{
		DestroyVehicle ( p_t_info [ playerid ] [ c_vehicle ], 25 ) ;
		p_t_info [ playerid ] [ c_vehicle ] = INVALID_VEHICLE_ID ;
	}

	if ( p_t_info [ playerid ] [ c_gangzone ] != -1 )
 	{
		GangZoneHideForPlayer ( playerid, p_t_info [ playerid ] [ c_gangzone ] ) ;
		GangZoneDestroy ( p_t_info [ playerid ] [ c_gangzone ] ) ;
		p_t_info [ playerid ] [ c_gangzone ] = -1 ;
 	}

 	if ( p_t_info [ playerid ] [ c_pos_toggled ] != -1 )
 	{
	 	if ( p_info [ playerid ] [ jackcar_skill ] < 51 ) ls_place_toggled [ p_t_info [ playerid ] [ c_pos_toggled ] ] = false ;
		else if ( p_info [ playerid ] [ jackcar_skill ] > 50 && p_info [ playerid ] [ jackcar_skill ] < 101 ) sf_place_toggled [ p_t_info [ playerid ] [ c_pos_toggled ] ] = false ;
		else if ( p_info [ playerid ] [ jackcar_skill ] > 100 && p_info [ playerid ] [ jackcar_skill ] < 151 ) lv_place_toggled [ p_t_info [ playerid ] [ c_pos_toggled ] ] = false ;
		else premium_place_toggled [ p_t_info [ playerid ] [ c_pos_toggled ] ] = false ;

		p_t_info [ playerid ] [ c_pos_toggled ] = -1 ;
	}
	return 1 ;
}

stock show_skinshop_ptd ( playerid, _type, bool: status )
{
	if ( status )
	{
		if ( _type == 1 )
		{
		    for ( new i = 0; i < 28 ; i ++ )
			{
				TextDrawShowForPlayer ( playerid, td_skinshop [ i ] ) ;
			}

			td_skinshop_price [ playerid ] = CreatePlayerTextDraw(playerid, 314.9333, 383.3036, "0$"); // пусто
			PlayerTextDrawLetterSize(playerid, td_skinshop_price [ playerid ], 0.1589, 1.1768);
			PlayerTextDrawAlignment(playerid, td_skinshop_price [ playerid ], 2);
			PlayerTextDrawColor(playerid, td_skinshop_price [ playerid ], color_box);
			PlayerTextDrawBackgroundColor(playerid, td_skinshop_price [ playerid ], 255);
			PlayerTextDrawFont(playerid, td_skinshop_price [ playerid ], 2);
			PlayerTextDrawSetProportional(playerid, td_skinshop_price [ playerid ], 1);
			PlayerTextDrawSetShadow(playerid, td_skinshop_price [ playerid ], 0);

			PlayerTextDrawShow ( playerid, td_skinshop_price [ playerid ] ) ;
			SetPlayerSkin ( playerid, shop_skins [ p_info [ playerid ] [ gender ] ] [ 0 ] ) ;

			new _td_string [ 16 ] ;
			format ( _td_string, sizeof _td_string, "%d$", shop_skins_price [ p_info [ playerid ] [ gender ] ] [ 0 ] ) ;
			PlayerTextDrawSetString ( playerid, td_skinshop_price [ playerid ], _td_string ) ;
		}
		else if ( _type == 2 )
		{
		    for ( new i = 0; i < 28 ; i ++ )
			{
				TextDrawShowForPlayer ( playerid, acc_td [ i ] ) ;
			}

			acc_ptd [ playerid ] = CreatePlayerTextDraw(playerid, 314.9333, 383.3036, "0$"); // пусто
			PlayerTextDrawLetterSize(playerid, acc_ptd [ playerid ], 0.1589, 1.1768);
			PlayerTextDrawAlignment(playerid, acc_ptd [ playerid ], 2);
			PlayerTextDrawColor(playerid, acc_ptd [ playerid ], color_box);
			PlayerTextDrawBackgroundColor(playerid, acc_ptd [ playerid ], 255);
			PlayerTextDrawFont(playerid, acc_ptd [ playerid ], 2);
			PlayerTextDrawSetProportional(playerid, acc_ptd [ playerid ], 1);
			PlayerTextDrawSetShadow(playerid, acc_ptd [ playerid ], 0);

			new _td_string [ 16 ] ;
			format ( _td_string, sizeof _td_string, "%d$", accessories_items_price [ GetPVarInt ( playerid, "p_acc_listitem" ) - 1 ] [ 0 ] ) ;
			PlayerTextDrawSetString ( playerid, acc_ptd [ playerid ], _td_string ) ;
			PlayerTextDrawShow ( playerid, acc_ptd [ playerid ] ) ;
		}

		SelectTextDraw ( playerid, 0xB0C4DEFF ) ;
	}
	else
	{
	    if ( _type == 1 )
	    {
	        for ( new i = 0; i < 28 ; i ++ )
			{
				TextDrawHideForPlayer ( playerid, td_skinshop [ i ] ) ;
			}
			PlayerTextDrawDestroy ( playerid, td_skinshop_price [ playerid ] ) ;
			td_skinshop_price [ playerid ] = PlayerText:-1 ;
	    }
	    else if ( _type == 1 )
	    {
	        for ( new i = 0; i < 28 ; i ++ )
			{
				TextDrawHideForPlayer ( playerid, acc_td [ i ] ) ;
			}
			PlayerTextDrawDestroy ( playerid, acc_ptd [ playerid ] ) ;
			acc_ptd [ playerid ] = PlayerText:-1 ;
	    }

	    CancelSelectTextDraw ( playerid ) ;
	}
	return 1 ;
}

stock show_carmarket ( playerid )
{
    new dialog_str [ 246 ],
		line_str [ 46 ],
		_c_count = 0 ;

	strcat ( dialog_str, "{"#cGRDialog"}Выберите транспорт для продажи:{ffffff}\n" ) ;
	foreach(new veh_id: player_vehicles[ playerid ])
	{
		if ( veh_info [ veh_id - 1 ] [ v_date_used ] > 0 ) continue ;
		if ( veh_info [ veh_id - 1 ] [ v_date_used ] == -1 ) continue ;

		set_player_listitem_values ( playerid, _c_count, veh_id ) ;
		_c_count ++ ;

		format ( line_str, 46, "%s\n", GetVehicleNameEx ( veh_id ) ) ;
		strcat ( dialog_str, line_str ) ;
	}
	if ( _c_count < 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет транспорта для продажи!" ) ;
	show_dialog(playerid, d_carmarket, DIALOG_STYLE_LIST, "{"#cBHD"}Авторынок", dialog_str, "Выбрать", "Закрыть" ) ;
	return 1 ;
}

callback: callback_info_complaints ( playerid, _typing )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( rows )
	{
	    if ( _typing == 1 )
	    {
		    new fromname [ MAX_PLAYER_NAME ], toname [ MAX_PLAYER_NAME ], reason [ 64 ] ;
			cache_get_field_content ( 0, "u_fromname", fromname, sql_connection, MAX_PLAYER_NAME ) ;
			cache_get_field_content ( 0, "u_toname", toname, sql_connection, MAX_PLAYER_NAME ) ;
			cache_get_field_content ( 0, "u_reason", reason, sql_connection, 64 ) ;

			new string [ 212 ] ;
			format ( string, sizeof ( string ), "\n{"#cBL"}Жалоба от игрока: {"#cWH"}%s{"#cGRDialog"} на игрока: {"#cWH"}%s\n\n{"#cBL"}Причина жалобы: {"#cWH"}%s", fromname, toname, reason ) ;
			show_dialog ( playerid, d_clearinfo, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Просмотр жалобы", string, "Закрыть", "" ) ;
		}
		else if ( _typing == 2 )
		{
		}
	}
	return 1 ;
}

callback: callback_check_simcard ( playerid, p_number, _listitem, price )
{
    player_select_count [ playerid ] ++ ;

    new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( rows )
	{
	    p_number = RandomEx ( 100000, 999999 ) ;
		if ( player_select_count [ playerid ] >= 5 )
		{
		    player_select_count [ playerid ] = 0 ;
			SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Произошла ошибка, попробуйте еще раз." ) ;
			SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Все варианты подбора уже заняты. Попробуйте подобрать номер ещё раз." ) ;
			return 1 ;
		}

		new _p_number = RandomEx ( 100000, 999999 ) ;
		static const _str [ ] = "SELECT 1 FROM licence_number WHERE number='%d'" ;
		new query_string [ sizeof _str + 9 ] ;
		format ( query_string, sizeof ( query_string ), _str, _p_number ) ;
		mysql_tquery ( sql_connection, query_string, "callback_check_simcard", "iiii", playerid, _p_number, _listitem, price ) ;
	    return 1 ;
	}

    player_select_count [ playerid ] = 0 ;

	if ( ! getPlayerAccessories ( playerid, ITEM_SIM_CARD ) )
	{
		new USER_ACCESSORIES_STRUCT: acsStruct [ _:ACS_STRUCTURE_MAX ] ;
		acsStruct [ _:ACS_ID ] = 0 ;
		acsStruct [ _:ACS_MODEL ] = ITEM_SIM_CARD ;
		acsStruct [ _:ACS_USED ] = 0 ;
		acsStruct [ _:ACS_DATE ] = -1 ;
		acsStruct [ _:ACS_COUNT ] = p_number ;
		give_accessories ( playerid, getFreeSlotAccessories ( playerid ), acsStruct ) ;
	}
	else
	{
		new USERS_INVENTORY_STRUCT: inventoryStruct [ _:INV_STRUCTURE_MAX ] ;
		inventoryStruct [ _:INV_ITEM ] = ITEM_SIM_CARD ;
		inventoryStruct [ _:INV_ITEM_COUNT ] = 1 ;
		inventoryStruct [ _:INV_ITEM_TYPE ] = INVENTORY_TYPE_SIMCARD ;
		inventoryStruct [ _:INV_ITEM_PLATE_TYPE ] = NUMBERPLATE_TYPE_NONE ;
		inventoryStruct [ _:INV_ITEM_GIVE_DATE ] = p_number ;
		inventoryStruct [ _:INV_ITEM_ID ] = 0 ;
		inventoryStruct [ _:INV_ITEM_DATE ] = -1 ;
		giveInventory ( playerid, inventoryStruct ) ;
	}

	p_info [ playerid ] [ model_phone ] = 18866 ;
	if ( ! p_info [ playerid ] [ number ] ) p_info [ playerid ] [ number ] = p_number ;

	global_string [ 0 ] = EOS ;
	format ( global_string, 600, "\
		{"#cWH"}Вы успешно приобрели мобильный телефон. Ваш номер: {"#cYW"}%d{"#cWH"}.\n\
		Для использования новой сим-карты в мобильном смартфоне необходимо\n\
		выбрать новый номер в инвентаре и переместить в блок {"#cTN"}аксессуаров{"#cWH"}.\n\n\
		Номер, который используется в телефоне сейчас - будет находиться\n\
		в {"#cTN"}инвентаре {"#cWH"}в блоке {"#cTN"}аксессуаров{"#cWH"}.\n\n\
		{"#cWH"}Используйте {"#cTN"}/sms {"#cWH"}для отправки сообщений.\n\
		{"#cWH"}Используйте {"#cTN"}/call {"#cWH"}для звонка.\n\
		{"#cWH"}Используйте {"#cTN"}/number {"#cWH"}для того, чтоб узнать номер игрока.", p_number ) ;
	show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Покупка телефона", global_string, "Принять", "" ) ;

	g_phone_call [ playerid ] [ PC_ENABLED ] = true ;
	p_info [ playerid ] [ phone_balance ] = 20 ;

	global_string [ 0 ] = EOS ;
	format ( global_string, 100, "UPDATE `users` SET `u_model_phone` = '%d' WHERE `u_id` = '%d' LIMIT 1", 18866, p_info [ playerid ] [ id ] ) ;
	mysql_tquery ( sql_connection, global_string ) ;

	new b = GetPVarInt ( playerid, "p_biz_id" ) - 1 ;
	give_bmoney ( b + 1, price, b_shop_product [ _listitem ] ) ;

	give_event_progress ( playerid, THE_BUY_247, 1 ) ;
	checking_quest_progress ( playerid, 4, 1, quest_line_start ) ;

	if ( player_device { playerid } == 2 ) { }
	else ShowShopDialog ( playerid, 1 ) ;

	give_money ( playerid, -price ) ;
	insert_money_log ( playerid, INVALID_PLAYER_ID, -price, "Закуп 24/7" ) ;
	return 1 ;
}

callback: callback_insert_user ( playerid, ds_password [ ] )
{
	new query_string [ 156 ] ;
    mysql_format ( sql_connection, query_string, 156, "SELECT * FROM `users` WHERE `u_name` = '%s' AND `u_password` = '%s' LIMIT 1", p_info [ playerid ] [ name ], ds_password ) ;
	mysql_tquery ( sql_connection, query_string, "load_user", "i", playerid ) ;

	CheckAndroidID ( playerid, 1 ) ;
	return 1 ;
}

callback: checkin_date_reg ( playerid )
{
    new rows, fields ;
	cache_get_data ( rows, fields ) ;

	if ( ! rows ) SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Дата регистрации указана не верно." ) ;
	else
	{
	    new scm_string [ 144 ] ;
    	format ( scm_string,sizeof(scm_string), "UPDATE `users` SET `u_ip_registration` = `%s` WHERE `u_id` = '%d' LIMIT 1", p_t_info [ playerid ] [ p_ip ], p_info [ playerid ] [ id ] ) ;
		mysql_tquery ( sql_connection, scm_string ) ;

		p_t_info [ playerid ] [ owner_account ] = false ;

		SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы подтвердили IP адрес. Ограничения сняты." ) ;
	}
	return 1 ;
}

public OnDialogResponse ( playerid, dialogid, response, listitem, inputtext [ ] )
{
	#if defined debug_mode
		printf ( "[DEBUG] [OnDialogResponse] playerid:%d | dialogid:%d | listitem:%d | p_t_info:%d", playerid, dialogid, listitem, p_t_info [ playerid ] [ p_dialog ] ) ;
	#endif

	#if defined mini_debug_mode
		printf ( "[DEBUG] [OnDialogResponse] playerid:%d | dialogid:%d | listitem:%d | p_t_info:%d", playerid, dialogid, listitem, p_t_info [ playerid ] [ p_dialog ] ) ;
	#endif

	for ( new i = 0 ; i < strlen ( inputtext ) ; i ++ ) if ( inputtext [ i ] == '%' ) inputtext [ i ] = '#' ;
	//while ( strfind ( inputtext, "%s", true ) != -1 ) strdel ( inputtext, strfind ( inputtext, "%s", true), strfind ( inputtext, "%s", true ) + 2 ) ;
	//while ( strfind ( inputtext, "%", true ) != -1 ) strdel ( inputtext, strfind ( inputtext, "%", true), strfind ( inputtext, "%", true ) + 2 ) ;
	//if ( strfind ( inputtext, "=", true ) != -1 ) return 1 ;

	if ( ( google_checking { playerid } == 1 && dialogid != d_googleauth_entrance ) ) return 1 ;

    if ( p_t_info [ playerid ] [ dialog_timer ] > GetTickCount ( ) )
	{
	    p_t_info [ playerid ] [ p_dialog ] = -1 ;
		return 1 ;
	}
	else p_t_info [ playerid ] [ dialog_timer ] = GetTickCount ( ) + 300 ;

	if ( p_t_info [ playerid ] [ p_dialog ] != dialogid )
	{
		p_t_info [ playerid ] [ p_dialog ] = -1 ;
		return 1 ;
	}
	p_t_info [ playerid ] [ p_dialog ] = -1 ;

	#if defined m_garage_auction
		if ( garage_auction_OnDialogResponse ( playerid, dialogid, response, listitem, inputtext ) ) return 1 ;
	#endif

	#if defined m_ammunation
		if ( ammunation_OnDialogResponse ( playerid, dialogid, response, listitem ) ) return 1 ;
	#endif

	#if defined m_auction
		auction_OnDialogResponse ( playerid, dialogid, response, listitem, inputtext ) ;
	#endif

	#if defined m_credit
		if ( credit_OnDialogResponse ( playerid, dialogid, response, listitem, inputtext ) ) return 1 ;
	#endif

	#if defined m_familys
		if ( familys_OnDialogResponse ( playerid, dialogid, response, listitem, inputtext ) ) return 1 ;
	#endif

	#if defined m_player_race
		player_race_OnDialogResponse ( playerid, dialogid, response, listitem, inputtext ) ;
	#endif

	#if defined m_treasure
		if ( tr_OnDialogResponse ( playerid, dialogid, response, listitem, inputtext ) ) return 1 ;
	#endif

	#if defined m_quest
		if ( quest_OnDialogResponse ( playerid, dialogid, response, listitem, inputtext ) ) return 1 ;
	#endif

	#if defined m_pickup_car
	    if ( pc_OnDialogResponse ( playerid, dialogid, response, listitem, inputtext ) ) return 1 ;
	#endif

	#if defined m_jobs_module
	    if ( trucker_OnDialogResponse ( playerid, dialogid, response, listitem, inputtext ) ) return 1 ;
	#endif

	#if defined m_incass
	    if ( incass_OnDialogResponse ( playerid, dialogid, response, listitem, inputtext ) ) return 1 ;
	#endif

	#if defined m_epass
	    if ( epass_OnDialogResponse ( playerid, dialogid, response, listitem, inputtext ) ) return 1 ;
	#endif

	#if defined m_fishing
	    if ( fishing_OnDialogResponse ( playerid, dialogid, response, listitem, inputtext ) ) return 1 ;
	#endif

	#if defined m_garden
	    if ( garden_OnDialogResponse ( playerid, dialogid, response, listitem, inputtext ) ) return 1 ;
	#endif

	#if defined m_anticheat
	    if ( anticheat_OnDialogResponse ( playerid, dialogid, response, listitem, inputtext ) ) return 1 ;
	#endif

	#if defined m_delivery
	    if ( delivery_OnDialogResponse ( playerid, dialogid, response, listitem, inputtext ) ) return 1 ;
	#endif

	#if defined m_details_thief
	    if ( thief_OnDialogResponse ( playerid, dialogid, response, listitem, inputtext ) ) return 1 ;
	#endif

	#if defined m_inventory_module
	    if ( trade_OnDialogResponse ( playerid, dialogid, response, listitem, inputtext ) ) return 1 ;
	    if ( market_OnDialogResponse ( playerid, dialogid, response, listitem, inputtext ) ) return 1 ;
		if ( mp_OnDialogResponse ( playerid, dialogid, response, listitem, inputtext ) ) return 1 ;
	#endif

	#if defined m_coin
	    if ( coin_OnDialogResponse ( playerid, dialogid, response, listitem, inputtext ) ) return 1 ;
	#endif

	#if defined m_t_stage
	    if ( stage_OnDialogResponse ( playerid, dialogid, response, listitem, inputtext ) ) return 1 ;
	#endif

	#if defined m_perks
	    if ( perks_OnDialogResponse ( playerid, dialogid, response, listitem, inputtext ) ) return 1 ;
	#endif

	#if defined m_donate
	    if ( donate_OnDialogResponse ( playerid, dialogid, response, listitem, inputtext ) ) return 1 ;
	#endif

	#if defined m_prison
	    if ( prison_OnDialogResponse ( playerid, dialogid, response, listitem, inputtext ) ) return 1 ;
	#endif

	#if defined m_binders
	    if ( binders_OnDialogResponse ( playerid, dialogid, response, listitem, inputtext ) ) return 1 ;
	#endif

	#if defined m_winter
	    if ( winter_OnDialogResponse ( playerid, dialogid, response, listitem, inputtext ) ) return 1 ;
	#endif

	#if defined m_tune
	    if ( tune_OnDialogResponse ( playerid, dialogid, response, listitem, inputtext ) ) return 1 ;
	    if ( tire_OnDialogResponse ( playerid, dialogid, response, listitem, inputtext ) ) return 1 ;
		if ( component_OnDialogResponse ( playerid, dialogid, response, listitem, inputtext ) ) return 1 ;
	#endif

	#if defined m_plates
	    if ( plates_OnDialogResponse ( playerid, dialogid, response, listitem, inputtext ) ) return 1 ;
	#endif

	#if defined m_casino_slots
	    if ( slots_OnDialogResponse ( playerid, dialogid, response, listitem, inputtext ) ) return 1 ;
	#endif

	#if defined m_casino_blackjack
	    if ( bj_OnDialogResponse ( playerid, dialogid, response, listitem, inputtext ) ) return 1 ;
	#endif

	#if defined m_fractions
		if ( fractions_OnDialogResponse ( playerid, dialogid, response, listitem, inputtext ) ) return 1 ;
	#endif

	#if defined m_tablet
		if ( t_market_OnDialogResponse ( playerid, dialogid, response, listitem, inputtext ) ) return 1 ;
		if ( t_bank_OnDialogResponse ( playerid, dialogid, response, listitem, inputtext ) ) return 1 ;
		if ( t_auctions_OnDialogResponse ( playerid, dialogid, response, listitem, inputtext ) ) return 1 ;
		if ( t_taxi_OnDialogResponse ( playerid, dialogid, response, listitem, inputtext ) ) return 1 ;
	#endif

	#if defined m_radial_menu
		if ( buoyancy_OnDialogResponse ( playerid, dialogid, response, listitem, inputtext ) ) return 1 ;
	#endif

	#if defined m_acessories
		if ( workshop_OnDialogResponse ( playerid, dialogid, response, listitem, inputtext ) ) return true ;
	#endif

	//if ( ac_OnDialogResponse ( playerid, dialogid, response, listitem, inputtext ) ) return 1 ;
	switch ( dialogid )
	{
		case d_casino_chips:
		{
			if ( ! response ) return 1 ;

			switch ( listitem )
			{
				case 0: show_dialog ( playerid, d_casino_chips_buy, DIALOG_STYLE_INPUT, "{"#cBHD"}Покупка фишек", "{"#cWH"}Введите количество фишек, которое хотите купить:", "Купить", "Закрыть" ) ;
				case 1: show_dialog ( playerid, d_casino_chips_sell, DIALOG_STYLE_INPUT, "{"#cBHD"}Продажа фишек", "{"#cWH"}Введите количество фишек, которое хотите продать:", "Продать", "Закрыть" ) ;
			}
			return 1 ;
		}
		case d_casino_chips_buy:
		{
			if ( ! response ) return 1 ;

			new _value = strval ( inputtext ), _price = _value * CASINO_CHIP_PRICE ;
			if ( _value < 1 || _value > 500 )
			{
				show_dialog ( playerid, d_casino_chips_buy, DIALOG_STYLE_INPUT, "{"#cBHD"}Покупка фишек", "{"#cRD"}* Купить можно 1 до 500 фишек за раз.\n\n{"#cWH"}Введите количество фишек, которое хотите купить:", "Купить", "Закрыть" ) ;
				return 1 ;
			}

			if ( _value * CASINO_CHIP_PRICE < 1 || _value * CASINO_CHIP_PRICE > p_info [ playerid ] [ money ] )
			{
				show_dialog ( playerid, d_casino_chips_buy, DIALOG_STYLE_INPUT, "{"#cBHD"}Покупка фишек", "{"#cRD"}* У Вас недостаточно средств.\n\n{"#cWH"}Введите количество фишек, которое хотите купить:", "Купить", "Закрыть" ) ;
				return 1 ;
			}

			give_money ( playerid, -_price ) ;
            insert_money_log ( playerid, INVALID_PLAYER_ID, -_price, "покупка фишек" ) ;

			give_inventory (
				playerid,
				ITEM_CASINO_CHIPS,
				_value,
				0,
				"",
				"",
				NUMBERPLATE_TYPE_NONE,
				0
			) ;
			return 1 ;
		}
		case d_casino_chips_sell:
		{
			if ( ! response ) return 1 ;

			new _value = strval ( inputtext ), _price = _value * CASINO_CHIP_PRICE ;
			if ( _value < 1 )
			{
				show_dialog ( playerid, d_casino_chips_sell, DIALOG_STYLE_INPUT, "{"#cBHD"}Продажа фишек", "{"#cRD"}* Вы указали неверное количество.\n\n{"#cWH"}Введите количество фишек, которое хотите продать:", "Продать", "Закрыть" ) ;
				return 1 ;
			}

			if ( _value > GetInventoryFindItem ( playerid, SUB_INVENTORY, ITEM_CASINO_CHIPS ) )
			{
				show_dialog ( playerid, d_casino_chips_sell, DIALOG_STYLE_INPUT, "{"#cBHD"}Продажа фишек", "{"#cRD"}* У Вас недостаточно фишек.\n\n{"#cWH"}Введите количество фишек, которое хотите продать:", "Продать", "Закрыть" ) ;
				return 1 ;
			}

			if ( p_info [ playerid ] [ money ] + _price > max_money || p_info [ playerid ] [ money ] + _price < 1 )
			{
				show_dialog ( playerid, d_casino_chips_sell, DIALOG_STYLE_INPUT, "{"#cBHD"}Продажа фишек", "{"#cRD"}* Вы не можете иметь сумму более 1.800.000.000 "valute_title".\n\n{"#cWH"}Введите количество фишек, которое хотите продать:", "Продать", "Закрыть" ) ;
				return 1 ;
			}

			give_money ( playerid, _price ) ;
            insert_money_log ( playerid, INVALID_PLAYER_ID, _price, "продажа фишек" ) ;

			clear_inventory ( playerid, ITEM_CASINO_CHIPS, _value ) ;
			return 1 ;
		}
		case d_thelp:
		{
			if ( response && listitem == 10 )
			{
				show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}О тестовой администрации",
					"{"#cWH"}Тестовая администрация выдаётся участникам тестирования обновлений.\n\n\
					Она позволяет наблюдать за игроками, перемещаться и проверять игровые механики,\n\
					но не даёт доступа к наказаниям, экономике и управлению сервером.\n\n\
					{"#cOR"}Права временные и могут быть сняты после окончания тестирования или открытия обновления.",
					"Понятно", "" ) ;
			}
			return 1 ;
		}
		case d_use_patrons:
		{
		    if ( ! response ) return 1 ;

		    if ( GetPlayerWeapon ( playerid ) < 22 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Возьми в руки огнестрельное оружие!" ) ;

		    new _value = strval ( inputtext ), _pt = GetInventoryFindItem ( playerid, SUB_INVENTORY, 2154 ) ;
		    if ( _value < 1 || _value > _pt ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы указали некорректное количество!" ) ;

            give_weapon ( playerid, GetPlayerWeapon ( playerid ), _value ) ;
            clear_inventory ( playerid, 2154, _value ) ;
		    return 1 ;
		}
	    case d_admins:
	    {
			if ( ! response ) return 1 ;

			if ( GetString ( inputtext, "Предыдущая страница" ) ) adminsList ( playerid, page_count [ playerid ] - 1 ) ;
			else if ( GetString ( inputtext, "Следующая страница" ) ) adminsList ( playerid, page_count [ playerid ] + 1 ) ;
			else if ( GetString ( inputtext, "Информация" ) )
			{
				global_string [ 0 ] = EOS ;
				format ( global_string, sizeof global_string, "\
					{"#cWH"}Отвечено репортов за сеанс:\t%d шт.\n\
					Отвечено репортов за сутки:\t%d шт.\n\
					Отвечено репортов за все время:\t%d шт.\n\
					Время администрирования за сеанс:\t%d минут(ы).\n\
					Время администрирования всего:\t%d минут(ы).",
				admin_info [ playerid ] [ report ],
				admin_info [ playerid ] [ day_report ] + admin_info [ playerid ] [ report ],
				admin_info [ playerid ] [ all_report ] + admin_info [ playerid ] [ report ],
				floatround ( p_info [ playerid ] [ time_played ] / 60 ),
				floatround ( p_info [ playerid ] [ time_played ] / 60 ) + floatround ( admin_info [ playerid ] [ admin_played ] / 60 ) ) ;
				show_dialog ( playerid, d_none, DIALOG_STYLE_TABLIST, "{"#cBHD"}Информация", global_string, "Закрыть", "" ) ;
			}
	        return 1 ;
	    }
	    case d_meeting:
	    {
	        if ( ! response ) return 1 ;

	        meetingPropertyList ( playerid, listitem, 0 ) ;
	        return 1 ;
	    }
	    case d_meeting_house:
	    {
			if ( ! response ) return 1 ;

			if ( GetString ( inputtext, "Предыдущая страница" ) ) meetingPropertyList ( playerid, 0, page_count [ playerid ] - 1 ) ;
			else if ( GetString ( inputtext, "Следующая страница" ) ) meetingPropertyList ( playerid, 0, page_count [ playerid ] + 1 ) ;
			else
			{
				new idx = get_player_listitem_values ( playerid, listitem ) ;
				if ( h_info [ idx ] [ h_podezd ] != -1 )
				{
					new _padik_id = h_info [ idx ] [ h_podezd ] ;
					SetPlayerRaceCheckpoint ( playerid, 1, podezd_info [ _padik_id ] [ p_pos ] [ 0 ], podezd_info [ _padik_id ] [ p_pos ] [ 1 ], podezd_info [ _padik_id ] [ p_pos ] [ 2 ], 0.0, 0.0, 0.0, 4.0 ) ;
				}
				else SetPlayerRaceCheckpoint ( playerid, 1, h_info [ idx ] [ h_pos ] [ 0 ], h_info [ idx ] [ h_pos ] [ 1 ], h_info [ idx ] [ h_pos ] [ 2 ], 0.0, 0.0, 0.0, 4.0 ) ;
				SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Дом обозначен на карте красной меткой." ) ;
				is_gps_used { playerid } = 1 ;
			}
	        return 1 ;
	    }
	    case d_meeting_bizz:
	    {
			if ( ! response )
			{
				page_count [ playerid ] =
				page_rows [ playerid ] = 0 ;
				return 1 ;
			}

			if ( GetString ( inputtext, "Предыдущая страница" ) ) meetingPropertyList ( playerid, 1, page_count [ playerid ] - 1 ) ;
			else if ( GetString ( inputtext, "Следующая страница" ) ) meetingPropertyList ( playerid, 1, page_count [ playerid ] + 1 ) ;
			else
			{
				new idx = get_player_listitem_values ( playerid, listitem ) ;
				SetPlayerRaceCheckpoint ( playerid, 1, b_info [ idx ] [ b_position ] [ 0 ], b_info [ idx ] [ b_position ] [ 1 ], b_info [ idx ] [ b_position ] [ 2 ], 0.0, 0.0, 0.0, 4.0 ) ;
