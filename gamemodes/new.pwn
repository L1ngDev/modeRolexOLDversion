			cache_get_field_content ( i, "e_name", _candidate_name, sql_connection, 20 ) ;
			_candidate_votes = cache_get_field_content_int ( i, "e_votes", sql_connection ) ;


			format ( line_string, sizeof ( line_string ), "{"#cWH"}%d. %s {"#cGRDialog"}(%d голосов)\n", i + 1, _candidate_name, _candidate_votes ) ;
			strcat ( dialog_string, line_string ) ;

		}
		show_dialog ( playerid, d_election_msgbox, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Список кандидатов", dialog_string, "Назад", "Закрыть" ) ;
	}
	else return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Ещё не было подано ни одной кандидатуры.") ;
	return 1 ;
}

