/*
    LIT / STAGE MOBILE — ИНФОРМАЦИЯ О МОДЕ

    Разработчики и поддержка мода:
    - Traw-gg (Slaughter)
    - LingDev — Telegram: @LingDev(аккаунт не активен, сессии снеслись) / @logountw - новый активный аккаунт лингдева.

    Эта ветка мода разрабатывалась и адаптировалась для проектов:
    - Vine Russia
    - Rolex Mobile
    - Light Mobile
    - Lit Mobile
    - Stage Mobile

    ОСНОВНЫЕ особенности этой ветки относительно базового «МОД КРАЙМ»:
    - тесная связка игрового мода с собственным Android-клиентом и лаунчеро;
    - собственные RakNet/RPC-пакеты для интерфейсов, транспорта, тегов и игровых систем;
    - лаунчерные аккаунты, выбор серверов и несколько персонажей на одном аккаунте;
    - переработанные мобильные интерфейсы: инвентарь, донат, семьи, транспорт,
      выбор персонажа, информация о блокировке, админ-логи и другие игровые меню;
    - персональные теги игроков и отдельная синхронизация названия семьи над персонажем;
    - расширенная система личного транспорта: меню /cars, ПТС, кастомный handling,
      загрузка транспорта и сохранение дополнительного тюнинга;
    - дополнительные административные, основательские и лаунчерные проверки; (автологин для админки)
    - поддержка разных вариантов сборки мода, включая CRMP и Stage;
    - исправления синхронизации, сохранения данных и совместимости с мобильным клиентом.

    Stage использует игровую механику CRMP, но имеет отдельные названия и брендинг. МОД БУДЕТ АДЕКВАТНО РАБОТАТЬ ТОЛЬКО НА СООТВЕТСТВУЮЩЕМ СУРСЕ, если сурс любой другой - придется
	переписать дохуя чего, и не факт что будет работать.
	
	
	начало работы с модом для Stage - 10.08.2026 04:51.
*/

/*

	https://sanstv.ru/color#f4f4f4
	https://i-leon.ru/tools/time

	SELECT
		u.u_id, u.u_name, u.u_gender, u.u_level, u.u_exp, u.u_skin, u.u_money, u.u_vip, u.u_family, u.u_member, u.u_tax, u.u_maxhouse, u.u_maxbiz,
		IFNULL(SUM(db.db_money), 0) AS money_count,
		COUNT(h.h_id) AS houses_count,
		COUNT(b.b_id) AS business_count,
		(SELECT u_b_date FROM users_bans WHERE u_b_name = '$userName' and u_b_date > NOW() LIMIT 1) AS ban_date
	FROM users u
	LEFT JOIN deposit_boxes db ON u.u_id = db.db_owner
	LEFT JOIN houses h ON u.u_id = h.h_owner
	LEFT JOIN businesses b ON u.u_id = b.b_owner_inc
	WHERE u.u_launcher = '$launcherId'
	GROUP BY u.u_id
	LIMIT 3;

	SELECT
		u.u_id, u.u_name, u.u_gender, u.u_level, u.u_exp, u.u_skin, u.u_money, u.u_vip, u.u_family, u.u_member, u.u_tax, u.u_maxhouse, u.u_maxbiz,
		IFNULL(SUM(db.db_money), 0) AS money_count,
		(SELECT COUNT(h_id) FROM houses WHERE h_owner = u.u_id) AS houses_count,
		(SELECT COUNT(b_id) FROM businesses WHERE b_owner_inc = u.u_id) AS business_count
	FROM users u
	LEFT JOIN deposit_boxes db ON u.u_id = db.db_owner
	WHERE u.u_launcher = '$launcherId'
	GROUP BY u.u_id
	LIMIT 3;

	SELECT
		u.u_id, u.u_name, u.u_gender, u.u_level, u.u_exp, u.u_skin, u.u_money, u.u_vip, u.u_family, u.u_member, u.u_tax, u.u_maxhouse, u.u_maxbiz,
		IFNULL((SELECT SUM(db_money) FROM deposit_boxes WHERE db_owner = u.u_id LIMIT 10), 0) AS money_count,
		(SELECT COUNT(h_id) FROM houses WHERE h_owner = u.u_id) AS houses_count,
		(SELECT COUNT(b_id) FROM businesses WHERE b_owner_inc = u.u_id) AS business_count
	FROM users u
	WHERE u.u_launcher = '$launcherId'
	LIMIT 3;

*/

