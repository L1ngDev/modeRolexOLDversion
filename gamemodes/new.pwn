					show_dialog ( playerid, d_cellar_seed, DIALOG_STYLE_INPUT, "{"#cBHD"}Посадка семян", "{"#cWH"}Введите количество семян, которое желаете посадить:", "Принять", "Назад" ) ;
				}
				case 2:
				{
					new h = GetPVarInt ( playerid, "house_id" ) - 1 ;
					if ( h_info [ h ] [ h_seed_result ] <= 0 )
					{
						new d_string [ 172 ] ;
						format ( d_string, sizeof ( d_string ), "{"#cBL"}Посажено семян: {"#cGRDialog"}%d гр.{"#cBL"} | Урожай: {"#cGRDialog"}%d гр.\n{"#cGRDialog"}- {"#cWH"}Посадить семена\n{"#cGRDialog"}- {"#cWH"}Переработка урожая",
						h_info [ h ] [ h_seed ], h_info [ h ] [ h_seed_result ] ) ;
						show_dialog ( playerid, d_cellar_menu_drugs, DIALOG_STYLE_LIST, "{"#cBHD"}Подвал", d_string, "Выбрать", "Закрыть" ) ;
						return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Для начала нужно вырастить урожай." ) ;
					}
					#if defined m_action
					    if ( player_device { playerid } == 2 )
					    {
							action_type { playerid } = ACTION_CELLAR ;
					        actionShow ( playerid, "Посадка семян", 100 ) ;
					        return 1 ;
					    }
					#endif

					action_type { playerid } = ACTION_CELLAR ;
					action_step { playerid } = 0 ;
					action_td_status ( playerid, true ) ;
				}
			}
			return 1 ;
		}
		case d_cellar_seed:
		{
			new h = GetPVarInt ( playerid, "house_id" ) - 1 ;
			if ( ! response )
			{
				new d_string [ 172 ] ;
				format ( d_string, sizeof ( d_string ), "{"#cBL"}Посажено семян: {"#cGRDialog"}%d гр.{"#cBL"} | Урожай: {"#cGRDialog"}%d гр.\n{"#cGRDialog"}- {"#cWH"}Посадить семена\n{"#cGRDialog"}- {"#cWH"}Переработка урожая",
				h_info [ h ] [ h_seed ], h_info [ h ] [ h_seed_result ] ) ;
				show_dialog ( playerid, d_cellar_menu_drugs, DIALOG_STYLE_LIST, "{"#cBHD"}Подвал", d_string, "Выбрать", "Закрыть" ) ;
