	if ( params [ 2 ] < 0 || params [ 2 ] > 255 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /plveh [ид] [ид авто] [цвет 1] [цвет 2]" ) ;
	if ( params [ 3 ] < 0 || params [ 3 ] > 255 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /plveh [ид] [ид авто] [цвет 1] [цвет 2]" ) ;
	new Float:player_pos [ 4 ] ;
	GetPlayerPos ( params [ 0 ], player_pos [ 0 ], player_pos [ 1 ], player_pos [ 2 ] ) ;
	GetPlayerFacingAngle ( params [ 0 ], player_pos [ 3 ] ) ;
	if ( params [ 0 ] == 537 || params [ 0 ] == 538 ) p_t_info [ params [ 0 ] ] [ pl_veh ] = AddStaticVehicleEx ( params [ 1 ], player_pos [ 0 ], player_pos [ 1 ], player_pos [ 2 ], player_pos [ 3 ], params [ 2 ], params [ 3 ], -1) ;
	else p_t_info [ params [ 0 ] ] [ pl_veh ] = CreateVehicle ( params [ 1 ], player_pos [ 0 ], player_pos [ 1 ], player_pos [ 2 ], player_pos [ 3 ], params [ 2 ], params [ 3 ], -1) ;

	new veh_id = p_t_info [ params [ 0 ] ] [ pl_veh ] ;

