            airdrop_object [ 2 ] = CreateDynamicObject ( 18728, air_info [ i ] [ move_position ] [ 0 ], air_info [ i ] [ move_position ] [ 1 ], air_info [ i ] [ move_position ] [ 2 ] - AIR_LIGHT, air_info [ i ] [ move_position ] [ 3 ], air_info [ i ] [ move_position ] [ 4 ], air_info [ i ] [ move_position ] [ 5 ] ) ;

			format ( fm_string, sizeof fm_string, "* В район %s была сброшена посылка, отправляйтесь туда!", air_info [ i ] [ lName ] ) ;
