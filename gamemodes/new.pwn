			else _b_id = p_info [ playerid ] [ business ] ;

            new _b_type = b_info [ _b_id - 1 ] [ b_type ] ;
			if ( listitem == 0 )
			{
                if ( p_info [ playerid ] [ b_worker ] != -1 )
                {
                    SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вам недоступен данный раздел, потому что Вы менеджер." ) ;
                    show_bpanel ( playerid ) ;
