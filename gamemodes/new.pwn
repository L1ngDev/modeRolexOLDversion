				return 1 ;
			}
			if ( bank_info [ playerid ] [ bi_money ] [ deposit_id ] < plprice )
			{
                new d_string [ 148 ] ;
				format ( d_string, sizeof ( d_string ), "{"#cRD"}* У Вас недостаточно средств для платежа.\n\n{"#cGRDialog"}Ваша задолженность по кредиту составляет {"#cBL"}%s"valute_title_"\n\n{"#cWH"}Введите сумму, которую желаете внести в счёт уплаты кредита:",
				GetPlayerCashValueToSmile ( bank_info [ playerid ] [ bi_credit ] [ deposit_id ] ) ) ;
				show_dialog ( playerid, d_bank_pay_credit, DIALOG_STYLE_INPUT, "{"#cBHD"}Оплата кредита", d_string, "Принять", "Назад" ) ;
				return 1 ;
			}
			if ( bank_info [ playerid ] [ bi_credit ] [ deposit_id ] < plprice )
			{
                new d_string [ 148 ] ;
				format ( d_string, sizeof ( d_string ), "{"#cRD"}* Вносимая сумма превышает сумму долга.\n\n{"#cGRDialog"}Ваша задолженность по кредиту составляет {"#cBL"}%s"valute_title_"\n\n{"#cWH"}Введите сумму, которую желаете внести в счёт уплаты кредита:",
				GetPlayerCashValueToSmile ( bank_info [ playerid ] [ bi_credit ] [ deposit_id ] ) ) ;
				show_dialog ( playerid, d_bank_pay_credit, DIALOG_STYLE_INPUT, "{"#cBHD"}Оплата кредита", d_string, "Принять", "Назад" ) ;
				return 1 ;
			}
			bank_info [ playerid ] [ bi_credit ] [ deposit_id ] -= plprice ;
            bank_info [ playerid ] [ bi_money ] [ deposit_id ] -= plprice ;

            new pl_id, _b_id = bank_info [ playerid ] [ bi_creditor ] [ deposit_id ] ;
			sscanf ( b_info [ _b_id - 1 ] [ b_owner_name ], "u", pl_id ) ;

            new scm_string [ 220 ] ;
            if ( IsPlayerConnected ( pl_id ) )
            {
                format ( scm_string, 144, "{"#cGInfo"}* {"#cWH"}%s оплатил(а) кредит на {"#cGN"}%d"valute_title"{"#cWH"}. Осталось погасить ещё {"#cGN"}%d"valute_title"{"#cWH"}.",
				p_info [ playerid ] [ name ], plprice, bank_info [ playerid ] [ bi_credit ] [ deposit_id ] ) ;
				SendClientMessage ( pl_id, col_white, scm_string ) ;
