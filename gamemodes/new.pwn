CMD:givegun ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] > 0 && admin_info [ playerid ] [ admin ] < 8 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы администратор." ) ;
	if ( sscanf ( params, "u", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /givegun [id/имя]") ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете применить это к самому себе." ) ;
	if ( p_info [ playerid ] [ hour_played ] < FIVE_HOUR_PLAYED ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Доступно с 3 часов в игре. Используйте /mm - Информация о персонаже - Статистика персонажа." ) ;
	if ( p_info [ params [ 0 ] ] [ hour_played ] < FIVE_HOUR_PLAYED ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не отыграл 3 часа." ) ;
	if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;

	new slot = get_weapon_slot ( GetPlayerWeapon ( playerid ) ) ;
	new weaponid = p_t_info [ playerid ] [ p_gun_slot ] [ slot ] ;
	new ammo = p_t_info [ playerid ] [ p_gun_ammo ] [ slot ] ;

	if ( ! weaponid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Возьмите в руку то оружие, которое хотите передать." ) ;
	if ( weaponid > 25 && weaponid < 29 || weaponid == 32 || weaponid == 9 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Выбранное оружие нельзя передавать." ) ;

    RemoveWeaponFromSlot ( playerid, get_weapon_slot ( weaponid ) ) ;
	give_weapon ( params [ 0 ], weaponid, ammo ) ;

	new scm_string [ 24 + MAX_PLAYER_NAME ] ;
	format ( scm_string, sizeof ( scm_string ), "передал(-а) оружие %s", p_info [ params [ 0 ] ] [ name ] ) ;
	me_action ( playerid, scm_string ) ;
	return 1 ;
}

CMD:sellgun ( playerid, params [ ] )
{
	if ( TeamPaint [ playerid ] != 0 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Невозможно во время участия в paintball." ) ;
	if ( ! gang_player ( playerid ) && ! mafia_player ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команда доступна только для криминальных организаций." ) ;
	if ( duel_opponent [ playerid ] != INVALID_PLAYER_ID ) return 1 ;
    if ( p_info [ playerid ] [ hour_played ] < THREE_HOUR_PLAYED ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Доступно с 3 часов в игре. Используйте /mm - Информация о персонаже - Статистика персонажа." ) ;
	if ( sscanf ( params, "udd", params [ 0 ], params [ 1 ], params [ 2 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /sellgun [id/имя] [патроны] [цена]") ;
	if ( params [ 1 ] < 1 || params [ 1 ] > 100000 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Количество патрон не может быть менее {"#cRD"}1{"#cGRInfo"}." ) ;
	if ( params [ 2 ] < 1 || params [ 2 ] > 10000 || params [ 2 ] == INVALID_PRICE ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Цена должна быть от {"#cRD"}1"valute_title_"{"#cGRInfo"} до {"#cRD"}10.000"valute_title"{"#cGRInfo"}." ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете применить это к самому себе." ) ;
	if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;
	if ( ! bad_dialog ( params [ 0 ] ) || ! bad_dialog ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Недоступно в данный момент.") ;
	if ( p_info [ params [ 0 ] ] [ hour_played ] < FIVE_HOUR_PLAYED ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не отыграл 5 часов." ) ;
	if ( cooldown_sentence [ playerid ] > gettime ( ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Предложение о сделке можно отправлять один раз в {"#cRD"}45 секунд{"#cGRInfo"}." ) ;

	if ( GetString ( p_t_info [ params [ 0 ] ] [ p_ip ], p_t_info [ playerid ] [ p_ip ] ) )
	{
		new scm_string [ 128 ] ;
		format ( scm_string, sizeof ( scm_string ), "{"#cBAdmin"}[A] {"#cGRAdmin"}%s[%d] продает оружие %s[%d] | same ip", p_info [ playerid ] [ name ], playerid, p_info [ params [ 0 ] ] [ name ], params [ 0 ] ) ;
		foreach(new i: admin_players)SendClientMessage ( i, col_admin, scm_string ) ;

		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Невозможно продать оружие данному игроку." ) ;
		return 1 ;
	}

	new gun_name [ 24 ], gun_id = GetPlayerWeapon ( playerid );
	if ( ! gun_id ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Возьмите в руку то оружие, которое хотите передать." ) ;
	GetWeaponName( gun_id, gun_name, sizeof ( gun_name ) ) ;
	new weapon, ammo ;
    GetPlayerWeaponData ( playerid, get_weapon_slot( gun_id ), weapon, ammo);
    if ( ammo < params [ 1 ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет такого количества патронов." ) ;

    cooldown_sentence [ playerid ] = gettime ( ) + time_sell_sentence ;

	buyer_id [ playerid ] = params [ 0 ] ;
	sell_price [ playerid ] = params [ 2 ] ;
	sell_item [ playerid ] = params [ 1 ] ;
	seller_id [ params [ 0 ] ] = playerid ;

	sell_time { playerid } =
	sell_time { params [ 0 ] } = time_sell_null ;

	SetPVarInt ( playerid, "sell_gunid", gun_id ) ;

	new dialog_string [ 146 ] ;
	format ( dialog_string, 144, "Вы предложили {"#cGN"}%s{FFFFFF} приобрести {"#cGN"}%d {FFFFFF}патронов {"#cGN"}%s{FFFFFF} за {"#cGN"}%d"valute_title_"",
	p_info [ params [ 0 ] ] [ name ], params [ 1 ], gun_name, params [ 2 ] ) ;
	SendClientMessage ( playerid, col_white, dialog_string ) ;

	format ( dialog_string, sizeof ( dialog_string  ), "{"#cBL"}%s {FFFFFF}предлагает Вам приобрести {"#cWV"}%d {FFFFFF}патронов {"#cOR"}%s{FFFFFF} за {"#cGN"}%d"valute_title_"",
	p_info [ playerid ] [ name ], params [ 1 ], gun_name, params [ 2 ] ) ;
	show_dialog ( params [ 0 ], d_gun_sell_accept, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Покупка оружия", dialog_string, "Купить", "Отмена" ) ;
	return true ;
}

