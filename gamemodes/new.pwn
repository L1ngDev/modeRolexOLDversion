	        {
		    	global_string [ 0 ] = EOS ;
				format(global_string, 450, "{"#cWH"}Вы собираетесь изменить следующую конфигурацию:\n\n\tОрганизация: {%s}%s\n\t{"#cWH"}Название: {"#cLY"}Одежда команды №1\n\t{"#cWH"}Текущее значение: {"#cLY"}%d\n\n{"#cGRDialog"}* Введите новое значение для данной конфигурации:", f_info [ f ] [ f_chat_color ], f_info [ f ] [ f_name ], f_info [ f ] [ f_tr_skin ] [ 0 ] );
