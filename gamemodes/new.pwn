callback: create_vehicle_callback ( veh_id )
{
	veh_info [ veh_id - 1 ] [ v_id ] = cache_insert_id ( ) ;
	return 1 ;
}

callback: create_vehicle_buycar ( playerid )
{
	new insertId = cache_insert_id ( ) ;

	global_string [ 0 ] = EOS ;
    format ( global_string, 128, "INSERT INTO `users_vehicles_tuning` (v_tuning_sql_id,v_body_painting_color) VALUES ('%d','%d|%d|%d')",
	insertId, GetPlayerAutoSalonData ( playerid, PAS_SELECTED_COLOR_R ), GetPlayerAutoSalonData ( playerid, PAS_SELECTED_COLOR_G ), GetPlayerAutoSalonData ( playerid, PAS_SELECTED_COLOR_B ) ) ;
    mysql_tquery ( sql_connection, global_string ) ;

	exit_carbuy ( playerid ) ;

	if ( ! users_education [ playerid ] [ EDUCATION_CAR_BUY ] )
	{
		show_window_monologue (
			playerid,
			5,
			"Поздравляю с покупкой! \
			Каждый транспорт облагается налогом, который начисляется раз в час в хх:00. \
			Не забывай оплачивать налоги, потому что Мэрия может изъять у тебя деньги или транспорт! \
			Для управление транспортом используй /cars, а для того, чтоб его припарковать /vpark. \
			Удачи на дорогах!",
			"Местный",
			"Понял"
		) ;

		save_user_education ( playerid, EDUCATION_CAR_BUY ) ;
	}

	global_string [ 0 ] = EOS ;
	format ( global_string, 256, "SELECT uv.*, lp.* \
								FROM users_vehicles uv \
								LEFT JOIN licence_plate lp \
								ON lp.licence_plate_use_own_car_id = uv.v_id \
								WHERE `v_id` = '%d' LIMIT 1", insertId ) ;
	mysql_tquery ( sql_connection, global_string, "load_player_vehicles", "iii", playerid, false, -1 ) ;
	return 1 ;
}

callback: shop_sim_callback ( playerid, pl_number )
{
	new fields, rows ;
	cache_get_data ( rows, fields ) ;
	if ( rows ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Этот номер занят другим игроком." ), ShowShopDialog ( playerid, 1 ) ;

	new USERS_INVENTORY_STRUCT: inventoryStruct [ _:INV_STRUCTURE_MAX ] ;
	inventoryStruct [ _:INV_ITEM ] = ITEM_SIM_CARD ;
	inventoryStruct [ _:INV_ITEM_COUNT ] = 1 ;
	inventoryStruct [ _:INV_ITEM_TYPE ] = INVENTORY_TYPE_SIMCARD ;
	inventoryStruct [ _:INV_ITEM_PLATE_TYPE ] = NUMBERPLATE_TYPE_NONE ;
	inventoryStruct [ _:INV_ITEM_GIVE_DATE ] = pl_number ;
	inventoryStruct [ _:INV_ITEM_ID ] = 0 ;
	inventoryStruct [ _:INV_ITEM_DATE ] = -1 ;
	new _return = giveInventory ( playerid, inventoryStruct ) ;
	if ( _return == -1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}В инвентаре недостаточно места." ) ;

	global_string [ 0 ] = EOS ;
	format ( global_string, 600, "\
		{"#cWH"}Вы успешно изменили свой номер телефона на: {"#cYW"}%d{"#cWH"}.\n\
		Для использования новой сим-карты в мобильном смартфоне необходимо\n\
		выбрать новый номер в инвентаре и переместить в блок {"#cTN"}аксессуаров{"#cWH"}.\n\n\
		Номер, который используется в телефоне сейчас - будет находиться\n\
		в {"#cTN"}инвентаре {"#cWH"}в блоке {"#cTN"}аксессуаров{"#cWH"}.\n\n\
		{"#cWH"}Используйте {"#cTN"}/sms {"#cWH"}для отправки сообщений.\n\
		{"#cWH"}Используйте {"#cTN"}/call {"#cWH"}для звонка.\n\
		{"#cWH"}Используйте {"#cTN"}/number {"#cWH"}для того, чтоб узнать номер игрока.", pl_number ) ;
	show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Изменение номера", global_string, "Принять", "" ) ;

	new b = GetPVarInt ( playerid, "p_biz_id" ) - 1 ;

	new price = b_price_market [ b ] [ 1 ] ;
	if ( mafia_player ( playerid ) )
	{
		if ( b_info [ b ] [ b_mafia ] == p_info [ playerid ] [ member ] )
		{
		    price = floatround ( ( b_price_market [ b ] [ 1 ] * 50 ) / 100 ) ;
		}
	}

	give_bmoney ( b + 1, price, b_shop_product [ 1 ] ) ;

	if ( player_device { playerid } == 2 ) { }
	else ShowShopDialog ( playerid, 1 ) ;

	give_money ( playerid, -price ) ;
	insert_money_log ( playerid, INVALID_PLAYER_ID, -price, "Закуп 24/7" ) ;
	return 1 ;
}

callback: atm_loading ( )
{
	new fields, time = GetTickCount ( ) ;
	cache_get_data ( atm_count, fields ) ;
	if ( atm_count )
	{
        for ( new t = 0 ; t < atm_count ; t ++ )
        {
			atm_info [ t ] [ atm_id ] = cache_get_field_content_int ( t, "atm_id", sql_connection ) ;
			atm_info [ t ] [ atm_status ] = cache_get_field_content_int ( t, "atm_status", sql_connection ) ;

			atm_info [ t ] [ atm_gps ] [ 0 ] = cache_get_field_content_float ( t, "atm_gps_x", sql_connection ) ;
			atm_info [ t ] [ atm_gps ] [ 1 ] = cache_get_field_content_float ( t, "atm_gps_y", sql_connection ) ;
			atm_info [ t ] [ atm_gps ] [ 2 ] = cache_get_field_content_float ( t, "atm_gps_z", sql_connection ) ;

			atm_info [ t ] [ atm_position ] [ 0 ] = cache_get_field_content_float ( t, "atm_pos_x", sql_connection ) ;
			atm_info [ t ] [ atm_position ] [ 1 ] = cache_get_field_content_float ( t, "atm_pos_y", sql_connection ) ;
			atm_info [ t ] [ atm_position ] [ 2 ] = cache_get_field_content_float ( t, "atm_pos_z", sql_connection ) ;
			atm_info [ t ] [ atm_position ] [ 3 ] = cache_get_field_content_float ( t, "atm_pos_xr", sql_connection ) ;
			atm_info [ t ] [ atm_position ] [ 4 ] = cache_get_field_content_float ( t, "atm_pos_yr", sql_connection ) ;
			atm_info [ t ] [ atm_position ] [ 5 ] = cache_get_field_content_float ( t, "atm_pos_zr", sql_connection ) ;

			new bool: _bankomat = false, _b_id ;
			for ( new i = 0 ; i < b_count ; i ++ )
			{
			    if ( b_info [ i ] [ b_car_marker ] != atm_info [ t ] [ atm_status ] ) continue ;

			    _bankomat = true ;
			    _b_id = i ;
			    break ;
			}
			if ( _bankomat == true )
			{
			    atm_info [ t ] [ atm_status ] = b_info [ _b_id ] [ b_id ] ;
			}
			else
			    printf ( "[SERVER] В atm маркер банкомата не совпадает с маркером бизнеса. (Маркер банкомата: %d)", atm_info [ t ] [ atm_status ] ) ;

			atm_info [ t ] [ atm_area ] = CreateDynamicSphere ( atm_info [ t ] [ atm_position ] [ 0 ], atm_info [ t ] [ atm_position ] [ 1 ], atm_info [ t ] [ atm_position ] [ 2 ], 3.0, 0, 0, -1 ) ;
	    	area_info [ atm_info [ t ] [ atm_area ] ] [ a_type ] = area_type_atm ;
	    	area_info [ atm_info [ t ] [ atm_area ] ] [ a_item ] = atm_info [ t ] [ atm_id ] ;

	    	if ( random ( 3 ) == 1 ) atm_info [ t ] [ atm_incass ] = 2 ;
			else atm_info [ t ] [ atm_incass ] = 1 ;

            atm_info [ t ] [ atm_text ] = CreateDynamic3DTextLabel ( "** Банкомат **\n{"#cGR3D"}Подойдите для взаимодействия", col_header_3d, atm_info [ t ] [ atm_position ] [ 0 ], atm_info [ t ] [ atm_position ] [ 1 ], atm_info [ t ] [ atm_position ] [ 2 ] + 0.5, 4.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0 ) ;

			#if defined CRMP
			atm_info [ t ] [ atm_object ] = CreateDynamicObject ( object_atm_tinkoff, atm_info [ t ] [ atm_position ] [ 0 ], atm_info [ t ] [ atm_position ] [ 1 ], atm_info [ t ] [ atm_position ] [ 2 ], atm_info [ t ] [ atm_position ] [ 3 ], atm_info [ t ] [ atm_position ] [ 4 ], atm_info [ t ] [ atm_position ] [ 5 ], 0, 0, -1, 300.0, 300.0 ) ;
			#endif

			#if defined Matreshka
   			atm_info [ t ] [ atm_object ] = CreateDynamicObject ( object_atm_tinkoff, atm_info [ t ] [ atm_position ] [ 0 ], atm_info [ t ] [ atm_position ] [ 1 ], atm_info [ t ] [ atm_position ] [ 2 ], atm_info [ t ] [ atm_position ] [ 3 ], atm_info [ t ] [ atm_position ] [ 4 ], atm_info [ t ] [ atm_position ] [ 5 ], 0, 0, -1, 300.0, 300.0 ) ;
			#endif

			#if defined SAMP
			atm_info [ t ] [ atm_object ] = CreateDynamicObject ( object_atm, atm_info [ t ] [ atm_position ] [ 0 ], atm_info [ t ] [ atm_position ] [ 1 ], atm_info [ t ] [ atm_position ] [ 2 ], atm_info [ t ] [ atm_position ] [ 3 ], atm_info [ t ] [ atm_position ] [ 4 ], atm_info [ t ] [ atm_position ] [ 5 ], 0, 0, -1, 300.0, 300.0 ) ;
			SetDynamicObjectMaterialText ( atm_info [ t ] [ atm_object ], 2, "\nБанкомат\n \n \n \n \n ", OBJECT_MATERIAL_SIZE_256x256, "Tahoma", 48, 1, 0xFF000000, 0xFF87CEEB, OBJECT_MATERIAL_TEXT_ALIGN_CENTER ) ;
			SetDynamicObjectMaterial ( atm_info [ t ] [ atm_object ], 0, -1, "none", "none", 0xFFF0FFFF ) ;
			#endif
		}
    }
	printf ( "[SERVER] Загружено %d банкоматов. (%d ms)", atm_count, GetTickCount ( ) - time ) ;
	return 1 ;
}

CMD:createatm ( playerid )
{
    if ( admin_info [ playerid ] [ admin ] < 8 ) return 0 ;
    if ( ! IsFounder ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}К сожалению, Вам данная функция не доступна." ) ;
    if ( create_type { playerid } ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы уже устанавливаете банкомат." ) ;
    if ( atm_count >= MAX_ATM ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}На сервере установлено максимальное количество банкоматов." ) ;

	SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Чтобы выйти, нажмите: ESC и чтобы сохранить, нажмите курсором: СОХРАНИТЬ." ) ;

	new _atm_object = CreateDynamicObject ( object_atm, p_t_info [ playerid ] [ p_pos ] [ 0 ], p_t_info [ playerid ] [ p_pos ] [ 1 ], p_t_info [ playerid ] [ p_pos ] [ 2 ], 0.0, 0.0, 0.0, 0, 0, -1, 300.0, 300.0 ) ;
	//SetDynamicObjectMaterialText ( _atm_object, 2, "\nБанкомат\n \n \n \n \n ", OBJECT_MATERIAL_SIZE_256x256, "Tahoma", 48, 1, 0xFF000000, 0xFF87CEEB, OBJECT_MATERIAL_TEXT_ALIGN_CENTER ) ;
	//SetDynamicObjectMaterial ( _atm_object, 0, -1, "none", "none", 0xFFF0FFFF);

    create_type { playerid } = 2 ;
    create_object_id [ playerid ] = _atm_object ;
	EditDynamicObject ( playerid, _atm_object ) ;
	return 1 ;
}

CMD:createstation ( playerid )
{
    if(admin_info [ playerid ] [ admin ] < 8 ) return 0 ;
    if ( ! IsFounder ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}К сожалению, Вам данная функция не доступна." ) ;
    if ( create_type { playerid } ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы уже устанавливаете остановку." ) ;
    if ( bus_station_count >= BUS_STATION ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}На сервере установлено максимальное количество остановок." ) ;

	SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Чтобы выйти, нажмите: ESC и чтобы сохранить, нажмите курсором: СОХРАНИТЬ." ) ;

	new station_object = CreateDynamicObject ( object_bus_station, p_t_info [ playerid ] [ p_pos ] [ 0 ], p_t_info [ playerid ] [ p_pos ] [ 1 ] + 1.5, p_t_info [ playerid ] [ p_pos ] [ 2 ], 0.0, 0.0, 0.0, 0, 0, -1, 300.0, 300.0 ) ;

    create_type { playerid } = 3 ;
    create_object_id [ playerid ] = station_object ;
	EditDynamicObject ( playerid, station_object ) ;
	return 1 ;
}

CMD:createradar ( playerid )
{
    if(admin_info [ playerid ] [ admin ] < 8 ) return 0 ;
    if ( ! IsFounder ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}К сожалению, Вам данная функция не доступна." ) ;
    show_dialog(playerid, d_radar, DIALOG_STYLE_LIST, "{"#cBHD"}Создание радара","\
			{"#cBL"}1. {"#cWH"}Дворовая территория {"#cGRDialog"}(Макс. доп. скорость: 20км/ч)\n\
			{"#cBL"}2. {"#cWH"}Населенные пункты {"#cGRDialog"}(Макс. доп. скорость: 60км/ч)\n\
			{"#cBL"}3. {"#cWH"}Автомагистрали {"#cGRDialog"}(Макс. доп. скорость: 110км/ч)\n\
			{"#cBL"}4. {"#cWH"}Вне населенных пунктов (ост. дороги) {"#cGRDialog"}(Макс. доп. скорость: 90км/ч)",
		"Выбрать","Отмена");
	return 1 ;
}

public OnPlayerEditAttachedObject ( playerid, response, index, modelid, boneid, Float: fOffsetX, Float: fOffsetY, Float: fOffsetZ, Float: fRotX, Float: fRotY, Float: fRotZ, Float: fScaleX, Float: fScaleY, Float: fScaleZ )
{
    if ( response == EDIT_RESPONSE_FINAL )
	{
	    if ( edit_acc [ playerid ] == true && editor_acc [ playerid ] == false )
	    {
		    new idx = get_player_use_listitem ( playerid ) ;
			GetUserAccessories ( playerid, ACS_OBJ_X, idx ) = fOffsetX ;
			GetUserAccessories ( playerid, ACS_OBJ_Y, idx ) = fOffsetY ;
			GetUserAccessories ( playerid, ACS_OBJ_Z, idx ) = fOffsetZ ;

			GetUserAccessories ( playerid, ACS_ROT_X, idx ) = fRotX ;
			GetUserAccessories ( playerid, ACS_ROT_Y, idx ) = fRotY ;
			GetUserAccessories ( playerid, ACS_ROT_Z, idx ) = fRotZ ;

			save_accesories ( playerid, idx ) ;

			SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Вы изменили положение аксессуара на своем персонаже." ) ;

			edit_acc [ playerid ] = false ;
		}
		else
		{
			global_string [ 0 ] = EOS ;
		    format ( global_string, sizeof global_string, "[SAVED ATTACH PLAYER] %d, %d, %.4f, %.4f, %.4f, %.4f, %.4f, %.4f, %.4f, %.4f, %.4f", modelid, boneid,

			fOffsetX,
			fOffsetY,
			fOffsetZ,

			fRotX,
			fRotY,
			fRotZ,

			fScaleX,
			fScaleY,
			fScaleZ ) ;

			printf ( global_string ) ;

	 		RemovePlayerAttachedObject ( playerid, index ) ;

			SendClientMessage ( playerid, col_white, "Attached settings saved!" ) ;
			editor_acc [ playerid ] = false ;
		}
	}
	else
	{
		if ( editor_acc [ playerid ] ) RemovePlayerAttachedObject ( playerid, index ) ;

		edit_acc [ playerid ] =
		editor_acc [ playerid ] = false ;
	}
	return 1 ;
}

public OnPlayerEditDynamicObject ( playerid, objectid, response, Float:x, Float:y, Float:z, Float:rx, Float:ry, Float:rz )
{
	if ( ! objectid )
	{
		if ( ! IsValidDynamicObject ( objectid ) ) return 1 ;
		MoveDynamicObject ( objectid, x, y, z, 10.0, rx, ry, rz ) ;
	}

	#if defined m_treasure
		tr_OnPlayerEditDynamicObject ( playerid, response, x, y, z ) ;
	#endif

	if ( response == EDIT_RESPONSE_FINAL )
	{
	    new Vehicle_ID = GetPlayerVehicleID ( playerid ) ;
		if ( IsPlayerInAnyVehicle ( playerid ) && veh_info [ Vehicle_ID - 1 ] [ v_taxi_object ] == objectid )
		{
		    new Float:Object_Pos[3], Float:Object_Rot[3];
		    GetDynamicObjectPos(objectid, Object_Pos[0], Object_Pos[1], Object_Pos[2]);
		    GetDynamicObjectRot(objectid, Object_Rot[0], Object_Rot[1], Object_Rot[2]);
		    if(floatabs(Object_Pos[2]-z) > 0.5 || floatcmp(Object_Rot[0], rx) != 0
			|| floatcmp(Object_Rot[1], ry) != 0 || floatcmp(Object_Rot[2], rz) != 0
			|| floatabs(Object_Pos[0]-x) > 5.0 || floatabs(Object_Pos[1]-y) > 5.0)
			{
				if(floatabs(Object_Pos[2]-z) > 0.5) SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нельзя так изменять высоту объекта." ) ;
				if(floatcmp(Object_Rot[0], rx) != 0 || floatcmp(Object_Rot[1], ry) != 0) SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нельзя поворачивать объект." ) ;
				if(floatabs(Object_Pos[0]-x) > 5.0 || floatabs(Object_Pos[1]-y) > 5.0) SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нельзя так перемещать объект." ) ;
				SetDynamicObjectPos(objectid, Object_Pos[0], Object_Pos[1], Object_Pos[2]);
				SetDynamicObjectRot(objectid, Object_Rot[0], Object_Rot[1], Object_Rot[2]);
				EditDynamicObject(playerid, objectid);
			}
			else
			{
			    new Float:Vehicle_Pos[4];
			    GetVehiclePos(Vehicle_ID, Vehicle_Pos[0], Vehicle_Pos[1], Vehicle_Pos[2]);
			    GetVehicleZAngle(Vehicle_ID, Vehicle_Pos[3]);
				AttachDynamicObjectToVehicle(objectid, Vehicle_ID, 0.0, -floatabs(Vehicle_Pos[1]-y), z-Vehicle_Pos[2], 0.0, 0.0, rz-Vehicle_Pos[3]);
				TogglePlayerControllable(playerid, 1);
			}
			return 1 ;
		}

	    if ( create_type { playerid } == 1 )
	    {
			switch ( GetPVarInt ( playerid, "TypeRadar" ) )
			{
				case 0: radar_info[radar_count][r_type] = 1, radar_info[radar_count][r_speed] = 20;
				case 1: radar_info[radar_count][r_type] = 2, radar_info[radar_count][r_speed] = 60;
				case 2: radar_info[radar_count][r_type] = 3, radar_info[radar_count][r_speed] = 110;
				case 3: radar_info[radar_count][r_type] = 4, radar_info[radar_count][r_speed] = 90;
			}
			radar_info [ radar_count ] [ r_id ] = radar_count ;

			radar_info [ radar_count ] [ r_x ] = x;
			radar_info [ radar_count ] [ r_y ] = y;
		 	radar_info [ radar_count ] [ r_z ] = z;
		 	radar_info [ radar_count ] [ r_rx ] = rx;
		 	radar_info [ radar_count ] [ r_ry ] = ry;
		 	radar_info [ radar_count ] [ r_rz ] = rz;

			DestroyDynamicObject ( create_object_id [ playerid ] ) ;
			radar_info [ radar_count ] [ r_object ] = CreateDynamicObject(18880, radar_info[radar_count][r_x], radar_info[radar_count][r_y], radar_info[radar_count][r_z], radar_info[radar_count][r_rx], radar_info[radar_count][r_ry], radar_info[radar_count][r_rz], 0, 0, -1, 300.0);

	        global_string [ 0 ] = EOS ;
			format(global_string, 144, "Радар {"#cOR3D"}№%d{"#cWH3D"}\n\nМакс. разрешенная скорость: {"#cBL3D"}%d{"#cWH3D"} км/ч", radar_count + 1, radar_info[radar_count][r_speed]);
			radar_info [ radar_count ] [ r_label ] = CreateDynamic3DTextLabel ( global_string, col_white, radar_info[radar_count][r_x], radar_info[radar_count][r_y], radar_info[radar_count][r_z] + 4.0, 10.0);

			radar_info [ radar_count ] [ r_area ] = CreateDynamicSphere ( radar_info [ radar_count ] [ r_x ], radar_info [ radar_count ] [ r_y ], radar_info [ radar_count ] [ r_z ], 20.0 ) ;
            area_info [ radar_info [ radar_count ] [ r_area ] ] [ a_type ] = area_type_radar ;
			area_info [ radar_info [ radar_count ] [ r_area ] ] [ a_item ] = radar_count ;

			radar_info [ radar_count ] [ r_area_warning ] = CreateDynamicSphere ( radar_info [ radar_count ] [ r_x ], radar_info [ radar_count ] [ r_y ], radar_info [ radar_count ] [ r_z ], 100.0 ) ;
			area_info [ radar_info [ radar_count ] [ r_area_warning ] ] [ a_type ] = area_type_radar_warning ;
			area_info [ radar_info [ radar_count ] [ r_area_warning ] ] [ a_item ] = radar_count ;

			create_type { playerid } = 0 ;
			create_object_id [ playerid ] = INVALID_OBJECT_ID ;
			DeletePVar(playerid, "TypeRadar");
			CancelEdit(playerid);

			format(global_string, 256, "INSERT INTO `radars` (`r_id`, `r_type`, `r_speed`, `r_x`, `r_y`, `r_z`, `r_rx`, `r_ry`, `r_rz`) VALUES (%i, '%s', %i, %i, '%f', '%f', '%f', '%f', '%f', '%f')",
			radar_count, radar_info[radar_count][r_type], radar_info[radar_count][r_speed], radar_info[radar_count][r_x], radar_info[radar_count][r_y], radar_info[radar_count][r_z], radar_info[radar_count][r_rx], radar_info[radar_count][r_ry], radar_info[radar_count][r_rz]);
			mysql_tquery(sql_connection, global_string, "", "");
			SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Радар успешно создан." ) ;

			radar_count ++ ;
		}

		else if ( create_type { playerid } == 2 )
	    {
	        atm_info [ atm_count ] [ atm_id ] = atm_count + 1 ;

			atm_info [ atm_count ] [ atm_position ] [ 0 ] = x ;
			atm_info [ atm_count ] [ atm_position ] [ 1 ] = y ;
			atm_info [ atm_count ] [ atm_position ] [ 2 ] = z ;
			atm_info [ atm_count ] [ atm_position ] [ 3 ] = rx ;
			atm_info [ atm_count ] [ atm_position ] [ 4 ] = ry ;
			atm_info [ atm_count ] [ atm_position ] [ 5 ] = rz ;

            atm_info [ atm_count ] [ atm_text ] = CreateDynamic3DTextLabel ( "** Банкомат **\n{"#cGR3D"}Подойдите для взаимодействия", col_header_3d, atm_info [ atm_count ] [ atm_position ] [ 0 ], atm_info [ atm_count ] [ atm_position ] [ 1 ], atm_info [ atm_count ] [ atm_position ] [ 2 ], 4.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0 ) ;
   			atm_info [ atm_count ] [ atm_object ] = CreateDynamicObject ( object_atm, atm_info [ atm_count ] [ atm_position ] [ 0 ], atm_info [ atm_count ] [ atm_position ] [ 1 ], atm_info [ atm_count ] [ atm_position ] [ 2 ], atm_info [ atm_count ] [ atm_position ] [ 3 ], atm_info [ atm_count ] [ atm_position ] [ 4 ], atm_info [ atm_count ] [ atm_position ] [ 5 ], 0, 0, -1, 300.0, 300.0 ) ;
            //SetDynamicObjectMaterialText ( atm_info [ atm_count ] [ atm_object ], 2, "\nБанкомат\n \n \n \n \n ", OBJECT_MATERIAL_SIZE_256x256, "Tahoma", 48, 1, 0xFF000000, 0xFF87CEEB, OBJECT_MATERIAL_TEXT_ALIGN_CENTER ) ;
			//SetDynamicObjectMaterial ( atm_info [ atm_count ] [ atm_object ], 0, -1, "none", "none", 0xFFF0FFFF ) ;

			DestroyDynamicObject ( create_object_id [ playerid ] ) ;

			create_object_id [ playerid ] = INVALID_OBJECT_ID ;
			create_type { playerid } = 0 ;
			CancelEdit ( playerid ) ;

			atm_info [ atm_count ] [ atm_area ] = CreateDynamicSphere ( atm_info [ atm_count ] [ atm_position ] [ 0 ], atm_info [ atm_count ] [ atm_position ] [ 1 ], atm_info [ atm_count ] [ atm_position ] [ 2 ], 3.0, 0, 0, -1 ) ;
	    	area_info [ atm_info [ atm_count ] [ atm_area ] ] [ a_type ] = area_type_atm ;
	    	area_info [ atm_info [ atm_count ] [ atm_area ] ] [ a_item ] = atm_info [ atm_count ] [ atm_id ] ;

			global_string [ 0 ] = EOS ;
			mysql_format ( sql_connection, global_string, 256, "INSERT INTO `atm` ( `atm_id`, `atm_pos_x`, `atm_pos_y`, `atm_pos_z`, `atm_pos_xr`, `atm_pos_yr`, `atm_pos_zr` ) VALUES ( '%d', '%f', '%f', '%f', '%f', '%f', '%f' )", atm_info [ atm_count ] [ atm_id ], x, y, z, rx, ry, rz ) ;
			mysql_tquery ( sql_connection, global_string) ;

			atm_count ++ ;
		}

		else if ( create_type { playerid } == 3 )
	    {
	        bus_station [ bus_station_count ] [ b_id ] = bus_station_count + 1 ;

			bus_station [ bus_station_count ] [ b_position ] [ 0 ] = x ;
			bus_station [ bus_station_count ] [ b_position ] [ 1 ] = y ;
			bus_station [ bus_station_count ] [ b_position ] [ 2 ] = z ;
			bus_station [ bus_station_count ] [ b_position ] [ 3 ] = rx ;
			bus_station [ bus_station_count ] [ b_position ] [ 4 ] = ry ;
			bus_station [ bus_station_count ] [ b_position ] [ 5 ] = rz ;

			bus_station [ bus_station_count ] [ b_price ] = random ( 500 ) + 500 ;

			new station_string [ 178 ] ;
			format ( station_string, sizeof station_string, "** Автобусная остановка №%d **\n{"#cWH3D"}Нет ожидающих\n\n{"#cGR3D"}Будьте на остановке, чтобы проезжающие водители\n{"#cGR3D"}смогли подвезти Вас за вознаграждение.", bus_station [ bus_station_count ] [ b_id ] ) ;
			bus_station [ bus_station_count ] [ b_text ] = CreateDynamic3DTextLabel ( station_string, col_header_3d, bus_station [ bus_station_count ] [ b_position ] [ 0 ], bus_station [ bus_station_count ] [ b_position ] [ 1 ], bus_station [ bus_station_count ] [ b_position ] [ 2 ] + 2.0, 10.0 ) ;

			bus_station [ bus_station_count ] [ b_price ] = random ( 500 ) + 500 ;

			bus_station [ bus_station_count ] [ b_object ] = CreateDynamicObject ( object_bus_station, bus_station [ bus_station_count ] [ b_position ] [ 0 ],
									bus_station [ bus_station_count ] [ b_position ] [ 1 ],
									bus_station [ bus_station_count ] [ b_position ] [ 2 ],
									bus_station [ bus_station_count ] [ b_position ] [ 3 ],
									bus_station [ bus_station_count ] [ b_position ] [ 4 ],
									bus_station [ bus_station_count ] [ b_position ] [ 5 ] ) ;

			DestroyDynamicObject ( create_object_id [ playerid ] ) ;

			create_type { playerid } = 0 ;
			create_object_id [ playerid ] = INVALID_OBJECT_ID ;
			CancelEdit(playerid);

			global_string [ 0 ] = EOS ;
			mysql_format ( sql_connection, global_string, 256, "INSERT INTO `bus_station` ( `b_id`, `b_pos_x`, `b_pos_y`, `b_pos_z`, `b_pos_rx`, `b_pos_ry`, `b_pos_rz` ) VALUES ( '%d', '%f', '%f', '%f', '%f', '%f', '%f' )", bus_station [ bus_station_count ] [ b_id ], x, y, z, rx, ry, rz ) ;
			mysql_tquery ( sql_connection, global_string) ;

			bus_station_count ++ ;
		}

		else if ( create_type { playerid } == 4 )
	    {
	       	new station_id = GetPVarInt ( playerid, "fam_id_select" ) ;
			bus_station [ station_id ] [ b_position ] [ 0 ] = x ;
			bus_station [ station_id ] [ b_position ] [ 1 ] = y ;
			bus_station [ station_id ] [ b_position ] [ 2 ] = z ;
			bus_station [ station_id ] [ b_position ] [ 3 ] = rx ;
			bus_station [ station_id ] [ b_position ] [ 4 ] = ry ;
			bus_station [ station_id ] [ b_position ] [ 5 ] = rz ;

			bus_station [ station_id ] [ b_price ] = random ( 500 ) + 500 ;

			new station_string [ 178 ] ;
			format ( station_string, sizeof station_string, "** Автобусная остановка №%d **\n{"#cWH3D"}Нет ожидающих\n\n{"#cGR3D"}Будьте на остановке, чтобы проезжающие водители\n{"#cGR3D"}смогли подвезти Вас за вознаграждение.", bus_station [ station_id ] [ b_id ] ) ;
			bus_station [ station_id ] [ b_text ] = CreateDynamic3DTextLabel ( station_string, col_header_3d, bus_station [ station_id ] [ b_position ] [ 0 ], bus_station [ station_id ] [ b_position ] [ 1 ], bus_station [ station_id ] [ b_position ] [ 2 ] + 2.0, 10.0 ) ;

			bus_station [ station_id ] [ b_price ] = random ( 500 ) + 500 ;

			bus_station [ station_id ] [ b_object ] = CreateDynamicObject ( object_bus_station, bus_station [ station_id ] [ b_position ] [ 0 ],
										bus_station [ station_id ] [ b_position ] [ 1 ],
										bus_station [ station_id ] [ b_position ] [ 2 ],
										bus_station [ station_id ] [ b_position ] [ 3 ],
										bus_station [ station_id ] [ b_position ] [ 4 ],
										bus_station [ station_id ] [ b_position ] [ 5 ] ) ;

			DestroyDynamicObject ( create_object_id [ playerid ] ) ;

			create_type { playerid } = 0 ;
			create_object_id [ playerid ] = INVALID_OBJECT_ID ;
			DeletePVar ( playerid, "fam_id_select" ) ;
			CancelEdit(playerid);

			global_string [ 0 ] = EOS ;
			format ( global_string, 256, "UPDATE `bus_station` SET `b_pos_x` = '%f', `b_pos_y` = '%f', `b_pos_z` = '%f', `b_pos_rx` = '%f', `b_pos_ry` = '%f', `b_pos_rz` = '%f' WHERE `b_id` = '%d' LIMIT 1",
			x, y, z, rx, ry, rz, bus_station [ station_id ] [ b_id ] ) ;
			mysql_tquery ( sql_connection, global_string, "", "" ) ;
		}

		else if ( create_type { playerid } == 5 )
	    {
	       	new station_id = GetPVarInt ( playerid, "fam_id_select" ) ;
			atm_info [ station_id ] [ atm_position ] [ 0 ] = x ;
			atm_info [ station_id ] [ atm_position ] [ 1 ] = y ;
			atm_info [ station_id ] [ atm_position ] [ 2 ] = z ;
			atm_info [ station_id ] [ atm_position ] [ 3 ] = rx ;
			atm_info [ station_id ] [ atm_position ] [ 4 ] = ry ;
			atm_info [ station_id ] [ atm_position ] [ 5 ] = rz ;

			atm_info [ station_id ] [ atm_text ] = CreateDynamic3DTextLabel ( "** Банкомат **\n{"#cGR3D"}Подойдите для взаимодействия", col_header_3d, atm_info [ station_id ] [ atm_position ] [ 0 ], atm_info [ station_id ] [ atm_position ] [ 1 ], atm_info [ station_id ] [ atm_position ] [ 2 ], 4.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0 ) ;
            atm_info [ station_id ] [ atm_object ] = CreateDynamicObject ( object_atm, atm_info [ station_id ] [ atm_position ] [ 0 ], atm_info [ station_id ] [ atm_position ] [ 1 ], atm_info [ station_id ] [ atm_position ] [ 2 ], atm_info [ station_id ] [ atm_position ] [ 3 ], atm_info [ station_id ] [ atm_position ] [ 4 ], atm_info [ station_id ] [ atm_position ] [ 5 ], 0, 0, -1, 300.0, 300.0 ) ;
            //SetDynamicObjectMaterialText ( atm_info [ station_id ] [ atm_object ], 2, "\nБанкомат\n \n \n \n \n ", OBJECT_MATERIAL_SIZE_256x256, "Tahoma", 48, 1, 0xFF000000, 0xFF87CEEB, OBJECT_MATERIAL_TEXT_ALIGN_CENTER ) ;
			//SetDynamicObjectMaterial ( atm_info [ station_id ] [ atm_object ], 0, -1, "none", "none", 0xFFF0FFFF);

			DestroyDynamicObject ( create_object_id [ playerid ] ) ;

			create_type { playerid } = 0 ;
			create_object_id [ playerid ] = INVALID_OBJECT_ID ;
			DeletePVar ( playerid, "fam_id_select" ) ;
			CancelEdit ( playerid ) ;

			atm_info [ station_id ] [ atm_area ] = CreateDynamicSphere ( atm_info [ station_id ] [ atm_position ] [ 0 ], atm_info [ station_id ] [ atm_position ] [ 1 ], atm_info [ station_id ] [ atm_position ] [ 2 ], 3.0, 0, 0, -1 ) ;
	    	area_info [ atm_info [ station_id ] [ atm_area ] ] [ a_type ] = area_type_atm ;
	    	area_info [ atm_info [ station_id ] [ atm_area ] ] [ a_item ] = atm_info [ station_id ] [ atm_id ] ;

			global_string [ 0 ] = EOS ;
			format ( global_string, 256, "UPDATE `atm` SET `atm_pos_x` = '%f', `atm_pos_y` = '%f', `atm_pos_z` = '%f', `atm_pos_xr` = '%f', `atm_pos_yr` = '%f', `atm_pos_zr` = '%f' WHERE `atm_id` = '%d' LIMIT 1",
			x, y, z, rx, ry, rz, atm_info [ station_id ] [ atm_id ] ) ;
			mysql_tquery ( sql_connection, global_string, "", "" ) ;
		}

		else if ( create_type { playerid } == 10 )
	    {
	        printf ( "objectid: %d, x: %f, y: %f, z: %f, rx: %f, ry: %f, rz: %f", objectid, x, y, z, rx, ry, rz ) ;
			if ( get_player_use_listitem ( playerid ) == 0 ) DestroyDynamicObject ( create_object_id [ playerid ] ) ;

			create_type { playerid } = 0 ;
			create_object_id [ playerid ] = INVALID_OBJECT_ID ;
	    }
	}
	if ( response == EDIT_RESPONSE_CANCEL )
	{
	    if ( create_type { playerid } == 1 )
	    {
			create_type { playerid } = 0 ;
			DeletePVar(playerid, "TypeRadar");
			DestroyDynamicObject ( create_object_id [ playerid ] ) ;
			create_object_id [ playerid ] = INVALID_OBJECT_ID ;
			CancelEdit(playerid);
		}

		else if ( create_type { playerid } == 2 )
   		{
			DestroyDynamicObject ( create_object_id [ playerid ] ) ;
			create_object_id [ playerid ] = INVALID_OBJECT_ID ;
			create_type { playerid } = 0 ;
			CancelEdit(playerid);
		}

		else if ( create_type { playerid } == 3 )
	    {
			DestroyDynamicObject ( create_object_id [ playerid ] ) ;
			create_object_id [ playerid ] = INVALID_OBJECT_ID ;
			create_type { playerid } = 0 ;
			CancelEdit(playerid);
		}

		else if ( create_type { playerid } == 4 )
	    {
			DestroyDynamicObject ( create_object_id [ playerid ] ) ;
			create_object_id [ playerid ] = INVALID_OBJECT_ID ;
			create_type { playerid } = 0 ;
			DeletePVar ( playerid, "fam_id_select" ) ;
			CancelEdit(playerid);
		}

		else if ( create_type { playerid } == 5 )
	    {
			DestroyDynamicObject ( create_object_id [ playerid ] ) ;
			create_object_id [ playerid ] = INVALID_OBJECT_ID ;
			create_type { playerid } = 0 ;
			DeletePVar ( playerid, "fam_id_select" ) ;
			CancelEdit(playerid);
		}

		else if ( create_type { playerid } == 10 )
	    {
			DestroyDynamicObject ( create_object_id [ playerid ] ) ;
			create_object_id [ playerid ] = INVALID_OBJECT_ID ;
			create_type { playerid } = 0 ;
			CancelEdit(playerid);
		}
	}
	return 1 ;
}

callback: bh_story ( playerid, _b_id, type )
{
	new fields,
		rows ;
	cache_get_data ( rows, fields ) ;

	if ( ! rows ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}История о доходах не найдена." ) ;
	if ( rows )
	{
		global_string [ 0 ] = EOS ;
		new line_string [ 100 ] ;
		new _bh_date [ 32 ], _bh_money ;

		strcat ( global_string, "{"#cBL"}Дата:\t{"#cBL"}Доход:\n" ) ;
		for ( new i = 0 ; i < rows ; i ++ )
		{
 			_bh_money = cache_get_field_content_int ( i, "bh_count", sql_connection ) ;
			cache_get_field_content ( i, "bh_date", _bh_date, sql_connection, 32 ) ;

			format ( line_string, sizeof line_string, "{"#cWH"}%s\t{"#cGN"}%s"valute_title_"\n", _bh_date, GetPlayerCashValueToSmile ( _bh_money ) ) ;
			strcat ( global_string, line_string ) ;
		}

        line_string [ 0 ] = EOS ;
		format ( line_string, sizeof line_string, "{"#cWH"}Доход за сегодня: {"#cGN"}%s"valute_title"{"#cWH"}.", GetPlayerCashValueToSmile ( b_info [ _b_id - 1 ] [ b_cash_today ] ) ) ;

		if ( type == 1 ) show_dialog ( playerid, d_b_story, DIALOG_STYLE_TABLIST_HEADERS, line_string, global_string, "Назад", "Закрыть" ) ;
		else if ( type == 2 ) show_dialog ( playerid, d_b_story_sell, DIALOG_STYLE_TABLIST_HEADERS, line_string, global_string, "Назад", "Закрыть" ) ;
		else if ( type == 3 ) show_dialog ( playerid, d_none, DIALOG_STYLE_TABLIST_HEADERS, line_string, global_string, "Назад", "Закрыть" ) ;
	}
	return 1 ;
}

callback: membersOffline ( playerid, page, init )
{
    if ( init )
    {
		DeletePVar ( playerid, "ofm_listitem" ) ;
		if( ! GetPVarInt ( playerid, "ofm_type" ) )
		{
			static const _str [ ] = "\
				SELECT \
					u.u_name, \
					fp.u_rank, \
					u.u_played_time \
				FROM fractions_players fp \
				LEFT JOIN users u ON u.u_id=fp.u_sql_id \
				WHERE fp.u_member = %d LIMIT 10 OFFSET %d" ;
			new query_string [ sizeof _str + ( 9 * 2 ) ] ;
			format ( query_string, sizeof query_string, _str, p_info [ playerid ] [ member ], page * 10 ) ;
			mysql_tquery ( sql_connection, query_string, "membersOffline", "iii", playerid, page, 0 ) ;
			return 1 ;
		}

		static const _str [ ] = "\
			SELECT \
				u.u_name, \
				fp.u_rank, \
				u.u_played_time \
			FROM fractions_players fp \
			LEFT JOIN users u ON u.u_id=fp.u_sql_id \
			WHERE fp.u_member = %d AND fp.u_rank = %d LIMIT 10 OFFSET %d" ;
		new query_string [ sizeof _str + ( 9 * 2 ) ] ;
        format ( query_string, sizeof query_string, _str, p_info [ playerid ] [ member ], GetPVarInt ( playerid, "ofm_type" ), page * 10 ) ;
        mysql_tquery ( sql_connection, query_string, "membersOffline", "iii", playerid, page, 0 ) ;
    }
    else
    {
		page_count [ playerid ] = page ;

        new rows, fields ;
		cache_get_data ( rows, fields ) ;

		if ( ! rows )
		{
			send_check_cinfo ( playerid, "Ничего не найдено!", 0, 3, CINFO_FAMILY_ID, PICTURE_INFO_ERROR, "", "" ) ;
			return 1 ;
		}

        new pl_ofm_name [ MAX_PLAYER_NAME ], pl_ofm_online [ MAX_PLAYER_NAME ],
			pl_ofm_rank, pl_ofm_time, _f_id = p_info [ playerid ] [ member ] ;

		global_string [ 0 ] = EOS ;
		strcat ( global_string, "{"#cBL"}Ник:\t{"#cBL"}Должность:\t{"#cBL"}Статус:\n" ) ;
		for ( new i = 0 ; i < rows ; i ++ )
		{
			cache_get_field_content ( i, "u_name", pl_ofm_name ) ;
			pl_ofm_rank = cache_get_field_content_int ( i, "u_rank" ) ;
			if ( pl_ofm_rank < 1 ) pl_ofm_rank = 1 ;

			pl_ofm_time = cache_get_field_content_int ( i, "u_played_time" ) ;

			new pvar_string [ 8 ] ;
			format ( pvar_string, sizeof ( pvar_string ), "ofm_%d", i ) ;
			SetPVarString ( playerid, pvar_string, pl_ofm_name ) ;

			new _pl_id ;
			sscanf ( pl_ofm_name, "u", _pl_id ) ;

			if ( IsPlayerConnected ( _pl_id ) ) format ( pl_ofm_online, sizeof pl_ofm_online, "Сейчас играет ({"#cGN"}ONLINE{ffffff})" ) ;
			else
			{
				new float_time = gettime( ) - pl_ofm_time ;
				format ( pl_ofm_online, sizeof pl_ofm_online, "%s ({"#cRD"}OFFLINE{ffffff})", check_float_time ( float_time ) ) ;
			}

			format ( global_string, sizeof global_string, "%s%s\t{"#cOR"}%s (%d){ffffff}\t%s\n", pl_ofm_name, f_rank [ _f_id - 1 ] [ pl_ofm_rank - 1 ], pl_ofm_rank, pl_ofm_online ) ;
		}

		if ( page > 0 ) strcat ( global_string, "{"#cBL"}Предыдущая страница\n" ) ;
		if ( rows == 10 ) strcat ( global_string, "{"#cBL"}Следующая страница" ) ;

		show_dialog ( playerid, d_offmembers_list, DIALOG_STYLE_TABLIST_HEADERS, "{"#cBHD"}Члены организации оффлайн", global_string, "Выбрать", "Назад" ) ;
	}
    return true ;
}

callback: callback_offmembers_info ( playerid )
{
	new rows, fields;
	cache_get_data ( rows, fields ) ;
	if ( rows )
	{
		new pl_rank, last_date [ 24 ], _fraction_date [ 24 ] ;

		pl_rank = cache_get_field_content_int ( 0, "u_rank", sql_connection ) ;
		cache_get_field_content ( 0, "u_last_date", last_date, sql_connection, 24 ) ;
		cache_get_field_content ( 0, "u_fraction_date", _fraction_date, sql_connection, 24 ) ;

		new pvar_string [ 38 ], pl_name [ MAX_PLAYER_NAME ] ;
		format ( pvar_string, sizeof ( pvar_string ), "ofm_%d", GetPVarInt ( playerid, "ofm_listitem" ) ) ;
		GetPVarString ( playerid, pvar_string, pl_name, MAX_PLAYER_NAME ) ;

		new fraction_id ;
		if ( p_info [ playerid ] [ leader ] ) fraction_id = p_info [ playerid ] [ member ] ;
		else fraction_id = player_settings { playerid } ;

		new dialog_string [ 286 ] ;
		format ( dialog_string, sizeof ( dialog_string ), "{FFFFFF}Имя: {"#cBL"}%s{FFFFFF}\nРанг: {"#cBL"}%s (%d){FFFFFF}\nВ организации с {"#cBL"}%s{FFFFFF}\nПоследний вход: {"#cBL"}%s{FFFFFF}", pl_name, f_rank [ fraction_id - 1 ] [ pl_rank - 1 ], pl_rank, _fraction_date, last_date ) ;
		show_dialog ( playerid, d_offmembers_pl_menu_info, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Информация об игроке", dialog_string, "Назад", "" ) ;
	}
	if ( ! rows ) membersOffline ( playerid, page_count [ playerid ], 1 ) ;
	return 1 ;
}

