			return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}В Ваш бизнес не требуются сотрудники." ) ;

	    if ( p_info [ playerid ] [ business ] != -1 )
		{
			if ( b_info [ p_info [ playerid ] [ business ] != -1 ] [ b_type ] == bizz_type_casino )
			{
			    show_dialog ( playerid, d_business_select, DIALOG_STYLE_LIST, "{"#cBHD"}Устройство на работу", "{"#cBL"}1. {"#cWH"}Принять на работу менеджера\n{"#cBL"}2. {"#cWH"}Принять на работу сотрудника", "Выбрать", "Отмена" ) ;

				SetPVarInt ( playerid, "player_id", params [ 0 ] ) ;
				return 1 ;
			}
		}*/

	    new _t_string [ 138 ] ;
	    format(_t_string,sizeof(_t_string),"{"#cGInfo"}* {"#cWH"}Вы предложили {"#cGN"}%s {"#cWH"}работу в %s",p_info [ params [ 0 ] ] [ name ], b_info [ params [ 1 ] - 1 ] [ b_name ] ) ;
	    SendClientMessage ( playerid, col_white, _t_string ) ;

	    format ( _t_string, sizeof ( _t_string ),"{FFFFFF}%s предлагает Вам работу в %s.\n\n{"#cBL"}Вы согласны устроиться?", p_info [ playerid ] [ name ], b_info [ params [ 1 ] - 1 ] [ b_name ] ) ;
	    show_dialog ( params [ 0 ], d_business_invite, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Устройство на работу", _t_string, "Да", "Нет" ) ;

        p_info [ playerid ] [ business ] = params [ 1 ] ;
	    SetPVarInt ( params [ 0 ], "business_id", params [ 1 ] ) ;
	    return 1 ;
	}
	else
	{
		if ( sscanf(params, "u", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /binvite [id/имя]" ) ;

		if ( p_info [ playerid ] [ business_rang ] <  b_info [ p_info [ playerid ] [ b_worker ] - 1 ] [ b_settings ] [ 1 ] )
		{
		    static const _str [ ] = "{"#cRInfo"}* {"#cGRInfo"}Команда доступна с должности %s (%d)." ;
		    new scm_string [ sizeof _str + 30 + 4 ] ;
		    format ( scm_string, sizeof scm_string, _str, b_rank [ p_info [ playerid ] [ b_worker ] - 1 ] [ b_info [ p_info [ playerid ] [ b_worker ] - 1 ] [ b_settings ] [ 1 ] - 1 ], b_info [ p_info [ playerid ] [ b_worker ] - 1 ] [ b_settings ] [ 1 ] ) ;
			SendClientMessage ( playerid, col_gray, scm_string ) ;
			return 1 ;
		}

	 	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
		if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете применить это к самому себе." ) ;
		if ( Iter_Count(player_business[params [ 0 ]]) > 0 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок является владельцем бизнеса." ) ;
		if ( p_info [ params [ 0 ] ] [ b_worker ] != -1 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок уже является сотрудником." ) ;
		if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;
		if ( ! bad_dialog ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Недоступно в данный момент." ) ;

		/*if ( p_info [ playerid ] [ b_manager ] != -1 && b_info [ p_info [ playerid ] [ b_manager ] != -1 ] [ b_type ] != bizz_type_casino )
			return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}В Ваш бизнес не требуются сотрудники." ) ;

	    if ( p_info [ playerid ] [ business ] != -1 )
		{
			if ( b_info [ p_info [ playerid ] [ business ] != -1 ] [ b_type ] == bizz_type_casino )
			{
			    show_dialog ( playerid, d_business_select, DIALOG_STYLE_LIST, "{"#cBHD"}Устройство на работу", "{"#cBL"}1. {"#cWH"}Принять на работу менеджера\n{"#cBL"}2. {"#cWH"}Принять на работу сотрудника", "Выбрать", "Отмена" ) ;

