			}
			new d_amount = strval ( inputtext ) ;
			new d_string [ 172 ] ;

			if ( d_amount < 1 ) return show_dialog ( playerid, d_cellar_seed, DIALOG_STYLE_INPUT, "{"#cBHD"}Посадка семян", "{"#cRD"}* Количество не может быть менее 1 гр.\n\n{"#cWH"}Введите количество семян, которое желаете посадить:", "Принять", "Назад" ) ;
			if ( GetInventoryFindItem ( playerid, SUB_INVENTORY, 2159 ) < d_amount ) return show_dialog ( playerid, d_cellar_seed, DIALOG_STYLE_INPUT, "{"#cBHD"}Посадка семян", "{"#cRD"}* У Вас нет такого количества семян.\n{"#cRD"}* Купить семяна можно в притоне. (/gps)\n\n{"#cWH"}Введите количество семян, которое желаете посадить:", "Принять", "Назад" ) ;

			clear_inventory ( playerid, 2159, d_amount ) ;
			h_info [ h ] [ h_seed ] += d_amount ;
			h_info [ h ] [ h_seed_time ] = SetElapsedTime ( gettime ( ), random ( 2 ) + 2, CONVERT_TIME_TO_HOURS ) ;

			format ( d_string, 112, "{"#cGN"}*{"#cWH"} Вы посадили {"#cGN"}%d гр.{"#cWH"} семян. Ожидайте их созревания.", d_amount ) ;
			SendClientMessage ( playerid, col_white, d_string ) ;

			format ( d_string, sizeof ( d_string ), "{"#cBL"}Посажено семян: {"#cGRDialog"}%d гр.{"#cBL"} | Урожай: {"#cGRDialog"}%d гр.\n{"#cGRDialog"}- {"#cWH"}Посадить семена\n{"#cGRDialog"}- {"#cWH"}Переработка урожая",
			h_info [ h ] [ h_seed ], h_info [ h ] [ h_seed_result ] ) ;
			show_dialog ( playerid, d_cellar_menu_drugs, DIALOG_STYLE_LIST, "{"#cBHD"}Подвал", d_string, "Выбрать", "Закрыть" ) ;
			return 1 ;
		}
		case d_delivery:
		{
			if ( ! response ) return 1 ;
			switch ( listitem )
			{
				case 0:
				{
					new d_string [ 156 ] ;
					format ( d_string, sizeof ( d_string ), "{"#cBL"}Товара в транспорте: {"#cGRDialog"}%d кг.\n{"#cBL"}1. {"#cWH"}Закупка товара\n{"#cBL"}2. {"#cWH"}Список заказов",
					veh_info [ GetPlayerVehicleID ( playerid ) - 1 ] [ v_cargo ] ) ;
