		{
		    if ( ! response ) return 1 ;
		    switch ( listitem )
			{
		    	case 0: show_dialog ( playerid, d_drug_dealer, DIALOG_STYLE_INPUT, "{"#cBHD"}Наркоторговец", "{"#cWH"}Введите количество грамм семян, которое желаете приобрести:\n\n{"#cGRDialog"}* Стоимость 1 гр. семян составляет - {"#cWH"}50"valute_title"{"#cGRDialog"}.", "Выбрать", "Закрыть" ) ;
                case 1: show_dialog ( playerid, d_drug_dealer_drug, DIALOG_STYLE_INPUT, "{"#cBHD"}Наркоторговец", "{"#cWH"}Введите количество грамм наркотиков, которое желаете приобрести:\n\n{"#cGRDialog"}* Стоимость 1 гр. наркотиков составляет - {"#cWH"}100"valute_title"{"#cGRDialog"}.", "Выбрать", "Закрыть" ) ;
			}
