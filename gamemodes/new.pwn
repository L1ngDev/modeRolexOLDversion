	show_dialog ( playerid, d_bus_admin_1, DIALOG_STYLE_LIST, "{"#cBHD"}Редактирование маршрута", "{"#cBL"}1.{"#cWH"} Изменить заработную плату рейса\n{"#cBL"}2.{"#cWH"} Изменить название рейса\n{"#cBL"}3.{"#cWH"} Изменить движение", "Принять", "Отмена" ) ;
