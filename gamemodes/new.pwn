stock clear_accessories ( playerid, acsId )
{
	for ( new j = 0 ; j < MAX_ACCESORIES ; j ++ )
	{
 		if ( GetUserAccessories ( playerid, ACS_ID, j ) != acsId ) continue ;

		GetUserAccessories ( playerid, ACS_USED, j ) = 0 ;
		for ( new i = 5 ; i < 10 ; i ++ ) if ( IsPlayerAttachedObjectSlotUsed ( playerid, i ) ) RemovePlayerAttachedObject ( playerid, i ) ;
		attachUserAccessories ( playerid ) ;

		static const _str [ ] = "DELETE FROM `users_accessories` WHERE `id` = '%d' LIMIT 1" ;
		new _query [ sizeof _str + 9 ], modelId = GetUserAccessories ( playerid, ACS_MODEL, j ) ;
		format ( _query, sizeof _query, _str, GetUserAccessories ( playerid, ACS_ID, j ) ) ;
		mysql_tquery ( sql_connection, _query, "", "" ) ;

        USER_ACCESSORIES [ playerid ] [ j ] = clearAccessoriesStruct ;

		if ( weapon_skins ( modelId ) )
		{
			foreach(new targetId: streamed_players[playerid])
			{
				ClearPlayerWeaponTexture ( playerid, targetId ) ;
				SetPlayerWeaponTexture ( playerid, targetId ) ;
			}
			ClearPlayerWeaponTexture ( playerid, playerid ) ;
			SetPlayerWeaponTexture ( playerid, playerid ) ;
		}
		else if ( modelId == ITEM_SIM_CARD || modelId == 255 )
		{
			// p_info [ playerid ] [ number ] = 0 ; // Disabled by request: sim card number should stay
		}

		MODEL_INFO [ modelId ] [ MODEL_COUNT ] -= 1 ;
		set_model_count ( modelId, MODEL_INFO [ modelId ] [ MODEL_COUNT ] ) ;

		updateInventoryAcsSlot ( playerid, j ) ;
    	break ;
 	}
	return 1 ;
}

stock dropped_accessories ( acsId )
{
	deleteAccessoriesFloat ( acsId ) ;
	deleteAccessoriesStats ( acsId ) ;
	return true ;
}

