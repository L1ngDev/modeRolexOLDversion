    			! GetString ( p_t_info [ playerid ] [ lic_reason ], "None" ) )
    			{
    			    new lic_name [ 30 ] ;
    			    switch ( p_t_info [ playerid ] [ lic_type ] )
    			    {
    			        case 1: format ( lic_name, sizeof lic_name, "{"#cLY"}вод. права{"#cWV"}" ) ;
                        case 2: format ( lic_name, sizeof lic_name, "{"#cLY"}возд. т/с{"#cWV"}" ) ;
                        case 3: format ( lic_name, sizeof lic_name, "{"#cLY"}водн. т/с{"#cWV"}" ) ;
                        case 4: format ( lic_name, sizeof lic_name, "{"#cLY"}оружие{"#cWV"}" ) ;
    			    }

    			    new sanction_status [ 102 + MAX_PLAYER_NAME ] ;
				    switch ( p_t_info [ playerid ] [ lic_status ] )
				    {
				        case 0: format ( sanction_status, sizeof sanction_status, "отобрал(а) Вашу лицензию на %s", lic_name ) ;
				        case 1: format ( sanction_status, sizeof sanction_status, "снял(а) санкции c Вашей лицензии на %s", lic_name ) ;
				        case 2: format ( sanction_status, sizeof sanction_status, "заморозил(а) Вашу лицензию %s, Вы не сможете пользоваться данным видом транспорта %d часов", lic_name, p_t_info [ playerid ] [ lic_hour ] ) ;
				        case 3: format ( sanction_status, sizeof sanction_status, "ограничил(а) получение на лицензию %s, после снятия ограничения Вы сможете получить лицензию заново", lic_name ) ;
				    }

					new scm_string [ 186 ] ;
					format ( scm_string, 144, "%s %s %s.", f_rank [ p_info [ playerid ] [ member ] - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], sanction_status ) ;
					SendClientMessage ( p_t_info [ playerid ] [ target_lic ], col_wavy, scm_string ) ;

					new targetid = p_t_info [ playerid ] [ target_lic ], _lic_type = p_t_info [ playerid ] [ lic_type ] ;
					if ( _lic_type == 1 )
					{
					    p_info [ targetid ] [ drive_lic ] = p_t_info [ playerid ] [ lic_status ] ;
						p_info [ targetid ] [ drive_hour ] = p_t_info [ playerid ] [ lic_hour ] ;

						format ( p_info [ targetid ] [ drive_reason ], 16, "%s", p_t_info [ playerid ] [ lic_reason ] ) ;

						new query_string [ 118 + 16 + ( 9 * 3 ) ] ;
						format ( query_string, sizeof ( query_string ), "UPDATE `users` SET `u_drive_lic` = '%d', `u_drive_hour` = '%d', `u_drive_reason` = '%s' WHERE `u_id` = '%d' LIMIT 1",
						p_info [ targetid ] [ drive_lic ], p_info [ targetid ] [ drive_hour ], p_info [ targetid ] [ drive_reason ], p_info [ targetid ] [ id ] ) ;
						mysql_tquery ( sql_connection, query_string ) ;
					}
					else if ( _lic_type == 2 )
					{
					    p_info [ targetid ] [ fly_lic ] = p_t_info [ playerid ] [ lic_status ] ;
						p_info [ targetid ] [ fly_hour ] = p_t_info [ playerid ] [ lic_hour ] ;

						format ( p_info [ targetid ] [ fly_reason ], 16, "%s", p_t_info [ playerid ] [ lic_reason ] ) ;

						new query_string [ 118 + 16 + ( 9 * 3 ) ] ;
						format ( query_string, sizeof ( query_string ), "UPDATE `users` SET `u_fly_lic` = '%d', `u_fly_hour` = '%d', `u_fly_reason` = '%s' WHERE `u_id` = '%d' LIMIT 1",
						p_info [ targetid ] [ fly_lic ], p_info [ targetid ] [ fly_hour ], p_info [ targetid ] [ fly_reason ], p_info [ targetid ] [ id ] ) ;
						mysql_tquery ( sql_connection, query_string ) ;
					}
					else if ( _lic_type == 3 )
					{
					    p_info [ targetid ] [ boat_lic ] = p_t_info [ playerid ] [ lic_status ] ;
						p_info [ targetid ] [ boat_hour ] = p_t_info [ playerid ] [ lic_hour ] ;

						format ( p_info [ targetid ] [ boat_reason ], 16, "%s", p_t_info [ playerid ] [ lic_reason ] ) ;

						new query_string [ 118 + 16 + ( 9 * 3 ) ] ;
						format ( query_string, sizeof ( query_string ), "UPDATE `users` SET `u_boat_lic` = '%d', `u_boat_hour` = '%d', `u_boat_reason` = '%s' WHERE `u_id` = '%d' LIMIT 1",
						p_info [ targetid ] [ boat_lic ], p_info [ targetid ] [ boat_hour ], p_info [ targetid ] [ boat_reason ], p_info [ targetid ] [ id ] ) ;
						mysql_tquery ( sql_connection, query_string ) ;
					}
					else if ( _lic_type == 4 )
					{
					    p_info [ targetid ] [ gun_lic ] = p_t_info [ playerid ] [ lic_status ] ;
						p_info [ targetid ] [ gun_hour ] = p_t_info [ playerid ] [ lic_hour ] ;

						format ( p_info [ targetid ] [ gun_reason ], 16, "%s", p_t_info [ playerid ] [ lic_reason ] ) ;

						new query_string [ 118 + 16 + ( 9 * 3 ) ] ;
						format ( query_string, sizeof ( query_string ), "UPDATE `users` SET `u_gun_lic` = '%d', `u_gun_hour` = '%d', `u_gun_reason` = '%s' WHERE `u_id` = '%d' LIMIT 1",
						p_info [ targetid ] [ gun_lic ], p_info [ targetid ] [ gun_hour ], p_info [ targetid ] [ gun_reason ], p_info [ targetid ] [ id ] ) ;
						mysql_tquery ( sql_connection, query_string ) ;
					}

					new sanction_status1 [ 30 ] ;
				    switch ( p_t_info [ playerid ] [ lic_status ] )
				    {
				        case 0: format ( sanction_status1, sizeof sanction_status1, "изъятие" ) ;
				        case 1: format ( sanction_status1, sizeof sanction_status1, "снятие санкции" ) ;
				        case 2: format ( sanction_status1, sizeof sanction_status1, "заморозка" ) ;
				        case 3: format ( sanction_status1, sizeof sanction_status1, "ограничение на получение" ) ;
				    }

					format ( scm_string, 144, "[D] %s %s применил(а) лицензионные санкции к %s.", f_rank [ p_info [ playerid ] [ member ] - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], p_info [ targetid ] [ name ] ) ;
					foreach(new i: logged_players) if ( 18 > p_info [ i ] [ member ] > 0 && p_info [ i ] [ settings ] [ 0 ] ) SendClientMessage ( i, 0xFF8282AA, scm_string ) ;

					format ( scm_string, 144, "[D] Cтатус: %s. Причина: %s", sanction_status1, p_t_info [ playerid ] [ lic_reason ] ) ;
					foreach(new i: logged_players) if ( 18 > p_info [ i ] [ member ] > 0 && p_info [ i ] [ settings ] [ 0 ] ) SendClientMessage ( i, 0xFF8282AA, scm_string ) ;

					format ( scm_string, sizeof scm_string, "Применил(а) лицензионные санкции к %s", p_info [ targetid ] [ name ] ) ;
					write_fraction ( playerid, p_info [ playerid ] [ member ], TYPE_LOG_OBWYAK, scm_string ) ;
    			}
    			else show_take_lic ( playerid, p_t_info [ playerid ] [ target_lic ], p_t_info [ playerid ] [ lic_type ] ) ;
			}
			return 1 ;
		}
		case d_take_lic_1:
		{
		    if ( ! response ) return show_take_lic ( playerid, p_t_info [ playerid ] [ target_lic ], p_t_info [ playerid ] [ lic_type ] ) ;

		    p_t_info [ playerid ] [ lic_status ] = listitem ;
		    show_take_lic ( playerid, p_t_info [ playerid ] [ target_lic ], p_t_info [ playerid ] [ lic_type ] ) ;
			return 1 ;
		}
		case d_take_lic_2:
		{
		    if ( ! response ) return show_take_lic ( playerid, p_t_info [ playerid ] [ target_lic ], p_t_info [ playerid ] [ lic_type ] ) ;

		    if ( listitem == 0 ) p_t_info [ playerid ] [ lic_hour ] = 1 ;
		    else if ( listitem == 1 ) p_t_info [ playerid ] [ lic_hour ] = 3 ;
		    else if ( listitem == 2 ) p_t_info [ playerid ] [ lic_hour ] = 6 ;
		    else if ( listitem == 3 ) p_t_info [ playerid ] [ lic_hour ] = 12 ;
		    show_take_lic ( playerid, p_t_info [ playerid ] [ target_lic ], p_t_info [ playerid ] [ lic_type ] ) ;
			return 1 ;
		}
		case d_take_lic_3:
		{
		    if ( ! response ) return show_take_lic ( playerid, p_t_info [ playerid ] [ target_lic ], p_t_info [ playerid ] [ lic_type ] ) ;

		    if ( strlen ( inputtext ) < 3 || strlen ( inputtext ) > 16 )
		    {
		        show_dialog ( playerid, d_take_lic_3, DIALOG_STYLE_INPUT, "{"#cBHD"}Причина", "{"#cRD"}* Причина не может быть менее 3 символов и более 16\n\n{"#cWH"}Укажите причину санкции, чтоб игрок мог её потом обжаловать.\n\n{"#cGRDialog"}* Введите причину санкции:", "Выбрать", "Закрыть");
		        return 1 ;
		    }

		    format ( p_t_info [ playerid ] [ lic_reason ], 16, "%s", inputtext ) ;
		    show_take_lic ( playerid, p_t_info [ playerid ] [ target_lic ], p_t_info [ playerid ] [ lic_type ] ) ;
			return 1 ;
		}
		case d_take:
		{
			if ( ! response ) return clear_sell_params ( playerid, playerid ) ;

			new targetid = buyer_id [ playerid ] ;
			clear_sell_params ( playerid, playerid ) ;

			if ( ! IsPlayerConnected ( targetid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ),DeletePVar ( playerid, "target_id" ) ;
			if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ targetid ][ p_pos ] [ 0 ], p_t_info [ targetid ][ p_pos ] [ 1 ], p_t_info [ targetid ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( targetid ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ),DeletePVar ( playerid, "target_id" ) ;
			switch ( p_t_info [ playerid ] [ take_position ] [ listitem ] )
			{
				case 0..3:
				{
				    p_t_info [ playerid ] [ target_lic ] = targetid ;
				    p_t_info [ playerid ] [ lic_type ] = listitem + 1 ;
				    show_take_lic ( playerid, p_t_info [ playerid ] [ target_lic ], p_t_info [ playerid ] [ lic_type ] ) ;
				    return 1 ;
				}
				case 4:
				{
					new t_string [ 128 ], _drugs = GetInventoryFindItem ( targetid, SUB_INVENTORY, 2155 ) ;
					format ( t_string, sizeof ( t_string ),"%s %s изъял(а) у Вас %d грамм наркотиков.",
					f_rank [ p_info [ playerid ] [ member ] - 1 ] [ p_info [ playerid ] [ rank ] - 1 ],
					p_info [ playerid ] [ name ],
					_drugs ) ;
					SendClientMessage ( targetid, col_wavy, t_string ) ;
					format ( t_string, 72,"Вы изъяли у %s %d грамм наркотиков.",
					p_info [ targetid ] [ name ], _drugs ) ;
					SendClientMessage ( playerid, col_wavy, t_string ) ;

					clear_inventory ( targetid, 2155, _drugs ) ;

					format ( t_string, 92, "Изъял(а) наркотики у %s", p_info [ targetid ] [ name ] ) ;
					write_fraction ( playerid, p_info [ playerid ] [ member ], TYPE_LOG_OBWYAK, t_string ) ;
				}
				case 5:
				{
					new t_string [ 128 ], _ammo = GetInventoryFindItem ( targetid, SUB_INVENTORY, 2154 ) ;
					format ( t_string, sizeof ( t_string ),"%s %s изъял(а) у Вас %d патрон.",
					f_rank [ p_info [ playerid ] [ member ] - 1 ] [ p_info [ playerid ] [ rank ] - 1 ],
					p_info [ playerid ] [ name ],
				 	_ammo ) ;
					SendClientMessage ( targetid, col_wavy, t_string ) ;
					format ( t_string, 54,"Вы изъяли у %s %d патрон.",
					p_info [ targetid ] [ name ], _ammo ) ;
					SendClientMessage ( playerid, col_wavy, t_string ) ;

					clear_inventory ( targetid, 2154, _ammo ) ;

					format ( t_string, 92, "Изъял(а) патроны у %s", p_info [ targetid ] [ name ] ) ;
					write_fraction ( playerid, p_info [ playerid ] [ member ], TYPE_LOG_OBWYAK, t_string ) ;
				}
				case 6:
				{
					new t_string [ 128 ], _guns = GetInventoryFindItem ( targetid, SUB_INVENTORY, 2153 ) ;
					format ( t_string, sizeof ( t_string ),"%s %s изъял(а) у Вас %d ед.оружия.",
					f_rank [ p_info [ playerid ] [ member ] - 1 ] [ p_info [ playerid ] [ rank ] - 1 ],
					p_info [ playerid ] [ name ],
					_guns ) ;
					SendClientMessage ( targetid, col_wavy, t_string ) ;
					format ( t_string, 72,"Вы изъяли у %s %d ед.оружия.",
					p_info [ targetid ] [ name ], _guns ) ;
					SendClientMessage ( playerid, col_wavy, t_string ) ;

					clear_inventory ( targetid, 2153, _guns ) ;

					format ( t_string, 92, "Изъял(а) ед. оружия у %s", p_info [ targetid ] [ name ] ) ;
					write_fraction ( playerid, p_info [ playerid ] [ member ], TYPE_LOG_OBWYAK, t_string ) ;
				}
				case 7:
				{
					new t_string [ 128 ], _seed = GetInventoryFindItem ( targetid, SUB_INVENTORY, 2159 ) ;
					format ( t_string, sizeof ( t_string ),"%s %s изъял(а) у Вас %d семян.",
					f_rank [ p_info [ playerid ] [ member ] - 1 ] [ p_info [ playerid ] [ rank ] - 1 ],
					p_info [ playerid ] [ name ], _seed ) ;
					SendClientMessage ( targetid, col_wavy, t_string ) ;
					format ( t_string, 72, "Вы изъяли у %s %d семян.",
					p_info [ targetid ] [ name ], _seed ) ;
					SendClientMessage ( playerid, col_wavy, t_string ) ;

					clear_inventory ( targetid, 2159, _seed ) ;

					format ( t_string, 92, "Изъял(а) семена у %s", p_info [ targetid ] [ name ] ) ;
					write_fraction ( playerid, p_info [ playerid ] [ member ], TYPE_LOG_OBWYAK, t_string ) ;
				}
				case 9..21:
				{
				    new _take_id = p_t_info [ playerid ] [ take_position ] [ listitem ] ;

				    new gun_name[ 32 ] ;
					GetWeaponName ( p_t_info [ targetid ] [ p_gun_slot ] [ _take_id - 9 ], gun_name, 32 ) ;

				    new t_string [ 100 ] ;
					format ( t_string, sizeof ( t_string ),"%s %s изъял(а) у Вас %s с %d патрон(ами).",
					f_rank [ p_info [ playerid ] [ member ] - 1 ] [ p_info [ playerid ] [ rank ] - 1 ],
					p_info [ playerid ] [ name ],
					gun_name,
					p_t_info [ targetid ] [ p_gun_ammo ] [ _take_id - 9 ] ) ;
					SendClientMessage ( targetid, col_wavy, t_string ) ;
					format ( t_string, 72,"Вы изъяли у %s %s с %d патрон(ами).",
					p_info [ targetid ] [ name ], gun_name, p_t_info [ targetid ] [ p_gun_ammo ] [ _take_id - 9 ] ) ;
					SendClientMessage ( playerid, col_wavy, t_string ) ;

					format ( t_string, 92, "Изъял(а) оружие у %s %s с %d патрон(ами)", p_info [ targetid ] [ name ],
					gun_name, p_t_info [ targetid ] [ p_gun_ammo ] [ _take_id - 9 ] ) ;
					write_fraction ( playerid, p_info [ playerid ] [ member ], TYPE_LOG_OBWYAK, t_string ) ;

					p_t_info [ targetid ] [ p_gun_ammo ] [ _take_id - 9 ] = 0 ;
					p_t_info [ targetid ] [ p_gun_slot ] [ _take_id - 9 ] = 0 ;
				}
			}
			new clf_string [ 4 + 9 ] ;
	       	format ( clf_string, sizeof clf_string, "%d", targetid ) ;
			callcmd::take ( playerid, clf_string ) ;
			return 1 ;
		}
		case d_cellarmenu:
		{
		    if ( ! response ) return 1 ;
			new house_id = p_info [ playerid ] [ cellar ] - 1 ;
			switch ( listitem )
			{
				case 0:
				{
					if ( cellar_info [ house_id ] [ cl_closed ] == 0 )
					{
						cellar_info [ house_id ] [ cl_closed ] = 1;
						GameTextForPlayer ( playerid,"~r~closed", 2000, 3 ) ;
					}
					else
					{
						cellar_info [ house_id ] [ cl_closed ] = 0;
						GameTextForPlayer ( playerid, "~g~opened", 2000, 3 ) ;
					}
					new query_string [ 98 ];
					format ( query_string, sizeof ( query_string ), "UPDATE `cellars` SET `cl_closed` = '%d' WHERE `cl_id` = '%d' LIMIT 1", cellar_info [ house_id ] [ cl_closed ], house_id + 1 ) ;
					mysql_tquery ( sql_connection, query_string ) ;
				}
				case 1:
				{
					global_string [ 0 ] = EOS ;
					for ( new i = 0 ; i < 4 ; i ++ )
					{
						new c[7];
						if ( cellar_info [ house_id ] [ cl_improve ] [ i ] ) c = ""#cGN"";
						else if ( !i || cellar_info [ house_id ] [ cl_improve ] [ i - 1 ] ) c = ""#cWH"" ;
						else c = ""#cGRDialog"" ;
						if(!i) format( global_string, sizeof ( global_string ),"{%s}%d. %s", c, i + 1, cl_improve_name [ i ] ) ;
						else format( global_string, sizeof ( global_string ),"%s\n{%s}%d. %s", global_string, c, i + 1, cl_improve_name [ i ] ) ;
					}
					show_dialog ( playerid, d_cl_improvement, DIALOG_STYLE_LIST, "{"#cBHD"}Улучшения подвала", global_string, "Выбрать", "Назад" ) ;
				}
				case 2:
				{
					if ( ! cellar_info [ house_id ] [ cl_improve ] [ 1 ] ) return show_cellarmenu ( playerid ), SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет данного улучшения." ) ;
					show_dialog ( playerid, d_cl_warehouse_access, DIALOG_STYLE_LIST, "{"#cBHD"}Cклад", "Взять деньги\nПоложить деньги\nВзять наркотики\nПоложить наркотики\nОружие", "Выбрать", "Закрыть" ) ;
				}
			}
			return 1 ;
		}
		case d_cl_improvement:
		{
			if(!response) return show_cellarmenu ( playerid ) ;
			new house_id = p_info [ playerid ] [ cellar ] - 1 ;
			if ( cellar_info [ house_id ] [ cl_improve ] [ listitem ] )
			{
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас уже установлено это улучшение." ) ;
				show_cellarmenu ( playerid ) ;
				return 1 ;
			}
			else if((!listitem && !cellar_info [ house_id ] [ cl_improve ] [ listitem ] ) || (cellar_info[house_id][cl_improve][listitem-1] && !cellar_info[house_id][cl_improve][listitem]))
			{
				new mes [ 156 ] ;
				format ( mes, sizeof ( mes ), "{"#cWH"}Вы хотите купить улучшение: {"#cBL"}\"%s\"?\n\n{"#cWH"}Оно обойдется Вам в {"#cGN"}%d"valute_title".",cl_improve_name[listitem], cl_improve_price[listitem]);
				show_dialog ( playerid, d_cl_improvement_accept, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Улучшения подвала",mes,"Купить","Отмена" ) ;
				set_player_use_listitem ( playerid, listitem ) ;
			}
			else
			{
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Это улучшение еще не доступно Вам." ) ;
				show_cellarmenu ( playerid ) ;
			}
			return 1 ;
		}
		case d_cl_improvement_accept:
		{
			new improveid = get_player_use_listitem ( playerid ) ;
			if(!response) return show_cellarmenu ( playerid ) ;
			new price = cl_improve_price[improveid];
			if ( p_info [ playerid ] [ money ] < price )
			{
				show_cellarmenu ( playerid ) ;
				return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас недостаточно денег." ) ;
			}
			new house_id = p_info [ playerid ] [ cellar ] - 1 ;

			cellar_info [ house_id ] [ cl_improve ] [ improveid ] = 1 ;
			new data [ 32 ], query [ 128 ] ;
			for ( new i = 0 ; i < 4 ; i ++ )
			{
				if(!i) format ( data, sizeof ( data ),"%d", cellar_info [ house_id ] [ cl_improve ] [ i ] ) ;
				else format ( data, sizeof ( data ),"%s|%d", data, cellar_info [ house_id ] [ cl_improve ] [ i ] ) ;
			}
			format(query,sizeof(query),"UPDATE `cellars` SET `cl_improve` = '%s' WHERE `cl_id` = '%d' LIMIT 1", data, house_id + 1 ) ;
			mysql_tquery ( sql_connection, query ) ;


			give_money ( playerid, -price ) ;
			insert_money_log ( playerid, INVALID_PLAYER_ID, -price, "Улучшение подвала" ) ;

			SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Поздравляем, Вы купили улучшение для подвала." ) ;
			for ( new i = 0 ; i < 4 ; i ++ )
			{
				new c [ 7 ] ;
				if ( cellar_info [ house_id ] [ cl_improve ] [ i ] ) c = ""#cGN"";
				else if ( !i || cellar_info [ house_id ] [ cl_improve ] [ i - 1 ] ) c = ""#cWH"" ;
				else c = ""#cGRDialog"" ;
				if(!i) format( global_string, sizeof ( global_string ),"{%s}%d. %s", c, i + 1, cl_improve_name [ i ] ) ;
				else format( global_string, sizeof ( global_string ),"%s\n{%s}%d. %s", global_string, c, i + 1, cl_improve_name [ i ] ) ;
			}
			show_dialog ( playerid, d_cl_improvement, DIALOG_STYLE_LIST, "{"#cBHD"}Улучшения подвала", global_string, "Выбрать", "Назад" ) ;
			return 1 ;
		}
		case d_cl_warehouse_access:
		{
			if ( ! response ) return show_cellarmenu ( playerid ) ;
			if ( response )
			{
				switch ( listitem )
				{
					case 0:
					{
					    if ( p_info [ playerid ] [ hour_played ] < THREE_HOUR_PLAYED ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Доступно с 3 часов в игре. Используйте /mm - Информация о персонаже - Статистика персонажа." ) ;

						new string [ 98 + 9 ] ;
					    new h = GetPVarInt ( playerid, "cellar_id" ) - 1 ;
						format ( string, sizeof string, "{"#cWH"}На складе {"#cGN"}%d"valute_title"{"#cWH"}.\n\n{"#cGRDialog"}* Введите сумму, которую желаете взять:", cellar_info [ h ] [ cl_safe_data ] [ 1 ] ) ;
						show_dialog ( playerid, d_cl_warehouse_money_get, DIALOG_STYLE_INPUT, "{"#cBHD"}Взять деньги", string, "Принять", "Назад" ) ;
					}
					case 1:
					{
					    if ( p_info [ playerid ] [ hour_played ] < THREE_HOUR_PLAYED ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Доступно с 3 часов в игре. Используйте /mm - Информация о персонаже - Статистика персонажа." ) ;

					    new string [ 109 + 9 ] ;
					    new h = GetPVarInt ( playerid, "cellar_id" ) - 1 ;
						format ( string, sizeof string, "{"#cWH"}На складе {"#cGN"}%d"valute_title"{"#cWH"}.\n\n{"#cGRDialog"}* Введите сумму, которую желаете положить в склад:", cellar_info [ h ] [ cl_safe_data ] [ 1 ] ) ;
						show_dialog ( playerid, d_cl_warehouse_money_put, DIALOG_STYLE_INPUT, "{"#cBHD"}Положить деньги", string, "Принять", "Назад" ) ;
					}
					case 2:
					{
						new string [ 119 + 9 ] ;
					    new h = GetPVarInt ( playerid, "cellar_id" ) - 1 ;
						format ( string, sizeof string, "{"#cWH"}На складе {"#cGN"}%d{"#cWH"} грамм наркотиков.\n\n{"#cGRDialog"}* Введите количество, которое желаете взять:", cellar_info [ h ] [ cl_safe_data ] [ 0 ]) ;
						show_dialog ( playerid, d_cl_warehouse_drugs_get, DIALOG_STYLE_INPUT, "{"#cBHD"}Взять наркотики", string, "Принять", "Назад" ) ;
					}
					case 3:
					{
						new string [ 122 + 9 ] ;
					    new h = GetPVarInt ( playerid, "cellar_id" ) - 1 ;
						format ( string, sizeof string, "{"#cWH"}На складе {"#cGN"}%d{"#cWH"} грамм наркотиков.\n\n{"#cGRDialog"}* Введите количество, которое желаете положить:", cellar_info [ h ] [ cl_safe_data ] [ 0 ]) ;
						show_dialog ( playerid, d_cl_warehouse_drugs_put, DIALOG_STYLE_INPUT, "{"#cBHD"}Положить наркотики", string, "Принять", "Назад" ) ;
					}
					case 4:
					{
						new string [ 198 ] ;
						new h = GetPVarInt ( playerid, "cellar_id" ) - 1 ;
						for(new i = 0; i < 3; i++)
