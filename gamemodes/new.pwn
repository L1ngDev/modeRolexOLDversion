    new query_string [ 300 ] ;
    new _count_id = 0 ;
    for ( new t = ( podezd_count * 16 ) ; t < ( podezd_count * 16 ) + 16 ; t ++ )
    {
        if ( params [ 3 ] == 2 )
        {
            GetPlayerPos ( playerid, h_info [ house_count ] [ h_pos ] [ 0 ], h_info [ house_count ] [ h_pos ] [ 1 ], h_info [ house_count ] [ h_pos ] [ 2 ] ) ;
			GetPlayerFacingAngle ( playerid, h_info [ house_count ] [ h_pos ] [ 3 ] ) ;

			h_info [ house_count ] [ h_id ] = house_count + 1 ;
			strcat ( h_info [ house_count ] [ h_owner_name ], "Собственность штата" ) ;
			h_info [ house_count ] [ h_owner ] = -1 ;
			h_info [ house_count ] [ h_price ] = 250000 ;
			h_info [ house_count ] [ h_garage ] = 0 ;
			h_info [ house_count ] [ h_int ] = 0 ;
			h_info [ house_count ] [ h_vw ] = p_t_info [ playerid ] [ p_data ] [ 1 ] ;

			h_info [ house_count ] [ h_price_ticket ] = 0 ;

			format ( query_string, 144, "Вы успешно создали недвижимость | Дом №%d.", h_info [ house_count ] [ h_id ] ) ;
			SendClientMessage ( playerid, col_white, query_string ) ;

			mysql_format ( sql_connection, query_string, sizeof ( query_string  ),"INSERT INTO `houses` (`h_id`,`h_pos_x`,`h_pos_y`,`h_pos_z`,`h_pos_c`,`h_price`,`h_vw`,`h_int`,`h_garage`,`h_price_ticket`) VALUES ('%d','%f','%f','%f','%f','%d','%d','%d','%d','%d')",
			h_info [ house_count ] [ h_id ], h_info [ house_count ] [ h_pos ] [ 0 ], h_info [ house_count ] [ h_pos ] [ 1 ], h_info [ house_count ] [ h_pos ] [ 2 ], h_info [ house_count ] [ h_pos ] [ 3 ],
			params [ 1 ], h_info [ house_count ] [ h_vw ], params [ 0 ], params [ 2 ], h_info [ house_count ] [ h_price_ticket ] ) ;
			mysql_query ( sql_connection, query_string, false ) ;

			house_count ++ ;
        }

        if ( _count_id < 4 ) h_info [ t ] [ h_vw ] = ( podezd_count * 10 ) + 10 ;
        else if ( _count_id > 3 && _count_id < 8 ) h_info [ t ] [ h_vw ] = ( podezd_count * 10 ) + 11 ;
        else if ( _count_id > 7 && _count_id < 12 ) h_info [ t ] [ h_vw ] = ( podezd_count * 10 ) + 12 ;
        else if ( _count_id > 11 && _count_id < 16 ) h_info [ t ] [ h_vw ] = ( podezd_count * 10 ) + 13 ;

        DestroyDynamicPickup ( h_info [ t ] [ h_pickup ] ) ;
	    DestroyDynamicMapIcon ( h_info [ t ] [ h_icon_id ] ) ;

	    h_info [ t ] [ h_podezd ] = podezd_count ;
	    h_info [ t ] [ h_pos ] [ 0 ] = _room_in_padik [ params [ 2 ] - 1 ] [ _count_id ] [ 0 ] ;
		h_info [ t ] [ h_pos ] [ 1 ] = _room_in_padik [ params [ 2 ] - 1 ] [ _count_id ] [ 1 ] ;
		h_info [ t ] [ h_pos ] [ 2 ] = _room_in_padik [ params [ 2 ] - 1 ] [ _count_id ] [ 2 ] ;
		h_info [ t ] [ h_pos ] [ 3 ] = _room_in_padik [ params [ 2 ] - 1 ] [ _count_id ] [ 3 ] ;

		if ( t == 2 || t == 5 || t == 7 || t == 11 || t == 13 ) h_info [ t ] [ h_int ] = params [ 1 ] ;
		else h_info [ t ] [ h_int ] = params [ 0 ] ;

        h_info [ t ] [ h_garage ] = 0 ;

		_count_id ++ ;

		format ( query_string, sizeof ( query_string  ), "UPDATE `houses` SET `h_pos_x` = '%f' ,`h_pos_y` = '%f' ,`h_pos_z` = '%f' ,`h_pos_c` = '%f', `h_vw` = '%d', `h_int` = '%d', `h_garage` = '%d', `h_podezd` = '%d' WHERE `h_id` = '%d' LIMIT 1",
		h_info [ t ] [ h_pos ] [ 0 ], h_info [ t ] [ h_pos ] [ 1 ], h_info [ t ] [ h_pos ] [ 2 ], h_info [ t ] [ h_pos ] [ 3 ], h_info [ t ] [ h_vw ], h_info [ t ] [ h_int ], h_info [ t ] [ h_garage ], podezd_count, t + 1 ) ;
		mysql_tquery ( sql_connection, query_string ) ;

		if ( h_info [ t ] [ h_owner ] == -1 )
		{
			h_info [ t ] [ h_pickup ] = CreateDynamicPickup ( pickupPropertyFree, 23, h_info [ t ] [ h_pos ] [ 0 ], h_info [ t ] [ h_pos ] [ 1 ], h_info [ t ] [ h_pos ] [ 2 ], h_info [ t ] [ h_vw ], -1 ) ;
			pick_info [ h_info [ t ] [ h_pickup ] ] [ pick_type ] = pick_type_hentrance ;
			pick_info [ h_info [ t ] [ h_pickup ] ] [ pick_item ] = h_info [ t ] [ h_id ] ;

			if ( ! h_info [ t ] [ h_vw ] ) h_info [ t ] [ h_icon_id ] = CreateDynamicMapIcon ( h_info [ t ] [ h_pos ] [ 0 ], h_info [ t ] [ h_pos ] [ 1 ], h_info [ t ] [ h_pos ] [ 2 ], radar_propertyG, 0, 0, 0, -1 ) ;
		}
		else
		{
			if ( h_info [ t ] [ h_rent_status ] == 0 )
			{
				h_info [ t ] [ h_pickup ] = CreateDynamicPickup ( pickupPropertyUse, 23, h_info [ t ] [ h_pos ] [ 0 ], h_info [ t ] [ h_pos ] [ 1 ], h_info [ t ] [ h_pos ] [ 2 ], h_info [ t ] [ h_vw ], -1 ) ;
                pick_info [ h_info [ t ] [ h_pickup ] ] [ pick_type ] = pick_type_hentrance ;
				pick_info [ h_info [ t ] [ h_pickup ] ] [ pick_item ] = h_info [ t ] [ h_id ] ;

				if ( ! h_info [ t ] [ h_vw ] ) h_info [ t ] [ h_icon_id ] = CreateDynamicMapIcon ( h_info [ t ] [ h_pos ] [ 0 ], h_info [ t ] [ h_pos ] [ 1 ], h_info [ t ] [ h_pos ] [ 2 ], radar_propertyR, 0, 0, 0, -1 ) ;
			}
			else
			{
				h_info [ t ] [ h_pickup ] = CreateDynamicPickup ( 19524, 23, h_info [ t ] [ h_pos ] [ 0 ], h_info [ t ] [ h_pos ] [ 1 ], h_info [ t ] [ h_pos ] [ 2 ], h_info [ t ] [ h_vw ], -1 ) ;
                pick_info [ h_info [ t ] [ h_pickup ] ] [ pick_type ] = pick_type_hentrance ;
				pick_info [ h_info [ t ] [ h_pickup ] ] [ pick_item ] = h_info [ t ] [ h_id ] ;

				if ( ! h_info [ t ] [ h_vw ] ) h_info [ t ] [ h_icon_id ] = CreateDynamicMapIcon ( h_info [ t ] [ h_pos ] [ 0 ], h_info [ t ] [ h_pos ] [ 1 ], h_info [ t ] [ h_pos ] [ 2 ], radar_propertyR, 0, 0, 0, -1 ) ;
			}
		}
    }

    GetPlayerPos ( playerid, podezd_info [ podezd_count ] [ p_pos ] [ 0 ], podezd_info [ podezd_count ] [ p_pos ] [ 1 ], podezd_info [ podezd_count ] [ p_pos ] [ 2 ] ) ;
    GetPlayerFacingAngle ( playerid, podezd_info [ podezd_count ] [ p_pos ] [ 3 ] ) ;

    podezd_info [ podezd_count ] [ p_pick ] = CreateDynamicPickup ( 1318, 23, podezd_info [ podezd_count ] [ p_pos ] [ 0 ], podezd_info [ podezd_count ] [ p_pos ] [ 1 ], podezd_info [ podezd_count ] [ p_pos ] [ 2 ], 0, 0, -1 ) ;
    pick_info [ podezd_info [ podezd_count ] [ p_pick ] ] [ pick_type ] = pick_type_podezd_enter ;
    pick_info [ podezd_info [ podezd_count ] [ p_pick ] ] [ pick_item ] = podezd_info [ podezd_count ] [ p_id ] ;

    _count_id = 0 ;
    for ( new t = ( podezd_count * 16 ) ; t < ( podezd_count * 16 ) + 16 ; t ++ )
    {
        if ( h_info [ t ] [ h_owner ] == -1 ) _count_id ++ ;
    }

	if ( _count_id == 0 ) podezd_info [ podezd_count ] [ p_icon ] = CreateDynamicMapIcon ( podezd_info [ podezd_count ] [ p_pos ] [ 0 ], podezd_info [ podezd_count ] [ p_pos ] [ 1 ], podezd_info [ podezd_count ] [ p_pos ] [ 2 ], 32, 0, 0, 0, -1 ) ;
	else podezd_info [ podezd_count ] [ p_icon ] = CreateDynamicMapIcon ( podezd_info [ podezd_count ] [ p_pos ] [ 0 ], podezd_info [ podezd_count ] [ p_pos ] [ 1 ], podezd_info [ podezd_count ] [ p_pos ] [ 2 ], 31, 0, 0, 0, -1 ) ;

    new station_string [ 63 + 4 + 4 ] ;
	format ( station_string, sizeof station_string, "** Подъезд №%d **\n{"#cWH3D"}Свободных квартир: {"#cOR3D"}%d", podezd_info [ podezd_count ] [ p_id ], _count_id ) ;
	podezd_info [ podezd_count ] [ p_text ] = CreateDynamic3DTextLabel ( station_string, col_header_3d, podezd_info [ podezd_count ] [ p_pos ] [ 0 ], podezd_info [ podezd_count ] [ p_pos ] [ 1 ], podezd_info [ podezd_count ] [ p_pos ] [ 2 ] + 1.0, 10.0 ) ;

    query_string [ 0 ] = EOS ;
    format ( query_string, 186, "INSERT INTO `podezd` (`p_pos_x`, `p_pos_y`, `p_pos_z`, `p_pos_c`, `p_int`) VALUES ('%f', '%f', '%f', '%f', '%d')", podezd_info [ podezd_count ] [ p_pos ] [ 0 ], podezd_info [ podezd_count ] [ p_pos ] [ 1 ], podezd_info [ podezd_count ] [ p_pos ] [ 2 ], podezd_info [ podezd_count ] [ p_pos ] [ 3 ], podezd_info [ podezd_count ] [ p_int ] ) ;
    mysql_tquery ( sql_connection, query_string, "", "" ) ;

    podezd_count ++ ;

	mysql_tquery ( sql_connection, !"SELECT * FROM `houses` ORDER BY `houses`.`h_id` ASC", "houses_loading" ) ;
	return 1 ;
}

CMD:gotopadik ( playerid, params [ ] )
{
    if ( admin_info [ playerid ] [ admin ] < 3 ) return 1 ;
    if ( sscanf ( params, "d", params [ 0 ] ) ) SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /gotopadik [ид]" ) ;
    if ( params [ 0 ] > podezd_count ) return 1 ;
    if ( params [ 0 ] > 0 )
    {
        SetPVarInt ( playerid, "fam_id_select", params [ 0 ] - 1 ) ;
        new select_id = GetPVarInt ( playerid, "fam_id_select" ) ;

        new line_string [ 64 ] ;
        format ( line_string, sizeof line_string, "{"#cBHD"}Подъезд №%d", podezd_info [ select_id ] [ p_id ] ) ;
        show_dialog ( playerid, d_gotopadik_select, DIALOG_STYLE_LIST, line_string, "{"#cBL"}1. {"#cWH"}Телепортироваться\n{"#cBL"}2. {"#cWH"}Изменить позицию\n{"#cBL"}3. {"#cWH"}Добавить подземную парковку\n{"#cBL"}4. {"#cWH"}Позиция выезда с парковки", "Выбрать", "Закрыть" ) ;
        return 1 ;
    }

    podezdList ( playerid, 0 ) ;
	return 1 ;
}

stock podezdList ( playerid, page )
{
	page_count [ playerid ] = page ;

	new count = 0 ;

	global_string [ 0 ] = EOS ;
  	for ( new p = 0 ; p < podezd_count ; p ++ )
	{
		if ( page * 20 > p ) continue ;
  		if ( p > ( page + 1 ) * 20 ) break ;

  		set_player_listitem_values ( playerid, count, p ) ;
		count ++ ;

		format ( global_string, sizeof ( global_string ), "%s{"#cBL"}%i. {"#cWH"}Подъезд №%d\n", global_string, p + 1, podezd_info [ p ] [ p_id ] ) ;
	}

	if ( page > 0 ) strcat ( global_string, "{"#cBL"}Предыдущая страница\n" ) ;
	if ( podezd_count > ( page + 1 ) * 20 ) strcat ( global_string, "{"#cBL"}Следующая страница" ) ;

	show_dialog ( playerid, d_gotopadik, DIALOG_STYLE_LIST, "{"#cBHD"}Подъезды", global_string, "Выбрать", "Закрыть" ) ;
    return true ;
}

CMD:gotocellar ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 3 )return 1 ;
    if ( sscanf ( params, "d", params [ 0 ] ) ) SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /gotocellar [ид]" ) ;

    if ( params [ 0 ] > 0 )
    {
		if ( params [ 0 ] < 1 || params [ 0 ] > cellar_count ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Гараж не найден." ) ;
		set_pos ( playerid, cellar_info [ params [ 0 ] - 1 ] [ cl_pos ] [ 0 ], cellar_info [ params [ 0 ] - 1 ] [ cl_pos ] [ 1 ], cellar_info [ params [ 0 ] - 1 ] [ cl_pos ] [ 2 ], 90, 0, 0 ) ;
		new scm_string [ 82 ] ;
		format ( scm_string, sizeof ( scm_string  ),"{"#cBAdmin"}[A] {"#cGRAdmin"}Вы телепортировались к гаражу | ID: %d", params [ 0 ] ) ;
		SendClientMessage ( playerid, col_admin, scm_string ) ;
		return 1 ;
	}

    page_count [ playerid ] = 1 ;
	new rows_list = page_count [ playerid ] - 1 ;
	page_rows [ playerid ] = cellar_count ;

	global_string [ 0 ] = EOS ;
	new line_string [ 128 ], row_count ;
	for ( new b = rows_list * 10 ; b < rows_list * 10 + 10 ; b ++ )
	{
	    if ( b >= cellar_count ) break ;

		set_player_listitem_values ( playerid, b - rows_list * 10, b ) ;

		format ( line_string, sizeof ( line_string ), "{"#cBL"}%i. {"#cWH"}%s\n", b + 1, cellar_info [ b ] [ cl_owner_name ] ) ;
		strcat ( global_string, line_string ) ;

		row_count ++ ;
	}

	cellarsList ( playerid, 0 ) ;
	return 1 ;
}

stock cellarsList ( playerid, page )
{
	page_count [ playerid ] = page ;

	new count = 0 ;

	global_string [ 0 ] = EOS ;
  	for ( new c = 0 ; c < cellar_count ; c ++ )
	{
		if ( page * 20 > c ) continue ;
  		if ( c > ( page + 1 ) * 20 ) break ;

  		set_player_listitem_values ( playerid, count, c ) ;
		count ++ ;

		format ( global_string, sizeof ( global_string ), "%s{"#cBL"}%i. {"#cWH"}%s\n", global_string, c + 1, cellar_info [ c ] [ cl_owner_name ] ) ;
	}

	if ( page > 0 ) strcat ( global_string, "{"#cBL"}Предыдущая страница\n" ) ;
	if ( cellar_count > ( page + 1 ) * 20 ) strcat ( global_string, "{"#cBL"}Следующая страница" ) ;

	show_dialog ( playerid, d_gotocellar, DIALOG_STYLE_LIST, "{"#cBHD"}Гаражи", global_string, "Выбрать", "Закрыть" ) ;
    return true ;
}

CMD:gotobiz ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 3 ) return 1 ;
    if ( sscanf ( params, "d", params [ 0 ] ) ) SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /gotobiz [ид]" ) ;

    if ( params [ 0 ] > 0 )
    {
		if ( params [ 0 ] < 1 || params [ 0 ] > b_count ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Бизнес не найден." ) ;

		page_count [ playerid ] = 0 ;
		set_player_use_listitem ( playerid, params [ 0 ] - 1 ) ;

        new line_string [ 64 ], bizz_id = get_player_use_listitem ( playerid ) ;
        format ( line_string, sizeof line_string, "{"#cBHD"}%s", b_info [ bizz_id ] [ b_name ] ) ;

        global_string [ 0 ] = EOS ;
		format ( global_string, 750, "{"#cBL"}1. {"#cWH"}Телепортироваться\n{"#cBL"}2. {"#cWH"}Изменить продукты\n{"#cBL"}3. {"#cWH"}Изменить контроль\n{"#cBL"}4. {"#cWH"}Изменить сумму на счете\n{"#cBL"}5. {"#cWH"}Статистика бизнеса\n{"#cBL"}6. {"#cWH"}Продать государству\n{"#cBL"}7. {"#cWH"}Доходы\n{"#cBL"}8. {"#cWH"}Переместить\n{"#cBL"}9. {"#cWH"}Название\n \n{"#cGRDialog"}- Контроль: {"#cWH"}%s\n{"#cGRDialog"}- Заработано за сегодня: {"#cWH"}%d"valute_title_"\n{"#cGRDialog"}- Осталось {"#cGN"}%d{"#cGRDialog"} дн. до конца заморозки",
		f_info [ b_info [ bizz_id ] [ b_mafia ] - 1 ] [ f_name ], b_info [ bizz_id ] [ b_cash_today ], b_info [ bizz_id ] [ b_freeze ] ) ;

        show_dialog ( playerid, d_gotobiz_select, DIALOG_STYLE_LIST, line_string, global_string, "Выбрать", "Закрыть" ) ;
		return 1 ;
	}

    businessList ( playerid, 0 ) ;
	return 1 ;
}

stock businessList ( playerid, page )
{
	page_count [ playerid ] = page ;

	new count = 0 ;

	global_string [ 0 ] = EOS ;
	strcat ( global_string, "{"#cBL"}ID:\t{"#cBL"}Продуктов:\t{"#cBL"}Тип бизнеса:\t{"#cBL"}Владелец:\n") ;
  	for ( new b = 0 ; b < b_count ; b ++ )
	{
		if ( page * 20 > b ) continue ;
  		if ( b > ( page + 1 ) * 20 ) break ;

  		set_player_listitem_values ( playerid, count, b ) ;
		count ++ ;

		format ( global_string, sizeof ( global_string ), "%s{"#cBL"}%i.{"#cWH"}\t%d\t%s\t%s\n", global_string, b + 1, b_info [ b ] [ b_product ], b_types [ b_info [ b ] [ b_type ] ], b_info [ b ] [ b_owner_name ] ) ;
	}

	if ( page > 0 ) strcat ( global_string, "{"#cBL"}Предыдущая страница\n" ) ;
	if ( b_count > ( page + 1 ) * 20 ) strcat ( global_string, "{"#cBL"}Следующая страница" ) ;

	show_dialog ( playerid, d_gotobiz, DIALOG_STYLE_TABLIST_HEADERS, "{"#cBHD"}Бизнесы", global_string, "Выбрать", "Закрыть" ) ;
    return true ;
}

CMD:marea ( playerid, params [ ] )
{
    if ( admin_info [ playerid ] [ admin ] < 8 )return 1 ;
    if ( ! IsFounder ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}К сожалению, Вам данная функция не доступна." ) ;

	if ( sscanf ( params, "d", params [ 0 ] ) ) return areaTeleportList ( playerid, 0 ) ;

	page_count [ playerid ] = 1 ;
	SetPVarInt ( playerid, "a_id_select", params [ 0 ] - 1 ) ;

	new line_string [ 64 ] ;
 	format ( line_string, sizeof line_string, "{"#cBHD"}%s", area_tp_info [ GetPVarInt ( playerid, "a_id_select" ) ] [ a_name ] ) ;

	global_string [ 0 ] = EOS ;
	format ( global_string, 750, "{"#cBL"}1. {"#cWH"}Телепортироваться\n{"#cBL"}2. {"#cWH"}Изменить первую позицию\n{"#cBL"}3. {"#cWH"}Изменить вторую позицию\n{"#cBL"}4. {"#cWH"}Виртуальный мир (№1): %d\n{"#cBL"}5. {"#cWH"}Интерьер (№1): %d\n{"#cBL"}6. {"#cWH"}Виртуальный мир (№2): %d\n{"#cBL"}7. {"#cWH"}Интерьер (№2): %d\n{"#cBL"}8. {"#cWH"}Название\n{"#cRD"}Удалить",
	area_tp_info [ GetPVarInt ( playerid, "a_id_select" ) ] [ a_virt_world ] [ 0 ], area_tp_info [ GetPVarInt ( playerid, "a_id_select" ) ] [ a_interior ] [ 0 ],
	area_tp_info [ GetPVarInt ( playerid, "a_id_select" ) ] [ a_virt_world ] [ 1 ], area_tp_info [ GetPVarInt ( playerid, "a_id_select" ) ] [ a_interior ] [ 1 ] ) ;

	show_dialog ( playerid, d_marea_select, DIALOG_STYLE_LIST, line_string, global_string, "Выбрать", "Закрыть" ) ;
	return 1 ;
}

stock areaTeleportList ( playerid, page )
{
	page_count [ playerid ] = page ;

	new count = 0 ;

	global_string [ 0 ] = EOS ;
	strcat ( global_string, "{"#cBL"}№. Название:\t{"#cBL"}Второй пикап:\n") ;
  	for ( new a = 0 ; a < area_tp_amount ; a ++ )
	{
		if ( page * 20 > a ) continue ;
  		if ( a > ( page + 1 ) * 20 ) break ;

  		set_player_listitem_values ( playerid, count, a ) ;
		count ++ ;

		format ( global_string, sizeof ( global_string ), "%s{"#cBL"}%i. {"#cWH"}%s\t%s\n", global_string, a + 1, area_tp_info [ a ] [ a_name ], ( area_tp_info [ a ] [ a_to_pos ] [ 0 ] != 0 ) ? ( "{"#cGN"}Есть" ) : ( "{"#cRD"}Нет" ) ) ;
	}

	if ( page > 0 ) strcat ( global_string, "{"#cBL"}Предыдущая страница\n" ) ;
	if ( area_tp_amount > ( page + 1 ) * 20 ) strcat ( global_string, "{"#cBL"}Следующая страница" ) ;

	show_dialog ( playerid, d_marea, DIALOG_STYLE_TABLIST_HEADERS, "{"#cBHD"}Телепорты", global_string, "Выбрать", "Закрыть" ) ;
    return true ;
}

CMD:gotohouse ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 3 )return 1 ;
	if ( sscanf ( params, "d", params [ 0 ] ) ) SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /gotohouse [ид]" ) ;

    if ( params [ 0 ] > 0 )
    {
		if ( params [ 0 ] < 1 || params [ 0 ] > house_count ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Дом не найден." ) ;

		set_player_use_listitem ( playerid, params [ 0 ] - 1 ) ;

		global_string [ 0 ] = EOS ;
		new house_id = get_player_use_listitem ( playerid ) ;
		format ( global_string, 750, "{"#cBL"}1. {"#cWH"}Телепортироваться\n{"#cBL"}2. {"#cWH"}Изменить сумму на счете\n{"#cBL"}3. {"#cWH"}Статистика\n{"#cBL"}4. {"#cWH"}Продать государству\n{"#cBL"}5. {"#cWH"}Переместить\n{"#cBL"}6. {"#cWH"}Изменить класс\n \n{"#cGRDialog"}- Владелец: {"#cWH"}%s\n{"#cGRDialog"}- В сейфе: {"#cWH"}%d"valute_title_"\n{"#cGRDialog"}- Осталось {"#cGN"}%d{"#cGRDialog"} дн. до конца заморозки",
		h_info [ house_id ] [ h_owner_name ], h_info [ house_id ] [ h_safe_data ] [ 1 ], h_info [ house_id ] [ h_freeze ] ) ;

        new line_string [ 64 ] ;
        format ( line_string, sizeof line_string, "{"#cBHD"}Дом №%d", h_info [ house_id ] [ h_id ] ) ;
        show_dialog(playerid, d_gotohouse_select, DIALOG_STYLE_LIST, line_string, global_string, "Выбрать", "Закрыть" ) ;
		return 1 ;
	}

	housesList ( playerid, 0 ) ;
	return 1 ;
}

stock housesList ( playerid, page )
{
	page_count [ playerid ] = page ;

	new count = 0 ;

	global_string [ 0 ] = EOS ;
	strcat ( global_string, "{"#cBL"}№. Владелец:\t{"#cBL"}Класс:\n" ) ;
  	for ( new h = 0 ; h < house_count ; h ++ )
	{
		if ( page * 20 > h ) continue ;
  		if ( h > ( page + 1 ) * 20 ) break ;

  		set_player_listitem_values ( playerid, count, h ) ;
		count ++ ;

		format ( global_string, sizeof ( global_string ), "%s{"#cBL"}%i. {"#cWH"}%s\t%s\n", global_string, h + 1, h_info [ h ] [ h_owner_name ], house_classes [ house_int [ h_info [ h ] [ h_int ] - 1 ] [ hint_class ] ] ) ;
	}

	if ( page > 0 ) strcat ( global_string, "{"#cBL"}Предыдущая страница\n" ) ;
	if ( house_count > ( page + 1 ) * 20 ) strcat ( global_string, "{"#cBL"}Следующая страница" ) ;

	show_dialog ( playerid, d_gotohouse, DIALOG_STYLE_LIST, "{"#cBHD"}Дома", global_string, "Выбрать", "Закрыть" ) ;
    return true ;
}

CMD:gethere ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 2 )return 1 ;
	if ( sscanf ( params, "u", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /gethere [ид]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( report_tp [ params [ 0 ] ] < gettime ( ) && admin_info [ playerid ] [ admin ] < 6 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Телепортировать игрока можно только в течении 3ёх минут после подачи репорта." ) ;

	new Float: pl_pos [ 3 ] ;
	GetPlayerPos ( playerid, pl_pos [ 0 ], pl_pos [ 1 ], pl_pos [ 2 ] ) ;
	pl_pos [ 0 ] += 2.0 ;

	if ( GetPlayerState( params [ 0 ] ) != 2 ) set_pos ( params [ 0 ], pl_pos [ 0 ], pl_pos [ 1 ], pl_pos [ 2 ], 90, GetPlayerInterior ( playerid  ), GetPlayerVirtualWorld ( playerid ) ) ;
	else return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок находится в транспорте." ) ;

	sp_timer [ playerid ] = 0 ;

	if ( GetPVarInt ( params [ 0 ], "house_id" ) > 0 )
	{
	    clear_check_info ( params [ 0 ], CINFO_HOUSE_HMENU_ID_1 ) ;
	    clear_check_info ( params [ 0 ], CINFO_HOUSE_HMENU_ID_2 ) ;
	    clear_check_info ( params [ 0 ], CINFO_HOUSE_HMENU_ID_3 ) ;
	}

	if ( GetPVarInt ( params [ 0 ], "cellar_id" ) > 0 ) clear_check_info ( params [ 0 ], CINFO_CELLAR_MENU_ID ) ;

	new scm_string [ 128 ] ;
	format ( scm_string, sizeof ( scm_string  ),"Администратор %s[%d] телепортировал Вас к себе.", p_info [ playerid ] [ name ], playerid ) ;
	SendClientMessage ( params [ 0 ], col_gray, scm_string ) ;
	format ( scm_string, sizeof ( scm_string  ),"{"#cBAdmin"}[A] {"#cGRAdmin"}%s[%d] телепортировал к себе %s[%d]", p_info [ playerid ] [ name ], playerid, p_info [ params [ 0 ] ] [ name ], params [ 0 ] ) ;
	foreach(new i: admin_players)SendClientMessage ( i, col_admin, scm_string ) ;
	return true ;
}

CMD:agun ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 6 )return 1 ;
	if (sscanf ( params, "udd", params [ 0 ], params [ 1 ], params [ 2 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /agun [ид] [оружие] [патроны]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;

	static const _verifity_gun [ ] =
	{
	    5,
	    6,
	    24,
	    25,
	    29,
	    30,
	    31,
	    33,
	    34,
	    41
	} ;

	new bool: _checking_gun = false ;
	for ( new i = 0 ; i < sizeof _verifity_gun ; i ++ )
	{
		if ( params [ 1 ] != _verifity_gun [ i ] ) continue ;

		_checking_gun = true ;
		break ;
	}
	if ( _checking_gun == false ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Не правильно указан ID оружия." ) ;
	give_weapon ( params [ 0 ], params [ 1 ], params [ 2 ] ) ;

	new scm_string [ 128 ] ;
	format ( scm_string, sizeof ( scm_string  ),"Администратор %s[%i] выдал Вам оружие #%i.", p_info [ playerid ] [ name ], playerid, params [ 1 ] ) ;
	SendClientMessage ( params [ 0 ], col_gray, scm_string ) ;
	format ( scm_string, sizeof ( scm_string  ),"{"#cBAdmin"}[A] {"#cGRAdmin"}%s[%d] выдал оружие %d игроку %s[%d].", p_info [ playerid ] [ name ], playerid, params [ 1 ], p_info [ params [ 0 ] ] [ name ], params [ 0 ] ) ;
	foreach(new i: admin_players)SendClientMessage ( i, col_admin, scm_string ) ;
	return 1 ;
}

CMD:gun ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 5 )return 1 ;
	if ( sscanf ( params, "dd", params [ 0 ], params [ 1 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /gun [оружие] [патроны]" ) ;

	static const _verifity_gun [ ] =
	{
	    5,
	    6,
	    24,
	    25,
	    29,
	    30,
	    31,
	    33,
	    34,
	    41
	} ;

	new bool: _checking_gun = false ;
	for ( new i = 0 ; i < sizeof _verifity_gun ; i ++ )
	{
		if ( params [ 0 ] != _verifity_gun [ i ] ) continue ;

		_checking_gun = true ;
		break ;
	}
	if ( _checking_gun == false ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Не правильно указан ID оружия." ) ;
	give_weapon ( playerid, params [ 0 ], params [ 1 ] ) ;

	static const _str [ ] = "{"#cBAdmin"}[A] {"#cGRAdmin"}%s[%d] выдал себе оружие #%d." ;
	new scm_string [ sizeof _str + 24 + 4 + 4 ] ;
	format ( scm_string, sizeof ( scm_string  ), _str, p_info [ playerid ] [ name ], playerid, params [ 0 ] ) ;
	foreach(new i: admin_players)SendClientMessage ( i, col_admin, scm_string ) ;
	return 1 ;
