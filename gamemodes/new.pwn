		PlayerTextDrawUseBox(playerid, capture_ptd[playerid][1], 1);
		PlayerTextDrawBoxColor(playerid, capture_ptd[playerid][1], color_box);
		PlayerTextDrawBackgroundColor(playerid, capture_ptd[playerid][1], 255);
		PlayerTextDrawFont(playerid, capture_ptd[playerid][1], 1);
		PlayerTextDrawSetProportional(playerid, capture_ptd[playerid][1], 1);
		PlayerTextDrawSetShadow(playerid, capture_ptd[playerid][1], 0);

		capture_ptd[playerid][2] = CreatePlayerTextDraw(playerid, 102.3333, 226.9185, "East_Side_Ballas"); // 1 Box ( Right Gang )
		PlayerTextDrawLetterSize(playerid, capture_ptd[playerid][2], 0.1748, 0.7578);
		PlayerTextDrawTextSize(playerid, capture_ptd[playerid][2], 0.0000, 38.0000);
		PlayerTextDrawAlignment(playerid, capture_ptd[playerid][2], 2);
		PlayerTextDrawColor(playerid, capture_ptd[playerid][2], -1061109505);
		PlayerTextDrawUseBox(playerid, capture_ptd[playerid][2], 1);
		PlayerTextDrawBoxColor(playerid, capture_ptd[playerid][2], color_box);
		PlayerTextDrawBackgroundColor(playerid, capture_ptd[playerid][2], 255);
		PlayerTextDrawFont(playerid, capture_ptd[playerid][2], 1);
		PlayerTextDrawSetProportional(playerid, capture_ptd[playerid][2], 1);
		PlayerTextDrawSetShadow(playerid, capture_ptd[playerid][2], 0);

		capture_ptd[playerid][3] = CreatePlayerTextDraw(playerid, 27.4342, 245.1704, "100"); // 1 Box ( Left Gang )
		PlayerTextDrawLetterSize(playerid, capture_ptd[playerid][3], 0.1748, 0.7578);
		PlayerTextDrawTextSize(playerid, capture_ptd[playerid][3], 0.0000, 14.0000);
		PlayerTextDrawAlignment(playerid, capture_ptd[playerid][3], 2);
		PlayerTextDrawColor(playerid, capture_ptd[playerid][3], -1);
		PlayerTextDrawUseBox(playerid, capture_ptd[playerid][3], 1);
		PlayerTextDrawBoxColor(playerid, capture_ptd[playerid][3], color_textdraw);
		PlayerTextDrawBackgroundColor(playerid, capture_ptd[playerid][3], 255);
		PlayerTextDrawFont(playerid, capture_ptd[playerid][3], 1);
		PlayerTextDrawSetProportional(playerid, capture_ptd[playerid][3], 1);
		PlayerTextDrawSetShadow(playerid, capture_ptd[playerid][3], 0);

		capture_ptd[playerid][4] = CreatePlayerTextDraw(playerid, 114.6675, 245.2704, "100"); // 1 Box ( Right Gang )
		PlayerTextDrawLetterSize(playerid, capture_ptd[playerid][4], 0.1748, 0.7578);
		PlayerTextDrawTextSize(playerid, capture_ptd[playerid][4], 0.0000, 14.0000);
		PlayerTextDrawAlignment(playerid, capture_ptd[playerid][4], 2);
		PlayerTextDrawColor(playerid, capture_ptd[playerid][4], -1);
		PlayerTextDrawUseBox(playerid, capture_ptd[playerid][4], 1);
		PlayerTextDrawBoxColor(playerid, capture_ptd[playerid][4], color_textdraw);
		PlayerTextDrawBackgroundColor(playerid, capture_ptd[playerid][4], 255);
		PlayerTextDrawFont(playerid, capture_ptd[playerid][4], 1);
		PlayerTextDrawSetProportional(playerid, capture_ptd[playerid][4], 1);
		PlayerTextDrawSetShadow(playerid, capture_ptd[playerid][4], 0);

		new _string [ 64 ] ;
		PlayerTextDrawSetString ( playerid, capture_ptd [ playerid ] [ 0 ], "TIME:_07:00" ) ;

		format ( _string, sizeof _string, "%s", f_info [ gz_info [ gz_captured ] [ gz_owner ] - 1 ] [ f_name ] ) ;
		PlayerTextDrawSetString ( playerid, capture_ptd [ playerid ] [ 1 ], _string ) ;

		format ( _string, sizeof _string, "%s", f_info [ gz_info [ gz_captured ] [ gz_attacker ] - 1 ] [ f_name ] ) ;
		PlayerTextDrawSetString ( playerid, capture_ptd [ playerid ] [ 2 ], _string ) ;

		format ( _string, sizeof _string, "%d", owner_points ) ;
		PlayerTextDrawSetString ( playerid, capture_ptd [ playerid ] [ 3 ], _string ) ;

		format ( _string, sizeof _string, "%d", attacker_points ) ;
		PlayerTextDrawSetString ( playerid, capture_ptd [ playerid ] [ 4 ], _string ) ;

		if ( p_info [ playerid ] [ capture_status ] > 1 )
		{
   			capture_ptd[playerid][5] = CreatePlayerTextDraw(playerid, 30.1009, 276.4188, "K:_0"); // 2 Box ( Kills )
			PlayerTextDrawLetterSize(playerid, capture_ptd[playerid][5], 0.1748, 0.7578);
			PlayerTextDrawTextSize(playerid, capture_ptd[playerid][5], 0.0000, 20.0000);
			PlayerTextDrawAlignment(playerid, capture_ptd[playerid][5], 2);
			PlayerTextDrawColor(playerid, capture_ptd[playerid][5], -1);
			PlayerTextDrawUseBox(playerid, capture_ptd[playerid][5], 1);
			PlayerTextDrawBoxColor(playerid, capture_ptd[playerid][5], color_textdraw);
			PlayerTextDrawBackgroundColor(playerid, capture_ptd[playerid][5], 255);
			PlayerTextDrawFont(playerid, capture_ptd[playerid][5], 1);
			PlayerTextDrawSetProportional(playerid, capture_ptd[playerid][5], 1);
			PlayerTextDrawSetShadow(playerid, capture_ptd[playerid][5], 0);

			capture_ptd[playerid][6] = CreatePlayerTextDraw(playerid, 111.4676, 276.4188, "D:_0"); // 2 Box ( Damage )
			PlayerTextDrawLetterSize(playerid, capture_ptd[playerid][6], 0.1748, 0.7578);
			PlayerTextDrawTextSize(playerid, capture_ptd[playerid][6], 0.0000, 20.0000);
			PlayerTextDrawAlignment(playerid, capture_ptd[playerid][6], 2);
			PlayerTextDrawColor(playerid, capture_ptd[playerid][6], -1);
			PlayerTextDrawUseBox(playerid, capture_ptd[playerid][6], 1);
			PlayerTextDrawBoxColor(playerid, capture_ptd[playerid][6], color_textdraw);
			PlayerTextDrawBackgroundColor(playerid, capture_ptd[playerid][6], 255);
			PlayerTextDrawFont(playerid, capture_ptd[playerid][6], 1);
			PlayerTextDrawSetProportional(playerid, capture_ptd[playerid][6], 1);
			PlayerTextDrawSetShadow(playerid, capture_ptd[playerid][6], 0);

			capture_ptd[playerid][7] = CreatePlayerTextDraw(playerid, 71.0336, 276.5723, "K/D:_0.00"); // 2 Box ( K/D Ratio )
			PlayerTextDrawLetterSize(playerid, capture_ptd[playerid][7], 0.1748, 0.7578);
			PlayerTextDrawTextSize(playerid, capture_ptd[playerid][7], 0.0000, 14.0000);
			PlayerTextDrawAlignment(playerid, capture_ptd[playerid][7], 2);
			PlayerTextDrawColor(playerid, capture_ptd[playerid][7], -1);
			PlayerTextDrawBackgroundColor(playerid, capture_ptd[playerid][7], 255);
			PlayerTextDrawFont(playerid, capture_ptd[playerid][7], 1);
			PlayerTextDrawSetProportional(playerid, capture_ptd[playerid][7], 1);
			PlayerTextDrawSetShadow(playerid, capture_ptd[playerid][7], 0);

			format ( _string, sizeof _string, "%d", p_info [ playerid ] [ capture_kills ] ) ;
			PlayerTextDrawSetString ( playerid, capture_ptd [ playerid ] [ 5 ], _string ) ;

			format ( _string, sizeof _string, "%.2f", p_info [ playerid ] [ capture_damage ] ) ;
			PlayerTextDrawSetString ( playerid, capture_ptd [ playerid ] [ 6 ], _string ) ;

			if ( ! p_info [ playerid ] [ capture_kills ] || ! p_info [ playerid ] [ capture_death ] ) format ( _string, sizeof _string, "K/D:_0.00" ) ;
			else format ( _string, sizeof _string, "K/D:_%.2f", floatdiv ( p_info [ playerid ] [ capture_kills ], p_info [ playerid ] [ capture_death ] ) ) ;
			PlayerTextDrawSetString ( playerid, capture_ptd [ playerid ] [ 7 ], _string ) ;
		}

        if ( p_info [ playerid ] [ capture_status ] > 2 )
		{
   			capture_ptd[playerid][8] = CreatePlayerTextDraw(playerid, 15.8332, 308.2572, "PLAYER_1"); // 3 Box ( Left Player )
			PlayerTextDrawLetterSize(playerid, capture_ptd[playerid][8], 0.1636, 0.7869);
			PlayerTextDrawAlignment(playerid, capture_ptd[playerid][8], 1);
			PlayerTextDrawColor(playerid, capture_ptd[playerid][8], -1061109505);
			PlayerTextDrawBackgroundColor(playerid, capture_ptd[playerid][8], 49);
			PlayerTextDrawFont(playerid, capture_ptd[playerid][8], 1);
			PlayerTextDrawSetProportional(playerid, capture_ptd[playerid][8], 1);
			PlayerTextDrawSetShadow(playerid, capture_ptd[playerid][8], 1);

			capture_ptd[playerid][9] = CreatePlayerTextDraw(playerid, 127.0330, 308.2573, "PLAYER_2"); // 3 Box ( Right Player )
			PlayerTextDrawLetterSize(playerid, capture_ptd[playerid][9], 0.1636, 0.7869);
			PlayerTextDrawAlignment(playerid, capture_ptd[playerid][9], 3);
			PlayerTextDrawColor(playerid, capture_ptd[playerid][9], -1061109505);
			PlayerTextDrawBackgroundColor(playerid, capture_ptd[playerid][9], 49);
			PlayerTextDrawFont(playerid, capture_ptd[playerid][9], 1);
			PlayerTextDrawSetProportional(playerid, capture_ptd[playerid][9], 1);
			PlayerTextDrawSetShadow(playerid, capture_ptd[playerid][9], 1);

			format ( _string, sizeof _string, "%s", capture_kills_first_name ) ;
			PlayerTextDrawSetString ( playerid, capture_ptd [ playerid ] [ 8 ], _string ) ;

			format ( _string, sizeof _string, "%s", capture_kills_two_name ) ;
			PlayerTextDrawSetString ( playerid, capture_ptd [ playerid ] [ 9 ], _string ) ;
		}

		for ( new i = 0 ; i < 38 ; i ++ )
		{
		    if ( p_info [ playerid ] [ capture_status ] == 2 )
		    {
		        if ( i < 32 ) TextDrawShowForPlayer ( playerid, capture_td [ i ] ) ;
		        if ( i < 8 ) PlayerTextDrawShow ( playerid, capture_ptd [ playerid ] [ i ] ) ;
		    }
		    else if ( p_info [ playerid ] [ capture_status ] == 3 )
		    {
		        TextDrawShowForPlayer ( playerid, capture_td [ i ] ) ;
		        if ( i < 10 ) PlayerTextDrawShow ( playerid, capture_ptd [ playerid ] [ i ] ) ;
		    }
		    else
		    {
		        if ( i < 26 ) TextDrawShowForPlayer ( playerid, capture_td [ i ] ) ;
		        if ( i < 5 ) PlayerTextDrawShow ( playerid, capture_ptd [ playerid ] [ i ] ) ;
		    }
		}
	}
	else
	{
	    for ( new i = 0 ; i < 38 ; i ++ )
		{
		    if ( p_info [ playerid ] [ capture_status ] == 2 )
		    {
		        if ( i < 32 ) TextDrawHideForPlayer ( playerid, capture_td [ i ] ) ;
		        if ( i < 8 )
			    {
					PlayerTextDrawDestroy ( playerid, capture_ptd [ playerid ] [ i ] ) ;
					capture_ptd [ playerid ] [ i ] = PlayerText:-1;
				}
		    }
		    else if ( p_info [ playerid ] [ capture_status ] == 3 )
		    {
		        TextDrawHideForPlayer ( playerid, capture_td [ i ] ) ;
		        if ( i < 10 )
			    {
					PlayerTextDrawDestroy ( playerid, capture_ptd [ playerid ] [ i ] ) ;
					capture_ptd [ playerid ] [ i ] = PlayerText:-1;
				}
		    }
		    else
		    {
		        if ( i < 26 ) TextDrawHideForPlayer ( playerid, capture_td [ i ] ) ;
		        if ( i < 5 )
			    {
					PlayerTextDrawDestroy ( playerid, capture_ptd [ playerid ] [ i ] ) ;
					capture_ptd [ playerid ] [ i ] = PlayerText:-1;
				}
		    }
		}
	}
	return 1 ;
}

callback: gangzone_timer ( gz_tid, gz_attacker_team, gz_owner_team, capture_type )
{
	new td_string [ 24 ] ;
	format ( td_string, sizeof ( td_string ), "%s", convert_time ( gz_info [ gz_tid ] [ gz_time ], TYPE_TIME_SECOND ) ) ;
	foreach(new pl_id: logged_players)
	{
		if ( ! gang_player ( pl_id ) && ! admin_info [ pl_id ] [ admin_settings ] [ 0 ] && gz_td_status_bool [ pl_id ] == true )
		{
			gz_td_status ( pl_id, false ) ;
			gz_td_status_bool [ pl_id ] = false ;
			for ( new j = 0 ; j < 5 ; j ++ ) SendDeathMessageToPlayer ( pl_id, 1001, 1001, 200 ) ;
		}
		else if ( ( gang_player ( pl_id ) || admin_info [ pl_id ] [ admin_settings ] [ 0 ] ) && gz_td_status_bool [ pl_id ] == false )
		{
		    p_info [ pl_id ] [ capture_kills ] =
			p_info [ pl_id ] [ capture_death ] = 0 ;
    		p_info [ pl_id ] [ capture_damage ] = 0.0 ;

			gz_td_status ( pl_id, true ) ;
			GangZoneFlashForPlayer ( pl_id, gz_info [ gz_tid ] [ gz_created ], f_info [ gz_attacker_team - 1 ] [ f_gangzone_color ] ) ;
			gz_td_status_bool [ pl_id ] = true ;
		}

		if ( ( gang_player ( pl_id ) || admin_info [ pl_id ] [ admin_settings ] [ 0 ] ) && gz_td_status_bool [ pl_id ] == true )
		{
		    if ( gz_info [ gz_tid ] [ gz_time ] >= 1 )
			{
				PlayerTextDrawSetString ( pl_id, capture_ptd [ pl_id ] [ 0 ], td_string ) ;

				if ( p_info [ pl_id ] [ masked ] > 0 )
				{
					p_info [ pl_id ] [ masked ] = 0 ;
					fraction_color ( pl_id ) ;

					if ( p_info [ pl_id ] [ mask_status ] == 0 ) RemovePlayerAttachedObject ( pl_id, 3 ) ;
				}
			}
		}
	}
	if ( gz_info [ gz_tid ] [ gz_time ] > 1 ) gz_info [ gz_tid ] [ gz_time ] -- ;
	else if ( gz_info [ gz_tid ] [ gz_time ] == 1 )
	{
	    if ( owner_points < 1 && attacker_points < 1 )
		{
		    new _count_attacker = 0 ;
			foreach(new q: fraction_players[gz_info [ gz_tid ] [ gz_attacker ]])
			{
				if ( IsPlayerInGangZone ( q, gz_captured ) ) _count_attacker ++ ;
			}

			new _count_defender = 0 ;
			foreach(new q: family_players[gz_info [ gz_tid ] [ gz_owner ]])
			{
				if ( IsPlayerInGangZone ( q, gz_captured ) ) _count_defender ++ ;
			}

			if ( _count_defender >= _count_attacker )
			{
				new _string [ 128 ] ;
				format ( _string, sizeof ( _string ), "[U] '%s' отстояла свою территорию.",
				f_info [ gz_info [ gz_tid ] [ gz_owner ] - 1 ] [ f_name ] ) ;
				SendGangMessage ( col_light_red, _string ) ;

				format ( _string, sizeof ( _string ), "{"#cBAdmin"}[A]{"#cGRAdmin"} %s отстояла свою территорию против %s. Счёт: %d:%d",
				f_info [ gz_info [ gz_tid ] [ gz_owner ] - 1 ] [ f_name ],
				f_info [ gz_info [ gz_tid ] [ gz_attacker ] - 1 ] [ f_name ],
				owner_points, attacker_points ) ;
				foreach(new j: admin_players) SendClientMessage ( j, col_admin, _string ) ;

				mysql_tquery ( sql_connection, !"SELECT `f_org`, `f_to_org` FROM `f_wars`", "Wars_Info", "iiiii", gz_info [ gz_tid ] [ gz_attacker ], gz_info [ gz_tid ] [ gz_owner ], attacker_points, owner_points, 0 ) ;
			}
			else
			{
				new _string [ 128 ] ;
				format ( _string, sizeof ( _string ), "[U] '%s' захватила территорию у '%s'.",
				f_info [ gz_info [ gz_tid ] [ gz_attacker ] - 1 ] [ f_name ],
				f_info [ gz_info [ gz_tid ] [ gz_owner ] - 1 ] [ f_name ] ) ;
				SendGangMessage ( col_light_red, _string ) ;

				format ( _string, sizeof ( _string ), "{"#cBAdmin"}[A]{"#cGRAdmin"} %s захватила территорию у %s. Счёт: %d:%d",
				f_info [ gz_info [ gz_tid ] [ gz_attacker ] - 1 ] [ f_name ],
				f_info [ gz_info [ gz_tid ] [ gz_owner ] - 1 ] [ f_name ],
				attacker_points, owner_points ) ;
				foreach(new j: admin_players) SendClientMessage ( j, col_admin, _string ) ;

				mysql_tquery ( sql_connection, !"SELECT `f_org`, `f_to_org` FROM `f_wars`", "Wars_Info", "iiiii", gz_info [ gz_tid ] [ gz_attacker ], gz_info [ gz_tid ] [ gz_owner ], attacker_points, owner_points, 1 ) ;

				gz_info [ gz_tid ] [ gz_owner ] = gz_info [ gz_tid ] [ gz_attacker ] ;
			}
		}
		else if ( owner_points >= attacker_points ) // победа хозяев
		{
			new _string [ 128 ] ;
			format ( _string, sizeof ( _string ), "[U] '%s' отстояла свою территорию.",
			f_info [ gz_info [ gz_tid ] [ gz_owner ] - 1 ] [ f_name ] ) ;
			SendGangMessage ( col_light_red, _string ) ;

			format ( _string, sizeof ( _string ), "{"#cBAdmin"}[A]{"#cGRAdmin"} %s отстояла свою территорию против %s. Счёт: %d:%d",
			f_info [ gz_info [ gz_tid ] [ gz_owner ] - 1 ] [ f_name ],
			f_info [ gz_info [ gz_tid ] [ gz_attacker ] - 1 ] [ f_name ],
			owner_points, attacker_points ) ;
			foreach(new j: admin_players) SendClientMessage ( j, col_admin, _string ) ;

			mysql_tquery ( sql_connection, !"SELECT `f_org`, `f_to_org` FROM `f_wars`", "Wars_Info", "iiiii", gz_info [ gz_tid ] [ gz_attacker ], gz_info [ gz_tid ] [ gz_owner ], attacker_points, owner_points, 0 ) ;
		}
		else if ( owner_points < attacker_points ) // победа атаки
		{
			new _string [ 128 ] ;
			format ( _string, sizeof ( _string ), "[U] '%s' захватила территорию у '%s'.",
			f_info [ gz_info [ gz_tid ] [ gz_attacker ] - 1 ] [ f_name ],
			f_info [ gz_info [ gz_tid ] [ gz_owner ] - 1 ] [ f_name ] ) ;
			SendGangMessage ( col_light_red, _string ) ;

			format ( _string, sizeof ( _string ), "{"#cBAdmin"}[A]{"#cGRAdmin"} %s захватила территорию у %s. Счёт: %d:%d",
			f_info [ gz_info [ gz_tid ] [ gz_attacker ] - 1 ] [ f_name ],
			f_info [ gz_info [ gz_tid ] [ gz_owner ] - 1 ] [ f_name ],
			attacker_points, owner_points ) ;
			foreach(new j: admin_players) SendClientMessage ( j, col_admin, _string ) ;

			mysql_tquery ( sql_connection, !"SELECT `f_org`, `f_to_org` FROM `f_wars`", "Wars_Info", "iiiii", gz_info [ gz_tid ] [ gz_attacker ], gz_info [ gz_tid ] [ gz_owner ], attacker_points, owner_points, 1 ) ;

			gz_info [ gz_tid ] [ gz_owner ] = gz_info [ gz_tid ] [ gz_attacker ] ;
		}

		foreach(new i: logged_players)
		{
			if ( gz_td_status_bool [ i ] == true )
			{
				gz_td_status ( i, false ) ;
				gz_td_status_bool [ i ] = false ;
				for ( new j = 0 ; j < 5 ; j ++ ) SendDeathMessageToPlayer ( i, 1001, 1001, 200 ) ;

				checking_getto_quest_progress ( i, 7, 1 ) ;

				new query_string [ 98 ] ;
				format ( query_string,sizeof(query_string),"UPDATE `users` SET `u_captures` = `u_captures`+1 WHERE `u_id` = '%d' LIMIT 1", p_info [ i ] [ id ] ) ;
				mysql_tquery ( sql_connection, query_string, "", "" ) ;
			}
			p_info [ i ] [ capture_kills ] =
			p_info [ i ] [ capture_death ] = 0 ;
		    p_info [ i ] [ capture_damage ] = 0.0 ;
		}

		KillTimer ( gz_info [ gz_tid ] [ gz_timer ] ) ;

		gz_captured =
		owner_points =
		attacker_points	= -1 ;

		gz_info [ gz_tid ] [ gz_time ] =
		gz_info [ gz_tid ] [ gz_attacker ] = 0 ;

		GangZoneStopFlashForAll( gz_info [ gz_tid ] [ gz_created ] ) ;
		GangZoneHideForAll ( gz_info [ gz_tid ] [ gz_created ] ) ;
		GangZoneShowForAll( gz_info [ gz_tid ] [ gz_created ], GetGangZoneColor ( gz_info [ gz_tid ] [ gz_owner ] ) ) ;
		SaveGangZone ( gz_tid ) ;

		top_player_in_zahvat ( 1 ) ;
	}
	return 1 ;
}

stock gangwar_quit ( playerid, reason_quit )
{
    if ( gz_captured != - 1 && reason_quit != 0 )
	{
	    if ( ! gang_player ( playerid ) ) return 1 ;
	    if ( p_t_info [ playerid ] [ last_time_damage ] < gettime ( ) ) return 1 ;
		if ( ( IsPlayerInGangZone ( playerid, gz_captured ) || ( IsPlayerInRangeOfQuad ( playerid, gz_info [ gz_captured ] [ gz_pos ] [ 2 ], gz_info [ gz_captured ] [ gz_pos ] [ 3 ] ) < 200 || IsPlayerInRangeOfQuad ( playerid, gz_info [ gz_captured ] [ gz_pos ] [ 0 ], gz_info [ gz_captured ] [ gz_pos ] [ 1 ] ) < 200 ) ) )
		{
   			if ( p_info [ playerid ] [ member ] == gz_info [ gz_captured ] [ gz_attacker ] || p_info [ playerid ] [ member ] == gz_info [ gz_captured ] [ gz_attacker ] ||
				f_diplomacy [ p_info [ playerid ] [ member ] - 18 ] [ gz_info [ gz_captured ] [ gz_attacker ] - 18 ] == dip_status_alliance && f_diplomacy [ p_info [ playerid ] [ member ] - 18 ] [ gz_info [ gz_captured ] [ gz_owner ] - 18 ] == dip_status_war ||
				f_diplomacy [ p_info [ playerid ] [ member ] - 18 ] [ gz_info [ gz_captured ] [ gz_owner ] - 18 ] == dip_status_alliance && f_diplomacy [ p_info [ playerid ] [ member ] - 18 ] [ gz_info [ gz_captured ] [ gz_attacker ] - 18 ] == dip_status_war )
   			{
   			    new score_kill ;
				switch ( p_t_info [ playerid ] [ last_gun_damage ] )
				{
					case 0 									: score_kill += 5 ;
					case 22, 23 							: score_kill += 4 ;
					case 5, 6, 7, 10, 11, 12, 13, 14, 15	: score_kill += 10 ;
					default 								: score_kill += 1 ;
				}


	   		    new scm_string [ 144 ], td_string [ 48 ] ;
   			    if ( p_info [ playerid ] [ member ] == gz_info [ gz_captured ] [ gz_attacker ] )
				{
				    owner_points += score_kill ;

					format ( scm_string, sizeof scm_string, "[U] %s [%s] покинул(а) поле боя (+%d очков для %s). Счёт: %s [%d] : [%d] %s",
					p_info [ playerid ] [ name ], f_info [ gz_info [ gz_captured ] [ gz_attacker ] - 1 ] [ f_letter_name ],
					score_kill, f_info [ gz_info [ gz_captured ] [ gz_owner ] - 1 ] [ f_letter_name ],
					f_info [ gz_info [ gz_captured ] [ gz_attacker ] - 1 ] [ f_letter_name ], attacker_points,
					owner_points, f_info [ gz_info [ gz_captured ] [ gz_owner ] - 1 ] [ f_letter_name ] ) ;
				}

				else if ( p_info [ playerid ] [ member ] == gz_info [ gz_captured ] [ gz_owner ] )
				{
				    attacker_points += score_kill ;

					format ( scm_string, sizeof scm_string, "[U] %s [%s] покинул(а) поле боя (+%d очков для %s). Счёт: %s [%d] : [%d] %s",
					p_info [ playerid ] [ name ], f_info [ gz_info [ gz_captured ] [ gz_owner ] - 1 ] [ f_letter_name ],
					score_kill, f_info [ gz_info [ gz_captured ] [ gz_attacker ] - 1 ] [ f_letter_name ],
					f_info [ gz_info [ gz_captured ] [ gz_attacker ] - 1 ] [ f_letter_name ], attacker_points,
					owner_points, f_info [ gz_info [ gz_captured ] [ gz_owner ] - 1 ] [ f_letter_name ] ) ;
				}

				else if ( f_diplomacy [ p_info [ playerid ] [ member ] - 18 ] [ gz_info [ gz_captured ] [ gz_attacker ] - 18 ] == dip_status_alliance  )
				{
				    owner_points += score_kill ;

					format ( scm_string, sizeof scm_string, "[U] %s [Альянс с %s] покинул(а) поле боя (+%d очков для %s). Счёт: %s [%d] : [%d] %s",
					p_info [ playerid ] [ name ], f_info [ gz_info [ gz_captured ] [ gz_attacker ] - 1 ] [ f_letter_name ],
					score_kill, f_info [ gz_info [ gz_captured ] [ gz_owner ] - 1 ] [ f_letter_name ],
					f_info [ gz_info [ gz_captured ] [ gz_attacker ] - 1 ] [ f_letter_name ], attacker_points,
					owner_points, f_info [ gz_info [ gz_captured ] [ gz_owner ] - 1 ] [ f_letter_name ] ) ;
				}

				else if ( f_diplomacy [ p_info [ playerid ] [ member ] - 18 ] [ gz_info [ gz_captured ] [ gz_owner ] - 18 ] == dip_status_alliance )
				{
				    attacker_points += score_kill ;

					format ( scm_string, sizeof scm_string, "[U] %s [Альянс с %s] покинул(а) поле боя (+%d очков для %s). Счёт: %s [%d] : [%d] %s",
					p_info [ playerid ] [ name ], f_info [ gz_info [ gz_captured ] [ gz_owner ] - 1 ] [ f_letter_name ],
					score_kill, f_info [ gz_info [ gz_captured ] [ gz_attacker ] - 1 ] [ f_letter_name ],
					f_info [ gz_info [ gz_captured ] [ gz_attacker ] - 1 ] [ f_letter_name ], attacker_points,
					owner_points, f_info [ gz_info [ gz_captured ] [ gz_owner ] - 1 ] [ f_letter_name ] ) ;
				}

				foreach(new i: logged_players)
				{
				    if ( ! gang_player ( i ) && ! admin_info [ i ] [ admin_settings ] [ 0 ] ) continue ;

                    new _fraction_id = p_info [ i ] [ member ] ;
					if ( admin_info [ i ] [ admin_settings ] [ 1 ] ) _fraction_id = gz_info [ gz_captured ] [ gz_owner ] ;

					if ( ( ( f_diplomacy [ gz_info [ gz_captured ] [ gz_owner ] - 18 ] [ _fraction_id - 18 ] == dip_status_alliance || is_control_chat { i } == gz_info [ gz_captured ] [ gz_owner ] || _fraction_id == gz_info [ gz_captured ] [ gz_owner ] ) ||
					( f_diplomacy [ gz_info [ gz_captured ] [ gz_attacker ] - 18 ] [ _fraction_id - 18 ] == dip_status_alliance || is_control_chat { i } == gz_info [ gz_captured ] [ gz_attacker ] || _fraction_id == gz_info [ gz_captured ] [ gz_attacker ] ) ) && p_info [ i ] [ settings ] [ 0 ] != 0 ) SendClientMessage ( i, f_info [ gz_info [ gz_captured ] [ gz_owner ] - 1 ] [ f_radar_color ], scm_string ) ;

                    format ( td_string, sizeof td_string, "%d", attacker_points ) ;
					PlayerTextDrawSetString ( i, capture_ptd [ i ] [ 4 ], td_string ) ;

					format ( td_string, sizeof td_string, "%d", owner_points ) ;
					PlayerTextDrawSetString ( i, capture_ptd [ i ] [ 3 ], td_string ) ;
				}

				format ( scm_string, sizeof ( scm_string ), "{"#cBAdmin"}[A]{"#cGRAdmin"} %s [%s] покинул(а) поле боя (на +%d очков).",
				p_info [ playerid ] [ name ], f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_letter_name ], score_kill ) ;
				admin_message ( 0, col_admin, scm_string ) ;
   			}
		}
	}
	return 1 ;
}

stock top_player_in_zahvat ( _type_war )
{
	static _string [ 128 ] ;
	if ( _type_war == 1 )
	{
		SendGangMessage ( col_blue, "** Статистика захвата (ТОП 3): **\n" ) ;
		for ( new i = 0 ; i < 3 ; i ++ )
		{
			if ( zahvat_kills [ i ] > 0 && zahvat_fractions [ i ] > 0 && zahvat_fractions [ i ] < max_fraction )
		   	{
		   		format ( _string, sizeof _string, "%d. %s [%s] - убийств на захвате: %d.", i + 1, zahvat_names [ i ], f_info [ zahvat_fractions [ i ] - 1 ] [ f_name ], zahvat_kills [ i ] ) ;
				SendGangMessage ( col_white, _string ) ;
			}
			else SendGangMessage ( col_gray, !"* Пусто..." ) ;

			zahvat_kills [ i ] =
			zahvat_fractions [ i ] = 0 ;
		}
	}
	else if ( _type_war == 2 )
	{
		SendMafiaMessage ( col_blue, "** Статистика захвата (ТОП 3): **\n" ) ;
		for ( new i = 0 ; i < 3 ; i ++ )
		{
			if ( zahvat_kills [ i ] > 0 && zahvat_fractions [ i ] > 0 && zahvat_fractions [ i ] < max_fraction )
		   	{
		   		format ( _string, sizeof _string, "%d. %s [%s] - убийств на захвате: %d.", i + 1, zahvat_names [ i ], f_info [ zahvat_fractions [ i ] - 1 ] [ f_name ], zahvat_kills [ i ] ) ;
				SendMafiaMessage ( col_white, _string ) ;
			}
			else SendMafiaMessage ( col_gray, !"* Пусто..." ) ;

			zahvat_kills [ i ] =
			zahvat_fractions [ i ] = 0 ;
		}
	}
	return 1 ;
}

CMD:warsinfo ( playerid )
{
    if ( ! gang_player ( playerid ) && ! mafia_player ( playerid ) ) return 1 ;
	mysql_tquery ( sql_connection, !"SELECT * FROM `f_wars`", "WarsInfo", "i", playerid );
	return 1 ;
}

callback: WarsInfo ( playerid )
{
    new rows, fields;
    cache_get_data(rows, fields);

    SendClientMessage ( playerid, col_blue, "** Статистика идущих воин: **\n" ) ;

    if ( ! rows ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Сейчас не идут войны." ) ;
    for ( new i; i < rows; i ++ )
	{
     	new _string [ 144 ] ;
	    new fr_org, fr_to_org, fr_kill, fr_to_kill, fr_capture, fr_to_capture ;
	    fr_org = cache_get_field_content_int ( i, "f_org", sql_connection ) ;
	    fr_to_org = cache_get_field_content_int ( i, "f_to_org", sql_connection ) ;
	    fr_kill = cache_get_field_content_int ( i, "f_kill", sql_connection ) ;
	    fr_to_kill = cache_get_field_content_int ( i, "f_to_kill", sql_connection ) ;
	    fr_capture = cache_get_field_content_int ( i, "f_capture", sql_connection ) ;
	    fr_to_capture = cache_get_field_content_int ( i, "f_to_capture", sql_connection ) ;

	    if ( ( fr_org >= 18 && fr_org <= 22 ) && ( fr_to_org >= 23 && fr_to_org <= 25 ) || ( fr_org >= 23 && fr_org <= 25 ) && ( fr_to_org >= 18 && fr_to_org <= 22 ) ) continue ;

	    format ( _string, sizeof ( _string ), "%d. {%s}%s{"#cWH"} - {%s}%s{"#cWH"}: убийств: %d - %d, захватов: %d - %d.", i + 1,
		f_info [ fr_org - 1 ] [ f_chat_color ], f_info [ fr_org - 1 ] [ f_name ], f_info [ fr_to_org - 1 ] [ f_chat_color ], f_info [ fr_to_org - 1 ] [ f_name ], fr_kill, fr_to_kill, fr_capture, fr_to_capture ) ;
	    SendClientMessage ( playerid, col_white, _string ) ;
	}
	return 1 ;
}

callback: Wars_Info ( attacker, owner, attack_points, own_points, status )
{
    new rows, fields;
    cache_get_data(rows, fields);

    new _string [ 144 ], fr_org, fr_to_org ;
    for ( new i = 0 ; i < rows ; i ++ )
	{
	    fr_org = cache_get_field_content_int ( i, "f_org", sql_connection ) ;
	    fr_to_org = cache_get_field_content_int ( i, "f_to_org", sql_connection ) ;

		if ( attacker == fr_org && owner == fr_to_org )
		{
		    if ( status == 1 )
		    {
		    	format ( _string,sizeof(_string),"UPDATE `f_wars` SET `f_capture` = `f_capture`+1 WHERE `f_org` = '%d' AND `f_to_org` = '%d' LIMIT 1", attacker, owner ) ;
				mysql_tquery ( sql_connection, _string, "", "" ) ;
			}

			format ( _string,sizeof(_string),"UPDATE `f_wars` SET `f_kill` = `f_kill`+'%d' WHERE `f_org` = '%d' AND `f_to_org` = '%d' LIMIT 1", attack_points, attacker, owner ) ;
			mysql_tquery ( sql_connection, _string, "", "" ) ;

			format ( _string,sizeof(_string),"UPDATE `f_wars` SET `f_to_kill` = `f_to_kill`+'%d' WHERE `f_org` = '%d' AND `f_to_org` = '%d' LIMIT 1", own_points, attacker, owner ) ;
			mysql_tquery ( sql_connection, _string, "", "" ) ;
		}
		else if ( attacker == fr_to_org && owner == fr_org )
		{
		    if ( status == 1 )
		    {
				format ( _string,sizeof(_string),"UPDATE `f_wars` SET `f_to_capture` = `f_to_capture`+1 WHERE `f_org` = '%d' AND `f_to_org` = '%d' LIMIT 1", owner, attacker ) ;
				mysql_tquery ( sql_connection, _string, "", "" ) ;
			}

			format ( _string,sizeof(_string),"UPDATE `f_wars` SET `f_kill` = `f_kill`+'%d' WHERE `f_org` = '%d' AND `f_to_org` = '%d' LIMIT 1", own_points, owner, attacker ) ;
			mysql_tquery ( sql_connection, _string, "", "" ) ;

			format ( _string,sizeof(_string),"UPDATE `f_wars` SET `f_to_kill` = `f_to_kill`+'%d' WHERE `f_org` = '%d' AND `f_to_org` = '%d' LIMIT 1", attack_points, owner, attacker ) ;
			mysql_tquery ( sql_connection, _string, "", "" ) ;
		}
	}
	return 1 ;
}

CMD:diplomacy ( playerid )
{
	if ( ! gang_player ( playerid ) && ! mafia_player ( playerid ) ) return 1 ;

	static const dip_status [ ] [ ] =
	{
		"{FFF2C7}Нейтралитет",
		"{"#cRD"}Война",
		"{"#cGN"}Союз",
		"{"#cBL"}Запрос на союз",
		"{"#cBL"}Запрос на союз"
	} ;

	new step = 0,
		line_string [ 128 ] ;

	global_string [ 0 ] = EOS ;

	for ( new i = 0 ; i < 8 ; i ++ )
	{
		if ( i + 18 == p_info [ playerid ] [ member ] ) continue ;

		set_player_listitem_values ( playerid, step, i + 18 ) ;

		format ( line_string, sizeof line_string, "{%s}%s\t%s\n", f_info [ i + 17 ] [ f_chat_color ], f_info [ i + 17 ] [ f_name ], dip_status [ f_diplomacy [ p_info [ playerid ] [ member ] - 18 ] [ i ] ] ) ;
		strcat ( global_string, line_string ) ;
		step ++ ;
	}
	show_dialog ( playerid, d_dip_list, DIALOG_STYLE_TABLIST, "{"#cBHD"}Дипломатия", global_string, "Выбрать", "Закрыть" ) ;
	return 1 ;
}

stock save_diplomacy ( fractiond )
{
    global_string [ 0 ] = EOS ;
	mysql_format ( sql_connection, global_string, 128, "UPDATE `fractions` SET `f_dip` = '%d|%d|%d|%d|%d|%d|%d|%d' WHERE `f_id` = '%d' LIMIT 1",
	f_diplomacy [ fractiond - 18 ] [ 0 ], f_diplomacy [ fractiond - 18 ] [ 1 ],
	f_diplomacy [ fractiond - 18 ] [ 2 ], f_diplomacy [ fractiond - 18 ] [ 3 ],
	f_diplomacy [ fractiond - 18 ] [ 4 ], f_diplomacy [ fractiond - 18 ] [ 5 ],
	f_diplomacy [ fractiond - 18 ] [ 6 ], f_diplomacy [ fractiond - 18 ] [ 7 ],
	fractiond ) ;
	mysql_tquery ( sql_connection, global_string ) ;
	return 1 ;
}

CMD:setrank ( playerid )
{
	if ( p_info [ playerid ] [ leader ] < 1 || p_info [ playerid ] [ member ] < 1 ) return 1 ;
	if ( f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_leader_settings ] [ 0 ] == 0 && p_info [ playerid ] [ leader_status ] == 0 ) return 1 ;

	show_setrank ( playerid ) ;
	return 1 ;
}

