			SendClientMessage ( pl_id, col_white, text_string );

			if ( gang_player ( playerid ) || mafia_player ( playerid ) ) format ( text_string, 128, "[F] %s присоединился к подразделению %s (Пригласил: %s). Приветствуем!", p_info [ playerid ] [ name ], unit_info [ _unit_id - 1 ] [ un_name ], p_info [ pl_id ] [ name ] ) ;
			else format ( text_string, 128, "[R] %s присоединился к подразделению %s (Пригласил: %s). Приветствуем!", p_info [ playerid ] [ name ], unit_info [ _unit_id - 1 ] [ un_name ], p_info [ pl_id ] [ name ] ) ;
			fraction_message ( fraction_id, col_lblue, text_string ) ;

			format ( text_string, 128, "Принял(а) %s в поздразделение", p_info [ playerid ] [ name ] ) ;
