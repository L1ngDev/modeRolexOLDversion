	format ( string, sizeof ( string ), "{"#cGN"}* %s {"#cWH"}передал%s Вам {"#cGN"}%d{"#cWH"} пт.", p_info [ playerid ] [ name ], ( p_info [ playerid ] [ gender ] == 1 ) ? (""):("а"), params [ 1 ] ) ;
