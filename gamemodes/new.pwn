}

alias:spoff("reoff")
CMD:spoff ( playerid )
{
	if ( admin_info [ playerid ] [ spectate_id ] != -1 )
	{
		TogglePlayerSpectating ( playerid, false ) ;
		SpawnPlayer ( playerid ) ;
	    if ( player_device { playerid } == 2 )
	    {
	        onServerDestroy ( playerid, UI_ADMIN_PANEL ) ;
			TogglePlayerHudElement ( playerid, HUD_ELEMENT_BUTTONS, true ) ;
			TogglePlayerHudElement ( playerid, HUD_ELEMENT_HUD, true ) ;
			TogglePlayerHudElement ( playerid, HUD_ELEMENT_KILL_LIST, true ) ;
			TogglePlayerHudElement ( playerid, HUD_ELEMENT_TEXTLABELS, true ) ;
	    }
	    else
	    {
			show_spec_ptd ( playerid, false ) ;
			CancelSelectTextDraw ( playerid ) ;
		}
	}
	return 1 ;
}

alias:sp("re")
CMD:sp ( playerid, params [ ] )
{
	if ( ! admin_info [ playerid ] [ admin ] && ! tester_admin [ playerid ] ) return 1 ;
	if ( sscanf ( params, "u", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /sp [ид]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) || playerid == params [ 0 ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( GetPlayerState ( playerid ) == PLAYER_STATE_DRIVER ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы находитесь за рулём транспортного средства." ) ;
	if ( admin_info [ params [ 0 ] ] [ spectate_id ] != -1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок находится в режиме наблюдения." ) ;
	if ( admin_info [ params [ 0 ] ] [ admin ] > admin_info [ playerid ] [ admin ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}За данным администратором нельзя начать слежку." ) ;

    sp_timer [ playerid ] = 0 ;

	new Float: player_health ;
	GetPlayerHealth ( params [ 0 ], player_health ) ;
	if ( admin_info [ playerid ] [ spectate_id ] == -1 )
	{
		GetPlayerPos ( playerid, last_coord [ playerid ] [ 0 ], last_coord [ playerid ] [ 1 ], last_coord [ playerid ] [ 2 ] ) ;
		GetPlayerFacingAngle ( playerid, last_coord [ playerid ] [ 3 ] ) ;

		last_virt [ playerid ] = GetPlayerVirtualWorld ( playerid ) ;
    	last_int [ playerid ] = GetPlayerInterior ( playerid ) ;

		new td_str [ 98 ] ;
		if ( player_device { playerid } == 2 )
		{
			SPEC_SendSpectateData ( playerid, params [ 0 ] ) ;
			TogglePlayerHudElement ( playerid, HUD_ELEMENT_BUTTONS, false ) ;
			TogglePlayerHudElement ( playerid, HUD_ELEMENT_HUD, false ) ;
			TogglePlayerHudElement ( playerid, HUD_ELEMENT_KILL_LIST, false ) ;
			TogglePlayerHudElement ( playerid, HUD_ELEMENT_TEXTLABELS, false ) ;
		}
		else
		{
	    	show_spec_ptd ( playerid, true ) ;

			format ( td_str, sizeof td_str, "%s", p_info [ params [ 0 ] ] [ name ] ) ;
	  		PlayerTextDrawSetString ( playerid, sp_ptd [ playerid ] [ 28 ], td_str ) ;

			format ( td_str, sizeof td_str, "ID:_%d", params [ 0 ] ) ;
	  		PlayerTextDrawSetString ( playerid, sp_ptd [ playerid ] [ 38 ], td_str ) ;

			format ( td_str, sizeof ( td_str ), "%d~n~%.2f~n~%.2f~n~%d~n~%d~n~%d~n~%s~n~%d~n~%d$",
			p_info [ params [ 0 ] ] [ level ],
			player_health,
			p_t_info [ params [ 0 ] ] [ p_armour ],
			p_t_info [ params [ 0 ] ] [ p_gun_accuracy ],
			GetPlayerAmmo ( params [ 0 ] ),
			get_speed ( params [ 0 ] ),
			p_t_info [ params [ 0 ] ] [ p_ip ],
			p_info [ params [ 0 ] ] [ p_warn ],
			p_info [ params [ 0 ] ] [ money ] ) ;
	  		PlayerTextDrawSetString ( playerid, sp_ptd [ playerid ] [ 18 ], td_str ) ;
		}

		SendClientMessage ( playerid, col_admin, !"{"#cBAdmin"}[A] {"#cGRAdmin"}Нажмите {"#cBAdmin"}\"ALT\"{"#cGRAdmin"} для отображения указателя мыши." ) ;
		SendClientMessage ( playerid, col_admin, !"{"#cBAdmin"}[A] {"#cGRAdmin"}Нажмите {"#cBAdmin"}\"ESC\"{"#cGRAdmin"} для отключения указателя мыши." ) ;

		format ( td_str, sizeof td_str, "Администратор %s начал следить за %s", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ] ) ;
		WriteLog ( playerid, TYPE_LOG_SP, td_str ) ;
	}
	else
	{

		if ( player_device { playerid } == 2 )
		{
			SPEC_SendSpectateData ( playerid, params [ 0 ] ) ;
		}
		else
		{
			new td_str [ 98 ] ;
			format ( td_str, sizeof td_str, "%s", p_info [ params [ 0 ] ] [ name ] ) ;
	  		PlayerTextDrawSetString ( playerid, sp_ptd [ playerid ] [ 28 ], td_str ) ;

			format ( td_str, sizeof td_str, "ID:_%d", params [ 0 ] ) ;
	  		PlayerTextDrawSetString ( playerid, sp_ptd [ playerid ] [ 38 ], td_str ) ;

			format ( td_str, sizeof ( td_str ), "%d~n~%.2f~n~%.2f~n~%d~n~%d~n~%d~n~%s~n~%d~n~%d$",
			p_info [ params [ 0 ] ] [ level ],
			player_health,
			p_t_info [ params [ 0 ] ] [ p_armour ],
			p_t_info [ params [ 0 ] ] [ p_gun_accuracy ],
			GetPlayerAmmo ( params [ 0 ] ),
			get_speed ( params [ 0 ] ),
			p_t_info [ params [ 0 ] ] [ p_ip ],
			p_info [ params [ 0 ] ] [ p_warn ],
			p_info [ params [ 0 ] ] [ money ] ) ;

			PlayerTextDrawSetString ( playerid, sp_ptd [ playerid ] [ 18 ], td_str ) ;
		}
	}

	new line_string [ 128 ] ;
	if ( ! GetString ( ac_info [ params [ 0 ] ], "clear" ) )
	{
	    new s_year, s_month, s_day, s_hour, s_minute, s_second ;
		timestamp_to_date ( ac_date [ params [ 0 ] ] + CONVERT_TIME_TO_MOSCOW, s_year, s_month, s_day, s_hour, s_minute, s_second ) ;

		format ( line_string, sizeof ( line_string ), "%s добавлялся в чит панель. Причина: %s. Время: %02d:%02d:%02d.", p_info [ params [ 0 ] ] [ name ], ac_info [ params [ 0 ] ], s_hour, s_minute, s_second ) ;
		SendClientMessage ( playerid, col_white, line_string ) ;
	}

	if ( admin_info [ playerid ] [ admin ] < 8 )
	{
		format ( line_string, sizeof ( line_string ), "{"#cBAdmin"}[A]{"#cGRAdmin"} %s[%d] начал следить за %s[%d]", p_info [ playerid ] [ name ], playerid, p_info [ params [ 0 ] ] [ name ], params [ 0 ] ) ;
		admin_message ( 3, col_admin, line_string ) ;
	}

	switch ( GetPlayerState ( params [ 0 ] ) )
	{
		case 1:
		{
			set_interior ( playerid, p_t_info [ params [ 0 ] ][ p_data ] [ 0 ] ) ;
			set_world ( playerid, p_t_info [ params [ 0 ] ][ p_data ] [ 1 ] ) ;
			TogglePlayerSpectating ( playerid, true ) ;
			GameTextForPlayer ( playerid, "~n~", 100, 3 ) ;
			GameTextForPlayer ( playerid, "~n~", 100, 4 ) ;
			GameTextForPlayer ( playerid, "~n~", 100, 5 ) ;
	   		PlayerSpectatePlayer ( playerid, params [ 0 ] ) ;
		}
		case 2:
		{
			set_interior ( playerid, p_t_info [ params [ 0 ] ][ p_data ] [ 0 ] ) ;
			set_world ( playerid, p_t_info [ params [ 0 ] ][ p_data ] [ 1 ] ) ;
			new veh_id = GetPlayerVehicleID ( params [ 0 ] ) ;
			TogglePlayerSpectating ( playerid, true ) ;
			PlayerSpectateVehicle ( playerid, veh_id ) ;
		}
		case 3:
		{
			set_interior ( playerid, p_t_info [ params [ 0 ] ][ p_data ] [ 0 ] ) ;
			set_world ( playerid, p_t_info [ params [ 0 ] ][ p_data ] [ 1 ] ) ;
	        new veh_id = GetPlayerVehicleID ( params [ 0 ] ) ;
	        TogglePlayerSpectating ( playerid, true ) ;
			PlayerSpectateVehicle ( playerid, veh_id ) ;
		}
	}

	admin_info [ playerid ] [ spectate_id ] = params [ 0 ] ;

	/*format ( line_string, sizeof ( line_string ), "(/sp) %s начал следить за %s", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ] ) ;
	WriteLog ( playerid, TYPE_LOG_ADMIN, line_string ) ;*/
	return 1 ;
}

stock show_packet_adminpanel ( playerid, actionId, data [ ] )
{
	#pragma unused data

	new target_id = admin_info [ playerid ] [ spectate_id ] ;
	if ( actionId == 0 ) // previous
	{
        new prev = Iter_Prev(logged_players, target_id) ;
        if ( prev == playerid ) prev = Iter_Prev(logged_players, prev) ;

		new clf_string [ 4 + 9 ] ;
	    format ( clf_string, sizeof clf_string, "%d", admin_info [ playerid ] [ spectate_id ] ) ;
		callcmd::sp ( playerid, clf_string ) ;
	}
	else if ( actionId == 1 ) // refresh
	{
		switch ( GetPlayerState ( target_id ) )
		{
			case 1:
			{
				set_interior ( playerid, p_t_info [ target_id ] [ p_data ] [ 0 ] ) ;
				set_world ( playerid, p_t_info [ target_id ] [ p_data ] [ 1 ] ) ;
				TogglePlayerSpectating ( playerid, true ) ;
				PlayerSpectatePlayer ( playerid, target_id ) ;
			}
			case 2:
			{
				set_interior ( playerid, p_t_info [ target_id ] [ p_data ] [ 0 ] ) ;
				set_world ( playerid, p_t_info [ target_id ] [ p_data ] [ 1 ] ) ;
				new veh_id = GetPlayerVehicleID ( target_id ) ;
				TogglePlayerSpectating ( playerid, true ) ;
				PlayerSpectateVehicle ( playerid, veh_id ) ;
			}
			case 3:
			{
				set_interior ( playerid, p_t_info [ target_id ] [ p_data ] [ 0 ] ) ;
				set_world ( playerid, p_t_info [ target_id ] [ p_data ] [ 1 ] ) ;
				new veh_id = GetPlayerVehicleID ( target_id ) ;
				TogglePlayerSpectating ( playerid, true ) ;
				PlayerSpectateVehicle ( playerid, veh_id ) ;
			}
		}
	}
	else if ( actionId == 8 ) // exit
	{
		callcmd::spoff ( playerid ) ;
	}
	else if ( actionId == 9 ) // next
	{
		new prev = Iter_Next(logged_players, target_id) ;
        if ( prev == playerid ) prev = Iter_Next(logged_players, prev) ;

		new clf_string [ 4 + 9 ] ;
	    format ( clf_string, sizeof clf_string, "%d", admin_info [ playerid ] [ spectate_id ] ) ;
		callcmd::sp ( playerid, clf_string ) ;
	}
	else if ( actionId == 10 ) // full stat
	{
		show_stats ( target_id, playerid ) ;
	}
	else
	{
		new org_string [ 48 ], rang_string [ 48 ], _f_id = p_info [ target_id ] [ member ], _rank_id = p_info [ target_id ] [ rank ] ;
	   	if ( _f_id > 0 ) format ( org_string, sizeof org_string, "{%s}%s", f_info [ _f_id - 1 ] [ f_chat_color ], f_info [ _f_id - 1 ] [ f_name ] ) ;
		else format ( org_string, sizeof org_string, "{"#cRD"}Нет" ) ;

	    if ( _f_id > 0 && _rank_id > 0 ) format ( rang_string, sizeof rang_string, "%s (%d)", f_rank [ _f_id - 1 ] [ _rank_id - 1 ], _rank_id ) ;
		else format ( rang_string, sizeof rang_string, "{"#cRD"}Нет" ) ;

		if ( actionId == 2 ) // kick
		{
			global_string [ 0 ] = EOS ;
			format ( global_string, 512, "\
				{"#cWH"}Вы собираетесь кикнуть игрока:\n\n\
				\t{"#cWH"}Имя игрока: {"#cOR"}%s {"#cGRDialog"}(ID: {"#cWH"}%d{"#cGRDialog"})\n\
				\t{"#cWH"}Уровень: {"#cOR"}%d ур.\n\
				\t{"#cWH"}Организация: %s\n\
				\t{"#cWH"}Должность: %s\n\n\
				{"#cGRDialog"}* Пример наказания: {"#cBL"}'помеха'.\n\
				{"#cGRDialog"}* Укажите причину наказания:",
			p_info [ target_id ] [ name ], target_id, p_info [ target_id ] [ level ], org_string, rang_string ) ;
			show_dialog ( playerid, d_sp_kick, DIALOG_STYLE_INPUT, "{"#cBHD"}Наказание", global_string, "Выбрать", "Закрыть" ) ;
		}
		else if ( actionId == 3 ) // warn
		{
			global_string [ 0 ] = EOS ;
			format ( global_string, 512, "\
				{"#cWH"}Вы собираетесь выдать предупреждение игроку:\n\n\
				\t{"#cWH"}Имя игрока: {"#cOR"}%s {"#cGRDialog"}(ID: {"#cWH"}%d{"#cGRDialog"})\n\
				\t{"#cWH"}Уровень: {"#cOR"}%d ур.\n\
				\t{"#cWH"}Организация: %s\n\
				\t{"#cWH"}Должность: %s\n\n\
				{"#cGRDialog"}* Пример наказания: {"#cBL"}'нРП коп'.\n\
				{"#cGRDialog"}* Укажите причину наказания:",
			p_info [ target_id ] [ name ], target_id, p_info [ target_id ] [ level ], org_string, rang_string ) ;
			show_dialog ( playerid, d_sp_warn, DIALOG_STYLE_INPUT, "{"#cBHD"}Наказание", global_string, "Выбрать", "Закрыть" ) ;
		}
		else if ( actionId == 4 ) // mute
		{
	        new clf_string [ 12 ] ;
	        format ( clf_string, sizeof clf_string, "%d", target_id ) ;
	        callcmd::mute ( playerid, clf_string ) ;
		}
		else if ( actionId == 5 ) // ban
		{
			global_string [ 0 ] = EOS ;
			format ( global_string, 512, "\
				{"#cWH"}Вы собираетесь забанить игрока:\n\n\
				\t{"#cWH"}Имя игрока: {"#cOR"}%s {"#cGRDialog"}(ID: {"#cWH"}%d{"#cGRDialog"})\n\
				\t{"#cWH"}Уровень: {"#cOR"}%d ур.\n\
				\t{"#cWH"}Организация: %s\n\
				\t{"#cWH"}Должность: %s\n\n\
				{"#cGRDialog"}* Пример наказания (время в днях и причина): {"#cBL"}'30, читы'.\n\
				{"#cGRDialog"}* Укажите время и причину наказания через запятую:",
			p_info [ target_id ] [ name ], target_id, p_info [ target_id ] [ level ], org_string, rang_string ) ;
			show_dialog ( playerid, d_sp_ban, DIALOG_STYLE_INPUT, "{"#cBHD"}Наказание", global_string, "Выбрать", "Закрыть" ) ;
		}
		else if ( actionId == 6 ) // slap
		{
	        new clf_string [ 8 ] ;
	        format ( clf_string, sizeof clf_string, "%d", target_id ) ;
	        callcmd::slap ( playerid, clf_string ) ;
		}
		else if ( actionId == 7 ) // jail
		{
	        new clf_string [ 12 ] ;
	        format ( clf_string, sizeof clf_string, "%d", target_id ) ;
	        callcmd::jail ( playerid, clf_string ) ;
		}
	}
	return 1 ;
}

CMD:inter ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 4 )return 1 ;
	if ( sscanf ( params,"i",params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /inter [1-140]" ) ;
	if ( params [ 0 ] > 140 && params [ 0 ] < 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /inter [1-140]" ) ;

	switch ( params [ 0 ] )
