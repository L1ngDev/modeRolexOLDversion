	( ! p_info [ playerid ] [ google_auth_status ] ) ? ( "{F04245}Отключена" ) : ( "{63BD4E}Включена" ),
	( ! p_info [ playerid ] [ mail_auth ] ) ? ( "{F04245}Не подтвержден" ) : ( "{63BD4E}Подтвержден" ),
