						static const _str [ ] = "* Администратор %s[%d] забрал у вас оружие." ;
						new _t_string [ sizeof _str + 24 + 4 ] ;
						format( _t_string, sizeof _t_string, _str, p_info [ playerid ] [ name ], playerid ) ;
						SendClientMessage(i, col_yellow, _t_string ) ;
