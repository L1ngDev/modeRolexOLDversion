stock show_b_improvment ( playerid, _b_type, _b_id )
{
	if ( _b_type == bizz_type_gas )
   	{
		global_string [ 0 ] = EOS ;
		for ( new i = 0 ; i < MAX_B_IMPROVE ; i ++ )
		{
			new c[7];
			if ( b_info [ _b_id - 1 ] [ b_improve ] [ i ] ) c = ""#cGN"";
			else if ( !i || b_info [ _b_id - 1 ] [ b_improve ] [ i - 1 ] ) c = ""#cWH"" ;
			else c = ""#cGRDialog"" ;
			if ( ! i ) format ( global_string, sizeof ( global_string ),"{%s}%d. %s", c, i + 1, b_improve_fuel_name [ i ] ) ;
			else format( global_string, sizeof ( global_string ),"%s\n{%s}%d. %s", global_string, c, i + 1, b_improve_fuel_name [ i ] ) ;
		}
		show_dialog ( playerid, d_b_improvement, DIALOG_STYLE_LIST, "{"#cBHD"}Улучшения бизнеса", global_string, "Выбрать", "Назад" ) ;
    }
   	else if ( _b_type == bizz_type_trucker )
    {
		global_string [ 0 ] = EOS ;
		for ( new i = 0 ; i < MAX_B_IMPROVE ; i ++ )
		{
			new c[7];
			if ( b_info [ _b_id - 1 ] [ b_improve ] [ i ] ) c = ""#cGN"";
			else if ( !i || b_info [ _b_id - 1 ] [ b_improve ] [ i - 1 ] ) c = ""#cWH"" ;
			else c = ""#cGRDialog"" ;
			if ( ! i ) format ( global_string, sizeof ( global_string ),"{%s}%d. %s", c, i + 1, b_improve_truck_name [ i ] ) ;
			else format( global_string, sizeof ( global_string ),"%s\n{%s}%d. %s", global_string, c, i + 1, b_improve_truck_name [ i ] ) ;
		}
		show_dialog ( playerid, d_b_improvement, DIALOG_STYLE_LIST, "{"#cBHD"}Улучшения бизнеса", global_string, "Выбрать", "Назад" ) ;
   	}
   	else
   	{
		global_string [ 0 ] = EOS ;
		for ( new i = 0 ; i < MAX_B_IMPROVE ; i ++ )
		{
			new c[7];
			if ( b_info [ _b_id - 1 ] [ b_improve ] [ i ] ) c = ""#cGN"";
			else if ( !i || b_info [ _b_id - 1 ] [ b_improve ] [ i - 1 ] ) c = ""#cWH"" ;
			else c = ""#cGRDialog"" ;
			if ( ! i ) format ( global_string, sizeof ( global_string ),"{%s}%d. %s", c, i + 1, b_improve_name [ i ] ) ;
			else format( global_string, sizeof ( global_string ),"%s\n{%s}%d. %s", global_string, c, i + 1, b_improve_name [ i ] ) ;
		}
		show_dialog ( playerid, d_b_improvement, DIALOG_STYLE_LIST, "{"#cBHD"}Улучшения бизнеса", global_string, "Выбрать", "Назад" ) ;
   	}
	return 1 ;
}

stock give_bmoney ( _b_id, _b_count, _b_product )
{
	if ( _b_id < 1 || _b_id > b_count ) return 1 ;

	if ( b_info [ _b_id - 1 ] [ b_cash_today ] < b_info [ _b_id - 1 ] [ b_cash_limit ] && b_info [ _b_id - 1 ] [ b_money ] < max_money )
	{
	   	b_info [ _b_id - 1 ] [ b_money ] += _b_count ;
		b_info [ _b_id - 1 ] [ b_cash_today ] += _b_count ;
		b_info [ _b_id - 1 ] [ b_product ] -= _b_product ;
		update_blabel ( _b_id - 1, 0 ) ;
	}
	return 1 ;
}

stock business_information ( playerid, t, type )
{
    new dialog_string [ 850 ], _b_type = b_info [ t ] [ b_type ] ;
   	if ( _b_type == bizz_type_ammo || _b_type == bizz_type_pharm || _b_type == bizz_type_shop || _b_type == bizz_type_clothes || _b_type == bizz_type_cafe ||
	   	_b_type == bizz_type_club || _b_type == bizz_type_bar || _b_type == bizz_type_casino || _b_type == bizz_type_gym || _b_type == bizz_type_fish ||
		_b_type == bizz_type_market_place || _b_type == bizz_type_workshop )
	{
		new business_tax = floatround ( b_info [ t ] [ b_cash_today ] / 500 ) * for_tax [ 4 ] ;
		if ( b_info [ t ] [ b_improve ] [ 0 ] ) business_tax = floatround ( b_info [ t ] [ b_cash_today ] / 1000 ) * for_tax [ 4 ] ;

		new business_status [ 19 + 1 ] = "{"#cRD"}Закрыт" ;
		if ( ! b_info [ t ] [ b_close ] ) business_status = "{"#cGN"}Открыт" ;
		format ( dialog_string, sizeof ( dialog_string ),
		"{"#cBL"}** %s **{"#cGRDialog"}\n\nНа счету бизнеса: {"#cWH"}%s"valute_title_" из %s"valute_title_"{"#cGRDialog"}\nИнкассация: {"#cWH"}-%d"valute_title_"{"#cGRDialog"}\nПродукты: {"#cWH"}%d{"#cGRDialog"}\nЦена на Продукты: {"#cWH"}%d{"#cGRDialog"}\nЦена за вход: {"#cWH"}%d"valute_title_"{"#cGRDialog"}\nКонтроль: {"#cWH"}%s{"#cGRDialog"}\nСостояние: {"#cWH"}%s{"#cGRDialog"}\nНалог в сутки: {"#cWH"}%d"valute_title_"{"#cGRDialog"}\nПосетители: {"#cWH"}%d{"#cGRDialog"} человек\n\n{"#cGRDialog"}* Налог зависит от прибыли за сутки,\n{"#cGRDialog"}* поэтому он может меняться",
		b_info [ t ] [ b_name ], GetPlayerCashValueToSmile ( b_info [ t ] [ b_money ] ), GetPlayerCashValueToSmile ( b_info [ t ] [ b_cash_limit ] ), b_info [ t ] [ b_incass ], b_info [ t ] [ b_product ], b_info [ t ] [ b_cost ], b_info [ t ] [ b_fee ], f_info [ b_info [ t ] [ b_mafia ] - 1 ] [ f_name ],  business_status, business_tax, b_info [ t ] [ b_visitors ] ) ;
	}
	else if ( _b_type == bizz_type_carshop )
	{
		new business_tax = floatround ( b_info [ t ] [ b_cash_today ] / 500 ) * for_tax [ 4 ] ;
		if ( b_info [ t ] [ b_improve ] [ 0 ] ) business_tax = floatround ( b_info [ t ] [ b_cash_today ] / 1000 ) * for_tax [ 4 ] ;

