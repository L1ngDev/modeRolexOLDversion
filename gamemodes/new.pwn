	else
	{
	    if ( player_device { playerid } != 2 )
	    {
		    for ( new i = 0 ; i < 35 ; i ++ )
			{
			    PlayerTextDrawDestroy ( playerid, dr_ptd_model [ playerid ] [ i ] ) ;
			    dr_ptd_model [ playerid ] [ i ] = PlayerText:-1 ;
			}
		}
	}
	return 1 ;
}

stock update_roulette_color ( playerid, box_id, color )
{
	if ( player_device { playerid } == 2 ) { }
	else
	{
		for ( new i = ( box_id * 6 ) ; i < ( box_id * 6 ) + 6 ; i ++ )
		{
		    PlayerTextDrawColor ( playerid, dr_ptd_model [ playerid ] [ i ], color ) ;
		}
	}
	return 1 ;
}

CMD:roulette ( playerid )
{
	if ( p_info [ playerid ] [ hour_played ] < THREE_HOUR_PLAYED ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Доступно с 3 часов в игре. Используйте /mm - Информация о персонаже - Статистика персонажа." ) ;
    if ( GetPlayerState ( playerid ) != PLAYER_STATE_ONFOOT ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Не доступно в транспорте." ) ;

    give_event_progress ( playerid, THE_ROULETTE, 1 ) ;

    if ( player_device { playerid } == 2 )
    {
        show_dialog ( playerid, d_roulette, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Рулетка", "\
			{cd7f32}Бронзовая {"#cWH"}рулетка:\n\n\
			{"#cGRDialog"}- {"#cWH"}За {"#cLY"}+1 {"#cWH"}игровой уровень\n\
			{"#cGRDialog"}- {"#cWH"}В кладах {"#cGRDialog"}(/gps - 24/7)\n\
			{"#cGRDialog"}- {"#cWH"}В семейном и Battle Pass обменниках {"#cGRDialog"}(/gps - Прочее)\n\
			{"#cGRDialog"}- {"#cWH"}Битва за контейнеры {"#cGRDialog"}(/gps - Важные места)\n\
			{"#cGRDialog"}- {"#cWH"}Крафт {"#cGRDialog"}(Доступен в доме, гараже)\n\n\
			{c8c8c8}Серебряная {"#cWH"}рулетка:\n\n\
			{"#cGRDialog"}- {"#cWH"}В кладах {"#cGRDialog"}(/gps - 24/7)\n\
			{"#cGRDialog"}- {"#cWH"}В семейном и Battle Pass обменниках {"#cGRDialog"}(/gps - Прочее)\n\
			{"#cGRDialog"}- {"#cWH"}Битва за контейнеры {"#cGRDialog"}(/gps - Важные места)\n\
			{"#cGRDialog"}- {"#cWH"}Крафт {"#cGRDialog"}(Доступен в доме, гараже)\n\n\
			{c8c8c8}Золотая {"#cWH"}рулетка:\n\n\
			{"#cGRDialog"}- {"#cWH"}За {"#cLY"}/donate\n\
			{"#cGRDialog"}- {"#cWH"}В семейном и Battle Pass обменниках {"#cGRDialog"}(/gps - Прочее)\n\
			{"#cGRDialog"}- {"#cWH"}Крафт {"#cGRDialog"}(Доступен в доме, гараже)\n\n", "Открыть", "Закрыть" ) ;
        return 1 ;
    }
    else
    {
	    show_background_roulette ( playerid, true ) ;
	    show_model_roulette ( playerid, true ) ;

		new _box_id [ ] = { 30, 31, 32, 33, 34 } ;

		for ( new j = 0 ; j < 5 ; j ++ )
		{
			new donate_count = random ( 107000 ),
				random_item ;

			if ( donate_count >= 0 && donate_count <= 20000 )random_item = prise_skills ;
			else if ( donate_count >= 20001 && donate_count <= 40000 )random_item = prise_skills ;
			else if ( donate_count >= 40001 && donate_count <= 57000 )random_item = prise_licenses ;
			else if ( donate_count >= 57001 && donate_count <= 75000 )random_item = prise_drugs ;

			else if ( donate_count >= 75001 && donate_count <= 84000 )random_item = prise_guns ;

			else if ( donate_count >= 84001 && donate_count <= 95000 )random_item = prise_skin ;
			else if ( donate_count >= 95001 && donate_count <= 100000 )random_item = prise_money ;
			else if ( donate_count >= 100001 && donate_count <= 101000 )random_item = prise_donate ;

			else if ( donate_count >= 101001 && donate_count <= 108000 )random_item = prise_satiety ;
			else if ( donate_count >= 108001 && donate_count <= 102000 )random_item = prise_car ;
			else if ( donate_count >= 102001 && donate_count <= 105000 )random_item = prise_yacht ;
			else if ( donate_count >= 105001 && donate_count <= 107000 )random_item = prise_accesories ;

			dr_slot_item [ playerid ] [ j ] = random_item ;
			if ( random_item == prise_car )
			{
				new _slot = random ( 8 ),
					_vehicle_cell = random ( 6 ) ;


				switch ( _slot )
				{
					case 0: update_roulette_color ( playerid, j, -2139062017 ) ;
					case 1: update_roulette_color ( playerid, j, 8388863 ) ;
					case 2: update_roulette_color ( playerid, j, 41215 ) ;
					case 3: update_roulette_color ( playerid, j, -2139062017 ) ;
					case 4: update_roulette_color ( playerid, j, 8388863 ) ;
					case 5: update_roulette_color ( playerid, j, 41215 ) ;
					case 6: update_roulette_color ( playerid, j, -2147450625 ) ;
					case 7: update_roulette_color ( playerid, j, -2147483393 ) ;

				}

	            PlayerTextDrawSetPreviewModel(playerid, dr_ptd_model [ playerid ] [ _box_id [ j ] ], dr_veh_models [ _slot ] [ _vehicle_cell ] ) ;

				PlayerTextDrawSetPreviewRot(playerid, dr_ptd_model [ playerid ] [ _box_id [ j ] ], dr_info [ random_item - 1 ] [ dr_rot_x ],
																				 dr_info [ random_item - 1 ] [ dr_rot_y ],
																				 dr_info [ random_item - 1 ] [ dr_rot_xr ],
																				 dr_info [ random_item - 1 ] [ dr_rot_yr ] ) ;
				PlayerTextDrawSetPreviewVehCol ( playerid, dr_ptd_model [ playerid ] [ _box_id [ j ] ], 1, 1 ) ;

				dr_slot_model [ playerid ] [ j ] = _slot ;

				dr_veh_slot [ playerid ] [ j ] = _vehicle_cell ;
				continue ;
			}

	        update_roulette_color ( playerid, j, dr_background_color [ dr_info [ random_item - 1 ] [ dr_type ] - 1 ] ) ;

	        PlayerTextDrawSetPreviewModel(playerid, dr_ptd_model [ playerid ] [ _box_id [ j ] ], dr_info [ random_item - 1 ] [ dr_model ] ) ;

			PlayerTextDrawSetPreviewRot(playerid, dr_ptd_model [ playerid ] [ _box_id [ j ] ], dr_info [ random_item - 1 ] [ dr_rot_x ],
																			 dr_info [ random_item - 1 ] [ dr_rot_y ],
																			 dr_info [ random_item - 1 ] [ dr_rot_xr ],
																			 dr_info [ random_item - 1 ] [ dr_rot_yr ] ) ;

			if ( dr_slot_item [ playerid ] [ j ] == prise_skin )
			{
				new _skin_slot = random ( sizeof dr_skin ) ;
				dr_slot_model [ playerid ] [ j ] = dr_skin [ _skin_slot ] ;

				PlayerTextDrawSetPreviewModel(playerid, dr_ptd_model [ playerid ] [ _box_id [ j ] ], dr_skin [ _skin_slot ] ) ;
			}
			else if ( dr_slot_item [ playerid ] [ j ] == prise_accesories )
			{
				new _accesories_slot = random ( 8 ) ;
				dr_slot_model [ playerid ] [ j ] = dr_accesories [ _accesories_slot ] ;

				PlayerTextDrawSetPreviewModel(playerid, dr_ptd_model [ playerid ] [ _box_id [ j ] ], dr_accesories [ _accesories_slot ] ) ;
			}
		}

		set_player_use_roulette { playerid } = 0 ;
		for ( new i = 15 ; i < 18 ; i ++ )
		{
	 		PlayerTextDrawColor ( playerid, dr_ptd [ playerid ] [ i ], 0xCD7F32FF ) ;
	  		PlayerTextDrawHide ( playerid, dr_ptd [ playerid ] [ i ] ) ;
	   		PlayerTextDrawShow ( playerid, dr_ptd [ playerid ] [ i ] ) ;
		}

		for ( new j = 0 ; j < 35 ; j ++ )
		{
			PlayerTextDrawShow ( playerid, dr_ptd_model [ playerid ] [ j ] ) ;
		}
	}

	used_roulette [ playerid ] = true ;
 	SelectTextDraw ( playerid, 0xB0C4DEFF ) ;
	return 1 ;
}

callback: rd_refresh ( playerid )
{
	dr_step [ playerid ] -- ;
	if ( dr_step [ playerid ] == 1 )
	{
		KillTimer ( dr_timer [ playerid ] ) ;
		dr_timer [ playerid ] = -1 ;
		show_dr_result ( playerid ) ;
		return 1 ;
	}
	else if ( dr_step [ playerid ] == 5 )
	{
	    KillTimer ( dr_timer [ playerid ] ) ;
		dr_timer [ playerid ] = -1 ;
	    dr_timer [ playerid ] = SetTimerEx ( "rd_refresh", 1250, true, "i", playerid ) ;
	}
	else if ( dr_step [ playerid ] == 10 )
	{
	    KillTimer ( dr_timer [ playerid ] ) ;
		dr_timer [ playerid ] = -1 ;
	    dr_timer [ playerid ] = SetTimerEx ( "rd_refresh", 1000, true, "i", playerid ) ;
	}

	if ( player_device { playerid } == 2 ) { }
	else
    {
		static const _box_id [ ] = { 30, 31, 32, 33, 34 } ;

		for ( new j = 1 ; j < 5 ; j ++ )
		{
		    new _slot = dr_slot_model [ playerid ] [ j ],
				_vehicle_cell = dr_veh_slot [ playerid ] [ j ],
				_slot_item = dr_slot_item [ playerid ] [ j ] ;

			if ( _slot_item == prise_car )
			{
				switch ( _slot )
				{
	                case 0: update_roulette_color ( playerid, j - 1, -2139062017 ) ;
					case 1: update_roulette_color ( playerid, j - 1, 8388863 ) ;
					case 2: update_roulette_color ( playerid, j - 1, 41215 ) ;
					case 3: update_roulette_color ( playerid, j - 1, -2139062017 ) ;
					case 4: update_roulette_color ( playerid, j - 1, 8388863 ) ;
					case 5: update_roulette_color ( playerid, j - 1, 41215 ) ;
					case 6: update_roulette_color ( playerid, j - 1, -2147450625 ) ;
					case 7: update_roulette_color ( playerid, j - 1, -2147483393 ) ;
				}

				PlayerTextDrawSetPreviewModel(playerid, dr_ptd_model [ playerid ] [ _box_id [ j - 1 ] ], dr_veh_models [ _slot ] [ _vehicle_cell ] ) ;

				PlayerTextDrawSetPreviewRot(playerid, dr_ptd_model [ playerid ] [ _box_id [ j - 1 ] ], dr_info [ _slot_item - 1 ] [ dr_rot_x ],
																					 dr_info [ _slot_item - 1 ] [ dr_rot_y ],
																					 dr_info [ _slot_item - 1 ] [ dr_rot_xr ],
																					 dr_info [ _slot_item - 1 ] [ dr_rot_yr ] ) ;
				PlayerTextDrawSetPreviewVehCol ( playerid, dr_ptd_model [ playerid ] [ _box_id [ j - 1 ] ], 1, 1 ) ;

				dr_veh_slot [ playerid ] [ j - 1 ] = _vehicle_cell ;
				dr_slot_item [ playerid ] [ j - 1 ] = _slot_item ;
				dr_slot_model [ playerid ] [ j - 1 ] = _slot ;
				continue ;
			}
			else
			{
				dr_veh_slot [ playerid ] [ j - 1 ] = _vehicle_cell ;
				dr_slot_item [ playerid ] [ j - 1 ] = _slot_item ;
				dr_slot_model [ playerid ] [ j - 1 ] = _slot ;

				update_roulette_color ( playerid, j - 1, dr_background_color [ dr_info [ _slot_item - 1 ] [ dr_type ] - 1 ] ) ;

				PlayerTextDrawSetPreviewModel(playerid, dr_ptd_model [ playerid ] [ _box_id [ j - 1 ] ], dr_info [ _slot_item - 1 ] [ dr_model ] ) ;

				PlayerTextDrawSetPreviewRot(playerid, dr_ptd_model [ playerid ] [ _box_id [ j - 1 ] ], dr_info [ _slot_item - 1 ] [ dr_rot_x ],
																					 dr_info [ _slot_item - 1 ] [ dr_rot_y ],
																					 dr_info [ _slot_item - 1 ] [ dr_rot_xr ],
																					 dr_info [ _slot_item - 1 ] [ dr_rot_yr ] ) ;
			}
			if ( _slot_item == prise_skin )
			{
				PlayerTextDrawSetPreviewModel(playerid, dr_ptd_model [ playerid ] [ _box_id [ j - 1 ] ], _slot ) ;
			}
			else if ( _slot_item == prise_accesories )
			{
				PlayerTextDrawSetPreviewModel(playerid, dr_ptd_model [ playerid ] [ _box_id [ j - 1 ] ], _slot ) ;
			}
		}

		new random_item ;
		switch ( set_player_use_roulette { playerid } )
		{
	 		case 0:
		    {
		       	new donate_count = random ( 107000 ) ;
			    if ( donate_count >= 0 && donate_count <= 20000 )random_item = prise_skills ;
				else if ( donate_count >= 20001 && donate_count <= 40000 )random_item = prise_skills ;
				else if ( donate_count >= 40001 && donate_count <= 57000 )random_item = prise_licenses ;
				else if ( donate_count >= 57001 && donate_count <= 75000 )random_item = prise_drugs ;

				else if ( donate_count >= 75001 && donate_count <= 84000 )random_item = prise_guns ;

				else if ( donate_count >= 84001 && donate_count <= 95000 )random_item = prise_skin ;
				else if ( donate_count >= 95001 && donate_count <= 100000 )random_item = prise_money ;
				else if ( donate_count >= 100001 && donate_count <= 101000 )random_item = prise_donate ;

				else if ( donate_count >= 101001 && donate_count <= 108000 )random_item = prise_satiety ;
				else if ( donate_count >= 108001 && donate_count <= 102000 )random_item = prise_car ;
				else if ( donate_count >= 102001 && donate_count <= 105000 )random_item = prise_yacht ;
				else if ( donate_count >= 105001 && donate_count <= 107000 )random_item = prise_accesories ;
		    }
		    case 1:
		    {
		        new donate_count = random ( 61000 ) ;
				if ( donate_count >= 0 && donate_count <= 10000 )random_item = prise_skills ;
				else if ( donate_count >= 10001 && donate_count <= 20000 )random_item = prise_skills ;
				else if ( donate_count >= 20001 && donate_count <= 37000 )random_item = prise_licenses ;
				else if ( donate_count >= 37001 && donate_count <= 55000 )random_item = prise_drugs ;

				else if ( donate_count >= 55001 && donate_count <= 64000 )random_item = prise_guns ;

				else if ( donate_count >= 64001 && donate_count <= 75000 )random_item = prise_skin ;
				else if ( donate_count >= 75001 && donate_count <= 80000 )random_item = prise_money ;
				else if ( donate_count >= 80001 && donate_count <= 91000 )random_item = prise_donate ;

				else if ( donate_count >= 91001 && donate_count <= 98000 )random_item = prise_satiety ;
				else if ( donate_count >= 98001 && donate_count <= 103000 )random_item = prise_car ;
				else if ( donate_count >= 103001 && donate_count <= 109000 )random_item = prise_yacht ;

				else if ( donate_count >= 109001 && donate_count <= 11000 )random_item = prise_accesories ;
			}
		    case 2:
		    {
		        new donate_count = random ( 61000 ) ;
				if ( donate_count >= 0 && donate_count <= 5000 )random_item = prise_skills ;
				else if ( donate_count >= 5001 && donate_count <= 10000 )random_item = prise_skills ;
				else if ( donate_count >= 10001 && donate_count <= 17000 )random_item = prise_licenses ;
				else if ( donate_count >= 17001 && donate_count <= 25000 )random_item = prise_drugs ;

				else if ( donate_count >= 25001 && donate_count <= 34000 )random_item = prise_guns ;

				else if ( donate_count >= 34001 && donate_count <= 35000 )random_item = prise_skin ;
				else if ( donate_count >= 35001 && donate_count <= 40000 )random_item = prise_money ;
				else if ( donate_count >= 40001 && donate_count <= 41000 )random_item = prise_donate ;

				else if ( donate_count >= 41001 && donate_count <= 48000 )random_item = prise_satiety ;
				else if ( donate_count >= 48001 && donate_count <= 55000 )random_item = prise_car ;
				else if ( donate_count >= 55001 && donate_count <= 59000 )random_item = prise_yacht ;

				else if ( donate_count >= 59001 && donate_count <= 61000 )random_item = prise_accesories ;
			}
		}

		dr_slot_item [ playerid ] [ 4 ] = random_item ;
		if ( random_item == prise_car )
		{
			new _slot = random ( 8 ),
				_vehicle_cell = random ( 6 ) ;

			switch ( _slot )
			{
				case 0: update_roulette_color ( playerid, 4, -2139062017 ) ;
				case 1: update_roulette_color ( playerid, 4, 8388863 ) ;
				case 2: update_roulette_color ( playerid, 4, 41215 ) ;
				case 3: update_roulette_color ( playerid, 4, -2139062017 ) ;
				case 4: update_roulette_color ( playerid, 4, 8388863 ) ;
				case 5: update_roulette_color ( playerid, 4, 41215 ) ;
				case 6: update_roulette_color ( playerid, 4, -2147450625 ) ;
				case 7: update_roulette_color ( playerid, 4, -2147483393 ) ;

			}

			PlayerTextDrawSetPreviewModel(playerid, dr_ptd_model [ playerid ] [ _box_id [ 4 ] ], dr_veh_models [ _slot ] [ _vehicle_cell ] ) ;

			PlayerTextDrawSetPreviewRot(playerid, dr_ptd_model [ playerid ] [ _box_id [ 4 ] ], dr_info [ random_item - 1 ] [ dr_rot_x ],
																			 dr_info [ random_item - 1 ] [ dr_rot_y ],
																			 dr_info [ random_item - 1 ] [ dr_rot_xr ],
																			 dr_info [ random_item - 1 ] [ dr_rot_yr ] ) ;
			PlayerTextDrawSetPreviewVehCol ( playerid, dr_ptd_model [ playerid ] [ _box_id [ 4 ] ], 1, 1 ) ;

			dr_slot_model [ playerid ] [ 4 ] = _slot ;
			dr_veh_slot [ playerid ] [ 4 ] = _vehicle_cell ;
		}
		else
		{
			update_roulette_color ( playerid, 4, dr_background_color [ dr_info [ random_item - 1 ] [ dr_type ] - 1 ] ) ;

			PlayerTextDrawSetPreviewModel(playerid, dr_ptd_model [ playerid ] [ _box_id [ 4 ] ], dr_info [ random_item - 1 ] [ dr_model ] ) ;

			PlayerTextDrawSetPreviewRot(playerid, dr_ptd_model [ playerid ] [ _box_id [ 4 ] ], dr_info [ random_item - 1 ] [ dr_rot_x ],
																			 dr_info [ random_item - 1 ] [ dr_rot_y ],
																			 dr_info [ random_item - 1 ] [ dr_rot_xr ],
																			 dr_info [ random_item - 1 ] [ dr_rot_yr ] ) ;
		}

		if ( dr_slot_item [ playerid ] [ 4 ] == prise_skin )
		{
			new _skin_slot = random ( sizeof dr_skin ) ;
			dr_slot_model [ playerid ] [ 4 ] = dr_skin [ _skin_slot ] ;
			PlayerTextDrawSetPreviewModel(playerid, dr_ptd_model [ playerid ] [ _box_id [ 4 ] ], dr_skin [ _skin_slot ] ) ;
		}
		else if ( dr_slot_item [ playerid ] [ 4 ] == prise_accesories )
		{
			new _accesories_slot = random ( 8 ) ;
			dr_slot_model [ playerid ] [ 4 ] = dr_accesories [ _accesories_slot ] ;
			PlayerTextDrawSetPreviewModel(playerid, dr_ptd_model [ playerid ] [ _box_id [ 4 ] ], dr_accesories [ _accesories_slot ] ) ;
		}

		for ( new j = 0 ; j < 35 ; j ++ )
		{
		    PlayerTextDrawHide ( playerid, dr_ptd_model [ playerid ] [ j ] ) ;
			PlayerTextDrawShow ( playerid, dr_ptd_model [ playerid ] [ j ] ) ;
		}
	}
	return 1 ;
}

stock show_dr_result ( playerid )
{
	switch ( dr_slot_item [ playerid ] [ 2 ] )
	{
		case prise_skills:
		{
		    new prize_type ;
			if ( random ( 15 ) == 1 ) prize_type = 2036 ;
			else prize_type = RandomEx ( 2088, 2094 ) ;

			new query_string [ 128 ] ;
			format ( query_string, sizeof query_string, "%s выиграл в рулетку %s", p_info [ playerid ] [ name ], item_name ( prize_type ) ) ;
			WriteLog ( playerid, TYPE_LOG_ROULETTE, query_string ) ;

			give_inventory ( playerid, prize_type, 1, 0, "", "", NUMBERPLATE_TYPE_NONE, 0 ) ;
			format ( query_string, sizeof query_string, "* Вам в инвентарь был добавлен предмет '%s'.", item_name ( prize_type ) ) ;
			SendClientMessage ( playerid, col_yellow, query_string ) ;
		}
		case prise_licenses:
		{
		    new prize_type ;
			if ( random ( 15 ) == 1 ) prize_type = 2035 ;
			else prize_type = RandomEx ( 2084, 2087 ) ;

			new query_string [ 128 ] ;
			format ( query_string, sizeof query_string, "%s выиграл в рулетку %s", p_info [ playerid ] [ name ], item_name ( prize_type ) ) ;
			WriteLog ( playerid, TYPE_LOG_ROULETTE, query_string ) ;

		   	give_inventory ( playerid, prize_type, 1, 0, "", "", NUMBERPLATE_TYPE_NONE, 0 ) ;
			format ( query_string, sizeof query_string, "* Вам в инвентарь был добавлен предмет '%s'.", item_name ( prize_type ) ) ;
			SendClientMessage ( playerid, col_yellow, query_string ) ;
		}
		case prise_aidkits:
		{
			new aidkit_count = RandomEx ( 1, 3 ) ;
			give_inventory ( playerid, ITEM_AID_KIT, aidkit_count, 0, "", "", NUMBERPLATE_TYPE_NONE, 0 ) ;

			new query_string [ 128 ] ;
			format ( query_string, sizeof ( query_string ),"{"#cBL"}Поздравляем!\n\n{"#cWH"}Игра в рулетку завершена, Ваш выигрыш:\n{"#cBL"}-{"#cWH"} %d универсальных аптечек (/healme)", aidkit_count ) ;

			show_dialog ( playerid, d_rd_end, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Выигрыш", query_string, "Закрыть", "" ) ;
		}
		case prise_drugs:
		{
			new drugs_count = RandomEx ( 1, 50 ) ;
			give_inventory ( playerid, 2155, drugs_count, 0, "", "", NUMBERPLATE_TYPE_NONE, 0 ) ;

			new query_string [ 128 ] ;
			format ( query_string, sizeof ( query_string ),"{"#cBL"}Поздравляем!\n\n{"#cWH"}Игра в рулетку завершена, Ваш выигрыш:\n{"#cBL"}-{"#cWH"} %d гр. наркотиков (/usedrugs)", drugs_count ) ;
			show_dialog ( playerid, d_rd_end, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Выигрыш", query_string, "Закрыть", "" ) ;

			SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Используйте {"#cBL"}/dropdrugs{"#cWH"}, если хотите их выбросить." ) ;
		}
		case prise_guns:
		{
			new drugs_count = RandomEx ( 5, 100 ) ;
			give_inventory ( playerid, 2153, drugs_count, 0, "", "", NUMBERPLATE_TYPE_NONE, 0 ) ;
			give_inventory ( playerid, 2154, drugs_count, 0, "", "", NUMBERPLATE_TYPE_NONE, 0 ) ;

			new query_string [ 128 ] ;
			format ( query_string, sizeof ( query_string ),"{"#cBL"}Поздравляем!\n\n{"#cWH"}Игра в рулетку завершена, Ваш выигрыш:\n{"#cBL"}-{"#cWH"} %d ед.оружия и патронов (/makegun)", drugs_count ) ;
			show_dialog ( playerid, d_rd_end, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Выигрыш", query_string, "Закрыть", "" ) ;
		}
		case prise_skin:
		{
			new money_count = dr_slot_model [ playerid ] [ 2 ] ;

			new dialog_string [ 128 ] ;
			format ( dialog_string, sizeof dialog_string, "%s выиграл в рулетку Одежда №%d", p_info [ playerid ] [ name ], money_count ) ;
			WriteLog ( playerid, TYPE_LOG_ROULETTE, dialog_string ) ;

			give_inventory ( playerid, money_count, 1, 0, "", "", NUMBERPLATE_TYPE_NONE, 0 ) ;
			format ( dialog_string, sizeof dialog_string, "* Вам был добавлен предмет 'Одежда №%d'. Откройте инвентарь, используйте /mm или радиальное меню.", money_count ) ;
			SendClientMessage ( playerid, col_yellow, dialog_string ) ;
		}
		case prise_money:
		{
			new money_count = 0 ;
			switch ( random ( 5 ) )
			{
				case 0,1,3,4: money_count = RandomEx ( 2004, 2009 ) ;
				case 2: money_count = RandomEx ( 2050, 2055 ) ;
			}

			new dialog_string [ 128 ] ;
			format ( dialog_string, sizeof dialog_string, "%s выиграл в рулетку %s", p_info [ playerid ] [ name ], item_name ( money_count ) ) ;
			WriteLog ( playerid, TYPE_LOG_ROULETTE, dialog_string ) ;

		   	give_inventory ( playerid, money_count, 1, 0, "", "", NUMBERPLATE_TYPE_NONE, 0 ) ;
			format ( dialog_string, sizeof dialog_string, "* Вам в инвентарь был добавлен предмет '%s'.", item_name ( money_count ) ) ;
			SendClientMessage ( playerid, col_yellow, dialog_string ) ;
		}
		case prise_donate:
		{
			new money_count = RandomEx ( 2015, 2023 ) ;

			new query_string [ 128 ] ;
		   	give_inventory ( playerid, money_count, 1, 0, "", "", NUMBERPLATE_TYPE_NONE, 0 ) ;
			format ( query_string, sizeof query_string, "* Вам в инвентарь был добавлен предмет '%s'.", item_name ( money_count ) ) ;
			SendClientMessage ( playerid, col_yellow, query_string ) ;
		}
		case prise_satiety:
		{
		    new result_random = RandomEx ( 2040, 2044 ) ;

            new query_string [ 128 ] ;
			format ( query_string, sizeof query_string, "%s выиграл в рулетку %s", p_info [ playerid ] [ name ], item_name ( result_random ) ) ;
			WriteLog ( playerid, TYPE_LOG_ROULETTE, query_string ) ;

		   	give_inventory ( playerid, result_random, 1, 0, "", "", NUMBERPLATE_TYPE_NONE, 0 ) ;
			format ( query_string, sizeof query_string, "* Вам в инвентарь был добавлен предмет '%s'.", item_name ( result_random ) ) ;
			SendClientMessage ( playerid, col_yellow, query_string ) ;
		}
		case prise_car:
		{
			new result_random ;
			result_random = dr_veh_models [ dr_slot_model [ playerid ] [ 2 ] ] [ dr_veh_slot [ playerid ] [ 2 ] ] ;

            new query_string [ 128 ] ;
			format ( query_string, sizeof query_string, "%s выиграл в рулетку %s", p_info [ playerid ] [ name ], item_name ( result_random ) ) ;
			WriteLog ( playerid, TYPE_LOG_ROULETTE, query_string ) ;

		   	give_inventory ( playerid, result_random, 1, 0, "", "", NUMBERPLATE_TYPE_NONE, 0 ) ;
			format ( query_string, sizeof query_string, "* Вам в инвентарь был добавлен предмет '%s'.", item_name ( result_random ) ) ;
			SendClientMessage ( playerid, col_yellow, query_string ) ;
		}
		case prise_yacht:
		{
		    new result_random = 454 ;

		    new query_string [ 128 ] ;
			format ( query_string, sizeof query_string, "%s выиграл в рулетку %s", p_info [ playerid ] [ name ], item_name ( result_random ) ) ;
			WriteLog ( playerid, TYPE_LOG_ROULETTE, query_string ) ;

		   	give_inventory ( playerid, result_random, 1, 0, "", "", NUMBERPLATE_TYPE_NONE, 0 ) ;
			format ( query_string, sizeof query_string, "* Вам в инвентарь был добавлен предмет '%s'.", item_name ( result_random ) ) ;
			SendClientMessage ( playerid, col_yellow, query_string ) ;
		}
		case prise_accesories:
		{
