CMD:createrace ( playerid )
{
	if ( admin_info [ playerid ] [ admin ] < 8 ) return 1 ;
	if ( ! IsFounder ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}К сожалению, Вам данная функция не доступна." ) ;
    mysql_tquery ( sql_connection, !"SELECT * FROM `src_info`", "server_raceinfo_edit", "i", playerid ) ;
    return 1 ;
}

callback: server_raceinfo_edit ( playerid )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	global_string [ 0 ] = EOS ;
	if ( rows )
	{
	    new _r_name [ 24 ], _r_creator [ 24 ], line_string [ 128 ], _r_step ;
	    for ( new i = 0 ; i < rows ; i++ )
	    {
	        _r_step = cache_get_field_content_int ( i, "r_step", sql_connection ) ;
	        cache_get_field_content ( i, "r_name", _r_name, sql_connection, 24 ) ;
	        cache_get_field_content ( i, "r_creator", _r_creator, sql_connection, 24 ) ;

	        set_player_listitem_values ( playerid, i, _r_step ) ;

			format ( line_string, sizeof line_string, "{"#cBL"}%d. {"#cWH"}%s {"#cGRDialog"}(Author: {"#cWH"}%s{"#cGRDialog"})\n", i + 1, _r_name, _r_creator ) ;
			strcat ( global_string, line_string ) ;
	    }
	}
	strcat ( global_string, "Создание нового маршрута" ) ;
 	show_dialog ( playerid, d_server_race, DIALOG_STYLE_LIST, "{"#cBHD"}Выбор маршрута", global_string, "Выбрать", "Назад" ) ;
	return 1 ;
}

callback: server_race_edit ( playerid )
{
	new fields, time = GetTickCount ( ) ;
	cache_get_data ( src_count, fields ) ;
	if( src_count )
	{
	    for ( new i = 0 ; i < src_count ; i ++ )
		{
	        src_info [ i ] [ race_position ] [ 0 ] = cache_get_field_content_float ( i, "r_pos_x", sql_connection ) ;
			src_info [ i ] [ race_position ] [ 1 ] = cache_get_field_content_float ( i, "r_pos_y", sql_connection ) ;
			src_info [ i ] [ race_position ] [ 2 ] = cache_get_field_content_float ( i, "r_pos_z", sql_connection ) ;
			src_info [ i ] [ race_position ] [ 3 ] = cache_get_field_content_float ( i, "r_pos_a", sql_connection ) ;
	    }
	}
	show_menu_server_race ( playerid ) ;
	printf("[SERVER] Загружено %d чекпоинтов для гонок Street Racing Club. (%d ms)", src_count, GetTickCount ( ) - time ) ;
	return 1 ;
}

stock show_menu_server_race ( playerid )
{
	global_string [ 0 ] = EOS ;

	new Float:_distance ;
	if ( src_count > 0 ) _distance = GetDistanceBetweenPoints ( src_info [ 0 ] [ race_position ] [ 0 ], src_info [ 0 ] [ race_position ] [ 1 ], src_info [ 0 ] [ race_position ] [ 2 ], src_info [ src_count - 1 ] [ race_position ] [ 0 ], src_info [ src_count - 1 ] [ race_position ] [ 1 ], src_info [ src_count - 1 ] [ race_position ] [ 2 ] ) ;

	format ( global_string, 512, "\
		{"#cBL"}1. {"#cWH"}Добавить крайнюю точку\n\
		{"#cBL"}2. {"#cWH"}Подсказки\n\
		{"#cBL"}3. {"#cWH"}Проехать ({"#cGN"}%.1f{"#cWH"} м)\n\
		{"#cBL"}4. {"#cWH"}Точек в маршруте: {"#cGN"}%d/%d\n\
		{"#cBL"}5. {"#cWH"}Удалить крайнюю точку\n\
		{"#cBL"}6. {"#cWH"}Удалить маршрут",
	_distance, src_count, SRC_TRECK_COUNT ) ;
	show_dialog ( playerid, d_server_race_edit, DIALOG_STYLE_LIST, "{"#cBHD"}Настройки маршрута", global_string, "Выбрать", "Назад" ) ;
	return 1 ;
}

callback: bus_first_loading ( )
{
	new fields, time = GetTickCount ( ) ;
	cache_get_data ( bus_first_count, fields ) ;
	if( bus_first_count )
	{
	    for ( new i ; i < bus_first_count ; i++ )
	    {
	        cache_get_field_content ( i, "b_name", bus_info [ i ] [ bus_name ], sql_connection, 24 ) ;
			bus_info [ i ] [ bus_price ] = cache_get_field_content_int ( i, "b_price", sql_connection ) ;
	    }
	}
	mysql_tquery ( sql_connection, !"SELECT * FROM `bus_settings`", "bus_loading" ) ;
	printf("[SERVER] Загружено %d рейсов для автобусника. (%d ms)", bus_first_count, GetTickCount ( ) - time ) ;
