					#if defined m_fractions
					    if ( mayor_player ( playerid ) || gov_player ( playerid ) ) give_emp_progress ( playerid, 1, 1 ) ;
					    else if ( cop_player ( playerid ) || fbi_player ( playerid ) ) give_emp_progress ( playerid, 4, 1 ) ;
					#endif
					return 1 ;
			    }
			}

   			for ( new i = 0 ; i < max_maps ; i ++ )
			{
				if ( p_t_info [ playerid ] [ tr_enter ] && pickupid >= f_info [ 0 ] [ f_tr_exit_pickup ] [ i ] && pickupid <= f_info [ max_fraction - 1 ] [ f_tr_exit_pickup ] [ i ] )
				{
					new fractionid = p_t_info [ playerid ] [ tr_enter ] ;
				    set_pos ( playerid, f_info [ fractionid - 1 ] [ f_tr_pickup ] [ 0 ], f_info [ fractionid - 1 ] [ f_tr_pickup ] [ 1 ], f_info [ fractionid - 1 ] [ f_tr_pickup ] [ 2 ], f_info [ fractionid - 1 ] [ f_tr_pickup ] [ 3 ], f_info [ fractionid - 1 ] [ f_tr_int ], f_info [ fractionid - 1 ] [ f_tr_vw ] ) ;
					fraction_duty ( playerid ) ;

					p_t_info [ playerid ] [ tr_enter ] =
					p_t_info [ playerid ] [ tr_team ] = 0 ;

					reset_player_weapon ( playerid ) ;
					return 1 ;
				}
			}
		}
		case pick_type_admin:
		{
		    if ( pick_info [ pickupid ] [ pick_model ] == 336 ) give_weapon ( playerid, 5, 1 ) ;
		    else if ( pick_info [ pickupid ] [ pick_model ] == 341 ) give_weapon ( playerid, 9, 1 ) ;
		    else if ( pick_info [ pickupid ] [ pick_model ] == 342 ) give_weapon ( playerid, 16, 10 ) ;
		    else if ( pick_info [ pickupid ] [ pick_model ] == 343 ) give_weapon ( playerid, 17, 10 ) ;
		    else if ( pick_info [ pickupid ] [ pick_model ] == 344 ) give_weapon ( playerid, 18, 10 ) ;
		    else if ( pick_info [ pickupid ] [ pick_model ] == 346 ) give_weapon ( playerid, 22, 100 ) ;
		    else if ( pick_info [ pickupid ] [ pick_model ] == 347 ) give_weapon ( playerid, 23, 100 ) ;
		    else if ( pick_info [ pickupid ] [ pick_model ] == 348 ) give_weapon ( playerid, 24, 100 ) ;
		    else if ( pick_info [ pickupid ] [ pick_model ] == 349 ) give_weapon ( playerid, 25, 100 ) ;
		    else if ( pick_info [ pickupid ] [ pick_model ] == 350 ) give_weapon ( playerid, 26, 100 ) ;
		    else if ( pick_info [ pickupid ] [ pick_model ] == 351 ) give_weapon ( playerid, 27, 100 ) ;
		    else if ( pick_info [ pickupid ] [ pick_model ] == 352 ) give_weapon ( playerid, 28, 100 ) ;
		    else if ( pick_info [ pickupid ] [ pick_model ] == 353 ) give_weapon ( playerid, 29, 100 ) ;
		    else if ( pick_info [ pickupid ] [ pick_model ] == 355 ) give_weapon ( playerid, 30, 100 ) ;
		    else if ( pick_info [ pickupid ] [ pick_model ] == 356 ) give_weapon ( playerid, 31, 100 ) ;
		    else if ( pick_info [ pickupid ] [ pick_model ] == 372 ) give_weapon ( playerid, 32, 100 ) ;
		    else if ( pick_info [ pickupid ] [ pick_model ] == 357 ) give_weapon ( playerid, 33, 100 ) ;
		    else if ( pick_info [ pickupid ] [ pick_model ] == 358 ) give_weapon ( playerid, 34, 100 ) ;
		    else if ( pick_info [ pickupid ] [ pick_model ] == 1240 ) set_health ( playerid, 100.0 ) ;
		    else if ( pick_info [ pickupid ] [ pick_model ] == 1242 ) set_armour ( playerid, 100.0 ) ;
		    return 1 ;
		}
  		case pick_type_famcon:
		{
		    if ( ! p_info [ playerid ] [ family ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не состоите в семье." ) ;
		    if ( p_info [ playerid ] [ family_quest ] != 4 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет активного квеста." ) ;

		    if ( ++ p_info [ playerid ] [ family_quest_progress ] < 5 )
		    {
			    new family_id = p_info [ playerid ] [ family ] ;
			    if ( family_info [ family_id - 1 ] [ fam_house ] )
			    {
			        new s_house_id = family_info [ family_id - 1 ] [ fam_house ] - 1 ;

					if ( h_info [ s_house_id ] [ h_podezd ] != -1 )
				    {
				    	new _padik_id = h_info [ s_house_id ] [ h_podezd ] ;
						SetPlayerRaceCheckpoint ( playerid, 1, podezd_info [ _padik_id ] [ p_pos ] [ 0 ], podezd_info [ _padik_id ] [ p_pos ] [ 1 ], podezd_info [ _padik_id ] [ p_pos ] [ 2 ], 0.0, 0.0, 0.0, 4.0 ) ;
					}
					else SetPlayerCheckpoint ( playerid, h_info [ s_house_id ] [ h_pos ] [ 0 ], h_info [ s_house_id ] [ h_pos ] [ 1 ], h_info [ s_house_id ] [ h_pos ] [ 2 ], 4.0 ) ;

					SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}[GPS] - Метка установлена." ) ;
					is_gps_used { playerid } = 9 ;
			    }
			    else
			    {
				    SetPlayerRaceCheckpoint ( playerid, 1, fam_con_gps [ 1 ] [ 0 ], fam_con_gps [ 1 ] [ 1 ], fam_con_gps [ 1 ] [ 1 ], 0.0, 0.0, 0.0, 2.0 ) ;
					SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}[GPS] - Метка установлена." ) ;
					is_gps_used { playerid } = 9 ;
				}
			}

			update_int_sql ( playerid, "u_family_quest_progress", p_info [ playerid ] [ family_quest_progress ] ) ;

			if ( IsPlayerAttachedObjectSlotUsed ( playerid, 0 ) ) RemovePlayerAttachedObject ( playerid, 0 ) ;
			SetPlayerAttachedObject ( playerid, 0, 3013, 6, 0.0, 0.10, -0.2, -110.0, 0.0, 78.0 ) ;
			have_box [ playerid ] = true ;

			SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы взяли ящик с патронами. Отнесите и положите его в фургон." ) ;
     		SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}У задних дверей фургона нажмите 'Y' для того, чтобы положить ящик с патронами." ) ;
			ClearAnimations ( playerid ) ;
			p_t_info [ playerid ] [ p_animation ] = true ;
			ApplyAnimation ( playerid, "CARRY", "crry_prtial", 4.1, 0, 1, 1, 1, 1 ) ;
			return 1 ;
		}
		case pick_type_inkassation_quest:
		{
		    for ( new q = 0 ; q < sizeof ink_quest_enter ; q ++ )
		    {
			    if ( ! IsPlayerInRangeOfPoint ( playerid, 5, ink_quest_enter [ q ] [ 0 ], ink_quest_enter [ q ] [ 1 ], ink_quest_enter [ q ] [ 2 ] ) ) continue ;

				if ( ! p_info [ playerid ] [ family ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не состоите в семье." ) ;
			   	if ( p_info [ playerid ] [ family_quest ] != 3 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет активного квеста." ) ;
			   	if ( p_info [ playerid ] [ family_quest_progress ] == 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Задание уже выполнено." ) ;
				if ( p_t_info [ playerid ] [ pl_quest ] != INVALID_VEHICLE_ID ) return SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Вы уже выполняете задание." ) ;

		  		p_t_info [ playerid ] [ pl_quest ] = CreateVehicle ( 428, ink_car_position [ q ] [ 0 ], ink_car_position [ q ] [ 1 ], ink_car_position [ q ] [ 2 ], ink_car_position [ q ] [ 3 ], 1, 1, -1 ) ;

				new veh_id = p_t_info [ playerid ] [ pl_quest ] ;
				new engine, lights, alarm, doors, bonnet, boot, objective ;
	            veh_info [ veh_id - 1 ] [ v_locked ] = false ;
				GetVehicleParamsEx ( veh_id, engine, lights, alarm, doors, bonnet, boot, objective ) ;
				SetVehicleParamsEx ( veh_id, engine, lights, alarm, false, bonnet, boot, objective ) ;

				veh_info [ veh_id - 1 ] [ v_fuel ] = 60.0 ;

				veh_info [ veh_id - 1 ] [ v_type ] = vehicle_type_quest ;
				veh_info [ veh_id - 1 ] [ v_renter ] = playerid ;

				SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Не покидайте транспорт. Место отмечено у Вас на карте." ) ;

				static _bank_id ;
				if ( q == 0 ) _bank_id = 1 ;
				else if ( q == 1 ) _bank_id = 2 ;
				else _bank_id = 0 ;

				SetPlayerRaceCheckpoint ( playerid, 1, ink_quest_position [ _bank_id ] [ 0 ], ink_quest_position [ _bank_id ] [ 1 ], ink_quest_position [ _bank_id ] [ 2 ], 0.0, 0.0, 0.0, 2.0 ) ;
				SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}[GPS] - Метка установлена." ) ;
				is_gps_used { playerid } = 9 ;

				static const _banks_name [ 3 ] [ 18 ] =
				{
				    "Тинькофф",
				    "Сбер Арзамас",
				    "Сбер Южный"
				} ;

				new scm_string [ 108 + MAX_PLAYER_NAME ] ;
				format ( scm_string, sizeof scm_string, "{"#cBInfo"}* {"#cWH"} С банка %s выехала инкассация, за рулём: {"#cBL"}%s{"#cWH"}. Остановите её!", _banks_name [ q ], p_info [ playerid ] [ name ] ) ;
				foreach(new i: logged_players)
				{
				    if ( p_info [ i ] [ family_quest ] != 7 && p_info [ i ] [ family_quest ] != 1 ) continue ;

				    SendClientMessage ( i, col_white, scm_string ) ;
				}
				return 1 ;
			}
		}
		case pick_type_deer:
		{
		    if ( p_info [ playerid ] [ deer ] >= player_max_deer ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас максимальное количество тушек! Продайте их." ) ;

			new A = pick_info [ pickupid ] [ pick_item ] ;
			if ( IsValidDynamicPickup ( DeerInfo [ A ] [ D_Pickup ] ) )
			{
				DestroyDynamicPickup ( DeerInfo [ A ] [ D_Pickup ] ) ;
		    	DeerInfo [ A ] [ D_Pickup ] = INVALID_PICKUP_ID ;
			}

			DeerInfo [ A ] [ D_Status ] = 3 ;
			DeerInfo [ A ] [ D_RespawnTime ] = gettime ( ) + 180 ;

	  	   	ApplyAnimation ( playerid, "BOMBER", "BOM_Plant", 6.1, 0, 0, 0, 0, 0, 1 ) ;

	  	   	p_info [ playerid ] [ deer ] ++ ;

	  	   	new scm_string [ 128 ] ;
	  	   	format ( scm_string, sizeof scm_string, "{"#cGInfo"}* {"#cWH"}Вы подобрали тушку оленя. У Вас {"#cGN"}%d {"#cWH"}тушек из {"#cGN"}%d{"#cWH"}.", p_info [ playerid ] [ deer ], player_max_deer ) ;
	  	   	SendClientMessage ( playerid, col_white, scm_string ) ;

	  	   	give_event_progress ( playerid, THE_HUNTING, 1 ) ;
	  	   	return 1 ;
		}
		case pick_type_collector:
		{
		    if ( pickupid >= collector_box [ 0 ] && pickupid <= collector_box [ sizeof collector_box - 1 ] )
			{
			    if ( ! gang_player ( playerid ) && ! mafia_player ( playerid ) ) return 1 ;
			    if ( IsPlayerAttachedObjectSlotUsed ( playerid, 1 ) ) return SendClientMessage (playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас уже есть сумка!" ) ;
				SetPlayerAttachedObject ( playerid, 1, 1550, 1,   0.160001, -0.234000, -0.009998, 1.100002, 95.899940, -17.500007  ) ;

				SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Теперь нужно отмыть деньги. У Вас на радаре отмечено место, где это можно сделать." ) ;

				p_info [ playerid ] [ robbery_money ] += 50000 ;

				new _position = random ( MAX_ROBBERY_POSITION ) ;
 	  			SetPlayerRaceCheckpoint ( playerid, 1, robbery_position [ _position ] [ 0 ], robbery_position [ _position ] [ 1 ], robbery_position [ _position ] [ 2 ], 0.0, 0.0, 0.0, 5 ) ;
				is_gps_used { playerid } = 4 ;

				ClearAnimations ( playerid ) ;
				p_t_info [ playerid ] [ p_animation ] = true ;
	    		ApplyAnimation(playerid,"CARRY", "crry_prtial", 4.1, 0, 1, 1, 1, 1 ) ;

                new i = pick_info [ pickupid ] [ pick_item ] ;
				if ( IsValidDynamicPickup ( collector_box [ i ] ) )
				{
					DestroyDynamicPickup ( collector_box [ i ] ) ;
					collector_box [ i ] = INVALID_PICKUP_ID ;
				}
			   	if ( IsValidDynamic3DTextLabel ( collector_text [ i ] ) )
				{
					DestroyDynamic3DTextLabel ( collector_text [ i ] ) ;
					collector_text [ i ] = Text3D:INVALID_3DTEXT_ID ;
				}
			    return 1 ;
			}
		}
        case pick_type_podezd_enter:
		{
		    new i = pick_info [ pickupid ] [ pick_item ] - 1 ;
		    if ( i < 0 ) return 1 ;

		    if ( podezd_info [ i ] [ p_int ] == 1 ) set_pos ( playerid, 558.1899, 22.1904, 1049.2656, 356.7175, 1, ( i * 10 ) + 10 ) ;
		    else set_pos ( playerid, 501.2602, -383.9020, 1201.9317, 358.6749, 1, ( i * 10 ) + 10 ) ;
		    SetPVarInt ( playerid, "podezd_id", i + 1 ) ;
			return 1 ;
		}
		case pick_type_cannabis:
		{
			if ( b_info [ mafia_farm_id - 1 ] [ b_mafia ] == p_info [ playerid ] [ member ] )
		   	{
				new vehid = GetPlayerVehicleID ( playerid ) ;
				if ( ! vehid ) return 1 ;

		  		if ( veh_info [ vehid - 1 ] [ v_drugs ] < 1000 )
		    	{
					if ( GetVehicleModel ( vehid ) == 532 )
					{
					    for ( new i = 0 ; i < 100 ; i ++ )
					    {
					        if ( pickupid != CannabisPickup [ i ] ) continue ;

							veh_info [ vehid - 1 ] [ v_drugs ] += 30 ;
							DestroyCannabisPickup ( i ) ;
							CannabisDeleted [ i ] = true ;
							new narko_text [ 34 ] ;
							format ( narko_text, sizeof narko_text, "~g~DRUGS IN CAR:~w~ %d", veh_info [ vehid - 1 ] [ v_drugs ] ) ;
							GameTextForPlayer ( playerid, narko_text, 3000, 3 ) ;
							return 1 ;
						}
					}
			 	}
			}
		}
	}
	return 1 ;
}

stock DestroyCannabisPickup ( cannabis )
{
    if ( IsValidDynamicPickup ( CannabisPickup [ cannabis ] ) ) DestroyDynamicPickup ( CannabisPickup [ cannabis ] ) ;
    return 1 ;
}

