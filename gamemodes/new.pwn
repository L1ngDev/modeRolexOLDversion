		TextWarehousePriton [ 0 ] = CreateDynamic3DTextLabel ( "** Притон **\n{"#cGR3D"}Зона разгрузки", col_header_3d, priton_position [ 0 ], priton_position [ 1 ], priton_position [ 2 ], 15.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, -1, -1);
