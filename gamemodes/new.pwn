				    GetPlayerFacingAngle ( i, last_coord [ i ] [ 3 ] ) ;

				    last_virt [ i ] = GetPlayerVirtualWorld ( i ) ;
				    last_int [ i ] = GetPlayerInterior ( i ) ;

				    set_pos ( i, admin_mp_pos [ 0 ], admin_mp_pos [ 1 ], admin_mp_pos [ 2 ], admin_mp_pos [ 3 ], admin_mp_int, admin_mp_virt ) ;
		        }

		        callcmd::mp ( playerid ) ;
		        return 1 ;
		    }
		    else if ( listitem == 1 )
		    {
		        new _team = GetPVarInt ( playerid, "mp_listitem" ) + 1 ;
		        DeletePVar ( playerid, "mp_listitem" ) ;

		        foreach(new i: fraction_players[_team])
		        {
		            if ( ! player_mp [ i ] ) continue ;

		            player_mp [ i ] = false, p_t_info [ i ] [ mp_team ] = 0 ;
