				case 13:
				{
					show_dialog ( playerid, d_help_box, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Донат счёт", "{"#cBL"}Общее положение:\n\n\
					{"#cWH"}Донат - это благотварительность на продвижение и функционирование сервера на добровольной основе.\n\
					Пополняя Ваш {"#cLY"}основной {"#cWH"}донат счёт Вы помогаете в продвижении проекта, привлечении новой аудитории,\n\
					обеспечение жизнедеятельности сервера и обновлений.\n\n\
					На проекте имеется 2 донат счёта:\n\
					{"#cGRDialog"}Бонусный счёт {"#cWH"}- это счёт, который пополняется в знак благодарности за игру на сервере.\n\
					Потратить Вы его можете в {"#cLY"}/donate{"#cWH"}, где есть приписка {"#cLY"}'БОНУСНЫЙ'{"#cWH"}.\n\
					{"#cGRDialog"}Основной счёт {"#cWH"}- это счёт, который Вы пополняете самостоятельно через "site_name".\n\
					На него Вы можете приобретать любые позиции из меню {"#cLY"}/donate{"#cWH"}. Также его можно пополнять\n\
					выполняя разные задания, например, семейные.", "Назад", "Закрыть" ) ;
				}
				case 14:
				{
					show_dialog ( playerid, d_help_box, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Обмен / трейд", "{"#cBL"}Обмен:\n\n\
					{"#cWH"}Вы можете обменяться {"#cLY"}любым {"#cWH"}имуществом для этого обратитесть в {"#cLY"}/gps - Бизнесы - Риелторское агентство{"#cWH"}.\n\
					При обмене Вы можете предложить всё, что угодно, как и тот, с кем Вы меняетесь.\n\
					Настоятельно рекомендуем не ждать чего-либо, а меняться сразу на оговоренное.\n\n\
					{"#cRInfo"}Администрация не несёт ответственности за Вашу невнимательность!\n\
					Мы Вас не ограничиваем в обмене и даём возможность обменять всё сразу!\n\
					Не нужно верить в то, что игрок что-то сперва помериет, а потом, если всё устроит,\n\
					то отдаст обещанное!\n\n\
					МЕНЯЙТЕСЬ НА ВСЁ СРАЗУ, НЕ ЖДИТЕ НИКАКИХ ПРИМЕРОК И ТОМУ ПОДОБНОГО!", "Назад", "Закрыть" ) ;
				}
				case 15:
				{
					show_dialog ( playerid, d_help_box, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Исправительная колония", "{"#cBL"}Общее положение:\n\n\
					{"#cWH"}Исправительная колония - это место, где заключённые отбывают срок наказания.\n\
