			if ( bank_info [ playerid ] [ bi_id ] [ get_player_use_listitem ( playerid ) ] == _value ) return show_dialog ( playerid, d_deposit_transfer_id, DIALOG_STYLE_INPUT, "{"#cBHD"}Перевод", "{"#cRD"}* Вы не можете переводить деньги на этот же номер счёта.\n\n{ffffff}Введите номер счёта:", "Принять", "Назад" ) ;

			new sql_string [ 70 + 9 ] ;
			mysql_format ( sql_connection, sql_string, sizeof sql_string, "SELECT `db_owner` FROM `deposit_boxes` WHERE `db_id` = '%d' LIMIT 1", GetPVarInt ( playerid, "dl_from" ) ) ;
			mysql_tquery ( sql_connection, sql_string, "check_deposit_box", "ii", playerid, _value ) ;
			return 1 ;
		}
		case d_deposit_transfer_money:
		{
			if ( ! response  )
			{
				DeletePVar ( playerid, "todb_id" ) ;
				show_dialog ( playerid, d_deposit_transfer_id, DIALOG_STYLE_INPUT, "{"#cBHD"}Перевод", "{ffffff}Введите номер счёта:", "Принять", "Назад" ) ;
				return 1 ;
			}
			new _deposit_num = get_player_use_listitem ( playerid ),
				_todb_id = GetPVarInt ( playerid, "todb_id" ),
				_db_id = bank_info [ playerid ] [ bi_id ] [ _deposit_num ],
				_value = strval ( inputtext ) ;
			if ( _value < 1000 || _value > 50000000 )
			{
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Сумма перевода не может быть меньше {"#cRD"}1.000"valute_title_"{"#cGRInfo"} или больше {"#cRD"}50.000.000"valute_title_"" ) ;

				new sql_string [ 70 + 9 ] ;
				mysql_format ( sql_connection, sql_string, sizeof sql_string, "SELECT `db_owner` FROM `deposit_boxes` WHERE `db_id` = '%d' LIMIT 1", _todb_id ) ;
				mysql_tquery ( sql_connection, sql_string, "check_deposit_box", "ii", playerid, _todb_id ) ;
				return 1 ;
			}

			new _db_money = bank_info [ playerid ] [ bi_money ] [ _deposit_num ] ;
			if ( _db_money < _value )
			{
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}На вашем счету недостаточно средств." ) ;

				new sql_string [ 70 + 9 ] ;
				mysql_format ( sql_connection, sql_string, sizeof sql_string, "SELECT `db_owner` FROM `deposit_boxes` WHERE `db_id` = '%d' LIMIT 1", _todb_id ) ;
				mysql_tquery ( sql_connection, sql_string, "check_deposit_box", "ii", playerid, _todb_id ) ;
				return 1 ;
			}

			new query_string [ 70 + 11 ] ;
			format ( query_string, sizeof ( query_string ), "SELECT `db_owner` FROM `deposit_boxes` WHERE `db_id` = '%d' LIMIT 1", _todb_id ) ;
			mysql_tquery ( sql_connection, query_string, "get_banker_id", "iiii", playerid, _db_id, _todb_id, _value ) ;

			DeletePVar ( playerid, "todb_id" ) ;
			return 1 ;
		}
