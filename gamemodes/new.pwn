			if ( GetInventoryFindItem ( playerid, SUB_INVENTORY, 2159 ) + d_amount > 500 ) return show_dialog ( playerid, d_drug_dealer_drug, DIALOG_STYLE_INPUT, "{"#cBHD"}Наркоторговец", "{"#cRD"}* Вы не можете унести более 500 гр. наркотиков.\n\n{"#cWH"}Введите количество грамм наркотиков, которое желаете приобрести:\n\n{"#cGRDialog"}* Стоимость 1 гр. наркотиков составляет - {"#cWH"}100"valute_title"{"#cGRDialog"}.", "Купить", "Закрыть" ) ;
			if ( p_info [ playerid ] [ money ] < d_amount * 100 ) return show_dialog ( playerid, d_drug_dealer_drug, DIALOG_STYLE_INPUT, "{"#cBHD"}Наркоторговец", "{"#cRD"}* У Вас нет такого количества денег.\n\n{"#cWH"}Введите количество грамм наркотиков, которое желаете приобрести:\n\n{"#cGRDialog"}* Стоимость 1 гр. наркотиков составляет - {"#cWH"}100"valute_title"{"#cGRDialog"}.", "Купить", "Закрыть" ) ;
			if ( PritonDrugs < d_amount ) return show_dialog ( playerid, d_drug_dealer_drug, DIALOG_STYLE_INPUT, "{"#cBHD"}Наркоторговец", "{"#cRD"}* В притоне недостаточно наркотиков.\n\n{"#cWH"}Введите количество грамм наркотиков, которое желаете приобрести:\n\n{"#cGRDialog"}* Стоимость 1 гр. наркотиков составляет - {"#cWH"}100"valute_title"{"#cGRDialog"}.", "Купить", "Закрыть" ) ;

            PritonDrugs -= d_amount ;
			give_inventory ( playerid, 2155, d_amount, 0, "", "", NUMBERPLATE_TYPE_NONE, 0 ) ;

			give_money ( playerid, -d_amount * 100 ) ;
			insert_money_log ( playerid, INVALID_PLAYER_ID, -d_amount * 100, "покупка нарко" ) ;

