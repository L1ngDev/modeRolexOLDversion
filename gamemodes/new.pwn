CMD:home ( playerid )
{
	if ( ! Iter_Count(player_houses[playerid]) )
	{
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас в собственности нет недвижимости." ) ;
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте {"#cRInfo"}/ad{"#cGRInfo"}, чтоб подать объявление о покупке дома." ) ;
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте {"#cRInfo"}/gps - Бизнесы - Риелторское агентство{"#cGRInfo"}, чтоб найти свободные дома." ) ;
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте {"#cRInfo"}/gps - Бизнесы - Отели{"#cGRInfo"}, чтоб временно заселиться в отель." ) ;
		return 1 ;
	}

	show_home ( playerid ) ;
	return 1 ;
}

stock show_home ( playerid )
{
	if ( Iter_Count(player_houses[playerid]) == 1 )
	{
	    p_info [ playerid ] [ house ] = Iter_First(player_houses[playerid]) ;
        new s_house_id = p_info [ playerid ] [ house ] - 1 ;
        if ( h_info [ s_house_id ] [ h_podezd ] != -1 )
	    {
	    	new _padik_id = h_info [ s_house_id ] [ h_podezd ] ;
			SetPlayerRaceCheckpoint ( playerid, 1, podezd_info [ _padik_id ] [ p_pos ] [ 0 ], podezd_info [ _padik_id ] [ p_pos ] [ 1 ], podezd_info [ _padik_id ] [ p_pos ] [ 2 ], 0.0, 0.0, 0.0, 4.0 ) ;
		}
		else SetPlayerRaceCheckpoint ( playerid, 1, h_info [ s_house_id ] [ h_pos ] [ 0 ], h_info [ s_house_id ] [ h_pos ] [ 1 ], h_info [ s_house_id ] [ h_pos ] [ 2 ], 0.0, 0.0, 0.0, 4.0 ) ;
		SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Ваш дом обозначен на карте красной меткой." ) ;
		is_gps_used { playerid } = 1 ;
	}
	else
	{
	    global_string [ 0 ] = EOS ;
	    new line_string [ 128 ], count_h = 0 ;
	    foreach(new h: player_houses[playerid])
	    {
	        set_player_listitem_values ( playerid, count_h, h ) ;

	        count_h ++ ;

			format ( line_string, sizeof line_string, "{"#cBL"}%d.{"#cWH"} %s - {"#cBL"}№%d {"#cGRDialog"}(%s{"#cGRDialog"})\n", count_h, house_classes [ house_int [ h_info [ h - 1 ] [ h_int ] - 1 ] [ hint_class ] ], h, ( h_info [ h - 1 ] [ h_closed ] ) ? ( "{"#cRD"}Закрыт" ) : ( "{"#cGN"}Открыт" ) ) ;
			strcat ( global_string, line_string ) ;
		}
	    show_dialog ( playerid, d_home_select, DIALOG_STYLE_LIST, "{"#cBHD"}Дома", global_string, "Выбрать", "Закрыть" ) ;
	}
	return 1 ;
}

stock show_home_heal ( playerid, list_item, price )
{
	if ( Iter_Count(player_houses[playerid]) == 1 )
	{
	    new b = GetPVarInt ( playerid, "p_biz_id" ) - 1 ;

	    p_info [ playerid ] [ house ] = Iter_First(player_houses[playerid]) ;

		new _h_id = p_info [ playerid ] [ house ] ;
        h_info[ _h_id - 1 ] [ h_heal ] += get_player_use_listitem ( playerid ) ;

		SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы приобрели аптечки в дом." ) ;

		give_bmoney ( b + 1, price, b_shop_product [ list_item ] ) ;

		ShowShopDialog ( playerid, 1 ) ;
		give_money ( playerid, -price ) ;
		insert_money_log ( playerid, INVALID_PLAYER_ID, -price, "Закуп 24/7" ) ;
	}
	else
	{
	    global_string [ 0 ] = EOS ;
	    new line_string [ 128 ], count_h = 0 ;
