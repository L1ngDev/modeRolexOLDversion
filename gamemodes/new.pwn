	    format ( line_string, sizeof line_string, "{"#cGRDialog"}- {"#cWH"}Регистрация номеров: {"#cGN"}%d"valute_title_"\n", f_info [ fractionid - 1 ] [ f_money_statistic ] [ 3 ] ) ;
    	strcat ( global_string, line_string ) ;
    	format ( line_string, sizeof line_string, "{"#cGRDialog"}- {"#cWH"}Внесение залога: {"#cGN"}%d"valute_title_"\n\n", f_info [ fractionid - 1 ] [ f_money_statistic ] [ 4 ] ) ;
    	strcat ( global_string, line_string ) ;
	}
	else if ( fbi_player ( playerid ) )
	{
	    format ( line_string, sizeof line_string, "{"#cGRDialog"}- {"#cWH"}Перехват посылок: {"#cGN"}%d"valute_title_"\n", f_info [ fractionid - 1 ] [ f_money_statistic ] [ 0 ] ) ;
	   	strcat ( global_string, line_string ) ;
    	format ( line_string, sizeof line_string, "{"#cGRDialog"}- {"#cWH"}Конфискация: {"#cGN"}%d"valute_title_"\n\n", f_info [ fractionid - 1 ] [ f_money_statistic ] [ 4 ] ) ;
	   	strcat ( global_string, line_string ) ;
	}
	else if ( radio_player ( playerid ) )
	{
    	format ( line_string, sizeof line_string, "{"#cGRDialog"}- {"#cWH"}Звонки в студию: {"#cGN"}%d"valute_title_"\n\n", f_info [ fractionid - 1 ] [ f_money_statistic ] [ 3 ] ) ;
    	strcat ( global_string, line_string ) ;
    	format ( line_string, sizeof line_string, "{"#cGRDialog"}- {"#cWH"}Объявления: {"#cGN"}%d"valute_title_"\n\n", f_info [ fractionid - 1 ] [ f_money_statistic ] [ 3 ] ) ;
		strcat ( global_string, line_string ) ;
	}
	else if ( p_info [ playerid ] [ member ] == 10 )
	{
    	format ( line_string, sizeof line_string, "{"#cGRDialog"}- {"#cWH"}Продажа лицензий: {"#cGN"}%d"valute_title_"\n\n", f_info [ fractionid - 1 ] [ f_money_statistic ] [ 3 ] ) ;
    	strcat ( global_string, line_string ) ;
	}
	else if ( medic_player ( playerid ) )
	{
    	format ( line_string, sizeof line_string, "{"#cGRDialog"}- {"#cWH"}Лечение: {"#cGN"}%d"valute_title_"\n\n", f_info [ fractionid - 1 ] [ f_money_statistic ] [ 3 ] ) ;
    	strcat ( global_string, line_string ) ;
	}

	strcat ( global_string, "{"#cBL"}** Отчисление средств **\n\n" ) ;
   	format ( line_string, sizeof line_string, "{"#cGRDialog"}- {"#cWH"}Премиальная зарплата: {"#cGN"}%d"valute_title_"\n", f_info [ fractionid - 1 ] [ f_money_statistic_minus ] [ 0 ] ) ;
   	strcat ( global_string, line_string ) ;
   	format ( line_string, sizeof line_string, "{"#cGRDialog"}- {"#cWH"}Обслуживание транспорта: {"#cGN"}%d"valute_title_"\n\n", f_info [ fractionid - 1 ] [ f_money_statistic_minus ] [ 4 ] ) ;
   	strcat ( global_string, line_string ) ;

	new pribil_team, minus_team ;
	for ( new i ; i < 5 ; i++ )
	{
	    pribil_team += f_info [ fractionid - 1 ] [ f_money_statistic ] [ i ] ;

	    minus_team -= f_info [ fractionid - 1 ] [ f_money_statistic_minus ] [ i ] ;
	}

	format ( line_string, sizeof line_string, "{"#cGRDialog"}- {"#cWH"}Профицит: {"#cGN"}%d"valute_title_"", pribil_team - minus_team ) ;
	strcat ( global_string, line_string ) ;

	show_dialog ( playerid, d_budget_exit, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Финансовая статистика", global_string, "Назад", "" ) ;
	return 1 ;
}

callback: callback_fractions_profit ( playerid )
{
    global_string [ 0 ] = EOS ;
	new rows, fields;
	cache_get_data(rows, fields);
	if ( ! rows )
	{
	    page_count [ playerid ] = 0 ;
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Активных логов не найдено." ) ;
		return 1 ;
	}

	page_rows [ playerid ] = rows ;
    new rows_list = page_count [ playerid ] - 1 ;
    global_string [ 0 ] = EOS ;
	new line_string [ 128 ], row_count ;
	for ( new i = rows_list * 10 ; i <  rows_list * 10 + 10 ; i ++ )
	{
	    if ( i >= rows ) break ;

	    new _t_name [ 16 ], _t_date [ 16 ], _t_id ;
	    _t_id = cache_get_field_content_int ( i, "f_log_id", sql_connection ) ;

		cache_get_field_content ( i, "f_start_date", _t_name, sql_connection, 16 ) ;
		cache_get_field_content ( i, "f_end_date", _t_date, sql_connection, 16 ) ;

		set_player_listitem_values ( playerid, i - rows_list * 10, _t_id ) ;

		format(line_string, sizeof(line_string), "{"#cBL"}%d. {"#cWH"}%s - %s\n", i + 1, _t_name, _t_date);
		strcat ( global_string, line_string ) ;

		row_count ++ ;
	}

	if ( rows_list > 0 )
	{
		strcat ( global_string, "{"#cBL"}Предыдущая страница\n" ) ;
		set_player_use_page ( playerid, row_count, 0 ) ;
		row_count ++ ;
	}
	if ( ofm_formula ( page_count [ playerid ] ) < rows )
	{
		strcat ( global_string, "{"#cBL"}Следующая страница\n" ) ;
		set_player_use_page ( playerid, row_count, 1 ) ;
	}

	show_dialog ( playerid, d_fr_profit_lognext, DIALOG_STYLE_LIST, "{"#cBHD"}Финансовая история", global_string, "Выбрать", "Закрыть" ) ;
	return 1 ;
}

callback: fractions_profits ( )
{
    new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows ) return 1 ;

	new _statistic [ max_fraction ] [ 5 ], _statistic_minus [ max_fraction ] [ 5 ], _f_id [ max_fraction ] ;
	for ( new i = 0 ; i < rows ; i ++ )
	{
        _f_id [ i ] = cache_get_field_content_int ( i, "f_id", sql_connection ) ;

		global_string [ 0 ] = EOS ;
		cache_get_field_content ( i, "f_money_statistic", global_string ), sscanf ( global_string, "p<|>ddddd",
		_statistic [ i ] [ 0 ], _statistic [ i ] [ 1 ], _statistic [ i ] [ 2 ], _statistic [ i ] [ 3 ], _statistic [ i ] [ 4 ] ) ;

        global_string [ 0 ] = EOS ;
		cache_get_field_content ( i, "f_money_statistic_minus", global_string ), sscanf ( global_string, "p<|>ddddd",
		_statistic_minus [ i ] [ 0 ], _statistic_minus [ i ] [ 1 ], _statistic_minus [ i ] [ 2 ], _statistic_minus [ i ] [ 3 ], _statistic_minus [ i ] [ 4 ] ) ;
	}
	for	( new i = 0 ; i < rows ; i ++ )
	{
	    new query_string [ 356 ] ;
        format ( query_string, sizeof query_string, "INSERT INTO `fractions_profit` (`f_id`,`f_money_statistic`,`f_money_statistic_minus`,`f_start_date`,`f_end_date`) VALUES ('%d','%d|%d|%d|%d|%d','%d|%d|%d|%d|%d',NOW()-INTERVAL 7 DAY,NOW())",
		_f_id [ i ], _statistic [ i ] [ 0 ], _statistic [ i ] [ 1 ], _statistic [ i ] [ 2 ], _statistic [ i ] [ 3 ], _statistic [ i ] [ 4 ],
		_statistic_minus [ i ] [ 0 ], _statistic_minus [ i ] [ 1 ], _statistic_minus [ i ] [ 2 ], _statistic_minus [ i ] [ 3 ], _statistic_minus [ i ] [ 4 ] ) ;
		mysql_query ( sql_connection, query_string, false ) ;
	}
	mysql_tquery ( sql_connection, "UPDATE `fractions` SET `f_money_statistic` = '0|0|0|0|0', `f_money_statistic_minus` = '0|0|0|0|0'" ) ;
	return 1 ;
}

CMD:car_play ( playerid )
{
	if ( GetPlayerState ( playerid ) != PLAYER_STATE_DRIVER ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не водитель." ) ;
    show_dialog ( playerid, d_recorder, DIALOG_STYLE_LIST, "{"#cBHD"}Аудио-система", "{"#cBL"}1. {"#cWH"}Радио\n{"#cRD"}Отключить", "Выбор", "Выход" ) ;
	SetPVarInt ( playerid, "car_audio", 1 ) ;
	return 1 ;
}

stock show_debtors_mayor ( playerid )
{
    if ( p_t_info [ playerid ] [ debt_house ] != -1 ) p_t_info [ playerid ] [ debt_house ] = -1 ;
	if ( p_t_info [ playerid ] [ debt_business ] != -1 ) p_t_info [ playerid ] [ debt_business ] = -1 ;
 	if ( p_t_info [ playerid ] [ debt_cellar ] != -1 ) p_t_info [ playerid ] [ debt_cellar ] = -1 ;
    show_dialog ( playerid, d_debtors_mayor, DIALOG_STYLE_LIST, "{"#cBHD"}Опечатка", "{"#cBL"}1. {"#cWH"}Дома\n{"#cBL"}2. {"#cWH"}Бизнесы\n{"#cBL"}3. {"#cWH"}Гаражи", "Выбрать", "Закрыть");
	return 1 ;
}

stock debtorsHouse ( playerid, page )
{
	page_count [ playerid ] = page ;

	new count = 0, _h_count = 0 ;

	global_string [ 0 ] = EOS ;
	strcat ( global_string, "{"#cBL"}№. Владелец:\t{"#cBL"}Класс:\t{"#cBL"}Оплата:\n" ) ;
  	for ( new h = 0 ; h < house_count ; h ++ )
	{
	    if ( ! h_info [ h ] [ h_sell_status ] || h_info [ h ] [ h_sell_status ] == 2 ) continue ;

		_h_count ++ ;

		if ( page * 20 > h ) continue ;
  		if ( h > ( page + 1 ) * 20 ) break ;

  		set_player_listitem_values ( playerid, count, h ) ;
		count ++ ;

		format ( global_string, sizeof global_string, "%s{"#cBL"}%d. {"#cWH"}%s\t%s\t{"#cGN"}%d"valute_title_"\n", global_string, h + 1, h_info [ h ] [ h_owner_name ], house_classes [ house_int [ h_info [ h ] [ h_int ] - 1 ] [ hint_class ] ], floatround ( ( h_info [ h ] [ h_price ] * 5 ) / 100 ) ) ;
	}

	if ( page > 0 ) strcat ( global_string, "{"#cBL"}Предыдущая страница\n" ) ;
	if ( _h_count > ( page + 1 ) * 20 ) strcat ( global_string, "{"#cBL"}Следующая страница" ) ;

	if ( ! _h_count ) show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Дома", "{"#cRInfo"}* Нет имущества, которое нужно опечатать!", "Закрыть", "" ) ;
	else show_dialog ( playerid, d_debtors_house_select, DIALOG_STYLE_TABLIST_HEADERS, "{"#cBHD"}Дома", global_string, "Выбрать", "Закрыть" ) ;
    return true ;
}

