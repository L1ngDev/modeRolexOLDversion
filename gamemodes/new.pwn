callback: callback_debtor_property ( playerid )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows )
	{
	    DeletePVar ( playerid, "debt_uid" ) ;
		DeletePVar ( playerid, "ofm_listitem" ) ;
		getDebtorsInfo ( playerid, page_count [ playerid ], 1 ) ;
		return 1 ;
	}
	if ( rows )
	{
		new pl_id, pl_tax, pl_cellar ;

		pl_id = cache_get_field_content_int ( 0, "u_id", sql_connection ) ;
		pl_tax = cache_get_field_content_int ( 0, "u_tax", sql_connection ) ;
		pl_cellar = cache_get_field_content_int ( 0, "u_cellar", sql_connection ) ;

        new dialog_string [ 300 ] ;

		new house_data [ 64 ] ;
		format ( house_data, 64, "Дома игрока {"#cGRDialog"}({"#cBL"}%d{"#cGRDialog"}){"#cWH"}\n", debt_house_count [ playerid ] ) ;

		new business_date [ 64 ] ;
		format ( business_date, 64, "Бизнесы игрока {"#cGRDialog"}({"#cBL"}%d{"#cGRDialog"}){"#cWH"}\n", debt_business_count [ playerid ] ) ;

		new garage_date [ 32 ] ;
		if ( pl_cellar != -1 )
		{
		    if ( cellar_info [ pl_cellar - 1 ] [ cl_sell_status ] )
			{
			    SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Имущество игрока уже подгатавливается к опечатке." ) ;

			    DeletePVar ( playerid, "debt_uid" ) ;
				DeletePVar ( playerid, "ofm_listitem" ) ;
				getDebtorsInfo ( playerid, page_count [ playerid ], 1 ) ;
				return 1 ;
			}

			format ( garage_date, 32, "гараж № %d (%d"valute_title_")\n", pl_cellar, cellar_info [ pl_cellar - 1 ] [ cl_price ] ) ;
		}
		else format ( garage_date, 32, "Гараж отсутствует\n" ) ;

		strcat ( dialog_string, house_data ) ;
		strcat ( dialog_string, business_date ) ;
		strcat ( dialog_string, garage_date ) ;

		SetPVarInt ( playerid, "debt_uid", pl_id ) ;
		SetPVarInt ( playerid, "debt_garage", pl_cellar ) ;
		SetPVarInt ( playerid, "debt_tax", pl_tax ) ;

		show_dialog ( playerid, d_debtor_sell, DIALOG_STYLE_LIST, "{"#cBHD"}Изъятие недвижимости", dialog_string, "Выбрать", "Назад" ) ;

	}
	return 1 ;
}

callback: callback_debtor_bankmoney ( playerid, bank_card, bank_money )
{
	new rows, fields;
	cache_get_data ( rows, fields ) ;
	if ( rows )
	{
		new pl_id, pl_tax, pl_name [ 32 ] ;

		pl_id = cache_get_field_content_int ( 0, "u_id", sql_connection ) ;
		pl_tax = cache_get_field_content_int ( 0, "u_tax", sql_connection ) ;
		cache_get_field_content ( 0, "u_name", pl_name, sql_connection, 32 ) ;

		new player_id, _text_string [ 144 ] ;
		sscanf ( pl_name, "u", player_id ) ;
		if ( IsPlayerConnected ( player_id ) )
		{
			if ( bank_money > pl_tax )
			{
				format(_text_string, 128, "UPDATE `users` SET `u_tax` = '0' WHERE `u_id` = '%d' LIMIT 1", pl_id ) ;
				mysql_tquery ( sql_connection, _text_string ) ;

				for ( new b = 0 ; b < MAX_BANK_ACCOUNT ; b ++ )
				{
				    if ( bank_info [ player_id ] [ bi_id ] [ b ] == bank_card )
				    {
				        bank_info [ player_id ] [ bi_money ] [ b ] -= pl_tax ;

						format(_text_string, 128, "UPDATE `deposit_boxes` SET `db_money` = '%d' WHERE `db_id` = '%d' LIMIT 1", bank_info [ player_id ] [ bi_money ] [ b ], bank_info [ player_id ] [ bi_id ] [ b ] ) ;
						mysql_tquery ( sql_connection, _text_string ) ;

						break ;
					}
				}

				p_info [ player_id ] [ tax ] = 0 ;

                set_money_fraction ( 10, 3, floatround ( ( pl_tax * 50 ) / 100 ), true ) ;
			}
			else
			{
				for ( new b = 0 ; b < MAX_BANK_ACCOUNT ; b ++ )
				{
				    if ( bank_info [ player_id ] [ bi_id ] [ b ] == bank_card )
				    {
				        format(_text_string, 128, "UPDATE `users` SET `u_tax` = u_tax-'%d' WHERE `u_id` = '%d' LIMIT 1", bank_info [ player_id ] [ bi_money ] [ b ], pl_id ) ;
						mysql_tquery ( sql_connection, _text_string ) ;

				        bank_info [ player_id ] [ bi_money ] [ b ] = 0 ;

						format(_text_string, 128, "UPDATE `deposit_boxes` SET `db_money` = '%d' WHERE `db_id` = '%d' LIMIT 1", bank_info [ player_id ] [ bi_money ] [ b ], bank_info [ player_id ] [ bi_id ] [ b ] ) ;
						mysql_tquery ( sql_connection, _text_string ) ;

						break ;
					}
				}

				p_info [ player_id ] [ tax ] -= bank_money ;

                set_money_fraction ( 10, 3, floatround ( ( bank_money * 50 ) / 100 ), true ) ;
			}
			SendClientMessage ( player_id, col_gray, !"* Сотрудники мэрии списали с Вашего счёта средства в счёт уплаты налогов." ) ;
			SendClientMessage ( player_id, col_gray, !"* В следующий раз будьте усмотрительнее при выплатах налогов." ) ;
		}
		else
		{
			insert_debtor_message ( "Налоги", "С Вашего банковского счёта была списана часть средств для погашение налогового долга.", GetPVarInt ( playerid, "debt_uid" ) ) ;
			if ( bank_money > pl_tax )
			{
				format(_text_string, 128,"UPDATE `users` SET `u_tax` = '0' WHERE `u_id` = '%d' LIMIT 1", pl_id ) ;
				mysql_tquery ( sql_connection, _text_string ) ;

				format(_text_string, 128, "UPDATE `deposit_boxes` SET `db_money` = `db_money`-'%d' WHERE `db_id` = '%d' LIMIT 1", pl_tax, bank_card ) ;
				mysql_tquery ( sql_connection, _text_string ) ;

				set_money_fraction ( 10, 3, floatround ( ( pl_tax * 50 ) / 100 ), true ) ;
			}
			else
			{
				format(_text_string, 128,"UPDATE `users` SET `u_tax` = u_tax-'%d' WHERE `u_id` = '%d' LIMIT 1", bank_money, pl_id ) ;
				mysql_tquery ( sql_connection, _text_string ) ;

				format(_text_string, 128, "UPDATE `deposit_boxes` SET `db_money` = '0' WHERE `db_id` = '%d' LIMIT 1", pl_tax, bank_card ) ;
				mysql_tquery ( sql_connection, _text_string ) ;

				set_money_fraction ( 10, 3, floatround ( ( bank_money * 50 ) / 100 ), true ) ;
			}
		}

		write_fraction ( playerid, p_info [ playerid ] [ member ], TYPE_LOG_OBWYAK, "Списал(а) долг со счета" ) ;

		SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Средства должника успешно списаны с его счёта." ) ;
		DeletePVar ( playerid, "debt_house" ) ;
		DeletePVar ( playerid, "debt_business" ) ;
		DeletePVar ( playerid, "debt_tax" ) ;
		DeletePVar ( playerid, "debt_uid" ) ;
		DeletePVar ( playerid, "ofm_listitem" ) ;
		getDebtorsInfo ( playerid, page_count [ playerid ], 1 ) ;
	}
	return 1 ;
}

callback: load_debtor_messages ( playerid )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;

	if ( rows )
	{
		new Node: node = JSON_Array ( ), message [ 256 ], messageDate, itemsLoaded = 0 ;
		for ( new i = 0, Node: messageNode ; i < rows ; i ++ )
		{
			cache_get_field_content ( i, "dm_text", message ) ;
			messageDate = cache_get_field_content_int ( i, "dm_date" ) ;

			messageNode = JSON_Array (
				JSON_Object (
					"date",		JSON_Int ( messageDate ),
					"info",		JSON_String ( message )
				)
			) ;
			node = JSON_Append ( node, messageNode ) ;

			if ( ++ itemsLoaded == 5 )
			{
				global_string [ 0 ] = EOS ;
				JSON_Stringify ( node, global_string, sizeof global_string ) ;
				onServerSendData ( playerid, UI_OFFLINE_NOTIFICATION, 0, global_string ) ;

				node = JSON_Array ( ) ;
				itemsLoaded = 0 ;
			}
		}

		if ( itemsLoaded )
		{
			global_string [ 0 ] = EOS ;
			JSON_Stringify ( node, global_string, sizeof global_string ) ;
			onServerSendData ( playerid, UI_OFFLINE_NOTIFICATION, 0, global_string ) ;

			node = JSON_Array ( ) ;
			itemsLoaded = 0 ;
		}
	}
	return 1 ;
}

callback: change_donate_name ( playerid, donate_name [ ] )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( rows )
	{
		show_dialog ( playerid, d_donate_rename, DIALOG_STYLE_INPUT, "{"#cBHD"}Донат услуги", "{"#cRD"}* Данный никнейм уже занят.\n\n{"#cGRDialog"}- {"#cWH"}Смена Ник-Нейма:\n\n{"#cGRDialog"}* Цена: {"#cGN"}100 "donate_title"{"#cGRDialog"}.\n{"#cGRDialog"}* Вы действительно хотите сменить Ваш \"{"#cWH"}Ник-Нейм{"#cGRDialog"}\".","Принять", "Назад");
		return 1 ;
	}

	new pl_id ;
	sscanf ( donate_name, "u", pl_id ) ;
	if ( IsPlayerConnected ( pl_id ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок с таким именем подключён к серверу." )  ;

	new sql_string [ 228 ] ;
	format ( sql_string, sizeof ( sql_string ), "UPDATE `users` SET `u_name` = '%s' WHERE `u_id` = '%d' LIMIT 1", donate_name, p_info [ playerid ] [ id ] ) ;
	mysql_tquery ( sql_connection, sql_string ) ;

	if ( admin_info [ playerid ] [ admin ] != 0 )
	{
		format ( sql_string, sizeof ( sql_string ), "UPDATE `users_admins` SET `u_a_name` = '%s' WHERE `u_a_id` = '%d' LIMIT 1", donate_name, p_info [ playerid ] [ id ] ) ;
		mysql_tquery ( sql_connection, sql_string ) ;
	}
	format ( sql_string, sizeof ( sql_string ), "UPDATE `fractions_blacklist` SET `bl_name` = '%s' WHERE `bl_name` = '%s'", donate_name, p_info [ playerid ] [ name ] ) ;
	mysql_tquery ( sql_connection, sql_string ) ;

	format ( sql_string, sizeof ( sql_string ), "UPDATE `fractions_blacklist` SET `bl_add_name` = '%s' WHERE `bl_add_name` = '%s'", donate_name, p_info [ playerid ] [ name ] ) ;
	mysql_tquery ( sql_connection, sql_string ) ;

	if ( Iter_Count(player_houses[playerid]) > 0 )
	{
	    foreach(new h: player_houses[playerid])
	    {
	        strmid( h_info [ h - 1 ] [ h_owner_name ], donate_name, 0, strlen ( donate_name ), 31 ) ;
	    }
	}
	if ( Iter_Count(player_business[playerid]) > 0 )
    {
        foreach(new b: player_business[playerid])
        {
	   		strmid( b_info [ b - 1 ] [ b_owner_name ], donate_name, 0, strlen ( donate_name ), 31 ) ;
			update_blabel ( b - 1 ) ;
		}
	}
	if ( p_info [ playerid ] [ cellar ] != -1 )
    {
        strmid( cellar_info [ p_info [ playerid ] [ cellar ] - 1 ] [ cl_owner_name ], donate_name, 0, strlen ( donate_name ), 31 ) ;
    }

    #if defined m_familys
        familys_rename ( playerid, donate_name, p_info [ playerid ] [ name ] ) ;
	#endif

	format(sql_string, 138, "UPDATE `users_lottery` SET `u_name` = '%s' WHERE `u_id` = '%d' LIMIT 50", donate_name, p_info [ playerid ] [ id ] ) ;
	mysql_tquery ( sql_connection, sql_string ) ;

	format(sql_string, 138, "UPDATE `users_casino` SET `u_name` = '%s' WHERE `u_id` = '%d'", donate_name, p_info [ playerid ] [ id ] ) ;
	mysql_tquery ( sql_connection, sql_string ) ;

	format ( sql_string, 98,"* Ваш никнейм был изменен на: {"#cBL"}%s", donate_name ) ;
	SendClientMessage ( playerid, col_green, sql_string ) ;
	SendClientMessage ( playerid, col_green, !"* Рекомендуем вам перезайти в игру с новым никнеймом." ) ;
	format ( sql_string, 132, "{"#cBAdmin"}[A] {"#cGRAdmin"}%s сменил никнейм на %s", p_info [ playerid ] [ name ], donate_name ) ;
	foreach(new i: admin_players)SendClientMessage ( i, col_admin, sql_string ) ;

	//format( sql_string, 132, "<< %s сменил(а) имя на %s >>", p_info [ playerid ] [ name ], donate_name ) ;
	//foreach(new i: logged_players) if ( p_info [ i ] [ settings ] [ 2 ] ) SendClientMessage ( i, col_light_red, sql_string ) ;

	format ( sql_string, sizeof ( sql_string ), "INSERT INTO `nickname_history` (`nh_owner`,`nh_oldname`,`nh_newname`,`nh_date`,`nh_admin`) VALUES ('%d','%s','%s',NOW(),'donate')",
	p_info [ playerid ] [ id ], p_info [ playerid ] [ name ], donate_name ) ;
	mysql_tquery ( sql_connection, sql_string ) ;

	if ( ! player_rp_name [ playerid ] )
	{
	    give_money ( playerid, rename_reward ) ;
		insert_money_log ( playerid, INVALID_PLAYER_ID, rename_reward, "смена nRP ника" ) ;
		player_rp_name [ playerid ] = true ;
	}

    SetPlayerName ( playerid, donate_name ) ;
    format ( p_info [ playerid ] [ name ], MAX_PLAYER_NAME, "%s", donate_name ) ;

	set_player_donate ( playerid, 100, 2 ) ;

	show_donate ( playerid ) ;
	return 1 ;
}

callback: donate_unwarns ( playerid )
{
	new fields,
		rows ;

	cache_get_data ( rows, fields ) ;
	if ( ! rows )
	{
		show_dialog ( playerid, d_donate_unwarn, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Донат услуги","{"#cRD"}* У Вас нет предупреждений, которые можно было бы снять.\n\n{"#cGRDialog"}- {"#cWH"}Снять предупреждение:\n\n{"#cGRDialog"}* Цена: {"#cGN"}100 "donate_title"{"#cGRDialog"}.\n{"#cGRDialog"}* Вы действительно хотите снять \"{"#cWH"}Предупреждение{"#cGRDialog"}\"?","Принять", "Назад");
		return 1 ;
	}
	new warn_id = cache_get_field_content_int ( rows - 1, "w_id", sql_connection ) ;

	static const _str [ ] = "UPDATE `users_warns` SET `w_end` = NOW() WHERE `w_id` = '%d' LIMIT 1" ;
	new scm_string [ sizeof _str + 9 ] ;
	format ( scm_string, sizeof scm_string, _str, warn_id ) ;
	mysql_tquery ( sql_connection, scm_string ) ;

	p_info [ playerid ] [ p_warn ] -= 1 ;

	set_player_donate ( playerid, 200, 2 ) ;
	insert_donate_log ( playerid, INVALID_PLAYER_ID, 200, p_info [ playerid ] [ donate ], "(donate) unwarn" ) ;

	show_donate ( playerid ) ;
	SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Донат услуга успешно приобретена." ) ;
	return 1 ;
}

callback: donate_phone ( playerid, phone_number, phone_price )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( rows )
	{
		show_dialog ( playerid, d_donate_phone_list, DIALOG_STYLE_INPUT, "{"#cBHD"}Донат услуги","\
		{"#cRD"}* Данный номер уже занят другим человеком.\n\n\
		{"#cGRDialog"}- {"#cWH"}Смена номера телефона:\n\n\
		{"#cGRDialog"}* Цена на на 4-значный номер телефона: {"#cGN"}200 "donate_title"{"#cGRDialog"}.\n\
		{"#cGRDialog"}* Цена на на 5-значный номер телефона: {"#cGN"}150 "donate_title"{"#cGRDialog"}.\n\n\
		{"#cGRDialog"}* Введите номер телефона, который желаете приобрести:","Принять", "Назад");
		return 1 ;
	}

	new _return = give_inventory (
		playerid,
		ITEM_SIM_CARD,
		1,
		INVENTORY_TYPE_SIMCARD,
		"",
		"",
		NUMBERPLATE_TYPE_NONE,
		phone_number,
		-1
	) ;

	if ( _return == -1 )
		return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}В инвентаре недостаточно места." ) ;

    set_player_donate ( playerid, phone_price, 2 ) ;
	insert_donate_log ( playerid, INVALID_PLAYER_ID, phone_price, p_info [ playerid ] [ donate ], "(donate) номер телефона" ) ;

	if ( ! getPlayerAccessories ( playerid, ITEM_SIM_CARD ) )
	{
		new USER_ACCESSORIES_STRUCT: acsStruct [ _:ACS_STRUCTURE_MAX ] ;
		acsStruct [ _:ACS_ID ] = 0 ;
		acsStruct [ _:ACS_MODEL ] = ITEM_SIM_CARD ;
		acsStruct [ _:ACS_USED ] = 0 ;
		acsStruct [ _:ACS_DATE ] = -1 ;
		acsStruct [ _:ACS_COUNT ] = phone_number ;
		give_accessories ( playerid, getFreeSlotAccessories ( playerid ), acsStruct ) ;
	}
	else
	{
		p_info [ playerid ] [ number ] = phone_number ;
	}

	show_donate ( playerid ) ;
	SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Донат услуга успешно приобретена." ) ;
	return 1 ;
}

callback: donate_number ( playerid, veh_id )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( rows )
	{
	    DeletePVar ( playerid, "phone_number" ) ;
	    DeletePVar ( playerid, "phone_region" ) ;
	    DeletePVar ( playerid, "phone_type" ) ;

		show_dialog ( playerid, d_donate_number, DIALOG_STYLE_INPUT, "{"#cBHD"}Донат услуги","\
		{"#cRD"}* Данный номер уже занят другим человеком.\n\n\
		{"#cGR"}* Цена: {"#cGN"}500 "donate_title"{"#cGR"}.\n\n\
		{"#cGR"}- {"#cWH"}Критерии:\n\
		{"#cGR"}1. {"#cWH"}Необходимо указать тип номера.\n\
		{"#cGR"}2. {"#cWH"}Необходимо указать сам номер.\n\
		{"#cGR"}3. {"#cWH"}Необходимо указать регион.\n\n\
		{"#cGR"}- {"#cWH"}Типы номеров:\n\
		{"#cGR"}Тип 2. {"#cWH"}Русские номера.\n\
		{"#cGR"}Тип 3. {"#cWH"}Украинские номера.\n\
		{"#cGR"}Тип 4. {"#cWH"}Белоруские номера.\n\
		{"#cGR"}Тип 5. {"#cWH"}Казахские номера.\n\
		{"#cGR"}Тип 6. {"#cWH"}Полицейские номера.\n\n\
		{"#cGR"}* Пример номера: 2, a111aa, 77 (2 - тип номера, потом сам номер, потом регион)\n\
		{"#cGR"}* Введите номер, который желаете приобрести:","Принять", "Назад");
		return 1 ;
	}

	new _plate_name [ 32 ], _plate_region [ 10 ] ;
	GetPVarString ( playerid, "phone_number", _plate_name, 32 ) ;
	GetPVarString ( playerid, "phone_region", _plate_region, 10 ) ;
	new _plate_type = GetPVarInt ( playerid, "phone_type" ) ;

	global_string [ 0 ] = EOS ;
    format ( global_string, 256, "\
        INSERT INTO licence_plate \
        (licence_plate_char_id,licence_plate_country,licence_plate_number,licence_plate_region) \
        VALUES ('%d','%s','%s','%s')",
        p_info [ playerid ] [ id ],
        g_licence_plates_region [ _plate_type ],
        _plate_name,
        _plate_region
    ) ;
	mysql_tquery ( sql_connection, global_string, "callback_insert_plate", "i", playerid ) ;

    set_player_donate ( playerid, 500, 2 ) ;

	new query_string [ 128 ] ;
	format ( query_string, sizeof query_string, "(donate) номера т/с (%s)", plate_number1 ( _plate_type, _plate_name, _plate_region ) ) ;
	insert_donate_log ( playerid, INVALID_PLAYER_ID, 500, p_info [ playerid ] [ donate ], query_string ) ;

	setUpdateBalance ( playerid, p_info [ playerid ] [ donate ] ) ;
	SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Донат услуга успешно приобретена." ) ;
	return 1 ;
}

callback: callback_insert_plate ( playerid )
{
	new _plate_name [ 32 ], _plate_region [ 10 ] ;
	GetPVarString ( playerid, "phone_number", _plate_name, 32 ) ;
	GetPVarString ( playerid, "phone_region", _plate_region, 10 ) ;
	new _plate_type = GetPVarInt ( playerid, "phone_type" ) ;

	give_inventory (
		playerid,
		2250,
		1,
		RENDER_TYPE_PLATE,
		_plate_region,
		_plate_name,
		_plate_type,
		cache_insert_id ( )
	) ;

	DeletePVar ( playerid, "phone_number" ) ;
 	DeletePVar ( playerid, "phone_region" ) ;
  	DeletePVar ( playerid, "phone_type" ) ;
	return 1 ;
}

callback: promo_second_callback ( playerid, inputtext_promo [ ] )
{
	new rows, fields;
	cache_get_data ( rows, fields ) ;
	if ( ! rows )
	{
	    global_string [ 0 ] = EOS ;
	    strcat ( global_string, "{"#cRD"}* Данный промокод не существует.\n\n" ) ;

	    strcat ( global_string, "{"#cWH"}Если вы пришли на {"#cBL"}"server_name"{"#cWH"}\n" ) ;
		strcat ( global_string, "по приглашению и у Вас есть {"#cLY"}промокод{"#cWH"},\n" ) ;
		strcat ( global_string, "то введите его в поле ниже.\n\n" ) ;

		strcat ( global_string, "{"#cBL"}1.{"#cWH"} При активации {"#cLY"}промокода{"#cWH"}\n" ) ;
		strcat ( global_string, "Вы получите все бонусы,\n" ) ;
		strcat ( global_string, "которые были обещаны.\n\n" ) ;

		new line_string [ 100 ] ;
		format ( line_string, sizeof line_string, "{"#cBL"}2.{"#cWH"} При достижении {"#cLY"}%d{"#cWH"} уровня\n", promo_level ) ;
		strcat ( global_string, line_string ) ;
		strcat ( global_string, "Вы получите денежные средства.\n\n" ) ;

		format ( line_string, sizeof line_string, "{"#cBL"}3.{"#cWH"} С {"#cLY"}%d{"#cWH"} по {"#cLY"}%d{"#cWH"} уровень аккаунта будет\n", promo_level, promo_llevel ) ;
		strcat ( global_string, line_string ) ;
		strcat ( global_string, "качаться в {"#cBL"}2 раза быстрее{"#cWH"}.\n\n" ) ;

		format ( line_string, sizeof line_string, "{"#cBL"}4.{"#cWH"} При достижении {"#cLY"}%d{"#cWH"} уровня\n", promo_llevel ) ;
		strcat ( global_string, line_string ) ;
		strcat ( global_string, "Вы получите ещё дополнительные\n" ) ;
		strcat ( global_string, "денежные средства в виде {"#cBL"}x1.5{"#cWH"} от\n" ) ;
		strcat ( global_string, "того, что выдавал {"#cLY"}промокод{"#cWH"} изначально.\n\n" ) ;

		strcat ( global_string, "{"#cGRDialog"}* Если у Вас имеется {"#cBL"}промокод{"#cGRDialog"}, введите его здесь:" ) ;
		show_dialog ( playerid, d_mm_promocode, DIALOG_STYLE_INPUT, "{"#cBHD"}Промокод", global_string, "Принять", "Назад" ) ;
		return 1 ;
	}

	new promo_exp = cache_get_field_content_int ( 0, "promo_exp", sql_connection ) ;
	if ( p_info [ playerid ] [ level ] == 1 && p_info [ playerid ] [ exp ] < promo_exp )
	{
	    global_string [ 0 ] = EOS ;
	    strcat ( global_string, "{"#cRD"}* Вы не подходите требованиям данного промокода.\n\n" ) ;

	    strcat ( global_string, "{"#cWH"}Если вы пришли на {"#cBL"}"server_name"{"#cWH"}\n" ) ;
		strcat ( global_string, "по приглашению и у Вас есть {"#cLY"}промокод{"#cWH"},\n" ) ;
		strcat ( global_string, "то введите его в поле ниже.\n\n" ) ;

		strcat ( global_string, "{"#cBL"}1.{"#cWH"} При активации {"#cLY"}промокода{"#cWH"}\n" ) ;
		strcat ( global_string, "Вы получите все бонусы,\n" ) ;
		strcat ( global_string, "которые были обещаны.\n\n" ) ;

		new line_string [ 100 ] ;
		format ( line_string, sizeof line_string, "{"#cBL"}2.{"#cWH"} При достижении {"#cLY"}%d{"#cWH"} уровня\n", promo_level ) ;
		strcat ( global_string, line_string ) ;
		strcat ( global_string, "Вы получите денежные средства.\n\n" ) ;

		format ( line_string, sizeof line_string, "{"#cBL"}3.{"#cWH"} С {"#cLY"}%d{"#cWH"} по {"#cLY"}%d{"#cWH"} уровень аккаунта будет\n", promo_level, promo_llevel ) ;
		strcat ( global_string, line_string ) ;
		strcat ( global_string, "качаться в {"#cBL"}2 раза быстрее{"#cWH"}.\n\n" ) ;

		format ( line_string, sizeof line_string, "{"#cBL"}4.{"#cWH"} При достижении {"#cLY"}%d{"#cWH"} уровня\n", promo_llevel ) ;
		strcat ( global_string, line_string ) ;
		strcat ( global_string, "Вы получите ещё дополнительные\n" ) ;
		strcat ( global_string, "денежные средства в виде {"#cBL"}x1.5{"#cWH"} от\n" ) ;
		strcat ( global_string, "того, что выдавал {"#cLY"}промокод{"#cWH"} изначально.\n\n" ) ;

		strcat ( global_string, "{"#cGRDialog"}* Если у Вас имеется {"#cBL"}промокод{"#cGRDialog"}, введите его здесь:" ) ;
		show_dialog ( playerid, d_mm_promocode, DIALOG_STYLE_INPUT, "{"#cBHD"}Промокод", global_string, "Принять", "Назад" ) ;
		return 1 ;
	}

	new promo_id = cache_get_field_content_int ( 0, "promo_id", sql_connection ) ;
	new promo_money = cache_get_field_content_int ( 0, "promo_money", sql_connection ) ;

	new promo_drivelic = cache_get_field_content_int ( 0, "promo_drivelic", sql_connection ) ;
	new promo_boatlic = cache_get_field_content_int ( 0, "promo_boatlic", sql_connection ) ;
	new promo_gunlic = cache_get_field_content_int ( 0, "promo_gunlic", sql_connection ) ;
	new promo_flylic = cache_get_field_content_int ( 0, "promo_flylic", sql_connection ) ;

	new promo_skill_silenced = cache_get_field_content_int ( 0, "promo_flylic", sql_connection ) ;
    new promo_skill_deagle = cache_get_field_content_int ( 0, "promo_skill_deagle", sql_connection ) ;
    new promo_skill_shotgun = cache_get_field_content_int ( 0, "promo_skill_shotgun", sql_connection ) ;
    new promo_skill_mp5 = cache_get_field_content_int ( 0, "promo_skill_mp5", sql_connection ) ;
    new promo_skill_ak47 = cache_get_field_content_int ( 0, "promo_skill_ak47", sql_connection ) ;
    new promo_skill_m4 = cache_get_field_content_int ( 0, "promo_skill_m4", sql_connection ) ;
    new promo_skill_rifle = cache_get_field_content_int ( 0, "promo_skill_rifle", sql_connection ) ;

    new promo_roulette_type = cache_get_field_content_int ( 0, "promo_roulette_type", sql_connection ) ;
    new promo_roulette = cache_get_field_content_int ( 0, "promo_roulette", sql_connection ) ;
    new promo_donate = cache_get_field_content_int ( 0, "promo_donate", sql_connection ) ;

    new promocode_used = cache_get_field_content_int ( 0, "promo_used", sql_connection ) ;
    new promo_activations = cache_get_field_content_int ( 0, "promo_activations", sql_connection ) ;

    new promo_veh = cache_get_field_content_int ( 0, "promo_veh", sql_connection ) ;
    new promo_skin = cache_get_field_content_int ( 0, "promo_skin", sql_connection ) ;
    new promo_acs = cache_get_field_content_int ( 0, "promo_acs", sql_connection ) ;
    new promo_day = cache_get_field_content_int ( 0, "promo_day", sql_connection ) ;

    new promo_obj_activations = cache_get_field_content_int ( 0, "promo_obj_activations", sql_connection ) ;
    new promo_hourss = cache_get_field_content_int ( 0, "promo_hours", sql_connection ) ;

    if ( promo_hourss )
    {
        if ( p_info [ playerid ] [ promo_hours ] )
		{
		    SetPVarInt ( playerid, "promo_hourss", promo_hourss ) ;

   			new _p_type = 0, _p_id = 0 ;
	        if ( promo_veh ) _p_type = 1, _p_id = promo_veh ;
			else if ( promo_acs ) _p_type = 2, _p_id = promo_acs ;
			else if ( promo_skin ) _p_type = 3, _p_id = promo_skin ;
			SetPVarInt ( playerid, "promo_type", _p_type ) ;
			SetPVarInt ( playerid, "promo_p_id", _p_id ) ;

			global_string [ 0 ] = EOS ;

		    new line_string [ 100 ] ;
		    strcat ( global_string, "{"#cBL"}** Ваш активный промокод **\n\n" ) ;
	  		format ( line_string, sizeof line_string, "{"#cGRDialog"}До получения промокода: {"#cWH"}%d {"#cGRDialog"}час(ов).\n", p_info [ playerid ] [ promo_hours ] ) ;
			strcat ( global_string, line_string ) ;
			if ( p_info [ playerid ] [ promo_type ] == 1 )
			{
				strcat ( global_string, "{"#cGRDialog"}Тип приза: {"#cWH"}транспорт\n" ) ;

				format ( line_string, sizeof line_string, "{"#cGRDialog"}Модель: {"#cWH"}%s (%d)\n\n", GetVehicleNameEx ( INVALID_VEHICLE_ID, p_info [ playerid ] [ promo_p_id ] ), p_info [ playerid ] [ promo_p_id ] ) ;
				strcat ( global_string, line_string ) ;
			}
			else if ( p_info [ playerid ] [ promo_type ] == 2 )
			{
				strcat ( global_string, "{"#cGRDialog"}Тип приза: {"#cWH"}аксессуар\n" ) ;

				format ( line_string, sizeof line_string, "{"#cGRDialog"}Модель: {"#cWH"}%s (%d)\n\n", get_accessorie_name ( p_info [ playerid ] [ promo_p_id ] ), p_info [ playerid ] [ promo_p_id ] ) ;
				strcat ( global_string, line_string ) ;
			}
			else if ( p_info [ playerid ] [ promo_type ] == 3 )
			{
				strcat ( global_string, "{"#cGRDialog"}Тип приза: {"#cWH"}одежда\n" ) ;

				format ( line_string, sizeof line_string, "{"#cGRDialog"}Модель: {"#cWH"}#%d\n\n", p_info [ playerid ] [ promo_p_id ] ) ;
				strcat ( global_string, line_string ) ;
			}

		    strcat ( global_string, "{"#cBL"}** Содержимое промокода, который Вы использовали **\n\n" ) ;
		    format ( line_string, sizeof line_string, "{"#cGRDialog"}До получения промокода: {"#cWH"}%d {"#cGRDialog"}час(ов).\n", promo_hourss ) ;
			strcat ( global_string, line_string ) ;
			if ( _p_type == 1 )
			{
				strcat ( global_string, "{"#cGRDialog"}Тип приза: {"#cWH"}транспорт\n" ) ;

				format ( line_string, sizeof line_string, "{"#cGRDialog"}Модель: {"#cWH"}%s (%d)\n\n", GetVehicleNameEx ( INVALID_VEHICLE_ID, _p_id ), _p_id ) ;
				strcat ( global_string, line_string ) ;
			}
			else if ( _p_type == 2 )
			{
				strcat ( global_string, "{"#cGRDialog"}Тип приза: {"#cWH"}аксессуар\n" ) ;

				format ( line_string, sizeof line_string, "{"#cGRDialog"}Модель: {"#cWH"}%s (%d)\n\n", get_accessorie_name ( _p_id ), _p_id ) ;
				strcat ( global_string, line_string ) ;
			}
			else if ( _p_type == 3 )
			{
				strcat ( global_string, "{"#cGRDialog"}Тип приза: {"#cWH"}одежда\n" ) ;

				format ( line_string, sizeof line_string, "{"#cGRDialog"}Модель: {"#cWH"}#%d\n\n", _p_id ) ;
				strcat ( global_string, line_string ) ;
			}

			strcat ( global_string, "{"#cGRDialog"}* У Вас уже есть активный промокод.\n\n" ) ;
			strcat ( global_string, "{"#cGRDialog"}* Хотите его заменить?" ) ;
		    show_dialog ( playerid, d_mm_change_promo, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Промокод", global_string, "Заменить", "Отказ" ) ;
		}
		else
		{
	        p_info [ playerid ] [ promo_hours ] = promo_hourss ;

	        new _p_type = 0, _p_id = 0 ;
	        if ( promo_veh ) _p_type = 1, _p_id = promo_veh ;
			else if ( promo_acs ) _p_type = 2, _p_id = promo_acs ;
			else if ( promo_skin ) _p_type = 3, _p_id = promo_skin ;
	        p_info [ playerid ] [ promo_type ] = _p_type ;
	        p_info [ playerid ] [ promo_p_id ] = _p_id ;

	        new query_string [ 118 + ( 4 * 9 ) ] ;
			format ( query_string, sizeof query_string, "UPDATE `users` SET `u_promo_hours` = '%d', `u_promo_type` = '%d', `u_promo_p_id` = '%d' WHERE `u_id` = '%d' LIMIT 1",
			p_info [ playerid ] [ promo_hours ], p_info [ playerid ] [ promo_type ],
			p_info [ playerid ] [ promo_p_id ], p_info [ playerid ] [ id ] ) ;
			mysql_tquery ( sql_connection, query_string ) ;

			SendClientMessage ( playerid, col_succes, "* Используйте {"#cWH"}/mm - Информация о персонаже - Информация о промокоде{"#cSucces"} для просмотра статистики." ) ;
		}
	}
	else
	{
		new bool: promo_obj_used = false ;
		if ( promo_obj_activations != -1 )
	    {
	    	if ( promocode_used > promo_obj_activations )
			{
				promo_obj_used = true ;
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Действие предметов уже закончилось, но Вы получили оставшиеся параметры промокода." ) ;
			}
	    }

		if ( promo_skin )
		{
		}

		if ( promo_veh && ! promo_obj_used )
		{
		    new ts_id = 0, ts_spawn_slot = random ( 5 ) ;
			new	veh_id = CreateVehicle ( promo_veh, t_shop_respawn [ ts_id ] [ ts_spawn_slot ] [ 0 ],
												t_shop_respawn [ ts_id ] [ ts_spawn_slot ] [ 1 ],
												t_shop_respawn [ ts_id ] [ ts_spawn_slot ] [ 2 ],
												t_shop_respawn [ ts_id ] [ ts_spawn_slot ] [ 3 ],
												1, 1, SPAWN_TIME_PLAYER_VEHICLE ) ;

		    p_info [ playerid ] [ max_veh ] += 1 ;
		    update_int_sql ( playerid, "u_maxveh", p_info [ playerid ] [ max_veh ] ) ;

		    p_info [ playerid ] [ max_veh_timeing ] += 1 ;
		    update_int_sql ( playerid, "u_maxveh_timeing", p_info [ playerid ] [ max_veh_timeing ] ) ;

			veh_info [ veh_id - 1 ] [ v_price ] = 0 ;

			veh_info [ veh_id - 1 ] [ v_date_used ] = SetElapsedTime ( gettime ( ), promo_day, CONVERT_TIME_TO_DAYS ) ;

			new query_string [ 356 ] ;
			mysql_format ( sql_connection, query_string, sizeof query_string, "INSERT INTO `users_vehicles`(`v_model`,`v_owner`,`v_color_1`,`v_color_2`,`v_pos_x`,`v_pos_y`,`v_pos_z`,`v_pos_a`,`v_buydate`,`v_gps_tracker`,`v_price`,`v_date_used`) VALUES ('%d','%i','1','1','%f','%f','%f','%f',NOW(),'1','%d','%d')",
			promo_veh,
			p_info [ playerid ] [ id ],
			t_shop_respawn [ ts_id ] [ ts_spawn_slot ] [ 0 ],
			t_shop_respawn [ ts_id ] [ ts_spawn_slot ] [ 1 ],
			t_shop_respawn [ ts_id ] [ ts_spawn_slot ] [ 2 ],
			t_shop_respawn [ ts_id ] [ ts_spawn_slot ] [ 3 ],
			veh_info [ veh_id - 1 ] [ v_price ],
			veh_info [ veh_id - 1 ] [ v_date_used ] ) ;
			mysql_tquery ( sql_connection, query_string, "create_vehicle_callback", "d", veh_id ) ;

			p_info [ playerid ] [ p_veh_count ] ++ ;

			veh_info [ veh_id - 1 ] [ v_type ] = vehicle_type_player ;
			veh_info [ veh_id - 1 ] [ v_vehicle ] = veh_id ;
			format ( veh_info [ veh_id - 1 ] [ v_plate ], 12, "Transit" ) ;
			veh_info [ veh_id - 1 ] [ v_pos ] [ 0 ] = t_shop_respawn [ ts_id ] [ ts_spawn_slot ] [ 0 ] ;
			veh_info [ veh_id - 1 ] [ v_pos ] [ 1 ] = t_shop_respawn [ ts_id ] [ ts_spawn_slot ] [ 1 ] ;
			veh_info [ veh_id - 1 ] [ v_pos ] [ 2 ] = t_shop_respawn [ ts_id ] [ ts_spawn_slot ] [ 2 ] ;
			veh_info [ veh_id - 1 ] [ v_pos ] [ 3 ] = t_shop_respawn [ ts_id ] [ ts_spawn_slot ] [ 3 ] ;
			veh_info [ veh_id - 1 ] [ v_fuel ] = 100.0 ;
			veh_info [ veh_id - 1 ] [ v_millage ] = 0.0 ;
			veh_info [ veh_id - 1 ] [ v_legal_millage ] = 0.0 ;
			veh_info [ veh_id - 1 ] [ v_fine ] = 3 ;
			veh_info [ veh_id - 1 ] [ v_gps_tracker ] = 1 ;

			veh_plate ( veh_id ) ;

			new engine, lights, alarm, doors, bonnet, boot, objective ;
			veh_info [ veh_id - 1 ] [ v_locked ] = true ;
			GetVehicleParamsEx ( veh_id, engine, lights, alarm, doors, bonnet, boot, objective ) ;
			SetVehicleParamsEx ( veh_id, engine, lights, alarm, true, bonnet, boot, objective ) ;

			veh_info [ veh_id - 1 ] [ v_owner ] = p_info [ playerid ] [ id ] ;

			SetVehicleNumberPlate ( veh_info [ veh_id - 1 ] [ v_vehicle ], veh_info [ veh_id - 1 ] [ v_plate ] ) ;
			Iter_Add(player_vehicles[ playerid ], veh_info [ veh_id - 1 ] [ v_vehicle ] ) ;

			new fmt_str [ 63 + 32 ] ;
			format ( fmt_str, sizeof fmt_str, "* Вы получили т/с %s в промокоде. Заберите его у автосалона.", GetVehicleNameEx ( INVALID_VEHICLE_ID, promo_veh ) ) ;
			SendClientMessage ( playerid, col_succes, fmt_str ) ;

			SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Не забудьте припарковать Ваше транспортное средство (/vpark)." ) ;
			SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}У Вас есть 3 минуты, чтобы его отогнать или оно будет отправлено на штрафстоянку." ) ;
			veh_info [ veh_id - 1 ] [ v_fine_time ] = 180 ;
		}

		if ( promo_acs && ! promo_obj_used )
		{
			give_inventory ( playerid, promo_acs, 1, 0, "", "", NUMBERPLATE_TYPE_NONE, promo_day ) ;
		}
	}

	if ( promo_drivelic )
	{
		p_info [ playerid ] [ drive_lic ] = promo_drivelic ;
		p_info [ playerid ] [ drive_day ] = 30 ;

		new sql_string [ 100 + ( 2 * 9 ) ] ;
		format ( sql_string, sizeof sql_string, "UPDATE `users` SET `u_drive_day` = '30', `u_drive_lic` = '%d' WHERE `u_id` = '%d' LIMIT 1",
		promo_drivelic, p_info [ playerid ] [ id ] ) ;
		mysql_tquery ( sql_connection, sql_string ) ;
	}
	if ( promo_boatlic )
	{
		p_info [ playerid ] [ boat_lic ] = promo_boatlic ;
		p_info [ playerid ] [ boat_day ] = 30 ;

		new sql_string [ 100 + ( 2 * 9 ) ] ;
		format ( sql_string, sizeof sql_string, "UPDATE `users` SET `u_boat_day` = '30', `u_boat_lic` = '%d' WHERE `u_id` = '%d' LIMIT 1",
		promo_boatlic, p_info [ playerid ] [ id ] ) ;
		mysql_tquery ( sql_connection, sql_string ) ;
	}
	if ( promo_gunlic )
	{
		p_info [ playerid ] [ gun_lic ] = promo_gunlic ;
		p_info [ playerid ] [ gun_day ] = 30 ;

		new sql_string [ 100 + ( 2 * 9 ) ] ;
		format ( sql_string, sizeof sql_string, "UPDATE `users` SET `u_gun_day` = '30', `u_gun_lic` = '%d' WHERE `u_id` = '%d' LIMIT 1",
		promo_gunlic, p_info [ playerid ] [ id ] ) ;
		mysql_tquery ( sql_connection, sql_string ) ;
	}
	if ( promo_flylic )
	{
		p_info [ playerid ] [ fly_lic ] = promo_flylic ;
		p_info [ playerid ] [ fly_day ] = 30 ;

		new sql_string [ 100 + ( 2 * 9 ) ] ;
		format ( sql_string, sizeof sql_string, "UPDATE `users` SET `u_fly_day` = '30', `u_fly_lic` = '%d' WHERE `u_id` = '%d' LIMIT 1",
		promo_flylic, p_info [ playerid ] [ id ] ) ;
		mysql_tquery ( sql_connection, sql_string ) ;
	}

	if ( promo_skill_silenced )p_info [ playerid ] [ gun_skills ] [ 0 ] = promo_skill_silenced ;
	if ( promo_skill_deagle )p_info [ playerid ] [ gun_skills ] [ 1 ] = promo_skill_deagle ;
	if ( promo_skill_shotgun )p_info [ playerid ] [ gun_skills ] [ 2 ] = promo_skill_shotgun ;
	if ( promo_skill_mp5 )p_info [ playerid ] [ gun_skills ] [ 3 ] = promo_skill_mp5 ;
	if ( promo_skill_ak47 )p_info [ playerid ] [ gun_skills ] [ 4 ] = promo_skill_ak47 ;
	if ( promo_skill_m4 )p_info [ playerid ] [ gun_skills ] [ 5 ] = promo_skill_m4 ;
	if ( promo_skill_rifle )p_info [ playerid ] [ gun_skills ] [ 6 ] = promo_skill_rifle ;

	if ( promo_roulette_type != -1 && promo_roulette )
	{
	    new _item_id = 0 ;
		if ( promo_roulette_type == 0 ) _item_id = 2045, give_inventory ( playerid, 2045, promo_roulette, 0, "", "", NUMBERPLATE_TYPE_NONE, 0 ) ;
		else if ( promo_roulette_type == 1 ) _item_id = 2055, give_inventory ( playerid, 2055, promo_roulette, 0, "", "", NUMBERPLATE_TYPE_NONE, 0 ) ;
		else if ( promo_roulette_type == 2 ) _item_id = 2125, give_inventory ( playerid, 2125, promo_roulette, 0, "", "", NUMBERPLATE_TYPE_NONE, 0 ) ;

		new fmt_str [ 92 + 32 ] ;
		format ( fmt_str, sizeof fmt_str, "* Вам в инвентарь был добавлен предмет '%s'.", item_name ( _item_id ) ) ;
		SendClientMessage ( playerid, col_yellow, fmt_str ) ;
	}
	if ( promo_donate )
	{
		give_player_donate ( playerid, promo_donate, 1 ) ;

		new fmt_str [ 47 + 9 ] ;
		format ( fmt_str, sizeof fmt_str, "* Вы получили %d "donate_title" в промокоде.", promo_donate ) ;
		SendClientMessage ( playerid, col_succes, fmt_str ) ;
	}

	SetPlayerSkills ( playerid ) ;

	if ( promo_money > 0 )
	{
		give_money ( playerid, promo_money ) ;
		insert_money_log ( playerid, INVALID_PLAYER_ID, promo_money, "промыч" ) ;
	}

	new query_string [ 256 ] ;
	format ( query_string, 144, "UPDATE `time_promocodes` SET `promo_used` = `promo_used`+'1' WHERE `promo_id` = '%d' LIMIT 1",
	promo_id ) ;
	mysql_tquery ( sql_connection, query_string ) ;

	format ( query_string, sizeof ( query_string ),"UPDATE `users` SET `u_skills`='%d|%d|%d|%d|%d|%d|%d' WHERE `u_id` = '%d' LIMIT 1",
	p_info [ playerid ] [ gun_skills ] [ 0 ], p_info [ playerid ] [ gun_skills ] [ 1 ], p_info [ playerid ] [ gun_skills ] [ 2 ],
	p_info [ playerid ] [ gun_skills ] [ 3 ], p_info [ playerid ] [ gun_skills ] [ 4 ], p_info [ playerid ] [ gun_skills ] [ 5 ],
	p_info [ playerid ] [ gun_skills ] [ 6 ],
	p_info [ playerid ] [ id ] ) ;
	mysql_tquery ( sql_connection, query_string ) ;

	SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Промокод успешно активирован." ) ;

    format ( query_string, 144, "INSERT INTO `promo_activations` (`account_id`,`name_promo`) VALUES ('%d','%s')", p_info [ playerid ] [ id ], inputtext_promo ) ;
	mysql_tquery ( sql_connection, query_string ) ;

	if ( promo_activations != -1 && promocode_used + 1 >= promo_activations )
	{
	    format ( query_string, 144, "DELETE FROM `time_promocodes` WHERE `promo_id` = '%d' LIMIT 1", promo_id ) ;
		mysql_tquery ( sql_connection, query_string ) ;

		format ( query_string, 144, "DELETE FROM `promo_activations` WHERE `name_promo` = '%s'", inputtext_promo ) ;
		mysql_tquery ( sql_connection, query_string ) ;
	}
	return 1 ;
}

callback: promo_code_list ( const playerid )
{
	new
		rows = cache_num_rows(),
		promo_code_name [ 32 ],
		promo_code_used ;

	global_string [ 0 ] = EOS ;
	if ( ! rows ) return 1 ;
	if ( rows )
	{
		for(new i = 0; i < rows; i++)
		{
		    new promo_id = cache_get_field_content_int(i, "promo_id", sql_connection);

			cache_get_field_content(i, "promo_text", promo_code_name, sql_connection);
            promo_code_used = cache_get_field_content_int(i, "promo_used", sql_connection);
            new promo_l_level = cache_get_field_content_int(i, "promo_level", sql_connection);
            new promo_ll_level = cache_get_field_content_int(i, "promo_llevel", sql_connection);

			set_player_listitem_values ( playerid, i, promo_id ) ;

			format ( global_string, sizeof global_string, "%s{"#cBL"}%d. {"#cWH"}%s, Активаций: {"#cGN"}%d {"#cWH"}, %d lvl: {"#cGN"}%d {"#cWH"}, %d lvl: {"#cGN"}%d\n", global_string, i + 1, promo_code_name, promo_code_used, promo_level, promo_l_level, promo_llevel, promo_ll_level ) ;
		}
		show_dialog ( playerid, d_promo_code_list, DIALOG_STYLE_LIST, "{"#cBHD"}Лист промокодов", global_string, "Выбрать", "Закрыть" ) ;

		page_rows [ playerid ] = rows ;
	}
	return 1 ;
}

callback: promo_code_check ( const playerid )
{
    new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows ) return 1 ;
	if ( rows )
	{
		new promo_money = cache_get_field_content_int ( 0, "promo_money", sql_connection ) ;
		new promo_activations = cache_get_field_content_int ( 0, "promo_activations", sql_connection ) ;

		new promo_drivelic = cache_get_field_content_int ( 0, "promo_drivelic", sql_connection ) ;
		new promo_boatlic = cache_get_field_content_int ( 0, "promo_boatlic", sql_connection ) ;
		new promo_gunlic = cache_get_field_content_int ( 0, "promo_gunlic", sql_connection ) ;
		new promo_flylic = cache_get_field_content_int ( 0, "promo_flylic", sql_connection ) ;

		new promo_skill_silenced = cache_get_field_content_int ( 0, "promo_flylic", sql_connection ) ;
	    new promo_skill_deagle = cache_get_field_content_int ( 0, "promo_skill_deagle", sql_connection ) ;
	    new promo_skill_shotgun = cache_get_field_content_int ( 0, "promo_skill_shotgun", sql_connection ) ;
	    new promo_skill_mp5 = cache_get_field_content_int ( 0, "promo_skill_mp5", sql_connection ) ;
	    new promo_skill_ak47 = cache_get_field_content_int ( 0, "promo_skill_ak47", sql_connection ) ;
	    new promo_skill_m4 = cache_get_field_content_int ( 0, "promo_skill_m4", sql_connection ) ;
	    new promo_skill_rifle = cache_get_field_content_int ( 0, "promo_skill_rifle", sql_connection ) ;

	    new promo_roulette = cache_get_field_content_int ( 0, "promo_roulette", sql_connection ) ;
	    new promo_donate = cache_get_field_content_int ( 0, "promo_donate", sql_connection ) ;

	    new promo_veh = cache_get_field_content_int ( 0, "promo_veh", sql_connection ) ;
	    new promo_skin = cache_get_field_content_int ( 0, "promo_skin", sql_connection ) ;
	    new promo_acs = cache_get_field_content_int ( 0, "promo_acs", sql_connection ) ;
	    new promo_day = cache_get_field_content_int ( 0, "promo_day", sql_connection ) ;

	    new promo_obj_activations = cache_get_field_content_int ( 0, "promo_obj_activations", sql_connection ) ;

	    new promo_name [ 16 ] ;
	    cache_get_field_content(0, "promo_text", promo_name, sql_connection);

		global_string [ 0 ] = EOS ;
		new line_string [ 128 ] ;

		format ( line_string, sizeof line_string, "{"#cGRDialog"} - {"#cWH"}Название: {"#cGN"}%s\n\n", promo_name ) ;
		strcat ( global_string, line_string ) ;

		strcat ( global_string, "{"#cBL"}** Содержимое промокода **\n" ) ;
		if ( promo_money )
		{
		    format ( line_string, sizeof line_string, "{"#cGRDialog"} - {"#cWH"}Игровая валюта: {"#cGN"}%d"valute_title_"\n", promo_money ) ;
			strcat ( global_string, line_string ) ;
		}

		if ( promo_drivelic ) strcat ( global_string, "{"#cGRDialog"} - {"#cWH"}Водительские права: {"#cGN"}Да\n" ) ;
		if ( promo_boatlic ) strcat ( global_string, "{"#cGRDialog"} - {"#cWH"}Лицензия на оружие: {"#cGN"}Да\n" ) ;
		if ( promo_gunlic ) strcat ( global_string, "{"#cGRDialog"} - {"#cWH"}Лицензия на водный транспорт: {"#cGN"}Да\n" ) ;
		if ( promo_flylic ) strcat ( global_string, "{"#cGRDialog"} - {"#cWH"}Лицензия на полеты: {"#cGN"}Да\n" ) ;

		if ( promo_skill_silenced ) strcat ( global_string, "{"#cGRDialog"} - {"#cWH"}Навык SDPistol: {"#cGN"}Да\n" ) ;
		if ( promo_skill_deagle ) strcat ( global_string, "{"#cGRDialog"} - {"#cWH"}Навык Desert Eagle: {"#cGN"}Да\n" ) ;
		if ( promo_skill_shotgun ) strcat ( global_string, "{"#cGRDialog"} - {"#cWH"}Навык ShotGun: {"#cGN"}Да\n" ) ;
		if ( promo_skill_mp5 ) strcat ( global_string, "{"#cGRDialog"} - {"#cWH"}Навык MP5: {"#cGN"}Да\n" ) ;
		if ( promo_skill_ak47 ) strcat ( global_string, "{"#cGRDialog"} - {"#cWH"}Навык Ak47: {"#cGN"}Да\n" ) ;
		if ( promo_skill_m4 ) strcat ( global_string, "{"#cGRDialog"} - {"#cWH"}Навык M4A1: {"#cGN"}Да\n" ) ;
		if ( promo_skill_rifle ) strcat ( global_string, "{"#cGRDialog"} - {"#cWH"}Навык Rifle: {"#cGN"}Да\n" ) ;

		if ( promo_roulette )
		{
		    format ( line_string, sizeof line_string, "{"#cGRDialog"} - {"#cWH"}Прокрутки: {"#cGN"}%d\n", promo_roulette ) ;
			strcat ( global_string, line_string ) ;
		}

		if ( promo_donate )
		{
		    format ( line_string, sizeof line_string, "{"#cGRDialog"} - {"#cWH"}Донат: {"#cGN"}%d\n", promo_donate ) ;
			strcat ( global_string, line_string ) ;
		}

		if ( promo_activations )
		{
		    format ( line_string, sizeof line_string, "\n{"#cGRDialog"} - {"#cWH"}Число активаций: {"#cGN"}%d", promo_activations ) ;
			strcat ( global_string, line_string ) ;
		}

		if ( promo_veh )
		{
		    format ( line_string, sizeof line_string, "\n{"#cGRDialog"} - {"#cWH"}Транспорт: {"#cGN"}%s", GetVehicleNameEx ( INVALID_VEHICLE_ID, promo_params [ 15 ] ) ) ;
			strcat ( global_string, line_string ) ;
		}

		if ( promo_skin )
		{
		    format ( line_string, sizeof line_string, "\n{"#cGRDialog"} - {"#cWH"}Одежда: {"#cGN"}№%d", promo_params [ 16 ] ) ;
			strcat ( global_string, line_string ) ;
		}

		if ( promo_acs )
		{
		    format ( line_string, sizeof line_string, "\n{"#cGRDialog"} - {"#cWH"}Аксессуар: {"#cGN"}№%d", promo_params [ 17 ] ) ;
			strcat ( global_string, line_string ) ;
		}

		if ( promo_day )
		{
		    format ( line_string, sizeof line_string, "\n{"#cGRDialog"} - {"#cWH"}Действие предметов: {"#cGN"}%d дней", promo_params [ 18 ] ) ;
			strcat ( global_string, line_string ) ;
		}

		if ( promo_obj_activations )
		{
		    format ( line_string, sizeof line_string, "\n{"#cGRDialog"} - {"#cWH"}Активаций предметов: {"#cGN"}%d дней", promo_params [ 19 ] ) ;
			strcat ( global_string, line_string ) ;
		}

		show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Промокод", global_string, "Принять", "" ) ;
	}
	return 1 ;
}

