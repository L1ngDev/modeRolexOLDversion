	        format ( _sql_string, sizeof _sql_string, "UPDATE `server_variables` SET `var_count` = '%d' WHERE `var_id` = '54' LIMIT 1", plant_order ) ;
			mysql_tquery ( sql_connection, _sql_string ) ;

			new scm_string [ 144 ] ;
			format ( scm_string, sizeof scm_string, "* [TRUCK] %s заказала %d кг металла. Оплата: %d"valute_title_" / кг металла. (/tpanel > Точки разгрузки > Оружейный завод)", f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_name ], plant_order, plant_metall_price ) ;
			foreach(new i: logged_players) if ( p_info [ i ] [ job ] == job_trucker && player_rentcar [ i ] != INVALID_VEHICLE_ID && ( veh_info [ player_rentcar [ i ] - 1 ] [ v_type ] == vehicle_type_job || veh_info [ player_rentcar [ i ] - 1 ] [ v_owner ] == job_trucker ) && p_info [ i ] [ settings ] [ 4 ] != 0 ) SendClientMessage ( i, color_job, scm_string ) ;

