			strcat ( global_string, "{"#cGRDialog"}*{"#cWH"} Включить сигнал, оповещающий об аварийной ситуации.\n" ) ;
			strcat ( global_string, "{"#cBL"}-{"#cWH"} Обгон впереди движущегося т/с с правой стороны,обгон разрешен лишь в случае поворота\n" ) ;
