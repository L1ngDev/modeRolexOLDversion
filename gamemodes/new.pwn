                new j = get_player_use_listitem ( playerid ) ;
                users_contacts [ playerid ] [ j ] [ uc_number ] = _value ;

				new sql_string [ 81 + ( 9 * 2 ) ] ;
				format ( sql_string, sizeof sql_string, "UPDATE `users_contacts` SET `u_c_number` = '%d' WHERE `inc_id` = '%d' LIMIT 1", _value, users_contacts [ playerid ] [ j ] [ uc_inc ] ) ;
				mysql_tquery ( sql_connection, sql_string, "", "" ) ;

