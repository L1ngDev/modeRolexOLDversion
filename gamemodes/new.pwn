		case d_filling_repair:
		{
		    if ( ! response ) return 1 ;
            new b = GetPVarInt ( playerid, "f_biz" ) ;

            new bool: _sucess_product = false ;
            if ( b_info [ b ] [ b_product ] < b_fill_product [ 5 ] ) _sucess_product = true ;

			new _price = b_price_market [ b ] [ 2 ] ;
		    if ( p_info [ playerid ] [ money ] < _price )
			{
				new dialog_string [ 102 + 9 ] ;
		    	format ( dialog_string, sizeof dialog_string, "{"#cWH"}Стоимость починки: {"#cGN"}%d"valute_title_"\n\n{"#cGRDialog"}* Вы хотите починить транспортное средство?", b_price_market [ b ] [ 2 ] ) ;
				show_dialog ( playerid, d_filling_repair, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Заправочная станция", dialog_string, "Выбрать", "Закрыть" ) ;

				if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "У Вас недостаточно средств.", 0, 3, CINFO_AZS_ID, PICTURE_INFO_ERROR, "", "" ) ;
				else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас недостаточно средств." ) ;
				return 1 ;
			}

			give_money ( playerid, -_price ) ;
			insert_money_log ( playerid, INVALID_PLAYER_ID, -_price, "починка на азс" ) ;

			RepairVehicle ( GetPlayerVehicleID ( playerid ) ) ;

			if ( ! _sucess_product ) give_bmoney ( b + 1, _price, b_fill_product [ 5 ] ) ;
			b_info [ b ] [ b_visitors ] ++ ;

			if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Вы починили транспортное средство.", 0, 3, CINFO_AZS_ID, PICTURE_INFO_SUCESS, "", "" ) ;
			else SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы починили транспортное средство." ) ;
			return 1 ;
		}
		case d_rd_end:
		{
			SelectTextDraw ( playerid, 0xB0C4DEFF ) ;
			return 1 ;
