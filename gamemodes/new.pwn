					    format ( global_string, 1000, "%s%s: %i\n", global_string, mg_info [ i ][ mg_name ], mg_info [ i ] [ mg_guns ] - 12 ) ;
					}
					show_dialog ( playerid, d_cellar_makegun, DIALOG_STYLE_TABLIST_HEADERS, "{"#cBHD"}Сборка оружия", global_string, "Выбрать", "Закрыть" ) ;
				}
				case 3:
				{
				    #if defined m_craft
				        craft_ptd_status ( playerid, true ) ;
					#endif
				    return 1 ;
				}
			}
		}
		case d_cellar_menu_drugs:
		{
