		case d_shop:
		{
			if ( ! response ) return 1 ;
			new b = GetPVarInt ( playerid, "p_biz_id" ) - 1 ;

			new price = b_price_market [ b ] [ listitem ] * get_player_use_listitem ( playerid ) ;
			if ( mafia_player ( playerid ) )
			{
				if ( b_info [ b ] [ b_mafia ] == p_info [ playerid ] [ member ] )
				{
				    price = floatround ( ( b_price_market [ b ] [ listitem ] * 50 ) / 100 ) ;
				}
			}

			#if defined m_perks
			new _perk_stats = get_perk_info ( playerid, PERK_COLLECTIONER ), __price = price ;
			if ( _perk_stats > 0 ) price = price - floatround ( ( __price * _perk_stats ) / 100 ) ;
			#endif

			if ( p_info [ playerid ] [ money ] < price )
			{
				if ( player_device { playerid } == 2 )
				{
					send_check_cinfo ( playerid, "У Вас недостаточно средств!", 0, 3, CINFO_OTHER_ID, PICTURE_INFO_ERROR, "", "" ) ;
					return 1 ;
				}
				else
				{
					ShowShopDialog ( playerid, 1 ) ;
					return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас недостаточно денег." ) ;
				}
			}

			new bool: _sucess_product = false ;
			if ( b_info [ b ] [ b_product ] < b_shop_product [ listitem ] ) _sucess_product = true ;

			switch ( listitem )
			{
				case 0:
				{
					if ( player_device { playerid } == 2 )
					{
						if ( p_info [ playerid ] [ number ] )
						{
							send_check_cinfo ( playerid, "У Вас уже есть мобильный телефон!", 0, 3, CINFO_OTHER_ID, PICTURE_INFO_ERROR, "", "" ) ;
							return 1 ;
						}
						if ( GetTickCount ( ) - simcard_dialog_tick [ playerid ] < 45000 )
						{
							send_check_cinfo ( playerid, "Подбирать номер можно раз в 45 секунд!", 0, 3, CINFO_OTHER_ID, PICTURE_INFO_ERROR, "", "" ) ;
							return 1 ;
						}
					}
					else
					{
						if ( p_info [ playerid ] [ number ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас уже есть мобильный телефон." ), ShowShopDialog ( playerid, 1 ) ;
				    	if ( GetTickCount ( ) - simcard_dialog_tick [ playerid ] < 45000 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Подбирать номер можно раз в {"#cRD"}45 секунд{"#cGRInfo"}." ) ;
					}

					simcard_dialog_tick [ playerid ] = GetTickCount ( ) ;

					new p_number = RandomEx ( 100000, 999999 ) ;
					static const _str [ ] = "SELECT 1 FROM licence_number WHERE number='%d'" ;
					new query_string [ sizeof _str + 9 ] ;
					format ( query_string, sizeof ( query_string ), _str, p_number ) ;
					mysql_tquery ( sql_connection, query_string, "callback_check_simcard", "iiii", playerid, p_number, listitem, price ) ;
					return 1 ;
				}
				case 1:
				{
					if ( player_device { playerid } == 2 )
					{
