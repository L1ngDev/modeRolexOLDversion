callback: bus_loading ( )
{
	new fields, time = GetTickCount ( ) ;
	cache_get_data ( bus_count, fields ) ;
	if( bus_count )
	{
	    for ( new i ; i < bus_count ; i++ )
	    {
	        bus_info [ i ] [ bus_id ] = cache_get_field_content_int ( i, "b_id", sql_connection ) ;

	        bus_info [ i ] [ bus_step ] = cache_get_field_content_int ( i, "b_step", sql_connection ) ;
			bus_info [ i ] [ bus_stop ] = cache_get_field_content_int ( i, "b_stop", sql_connection ) ;

	        bus_info [ i ] [ bus_position ] [ 0 ] = cache_get_field_content_float ( i, "b_pos_x", sql_connection ) ;
			bus_info [ i ] [ bus_position ] [ 1 ] = cache_get_field_content_float ( i, "b_pos_y", sql_connection ) ;
			bus_info [ i ] [ bus_position ] [ 2 ] = cache_get_field_content_float ( i, "b_pos_z", sql_connection ) ;
			bus_info [ i ] [ bus_position ] [ 3 ] = cache_get_field_content_float ( i, "b_pos_a", sql_connection ) ;
	    }
	}

	for ( new i = 0 ; i < bus_first_count ; i ++ )
	{
		for ( new j = 0 ; j < bus_count ; j ++ )
		{
			if ( bus_info [ j ] [ bus_step ] != i || bus_route_count [ i ] != 0 ) continue ;

			bus_route_count [ i ] = j ;
		}
	}

	printf ( "[SERVER] Загружено %d чекпоинтов для автобусника. (%d ms)", bus_count, GetTickCount ( ) - time ) ;
	return 1 ;
}

CMD:createroute ( playerid )
{
	if ( admin_info [ playerid ] [ admin ] < 8 ) return 1 ;
	if ( ! IsFounder ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}К сожалению, Вам данная функция не доступна." ) ;

	new line_string [ 128 ] ;
	global_string [ 0 ] = EOS ;
	for ( new i = 0 ; i < bus_first_count ; i ++ )
	{
		format ( line_string, sizeof line_string, "{"#cBL"}%d.{"#cWH"} %s (%d"valute_title_"/рейс)\n", i + 1, bus_info [ i ] [ bus_name ], zp_for_gos [ 7 ] * bus_info [ i ] [ bus_price ] ) ;
	    strcat ( global_string, line_string ) ;
	}
	strcat ( global_string, "{"#cGRDialog"}Создать маршрут" ) ;
	show_dialog (playerid, d_bus_admin, DIALOG_STYLE_LIST, "{"#cBHD"}Выберите маршрут", global_string, "Выбрать", "Отмена" ) ;
	return 1 ;
}

stock show_admin_route ( playerid )
