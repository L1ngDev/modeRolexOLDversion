		new query_string [ sizeof _str + ( 9 * 2 ) ] ;
        format ( query_string, sizeof query_string, _str, p_info [ playerid ] [ member ], pl_name, page * 10 ) ;
        mysql_tquery ( sql_connection, query_string, "getMembersPlayerLogs", "isii", playerid, pl_name, page, 0 ) ;
    }
