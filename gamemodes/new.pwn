		    format ( bonus_text, sizeof bonus_text, "{"#cGRInfo"}- {"#cWH"}Приз на мероприятиях {"#cGN"}x%d за призовое место.", server_bonus [ 6 ] ) ;
		    SendClientMessage ( playerid, col_gray, bonus_text ) ;
