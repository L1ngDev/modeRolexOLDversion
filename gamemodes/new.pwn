stock ClearPVars_Duel ( playerid )
{
    player_duel [ playerid ] [ duel_player ] =
    player_duel [ playerid ] [ duel_in_lobby ] = INVALID_PLAYER_ID ;

    player_duel [ playerid ] [ duel_max_players ] =
    player_duel [ playerid ] [ duel_player_lobby ] =
    player_duel [ playerid ] [ duel_money ] =
    player_duel [ playerid ] [ duel_map ] =
    player_duel [ playerid ] [ duel_gun ] [ 0 ] =
    player_duel [ playerid ] [ duel_gun ] [ 1 ] =
    player_duel [ playerid ] [ duel_gun ] [ 2 ] =
    player_duel [ playerid ] [ duel_weapon ] = 0 ;

    player_duel [ playerid ] [ duel_create ] =
	player_duel [ playerid ] [ duel_on ] = false ;
	return 1 ;
}
