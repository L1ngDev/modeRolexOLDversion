CMD:settime ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 8 )return 1 ;
	if ( sscanf ( params, "ddd", params [ 0 ], params [ 1 ], params [ 2 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /settime [часы] [минуты] [секунды]" ) ;
	if ( params [ 0 ] > 23 || params [ 0 ] < 0 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /settime [часы] [минуты] [секунды]" ) ;
	if ( params [ 1 ] > 59 || params [ 1 ] < 0 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /settime [часы] [минуты] [секунды]" ) ;
	if ( params [ 2 ] > 59 || params [ 2 ] < 0 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /settime [часы] [минуты] [секунды]" ) ;
	global_hour = params [ 0 ] ;
	SetWorldTime ( params [ 0 ] ) ;

	new scm_string [ 98 ] ;
	format ( scm_string, sizeof ( scm_string  ),"{"#cBAdmin"}[A] {"#cGRAdmin"}%s[%d] установил новое время на сервере %d:%d:%d.", p_info [ playerid ] [ name ], playerid, params [ 0 ], params [ 1 ], params [ 2 ] ) ;
	foreach(new i: admin_players)SendClientMessage ( i, col_admin, scm_string ) ;
	return 1 ;
}

CMD:ipaccounts ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 6 )return 1 ;
	new ban_ip [ 20 ] ;
	if ( sscanf ( params, "s[20]", ban_ip ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /ipaccounts [ип]" ) ;

	global_string [ 0 ] = EOS ;
	mysql_format ( sql_connection, global_string, 400, "SELECT `u_id`,`u_name`,`u_last_date`,`u_online`,`u_level`,`u_money`,`u_admin` FROM `users` WHERE `u_last_ip` = '%s' OR `u_ip_registration` = '%s' LIMIT 25",
	ban_ip, ban_ip ) ;
	mysql_tquery ( sql_connection, global_string, "cmd_ipaccounts_callback", "i", playerid ) ;

	return true ;
}

callback: cmd_ipaccounts_callback ( playerid )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Не найденно данных по данному ip-адресу." ) ;

 	global_string [ 0 ] = EOS ;
	strcat ( global_string, "{"#cBL"}ID. Ник (Посл. вход):\t{"#cBL"}Деньги:\t{"#cBL"}Уровень:\t{"#cBL"}Бан:\n" ) ;
	new pl_name [ 25 ] [ 24 ], pl_date [ 25 ] [ 28 ], line_string [ 144 ], pl_level [ 25 ], pl_money [ 25 ], pl_id [ 25 ], pl_admin [ 25 ] ;
 	for ( new j = 0 ; j < rows ; j ++ )
	{
		pl_id [ j ] = cache_get_field_content_int ( j, "u_id", sql_connection ) ;
		pl_level [ j ] = cache_get_field_content_int ( j, "u_level", sql_connection ) ;
		pl_money [ j ] = cache_get_field_content_int ( j, "u_money", sql_connection ) ;
		pl_admin [ j ] = cache_get_field_content_int ( j, "u_admin", sql_connection ) ;

		cache_get_field_content ( j, "u_name", pl_name [ j ], sql_connection, 24 ) ;
		cache_get_field_content ( j, "u_last_date", pl_date [ j ], sql_connection, 28 ) ;
	}
 	for ( new i = 0 ; i < rows ; i ++ )
	{
	    if ( pl_admin [ i ] == 1 )
	    {
			if ( get_player_admin_level ( pl_name [ i ] ) > 7 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Запрещено просматривать информацию данного игрока." ) ;
		}
		new ban_days = get_player_banned ( pl_name [ i ] ) ;
        format ( line_string, sizeof ( line_string ), "{"#cBL"}%d. {"#cWH"}%s {"#cGRDialog"}(%s){"#cWH"}\t{"#cGN"}%s"valute_title_"{"#cWH"}\t%d ур.\t%d дней\n",
        pl_id [ i ], pl_name [ i ], pl_date [ i ], GetPlayerCashValueToSmile ( pl_money [ i ] ), pl_level [ i ], ban_days ) ;
		strcat ( global_string, line_string ) ;
	}
	show_dialog ( playerid, d_none, DIALOG_STYLE_TABLIST_HEADERS, "{"#cBHD"}Список аккаунтов", global_string, "Закрыть", "" ) ;
	return 1 ;
}

CMD:banip ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 7 )return 1 ;
	new ban_ip [ 16 ], ban_reason_ip [ 32 ] ;
	if ( sscanf ( params,"s[16]s[32]", ban_ip, ban_reason_ip ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /banip [ип] [причина]" ) ;

    if ( reload_admin_warning ( playerid, ban_reason_ip ) ) return 1 ;

	new scm_string [ 128 ];
	format ( scm_string, sizeof ( scm_string ), "banip %s", ban_ip ) ;
	SendRconCommand ( scm_string ) ;

	format ( scm_string, sizeof ( scm_string  ),"{"#cBAdmin"}[A] {"#cGRAdmin"}%s[%d] заблокировал IP %s. Причина: %s", p_info [ playerid ] [ name ], playerid, ban_ip, ban_reason_ip ) ;
	foreach(new i: admin_players)SendClientMessage ( i, col_admin, scm_string ) ;
	return true ;
}

CMD:unbanip ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 8 )return 1 ;
	if ( sscanf ( params,"s[16]",params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /unbanip [ип]" ) ;

	new scm_string [ 128 ];
	format ( scm_string, sizeof ( scm_string ), "unbanip %s", params [ 0 ] ) ;
	SendRconCommand ( scm_string ) ;

	format ( scm_string, sizeof ( scm_string  ),"{"#cBAdmin"}[A] {"#cGRAdmin"}%s[%d] разблокировал IP %s.", p_info [ playerid ] [ name ], playerid, params [ 0 ] ) ;
	foreach(new i: admin_players)SendClientMessage ( i, col_admin, scm_string ) ;
	return true ;
}

CMD:reloadbans ( playerid )
{
    if ( admin_info [ playerid ] [ admin ] < 7 )return 1 ;

    SendRconCommand ( "reloadbans" ) ;

	new scm_string [ 128 ] ;
	format ( scm_string, sizeof ( scm_string  ),"{"#cBAdmin"}[A] {"#cGRAdmin"}%s[%d] разблокировал все IP адреса.", p_info [ playerid ] [ name ], playerid ) ;
	foreach(new i: admin_players)SendClientMessage ( i, col_gray, scm_string ) ;
	return true ;
}

CMD:setfvehiclemodel ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 8 )return 1 ;
	if ( ! IsFounder ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}К сожалению, Вам данная функция не доступна." ) ;
	if ( GetPlayerState ( playerid ) != PLAYER_STATE_DRIVER ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нужно быть в транспорте." ) ;
	if ( p_info [ playerid ] [ member ] != 0 && p_info [ playerid ] [ job ] != 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны либо состоять в организации, либо работать на работе." ) ;
	if ( sscanf ( params, "d", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /setfvehiclemodel [модель]" ) ;
	if ( params [ 0 ] < 400 || params [ 0 ] > 611 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /setfvehiclemodel [модель]" ) ;

	new veh_id = GetPlayerVehicleID ( playerid ), veh_type, veh_owner ;
	if ( GetPVarInt ( playerid, "admin_vehicle" ) == veh_id ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данный транспорт не динамический." ) ;

	new Float:X, Float:Y, Float:Z ;
	GetVehiclePos ( veh_id, X, Y, Z ) ;
 	GetVehicleZAngle ( veh_id, veh_info [ veh_id - 1 ] [ v_pos ] [ 3 ] ) ;

 	veh_type = veh_info [ veh_id - 1 ] [ v_type ] ;
 	veh_owner = veh_info [ veh_id - 1 ] [ v_owner ] ;

	DestroyVehicle ( veh_id, 18 ) ;

	veh_info [ veh_id - 1 ] [ v_vehicle ] = INVALID_VEHICLE_ID ;
	veh_info [ veh_id - 1 ] [ v_model ] = params [ 0 ] ;

	veh_info [ veh_id - 1 ] [ v_pos ] [ 0 ] = X ;
	veh_info [ veh_id - 1 ] [ v_pos ] [ 1 ] = Y ;
	veh_info [ veh_id - 1 ] [ v_pos ] [ 2 ] = Z ;

    veh_info [ veh_id - 1 ] [ v_vehicle ] = AddStaticVehicleEx ( veh_info [ veh_id - 1 ] [ v_model ], veh_info [ veh_id - 1 ] [ v_pos ] [ 0 ], veh_info [ veh_id - 1 ] [ v_pos ] [ 1 ], veh_info [ veh_id - 1 ] [ v_pos ] [ 2 ], veh_info [ veh_id - 1 ] [ v_pos ] [ 3 ], veh_info [ veh_id - 1 ] [ v_color ] [ 0 ], veh_info [ veh_id - 1 ] [ v_color ] [ 1 ], 600 ) ;
	SetVehicleNumberPlate( veh_info [ veh_id - 1 ] [ v_vehicle ], veh_info [ veh_id - 1 ] [ v_plate ] ) ;
	veh_info [ veh_id - 1 ] [ v_fuel ] = 60.0 ;

	if ( veh_type == vehicle_type_rentcar )
	{
	    veh_info [ veh_id - 1 ] [ v_type ] = vehicle_type_rentcar ;
		veh_info [ veh_id - 1 ] [ v_owner ] = veh_owner ;
	}
	else
	{
		if ( p_info [ playerid ] [ member ] )
		{
		    veh_info [ veh_id - 1 ] [ v_type ] = vehicle_type_server ;
			veh_info [ veh_id - 1 ] [ v_owner ] = p_info [ playerid ] [ member ] ;
		}
		else
		{
		    veh_info [ veh_id - 1 ] [ v_type ] = vehicle_type_job ;
			veh_info [ veh_id - 1 ] [ v_owner ] = p_info [ playerid ] [ job ] ;
		}
	}

    if ( veh_info [ veh_id - 1 ] [ v_type ] == vehicle_type_rentcar )
	{
	    veh_plate ( veh_id ) ;

		new sql_string [ 76 ] ;
		mysql_format ( sql_connection, sql_string, 76, "UPDATE `rent_vehicles` SET `sv_model` = '%d' WHERE `sv_id` = '%d' LIMIT 1",
		veh_info [ veh_id - 1 ] [ v_model ],
		veh_info [ veh_id - 1 ] [ v_id ] ) ;
		mysql_tquery ( sql_connection, sql_string, "", "" ) ;
	}
	else
	{
	    new sql_string [ 76 ] ;
		mysql_format ( sql_connection, sql_string, 76, "UPDATE `server_vehicles` SET `sv_model` = '%d' WHERE `sv_id` = '%d' LIMIT 1",
		veh_info [ veh_id - 1 ] [ v_model ],
		veh_info [ veh_id - 1 ] [ v_id ] ) ;
		mysql_tquery ( sql_connection, sql_string, "", "" ) ;
	}

    SendClientMessage ( playerid, col_white, !"Модель транспорта успешно изменена." ) ;
	return 1 ;
}

CMD:setfvehiclepos ( playerid )
{
    if ( admin_info [ playerid ] [ admin ] < 8 )return 1 ;
    if ( ! IsFounder ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}К сожалению, Вам данная функция не доступна." ) ;
	if ( GetPlayerState ( playerid ) != PLAYER_STATE_DRIVER ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нужно быть в транспорте." ) ;
	if ( p_info [ playerid ] [ member ] != 0 && p_info [ playerid ] [ job ] != 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны либо состоять в организации, либо работать на работе." ) ;

	new veh_id = GetPlayerVehicleID ( playerid ), veh_type, veh_owner ;
	if ( GetPVarInt ( playerid, "admin_vehicle" ) == veh_id ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данный транспорт не динамический." ) ;

	new Float:X, Float:Y, Float:Z ;
	GetVehiclePos ( veh_id, X, Y, Z ) ;
 	GetVehicleZAngle ( veh_id, veh_info [ veh_id - 1 ] [ v_pos ] [ 3 ] ) ;

 	veh_type = veh_info [ veh_id - 1 ] [ v_type ] ;
 	veh_owner = veh_info [ veh_id - 1 ] [ v_owner ] ;

	DestroyVehicle ( veh_id, 19 ) ;
	veh_info [ veh_id - 1 ] [ v_vehicle ] = INVALID_VEHICLE_ID ;

	veh_info [ veh_id - 1 ] [ v_pos ] [ 0 ] = X ;
	veh_info [ veh_id - 1 ] [ v_pos ] [ 1 ] = Y ;
	veh_info [ veh_id - 1 ] [ v_pos ] [ 2 ] = Z ;

	veh_info [ veh_id - 1 ] [ v_vehicle ] = AddStaticVehicleEx ( veh_info [ veh_id - 1 ] [ v_model ], veh_info [ veh_id - 1 ] [ v_pos ] [ 0 ], veh_info [ veh_id - 1 ] [ v_pos ] [ 1 ], veh_info [ veh_id - 1 ] [ v_pos ] [ 2 ], veh_info [ veh_id - 1 ] [ v_pos ] [ 3 ], veh_info [ veh_id - 1 ] [ v_color ] [ 0 ], veh_info [ veh_id - 1 ] [ v_color ] [ 1 ], -1 ) ;
    SetVehicleNumberPlate( veh_info [ veh_id - 1 ] [ v_vehicle ], veh_info [ veh_id - 1 ] [ v_plate ] ) ;
	veh_info [ veh_id - 1 ] [ v_fuel ] = 60.0 ;

	if ( veh_type == vehicle_type_rentcar )
	{
	    veh_plate ( veh_id ) ;

	    veh_info [ veh_id - 1 ] [ v_type ] = vehicle_type_rentcar ;
		veh_info [ veh_id - 1 ] [ v_owner ] = veh_owner ;
	}
	else
	{
		if ( p_info [ playerid ] [ member ] )
		{
		    veh_info [ veh_id - 1 ] [ v_type ] = vehicle_type_server ;
			veh_info [ veh_id - 1 ] [ v_owner ] = p_info [ playerid ] [ member ] ;
		}
		else
		{
		    veh_info [ veh_id - 1 ] [ v_type ] = vehicle_type_job ;
			veh_info [ veh_id - 1 ] [ v_owner ] = p_info [ playerid ] [ job ] ;
		}
	}

	if ( veh_info [ veh_id - 1 ] [ v_type ] == vehicle_type_rentcar )
	{
		new query_string [ 256 ];
	 	format ( query_string, sizeof query_string, "UPDATE `rent_vehicles` SET `sv_pos_x` = '%f', `sv_pos_y` = '%f', `sv_pos_z` = '%f', `sv_pos_a` = '%f' WHERE `sv_id` = '%d' LIMIT 1",
	  	veh_info [ veh_id - 1 ] [ v_pos ] [ 0 ], veh_info [ veh_id - 1 ] [ v_pos ] [ 1 ], veh_info [ veh_id - 1 ] [ v_pos ] [ 2 ], veh_info [ veh_id - 1 ] [ v_pos ] [ 3 ],
		veh_info [ veh_id - 1 ] [ v_id ] ) ;
	 	mysql_tquery ( sql_connection, query_string ) ;
	}
	else
	{
	    new query_string [ 256 ];
	 	format ( query_string, sizeof query_string, "UPDATE `server_vehicles` SET `sv_pos_x` = '%f', `sv_pos_y` = '%f', `sv_pos_z` = '%f', `sv_pos_a` = '%f' WHERE `sv_id` = '%d' LIMIT 1",
	  	veh_info [ veh_id - 1 ] [ v_pos ] [ 0 ], veh_info [ veh_id - 1 ] [ v_pos ] [ 1 ], veh_info [ veh_id - 1 ] [ v_pos ] [ 2 ], veh_info [ veh_id - 1 ] [ v_pos ] [ 3 ],
		veh_info [ veh_id - 1 ] [ v_id ] ) ;
	 	mysql_tquery ( sql_connection, query_string ) ;
	}

    SendClientMessage ( playerid, col_white, !"Позиция транспорта успешно изменена.") ;
	return 1;
}

CMD:setfvehiclecolor ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 8 )return 1 ;
	if ( ! IsFounder ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}К сожалению, Вам данная функция не доступна." ) ;
	if ( GetPlayerState ( playerid ) != PLAYER_STATE_DRIVER ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нужно быть в транспорте." ) ;
	if ( sscanf ( params, "dd", params [ 0 ], params [ 1 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /setfvehiclecolor [цвет 1] [цвет 2]" ) ;
	new veh_id = GetPlayerVehicleID ( playerid ) ;
	if ( GetPVarInt ( playerid, "admin_vehicle" ) == veh_id ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данный транспорт не динамический." ) ;

	if ( params [ 1 ] < 0 || params [ 1 ] > 255 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /setfvehiclecolor [цвет 1] [цвет 2]" ) ;
	if ( params [ 0 ] < 0 || params [ 0 ] > 255 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /setfvehiclecolor [цвет 1] [цвет 2]" ) ;

	veh_info [ veh_id - 1 ] [ v_color ] [ 0 ] = params [ 0 ] ;
	veh_info [ veh_id - 1 ] [ v_color ] [ 1 ] = params [ 1 ] ;

	n_ChangeVehicleColor ( veh_id, params [ 0 ], params [ 1 ] ) ;

    if ( veh_info [ veh_id - 1 ] [ v_type ] == vehicle_type_rentcar )
	{
		new sql_string [ 128 ] ;
		mysql_format ( sql_connection, sql_string, 128, "UPDATE `rent_vehicles` SET `sv_color_1` = '%d',`sv_color_2` = '%d' WHERE `sv_id` = '%d' LIMIT 1",
		params [ 0 ], params [ 1 ],
		veh_info [ veh_id - 1 ] [ v_id ] ) ;
		mysql_tquery ( sql_connection, sql_string ) ;
	}
	else
	{
	    new sql_string [ 128 ] ;
		mysql_format ( sql_connection, sql_string, 128, "UPDATE `server_vehicles` SET `sv_color_1` = '%d',`sv_color_2` = '%d' WHERE `sv_id` = '%d' LIMIT 1",
		params [ 0 ], params [ 1 ],
		veh_info [ veh_id - 1 ] [ v_id ] ) ;
		mysql_tquery ( sql_connection, sql_string ) ;
	}

    SendClientMessage ( playerid, col_white, !"Цвет транспорта организации успешно изменён.") ;
	return 1;
}

CMD:az ( playerid )
{
	if ( admin_info [ playerid ] [ admin ] < 1 ) return 1 ;

	set_pos ( playerid, spawn_admin_zone [ 0 ], spawn_admin_zone [ 1 ], spawn_admin_zone [ 2 ], spawn_admin_zone [ 3 ], admin_interior, 3000 ) ;
	return 1 ;
}

CMD:givelic ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 7 ) return 1 ;
	if ( sscanf ( params, "d", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /givelic [id]");
	if ( ! IsPlayerConnected ( params [ 0 ] )  ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;


	show_dialog ( playerid, d_give_lic, DIALOG_STYLE_LIST, "{"#cBHD"}Выдача лицензий",
	"{ffffff}Водительские права\nЛицензия пилота\nЛицензия водного транспорта\nЛицензия на оружие", "Выбрать", "Отмена" ) ;
	SetPVarInt ( playerid,"gl_id", params [ 0 ] ) ;
	return 1 ;
}

CMD:giveskill ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 7 ) return 1 ;
	if ( sscanf ( params, "d", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /giveskill [id]");
	if ( ! IsPlayerConnected ( params [ 0 ] )  ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;

	for ( new j = 0 ; j < 7 ; j ++ )
	{
		p_info [ params [ 0 ] ] [ gun_skills ] [ j ] = 100 ;
	}
	new _query [ 128 ] ;

	format ( _query, sizeof ( _query ), "UPDATE `users` SET `u_skills`='%d|%d|%d|%d|%d|%d|%d' WHERE `u_id` = '%d' LIMIT 1",
	p_info [ params [ 0 ] ] [ gun_skills ] [ 0 ], p_info [ params [ 0 ] ] [ gun_skills ] [ 1 ], p_info [ params [ 0 ] ] [ gun_skills ] [ 2 ],
	p_info [ params [ 0 ] ] [ gun_skills ] [ 3 ], p_info [ params [ 0 ] ] [ gun_skills ] [ 4 ], p_info [ params [ 0 ] ] [ gun_skills ] [ 5 ],
	p_info [ params [ 0 ] ] [ gun_skills ] [ 6 ], p_info [ params [ 0 ] ] [ id ] ) ;
	mysql_tquery ( sql_connection, _query ) ;
	SetPlayerSkills ( params [ 0 ] ) ;

	format ( _query, sizeof ( _query  ),"{"#cBAdmin"}[A] {"#cGRAdmin"}%s выдал %s скиллы оружия.", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ] ) ;
	foreach(new i: admin_players)SendClientMessage ( i, col_admin, _query ) ;

	format ( _query, sizeof ( _query ), "Администратор %s установил Вам совершенные навыки оружия.", p_info [ params [ 0 ] ] [ name ] ) ;
	SendClientMessage ( params [ 0 ], col_gray, _query ) ;
	return 1 ;
}

CMD:makeleader ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 6 ) return 1 ;
	if ( sscanf ( params, "ud", params [ 0 ], params [ 1 ] ) )  return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /makeleader [ид/имя] [позиция]" ) ;
    if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
    if ( p_info [ params [ 0 ] ] [ p_warn ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока имеются предупреждения." ) ;
	if ( p_info [ params [ 0 ] ] [ member ] > 0 || p_info [ params [ 0 ] ] [ leader ] > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок состоит в организации." ) ;
    if ( params [ 1 ] < 1 || params [ 1 ] > 2 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Позиция не может быть менее 1 и более 2." ) ;
	if ( admin_info [ playerid ] [ dostup ] [ 4 ] != 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет доступа к данной команде. Используйте /donate." ) ;
	if ( p_info [ params [ 0 ] ] [ hour_played ] < FIVE_HOUR_PLAYED && admin_info [ playerid ] [ admin ] < 8 && admin_info [ playerid ] [ dostup ] [ 5 ] != 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не отыграл 5 часов." ) ;
	if ( admin_info [ params [ 0 ] ] [ admin ] > 0 && admin_info [ params [ 0 ] ] [ admin ] < 8 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте /templeader." ) ;
	if ( p_info [ params [ 0 ] ] [ blocked_leader ] || p_info [ params [ 0 ] ] [ blocked_adm ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данному игроку закрыта возможность вставать на лидерские посты." ) ;

    if ( reload_admin_warning ( playerid, "/makeleader" ) ) return 1 ;

	global_string [ 0 ] = EOS ;
	new line_string [ 100 ] ;
	for ( new j = 0; j < fraction_count ; j ++ )
	{
		format ( line_string, sizeof line_string, "{ffffff}ID:%d - {%s}%s\n", j + 1, f_info [ j ] [ f_chat_color ], f_info [ j ] [ f_name ] ) ;
		strcat ( global_string, line_string ) ;
	}
	show_dialog ( playerid, d_makeleader, DIALOG_STYLE_LIST, "{"#cBHD"}Список организаций", global_string, "Выбрать", "Закрыть" ) ;

	SetPVarInt ( playerid, "player_id", params [ 0 ] ) ;
	SetPVarInt ( playerid, "player_position", params [ 1 ] - 1 ) ;
	return 1 ;
}

CMD:templeader ( playerid )
{
	if ( admin_info [ playerid ] [ admin ] < 5 ) return 1 ;
	if ( admin_info [ playerid ] [ dostup ] [ 4 ] != 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет доступа к данной команде. Используйте /donate." ) ;

	if ( p_info [ playerid ] [ leader ] > 0 )
	{
		static const _str [ ] = "{"#cBAdmin"}[A]{"#cGRAdmin"} %s снял себя с должности временного лидера." ;
		new scm_string [ sizeof _str + 24 ] ;
		format ( scm_string, sizeof scm_string, _str, p_info [ playerid ] [ name ] ) ;
		foreach(new i: admin_players) SendClientMessage ( i, col_admin, scm_string ) ;

		if ( p_info [ playerid ] [ member ] != 0 ) Iter_Remove ( fraction_players[p_info[playerid][member]], playerid ) ;

		p_info [ playerid ] [ member ] =
		p_info [ playerid ] [ leader ] =
		p_info [ playerid ] [ rank ] =
		p_info [ playerid ] [ leader_status ] = 0 ;

		fraction_duty ( playerid ) ;
		return 1 ;
	}

    global_string [ 0 ] = EOS ;
	for ( new j = 0; j < fraction_count ; j ++ )
	{
		new line_string [ 64 ] ;
		format ( line_string, 64, "{ffffff}ID:%d - {%s}%s\n", j + 1, f_info [ j ] [ f_chat_color ], f_info [ j ] [ f_name ] ) ;
		strcat ( global_string, line_string ) ;
	}
	show_dialog ( playerid, d_templeader, DIALOG_STYLE_LIST, "{"#cBHD"}Список организаций", global_string, "Выбрать", "Закрыть" ) ;
	return 1 ;
}

CMD:unmakeleader ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 6 ) return 1 ;
	if ( sscanf ( params, "u", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /unmakeleader [ид/имя]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;

	if ( p_info [ params [ 0 ] ] [ leader ] == 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока нет прав лидера организации." ) ;
	if ( p_info [ params [ 0 ] ] [ member ] == 0 )
	{
	    p_info [ params [ 0 ] ] [ leader ] =
		p_info [ params [ 0 ] ] [ member ] =
		p_info [ params [ 0 ] ] [ rank ] =
		p_info [ params [ 0 ] ] [ org_skin ] =
		p_info [ params [ 0 ] ] [ warblock ] =
		p_info [ params [ 0 ] ] [ subleader ] =
		p_info [ params [ 0 ] ] [ f_warning ] = 0 ;

		static const _str [ ] = "DELETE FROM `fractions_players` WHERE `u_sql_id` = '%d' LIMIT 1" ;
		new query_string [ sizeof _str + 9 ] ;
		format ( query_string, sizeof query_string, _str, p_info [ params [ 0 ] ] [ id ] ) ;
		mysql_tquery ( sql_connection, query_string ) ;

		if ( is_fraction_duty { params [ 0 ] } == 1 ) is_fraction_duty { params [ 0 ] } = 0 ;

		SetPlayerSkin ( params [ 0 ], p_info [ params [ 0 ] ] [ skin ] ) ;
		SetPlayerColor ( params [ 0 ], 0xFFFFFF80 ) ; // col_white

		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Произошла ошибка. Игрок не состоит в организации!" ) ;
		return 1 ;
	}
	if ( admin_info [ playerid ] [ dostup ] [ 4 ] != 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет доступа к данной команде. Используйте /donate." ) ;

    if ( reload_admin_warning ( playerid, "/unmakeleader" ) ) return 1 ;

	new scm_string [ 162 + 9 ], fraction_id = p_info [ params [ 0 ] ] [ member ] ;
	format ( scm_string, sizeof scm_string, "{"#cBAdmin"}[A]{"#cGRAdmin"} %s снял %s с должности лидера организации \"{"#cBAdmin"}%s{"#cGRAdmin"}\"", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], f_info [ fraction_id - 1 ] [ f_name ] ) ;
	foreach(new i: admin_players)SendClientMessage ( i, col_admin, scm_string ) ;
	format ( scm_string, sizeof scm_string, " %s снял Вас с должности лидера организации \"%s\"", p_info [ playerid ] [ name ], f_info [ fraction_id - 1 ] [ f_name ] ) ;
	SendClientMessage ( params [ 0 ], col_yellow, scm_string ) ;

	new _reason [ 32 ] = "Срок" ;
	insert_joblist ( params [ 0 ], _reason, LABOR_TYPE_UNINVITE, p_info [ params [ 0 ] ] [ rank ] ) ;

	f_info [ fraction_id - 1 ] [ f_members ] -- ;
	format ( scm_string, 144, "UPDATE `fractions` SET `f_members` = '%d' WHERE `f_id` = '%d' LIMIT 1", f_info [ fraction_id - 1 ] [ f_members ], fraction_id ) ;
	mysql_tquery ( sql_connection, scm_string ) ;

	if ( p_info [ params [ 0 ] ] [ org_date ] > 1 && p_info [ params [ 0 ] ] [ org_date ] < 4 * 14 )
	{
        scm_string [ 0 ] = EOS ;
        format ( scm_string, sizeof scm_string, "UPDATE `users` SET `u_block_leader` = '50', `u_block_adm` = '100' WHERE `u_id` = '%d' LIMIT 1", p_info [ params [ 0 ] ] [ id ] ) ;
		mysql_tquery ( sql_connection, scm_string ) ;

        SendClientMessage ( playerid, col_white, !"Игрок получил лидерскую блокировку за то, что не отстоял минимальный срок!" ) ;
        SendClientMessage ( params [ 0 ], col_white, !"Вы получили лидерскую блокировку за то, что не отстоялт минимальный срок!" ) ;

        scm_string [ 0 ] = EOS ;
		format ( scm_string, 128, "%s выдал LEADER BLOCK %s", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ]);
		WriteLog ( playerid, TYPE_LOG_ADMIN, scm_string ) ;
	}

	if ( fraction_id != 0 ) Iter_Remove ( fraction_players[fraction_id], params [ 0 ] ) ;

    p_info [ params [ 0 ] ] [ leader ] =
	p_info [ params [ 0 ] ] [ member ] =
	p_info [ params [ 0 ] ] [ rank ] =
	p_info [ params [ 0 ] ] [ org_skin ] =
	p_info [ params [ 0 ] ] [ warblock ] =
	p_info [ params [ 0 ] ] [ subleader ] =
	p_info [ params [ 0 ] ] [ f_warning ] = 0 ;

	format ( scm_string, sizeof scm_string, "DELETE FROM `fractions_players` WHERE `u_sql_id` = '%d' LIMIT 1", p_info [ params [ 0 ] ] [ id ] ) ;
	mysql_tquery ( sql_connection, scm_string ) ;

	if ( is_fraction_duty { params [ 0 ] } == 1 ) is_fraction_duty { params [ 0 ] } = 0 ;

	SetPlayerSkin ( params [ 0 ], p_info [ params [ 0 ] ] [ skin ] ) ;
	SetPlayerColor ( params [ 0 ], 0xFFFFFF80 ) ; // col_white

	scm_string [ 0 ] = EOS ;
	format ( scm_string, sizeof scm_string, "%s снял %s с лидерства %s", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], f_info [ fraction_id - 1 ] [ f_name ] );
	WriteLog ( playerid, TYPE_LOG_MKL, scm_string ) ;
	return 1 ;
}

CMD:afind ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 3 ) return 1 ;
	if ( sscanf ( params, "d", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /afind [номер организации]" ) ;
	if ( params [ 0 ] < 0 || params [ 0 ] > fraction_count )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Неправильный номер организации." ) ;

	global_string [ 0 ] = EOS ;

	show_find ( playerid, params [ 0 ] ) ;
	return 1 ;
}

CMD:achat ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 3 ) return 1 ;
	if ( sscanf ( params, "d", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /achat [номер организации]" ) ;
	if ( params [ 0 ] < 0 || params [ 0 ] > fraction_count )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Неправильный номер организации." ) ;
	is_control_chat { playerid } = params [ 0 ] ;
	if ( params [ 0 ] == 0 )
	{
		SendClientMessage ( playerid, col_admin, "{"#cBAdmin"}[A]{"#cGRAdmin"} Вы отключили прослушку чата организации." ) ;
	}
	else
	{
		new t_string [ 116 ] ;
		format ( t_string, sizeof ( t_string ), "{"#cBAdmin"}[A]{"#cGRAdmin"} Вы начали прослушку чата организации \"{"#cBAdmin"}%s{"#cGRAdmin"}\"", f_info [ params [ 0 ] - 1 ] [ f_name ] ) ;
		SendClientMessage ( playerid, col_admin, t_string ) ;
	}
	return 1;
}

CMD:r ( playerid, params [ ] )
{
	if ( p_info [ playerid ] [ member ] > 17 && ! radio_player ( playerid ) && is_fraction_cover { playerid } != 7 || p_info [ playerid ] [ member ] == 0 ) return 1 ;
	if ( p_info [ playerid ] [ mute ] )
	{
		new scm_string [ 38 ] ;
		format ( scm_string, sizeof ( scm_string ),"{"#cRInfo"}* {"#cGRInfo"}У вас бан чата | %d секунд(ы)", p_info [ playerid ] [ mute ] ) ;
		SendClientMessage ( playerid, col_light_red, scm_string ) ;
		return true ;
	}
	if ( p_info [ playerid ] [ f_mute ] )
	{
		new scm_string [ 78 ] ;
		format ( scm_string, sizeof ( scm_string ),"{"#cRInfo"}* {"#cGRInfo"}У вас затычка в чате организации | %d секунд(ы)", p_info [ playerid ] [ f_mute ] ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
		return false ;
	}
    if ( is_fraction_cover { playerid } == 7 )
	{
	    if ( sscanf ( params, "ds[100]", params [ 0 ], params [ 1 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /r [1 - чат организации, 2 - чат ФБР] [текст]" ) ;
	 	if ( check_advertise ( playerid, params [ 1 ], report_type_r ) ) return 1 ;
	 	if ( params [ 0 ] < 1 || params [ 0 ] > 2 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не указали параметр чата." ) ;
	 	if ( params [ 0 ] == 1 )
	 	{
			new scm_string [ 144 ];

			if ( p_info [ playerid ] [ subleader ] ) format ( scm_string, sizeof scm_string, "[R] %s %s[%d]: [%s] %s", f_rank [ p_info [ playerid ] [ member ] - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], playerid, unit_info [ p_info [ playerid ] [ subleader ] - 1 ] [ un_name ], params [ 0 ] ) ;
			else format ( scm_string, sizeof scm_string, "[R] %s %s[%d]: %s", f_rank [ p_info [ playerid ] [ member ] - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], playerid, params [ 0 ] ) ;
			fraction_message ( p_info [ playerid ] [ member ], col_lblue, scm_string ) ;

		    format(scm_string, sizeof scm_string, "сказал(а) в рацию: {FFFFFF}%s", params [ 1 ]);
			SetPlayerChatBubble(playerid, scm_string, col_light_purple, 13.0, 5000);
			return false ;
		}
		if ( params [ 0 ] == 2 )
		{
			new scm_string [ 144 ];

			format ( scm_string, sizeof scm_string, "[R] (COVER) %s %s[%d]: %s", f_rank [ is_fraction_cover { playerid } - 1 ] [ is_fraction_cover_rank { playerid } - 1 ], p_info [ playerid ] [ name ], playerid, params [ 1 ] ) ;
			foreach(new i: logged_players) if ( ( p_info [ i ] [ member ] == is_fraction_cover { playerid } || is_control_chat { i } == is_fraction_cover { playerid } ) && p_info [ i ] [ settings ] [ 0 ] != 0 || ( player_ssf { i } == p_info [ playerid ] [ member ] || player_ssf { i } == is_control_chat { playerid } ) && p_info [ i ] [ settings ] [ 0 ] != 0 ) SendClientMessage ( i, col_lblue, scm_string ) ;

            SendClientMessage ( playerid, col_lblue, scm_string ) ;

		    format(scm_string, sizeof scm_string, "сказал(а) в рацию: {FFFFFF}%s", params [ 1 ]);
			SetPlayerChatBubble(playerid, scm_string, col_light_purple, 13.0, 5000);
			return false ;
		}
	}
	if ( sscanf ( params, "s[100]", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /r [текст]" ) ;
 	if ( check_advertise ( playerid, params [ 0 ], report_type_r ) ) return 1 ;

    new scm_string [ 144 ], fraction_id = p_info [ playerid ] [ member ] ;
	if ( p_info [ playerid ] [ subleader ] > 0 ) format ( scm_string, sizeof scm_string, "[R] %s %s[%d]: [%s] %s", f_rank [ fraction_id - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], playerid, unit_info [ p_info [ playerid ] [ subleader ] - 1 ] [ un_name ], params [ 0 ] ) ;
	else format ( scm_string, sizeof scm_string, "[R] %s %s[%d]: %s", f_rank [ fraction_id - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], playerid, params [ 0 ] ) ;
	fraction_message ( fraction_id, col_lblue, scm_string ) ;

	format(scm_string, sizeof scm_string, "сказал(а) в рацию: {FFFFFF}%s", params [ 0 ]);
	SetPlayerChatBubble(playerid, scm_string, col_light_purple, 13.0, 5000);
	return 1;
}

CMD:rn ( playerid, params [ ] )
{
	if ( p_info [ playerid ] [ member ] > 17 && ! radio_player ( playerid ) && is_fraction_cover { playerid } != 7 || p_info [ playerid ] [ member ] == 0 ) return 1 ;
	if ( p_info [ playerid ] [ mute ] )
	{
		new scm_string [ 38 ] ;
		format ( scm_string, sizeof ( scm_string ),"{"#cRInfo"}* {"#cGRInfo"}У вас бан чата | %d секунд(ы)", p_info [ playerid ] [ mute ] ) ;
		SendClientMessage ( playerid, col_light_red, scm_string ) ;
		return true ;
	}
	if ( p_info [ playerid ] [ f_mute ] )
	{
		new scm_string [ 78 ] ;
		format ( scm_string, sizeof ( scm_string ),"{"#cRInfo"}* {"#cGRInfo"}У вас затычка в чате организации | %d секунд(ы)", p_info [ playerid ] [ f_mute ] ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
		return false ;
	}
 	if ( is_fraction_cover { playerid } == 7 )
	{
	    if ( sscanf ( params, "ds[100]", params [ 0 ], params [ 1 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /rn [1 - чат организации, 2 - чат ФБР] [текст]" ) ;
	 	if ( check_advertise ( playerid, params [ 1 ], report_type_rn ) ) return 1 ;
	 	if ( params [ 0 ] < 1 || params [ 0 ] > 2 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не указали параметр чата." ) ;
	 	if ( params [ 0 ] == 1 )
	 	{
			new scm_string [ 144 ];

			if ( p_info [ playerid ] [ subleader ] ) format ( scm_string, sizeof scm_string, "(( [R] %s %s[%d]: [%s] %s ))", f_rank [ p_info [ playerid ] [ member ] - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], playerid, unit_info [ p_info [ playerid ] [ subleader ] - 1 ] [ un_name ], params [ 0 ] ) ;
			else format ( scm_string, sizeof scm_string, "(( [R] %s %s[%d]: %s ))", f_rank [ p_info [ playerid ] [ member ] - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], playerid, params [ 0 ] ) ;
			fraction_message ( p_info [ playerid ] [ member ], col_lblue, scm_string ) ;

		    format(scm_string, sizeof scm_string, "сказал(а) в рацию: {FFFFFF}(( %s ))", params [ 0 ]);
			SetPlayerChatBubble(playerid, scm_string, col_light_purple, 13.0, 5000);
			return false ;
		}
		if ( params [ 0 ] == 2 )
		{
			new scm_string [ 144 ];

			format ( scm_string, sizeof scm_string, "(( [R] (COVER) %s %s[%d]: %s ))", f_rank [ is_fraction_cover { playerid } - 1 ] [ is_fraction_cover_rank { playerid } - 1 ], p_info [ playerid ] [ name ], playerid, params [ 1 ] ) ;
			foreach(new i: logged_players) if ( ( p_info [ i ] [ member ] == is_fraction_cover { playerid } || is_control_chat { i } == is_fraction_cover { playerid } ) && p_info [ i ] [ settings ] [ 0 ] != 0 || ( player_ssf { i } == p_info [ playerid ] [ member ] || player_ssf { i } == is_control_chat { playerid } ) && p_info [ i ] [ settings ] [ 0 ] != 0 ) SendClientMessage ( i, col_lblue, scm_string ) ;

            SendClientMessage ( playerid, col_lblue, scm_string ) ;

		    format(scm_string, sizeof scm_string, "сказал(а) в рацию: {FFFFFF}(( %s ))", params [ 0 ]);
			SetPlayerChatBubble(playerid, scm_string, col_light_purple, 13.0, 5000);
			return false ;
		}
	}
	if ( sscanf ( params, "s[100]", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /rn [текст]" ) ;
 	if ( check_advertise ( playerid, params [ 0 ], report_type_rn ) ) return 1 ;

    new scm_string [ 144 ], fraction_id = p_info [ playerid ] [ member ] ;
	if ( p_info [ playerid ] [ subleader ] > 0 ) format ( scm_string, sizeof scm_string, "(( [R] %s %s[%d]: [%s] %s ))", f_rank [ fraction_id - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], playerid, unit_info [ p_info [ playerid ] [ subleader ] - 1 ] [ un_name ], params [ 0 ] ) ;
	else format ( scm_string, sizeof scm_string, "(( [R] %s %s[%d]: %s ))", f_rank [ fraction_id - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], playerid, params [ 0 ] ) ;
	fraction_message ( fraction_id, col_lblue, scm_string ) ;

    format(scm_string, sizeof scm_string, "сказал(а) в рацию: {FFFFFF}(( %s ))", params [ 0 ]);
	SetPlayerChatBubble(playerid, scm_string, col_light_purple, 13.0, 5000);
	return 1;
}

