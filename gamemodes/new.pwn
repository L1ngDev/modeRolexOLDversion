			{
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вызывать меню с транспортом можно раз в {"#cRInfo"}10 секунд{"#cGRInfo"}." ) ;
				return 1 ;
			}

			b_info [ t ] [ b_car_cooldown ] [ 0 ] = gettime ( ) + 10 ;

