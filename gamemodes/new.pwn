stock WriteLog ( playerid, type, text [ ] )
{
	global_string [ 0 ] = EOS ;

	format ( global_string, sizeof global_string, "INSERT INTO `logs_all`(`member`, `type`, `text`, `name`) VALUES ('0', '%d', '%s', '%s')", type, text, p_info [ playerid ] [ name ] ) ;
	mysql_tquery ( sql_connection, global_string ) ;
	return 1 ;
}

stock WriteLogs ( playerid, org, type, text [ ] )
{
	global_string [ 0 ] = EOS ;

	format ( global_string, sizeof global_string, "INSERT INTO `logs_all`(`member`, `type`, `text`, `name`) VALUES ('%d', '%d', '%s', '%s')", org, type, text, p_info [ playerid ] [ name ] ) ;
	mysql_tquery ( sql_connection, global_string ) ;
	return 1 ;
}

stock WriteLogsName ( name_player [ ], org, type, text [ ] )
{
	global_string [ 0 ] = EOS ;

	format ( global_string, sizeof global_string, "INSERT INTO `logs_all`(`member`, `type`, `text`, `name`) VALUES ('%d', '%d', '%s', '%s')", org, type, text, name_player ) ;
	mysql_tquery ( sql_connection, global_string ) ;
	return 1 ;
}

stock write_fraction ( playerid, org, type, text [ ] )
{
	global_string [ 0 ] = EOS ;

	format ( global_string, sizeof global_string, "INSERT INTO `logs_fractions`(`name`, `fraction`, `type`, `text`) VALUES ('%s', '%d', '%d', '%s')", p_info [ playerid ] [ name ], org, type, text ) ;
	mysql_tquery ( sql_connection, global_string ) ;
	return 1 ;
}

stock insert_report ( playerid, text [ ] )
{
	global_string [ 0 ] = EOS ;

	report_count ++ ;
	report_id [ playerid ] = report_count ;

	format ( global_string, sizeof global_string, "INSERT INTO `logs_report`(`r_id`, `text`, `u_name`, `u_id`, `r_status`) VALUES ('%d', '%s', '%s', '%d', '0')", report_count, text, p_info [ playerid ] [ name ], p_info [ playerid ] [ id ] ) ;
	mysql_tquery ( sql_connection, global_string ) ;

	if ( auto_report ) go_auto_report ( ) ;
	return 1 ;
}

stock update_report ( playerid, text [ ], _report_id, _report_status )
{
    global_string [ 0 ] = EOS ;

    format ( global_string, sizeof global_string, "UPDATE `logs_report` SET `a_text` = '%s', `a_name` = '%s', `a_id` = '%d', `a_date` = NOW(), `r_status` = '%d' WHERE `r_id` = '%d' LIMIT 1", text, p_info [ playerid ] [ name ], p_info [ playerid ] [ id ], _report_status, _report_id ) ;
	mysql_tquery ( sql_connection, global_string ) ;

	if ( auto_report ) go_auto_report ( ) ;
	return 1 ;
}

stock insert_debtor_message ( info_tag [ ], text [ ], account_id )
{
    global_string [ 0 ] = EOS ;
    format ( global_string, sizeof global_string, "INSERT INTO `debtor_message`(`dm_info`, `dm_text`, `dm_dest`, `dm_status`) VALUES ('%s', '%s', '%d', '0')", info_tag, text, account_id ) ;
	mysql_tquery ( sql_connection, global_string ) ;
	return 1 ;
}

stock packetOffNotificationDestroy ( playerid )
{
	static const _str [ ] = "DELETE FROM `debtor_message` WHERE `dm_dest` = '%d'" ;
	new query_string [ sizeof _str + 9 ] ;
	format ( query_string, sizeof query_string, _str, p_info [ playerid ] [ id ] ) ;
	mysql_tquery ( sql_connection, query_string ) ;
	return true ;
}

stock insert_return_money ( infoTag [ ], returnMoney, userId )
{
    global_string [ 0 ] = EOS ;
	format ( global_string, sizeof ( global_string ), "\
		INSERT INTO `deposit_transfer` \
		(`dl_owner`,`dl_money`) \
		VALUES \
		('%d','%d')",
		userId, returnMoney ) ;
	mysql_tquery ( sql_connection, global_string ) ;

	static const _str [ ] = "SELECT `u_name`,`u_money`,`u_last_ip` FROM `users` WHERE `u_id` = '%d' LIMIT 1" ;
	new query_string [ sizeof _str + 9 ] ;
	format ( query_string, sizeof query_string, _str, userId ) ;
	mysql_tquery ( sql_connection, query_string, "insertReturnMoneyLog", "si", infoTag, returnMoney ) ;
	return 1 ;
}

callback: insertReturnMoneyLog ( infoTag [ ], returnMoney )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;

	new playerName [ MAX_PLAYER_NAME ], playerIp [ 16 ], playerMoney ;
	cache_get_field_content ( 0, "u_name", playerName ) ;
	cache_get_field_content ( 0, "u_last_ip", playerIp ) ;
	playerMoney = cache_get_field_content_int ( 0, "u_money" ) ;

	insertMoneyLogName ( playerName, playerMoney, returnMoney, playerIp, infoTag ) ;
	return true ;
}

stock go_auto_report ( )
{
	foreach(new i: admin_players)
 	{
 	    if ( admin_info [ i ] [ admin ] > 4 ) continue ;
  		if ( p_t_info [ i ] [ p_dialog ] != -1 ) continue ;

		//mysql_tquery ( sql_connection, "SELECT `r_id`, `u_id`, `r_status`, `u_name`, `date`, `text` FROM `logs_report` WHERE `r_status` = '0' ORDER BY `logs_report`.`r_id` DESC LIMIT 1", "callback_admin_report_info", "i", i ) ;
		callcmd::areport ( i ) ;
		break ;
	}
	return 1 ;
}

alias:checkreport("checkrep")
CMD:checkreport ( playerid )
{
    new sql_string [ 137 + 9 ] ;
	format ( sql_string, sizeof sql_string, "SELECT `r_id`, `r_status`, `date` FROM `logs_report` WHERE `u_id` = '%d' ORDER BY `logs_report`.`u_id` DESC LIMIT 10", p_info [ playerid ] [ id ] ) ;
	mysql_tquery ( sql_connection, sql_string, "callback_report_check", "i", playerid ) ;
	return 1 ;
}

callback: callback_report_check ( playerid )
{
    new rows, fields ;
	cache_get_data ( rows, fields ) ;

	if ( ! rows )
	{
	    SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Ваши жалобы не найдены!" ) ;
		return 1 ;
	}

	global_string [ 0 ] = EOS ;
	new line_string [ 128 ] ;
	new text_date [ 32 ], _r_id, _r_status ;
	for ( new i = 0 ; i < rows ; i ++ )
	{
	    _r_id = cache_get_field_content_int ( i, "r_id" ) ;
	    _r_status = cache_get_field_content_int ( i, "r_status" ) ;

		cache_get_field_content ( i, "date", text_date ) ;

		format ( line_string, 16, "vrl_%d", i ) ;
		SetPVarInt ( playerid, line_string, _r_id ) ;

		format ( line_string, 16, "vr_%d", i ) ;
		SetPVarInt ( playerid, line_string, _r_status ) ;

		format ( line_string, sizeof ( line_string ), "{"#cBL"}№%d. {"#cGRDialog"}[%s{"#cGRDialog"}] {"#cWH"}%s\n", _r_id, ( _r_status != 0 ) ? ( "{"#cGN"}Есть ответ" ) : ( "{"#cLY"}Ожидает ответа" ), text_date ) ;
		strcat ( global_string, line_string ) ;
	}
	show_dialog ( playerid, d_report_player, DIALOG_STYLE_LIST, "{"#cBHD"}Последние 10 жалоб от Вас", global_string, "Выбрать", "Закрыть" ) ;
	return 1 ;
}

callback: callback_report_check_info ( playerid )
{
    new rows, fields ;
	cache_get_data ( rows, fields ) ;

	if ( ! rows )
	{
	    DeletePVar ( playerid, "select_status" ) ;
		DeletePVar ( playerid, "select_id" ) ;
	    callcmd::checkreport ( playerid ) ;
		return 1 ;
	}

	new _p_name [ 32 ], _p_date [ 48 ], _p_text [ 128 ],
		_a_name [ 32 ], _a_date [ 48 ], _a_text [ 128 ],
		_r_status, _r_id ;

	_r_id = cache_get_field_content_int ( 0, "r_id", sql_connection ) ;
    _r_status = cache_get_field_content_int ( 0, "r_status", sql_connection ) ;

	cache_get_field_content ( 0, "u_name", _p_name, sql_connection, 32 ) ;
	cache_get_field_content ( 0, "date", _p_date, sql_connection, 48 ) ;
	cache_get_field_content ( 0, "text", _p_text, sql_connection, 128 ) ;

	cache_get_field_content ( 0, "a_name", _a_name, sql_connection, 32 ) ;
	cache_get_field_content ( 0, "a_date", _a_date, sql_connection, 48 ) ;
	cache_get_field_content ( 0, "a_text", _a_text, sql_connection, 128 ) ;

    global_string [ 0 ] = EOS ;
	if ( _r_status != 0 )
	{
		format ( global_string, sizeof ( global_string ), "{"#cWH"}Текст жалобы: {"#cGN"}%s\n{"#cWH"}Дата подачи: {"#cWV"}%s\n{"#cWH"}Статус: {"#cGN"}%s\n\n{"#cWH"}Ответ: {"#cGN"}%s\n{"#cWH"}Время ответа: {"#cWV"}%s\n{"#cWH"}Ответил администратор: {"#cOR"}%s",
		_p_text, _p_date, ( _r_status != 0 ) ? ( "{"#cGN"}Есть ответ" ) : ( "{"#cLY"}Ожидает ответа" ),
		_a_text, _a_date, _a_name ) ;
	}
	else
	{
		format ( global_string, sizeof ( global_string ), "{"#cWH"}Текст жалобы: {"#cGN"}%s\n{"#cWH"}Дата подачи: {"#cWV"}%s\n{"#cWH"}Статус: {"#cGN"}%s",
		_p_text, _p_date, ( _r_status == 1 ) ? ( "{"#cGN"}Есть ответ" ) : ( "{"#cLY"}Ожидает ответа" ) ) ;
	}

	new line_string [ 64 ] ;
	format ( line_string, sizeof line_string, "{"#cBHD"}Жалоба {"#cBL"}№%d", _r_id ) ;
	show_dialog(playerid, d_report_player_select, DIALOG_STYLE_MSGBOX, line_string, global_string, "Удалить", "Назад" ) ;
	return 1 ;
}

callback: getMembersLogs ( playerid, typeLogs, page, init )
{
    if ( init )
    {
		static const _str [ ] = "SELECT id, name, date, type FROM logs_fractions WHERE fraction = %d AND type = %d ORDER BY logs_fractions.id DESC LIMIT 10 OFFSET %d" ;
		new query_string [ sizeof _str + ( 9 * 2 ) ] ;
        format ( query_string, sizeof query_string, _str, p_info [ playerid ] [ member ], typeLogs, page * 10 ) ;
        mysql_tquery ( sql_connection, query_string, "getMembersLogs", "iiii", playerid, typeLogs, page, 0 ) ;
    }
    else
    {
		page_count [ playerid ] = page ;

        new rows, fields ;
		cache_get_data ( rows, fields ) ;

		if ( ! rows )
		{
			send_check_cinfo ( playerid, "Ничего не найдено!", 0, 3, CINFO_OTHER_ID, PICTURE_INFO_ERROR, "", "" ) ;
			return 1 ;
		}

        new playerName [ MAX_PLAYER_NAME ], logType, textDate [ 32 ], logText [ 256 ] ;

		global_string [ 0 ] = EOS ;
		strcat ( global_string, "{"#cBL"}Игрок:\t{"#cBL"}Дата:\t{"#cBL"}Действие:\t{"#cBL"}Тип:\n" ) ;
		for ( new i = 0 ; i < rows ; i ++ )
		{
			cache_get_field_content ( i, "name", playerName ) ;
			cache_get_field_content ( i, "date", textDate ) ;
			cache_get_field_content ( i, "text", logText ) ;
			logType = cache_get_field_content_int ( i, "type" ) ;

			format ( global_string, sizeof global_string, "%s{"#cWH"}%s\t%s\t%s\t%s\n", global_string, playerName, textDate, logText, logs_type ( logType ) ) ;
		}

		if ( page > 0 ) strcat ( global_string, "{"#cBL"}Предыдущая страница\n" ) ;
		if ( rows == 10 ) strcat ( global_string, "{"#cBL"}Следующая страница" ) ;

		show_dialog ( playerid, d_fractions_lognext, DIALOG_STYLE_TABLIST_HEADERS, "{"#cBHD"}Логирование", global_string, "Выбрать", "Закрыть" ) ;
    }
    return true ;
}

callback: logs_info_fraction ( playerid )
{
    new rows, fields ;
	cache_get_data ( rows, fields ) ;

	if ( ! rows )
	{
	    page_count [ playerid ] = 0 ;
		ShowLeaderMenu ( playerid ) ;
		return 1 ;
	}

	new _t_name [ 32 ], _t_date [ 48 ], _t_text [ 128 ], _t_type ;
	cache_get_field_content ( 0, "name", _t_name, sql_connection, 32 ) ;
	cache_get_field_content ( 0, "date", _t_date, sql_connection, 48 ) ;
	cache_get_field_content ( 0, "text", _t_text, sql_connection, 128 ) ;
	_t_type = cache_get_field_content_int ( 0, "type", sql_connection ) ;

	static const _str [ ] = "{"#cWH"}Ник персонажа: {"#cOR"}%s\n{"#cWH"}Дата: {"#cWV"}%s\n{"#cWH"}Тип: {"#cOR"}%s\n\n{"#cWH"}Действие: {"#cGN"}%s" ;
	new logs_dialog [ sizeof _str + 24 + 48 + 128 + 24 ] ;
	format ( logs_dialog, sizeof ( logs_dialog ), _str, _t_name, _t_date, logs_type ( _t_type ), _t_text);
	show_dialog ( playerid, d_fraction_logback, DIALOG_STYLE_MSGBOX, "{"#cBHD"}История организации", logs_dialog, "Назад", "Закрыть" ) ;
	return 1 ;
}

callback: logs_fraction ( playerid )
{
    new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows )
	{
	    page_count [ playerid ] = 0 ;
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Активных логов не найдено." ) ;
		return 1 ;
	}

    global_string [ 0 ] = EOS ;
	page_rows [ playerid ] = rows ;
    new rows_list = page_count [ playerid ] - 1 ;
    global_string [ 0 ] = EOS ;
	new line_string [ 128 ], row_count ;
    new _t_name [ 32 ], _t_id, _t_time [ 32 ], _t_type ;
	for ( new i = rows_list * 10 ; i <  rows_list * 10 + 10 ; i ++ )
	{
	    if ( i >= rows ) break ;

	    _t_id = cache_get_field_content_int ( i, "id", sql_connection ) ;

		cache_get_field_content ( i, "name", _t_name, sql_connection, 32 ) ;
		cache_get_field_content ( i, "date", _t_time, sql_connection, 32 ) ;
		_t_type = cache_get_field_content_int ( i, "type", sql_connection ) ;

		set_player_listitem_values ( playerid, i - rows_list * 10, _t_id ) ;

		format ( line_string, sizeof line_string, "{"#cBL"}%d. {"#cGRDialog"}[%s{"#cGRDialog"}] {"#cWH"}%s {"#cGRDialog"}(%s)\n", i + 1, logs_type ( _t_type ), _t_name, _t_time ) ;
		strcat ( global_string, line_string ) ;

		row_count ++ ;
	}

	if ( rows_list > 0 )
	{
		strcat ( global_string, "{"#cBL"}Предыдущая страница\n" ) ;
		set_player_use_page ( playerid, row_count, 0 ) ;
		row_count ++ ;
	}
	if ( ofm_formula ( page_count [ playerid ] ) < rows )
	{
		strcat ( global_string, "{"#cBL"}Следующая страница\n" ) ;
		set_player_use_page ( playerid, row_count, 1 ) ;
	}

	show_dialog ( playerid, d_fraction_lognext, DIALOG_STYLE_LIST, "{"#cBHD"}История организации", global_string, "Выбрать", "Закрыть" ) ;
	return 1 ;
}

