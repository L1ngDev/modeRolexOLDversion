		}

		for ( new i = 0 ; i < fraction_count ; i ++ )
	    {
	        /*format ( dialog_string, sizeof ( dialog_string ), "SELECT `u_member` FROM `users` WHERE `u_member` = '%d'", i + 1 ) ;
			mysql_tquery ( sql_connection, dialog_string, "fractions_loading_member", "i", i ) ;*/

			InventoryLoading ( f_info [ i ] [ f_id ], i + 1, SUB_INV_FRACTION, 1 ) ;
	    }

	    #if defined m_pickup_car
		    pc_OnGameModeInit ( ) ;
		#endif

		printf ( "[SERVER] Загружено %d фракций. (%d ms)", fraction_count, GetTickCount ( ) - time ) ;
		mysql_tquery ( sql_connection, !"SELECT * FROM `fractions_training`", "fractions_tr_loading" ) ;
	}
	else print ( "[SERVER] Фракции не были найдены в базе данных." ) ;
	return 1 ;
}

callback: fractions_loading_member ( _fr_id )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;

	new dialog_string [ 72 + 4 + 4 ] ;
    f_info [ _fr_id ] [ f_members ] = rows ;
	format ( dialog_string, sizeof ( dialog_string ), "UPDATE `fractions` SET `f_members` = '%d' WHERE `f_id` = '%d' LIMIT 1", f_info [ _fr_id ] [ f_members ], _fr_id + 1 ) ;
	mysql_tquery ( sql_connection, dialog_string ) ;
	return 1 ;
}

callback: fractions_tr_loading ( )
{
	new rows, fields, time = GetTickCount ( ) ;
	cache_get_data ( rows, fields ) ;
	if ( rows )
	{
		for ( new i = 0 ; i < rows ; i ++ )
		{
		    if ( GetString ( f_info [ i ] [ f_name ], "Резерв" ) ) continue ;

			f_info [ i ] [ f_tr_status ] = cache_get_field_content_int ( i, "f_tr_status", sql_connection ) ;
			f_info [ i ] [ f_tr_status_map ] = cache_get_field_content_int ( i, "f_tr_status_map", sql_connection ) ;
			f_info [ i ] [ f_tr_map ] = cache_get_field_content_int ( i, "f_tr_map", sql_connection ) ;

			global_string [ 0 ] = EOS ;
		    cache_get_field_content ( i, "f_tr_pickup", global_string ), sscanf ( global_string, "p<|>ffffdd",
			f_info [ i ] [ f_tr_pickup ] [ 0 ], f_info [ i ] [ f_tr_pickup ] [ 1 ], f_info [ i ] [ f_tr_pickup ] [ 2 ],
			f_info [ i ] [ f_tr_pickup ] [ 3 ], f_info [ i ] [ f_tr_int ], f_info [ i ] [ f_tr_vw ] ) ;

			f_info [ i ] [ f_tr_exit_pickup ] [ 0 ] = CreateDynamicPickup ( 1318, 23, training_pickup_exit [ 0 ] [ 0 ], training_pickup_exit [ 0 ] [ 1 ], training_pickup_exit [ 0 ] [ 2 ], f_info [ i ] [ f_id ], interior_training ) ;
            pick_info [ f_info [ i ] [ f_tr_exit_pickup ] [ 0 ] ] [ pick_type ] = pick_type_training ;

			f_info [ i ] [ f_tr_exit_pickup ] [ 1 ] = CreateDynamicPickup ( 1318, 23, training_pickup_exit [ 1 ] [ 0 ], training_pickup_exit [ 1 ] [ 1 ], training_pickup_exit [ 1 ] [ 2 ], f_info [ i ] [ f_id ], interior_training ) ;
            pick_info [ f_info [ i ] [ f_tr_exit_pickup ] [ 1 ] ] [ pick_type ] = pick_type_training ;

			/*f_info [ i ] [ f_tr_exit_pickup ] [ 2 ] = CreateDynamicPickup ( 1318, 23, training_pickup_exit [ 2 ] [ 0 ], training_pickup_exit [ 2 ] [ 1 ], training_pickup_exit [ 2 ] [ 2 ], f_info [ i ] [ f_id ], f_info [ i ] [ f_id ] ) ;
            pick_info [ f_info [ i ] [ f_tr_exit_pickup ] [ 2 ] ] [ pick_type ] = pick_type_training ;*/

			f_info [ i ] [ f_tr_enter_pickup ] = CreateDynamicPickup ( 1318, 23, f_info [ i ] [ f_tr_pickup ] [ 0 ], f_info [ i ] [ f_tr_pickup ] [ 1 ], f_info [ i ] [ f_tr_pickup ] [ 2 ], f_info [ i ] [ f_tr_vw ], f_info [ i ] [ f_tr_int ] ) ;
           	pick_info [ f_info [ i ] [ f_tr_enter_pickup ] ] [ pick_type ] = pick_type_training ;
           	pick_info [ f_info [ i ] [ f_tr_enter_pickup ] ] [ pick_item ] = i ;

            new tr_string [ 64 ] ;
			format ( tr_string, sizeof tr_string, "** Тренировочный комплекс **\n{%s}%s", f_info [ i ] [ f_chat_color ], f_info [ i ] [ f_name ] ) ;
           	f_info [ i ] [ f_tr_label ] = CreateDynamic3DTextLabel ( tr_string, col_header_3d, f_info [ i ] [ f_tr_pickup ] [ 0 ], f_info [ i ] [ f_tr_pickup ] [ 1 ], f_info [ i ] [ f_tr_pickup ] [ 2 ] + 0.5, 5.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, f_info [ i ] [ f_tr_vw ], f_info [ i ] [ f_tr_int ] );

		    global_string [ 0 ] = EOS ;
		    cache_get_field_content ( i, "f_tr_dostup", global_string ), sscanf ( global_string, "p<|>ddddddddddddddddddddddddddddd",
			f_info [ i ] [ f_tr_dostup ] [ 0 ], f_info [ i ] [ f_tr_dostup ] [ 1 ], f_info [ i ] [ f_tr_dostup ] [ 2 ],
