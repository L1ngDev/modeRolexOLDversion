CMD:buninvite ( playerid, params [ ] )
{
    if ( ! Iter_Count(player_business[playerid]) && p_info [ playerid ] [ b_worker ] == -1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет бизнеса или Вы не являетесь менеджером." ) ;
    if ( sscanf(params, "us[32]", params [ 0 ], params [ 1 ] ) )return SendClientMessage ( playerid, -1, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /buninvite [id] [причина]" ) ;

 	if ( ! IsPlayerConnected ( params [ 0 ] ) )
	 	return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( params [ 0 ] == playerid )
		return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете применить это к самому себе." ) ;
	if ( strlen ( params [ 1 ] ) < 3 || strlen ( params [ 1 ] ) > 32 )
		return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Причина должна содержать от 3 до 32 символов." ) ;
	if ( is_text_invalid ( params [ 1 ] ) )
		return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Причина содержит некорректные символы." ) ;

	new business_id = -1 ;
	if ( p_info [ playerid ] [ b_worker ] != -1 )
	{
		if ( p_info [ playerid ] [ business_rang ] <  b_info [ p_info [ playerid ] [ b_worker ] - 1 ] [ b_settings ] [ 2 ] )
		{
		    static const _str [ ] = "{"#cRInfo"}* {"#cGRInfo"}Команда доступна с должности %s (%d)." ;
		    new scm_string [ sizeof _str + 30 + 4 ] ;
		    format ( scm_string, sizeof scm_string, _str, b_rank [ p_info [ playerid ] [ b_worker ] - 1 ] [ b_info [ p_info [ playerid ] [ b_worker ] - 1 ] [ b_settings ] [ 2 ] - 1 ], b_info [ p_info [ playerid ] [ b_worker ] - 1 ] [ b_settings ] [ 2 ] ) ;
			SendClientMessage ( playerid, col_gray, scm_string ) ;
			return 1 ;
		}

		if ( p_info [ params [ 0 ] ] [ b_worker ] != p_info [ playerid ] [ b_worker ] )
			return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не является работником Вашего бизнеса." ) ;

        if ( p_info [ params [ 0 ] ] [ business_rang ] >= p_info [ playerid ] [ business_rang ] )
			return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете уволить своё руководство." ) ;

        business_id = p_info [ playerid ] [ b_worker ] ;
	}
	if ( Iter_Count(player_business[playerid]) > 0 )
	{
	    foreach(new b: player_business[playerid])
	    {
    		if ( p_info [ params [ 0 ] ] [ b_worker ] == b_info [ b - 1 ] [ b_id ] )
			{
				business_id = b ;
				break ;
			}
		}
	}

	if ( business_id < 1 || p_info [ playerid ] [ business_rang ] < 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не является работником Вашего бизнеса." ) ;

    new _t_string [ 144 ] ;
    format ( _t_string, sizeof ( _t_string ), "{"#cGInfo"}* {"#cWH"}Вы уволили {"#cGN"}%s {"#cWH"}с работы в '%s'.", p_info [ params [ 0 ] ] [ name ], b_info [ business_id - 1 ] [ b_name ] ) ;
    SendClientMessage ( playerid, col_white, _t_string ) ;

	format ( _t_string, sizeof ( _t_string ), "{%s}[%s] %s %s[%i] уволил(а) с работы %s[%d]! Причина: %s", b_info [ business_id - 1 ] [ b_chat_color ], b_info [ business_id - 1 ] [ b_name ], b_rank [ business_id - 1 ] [ p_info [ playerid ] [ business_rang ] - 1 ], p_info [ playerid ] [ name ], playerid, p_info [ params [ 0 ] ] [ name ], params [ 0 ], params [ 1 ] ) ;
 	business_message ( business_id, col_gray, _t_string ) ;

    p_info [ params [ 0 ] ] [ business_rang ] = 0 ;
	p_info [ params [ 0 ] ] [ b_worker ] = -1 ;
	Iter_Remove ( business_players[business_id], params [ 0 ] ) ;

	format ( _t_string, sizeof ( _t_string ), "UPDATE `users` SET `u_bworker` = '-1',`u_business_rang` = '0' WHERE `u_id` = '%d' LIMIT 1", p_info [ params [ 0 ] ] [ id ] ) ;
	mysql_tquery ( sql_connection, _t_string ) ;
    return 1;
}

CMD:hmenu ( playerid )
{
	if ( ! Iter_Count(player_houses[playerid]) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас нет дома." ) ;

	show_select_hmenu ( playerid ) ;
	return 1 ;
}

stock show_house_cellar ( playerid )
{
	if ( job_timer [ playerid ] != -1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}В данный момент недоступно. Подождите немного..." ) ;

	new _h_id = GetPVarInt ( playerid, "house_id" ) ;
	if ( _h_id < 1 ) return bad_exit ( playerid ) ;

	#if defined m_craft
		global_string [ 0 ] = EOS ;
		format ( global_string, 356, "{"#cBL"}1.{ffffff} Гидропонная ферма\n{"#cBL"}2.{ffffff} Снять розыск\n{"#cBL"}3.{ffffff} Сбор оружия\n{"#cBL"}4.{ffffff} Верстак для крафта [%s{"#cWH"}]", ( h_info [ _h_id - 1 ] [ h_upgrade_craft ] ) ? ( "{"#cGN"}Улучшен" ) : ( "{"#cRD"}Не улучшен" ) ) ;
		show_dialog ( playerid, d_cellar_menu, DIALOG_STYLE_LIST, "{"#cBHD"}Подвал", global_string, "Выбрать", "Закрыть" ) ;
	#else
		show_dialog ( playerid, d_cellar_menu, DIALOG_STYLE_LIST, "{"#cBHD"}Подвал", "{"#cBL"}1.{ffffff} Гидропонная ферма\n{"#cBL"}2.{ffffff} Снять розыск\n{"#cBL"}3.{ffffff} Сбор оружия", "Выбрать", "Закрыть" ) ;
	#endif

	if ( h_info [ _h_id - 1 ] [ h_seed_time ] < gettime ( ) ) create_house_seed ( _h_id ) ;
	return 1 ;
}

stock show_renters ( playerid )
{
    show_dialog ( playerid, d_h_rent_mn, DIALOG_STYLE_LIST, "{"#cBHD"}Подселение", "{"#cBL"}1.{ffffff} Подселить человека\n{"#cBL"}2.{ffffff} Список жильцов", "Выбрать", "Назад" ) ;
    return 1 ;
}

CMD:hradio ( playerid )
{
	if ( ! Iter_Count(player_houses[playerid]) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас нет дома." ) ;

	new bool:_in_house = false ;
	foreach(new h: player_houses[playerid])
	{
		if ( IsPlayerInRangeOfPoint ( playerid, 30, house_int [  h_info [ h - 1 ] [ h_int ] - 1 ] [ hint_position ] [ 0 ], house_int [  h_info [ h - 1 ] [ h_int ] - 1 ] [ hint_position ] [ 1 ], house_int [  h_info [ h - 1 ] [ h_int ] - 1 ] [ hint_position ] [ 2 ] ) && GetPlayerVirtualWorld ( playerid ) == h_info [ h - 1 ] [ h_id ] )
		{
        	p_info [ playerid ] [ house ] = h ;
        	_in_house = true ;
        	break ;
		}
	}
	if ( _in_house == false ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны находиться в своём жилье." ) ;

	if ( h_info [ p_info [ playerid ] [ house ] - 1 ] [ h_radio_status ] == 0 ) show_dialog ( playerid, d_h_radio, DIALOG_STYLE_LIST, "{"#cBHD"}Аудио система", "{"#cBL"}1.{"#cGN"} Включить аудио", "Выбрать", "Закрыть" ) ;
	else show_dialog ( playerid, d_h_radio, DIALOG_STYLE_LIST, "{"#cBHD"}Аудио система", "{"#cBL"}1.{"#cRD"} Выключить аудио", "Выбрать", "Закрыть" ) ;

	return 1 ;
}

CMD:hlock ( playerid )
{
	if ( ! Iter_Count(player_houses[playerid]) && ! p_info [ playerid ] [ rent_house ] )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас нет дома и Вы не арендуете жильё." ) ;

	new h ;
	if ( Iter_Count(player_houses[playerid]) > 0 )
	{
		new bool:_in_house = false ;
		foreach(new _h: player_houses[playerid])
		{
			if ( IsPlayerInRangeOfPoint ( playerid, 4, h_info [ _h - 1 ] [ h_pos ] [ 0 ], h_info [ _h - 1 ] [ h_pos ] [ 1 ], h_info [ _h - 1 ] [ h_pos ] [ 2 ] ) ||
				IsPlayerInRangeOfPoint ( playerid, 30, house_int [  h_info [ _h - 1 ] [ h_int ] - 1 ] [ hint_position ] [ 0 ], house_int [  h_info [ _h - 1 ] [ h_int ] - 1 ] [ hint_position ] [ 1 ], house_int [  h_info [ _h - 1 ] [ h_int ] - 1 ] [ hint_position ] [ 2 ] ) && GetPlayerVirtualWorld ( playerid ) == h_info [ _h - 1 ] [ h_id ] )
			{
	        	p_info [ playerid ] [ house ] = _h ;
	        	h = _h - 1 ;
	        	_in_house = true ;
	        	break ;
			}
		}
		if ( _in_house == false ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны находиться в своём жилье." ) ;
	}
	else h = p_info [ playerid ] [ rent_house ] - 1 ;

	if ( ! IsPlayerInRangeOfPoint ( playerid, 4, h_info [ h ] [ h_pos ] [ 0 ], h_info [ h ] [ h_pos ] [ 1 ], h_info [ h ] [ h_pos ] [ 2 ] ) &&
	( ! IsPlayerInRangeOfPoint ( playerid, 30, house_int [  h_info [ h ] [ h_int ] - 1 ] [ hint_position ] [ 0 ], house_int [  h_info [ h ] [ h_int ] - 1 ] [ hint_position ] [ 1 ], house_int [  h_info [ h ] [ h_int ] - 1 ] [ hint_position ] [ 2 ] ) && GetPlayerVirtualWorld ( playerid ) != h_info [ h ] [ h_id ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы слишком далеко от своего жилья." ) ;

	if ( h_info [ h ] [ h_closed ] == 0 )
	{
		h_info [ h ] [ h_closed ] = 1 ;
		GameTextForPlayer ( playerid,"~r~closed", 2000, 3 ) ;
	}
	else
	{
		h_info [ h ] [ h_closed ] = 0 ;
		GameTextForPlayer ( playerid, "~g~opened", 2000, 3 ) ;
	}

	new query_string [ 78 ];
	format ( query_string, sizeof ( query_string ), "UPDATE `houses` SET `h_closed` = '%d' WHERE `h_id` = '%d' LIMIT 1", h_info [ h ] [ h_closed ], h + 1 ) ;
	mysql_tquery ( sql_connection, query_string ) ;
	return 1 ;
}

stock show_select_hmenu ( playerid )
{
	if ( Iter_Count(player_houses[playerid]) == 1 )
	{
	    p_info [ playerid ] [ house ] = Iter_First(player_houses[playerid]) ;

	    new select_id = p_info [ playerid ] [ house ] ;
	    if ( ! IsPlayerInRangeOfPoint ( playerid, 30, house_int [  h_info [ select_id - 1 ] [ h_int ] - 1 ] [ hint_position ] [ 0 ], house_int [  h_info [ select_id - 1 ] [ h_int ] - 1 ] [ hint_position ] [ 1 ], house_int [  h_info [ select_id - 1 ] [ h_int ] - 1 ] [ hint_position ] [ 2 ] ) ||
					GetPlayerVirtualWorld ( playerid ) != h_info [ select_id - 1 ] [ h_id ] )
		{
		    SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны находиться в своём жилье." ) ;
		    SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте {"#cRInfo"}/home{"#cGRInfo"}, чтобы найти Ваш дом." ) ;
		    return 1 ;
		}

        show_hmenu ( playerid ) ;
	}
	else
	{
	    global_string [ 0 ] = EOS ;
	    new line_string [ 128 ], count_h = 0, header_string [ 44 + ( 4 * 2 ) ] ;
	    foreach(new h: player_houses[playerid])
	    {
	        set_player_listitem_values ( playerid, count_h, h ) ;

	        count_h ++ ;

			format ( line_string, sizeof line_string, "{"#cBL"}%d.{"#cWH"} %s - {"#cBL"}№%d {"#cGRDialog"}(%s{"#cGRDialog"})\n", count_h, house_classes [ house_int [ h_info [ h - 1 ] [ h_int ] - 1 ] [ hint_class ] ], h, ( h_info [ h - 1 ] [ h_closed ] ) ? ( "{"#cRD"}Закрыт" ) : ( "{"#cGN"}Открыт" ) ) ;
			strcat ( global_string, line_string ) ;
		}

		format ( header_string, sizeof header_string, "{"#cBHD"}Дома ({"#cWH"}%d из %d{"#cBHD"})", Iter_Count(player_houses[playerid]), p_info [ playerid ] [ max_house ] ) ;
	    show_dialog ( playerid, d_hmenu_select, DIALOG_STYLE_LIST, header_string, global_string, "Выбрать", "Закрыть" ) ;
	}
	return 1 ;
}

