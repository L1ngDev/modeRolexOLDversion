stock create_airball ( playerid, object_id )
{
    if ( GetPlayerState ( playerid ) != PLAYER_STATE_ONFOOT ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы находитесь в транспорте!" ) ;
   	if ( GetPlayerInterior ( playerid ) > 0 || GetPlayerVirtualWorld ( playerid ) > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Использовать в интерьере нельзя!" ) ;
	if ( p_t_info [ playerid ] [ pl_veh ] != INVALID_VEHICLE_ID )
	{
 		if ( GetVehicleModel ( p_t_info [ playerid ] [ pl_veh ] ) == 464 ) set_pos ( playerid, last_coord [ playerid ] [ 0 ], last_coord [ playerid ] [ 1 ], last_coord [ playerid ] [ 2 ], last_coord [ playerid ] [ 3 ], 0, 0 ) ;

		DestroyVehicle ( p_t_info [ playerid ] [ pl_veh ], 74 ) ;
		p_t_info [ playerid ] [ pl_veh ] = INVALID_VEHICLE_ID ;

		if ( IsValidDynamicObject ( p_t_info [ playerid ] [ pl_object ] ) )
		{
			DestroyDynamicObject ( p_t_info [ playerid ] [ pl_object ] ) ;
			p_t_info [ playerid ] [ pl_object ] = INVALID_OBJECT_ID ;
		}

		if ( IsValidDynamic3DTextLabel ( p_t_info [ playerid ] [ pl_label ] ) )
		{
			DestroyDynamic3DTextLabel ( p_t_info [ playerid ] [ pl_label ] ) ;
			p_t_info [ playerid ] [ pl_label ] = Text3D:INVALID_3DTEXT_ID ;
		}
	}

    if ( object_id == 1083 )
	{
	    GetPlayerPos ( playerid, last_coord [ playerid ] [ 0 ], last_coord [ playerid ] [ 1 ], last_coord [ playerid ] [ 2 ] ) ;
		GetPlayerFacingAngle ( playerid, last_coord [ playerid ] [ 3 ] ) ;

		p_t_info [ playerid ] [ pl_veh ] = CreateVehicle ( 481, last_coord [ playerid ] [ 0 ], last_coord [ playerid ] [ 1 ], last_coord [ playerid ] [ 2 ], last_coord [ playerid ] [ 3 ], -1, -1, -1 ) ;
		LinkVehicleToInterior ( p_t_info [ playerid ] [ pl_veh ], 0 ) ;

		new veh_id = p_t_info [ playerid ] [ pl_veh ] ;
		PutPlayerInVehicle ( playerid, veh_id, 0 ) ;
		veh_info [ veh_id - 1 ] [ v_fuel ] = 60.0 ;

		new engine, lights, alarm, doors, bonnet, boot, objective ;
	 	veh_info [ veh_id - 1 ] [ v_locked ] = true ;
		GetVehicleParamsEx ( veh_id, engine, lights, alarm, doors, bonnet, boot, objective ) ;
		SetVehicleParamsEx ( veh_id, VEHICLE_PARAMS_ON, false, alarm, true, bonnet, boot, objective ) ;
		if ( player_device { playerid } == 2 ) SendSpeedometr ( playerid, veh_id, false ) ;
	}
	else if ( object_id == 2511 )
	{
	    SendClientMessage ( playerid, col_white, !"{"#cBInfo"}* {"#cWH"}Для того, чтоб покинуть самолётик используйте {"#cBL"}'ALT'{"#cWH"}." ) ;

	    GetPlayerPos ( playerid, last_coord [ playerid ] [ 0 ], last_coord [ playerid ] [ 1 ], last_coord [ playerid ] [ 2 ] ) ;
		GetPlayerFacingAngle ( playerid, last_coord [ playerid ] [ 3 ] ) ;

		p_t_info [ playerid ] [ pl_veh ] = CreateVehicle ( 464, last_coord [ playerid ] [ 0 ], last_coord [ playerid ] [ 1 ], last_coord [ playerid ] [ 2 ], last_coord [ playerid ] [ 3 ], -1, -1, -1 ) ;
		LinkVehicleToInterior ( p_t_info [ playerid ] [ pl_veh ], 0 ) ;

		new veh_id = p_t_info [ playerid ] [ pl_veh ] ;
		PutPlayerInVehicle ( playerid, veh_id, 0 ) ;
		veh_info [ veh_id - 1 ] [ v_fuel ] = 60.0 ;

		new engine, lights, alarm, doors, bonnet, boot, objective ;
	 	veh_info [ veh_id - 1 ] [ v_locked ] = true ;
		GetVehicleParamsEx ( veh_id, engine, lights, alarm, doors, bonnet, boot, objective ) ;
		SetVehicleParamsEx ( veh_id, VEHICLE_PARAMS_ON, false, alarm, true, bonnet, boot, objective ) ;
		if ( player_device { playerid } == 2 ) SendSpeedometr ( playerid, veh_id, false ) ;
	}
	else if ( object_id >= 19332 && object_id <= 19338 || object_id >= 8224 && object_id <= 8230 || object_id == 8327 )
	{
	    for ( new j = 0 ; j < MAX_DM_ZONE ; j ++ )
		{
			if ( ! IsPlayerInQuad ( playerid, anti_dm_pos [ j ] [ 0 ], anti_dm_pos [ j ] [ 1 ], anti_dm_pos [ j ] [ 2 ], anti_dm_pos [ j ] [ 3 ] ) ) continue ;

			SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Запрещено создавать шар в зелёных зонах." ) ;
			return 1 ;
		}

		new Float:X, Float:Y, Float:Z, Float:A, mes [ 128 ] ;
		format ( mes, sizeof mes, "** Воздушный Шар **\n\n{"#cLY3D"}Управлене доступно только для владельца" ) ; //, -1, 7.77, 7.77, 7.77, 300.0, 0, 1 ); // Создаём текст
		GetPlayerPos ( playerid, X, Y, Z ) ;
		GetPlayerFacingAngle ( playerid, A ) ;
		p_t_info [ playerid ] [ pl_veh ] = CreateVehicle ( 487, X, Y, Z, A, -1, -1, -1 ) ;
		LinkVehicleToInterior ( p_t_info [ playerid ] [ pl_veh ], 100 ) ;

		new veh_id = p_t_info [ playerid ] [ pl_veh ] ;
		p_t_info [ playerid ] [ pl_object ] = CreateDynamicObject ( object_id, 0.000000, 0.000000, 0.000000, 0.000000, 0.000000, 0.000000, -1, -1, -1, 300.000000 ) ;
		p_t_info [ playerid ] [ pl_label ] = CreateDynamic3DTextLabel ( mes, col_header_3d, 0.0, 0.0, 2.0, 20.0, INVALID_PLAYER_ID, veh_id ) ;
		AttachDynamicObjectToVehicle ( p_t_info [ playerid ] [ pl_object ], veh_id, 0.000000, -0.000000, -1.000000, 0.000000, 0.000000, -0.000000 ) ;

		PutPlayerInVehicle ( playerid, veh_id, 0 ) ;
		veh_info [ veh_id - 1 ] [ v_fuel ] = 60.0 ;

		new engine, lights, alarm, doors, bonnet, boot, objective ;
	 	veh_info [ veh_id - 1 ] [ v_locked ] = false ;
		GetVehicleParamsEx ( veh_id, engine, lights, alarm, doors, bonnet, boot, objective ) ;
		SetVehicleParamsEx ( veh_id, VEHICLE_PARAMS_ON, false, alarm, false, bonnet, boot, objective ) ;
		if ( player_device { playerid } == 2 ) SendSpeedometr ( playerid, veh_id, false ) ;
	}
	return true ;
}

stock end_for_job ( playerid, _type_end_job = 0 )
{
    new _v_id = player_rentcar [ playerid ] ;
	if ( _v_id == INVALID_VEHICLE_ID ) return 1 ;
	player_rentcar [ playerid ] = INVALID_VEHICLE_ID ;

	new _j_id = p_info [ playerid ] [ job ] ;
	if ( _j_id == job_bus )
	{
		DisablePlayerRaceCheckpoint ( playerid ) ;

		p_t_info [ playerid ] [ pBusRoute ] =
		p_t_info [ playerid ] [ pBusPos ] =
		p_t_info [ playerid ] [ pBusPrice ] = 0 ;

		if ( IsValidDynamic3DTextLabel ( p_t_info [ playerid ] [ pBusText ] ) ) DestroyDynamic3DTextLabel ( p_t_info [ playerid ] [ pBusText ] ) ;
		p_t_info [ playerid ] [ pBusText ] = Text3D:INVALID_3DTEXT_ID ;

		if ( IsValidVehicle ( _v_id ) && _type_end_job == 0 && _v_id != INVALID_VEHICLE_ID && veh_info [ _v_id - 1 ] [ v_type ] == vehicle_type_server )
		{
		    if ( veh_info [ _v_id - 1 ] [ v_renter ] != playerid ) return 1 ;

			veh_info [ _v_id - 1 ] [ v_locked ] = false ;
			SetVehicleToRespawn ( _v_id, 21 ) ;

			if ( veh_info [ _v_id - 1 ] [ v_renter ] != INVALID_PLAYER_ID ) veh_info [ _v_id - 1 ] [ v_renter ] = INVALID_PLAYER_ID ;
			return 1 ;
		}
	}
	else if ( _j_id == job_taxi )
	{
    	new passId = taxiPassenger [ playerid ] [ 0 ], typePass = taxiPassenger [ playerid ] [ 1 ] ;
		if ( passId != INVALID_PLAYER_ID && typePass == 0 ) deleteTaxiOrder ( passId, p_info [ playerid ] [ taxi_skill ] ) ;

		if ( IsValidVehicle ( _v_id ) && _type_end_job == 0 && _v_id != INVALID_VEHICLE_ID && veh_info [ _v_id - 1 ] [ v_type ] == vehicle_type_server )
		{
		    if ( veh_info [ _v_id - 1 ] [ v_renter ] != playerid ) return 1 ;

			veh_info [ _v_id - 1 ] [ v_locked ] = false ;
			SetVehicleToRespawn ( _v_id, 21 ) ;

			if ( veh_info [ _v_id - 1 ] [ v_renter ] != INVALID_PLAYER_ID ) veh_info [ _v_id - 1 ] [ v_renter ] = INVALID_PLAYER_ID ;
			return 1 ;
		}
	}
	else if ( _j_id == job_mechanic )
	{
		DeletePVar ( playerid, "MehName" ) ;
		DeletePVar ( playerid, "toplivo" ) ;

		if ( IsValidVehicle ( _v_id ) && _type_end_job == 0 && _v_id != INVALID_VEHICLE_ID && veh_info [ _v_id - 1 ] [ v_type ] == vehicle_type_server )
		{
		    if ( veh_info [ _v_id - 1 ] [ v_renter ] != playerid ) return 1 ;

			veh_info [ _v_id - 1 ] [ v_locked ] = false ;
			SetVehicleToRespawn ( _v_id, 21 ) ;

			if ( veh_info [ _v_id - 1 ] [ v_renter ] != INVALID_PLAYER_ID ) veh_info [ _v_id - 1 ] [ v_renter ] = INVALID_PLAYER_ID ;
			return 1 ;
		}
	}
	else if ( _j_id == job_trucker )
	{
	    player_rentcar [ playerid ] = _v_id ;
	    clear_trucker ( playerid ) ;
	}
	else if ( _j_id == job_fuel_delivery )
	{
	    if ( player_trailer [ playerid ] != INVALID_VEHICLE_ID )
		{
			DestroyVehicle ( player_trailer [ playerid ], 75 ) ;
			player_trailer [ playerid ] = INVALID_VEHICLE_ID ;
		}

		if ( IsValidVehicle ( _v_id ) && _type_end_job == 0 && _v_id != INVALID_VEHICLE_ID && veh_info [ _v_id - 1 ] [ v_type ] == vehicle_type_server )
		{
		    if ( veh_info [ _v_id - 1 ] [ v_renter ] != playerid ) return 1 ;

			veh_info [ _v_id - 1 ] [ v_locked ] = false ;
			SetVehicleToRespawn ( _v_id, 21 ) ;

			if ( veh_info [ _v_id - 1 ] [ v_renter ] != INVALID_PLAYER_ID ) veh_info [ _v_id - 1 ] [ v_renter ] = INVALID_PLAYER_ID ;
			return 1 ;
		}
	}

	if ( IsValidVehicle ( _v_id ) && _type_end_job == 0 && _v_id != INVALID_VEHICLE_ID )
	{
		switch ( veh_info [ _v_id - 1 ] [ v_type ] )
		{
	 		case vehicle_type_server:
		    {
			    if ( veh_info [ _v_id - 1 ] [ v_renter ] != playerid ) return 1 ;

				veh_info [ _v_id - 1 ] [ v_locked ] = false ;
				SetVehicleToRespawn ( _v_id, 21 ) ;

				if ( veh_info [ _v_id - 1 ] [ v_renter ] != INVALID_PLAYER_ID ) veh_info [ _v_id - 1 ] [ v_renter ] = INVALID_PLAYER_ID ;
				return 1 ;
			}
		    case vehicle_type_job:
		    {
			    if ( veh_info [ _v_id - 1 ] [ v_renter ] != playerid ) return 1 ;

				veh_info [ _v_id - 1 ] [ v_locked ] = false ;
				SetVehicleToRespawn ( _v_id, 21 ) ;

				if ( veh_info [ _v_id - 1 ] [ v_renter ] != INVALID_PLAYER_ID ) veh_info [ _v_id - 1 ] [ v_renter ] = INVALID_PLAYER_ID ;
				return 1 ;
			}
			case vehicle_type_family:
		    {
			    if ( veh_info [ _v_id - 1 ] [ v_renter ] != playerid ) return 1 ;

				veh_info [ _v_id - 1 ] [ v_locked ] = false ;
				SetVehicleToRespawn ( _v_id, 21 ) ;

				if ( veh_info [ _v_id - 1 ] [ v_renter ] != INVALID_PLAYER_ID ) veh_info [ _v_id - 1 ] [ v_renter ] = INVALID_PLAYER_ID ;
				return 1 ;
			}
			case vehicle_type_rentcar:
			{
				if ( veh_info [ _v_id - 1 ] [ v_renter ] != playerid ) return 1 ;

				veh_info [ _v_id - 1 ] [ v_locked ] = false ;
				SetVehicleToRespawn ( _v_id, 21 ) ;

				if ( veh_info [ _v_id - 1 ] [ v_renter ] != INVALID_PLAYER_ID ) veh_info [ _v_id - 1 ] [ v_renter ] = INVALID_PLAYER_ID ;
				return 1 ;
			}
			case vehicle_type_rentcar_faggio:
   			{
		    	if ( veh_info [ _v_id - 1 ] [ v_renter ] != playerid ) return 1 ;

				veh_info [ _v_id - 1 ] [ v_locked ] = false ;
				SetVehicleToRespawn ( _v_id, 21 ) ;

				if ( veh_info [ _v_id - 1 ] [ v_renter ] != INVALID_PLAYER_ID ) veh_info [ _v_id - 1 ] [ v_renter ] = INVALID_PLAYER_ID ;
				return 1 ;
			}
		}
	}
	return 0 ;
}

callback: callback_offadmins ( playerid )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows )
	{
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игроки с данными параметрами не найдены." ) ;
		page_count [ playerid ] = 0 ;
		return 1 ;
	}

	new rows_list = page_count [ playerid ] - 1 ;
	page_rows [ playerid ] = rows ;

	global_string [ 0 ] = EOS ;
	new line_string [ MAX_PLAYER_NAME + 128 ], pl_ofm_name [ 24 ], pl_ofm_online [ 24 ], a_level, a_last_level, row_count, admins_buy ;
	strcat ( global_string, "{"#cBL"}Имя:\t{"#cBL"}Уровень:\t{"#cBL"}Дата входа:\t{"#cBL"}Статус:\n" ) ;
	for ( new i = rows_list * 10 ; i <  rows_list * 10 + 10 ; i ++ )
	{
		if ( i >= rows ) break ;

		cache_get_field_content ( i, "u_a_name", pl_ofm_name, sql_connection, 24 ) ;
		cache_get_field_content ( i, "u_a_date", pl_ofm_online, sql_connection, 24 ) ;
		a_level = cache_get_field_content_int ( i, "u_a_level", sql_connection ) ;
		a_last_level = cache_get_field_content_int ( i, "u_a_last_level", sql_connection ) ;

		new pvar_string [ 8 ] ;
		format ( pvar_string, sizeof ( pvar_string ), "ofm_%d", i - rows_list * 10 ) ;
		SetPVarString ( playerid, pvar_string, pl_ofm_name ) ;

		new _pl_id ;
		sscanf ( pl_ofm_name, "u", _pl_id ) ;

		if ( ! a_last_level ) format ( line_string, sizeof ( line_string ), "%s\t%d ур.\t%s\tПокупной\n", pl_ofm_name, a_level, pl_ofm_online ) ;
		else format ( line_string, sizeof ( line_string ), "%s\t%d ур.\t%s\t-\n", pl_ofm_name, a_level, pl_ofm_online ) ;
		strcat ( global_string, line_string ) ;

		row_count ++ ;
	}

	for ( new i = 0 ; i < rows ; i ++ )
	{
		a_last_level = cache_get_field_content_int ( i, "u_a_last_level", sql_connection ) ;
		if ( ! a_last_level ) admins_buy ++ ;
	}

    if ( rows_list > 0 )
	{
		strcat ( global_string, "{"#cBL"}Предыдущая страница\n" ) ;
		set_player_use_page ( playerid, row_count, 0 ) ;
		row_count ++ ;
	}
	if ( ofm_formula ( page_count [ playerid ] ) < rows )
	{
		strcat ( global_string, "{"#cBL"}Следующая страница\n" ) ;
		set_player_use_page ( playerid, row_count, 1 ) ;
	}

	line_string [ 0 ] = EOS ;
	if ( admins_buy ) format ( line_string, sizeof line_string, "{"#cBHD"}Администрация (Всего: {"#cWH"}%d {"#cBHD"}чел., покуп.: {"#cWH"}%d {"#cBHD"}чел.)", rows, admins_buy ) ;
	else format ( line_string, sizeof line_string, "{"#cBHD"}Администрация (Всего: {"#cWH"}%d {"#cBHD"}чел.)", rows ) ;
	show_dialog ( playerid, d_offmembers_list2, DIALOG_STYLE_TABLIST_HEADERS, line_string, global_string, "Выбрать", "Назад" ) ;
	return 1 ;
}

callback: callback_offadmins_info ( playerid )
{
	new rows, fields;
	cache_get_data ( rows, fields ) ;
	if ( rows )
	{
		new pl_ofm_online [ 24 ], pl_ofm_issued [ 24 ], a_level, a_online, a_jails, a_warns, a_bans, a_kicks, a_mute, a_reputation ;

		cache_get_field_content ( 0, "u_a_date", pl_ofm_online, sql_connection, 24 ) ;
		cache_get_field_content ( 0, "u_a_issued", pl_ofm_issued, sql_connection, 24 ) ;
		a_level = cache_get_field_content_int ( 0, "u_a_level", sql_connection ) ;
		a_online = cache_get_field_content_int ( 0, "u_a_online", sql_connection ) ;
		a_jails = cache_get_field_content_int ( 0, "u_a_jails", sql_connection ) ;
		a_warns = cache_get_field_content_int ( 0, "u_a_warns", sql_connection ) ;
		a_bans = cache_get_field_content_int ( 0, "u_a_bans", sql_connection ) ;
		a_kicks = cache_get_field_content_int ( 0, "u_a_kicks", sql_connection ) ;
		a_mute = cache_get_field_content_int ( 0, "u_a_mute", sql_connection ) ;
		a_reputation = cache_get_field_content_int ( 0, "u_a_reputation", sql_connection ) ;

		new pvar_string [ 38 ], pl_name [ MAX_PLAYER_NAME ] ;
		format ( pvar_string, sizeof ( pvar_string ), "ofm_%d", GetPVarInt ( playerid, "ofm_listitem" ) ) ;
		GetPVarString ( playerid, pvar_string, pl_name, MAX_PLAYER_NAME ) ;

		new dialog_string [ 512 ] ;
		format ( dialog_string, sizeof ( dialog_string ), "{"#cBL"}** Общая информация **\n\n{"#cWH"}Имя: {"#cBL"}%s{"#cWH"}\nУровень: {"#cBL"}%d{"#cWH"}\nНа посту с {"#cBL"}%s{"#cWH"}\nПоследний вход: {"#cBL"}%s{"#cWH"}\nОтыграно на посту: {"#cBL"}%d{"#cWH"} минут(ы)\nРепутация: {"#cBL"}%d{"#cWH"}\n\n{"#cBL"}** Выданые наказания **\n\n{"#cWH"}Посажено в тюрьму: {"#cBL"}%d{"#cWH"}\nВыдано варнов: {"#cBL"}%d{"#cWH"}\nВыдано банов: {"#cBL"}%d{"#cWH"}\nКикнуто игроков: {"#cBL"}%d{"#cWH"}\nВыдано мутов: {"#cBL"}%d{"#cWH"}",
		pl_name, a_level, pl_ofm_issued, pl_ofm_online, floatround ( a_online / 60 ), a_reputation, a_jails, a_warns, a_bans, a_kicks, a_mute ) ;
		show_dialog ( playerid, d_offmembers_pl_menu_info2, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Информация об администраторе", dialog_string, "Назад", "" ) ;
	}
	if ( ! rows )
	{
		DeletePVar( playerid, "ofm_listitem" ) ;
		if( ! GetPVarInt ( playerid, "ofm_type" ) )
		{
			mysql_tquery ( sql_connection, !"SELECT `u_a_name`,`u_a_date`,`u_a_level` FROM `users_admins`", "callback_offamily", "i", playerid ) ;
			return 1 ;
		}
	}
	return 1 ;
}

callback: leadersOffline ( playerid, page, init )
{
    if ( init )
    {
		static const _str [ ] = "\
			SELECT \
				u.u_name, \
				IFNULL(fp.u_leader, 0) AS u_leader, \
				fp.u_leader_status, \
				u.u_played_time \
			FROM fractions_players fp \
			LEFT JOIN users u ON u.u_id=fp.u_sql_id \
			WHERE fp.u_leader > 0" ;
		new query_string [ sizeof _str + ( 9 * 2 ) ] ;
        format ( query_string, sizeof query_string, _str, page * 10 ) ;
        mysql_tquery ( sql_connection, query_string, "leadersOffline", "iii", playerid, page, 0 ) ;
    }
    else
    {
		page_count [ playerid ] = page ;

        new rows, fields ;
		cache_get_data ( rows, fields ) ;

		if ( ! rows )
		{
			send_check_cinfo ( playerid, "Ничего не найдено!", 0, 3, CINFO_FAMILY_ID, PICTURE_INFO_ERROR, "", "" ) ;
			return 1 ;
		}

        new pl_ofm_name [ MAX_PLAYER_NAME ], pl_ofm_online [ MAX_PLAYER_NAME ],
			pl_ofm_rank, pl_ofm_time, pl_ofm_status, text_rank [ 12 ], counter = 0 ;

		global_string [ 0 ] = EOS ;
		strcat ( global_string, "{"#cBL"}Имя:\t{"#cBL"}Организация:\t{"#cBL"}Статус:\t{"#cBL"}Статус лидера:\n" ) ;
		for ( new i = 0 ; i < rows ; i ++ )
		{
			if ( page * 10 > i ) continue ;
  			if ( i > ( page + 1 ) * 10 ) continue ;

			cache_get_field_content ( i, "u_name", pl_ofm_name ) ;
			pl_ofm_rank = cache_get_field_content_int ( i, "u_leader" ) ;
			pl_ofm_time = cache_get_field_content_int ( i, "u_played_time" ) ;

			if ( pl_ofm_status == 1 ) text_rank = "Главный" ;
			else text_rank = "Помощник" ;

			new pvar_string [ 8 ] ;
			format ( pvar_string, sizeof ( pvar_string ), "ofm_%d", counter ) ;
			SetPVarString ( playerid, pvar_string, pl_ofm_name ) ;

			counter ++ ;

			new _pl_id ;
			sscanf ( pl_ofm_name, "u", _pl_id ) ;

			if ( IsPlayerConnected ( _pl_id ) ) format ( pl_ofm_online, sizeof pl_ofm_online, "Сейчас играет ({"#cGN"}ONLINE{ffffff})" ) ;
			else
			{
				new float_time = gettime( ) - pl_ofm_time ;
				format ( pl_ofm_online, sizeof pl_ofm_online, "%s ({"#cRD"}OFFLINE{ffffff})", check_float_time ( float_time ) ) ;
			}

			format ( global_string, sizeof ( global_string ), "%s%s\t{%s}%s\t{"#cWH"}%s\t%s\n", global_string, pl_ofm_name, f_info [ pl_ofm_rank - 1 ] [ f_chat_color ], f_info [ pl_ofm_rank - 1 ] [ f_letter_name ], pl_ofm_online, text_rank ) ;
		}

		if ( page > 0 ) strcat ( global_string, "{"#cBL"}Предыдущая страница\n" ) ;
		if ( rows > ( page + 1 ) * 10 ) strcat ( global_string, "{"#cBL"}Следующая страница" ) ;

		static const _str [ ] = "{"#cBHD"}Лидеры оффлайн (Всего: {"#cWH"}%d {"#cBHD"}чел.)" ;
		new header_string [ sizeof _str + 9 ] ;
		format ( header_string, sizeof header_string, _str, rows ) ;
		show_dialog ( playerid, d_offmembers_list3, DIALOG_STYLE_TABLIST_HEADERS, header_string, global_string, "Выбрать", "Назад" ) ;
	}
    return true ;
}

callback: callback_offleaders_info ( playerid )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( rows )
	{
		new last_date [ 16 ], _fraction_date [ 24 ], fam_c_rank ;

		fam_c_rank = cache_get_field_content_int ( 0, "u_leader", sql_connection ) ;
		cache_get_field_content ( 0, "u_last_date", last_date, sql_connection, 24 ) ;
		cache_get_field_content ( 0, "u_fraction_date", _fraction_date, sql_connection, 24 ) ;

		new pvar_string [ 38 ], pl_name [ MAX_PLAYER_NAME ] ;
		format ( pvar_string, sizeof ( pvar_string ), "ofm_%d", GetPVarInt ( playerid, "ofm_listitem" ) ) ;
		GetPVarString ( playerid, pvar_string, pl_name, MAX_PLAYER_NAME ) ;

		new dialog_string [ 256 ] ;
		format ( dialog_string, sizeof ( dialog_string ), "{"#cWH"}Имя: {"#cBL"}%s{"#cWH"}\nЛидер: {"#cBL"}%s{"#cWH"}\nНа посту с {"#cBL"}%s{"#cWH"}\nПоследний вход: {"#cBL"}%s{"#cWH"}", pl_name, f_info [ fam_c_rank - 1 ] [ f_name ], _fraction_date, last_date ) ;
		show_dialog ( playerid, d_offmembers_pl_menu_info3, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Информация об игроке", dialog_string, "Назад", "" ) ;
	}
	if ( ! rows ) leadersOffline ( playerid, page_count [ playerid ], 1 ) ;
	return 1 ;
}

callback: callback_banlist ( playerid )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows )
	{
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игроки с данными параметрами не найдены." ) ;
		page_count [ playerid ] = 0 ;
		return 1 ;
	}

	new rows_list = page_count [ playerid ] - 1 ;
	page_rows [ playerid ] = rows ;

	global_string [ 0 ] = EOS ;
	new line_string [ 128 ], pl_ofm_name [ MAX_PLAYER_NAME ], pl_ofm_online [ 48 ], pl_ofm_reason [ 64 ], row_count ;
	for ( new i = rows_list * 10 ; i < rows_list * 10 + 10 ; i ++ )
	{
		if ( i >= rows ) break ;

		cache_get_field_content ( i, "u_b_name", pl_ofm_name, sql_connection, MAX_PLAYER_NAME ) ;
		cache_get_field_content ( i, "u_b_date", pl_ofm_online, sql_connection, 48 ) ;
		cache_get_field_content ( i, "u_b_reason", pl_ofm_reason, sql_connection, 64 ) ;

		new pvar_string [ 8 ] ;
		format ( pvar_string, sizeof ( pvar_string ), "ofm_%d", i - rows_list * 10 ) ;
		SetPVarString ( playerid, pvar_string, pl_ofm_name ) ;

		format ( line_string, sizeof ( line_string ), "{"#cWH"}%s - %s {"#cGRDialog"}* %s\n", pl_ofm_name, pl_ofm_online, pl_ofm_reason ) ;
		strcat ( global_string, line_string ) ;

		row_count ++ ;
	}

    if ( rows_list > 0 )
	{
		strcat ( global_string, "{"#cBL"}Предыдущая страница\n" ) ;
		set_player_use_page ( playerid, row_count, 0 ) ;
		row_count ++ ;
	}
	if ( ofm_formula ( page_count [ playerid ] ) < rows )
	{
		strcat ( global_string, "{"#cBL"}Следующая страница\n" ) ;
		set_player_use_page ( playerid, row_count, 1 ) ;
	}

	show_dialog ( playerid, d_offmembers_list12, DIALOG_STYLE_LIST, "{"#cBHD"}BANLIST", global_string, "Выбрать", "Назад" ) ;
	return 1 ;
}

callback: callback_banlist_info ( playerid )
{
	new rows, fields;
	cache_get_data ( rows, fields ) ;
	if ( rows )
	{
		new pl_ofm_admin [ MAX_PLAYER_NAME ], pl_ofm_name [ MAX_PLAYER_NAME ], pl_ofm_ban [ 48 ], pl_ofm_unban [ 48 ], pl_ofm_reason [ 64 ] ;

		cache_get_field_content ( 0, "u_b_name", pl_ofm_name, sql_connection, MAX_PLAYER_NAME ) ;
		cache_get_field_content ( 0, "u_b_admin", pl_ofm_admin, sql_connection, MAX_PLAYER_NAME ) ;
		cache_get_field_content ( 0, "u_b_date", pl_ofm_ban, sql_connection, 48 ) ;
		cache_get_field_content ( 0, "u_b_ndate", pl_ofm_unban, sql_connection, 48 ) ;
		cache_get_field_content ( 0, "u_b_reason", pl_ofm_reason, sql_connection, 64 ) ;

		new pvar_string [ 38 ], pl_name [ MAX_PLAYER_NAME ] ;
		format ( pvar_string, sizeof ( pvar_string ), "ofm_%d", GetPVarInt ( playerid, "ofm_listitem" ) ) ;
		GetPVarString ( playerid, pvar_string, pl_name, MAX_PLAYER_NAME ) ;

		global_string [ 0 ] = EOS ;
		format ( global_string, 256, "{"#cWH"}Имя: {"#cBL"}%s{"#cWH"}\nЗабанил: {"#cBL"}%s{"#cWH"}\nДата бана: {"#cBL"}%s{"#cWH"}\nДата разбана: {"#cBL"}%s{"#cWH"}\nПричина: {"#cBL"}%s{"#cWH"}",
		pl_ofm_name, pl_ofm_admin, pl_ofm_unban, pl_ofm_ban, pl_ofm_reason ) ;
		show_dialog ( playerid, d_offmembers_pl_menu_info12, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Информация об игроке", global_string, "Назад", "" ) ;
	}
	if ( ! rows )
	{
		DeletePVar( playerid, "ofm_listitem" ) ;
		if( ! GetPVarInt ( playerid, "ofm_type" ) )
		{
			mysql_tquery ( sql_connection, !"SELECT * FROM `users_bans` WHERE `u_b_date` > NOW() ORDER BY `users_bans`.`u_b_ndate` DESC", "callback_banlist", "i", playerid ) ;
			return 1 ;
		}
	}
	return 1 ;
}

stock Bl_Init ( playerid )
{
	for ( new i = 0 ; i < max_fraction ; i ++ )
	{
		bl_info [ playerid ] [ bl_onFrac ] [ i ] =
		bl_info [ playerid ] [ bl_kills ] [ i ] = 0 ;
	}
	bl_info [ playerid ] [ bl_isKilled ] = false ;

	#if defined m_familys
	    familys_Bl_Init ( playerid ) ;
	#endif
	return 1 ;
}

stock Bl_Update ( playerid, fracid )
{
	static const _str [ ] = "UPDATE `fractions_blacklist` SET `bl_death` = '%d' WHERE `bl_player` = '%d' AND `bl_fraction` = '%d' LIMIT 1" ;
	new query [ sizeof _str + 4 + 9 + 4 ] ;
	format ( query, sizeof query, _str, bl_info [ playerid ] [ bl_kills ] [ fracid ], p_info [ playerid ] [ id ], fracid ) ;
	mysql_tquery ( sql_connection, query, "", "" ) ;
	return 1 ;
}

stock Bl_Clear ( )
{
	mysql_tquery ( sql_connection, "DELETE FROM `fractions_blacklist` WHERE `bl_last_date` < NOW() - INTERVAL 14 DAY" ) ;
	mysql_tquery ( sql_connection, "DELETE FROM `familys_blacklist` WHERE `bl_last_date` < NOW() - INTERVAL 14 DAY" ) ;
	return 1 ;
}

callback: callback_bl_check ( playerid )
{
	new rows = cache_get_row_count ( ) ;
	if ( rows )
	{
		new temp[ 128 ], query [ 128 ], src [ 256 ] ;
		format(temp, sizeof temp, "* Вы находитесь в черном списке ");

		for ( new i, fracid, kills ; i < rows ; i ++ )
		{
			fracid = cache_get_field_content_int ( i, "bl_fraction", sql_connection ) ;
			kills = cache_get_field_content_int ( i, "bl_death", sql_connection ) ;

			bl_info [ playerid ] [ bl_onFrac ] [ fracid ] = 1 ;
			bl_info [ playerid ] [ bl_kills ] [ fracid ] = kills ;
			format(query, sizeof query, "[F] Запахло дичью, был(а) замечен(а) %s.", p_info [ playerid ] [ name ] ) ;
			fraction_message ( fracid, col_lblue, query ) ;
			format ( temp, sizeof temp, "%s, ", f_info [ fracid - 1 ] [ f_name ] ) ;
			strcat ( src, temp ) ;
		}

		temp[strlen(temp)-2] = '\0';
		SendClientMessage ( playerid, col_lblue, temp ) ;

		format ( query, sizeof query, "UPDATE `fractions_blacklist` SET `bl_last_date` = NOW() WHERE `bl_player` = '%d' LIMIT %d", p_info [ playerid ] [ id ], rows ) ;
		mysql_tquery ( sql_connection, query, "", "" ) ;
	}
	return 1 ;
}

callback: membersBlackList ( playerid, page, init )
{
    if ( init )
    {
		DeletePVar ( playerid, "ofm_listitem" ) ;

		static const _str [ ] = "SELECT bl_name, bl_date FROM fractions_blacklist WHERE bl_fraction = %d LIMIT 10 OFFSET %d" ;
		new query_string [ sizeof _str + ( 9 * 2 ) ] ;
        format ( query_string, sizeof query_string, _str, p_info [ playerid ] [ member ], page * 10 ) ;
        mysql_tquery ( sql_connection, query_string, "membersBlackList", "iii", playerid, page, 0 ) ;
    }
    else
    {
		page_count [ playerid ] = page ;

        new rows, fields ;
		cache_get_data ( rows, fields ) ;

		if ( ! rows )
		{
			send_check_cinfo ( playerid, "Ничего не найдено!", 0, 3, CINFO_OTHER_ID, PICTURE_INFO_ERROR, "", "" ) ;
			return 1 ;
		}

        new pl_ofm_name [ MAX_PLAYER_NAME ], pl_ofm_online [ MAX_PLAYER_NAME ] ;

		global_string [ 0 ] = EOS ;
		strcat ( global_string, "{"#cBL"}Игрок:\t{"#cBL"}Дата занесения:\t{"#cBL"}Статус:\n" ) ;
		for ( new i = 0 ; i < rows ; i ++ )
		{
			cache_get_field_content ( i, "bl_name", pl_ofm_name ) ;
			cache_get_field_content ( i, "bl_date", pl_ofm_online ) ;

			new pvar_string [ 8 ] ;
			format ( pvar_string, sizeof ( pvar_string ), "ofm_%d", i ) ;
			SetPVarString ( playerid, pvar_string, pl_ofm_name ) ;

			new _pl_id ;
			sscanf ( pl_ofm_name, "u", _pl_id ) ;

			format ( global_string, sizeof global_string, "%s%s\t{"#cOR"}%s{"#cWH"}\t%s\n", global_string, pl_ofm_name, pl_ofm_online, ( IsPlayerConnected ( _pl_id ) ) ? ( "{"#cGN"}ONLINE{ffffff}" ) : ( "{"#cRD"}OFFLINE{ffffff}" ) ) ;
		}

		if ( page > 0 ) strcat ( global_string, "{"#cBL"}Предыдущая страница\n" ) ;
		if ( rows == 10 ) strcat ( global_string, "{"#cBL"}Следующая страница" ) ;

		show_dialog ( playerid, d_offmembers_list5, DIALOG_STYLE_LIST, "{"#cBHD"}Чёрный список", global_string, "Выбрать", "Назад" ) ;
	}
    return true ;
}

callback: callback_bl_fraction_info ( playerid )
{
	new rows, fields;
	cache_get_data ( rows, fields ) ;
	if ( rows )
	{
		new pl_date [ 24 ], pl_reason [ 24 ], pl_add_name [ 32 ] ;

		cache_get_field_content ( 0, "bl_date", pl_date, sql_connection, 24 ) ;
		cache_get_field_content ( 0, "bl_reason", pl_reason, sql_connection, 24 ) ;
		cache_get_field_content ( 0, "bl_add_name", pl_add_name, sql_connection, 32 ) ;

		new pvar_string [ 38 ], pl_name [ MAX_PLAYER_NAME ] ;
		format ( pvar_string, sizeof ( pvar_string ), "ofm_%d", GetPVarInt ( playerid, "ofm_listitem" ) ) ;
		GetPVarString ( playerid, pvar_string, pl_name, MAX_PLAYER_NAME ) ;

		new dialog_string [ 256 ] ;
		format ( dialog_string, sizeof ( dialog_string ), "{"#cWH"}Имя: {"#cBL"}%s{"#cWH"}\nПричина: {"#cBL"}%s{"#cWH"}\nДата занесения: {"#cBL"}%s{"#cWH"}\nЗанес: {"#cBL"}%s{"#cWH"}",
		pl_name, pl_reason, pl_date, pl_add_name ) ;
		show_dialog ( playerid, d_offmembers_pl_menu_info5, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Информация о игроке", dialog_string, "Назад", "" ) ;
	}
	if ( ! rows ) membersBlackList ( playerid, page_count [ playerid ], 1 ) ;
	return 1 ;
}

CMD:u ( playerid, params [ ] )
{
    if ( p_info [ playerid ] [ mute ] )
	{
		new scm_string [ 38 ] ;
		format ( scm_string, sizeof ( scm_string ),"{"#cRInfo"}* {"#cGRInfo"}У вас бан чата | %d секунд(ы)", p_info [ playerid ] [ mute ] ) ;
		SendClientMessage ( playerid, col_light_red, scm_string ) ;
		return true ;
	}

	if ( p_info [ playerid ] [ f_mute ] )
	{
		new scm_string [ 68 ] ;
		format ( scm_string, sizeof ( scm_string ),"{"#cRInfo"}* {"#cGRInfo"}У вас затычка в чате организации | %d секунд(ы)", p_info [ playerid ] [ f_mute ] ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
		return true ;
	}

	if ( globalchat_cooldown [ playerid ] > gettime ( ) )
	{
		new scm_string [ 81 + 9 ] ;
		format ( scm_string, sizeof ( scm_string ), "Вы уже писали в чат альянса. Повторно написать можно будет через %d секунд(ы).", globalchat_cooldown [ playerid ] - gettime ( ) ) ;
		SendClientMessage ( playerid,  col_light_red, scm_string ) ;
		return true ;
	}

	globalchat_cooldown [ playerid ] = gettime ( ) + 60 ;

	if ( gang_player ( playerid ) || mafia_player ( playerid ) )
	{
		if ( sscanf ( params, "s[100]", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /u [текст]");
		if ( check_advertise ( playerid, params [ 0 ], report_type_u ) ) return 1 ;

		new scm_string [ 144 ], fraction_id = p_info [ playerid ] [ member ] ;
		format(scm_string, sizeof scm_string, "[U] (%s) %s %s[%d]: %s", f_info [ fraction_id - 1 ] [ f_name ], f_rank [ fraction_id - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], playerid, params[ 0 ] ) ;
		foreach(new i: logged_players)
		{
		    if ( ! gang_player ( i ) && ! mafia_player ( i ) ) continue ;
			if ( ( f_diplomacy [ fraction_id - 18 ] [ p_info [ i ] [ member ] - 18 ] == dip_status_alliance || p_info [ i ] [ member ] == fraction_id || is_control_chat { i } == fraction_id ) && p_info [ i ] [ settings ] [ 0 ] != 0 )
			{
				SendClientMessage ( i, 0xb5e8f0FF, scm_string ) ;
			}
		}

		SetPlayerChatBubble(playerid, "Cказал(а) что-то в чат альянса", col_light_purple, 10.0, 3000);
	}
	return 1 ;
}

CMD:un ( playerid, params [ ] )
{
    if ( p_info [ playerid ] [ mute ] )
	{
		new scm_string [ 38 ] ;
		format ( scm_string, sizeof ( scm_string ),"{"#cRInfo"}* {"#cGRInfo"}У вас бан чата | %d секунд(ы)", p_info [ playerid ] [ mute ] ) ;
		SendClientMessage ( playerid, col_light_red, scm_string ) ;
		return true ;
	}

	if ( p_info [ playerid ] [ f_mute ] )
	{
		new scm_string [ 68 ] ;
		format ( scm_string, sizeof ( scm_string ),"{"#cRInfo"}* {"#cGRInfo"}У вас затычка в чате организации | %d секунд(ы)", p_info [ playerid ] [ f_mute ] ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
		return false ;
	}

	if ( globalchat_cooldown [ playerid ] > gettime ( ) )
	{
		new scm_string [ 81 + 9 ] ;
		format ( scm_string, sizeof ( scm_string ), "Вы уже писали в чат альянса. Повторно написать можно будет через %d секунд(ы).", globalchat_cooldown [ playerid ] - gettime ( ) ) ;
		SendClientMessage ( playerid,  col_light_red, scm_string ) ;
		return true ;
	}

	globalchat_cooldown [ playerid ] = gettime ( ) + 60 ;

	if ( gang_player ( playerid ) || mafia_player ( playerid ) )
	{
		if ( sscanf ( params, "s[100]", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /un [текст]");
		if ( check_advertise ( playerid, params [ 0 ], report_type_un ) ) return 1 ;

		new scm_string [ 144 ], fraction_id = p_info [ playerid ] [ member ] ;
		format(scm_string, sizeof scm_string, "(( [U] (%s) %s %s[%d]: %s ))", f_info [ fraction_id - 1 ] [ f_name ], f_rank [ fraction_id - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], playerid, params[0]);
		foreach(new i: logged_players)
		{
		    if ( ! gang_player ( i ) && ! mafia_player ( i ) ) continue ;
			if ( ( f_diplomacy [ fraction_id - 18 ] [ p_info [ i ] [ member ] - 18 ] == dip_status_alliance || p_info [ i ] [ member ] == fraction_id || is_control_chat { i } == fraction_id ) && p_info [ i ] [ settings ] [ 0 ] != 0 )
			{
				SendClientMessage ( i, 0xb5e8f0FF, scm_string ) ;
			}
		}

		SetPlayerChatBubble(playerid, "Cказал(а) что-то в чат альянса", col_light_purple, 10.0, 3000);
	}
	return 1 ;
}

stock damage_td_status ( playerid, box_id, type )
{
	if ( type == 1 )
	{
	    new default_size = box_id * 10 ;

	    gd_td [ playerid ] [ box_id ] = CreatePlayerTextDraw(playerid, 220.000000, 370.000000+default_size, "~b~~h~tensy~w~ / 52 ~b~~h~Desert Eagle");
	    PlayerTextDrawLetterSize(playerid, gd_td [ playerid ] [ box_id ], 0.180000, 0.900000);
	    PlayerTextDrawTextSize(playerid, gd_td [ playerid ] [ box_id ], 1280.000000, 1280.000000);
	    PlayerTextDrawAlignment(playerid, gd_td [ playerid ] [ box_id ], 2);
	    PlayerTextDrawColor(playerid, gd_td [ playerid ] [ box_id ], 0x00FF00FF);
	    PlayerTextDrawUseBox(playerid, gd_td [ playerid ] [ box_id ], 0);
	    PlayerTextDrawBoxColor(playerid, gd_td [ playerid ] [ box_id ], 0x80808080);
	    PlayerTextDrawSetShadow(playerid, gd_td [ playerid ] [ box_id ], 0);
	    PlayerTextDrawSetOutline(playerid, gd_td [ playerid ] [ box_id ], 1);
	    PlayerTextDrawBackgroundColor(playerid, gd_td [ playerid ] [ box_id ], 0x00000033);
	    PlayerTextDrawFont(playerid, gd_td [ playerid ] [ box_id ], 1);
	    PlayerTextDrawSetProportional(playerid, gd_td [ playerid ] [ box_id ], 1);
	    PlayerTextDrawSetSelectable(playerid, gd_td [ playerid ] [ box_id ], 0);

	    PlayerTextDrawShow ( playerid, gd_td [ playerid ] [ box_id ] ) ;
	    return 1 ;
	}
	else if ( type == 2 )
	{
	    new default_size = box_id * 10 ;

	    td_td [ playerid ] [ box_id ] = CreatePlayerTextDraw(playerid, 420.000000, 370.000000+default_size, "~r~~h~tensy~w~ / -52 ~r~~h~Desert Eagle");
	    PlayerTextDrawLetterSize(playerid, td_td [ playerid ] [ box_id ], 0.180000, 0.900000);
	    PlayerTextDrawTextSize(playerid, td_td [ playerid ] [ box_id ], 1280.000000, 1280.000000);
	    PlayerTextDrawAlignment(playerid, td_td [ playerid ] [ box_id ], 2);
	    PlayerTextDrawColor(playerid, td_td [ playerid ] [ box_id ], 0xFF0000FF);
	    PlayerTextDrawUseBox(playerid, td_td [ playerid ] [ box_id ], 0);
	    PlayerTextDrawBoxColor(playerid, td_td [ playerid ] [ box_id ], 0x80808080);
	    PlayerTextDrawSetShadow(playerid, td_td [ playerid ] [ box_id ], 0);
	    PlayerTextDrawSetOutline(playerid, td_td [ playerid ] [ box_id ], 1);
	    PlayerTextDrawBackgroundColor(playerid, td_td [ playerid ] [ box_id ], 0x00000033);
	    PlayerTextDrawFont(playerid, td_td [ playerid ] [ box_id ], 1);
	    PlayerTextDrawSetProportional(playerid, td_td [ playerid ] [ box_id ], 1);
	    PlayerTextDrawSetSelectable(playerid, td_td [ playerid ] [ box_id ], 0);

	    PlayerTextDrawShow ( playerid, td_td [ playerid ] [ box_id ] ) ;
	    return 1 ;
	}
	else if ( type == 3 )
	{
	    PlayerTextDrawDestroy ( playerid, gd_td [ playerid ] [ box_id ] ) ;

	    p_t_info [ playerid ] [ g_amount ] [ box_id ] = 0.0 ;
	    p_t_info [ playerid ] [ g_weapon ] [ box_id ] = 0 ;

	    p_t_info [ playerid ] [ give_damage_box_type ] [ box_id ] = -1 ;
	    return 1 ;
	}
	else if ( type == 4 )
	{
	    PlayerTextDrawDestroy ( playerid, td_td [ playerid ] [ box_id ] ) ;

	    p_t_info [ playerid ] [ t_amount ] [ box_id ] = 0.0 ;
	    p_t_info [ playerid ] [ t_weapon ] [ box_id ] = 0 ;

	    p_t_info [ playerid ] [ take_damage_box_type ] [ box_id ] = -1 ;
	    return 1 ;
	}
	return 1 ;
}

stock create_gd_td ( playerid, targetid, Float: d_amount, weapon_id, admin_id = -1 )
{
    for ( new i = 0 ; i < 4 ; i ++ )
	{
	    if ( admin_id != -1 )
	    {
	        if ( p_t_info [ admin_id ] [ give_damage_box ] [ i ] != -1 ) continue ;

		    p_t_info [ admin_id ] [ give_damage_box_type ] [ i ] = playerid ;

		    if ( p_t_info [ admin_id ] [ give_damage_box_type ] [ i ] != -1 )
		    {
				new gun_name [ 24 ], temp [ 64 ] ;
			    for ( new j = 0 ; j < 4 ; j ++ )
			    {
			        if ( i == j ) continue ;

			        if ( p_t_info [ admin_id ] [ give_damage_box_type ] [ i ] == p_t_info [ admin_id ] [ give_damage_box_type ] [ j ] )
			        {
			            p_t_info [ admin_id ] [ give_damage_box_type ] [ i ] = -1 ;

						p_t_info [ admin_id ] [ g_amount ] [ j ] += d_amount ;
						p_t_info [ admin_id ] [ g_weapon ] [ j ] = weapon_id ;

                        gun_name [ 0 ] = EOS ;
						GetWeaponName ( p_t_info [ targetid ] [ g_weapon ] [ j ], gun_name, sizeof ( gun_name ) ) ;

                        temp [ 0 ] = EOS ;
						format ( temp, sizeof temp, "~b~~h~%s~w~ / %.1f ~b~~h~%s", give_damage_box_name [ admin_id ] [ j ], p_t_info [ admin_id ] [ g_amount ] [ j ], gun_name ) ;
						PlayerTextDrawSetString ( admin_id, gd_td [ admin_id ] [ j ], temp ) ;

					    KillTimer ( p_t_info [ admin_id ] [ give_damage_box ] [ j ] ) ;
					    p_t_info [ admin_id ] [ give_damage_box ] [ j ] = -1 ;

					    p_t_info [ admin_id ] [ give_damage_box ] [ j ] = SetTimerEx ( "clear_gd_td", 5000 * ( j + 1 ), false, "i", admin_id ) ;
			            return 1 ;
			        }
			    }
			}

			damage_td_status ( admin_id, i, 1 ) ;

			p_t_info [ admin_id ] [ g_amount ] [ i ] += d_amount ;
			p_t_info [ admin_id ] [ g_weapon ] [ i ] = weapon_id ;

			new gun_name [ 24 ], temp [ 64 ] ;
			GetWeaponName ( p_t_info [ admin_id ] [ g_weapon ] [ i ], gun_name, sizeof ( gun_name ) ) ;

			format ( give_damage_box_name [ admin_id ] [ i ], MAX_PLAYER_NAME, "%s", p_info [ playerid ] [ name ] ) ;

			format ( temp, sizeof temp, "~b~~h~%s~w~ / %.1f ~b~~h~%s", give_damage_box_name [ admin_id ] [ i ], p_t_info [ admin_id ] [ g_amount ] [ i ], gun_name ) ;
			PlayerTextDrawSetString ( admin_id, gd_td [ admin_id ] [ i ], temp ) ;

			p_t_info [ admin_id ] [ give_damage_box ] [ i ] = SetTimerEx ( "clear_gd_td", 5000 * ( i + 1 ), false, "i", admin_id ) ;
		  	break ;
	    }
	    else
	    {
		    if ( p_t_info [ targetid ] [ give_damage_box ] [ i ] != -1 ) continue ;

		    p_t_info [ targetid ] [ give_damage_box_type ] [ i ] = playerid ;

		    if ( p_t_info [ targetid ] [ give_damage_box_type ] [ i ] != -1 )
		    {
				new gun_name [ 24 ], temp [ 64 ] ;
			    for ( new j = 0 ; j < 4 ; j ++ )
			    {
			        if ( i == j ) continue ;

			        if ( p_t_info [ targetid ] [ give_damage_box_type ] [ i ] == p_t_info [ targetid ] [ give_damage_box_type ] [ j ] )
			        {
			            p_t_info [ targetid ] [ give_damage_box_type ] [ i ] = -1 ;

						p_t_info [ targetid ] [ g_amount ] [ j ] += d_amount ;
						p_t_info [ targetid ] [ g_weapon ] [ j ] = weapon_id ;

                        gun_name [ 0 ] = EOS ;
						GetWeaponName( p_t_info [ targetid ] [ g_weapon ] [ j ], gun_name, sizeof ( gun_name ) ) ;

                        temp [ 0 ] = EOS ;
						format ( temp, sizeof temp, "~b~~h~%s~w~ / %.1f ~b~~h~%s", give_damage_box_name [ targetid ] [ j ], p_t_info [ targetid ] [ g_amount ] [ j ], gun_name ) ;
						PlayerTextDrawSetString ( targetid, gd_td [ targetid ] [ j ], temp ) ;

					    KillTimer ( p_t_info [ targetid ] [ give_damage_box ] [ j ] ) ;
					    p_t_info [ targetid ] [ give_damage_box ] [ j ] = -1 ;

					    p_t_info [ targetid ] [ give_damage_box ] [ j ] = SetTimerEx ( "clear_gd_td", 5000 * ( j + 1 ), false, "i", targetid ) ;
			            return 1 ;
			        }
			    }
			}

			damage_td_status ( targetid, i, 1 ) ;

			p_t_info [ targetid ] [ g_amount ] [ i ] += d_amount ;
			p_t_info [ targetid ] [ g_weapon ] [ i ] = weapon_id ;

			new gun_name [ 24 ], temp [ 64 ] ;
			GetWeaponName( p_t_info [ targetid ] [ g_weapon ] [ i ], gun_name, sizeof ( gun_name ) ) ;

			format ( give_damage_box_name [ targetid ] [ i ], MAX_PLAYER_NAME, "%s", p_info [ playerid ] [ name ] ) ;

			format ( temp, sizeof temp, "~b~~h~%s~w~ / %.1f ~b~~h~%s", give_damage_box_name [ targetid ] [ i ], p_t_info [ targetid ] [ g_amount ] [ i ], gun_name ) ;
			PlayerTextDrawSetString ( targetid, gd_td [ targetid ] [ i ], temp ) ;

			p_t_info [ targetid ] [ give_damage_box ] [ i ] = SetTimerEx ( "clear_gd_td", 5000 * ( i + 1 ), false, "i", targetid ) ;
		  	break ;
		}
	}
	return 1 ;
}

callback: clear_gd_td ( playerid, box_id )
{
	if ( box_id > 4 )
	{
	    for ( new i = 0 ; i < 4 ; i ++ )
	    {
			KillTimer ( p_t_info [ playerid ] [ give_damage_box ] [ i ] ) ;
			p_t_info [ playerid ] [ give_damage_box ] [ i ] = -1 ;
    		damage_td_status ( playerid, i, 3 ) ;
		}
	}

	if ( p_t_info [ playerid ] [ give_damage_box ] [ box_id ] == -1 ) return 1 ;

    damage_td_status ( playerid, box_id, 3 ) ;

	KillTimer ( p_t_info [ playerid ] [ give_damage_box ] [ box_id ] ) ;
	p_t_info [ playerid ] [ give_damage_box ] [ box_id ] = -1 ;

	for ( new i = 0 ; i < 3 ; i ++ )
	{
	    if ( p_t_info [ playerid ] [ give_damage_box ] [ i ] == -1 && p_t_info [ playerid ] [ give_damage_box ] [ i + 1 ] == -1 ||
			p_t_info [ playerid ] [ give_damage_box ] [ i ] != -1 && p_t_info [ playerid ] [ give_damage_box ] [ i + 1 ] == -1 ) continue ;

	    format ( give_damage_box_name [ playerid ] [ i ], 64, "%s", give_damage_box_name [ playerid ] [ i + 1 ] ) ;

	    p_t_info [ playerid ] [ g_amount ] [ i ] = p_t_info [ playerid ] [ g_amount ] [ i + 1 ] ;
	    p_t_info [ playerid ] [ g_weapon ] [ i ] = p_t_info [ playerid ] [ g_weapon ] [ i + 1 ] ;
	    p_t_info [ playerid ] [ give_damage_box_type ] [ i ] = p_t_info [ playerid ] [ give_damage_box_type ] [ i + 1 ] ;

		damage_td_status ( playerid, i + 1, 3 ) ;

		KillTimer ( p_t_info [ playerid ] [ give_damage_box ] [ i + 1 ] ) ;
		p_t_info [ playerid ] [ give_damage_box ] [ i + 1 ] = -1 ;

        create_gd_td ( p_t_info [ playerid ] [ give_damage_box_type ] [ i ], playerid, p_t_info [ playerid ] [ g_amount ] [ i ], p_t_info [ playerid ] [ g_weapon ] [ i ] ) ;
	}
	return 1 ;
}

