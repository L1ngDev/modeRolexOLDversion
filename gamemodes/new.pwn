	new s_year1, s_month1, s_day1, s_hour1, s_minute1, s_second1 ;
	timestamp_to_date ( month_gettime + CONVERT_TIME_TO_MOSCOW, s_year1, s_month1, s_day1, s_hour1, s_minute1, s_second1 ) ;

