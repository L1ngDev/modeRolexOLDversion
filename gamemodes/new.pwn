callback: callback_users_quests ( playerid )
{
    new rows, fields;
	cache_get_data ( rows, fields ) ;
	if ( ! rows )
	{
	    new _query [ 64 ] ;
	    mysql_format ( sql_connection, _query, sizeof _query, "INSERT INTO `users_quests` (`u_id`) VALUES ('%d')", p_info [ playerid ] [ id ] ) ;
		mysql_tquery ( sql_connection, _query ) ;
	}
	else
	{
		new sscanf_delimit [ 100 ] ;
		for ( new i = 0 ; i < 27 ; i ++ )
		{
		    format ( sscanf_delimit, sizeof sscanf_delimit, "u_farm_quest_%d", i ) ;
			player_quest_cooldown [ playerid ] [ i ] = cache_get_field_content_int ( 0, sscanf_delimit, sql_connection ) ;
		}
	}

	new sql_string [ 87 + 9 ] ;
	format ( sql_string, sizeof sql_string, "SELECT `bl_fraction`, `bl_death` FROM `fractions_blacklist` WHERE `bl_player` = '%d'", p_info [ playerid ] [ id ] ) ;
	mysql_tquery ( sql_connection, sql_string, "callback_bl_check", "i", playerid ) ;
	return 1 ;
}

stock Float:PointToPoint2D(Float:x1,Float:y1,Float:x2,Float:y2) return floatsqroot(floatadd(floatpower(x2-x1,2),floatpower(y2-y1,2)));
stock Float:GetPlayerDistanceToPlayer(playerid, targetid)
{
    new Float:x, Float:y, Float:z, Float:x2, Float:y2, Float:z2;
    GetPlayerPos(playerid, x, y, z);
    GetPlayerPos(targetid, x2, y2, z2);
    return PointToPoint2D(x, y, x2, y2);
}

stock IsPlayerInPickup ( playerid, pickupid )
{
	if ( pickupid < 0 )
	    return 0 ;
	new Float:x, Float:y, Float:z, Float:dist ;
	GetPlayerPos(playerid, x, y, z);
	new type = Streamer_GetIntData(STREAMER_TYPE_PICKUP, pickupid, E_STREAMER_TYPE);
	Streamer_GetDistanceToItem(x, y, z, STREAMER_TYPE_PICKUP, pickupid, dist);

	if ( type != 14 )
	{
		if ( dist <= 3.0 )
			return 1 ;
	}
	else
	{
		if ( dist <= 9.0 )
			return 1 ;
	}
	return 0 ;
}

public OnPlayerCommandReceived(playerid, cmd[], params[], flags)
{
 	#if defined debug_mode
		printf ( "[DEBUG] [OnPlayerCommandReceived] playerid: %d | cmd: %s", playerid, cmd ) ;
	#endif

 	#if defined mini_debug_mode
		printf ( "[DEBUG] [OnPlayerCommandReceived] playerid: %d | cmd: %s", playerid, cmd ) ;
	#endif

	//if ( p_t_info [ playerid ] [ p_logged ] == false ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не авторизованы." ), false ;
	if ( p_t_info [ playerid ] [ p_logged ] == false || player_loaded { playerid } == 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не авторизованы." ), false ;
 	if ( p_t_info [ playerid ] [ p_dialog ] != -1 )
	{
		global_string [ 0 ] = EOS ;
		format ( global_string, 144, "{"#cRInfo"}* {"#cGRInfo"}У Вас открыт диалог, Вы не можете использовать команды. (#%d)", p_t_info [ playerid ] [ p_dialog ] ) ;
		SendClientMessage ( playerid, col_gray, global_string ) ;
		return false ;
	}
 	if ( dr_ptd_model [ playerid ] [ 0 ] != PlayerText:-1 || player_dice_table { playerid } ||
		 used_inventory [ playerid ] == true || used_craft [ playerid ] == true || used_trade [ playerid ] == true ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас открыт интерфейс, Вы не можете использовать команды." ), false ;
	if ( trade_rielt [ playerid ] [ trade_id ] != INVALID_PLAYER_ID && rieltore_opened [ playerid ] == false ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы обмениваетесь, Вы не можете использовать команды." ), false ;
	if ( google_checking { playerid } == 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не авторизовались." ), false ;

	if ( GetTickCount ( ) - cmd_cooldown [ playerid ] < 500 )
	{
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Не флудите." ) ;
		return 0 ;
	}
	cmd_cooldown [ playerid ] = GetTickCount ( ) ;

	return 1 ;
}

public OnPlayerCommandPerformed(playerid, cmd[], params[], result, flags)
{
	//if ( p_t_info [ playerid ] [ p_logged ] == false ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не авторизованы." ) ;
	if ( p_t_info [ playerid ] [ p_logged ] == false || player_loaded { playerid } == 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не авторизованы." ) ;
	if ( result == -1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данная команда не существует. Используйте {"#cRD"}/menu{"#cGRInfo"}, чтобы узнать список команд сервера." ) ;

	#if defined debug_mode
		printf ( "[DEBUG] [OnPlayerCommandPerformed] playerid: %d | cmd: %s", playerid, cmd ) ;
	#endif

	#if defined mini_debug_mode
		printf ( "[DEBUG] [OnPlayerCommandPerformed] playerid: %d | cmd: %s", playerid, cmd ) ;
	#endif
	return 1 ;
}

alias:gotopos("tpcoord")
CMD:gotopos ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 4 )return 1 ;
	new Float: g_x,
		Float: g_y,
		Float: g_z,
		int_id, world_id ;

	if ( sscanf ( params, "p<,>fffdd", g_x, g_y, g_z, int_id, world_id ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /gotopos [x] [y] [z] [interior] [world]" ) ;

	set_pos ( playerid, g_x, g_y, g_z, 0.0, int_id, world_id ) ;
	SendClientMessage ( playerid, col_white, !"Вы телепортировались на указанные координаты." ) ;
	return 1 ;
}

CMD:testp ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 4 )return 1 ;
	new Float: g_x,
		Float: g_y,
		Float: g_z,
		Float: g_a,
		int_id, world_id,
		vehicleId = GetPlayerVehicleID ( playerid ) ;

	if ( sscanf ( params, "p<,>ffffdd", g_x, g_y, g_z, g_a, int_id, world_id ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /testtp [x] [y] [z] [a] [interior] [world]" ) ;

	set_pos ( playerid, g_x, g_y, g_z, g_a, int_id, world_id ) ;
	if ( vehicleId && GetPlayerState ( playerid ) == PLAYER_STATE_DRIVER )
	{
		SetVehiclePos ( vehicleId, g_x, g_y, g_z ) ;
		SetVehicleZAngle ( vehicleId, g_a ) ;

		LinkVehicleToInterior ( vehicleId, int_id ) ;
		SetVehicleVirtualWorld ( vehicleId, world_id ) ;

		PutPlayerInVehicle ( playerid, vehicleId, 0 ) ;
	}
	SendClientMessage ( playerid, col_white, !"Вы телепортировались на указанные координаты." ) ;
	return true ;
}

CMD:gotoint ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 6 )return 1 ;
	if ( sscanf ( params, "d", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /gotoint [id интерьера]" ) ;
	set_interior ( playerid, params [ 0 ] ) ;
	SendClientMessage ( playerid, col_white, !"Вы переместились в указанный интерьер." ) ;
	return 1 ;
}

CMD:gotovw ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 6 )return 1 ;
	if ( sscanf ( params, "d", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /gotovw [id вирт. мира]" ) ;
	set_world ( playerid, params [ 0 ] ) ;
	SendClientMessage ( playerid, col_white, !"Вы переместились в указанный виртуальный мир." ) ;
	return 1 ;
}

CMD:setint ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 6 )return 1 ;
	if ( sscanf ( params, "dd", params [ 0 ], params [ 1 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /setint [id] [id интерьера]" ) ;
	set_interior ( params [ 0 ], params [ 1 ] ) ;

	new scm_string [ 128 ] ;

	format ( scm_string, sizeof ( scm_string  ),"Администратор %s[%d] переместил Вас в интерьер.", p_info [ playerid ] [ name ], playerid ) ;
	SendClientMessage ( params [ 0 ], col_gray, scm_string ) ;
	format ( scm_string, sizeof ( scm_string  ),"{"#cBAdmin"}[A] {"#cGRAdmin"}%s[%d] переместил в интерьер %s[%d]", p_info [ playerid ] [ name ], playerid, p_info [ params [ 0 ] ] [ name ], params [ 0 ] ) ;
	foreach(new i: admin_players)SendClientMessage ( i, col_admin, scm_string ) ;
	return 1 ;
}

CMD:setvw ( playerid, params [ ] )
{
