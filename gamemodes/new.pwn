			mafia_plant_status [ fraction_id - 18 ] [ 0 ], mafia_plant_status [ fraction_id - 18 ] [ 1 ],
			mafia_plant_status [ fraction_id - 18 ] [ 2 ], mafia_plant_status [ fraction_id - 18 ] [ 3 ],
			mafia_plant_status [ fraction_id - 18 ] [ 4 ], mafia_plant_status [ fraction_id - 18 ] [ 5 ],
			mafia_plant_status [ fraction_id - 18 ] [ 6 ], mafia_plant_status [ fraction_id - 18 ] [ 7 ],
			p_info [ playerid ] [ member ] ) ;
