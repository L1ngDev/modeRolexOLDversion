						h_info [ t ] [ h_pickup ] = CreateDynamicPickup ( pickupPropertyFree, 23, h_info [ t ] [ h_pos ] [ 0 ], h_info [ t ] [ h_pos ] [ 1 ], h_info [ t ] [ h_pos ] [ 2 ], h_info [ t ] [ h_vw ], -1 ) ;
						pick_info [ h_info [ t ] [ h_pickup ] ] [ pick_type ] = pick_type_hentrance ;
						pick_info [ h_info [ t ] [ h_pickup ] ] [ pick_item ] = h_info [ t ] [ h_id ] ;

						if ( ! h_info [ t ] [ h_vw ] ) h_info [ t ] [ h_icon_id ] = CreateDynamicMapIcon ( h_info [ t ] [ h_pos ] [ 0 ], h_info [ t ] [ h_pos ] [ 1 ], h_info [ t ] [ h_pos ] [ 2 ], radar_propertyG, 0, 0, 0, -1 ) ;
					}
