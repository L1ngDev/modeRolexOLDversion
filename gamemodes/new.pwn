callback: get_player_warn_count ( playerid )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;

	p_info [ playerid ] [ p_warn ] = rows ;

	if ( rows )
	{
	    new _w_end [ 32 ], scm_string [ 75 + 32 ] ;
		for ( new i = 0 ; i < rows ; i ++ )
		{
		    cache_get_field_content ( i, "w_end", _w_end, sql_connection, 32 ) ;

		    format ( scm_string, sizeof scm_string, "* У Вас есть активное предупреждение. Дата окончания предупреждения: %s.", _w_end ) ;
		    SendClientMessage ( playerid, col_red, scm_string ) ;
		}
	}

	usersInventoryLoading ( playerid ) ;
	return 1 ;
}

