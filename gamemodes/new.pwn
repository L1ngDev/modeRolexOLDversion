CMD:apark ( playerid )
{
    if ( admin_info [ playerid ] [ admin ] < 6 )return 1 ;

	for ( new j = 0 ; j < MAX_NONPARKING_ZONES ; j ++ )
	{
		if ( IsPlayerInDynamicArea ( playerid, non_parking_area [ j ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете припарковать транспорт в зоне запрета парковки." ) ;
	}
	if ( GetPlayerState ( playerid ) != PLAYER_STATE_DRIVER )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны находиться за рулём транспортного средства." ) ;

	new veh_id = GetPlayerVehicleID ( playerid ) ;
	if ( IsValidVehicle ( veh_id ) )
	{
	    foreach(new i: logged_players)
	    {
			if ( veh_info [ veh_id - 1 ] [ v_owner ] != p_info [ i ] [ id ] || veh_info [ veh_id - 1 ] [ v_type ] != vehicle_type_player )continue ;
			new Float:vehicle_health ;
			GetVehicleHealth ( veh_id, vehicle_health ) ;
			if ( vehicle_health < 950 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Для начала нужно починить транспортное средство." ) ;

			foreach(new j: streamed_vehicles[playerid])
			{
				if ( ! IsValidVehicle ( j ) ) continue;
				if ( veh_info [ j - 1 ] [ v_vw ] == GetPlayerVirtualWorld ( playerid ) && IsPlayerInRangeOfPoint ( playerid, 3.0, veh_info [ j - 1 ] [ v_pos ] [ 0 ], veh_info [ j - 1 ] [ v_pos ] [ 1 ], veh_info [ j - 1 ] [ v_pos ] [ 2 ] ) )
				{
					SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Невозможно припарковать транспорт вбилизи парковки другого транспортного средства." ) ;
					return 1 ;
				}
			}

			GetVehiclePos ( veh_id, veh_info [ veh_id - 1 ] [ v_pos ] [ 0 ], veh_info [ veh_id - 1 ] [ v_pos ] [ 1 ], veh_info [ veh_id - 1 ] [ v_pos ] [ 2 ] ) ;
			GetVehicleZAngle ( veh_id, veh_info [ veh_id - 1 ] [ v_pos ] [ 3 ] ) ;

			new new_veh_id = CreateVehicle ( getVehicleOrdinalNumber ( veh_id ), veh_info [ veh_id - 1 ] [ v_pos ] [ 0 ], veh_info [ veh_id - 1 ] [ v_pos ] [ 1 ], veh_info [ veh_id - 1 ] [ v_pos ] [ 2 ], veh_info [ veh_id - 1 ] [ v_pos ] [ 3 ], veh_info [ veh_id - 1 ] [ v_color ] [ 0 ], veh_info [ veh_id - 1 ] [ v_color ] [ 1 ], SPAWN_TIME_PLAYER_VEHICLE ) ;
			Iter_Add ( player_vehicles[i], new_veh_id ) ;

			veh_info [ new_veh_id - 1 ] [ v_type ] = vehicle_type_player ;
			reInitVehicle ( new_veh_id, veh_id ) ;

			veh_info [ new_veh_id - 1 ] [ v_vehicle ] = new_veh_id ;

			veh_info [ new_veh_id - 1 ] [ v_vw ] = GetPlayerVirtualWorld ( playerid ) ;
			veh_info [ new_veh_id - 1 ] [ v_int ] = GetPlayerInterior ( playerid ) ;
			if ( veh_info [ new_veh_id - 1 ] [ v_int ] != 0 ) LinkVehicleToInterior ( new_veh_id, veh_info [ new_veh_id - 1 ] [ v_int ] ) ;
			if ( veh_info [ new_veh_id - 1 ] [ v_vw ] != 0 ) SetVehicleVirtualWorld ( new_veh_id, veh_info [ new_veh_id - 1 ] [ v_vw ] ) ;

			veh_plate ( new_veh_id ) ;

			SetVehicleNumberPlate ( new_veh_id, veh_info [ new_veh_id - 1 ] [ v_plate ] ) ;

            OnVehicleIteration ( new_veh_id ) ;
			DestroyVehicle ( veh_id, 14 ) ;
			Iter_Remove ( player_vehicles[i], veh_id ) ;

			new engine, lights, alarm, doors, bonnet, boot, objective ;

			GetVehicleParamsEx ( new_veh_id, engine, lights, alarm, doors, bonnet, boot, objective ) ;
			SetVehicleParamsEx ( new_veh_id, engine, lights, alarm, veh_info [ new_veh_id - 1 ] [ v_locked ], bonnet, boot, objective ) ;

			new scm_string [ 198 ] ;
			SendClientMessage ( playerid, col_gray, !"* Машина успешно припаркована." ) ;

			format ( scm_string, 198, "UPDATE `users_vehicles` SET `v_pos_x` = '%.2f', `v_pos_y` = '%.2f', `v_pos_z` = '%.2f',`v_pos_a` = '%.2f',`v_vw` = '%d',`v_int` = '%d' WHERE `v_id` = '%d' LIMIT 1",
			veh_info [ new_veh_id - 1 ] [ v_pos ] [ 0 ], veh_info [ new_veh_id - 1 ] [ v_pos ] [ 1 ], veh_info [ new_veh_id - 1 ] [ v_pos ] [ 2 ], veh_info [ new_veh_id - 1 ] [ v_pos ] [ 3 ],
			veh_info [ new_veh_id - 1 ] [ v_vw ], veh_info [ new_veh_id - 1 ] [ v_int ],
			veh_info [ new_veh_id - 1 ] [ v_id ] ) ;
			mysql_tquery ( sql_connection, scm_string ) ;
			break ;
		}
	}
	return 1 ;
}

CMD:finevehicle ( playerid, params [ ] )
{
    if ( admin_info [ playerid ] [ admin ] < 7 )return 1 ;
    if ( sscanf ( params, "d", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /finevehicle [ид авто]" ) ;
    new vehicleid = params [ 0 ] ;
    foreach(new i: logged_players)
    {
		if ( veh_info [ vehicleid - 1 ] [ v_owner ] == p_info [ i ] [ id ] && veh_info [ vehicleid - 1 ] [ v_type ] == vehicle_type_player )
		{
			new query_string [ 156 ] ;

			format ( query_string, sizeof query_string, "{"#cGInfo"}* {"#cWH"} Вы успешно отправили {"#cGN"}%s{"#cWH"} на штрафстоянку.", GetVehicleNameEx ( vehicleid ) ) ;
			SendClientMessage ( playerid, col_white, query_string ) ;

			format ( query_string, sizeof ( query_string ),"UPDATE `users_vehicles` SET `v_fuel` = '%f',`v_millage` = '%f',`v_fine` = '1' WHERE `v_id` = '%d' LIMIT 1",
			veh_info [ vehicleid - 1 ] [ v_fuel ],
			veh_info [ vehicleid - 1 ] [ v_millage ],
			veh_info [ vehicleid - 1 ] [ v_id ] ) ;
			mysql_tquery ( sql_connection, query_string, "", "" ) ;

			Iter_Remove(player_vehicles[i], vehicleid ) ;
			show_dialog ( i, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Информация", "{"#cRD"}ВНИМАНИЕ!\n\n{"#cRD"}ОДИН ИЗ ВАШИХ АВТОМОБИЛЕЙ НАХОДИТСЯ НА ШТРАФСТОЯНКЕ\n{"#cBL"}Чтобы забрать используйте {"#cWH"}'/gps > Прочее > Штрафстоянка'{"#cBL"}.", "Закрыть", "" ) ;

			DestroyVehicle ( vehicleid, 15 ) ;
			break ;
		}
	}
	return 1 ;
}

CMD:destroyveh ( playerid, params [ ] )
{
    if ( admin_info [ playerid ] [ admin ] < 8 )return 1 ;
    if ( sscanf ( params, "d", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /destroyveh [ид авто]" ) ;
    new veh_id = params [ 0 ] ;
    if ( veh_info [ veh_id - 1 ] [ v_type ] == vehicle_type_player )
    {
	    foreach(new i: logged_players)
	    {
			if ( veh_info [ veh_id - 1 ] [ v_owner ] == p_info [ i ] [ id ] )
			{
				new veh_price = GetModelPrice ( getVehicleOrdinalNumber ( veh_id ) ) ;
				new car_string [ 64 ] ;

				veh_price = veh_price - veh_price / 10 ;

				give_money ( i, veh_price ) ;

				format ( car_string, sizeof car_string, "продажа транспорта ([A] %s)", p_info [ playerid ] [ name ] ) ;
				insert_money_log ( i, INVALID_PLAYER_ID, veh_price, car_string ) ;

				static const _str [ ] = "{"#cGInfo"}* {"#cWH"} Вы успешно продали {"#cGN"}%s{"#cWH"} за {"#cGN"}%d"valute_title"{"#cWH"}." ;
				new query_string [ sizeof _str + 32 + 9 ] ;
				format ( query_string, sizeof query_string, _str, GetVehicleNameEx ( veh_id ), veh_price ) ;
				SendClientMessage ( playerid, col_white, query_string ) ;

				format ( query_string, sizeof query_string, "{"#cGInfo"}* {"#cWH"} Ваш транспорт {"#cGN"}%s{"#cWH"} был продан администратором.", GetVehicleNameEx ( veh_id ) ) ;
				SendClientMessage ( i, col_white, query_string ) ;

				format ( query_string, sizeof ( query_string ), "DELETE FROM `users_vehicles` WHERE `v_id` = '%d' LIMIT 1", veh_info [ veh_id - 1 ] [ v_id ] ) ;
				mysql_tquery( sql_connection, query_string ) ;

				Iter_Remove(player_vehicles[i], veh_id ) ;
				DestroyVehicle ( veh_id, 16 ) ;
				break ;
			}
		}
	}
	return 1 ;
}

CMD:delveh( playerid, params [ ] )
{
    if ( admin_info [ playerid ] [ admin ] < 4 )return 1 ;
	if ( ! GetPVarInt ( playerid, "admin_vehicle" ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не создавали автомобиль." ) ;

	new veh_id = GetPVarInt ( playerid, "admin_vehicle" ) ;
	//if ( GetPlayerVehicleID ( playerid ) == veh_id ) kill_speedometr ( playerid ) ;

	DestroyVehicle ( veh_id, 17 ) ;
	DeletePVar ( playerid, "admin_vehicle" ) ;
	return true ;
}

alias:clearchat("cc")
CMD:clearchat( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 5 )return 1 ;
	for ( new i = 0; i < 56 ; i ++ ) SendClientMessageToAll ( col_white, !" ") ;
	foreach(new i: logged_players) if ( p_info [ i ] [ settings ] [ 2 ] ) SendClientMessage ( i, col_light_red, !"Чат был очищен администрацией." ) ;

	static const _str [ ] = "{"#cBAdmin"}[A] {"#cGRAdmin"}Администратор %s очистил чат." ;
	new scm_string [ sizeof _str + 24 ] ;
	format ( scm_string, sizeof ( scm_string ), _str, p_info [ playerid ] [ name ] ) ;
	foreach(new i: admin_players) SendClientMessage ( i, col_admin, scm_string ) ;

	format ( scm_string, sizeof scm_string, "(/cc) %s", p_info [ playerid ] [ name ] ) ;
	WriteLog ( playerid, TYPE_LOG_ADMIN, scm_string ) ;
	return 1 ;
}

alias:admin("a")
CMD:admin ( playerid, params [ ] )
{
	if ( ! admin_info [ playerid ] [ admin ] )return 1 ;
	if ( sscanf( params, "s[128]", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /a [текст]" ) ;
	new scm_string [ 144 ] ;
	format ( scm_string, sizeof ( scm_string  ),"[A] (%d уровень) %s[%d]: %s", admin_info [ playerid ] [ admin ], p_info [ playerid ] [ name ], playerid, params [ 0 ] ) ;
	foreach(new i: admin_players) SendClientMessage ( i, col_green, scm_string ) ; // 0x6699FFFF
	return true ;
}

CMD:stats ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 2 )
	{
	    show_stats ( playerid, playerid ) ;
	    return 1 ;
	}
	if ( sscanf ( params, "u", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /stats [ид]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	show_stats ( params [ 0 ], playerid ) ;
	return true ;
}

CMD:money ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 2 )return 1 ;
	if ( sscanf ( params, "u", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /money [ид]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;

	new sql_string [ 83 + 9 + 4 ] ;
	mysql_format ( sql_connection, sql_string, sizeof sql_string, "SELECT `db_id`, `db_money` FROM `deposit_boxes` WHERE `db_owner` = '%d' LIMIT %d", p_info [ params [ 0 ] ] [ id ], MAX_BANK_ACCOUNT ) ;
	mysql_tquery ( sql_connection, sql_string, "cmd_money_callback", "ii", playerid, params [ 0 ] ) ;
	return true ;
}

callback:cmd_money_callback ( playerid, targetid )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;

	global_string [ 0 ] = EOS ;

	new line_string [ 78 ] ;

	format ( global_string, 81, "{"#cGRDialog"}Наличные - {"#cWH"}%d"valute_title_"\n\n{"#cBL"}Открытые счета\n", p_info [ targetid ] [ money ] ) ;
	for ( new j = 0 ; j < rows ; j ++ )
	{
		new _db_id = cache_get_field_content_int ( j, "db_id", sql_connection ) ;
		new _db_money = cache_get_field_content_int ( j, "db_money", sql_connection ) ;

		format ( line_string, sizeof ( line_string ), "{"#cGRDialog"}№%d - {"#cWH"}%d"valute_title_"\n", _db_id, _db_money ) ;
		strcat ( global_string, line_string ) ;
	}
	show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Финансы игрока", global_string, "Закрыть", "" ) ;
	return 1 ;
}

CMD:moneylog ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 6 )return 1 ;
	if ( sscanf ( params, "u", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /moneylog [ид]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;

    page_count [ playerid ] = 1 ;

	new sql_string [ 127 + MAX_PLAYER_NAME ] ;
	mysql_format ( sql_connection, sql_string, sizeof sql_string, "SELECT `log_id`, `money`, `name`, `date`, `reason` FROM `money_logs` WHERE `name` = '%s' ORDER BY `money_logs`.`log_id` DESC", p_info [ params [ 0 ] ] [ name ] ) ;
	mysql_tquery ( sql_connection, sql_string, "cmd_moneylog_callback", "i", playerid ) ;

    SetPVarString ( playerid, "log_name", p_info [ params [ 0 ] ] [ name ] ) ;
	return true ;
}

CMD:offmoneylog ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 6 )return 1 ;
	if ( sscanf ( params, "s[24]", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /offmoneylog [имя]" ) ;

    page_count [ playerid ] = 1 ;

	new sql_string [ 127 + MAX_PLAYER_NAME ] ;
	mysql_format ( sql_connection, sql_string, sizeof sql_string, "SELECT `log_id`, `money`, `name`, `date`, `reason` FROM `money_logs` WHERE `name` = '%s' ORDER BY `money_logs`.`log_id` DESC", params [ 0 ] ) ;
	mysql_tquery ( sql_connection, sql_string, "cmd_moneylog_callback", "i", playerid ) ;

	SetPVarString ( playerid, "log_name", params [ 0 ] ) ;
	return true ;
}

callback: moneylog_callback_info ( playerid )
{
    new rows, fields ;
	cache_get_data ( rows, fields ) ;

	if ( ! rows )
	{
		DeletePVar ( playerid, "log_name" ) ;
	    page_count [ playerid ] = 0 ;
		return 1 ;
	}

	new log_date [ 24 ], log_reason [ 48 ], log_from [ 24 ], log_name [ 24 ], log_money, log_from_money, log_ip [ 18 ] ;
	log_money = cache_get_field_content_int ( 0, "money", sql_connection ) ;
	log_from_money = cache_get_field_content_int ( 0, "player_money", sql_connection ) ;

    cache_get_field_content ( 0, "name", log_name, sql_connection, 24 ) ;
	cache_get_field_content ( 0, "from_name", log_from, sql_connection, 24 ) ;
	cache_get_field_content ( 0, "reason", log_reason, sql_connection, 48 ) ;
	cache_get_field_content ( 0, "date", log_date, sql_connection, 24 ) ;
	cache_get_field_content ( 0, "ip", log_ip, sql_connection, 18 ) ;

	static const _str [ ] = "{"#cWH"}Ник персонажа: {"#cOR"}%s\n{"#cWH"}Ник получателя: {"#cOR"}%s\n{"#cWH"}Сумма: {"#cGN"}%s"valute_title_"\n{"#cWH"}Сумма оставшихся средств: {"#cGN"}%s"valute_title_"\n{"#cWH"}Дата: {"#cWV"}%s\n{"#cWH"}IP-адрес: {"#cWV"}%s\n\n{"#cWH"}Действие: {"#cGN"}%s" ;
	new logs_dialog [ sizeof _str + 24 + 24 + 18 + 48 + 18 + 128 ] ;
	format ( logs_dialog, sizeof(logs_dialog), _str, log_name, log_from, GetPlayerCashValueToSmile ( log_money ), GetPlayerCashValueToSmile ( log_from_money ), log_date, log_ip, log_reason ) ;
	show_dialog ( playerid, d_money_logback, DIALOG_STYLE_MSGBOX, "{"#cBHD"}История финансов игрока", logs_dialog, "Назад", "Закрыть" ) ;
	return 1 ;
}

callback: cmd_moneylog_callback ( playerid )
{
	new rows, fields;
	cache_get_data(rows, fields);
	new log_date [ 24 ], log_from [ 24 ], log_id, log_money, reason_position [ 24 ], log_reason [ 12 ] ;
	if ( ! rows )
	{
	    DeletePVar ( playerid, "log_name" ) ;
	    page_count [ playerid ] = 0 ;
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Активных логов не найдено." ) ;
		return 1 ;
	}

	page_rows [ playerid ] = rows ;
    new rows_list = page_count [ playerid ] - 1 ;
    global_string [ 0 ] = EOS ;
	new line_string [ 128 ], row_count ;
	for ( new j = rows_list * 10 ; j <  rows_list * 10 + 10 ; j ++ )
	{
	    if ( j >= rows ) break ;

	    log_id = cache_get_field_content_int ( j, "log_id", sql_connection ) ;
	    log_money = cache_get_field_content_int ( j, "money", sql_connection ) ;

		cache_get_field_content ( j, "name", log_from, sql_connection, 24 ) ;
		cache_get_field_content ( j, "date", log_date, sql_connection, 24 ) ;

		cache_get_field_content ( j, "reason", log_reason, sql_connection, 12 ) ;

		set_player_listitem_values ( playerid, j - rows_list * 10, log_id ) ;

		if ( log_money > 0 ) format ( reason_position, sizeof reason_position, "[{"#cGN"}+{"#cWH"}]" ) ;
		else format ( reason_position, sizeof reason_position, "[{"#cRD"}-{"#cWH"}]" ) ;

		format(line_string, sizeof(line_string), "{"#cBL"}%d. {"#cWH"}%s %s * %s... {"#cGRDialog"}(%s)\n", j + 1, reason_position, log_from, log_reason, log_date);
		strcat ( global_string, line_string ) ;

		row_count ++ ;
	}

	if ( rows_list > 0 )
	{
		strcat ( global_string, "{"#cBL"}Предыдущая страница\n" ) ;
		set_player_use_page ( playerid, row_count, 0 ) ;
		row_count ++ ;
	}
	if ( ofm_formula ( page_count [ playerid ] ) < rows )
	{
		strcat ( global_string, "{"#cBL"}Следующая страница\n" ) ;
		set_player_use_page ( playerid, row_count, 1 ) ;
	}

	show_dialog(playerid, d_money_lognext, DIALOG_STYLE_LIST, "{"#cBHD"}История финансов игрока", global_string, "Выбрать", "Закрыть");
	return 1 ;
}

callback: callback_renters ( playerid )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows )
	{
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет подселённых жильцов." ) ;
		show_renters ( playerid ) ;
		page_count [ playerid ] = 0 ;
		return 1 ;
	}

	new rows_list = page_count [ playerid ] - 1 ;
	page_rows [ playerid ] = rows ;
	global_string [ 0 ] = EOS ;
	new line_string [ MAX_PLAYER_NAME + 100 ], pl_ofm_name [ 24 ], pl_ofm_online [ 24 ], row_count ;
	for ( new i = rows_list * 10 ; i <  rows_list * 10 + 10 ; i ++ )
	{
		if ( i >= rows ) break ;

		cache_get_field_content ( i, "u_name", pl_ofm_name, sql_connection, 24 ) ;
		cache_get_field_content ( i, "u_last_date", pl_ofm_online, sql_connection, 24 ) ;

		new pvar_string [ 8 ] ;
		format ( pvar_string, sizeof ( pvar_string ), "ofm_%d", i - rows_list * 10 ) ;
		SetPVarString ( playerid, pvar_string, pl_ofm_name ) ;

		new _pl_id ;
		sscanf ( pl_ofm_name, "u", _pl_id ) ;

		format ( line_string, sizeof ( line_string ), "{"#cWH"}%s - %s (%s)\n", pl_ofm_name, pl_ofm_online, ( IsPlayerConnected ( _pl_id ) ) ? ( "{"#cGN"}ONLINE{ffffff}" ) : ( "{"#cRD"}OFFLINE{ffffff}" ) ) ;
		strcat ( global_string, line_string ) ;

		row_count ++ ;
	}

    if ( rows_list > 0 )
	{
		strcat ( global_string, "{"#cBL"}Предыдущая страница\n" ) ;
		set_player_use_page ( playerid, row_count, 0 ) ;
		row_count ++ ;
	}
	if ( ofm_formula ( page_count [ playerid ] ) < rows )
	{
		strcat ( global_string, "{"#cBL"}Следующая страница\n" ) ;
		set_player_use_page ( playerid, row_count, 1 ) ;
	}

	show_dialog ( playerid, d_h_rent_list, DIALOG_STYLE_LIST, "{"#cBHD"}Жильцы", global_string, "Выбрать", "Назад" ) ;
	return 1 ;
}

callback: callback_offbusiness ( playerid )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows )
	{
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игроки с данными параметрами не найдены." ) ;
		show_bpanel ( playerid ) ;
		page_count [ playerid ] = 0 ;
		return 1 ;
	}

	new rows_list = page_count [ playerid ] - 1 ;
	page_rows [ playerid ] = rows ;
	global_string [ 0 ] = EOS ;
	new line_string [ MAX_PLAYER_NAME + 100 ], pl_ofm_name [ 24 ], pl_ofm_online [ 24 ], pl_ofm_time, pl_ofm_rank, pl_ofm_worker, row_count ;
	for ( new i = rows_list * 10 ; i <  rows_list * 10 + 10 ; i ++ )
	{
		if ( i >= rows ) break ;

		cache_get_field_content ( i, "u_name", pl_ofm_name, sql_connection, 24 ) ;
		pl_ofm_time = cache_get_field_content_int ( i, "u_played_time", sql_connection ) ;

		pl_ofm_rank = cache_get_field_content_int ( 0, "u_business_rang", sql_connection ) ;
		if ( pl_ofm_rank < 1 ) pl_ofm_rank = 1 ;

		pl_ofm_worker = cache_get_field_content_int ( 0, "u_bworker", sql_connection ) ;

  		new pvar_string [ 8 ] ;
		format ( pvar_string, sizeof ( pvar_string ), "ofm_%d", i - rows_list * 10 ) ;
		SetPVarString ( playerid, pvar_string, pl_ofm_name ) ;

		new _pl_id ;
		sscanf ( pl_ofm_name, "u", _pl_id ) ;

		if ( IsPlayerConnected ( _pl_id ) ) format ( pl_ofm_online, sizeof pl_ofm_online, "Сейчас играет ({"#cGN"}ONLINE{ffffff})" ) ;
		else
		{
		    new float_time = gettime( ) - pl_ofm_time ;
			format ( pl_ofm_online, sizeof pl_ofm_online, "%s ({"#cRD"}OFFLINE{ffffff})", check_float_time ( float_time ) ) ;
		}

		format ( line_string, sizeof ( line_string ), "{"#cWH"}%s - %s - {"#cBL"}%s\n", pl_ofm_name, pl_ofm_online, b_rank [ pl_ofm_worker - 1 ] [ pl_ofm_rank - 1 ] ) ;
		strcat ( global_string, line_string ) ;

		row_count ++ ;
	}

    if ( rows_list > 0 )
	{
		strcat ( global_string, "{"#cBL"}Предыдущая страница\n" ) ;
		set_player_use_page ( playerid, row_count, 0 ) ;
		row_count ++ ;
	}
	if ( ofm_formula ( page_count [ playerid ] ) < rows )
	{
		strcat ( global_string, "{"#cBL"}Следующая страница\n" ) ;
		set_player_use_page ( playerid, row_count, 1 ) ;
	}

	show_dialog ( playerid, d_offmembers_list9, DIALOG_STYLE_LIST, "{"#cBHD"}Сотрудники оффлайн", global_string, "Выбрать", "Назад" ) ;
	return 1 ;
}

callback: callback_offbusiness_info ( playerid )
{
	new rows, fields;
	cache_get_data ( rows, fields ) ;
	if ( rows )
	{
		new last_date [ 24 ] ;

		cache_get_field_content(0, "u_last_date", last_date, sql_connection, 24 ) ;

		new pvar_string [ 38 ], pl_name [ MAX_PLAYER_NAME ] ;
		format ( pvar_string, sizeof ( pvar_string ), "ofm_%d", GetPVarInt ( playerid, "ofm_listitem" ) ) ;
		GetPVarString ( playerid, pvar_string, pl_name, MAX_PLAYER_NAME ) ;

		static const _str [ ] = "{"#cWH"}Имя: {"#cBL"}%s{"#cWH"}\nПоследний вход: {"#cBL"}%s{"#cWH"}" ;
		new dialog_string [ sizeof _str + 24 + 16 ] ;
		format ( dialog_string, sizeof ( dialog_string ), _str, pl_name, last_date ) ;
		show_dialog ( playerid, d_offmembers_pl_menu_info9, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Информация об игроке", dialog_string, "Назад", "" ) ;
	}
	if ( ! rows )
	{
		new query_string [ 144 ] ;
		DeletePVar( playerid, "ofm_listitem" ) ;
		if( ! GetPVarInt ( playerid, "ofm_type" ) )
		{
			mysql_format ( sql_connection, query_string, sizeof query_string, "SELECT `u_name`,`u_played_time`,`u_business_rang`,`u_bworker` FROM `users` WHERE `u_bworker` = '%d'", p_info [ playerid ] [ business ] ) ;
			mysql_tquery ( sql_connection, query_string, "callback_offbusiness", "i", playerid ) ;
			return 1 ;
		}
	}
	return 1 ;
}

callback: casino_itog_callback ( b )
{
    new rows, fields;
	cache_get_data ( rows, fields ) ;
	if ( ! rows ) return 1 ;

	if ( rows )
    {
    	new _u_name [ MAX_PLAYER_NAME ], _u_id ;
	   	_u_id = cache_get_field_content_int ( 0, "u_id", sql_connection ) ;
		cache_get_field_content ( 0, "u_name", _u_name, sql_connection, MAX_PLAYER_NAME ) ;

		new _pl_id ;
  		sscanf ( _u_name, "u", _pl_id ) ;
		if ( IsPlayerConnected ( _pl_id ) )
		{
		    give_money ( _pl_id, b_info [ b - 1 ] [ b_win_prise ] ) ;
           	insert_money_log ( _pl_id, INVALID_PLAYER_ID, b_info [ b - 1 ] [ b_win_prise ], "куш в казино" ) ;

           	SendClientMessage ( _pl_id, col_white, !"{"#cBInfo"}* {"#cWH"}Поздравляем! Вы выйграли недельный куш в казино!" ) ;
		}
		else
		{
		    new scm_string [ 143 + 9 ] ;
			format ( scm_string, sizeof scm_string, "Поздравляем! Вы выйграли недельный куш в казино (%d"valute_title_")!\nПолучить деньги можно в банке подойдя к надписи получение переводов.", b_info [ b - 1 ] [ b_win_prise ] ) ;
			insert_debtor_message ( "Выйгрыш в казино", scm_string, _u_id ) ;

			insert_return_money ( "Выйгрыш в казино", b_info [ b - 1 ] [ b_win_prise ], _u_id ) ;
		}

	    new scm_string [ 128 ] ;
		foreach(new j: logged_players)
		{
		  	format ( scm_string, sizeof scm_string, "* Казино '%s': {"#cWH"}Недельный куш в казино '%s' выигрывает: %s.", b_info [ b - 1 ] [ b_name ], b_info [ b - 1 ] [ b_name ], _u_name ) ;
		   	SendClientMessage ( j, col_lorange, scm_string ) ;
		 	format ( scm_string, sizeof scm_string, "* Казино '%s': {"#cWH"}Недельный призовой фонд составил: {"#cGN"}%d"valute_title"{"#cWH"}.", b_info [ b - 1 ] [ b_name ], b_info [ b - 1 ] [ b_win_prise ] ) ;
		   	SendClientMessage ( j, col_lorange, scm_string ) ;
		}

		b_info [ b - 1 ] [ b_win_prise ] = 0 ;
		format ( scm_string, 100, "UPDATE `businesses` SET `b_win_prise` = '0' WHERE `b_id` = '%d' LIMIT 1", b_info [ b - 1 ] [ b_id ] ) ;
		mysql_tquery ( sql_connection, scm_string ) ;

		mysql_tquery ( sql_connection, "TRUNCATE `users_casino`" ) ;
	}
	return 1 ;
}

callback: casino_hoax_callback ( b )
{
    new rows, fields;
	cache_get_data ( rows, fields ) ;
	if ( ! rows ) return 1 ;

   	if ( rows )
    {
    	new _u_name [ MAX_PLAYER_NAME ], _u_id ;
	   	_u_id = cache_get_field_content_int ( 0, "u_id", sql_connection ) ;
		cache_get_field_content ( 0, "u_name", _u_name, sql_connection, MAX_PLAYER_NAME ) ;

		new _pl_id ;
  		sscanf ( _u_name, "u", _pl_id ) ;
		if ( IsPlayerConnected ( _pl_id ) )
		{
		    veh_prise_create ( _pl_id, 0, b_info [ b - 1 ] [ b_win_car ] ) ;

           	SendClientMessage ( _pl_id, col_white, !"{"#cBInfo"}* {"#cWH"}Поздравляем! Вы выйграли автомобиль, который разыгрывался в казино!" ) ;
		}
		else
		{
		    new ts_id = 0, ts_spawn_slot = random ( 5 ) ;

			new query_string [ 328 ] ;
			mysql_format ( sql_connection, query_string, sizeof query_string, "INSERT INTO `users_vehicles`(`v_model`,`v_owner`,`v_color_1`,`v_color_2`,`v_pos_x`,`v_pos_y`,`v_pos_z`,`v_pos_a`,`v_buydate`,`v_gps_tracker`,`v_price`) VALUES ('%d','%i','1','1','%f','%f','%f','%f',NOW(),'1','%d')",
            b_info [ b - 1 ] [ b_win_car ],
			_u_id,
			t_shop_respawn [ ts_id ] [ ts_spawn_slot ] [ 0 ],
			t_shop_respawn [ ts_id ] [ ts_spawn_slot ] [ 1 ],
			t_shop_respawn [ ts_id ] [ ts_spawn_slot ] [ 2 ],
			t_shop_respawn [ ts_id ] [ ts_spawn_slot ] [ 3 ],
			GetModelPrice ( b_info [ b - 1 ] [ b_win_car ] ) ) ;
			mysql_tquery ( sql_connection, query_string ) ;

			MODEL_INFO [ b_info [ b - 1 ] [ b_win_car ] ] [ MODEL_COUNT ] += 1 ;
			set_model_count ( b_info [ b - 1 ] [ b_win_car ], MODEL_INFO [ b_info [ b - 1 ] [ b_win_car ] ] [ MODEL_COUNT ] ) ;

			insert_debtor_message ( "Выйгрыш в казино", "Поздравляем! Вы выйграли автомобиль, который разыгрывался в казино!", _u_id ) ;
		}

	    new scm_string [ 144 ] ;
		foreach(new j: logged_players)
		{
		  	format ( scm_string, sizeof scm_string, "* Казино '%s': {"#cWH"}Победу в розыгрыше автомобиля в казино '%s' одержал: %s.", b_info [ b - 1 ] [ b_name ], b_info [ b - 1 ] [ b_name ], _u_name ) ;
		   	SendClientMessage ( j, col_lorange, scm_string ) ;
		 	format ( scm_string, sizeof scm_string, "* Казино '%s': {"#cWH"}Разыгрываемый автомобиль: {"#cGN"}%s{"#cWH"}.", b_info [ b - 1 ] [ b_name ], GetVehicleNameEx ( b_info [ b - 1 ] [ b_car_id ] ) ) ;
		   	SendClientMessage ( j, col_lorange, scm_string ) ;
		}
		mysql_tquery ( sql_connection, "TRUNCATE `users_casino_hoax`" ) ;

		b_info [ b - 1 ] [ b_win_car ] = casino_car [ random ( MAX_CASINO_CAR - 1 ) ] ;
		create_veh_casino ( b_info [ b - 1 ] [ b_win_car ], b ) ;

		new _query_string [ 73 + 4 + 9 ] ;
		format(_query_string, sizeof _query_string, "UPDATE `businesses` SET `b_win_car` = '%d' WHERE `b_id` = '%d' LIMIT 1", b_info [ b - 1 ] [ b_win_car ], b_info [ b - 1 ] [ b_id ] ) ;
		mysql_tquery ( sql_connection, _query_string ) ;
	}
	return 1 ;
}

callback: lottery_itog_callback ( ticket_number )
{
    new rows, fields;
	cache_get_data ( rows, fields ) ;
	if ( ! rows )
	{
	    new scm_string [ 128 ] ;

		lottery_prise += floatround ( ( f_info [ 10 ] [ f_money ] * 1 ) / 1000 ) ;
		format ( scm_string, sizeof scm_string, "UPDATE `server_variables` SET `var_count` = '%d' WHERE `var_id` = '56' LIMIT 1", lottery_prise ) ;
		mysql_tquery ( sql_connection, scm_string ) ;

		set_money_fraction ( 10, 1, floatround ( ( f_info [ 10 ] [ f_money ] * 1 ) / 1000 ), false ) ;

		foreach(new j: logged_players)
		{
		  	SendClientMessage ( j, col_lgreen, !"* Государственная лотерея: {"#cWH"}Победителем в ежедневной лотерии становится: победителя нет." ) ;
		  	SendClientMessage ( j, col_lgreen, !"* Государственная лотерея: {"#cWH"}Итоги будут подведены повторно на следующий день." ) ;
		 	format ( scm_string, sizeof scm_string, "* Государственная лотерея: {"#cWH"}Призовой фонд лотереи: {"#cGN"}%d"valute_title"{"#cWH"}.", lottery_prise ) ;
		   	SendClientMessage ( j, col_lgreen, scm_string ) ;
		}

		mysql_tquery ( sql_connection, "TRUNCATE `users_lottery`" ) ;
	    return 1 ;
	}

	if ( rows )
	{
	    new _u_name [ MAX_PLAYER_NAME ], _u_id, _u_ticket ;
	   	_u_id = cache_get_field_content_int ( 0, "u_id", sql_connection ) ;
	   	_u_ticket = cache_get_field_content_int ( 0, "u_lottery", sql_connection ) ;

		cache_get_field_content ( 0, "u_name", _u_name, sql_connection, MAX_PLAYER_NAME ) ;

		if ( ticket_number == _u_ticket )
		{
		    new _pl_id ;
		    sscanf ( _u_name, "u", _pl_id ) ;
			if ( IsPlayerConnected ( _pl_id ) )
			{
			    give_money ( _pl_id, lottery_prise ) ;
            	insert_money_log ( _pl_id, INVALID_PLAYER_ID, lottery_prise, "победа в лотереи" ) ;

            	SendClientMessage ( _pl_id, col_white, !"{"#cBInfo"}* {"#cWH"}Поздравляем! Вы смогли выйграть в лотерее!" ) ;
			}
			else
			{
			    new scm_string [ 178 ] ;
				format ( scm_string, sizeof scm_string, "Поздравляем! Вы смогли выйграть в лотерее!\nПризовой фонд составил %d"valute_title_"\nПолучить деньги можно в банке подойдя к надписи получение переводов.", lottery_prise ) ;
				insert_debtor_message ( "Лотерея", scm_string, _u_id ) ;

				insert_return_money ( "Лотерея", lottery_prise, _u_id ) ;
			}

			foreach(new j: logged_players)
			{
			    new scm_string [ 128 ] ;
			    format ( scm_string, sizeof scm_string, "* Государственная лотерея: {"#cWH"}Победителем в ежедневной лотерии становится: %s.", _u_name ) ;
			    SendClientMessage ( j, col_lgreen, scm_string ) ;
			    format ( scm_string, sizeof scm_string, "* Государственная лотерея: {"#cWH"}Призовой фонд лотереи составил: {"#cGN"}%d"valute_title"{"#cWH"}.", lottery_prise ) ;
			    SendClientMessage ( j, col_lgreen, scm_string ) ;
			}

			new scm_string [ 81 + 9 ] ;

			lottery_prise = floatround ( ( f_info [ 10 ] [ f_money ] * 1 ) / 1000 ) ;
			format ( scm_string, sizeof scm_string, "UPDATE `server_variables` SET `var_count` = '%d' WHERE `var_id` = '56' LIMIT 1", lottery_prise ) ;
			mysql_tquery ( sql_connection, scm_string ) ;

			set_money_fraction ( 10, 1, floatround ( ( f_info [ 10 ] [ f_money ] * 1 ) / 1000 ), false ) ;

			mysql_tquery ( sql_connection, "TRUNCATE `users_lottery`" ) ;
		    return 1 ;
		}
	}
	return 1 ;
}

callback: lottery_callback ( playerid )
{
	new fields,
		rows ;
	cache_get_data ( rows, fields ) ;

	if ( ! rows )
	{
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет лотерейных билетов." ) ;
		page_count [ playerid ] = 0 ;
		return 1 ;
	}

	new rows_list = page_count [ playerid ] - 1 ;
	page_rows [ playerid ] = rows ;

	global_string [ 0 ] = EOS ;
	new line_string [ 64 ] ;

	format ( line_string, sizeof line_string, "{"#cLY"}У Вас куплено билетов: {"#cGN"}%d\n{ffffff}", page_rows [ playerid ] ) ;
    strcat ( global_string, line_string ) ;
	strcat ( global_string, "{"#cLY"}Список Ваших билетов\n\n{ffffff}" ) ;

	for ( new i = rows_list * 10 ; i <  rows_list * 10 + 10 ; i ++ )
	{
		if ( i >= rows ) break ;

 		new _u_lottery = cache_get_field_content_int ( i, "u_lottery", sql_connection ) ;

		format ( line_string, sizeof line_string, "Билет {"#cBL"}№%d\n{ffffff}", _u_lottery ) ;
		strcat ( global_string, line_string ) ;
	}
	show_dialog ( playerid, d_mm_lottery, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Лотерейные билеты", global_string, "Назад", "Далее" ) ;
	return 1 ;
}

alias:ans("pm")
CMD:ans( playerid, params [ ] )
{
	if ( ! admin_info [ playerid ] [ admin ] ) return 1 ;
	if ( sscanf ( params, "ds[128]", params [ 0 ], params [ 1 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /ans [ид/имя] [текст]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) || params [ 0 ] == INVALID_PLAYER_ID ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( admin_info [ params [ 0 ] ] [ admin ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок администратор." ) ;
	if ( is_text_invalid_binder ( params [ 1 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы используете запрещённые символы в ответе." ) ;

	new scm_string [ 144 ] ;
	format ( scm_string, sizeof ( scm_string ), "* Администратор %s[%i]:{"#cWH"} %s", p_info [ playerid ] [ name ], playerid, params [ 1 ] ) ;
	SendClientMessage ( params [ 0 ], 0xcec710FF, scm_string ) ;

	format ( scm_string, sizeof ( scm_string ), "* [ОТВЕТ]: %s[%i] для %s[%i]:{"#cWH"} %s", p_info [ playerid ] [ name ], playerid, p_info [ params [ 0 ] ] [ name ], params [ 0 ], params [ 1 ] ) ;
	foreach(new i: admin_players) SendClientMessage ( i, 0xcec710FF, scm_string ) ;

	if ( report_id [ params [ 0 ] ] != -1 )
	{
	    SendClientMessage ( params [ 0 ], 0xcec710FF, !"* Оцените ответ от администратор. Введите {"#cWH"}\"/reputation [ + или - ]\"{cec710}." ) ;

	    if ( params [ 0 ] != playerid )
		{
			report_ans [ params [ 0 ] ] = playerid ;

			admin_info [ playerid ] [ report ] ++ ;
		}
		if ( ! GetPVarInt ( playerid, "cmd_params" ) )
		{
			if ( offline_report ) update_report ( playerid, params [ 1 ], report_id [ params [ 0 ] ], 2 ) ;
		}
		else DeletePVar ( playerid, "cmd_params" ) ;

		admin_info [ playerid ] [ coins ] += 1 ;
	    report_ans [ params [ 0 ] ] = playerid ;
	    report_id [ params [ 0 ] ] = -1 ;
	}

	if ( auto_report )
	{
	    if ( admin_info [ playerid ] [ admin ] < 6 )
    		mysql_tquery ( sql_connection, "SELECT `r_id`, `u_id`, `r_status`, `u_name`, `date`, `text` FROM `logs_report` WHERE `r_status` = '0' LIMIT 1", "callback_admin_report", "ii", playerid, 1 ) ;
	}
	return 1 ;
}

CMD:reputation ( playerid, params [ ] )
{
	if ( report_ans [ playerid ] == -1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет активного ответа от администрации для оценки." ) ;

	new _reps [ 32 ] ;
	if ( sscanf ( params, "s[32]", _reps ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /reputation [+ или -]" ) ;
	if ( strlen ( _reps ) != 1 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /reputation [+ или -]" ) ;
	if ( ! GetString ( _reps, "+" ) && ! GetString ( _reps, "-" ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /reputation [+ или -]" ) ;

	new scm_string [ 98 + MAX_PLAYER_NAME ] ;
	new admin_id = report_ans [ playerid ] ;
	if ( GetString ( _reps, "+" ) )
	{
	    format ( scm_string,sizeof(scm_string),"UPDATE `users_admins` SET `u_a_reputation` = `u_a_reputation`+1 WHERE `u_a_id` = '%d' LIMIT 1", p_info [ admin_id ] [ id ] ) ;
		mysql_tquery ( sql_connection, scm_string ) ;
	}
	else
	{
	    format ( scm_string,sizeof(scm_string),"UPDATE `users_admins` SET `u_a_reputation` = `u_a_reputation`-1 WHERE `u_a_id` = '%d' LIMIT 1", p_info [ admin_id ] [ id ] ) ;
		mysql_tquery ( sql_connection, scm_string ) ;
	}

	SendClientMessage ( playerid, 0xcec710FF, !"* Спасибо за оценку ответа! Нам это очень важно." ) ;
	report_ans [ playerid ] = -1 ;
	return 1 ;
}

CMD:report ( playerid, params [ ] )
{
	if ( p_info [ playerid ] [ mute ] )
	{
		new scm_string [ 38 ] ;
		format ( scm_string, sizeof ( scm_string ),"У вас бан чата | %d секунд(ы)", p_info [ playerid ] [ mute ] ) ;
		SendClientMessage ( playerid, col_light_red, scm_string ) ;
		return true ;
	}
	if ( report_cooldown [ playerid ] > gettime ( ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Жалобу/вопрос можно писать только раз в 60 секунд." ) ;
	if ( sscanf ( params, "s[100]", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /report [жалоба/вопрос]" ) ;
	if ( strlen ( params [ 0 ] ) < 3 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Обращение не может быть короче 3 символов." ) ;
	if ( admin_info [ playerid ] [ admin ] > 0 && admin_info [ playerid ] [ admin ] < 7 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы администратор." ) ;

    report_tp [ playerid ] = gettime ( ) + 180 ;
	report_cooldown [ playerid ] = gettime ( ) + 60 ;
	if ( report_id [ playerid ] != -1 ) report_id [ playerid ] = -1 ;

	new text_string [ 144 ] ;
	format ( text_string, 144, "{"#cRD"}* [ЖАЛОБА]{"#cWH"} %s", params [ 0 ] ) ;
	SendClientMessage ( playerid, col_red, text_string ) ;
	SendClientMessage ( playerid, col_red, !"{"#cRInfo"}* {"#cWH"}На Ваш вопрос обязательно ответит администрация!" ) ;
	SendClientMessage ( playerid, col_red, !"{"#cRInfo"}* {"#cWH"}Если за Вами необходимо проследить, администрация сделает это вне очереди!" ) ;
	SendClientMessage ( playerid, col_red, !"{"#cRInfo"}* {"#cWH"}Рекомендуем Вам ознакомиться с системами самостоятельно. Используйте {"#cRInfo"}/help{"#cWH"}." ) ;

	format ( text_string, 144, "{"#cRD"}* [ЖАЛОБА] %s[%d]:{"#cWH"} %s %s", p_info [ playerid ] [ name ], playerid, params [ 0 ], ( offline_report ) ? ( "(/arep)" ) : ( "(/pm)" ) ) ;
 	foreach(new i: admin_players) SendClientMessage ( i, col_red, text_string ) ;

 	count_report ++ ;

	if ( server_report )
	{
		new _ans_id = find_answer ( playerid, params [ 0 ] ) ;
		if ( _ans_id )
		{
		    count_auto_report ++ ;

		    new scm_string [ 144 ] ;
			format ( scm_string, sizeof ( scm_string  ), "* Ответ от сервера:{"#cWH"} %s", get_answer ( _ans_id ) ) ;
			SendClientMessage ( playerid, 0xcec710FF, scm_string ) ;

			format ( scm_string, sizeof ( scm_string  ), "* [ОТВЕТ]: Сервер для %s[%i]:{"#cWH"} %s", p_info [ playerid ] [ name ], playerid, get_answer ( _ans_id ) ) ;
			foreach(new i: admin_players) SendClientMessage ( i, 0xcec710FF, scm_string ) ;
		    return 1 ;
		}
	}

	if ( offline_report ) insert_report ( playerid, params [ 0 ] ) ;
	return 1 ;
}
alias:report("rep")

callback: callback_admin_report ( playerid, _type )
{
    new rows, fields ;
	cache_get_data ( rows, fields ) ;

	if ( ! rows )
	{
	    SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Список жалоб пуст!" ) ;
		return 1 ;
	}

	if ( _type == 1 )
	{
	    new pl_ofm_name [ MAX_PLAYER_NAME ], pl_ofm_online [ 64 ], _p_date [ 48 ], _p_text [ 128 ], _r_id, _u_id ;

		_r_id = cache_get_field_content_int ( 0, "r_id", sql_connection ) ;
	    _u_id = cache_get_field_content_int ( 0, "u_id", sql_connection ) ;
		cache_get_field_content ( 0, "u_name", pl_ofm_name, sql_connection, 32 ) ;
		cache_get_field_content ( 0, "date", _p_date, sql_connection, 48 ) ;
		cache_get_field_content ( 0, "text", _p_text, sql_connection, 128 ) ;

		new _pl_id ;
		sscanf ( pl_ofm_name, "u", _pl_id ) ;

	    global_string [ 0 ] = EOS ;
		if ( IsPlayerConnected ( _pl_id ) )
		{
			SetPVarInt ( playerid, "_pl_id", _pl_id ) ;
			SetPVarInt ( playerid, "_r_id", _r_id ) ;
			SetPVarInt ( playerid, "arep_2", 1 ) ;
			format ( pl_ofm_online, sizeof pl_ofm_online, "Сейчас играет ({"#cGN"}ONLINE{ffffff})" ) ;

			format ( global_string, 144, "[A] %s[%d] рассматривает обращение от %s[%d]", p_info [ playerid ] [ name ], playerid, p_info [ _pl_id ] [ name ], _pl_id ) ;
			foreach(new i: admin_players) SendClientMessage ( i, 0xcec710FF, global_string ) ;

	    	global_string [ 0 ] = EOS ;
	    	format ( global_string, 512, "{"#cBL"}%s\n{"#cWH"}Автор: {"#cOR"}%s{"#cWH"} - %s\n{"#cWH"}Дата: {"#cWV"}%s\n\n{"#cGRDialog"}* При входе в игру игрок увидит Ваш ответ\n{"#cGRDialog"}* через команду /checkrep\n\n{"#cGRDialog"}* Если Вам надо проследить, то введите ответ\n{"#cGRDialog"}* и нажмите 'СЛЕЖКА'\n\n{"#cGRDialog"}* Введите ответ на жалобу:", _p_text, pl_ofm_name, pl_ofm_online, _p_date ) ;

			new line_string [ 64 ] ;
			format ( line_string, sizeof line_string, "{"#cBHD"}Жалоба {"#cBL"}№%d", _r_id ) ;
			show_dialog ( playerid, d_areport_select, DIALOG_STYLE_INPUT, line_string, global_string, "Ответить", "Слежка" ) ;
		}
		else
		{
		    SetPVarInt ( playerid, "_pl_id", -1 ) ;
		    SetPVarInt ( playerid, "_r_id", _r_id ) ;
		    SetPVarInt ( playerid, "arep_2", 1 ) ;
			format ( pl_ofm_online, sizeof pl_ofm_online, "Не в игре ({"#cRD"}OFFLINE{ffffff})" ) ;

			format ( global_string, 144, "[A] %s[%d] рассматривает OFFLINE обращение от %s[account: №%d]", p_info [ playerid ] [ name ], playerid, pl_ofm_name, _u_id ) ;
			foreach(new i: admin_players) SendClientMessage ( i, 0xcec710FF, global_string ) ;

	    	global_string [ 0 ] = EOS ;
	    	format ( global_string, 512, "{"#cBL"}%s\n{"#cWH"}Автор: {"#cOR"}%s{"#cWH"} - %s\n{"#cWH"}Дата: {"#cWV"}%s\n\n{"#cGRDialog"}* При входе в игру игрок увидит Ваш ответ\n{"#cGRDialog"}* через команду /checkrep\n\n{"#cGRDialog"}* Введите ответ на жалобу:", _p_text, pl_ofm_name, pl_ofm_online, _p_date ) ;

		    new line_string [ 64 ] ;
			format ( line_string, sizeof line_string, "{"#cBHD"}Жалоба {"#cBL"}№%d", _r_id ) ;
			show_dialog ( playerid, d_areport_select, DIALOG_STYLE_INPUT, line_string, global_string, "Ответить", "" ) ;
		}
	}
	else if ( _type == 2 )
	{
		global_string [ 0 ] = EOS ;
		new line_string [ 128 ] ;
		new _r_id, t_time, float_time, pl_ofm_name [ MAX_PLAYER_NAME ], pl_ofm_online [ 24 ], pl_ofm_playerid [ 21 ] ;
		for ( new i = 0 ; i < rows ; i ++ )
		{
		    _r_id = cache_get_field_content_int ( i, "r_id", sql_connection ) ;

			cache_get_field_content ( i, "u_name", pl_ofm_name, sql_connection, 32 ) ;
			t_time = cache_get_field_content_int ( i, "date", sql_connection ) ;

	        float_time = gettime( ) - t_time ;

	  		set_player_listitem_values ( playerid, i, _r_id ) ;

			new _pl_id ;
			sscanf ( pl_ofm_name, "u", _pl_id ) ;

			if ( IsPlayerConnected ( _pl_id ) )
			{
				format ( pl_ofm_online, sizeof pl_ofm_online, "{"#cGN"}ONLINE" ) ;
				format ( pl_ofm_playerid, sizeof pl_ofm_playerid, " [ID: %d]", _pl_id ) ;
			}
			else
			{
				format ( pl_ofm_online, sizeof pl_ofm_online, "{"#cRD"}OFFLINE" ) ;
				format ( pl_ofm_playerid, sizeof pl_ofm_playerid, "", _pl_id ) ;
			}

			format ( line_string, sizeof ( line_string ), "{"#cBL"}№%d. {"#cGRDialog"}[%s{"#cGRDialog"}] {"#cWH"}%s%s {"#cGRDialog"}(%s)\n", _r_id, pl_ofm_online, pl_ofm_name, pl_ofm_playerid, check_float_time ( float_time ) ) ;
			strcat ( global_string, line_string ) ;
		}
		show_dialog ( playerid, d_areport, DIALOG_STYLE_LIST, "{"#cBHD"}Последние 20 жалоб", global_string, "Выбрать", "Закрыть" ) ;
	}
	return 1 ;
}

callback: callback_admin_report_info ( playerid )
{
    new rows, fields ;
	cache_get_data ( rows, fields ) ;

	if ( ! rows )
	{
	    callcmd::checkreport ( playerid ) ;
		return 1 ;
	}

	new pl_ofm_name [ MAX_PLAYER_NAME ], pl_ofm_online [ 64 ], _p_date [ 48 ], _p_text [ 128 ], _r_id, _u_id ;

	_r_id = cache_get_field_content_int ( 0, "r_id", sql_connection ) ;
    _u_id = cache_get_field_content_int ( 0, "u_id", sql_connection ) ;
	cache_get_field_content ( 0, "u_name", pl_ofm_name, sql_connection, 32 ) ;
	cache_get_field_content ( 0, "date", _p_date ) ;
	cache_get_field_content ( 0, "text", _p_text ) ;

	new _pl_id ;
	sscanf ( pl_ofm_name, "u", _pl_id ) ;

    global_string [ 0 ] = EOS ;
	if ( IsPlayerConnected ( _pl_id ) )
	{
		SetPVarInt ( playerid, "_pl_id", _pl_id ) ;
		SetPVarInt ( playerid, "_r_id", _r_id ) ;
		format ( pl_ofm_online, sizeof pl_ofm_online, "Сейчас играет ({"#cGN"}ONLINE{ffffff})" ) ;

		format ( global_string, 144, "[A] %s[%d] рассматривает обращение от %s[%d]", p_info [ playerid ] [ name ], playerid, p_info [ _pl_id ] [ name ], _pl_id ) ;
		foreach(new i: admin_players) SendClientMessage ( i, 0xcec710FF, global_string ) ;
	}
	else
	{
	    SetPVarInt ( playerid, "_pl_id", -1 ) ;
	    SetPVarInt ( playerid, "_r_id", _r_id ) ;
		format ( pl_ofm_online, sizeof pl_ofm_online, "Не в игре ({"#cRD"}OFFLINE{ffffff})" ) ;

		format ( global_string, 144, "[A] %s[%d] рассматривает OFFLINE обращение от %s[account: №%d]", p_info [ playerid ] [ name ], playerid, pl_ofm_name, _u_id ) ;
		foreach(new i: admin_players) SendClientMessage ( i, 0xcec710FF, global_string ) ;
	}

    global_string [ 0 ] = EOS ;
    format ( global_string, 356, "{"#cBL"}%s\n{"#cWH"}Автор: {"#cOR"}%s{"#cWH"} - %s\n{"#cWH"}Дата: {"#cWV"}%s\n\n{"#cGRDialog"}* Введите ответ на жалобу:", _p_text, pl_ofm_name, pl_ofm_online, _p_date ) ;

	new line_string [ 64 ] ;
	format ( line_string, sizeof line_string, "{"#cBHD"}Жалоба {"#cBL"}№%d", _r_id ) ;
	show_dialog ( playerid, d_areport_select, DIALOG_STYLE_INPUT, line_string, global_string, "Ответить", "Назад" ) ;
	return 1 ;
}

CMD:areport ( playerid )
{
    if ( ! admin_info [ playerid ] [ admin ] ) return 1 ;

    if ( admin_info [ playerid ] [ admin ] < 6 )
    	mysql_tquery ( sql_connection, "SELECT `r_id`, `u_id`, `r_status`, `u_name`, `date`, `text` FROM `logs_report` WHERE `r_status` = '0' LIMIT 1", "callback_admin_report", "ii", playerid, 1 ) ;

	else
		mysql_tquery ( sql_connection, "SELECT `r_id`, `u_name`, UNIX_TIMESTAMP(`date`) as `date` FROM `logs_report` WHERE `r_status` = '0' ORDER BY `logs_report`.`r_id` DESC LIMIT 20", "callback_admin_report", "ii", playerid, 2 ) ;
	return 1 ;
}
alias:areport("arep")

stock adminsList ( playerid, page )
{
	page_count [ playerid ] = page ;

	new count = 0, playersCount = 0 ;

	global_string [ 0 ] = EOS ;
	strcat ( global_string, "{"#cBL"}ID. Ник:\t{"#cBL"}Уровень:\t{"#cBL"}Информация:\n") ;
  	foreach(new i: admin_players)
	{
		if ( admin_info [ i ] [ admin ] > 7 && admin_info [ playerid ] [ admin ] < 8 ) continue ;
		if ( page * 10 > count )
		{
			count ++ ;
			continue ;
		}
  		if ( count > ( page + 1 ) * 10 ) continue ;

  		set_player_listitem_values ( playerid, playersCount, i ) ;
		playersCount ++ ;
		count ++ ;

		if ( admin_info [ i ] [ spectate_id ] != -1 ) format ( global_string, sizeof ( global_string ), "%s{"#cBL"}%i. {"#cWH"}%s\t%d ур.\t{"#cLY"}Следит за %s[%d]\n", global_string, i, p_info [ i ] [ name ], admin_info [ i ] [ admin ], p_info [ admin_info [ i ] [ spectate_id ] ] [ name ], admin_info [ i ] [ spectate_id ] ) ;
		else if ( pl_afk_time [ i ] > 3 ) format ( global_string, sizeof ( global_string ), "%s{"#cBL"}%i. {"#cWH"}%s\t%d ур.\t{"#cTN"}На паузе\n", global_string, i, p_info [ i ] [ name ], admin_info [ i ] [ admin ] ) ;
		else format ( global_string, sizeof ( global_string ), "%s{"#cBL"}%i. {"#cWH"}%s\t%d ур.\t{"#cGN"}в сети\n", global_string, i, p_info [ i ] [ name ], admin_info [ i ] [ admin ] ) ;
	}

	foreach(new i: tester_players)
	{
		if ( page * 10 > count ) { count ++ ; continue ; }
		if ( count > ( page + 1 ) * 10 ) { count ++ ; continue ; }
		set_player_listitem_values ( playerid, playersCount, i ) ;
		playersCount ++ ;
		count ++ ;
		if ( pl_afk_time [ i ] > 3 ) format ( global_string, sizeof global_string, "%s{"#cBL"}%i. {"#cWH"}%s\t{"#cLB"}[Тестер]\t{"#cTN"}На паузе\n", global_string, i, p_info [ i ] [ name ] ) ;
		else format ( global_string, sizeof global_string, "%s{"#cBL"}%i. {"#cWH"}%s\t{"#cLB"}[Тестер]\t{"#cGN"}в сети\n", global_string, i, p_info [ i ] [ name ] ) ;
	}

	strcat ( global_string, "{"#cBL"}Информация\n" ) ;
	if ( page > 0 ) strcat ( global_string, "{"#cBL"}Предыдущая страница\n" ) ;
	if ( count > ( page + 1 ) * 10 ) strcat ( global_string, "{"#cBL"}Следующая страница" ) ;

	static const _str [ ] = "{"#cBHD"}Администрация в сети ({"#cWH"}%d {"#cBHD"}в сети)" ;
	new header_string [ sizeof _str + 9 ] ;
	format ( header_string, sizeof header_string, _str, count ) ;
	show_dialog ( playerid, d_admins, DIALOG_STYLE_TABLIST_HEADERS, header_string, global_string, "Выбрать", "Закрыть" ) ;
    return true ;
}

CMD:admins ( playerid )
{
	if ( ! admin_info [ playerid ] [ admin ] && ! tester_admin [ playerid ] && p_info [ playerid ] [ vip ] < 1 ) return SendClientMessage ( playerid, col_gray, !"{"#CRInfo"}* {"#cGRInfo"}Для просмотра списка администрации Вам необходим VIP статус!" ) ;

	adminsList ( playerid, 0 ) ;
	return 1 ;
}

CMD:avig ( playerid, params [ ] )
{
 	if ( admin_info [ playerid ] [ admin ] < 7 ) return 1 ;
	if ( sscanf ( params, "us[32]", params [ 0 ], params [ 1 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /avig [ид/имя] [причина]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] )  || params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( ! admin_info [ params [ 0 ] ] [ admin ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не администратор." ) ;
	if ( admin_info [ params [ 0 ] ] [ admin ] >= 8 ) return 1 ;

	admin_info [ params [ 0 ] ] [ warning ] ++ ;

	new fm_string [ 144 ] ;
	if ( admin_info [ params [ 0 ] ] [ warning ] >= 3 )
	{
	    format ( fm_string, sizeof fm_string, "{"#cBAdmin"}[A] %s[%d] {"#cGRAdmin"}снял(а) администратора {"#cBAdmin"}%s[%d]{"#cGRAdmin"}. Причина: %s", p_info [ playerid ] [ name ], playerid, p_info [ params [ 0 ] ] [ name ], params [ 0 ], params [ 1 ] ) ;
		foreach(new i: admin_players) SendClientMessage ( i, col_admin, fm_string ) ;

		format ( fm_string, sizeof fm_string, "%s выдал(а) выговор %s. Причина: %s", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], params [ 1 ] ) ;
		WriteLog ( playerid, TYPE_LOG_ADMIN, fm_string ) ;

		remove_admin ( params [ 0 ] ) ;

		static const _str [ ] = "DELETE FROM `users_admins` WHERE `u_a_id` = '%d' LIMIT 1" ;
		new sql_string [ sizeof _str + 9 ] ;
		format ( sql_string, sizeof sql_string, _str, p_info [ params [ 0 ] ] [ id ] ) ;
		mysql_tquery ( sql_connection, sql_string ) ;
	}
	else
	{
	    format ( fm_string, sizeof fm_string, "{"#cBAdmin"}[A] %s[%d] {"#cGRAdmin"}выдал(а) выговор {"#cBAdmin"}%s[%d]{"#cGRAdmin"}. Причина: %s", p_info [ playerid ] [ name ], playerid, p_info [ params [ 0 ] ] [ name ], params [ 0 ], params [ 1 ] ) ;
		foreach(new i: admin_players) SendClientMessage ( i, col_admin, fm_string ) ;

		format ( fm_string, sizeof fm_string, "%s выдал(а) выговор %s. Причина: %s", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], params [ 1 ] ) ;
		WriteLog ( playerid, TYPE_LOG_ADMIN, fm_string ) ;

		format ( fm_string, sizeof fm_string, "UPDATE `users_admins` SET `u_a_warning` = '%d' WHERE `u_a_id` = '%d' LIMIT 1", admin_info [ params [ 0 ] ] [ warning ], p_info [ params [ 0 ] ] [ id ] ) ;
        mysql_tquery ( sql_connection, fm_string ) ;
	}
    return 1 ;
}

CMD:unavig ( playerid, params [ ] )
{
 	if ( admin_info [ playerid ] [ admin ] < 7 ) return 1 ;
	if ( sscanf ( params, "u", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /avig [ид/имя]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] )  || params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( ! admin_info [ params [ 0 ] ] [ admin ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не администратор." ) ;
	if ( admin_info [ params [ 0 ] ] [ admin ] >= 8 ) return 1 ;
	if ( ! admin_info [ params [ 0 ] ] [ warning ] ) return 1 ;

	admin_info [ params [ 0 ] ] [ warning ] -- ;

	new fm_string [ 144 ] ;
	format ( fm_string, sizeof fm_string, "{"#cBAdmin"}[A] {"#cGRAdmin"}%s[%d] снял(а) выговор администратору %s[%d].", p_info [ playerid ] [ name ], playerid, p_info [ params [ 0 ] ] [ name ], params [ 0 ] ) ;
	foreach(new i: admin_players) SendClientMessage ( i, col_admin, fm_string ) ;

	format ( fm_string, sizeof fm_string, "UPDATE `users_admins` SET `u_a_warning` = '%d' WHERE `u_a_id` = '%d' LIMIT 1", admin_info [ params [ 0 ] ] [ warning ], p_info [ params [ 0 ] ] [ id ] ) ;
	mysql_tquery ( sql_connection, fm_string ) ;
    return 1 ;
}

stock tester_no_access ( playerid )
{
	SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет прав на использование данной команды." ) ;
	return 1 ;
}

stock tester_load ( playerid )
{
	tester_admin [ playerid ] = false ;
	Iter_Remove ( tester_players, playerid ) ;
	new query [ 112 ] ;
	format ( query, sizeof query, "SELECT `u_t_id` FROM `users_testers` WHERE `u_t_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
	mysql_tquery ( sql_connection, query, "callback_tester_load", "i", playerid ) ;
	return 1 ;
}

callback: callback_tester_load ( playerid )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( rows && IsPlayerConnected ( playerid ) && ! admin_info [ playerid ] [ admin ] && admin_info [ playerid ] [ player_admin ] == false && ! IsFounder ( playerid ) )
	{
		tester_admin [ playerid ] = true ;
		Iter_Add ( tester_players, playerid ) ;
		SendClientMessage ( playerid, 0x33AAFFFF, !"* Активированы права администратора для тестирования. Команды: /thelp" ) ;
	}
	return 1 ;
}

CMD:maketester ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 8 ) return tester_no_access ( playerid ) ;
	new targetid ;
	if ( sscanf ( params, "u", targetid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /maketester [ид/имя]" ) ;
	if ( ! IsPlayerConnected ( targetid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( admin_info [ targetid ] [ admin ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок уже является обычным администратором." ) ;

	new query [ 256 ], message [ 180 ] ;
	if ( tester_admin [ targetid ] )
	{
		tester_admin [ targetid ] = false ;
		Iter_Remove ( tester_players, targetid ) ;
		format ( query, sizeof query, "DELETE FROM `users_testers` WHERE `u_t_id` = '%d' LIMIT 1", p_info [ targetid ] [ id ] ) ;
		mysql_tquery ( sql_connection, query ) ;
		format ( message, sizeof message, "Администратор %s снял с Вас права администратора для тестирования.", p_info [ playerid ] [ name ] ) ;
		SendClientMessage ( targetid, col_lorange, message ) ;
		format ( message, sizeof message, "Вы сняли тестовые права с %s[%d].", p_info [ targetid ] [ name ], targetid ) ;
		SendClientMessage ( playerid, col_lorange, message ) ;
	}
	else
	{
		tester_admin [ targetid ] = true ;
		Iter_Add ( tester_players, targetid ) ;
		mysql_format ( sql_connection, query, sizeof query, "REPLACE INTO `users_testers` (`u_t_id`,`u_t_name`,`u_t_issued_by`) VALUES ('%d','%e','%e')", p_info [ targetid ] [ id ], p_info [ targetid ] [ name ], p_info [ playerid ] [ name ] ) ;
		mysql_tquery ( sql_connection, query ) ;
		format ( message, sizeof message, "Администратор %s выдал Вам права администратора ДЛЯ тестирования.", p_info [ playerid ] [ name ] ) ;
		SendClientMessage ( targetid, col_lorange, message ) ;
		SendClientMessage ( targetid, 0x33AAFFFF, !"* Все необходимые для тестирования команды можно посмотреть в /thelp." ) ;
		format ( message, sizeof message, "Вы выдали тестовые права игроку %s[%d].", p_info [ targetid ] [ name ], targetid ) ;
		SendClientMessage ( playerid, col_lorange, message ) ;
	}
	return 1 ;
}

CMD:thelp ( playerid )
{
	if ( ! tester_admin [ playerid ] ) return tester_no_access ( playerid ) ;
	show_dialog ( playerid, d_thelp, DIALOG_STYLE_LIST, "{"#cBHD"}Тестовая администрация",
		"{"#cLB"}/admins {"#cWH"}- администрация и тестеры в сети\n\
		{"#cLB"}/sp [id] {"#cWH"}- наблюдение за игроком\n\
		{"#cLB"}/spoff {"#cWH"}- закончить наблюдение\n\
		{"#cLB"}/goto [id] {"#cWH"}- телепортироваться к игроку\n\
		{"#cLB"}/spawn [id] {"#cWH"}- заспавнить игрока\n\
		{"#cLB"}/fix {"#cWH"}- починить текущий транспорт\n\
		{"#cLB"}/veh [модель] [цвет 1] [цвет 2] {"#cWH"}- создать транспорт\n\
		{"#cLB"}/skin [id] [скин] {"#cWH"}- временно изменить скин\n\
		{"#cLB"}/tp {"#cWH"}- меню телепортации\n\
		{"#cLB"}Метка на карте {"#cWH"}- телепорт по установленной метке\n\
		{"#cOR"}Информация",
		"Выбрать", "Закрыть" ) ;
	return 1 ;
}
CMD:makeadmin ( playerid, params [ ] )
{
    if ( admin_info [ playerid ] [ admin ] < 7 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данная команда не существует. Используйте {"#cRD"}/menu{"#cGRInfo"}, чтобы узнать список команд сервера." ) ;

 	if ( sscanf ( params, "u", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /makeadmin [ид/имя]" ) ;

	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( p_info [ params [ 0 ] ] [ member ] > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок состоит в организации." ) ;

	new header_string [ MAX_PLAYER_NAME + 14 ] ;
	SetPVarInt ( playerid, "target_id", params [ 0 ] ) ;

	format ( header_string, sizeof ( header_string ), "{"#cBHD"}%s", p_info [ params [ 0 ] ] [ name ] ) ;
	show_dialog ( playerid, d_makeadmin, DIALOG_STYLE_LIST, header_string, "{"#cGRDialog"}Снять с должности Администратора\n{FFFFFF}1 уровень\n{FFFFFF}2 уровень\n{FFFFFF}3 уровень\n{FFFFFF}4 уровень\n{FFFFFF}5 уровень\n{FFFFFF}6 уровень\n{FFFFFF}7 уровень","Далее","Отмена");
	return true ;
}

CMD:blocked ( playerid, params [ ] )
{
    if ( admin_info [ playerid ] [ admin ] < 7 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данная команда не существует. Используйте {"#cRD"}/menu{"#cGRInfo"}, чтобы узнать список команд сервера." ) ;
	new pl_name [ MAX_PLAYER_NAME ], pl_id = INVALID_PLAYER_ID, pl_type, pl_status ;
	if ( sscanf ( params, "s[24]dd", pl_name, pl_type, pl_status ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /blocked [ид/имя] [лидерка - 0/админка - 1] [снять - 0/поставить - 1]" ) ;

	sscanf ( pl_name, "u", pl_id ) ;
	if ( IsPlayerConnected ( pl_id ) )
	{
		if ( pl_status == 0 )
		{
	    	if ( admin_info [ playerid ] [ admin ] < 8 && admin_info [ playerid ] [ dostup ] [ 5 ] != 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вам недоступно снятие блокировки." ) ;
			if ( pl_type == 0 )
			{
			    if ( ! p_info [ pl_id ] [ blocked_leader ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока нет блокировки на лидерский пост." ) ;

	            p_info [ pl_id ] [ blocked_leader ] = 0 ;
	            update_int_sql ( pl_id, "u_block_leader", 0 ) ;

	            new sql_string [ 128 ] ;
	            format ( sql_string, sizeof sql_string, "{"#cGInfo"}* {"#cWH"}Вы сняли {"#cGInfo"}%s {"#cWH"}лидерскую блокировку!", p_info [ pl_id ] [ name ] ) ;
	            SendClientMessage ( playerid, col_white, sql_string ) ;

	            sql_string [ 0 ] = EOS ;
				format ( sql_string, 128, "%s снял LEADER BLOCK %s", p_info [ playerid ] [ name ], p_info [ pl_id ] [ name ] ) ;
				WriteLog ( playerid, TYPE_LOG_ADMIN, sql_string ) ;
			}
			else if ( pl_type == 1 )
			{
			    if ( ! p_info [ pl_id ] [ blocked_adm ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока нет блокировки на пост администратора." ) ;

	            p_info [ pl_id ] [ blocked_adm ] = 0 ;
	            update_int_sql ( pl_id, "u_block_adm", 0 ) ;

	            new sql_string [ 128 ] ;
	            format ( sql_string, sizeof sql_string, "{"#cGInfo"}* {"#cWH"}Вы сняли {"#cGInfo"}%s {"#cWH"}админскую блокировку!", p_info [ pl_id ] [ name ] ) ;
	            SendClientMessage ( playerid, col_white, sql_string ) ;

	            sql_string [ 0 ] = EOS ;
				format ( sql_string, 128, "%s снял ADM BLOCK %s", p_info [ playerid ] [ name ], p_info [ pl_id ] [ name ] ) ;
				WriteLog ( playerid, TYPE_LOG_ADMIN, sql_string ) ;
			}
		}
		else if ( pl_status == 1 )
		{
			if ( pl_type == 0 )
			{
			    if ( p_info [ pl_id ] [ blocked_leader ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока есть блокировки на лидерский пост." ) ;

	            p_info [ pl_id ] [ blocked_leader ] = 255 ;
	            update_int_sql ( pl_id, "u_block_leader", 255 ) ;

	            new sql_string [ 128 ] ;
	            format ( sql_string, sizeof sql_string, "{"#cGInfo"}* {"#cWH"}Вы установили {"#cGInfo"}%s {"#cWH"}лидерскую блокировку!", p_info [ pl_id ] [ name ] ) ;
	            SendClientMessage ( playerid, col_white, sql_string ) ;

	            sql_string [ 0 ] = EOS ;
				format ( sql_string, 128, "%s выдал LEADER BLOCK %s", p_info [ playerid ] [ name ], p_info [ pl_id ] [ name ] ) ;
				WriteLog ( playerid, TYPE_LOG_ADMIN, sql_string ) ;
			}
			else if ( pl_type == 1 )
			{
			    if ( p_info [ pl_id ] [ blocked_adm ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока есть блокировки на пост администратора." ) ;

	            p_info [ pl_id ] [ blocked_adm ] = 255 ;
	            update_int_sql ( pl_id, "u_block_adm", 255 ) ;

	            new sql_string [ 128 ] ;
	            format ( sql_string, sizeof sql_string, "{"#cGInfo"}* {"#cWH"}Вы установили {"#cGInfo"}%s {"#cWH"}админскую блокировку!", p_info [ pl_id ] [ name ] ) ;
	            SendClientMessage ( playerid, col_white, sql_string ) ;

	            sql_string [ 0 ] = EOS ;
				format ( sql_string, 128, "%s выдал ADM BLOCK %s", p_info [ playerid ] [ name ], p_info [ pl_id ] [ name ] ) ;
				WriteLog ( playerid, TYPE_LOG_ADMIN, sql_string ) ;
			}
		}
	}
	else
	{
	    new sql_string [ 59 + MAX_PLAYER_NAME ] ;
	    format ( sql_string, sizeof sql_string, "SELECT `u_id` FROM `users` WHERE `u_name` = '%s' LIMIT 1", pl_name ) ;
	    mysql_tquery ( sql_connection, sql_string, "callback_blocked", "dsdd", playerid, pl_name, pl_type, pl_status ) ;
	}
	return 1 ;
}

callback: callback_blocked ( playerid, pl_name [ ], pl_type, pl_status )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;

	if ( rows )
	{
		if ( pl_status == 0 )
		{
	    	if ( admin_info [ playerid ] [ admin ] < 8 && admin_info [ playerid ] [ dostup ] [ 5 ] != 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вам недоступно снятие блокировки." ) ;
			if ( pl_type == 0 )
			{
	            new sql_string [ 128 ] ;
	            format ( sql_string, sizeof sql_string, "{"#cGInfo"}* {"#cWH"}Вы сняли {"#cGInfo"}%s {"#cWH"}лидерскую блокировку!", pl_name ) ;
	            SendClientMessage ( playerid, col_white, sql_string ) ;

			    format ( sql_string, sizeof sql_string, "UPDATE `users` SET `u_block_leader` = '0' WHERE `u_name` = '%s' LIMIT 1", pl_name ) ;
			    mysql_tquery ( sql_connection, sql_string ) ;

	            sql_string [ 0 ] = EOS ;
				format ( sql_string, 128, "%s снял LEADER BLOCK %s", p_info [ playerid ] [ name ], pl_name ) ;
				WriteLog ( playerid, TYPE_LOG_ADMIN, sql_string ) ;
			}
			else if ( pl_type == 1 )
			{
	            new sql_string [ 128 ] ;
	            format ( sql_string, sizeof sql_string, "{"#cGInfo"}* {"#cWH"}Вы сняли {"#cGInfo"}%s {"#cWH"}админскую блокировку!", pl_name ) ;
	            SendClientMessage ( playerid, col_white, sql_string ) ;

			    format ( sql_string, sizeof sql_string, "UPDATE `users` SET `u_block_adm` = '0' WHERE `u_name` = '%s' LIMIT 1", pl_name ) ;
			    mysql_tquery ( sql_connection, sql_string ) ;

	            sql_string [ 0 ] = EOS ;
				format ( sql_string, 128, "%s снял ADM BLOCK %s", p_info [ playerid ] [ name ], pl_name ) ;
				WriteLog ( playerid, TYPE_LOG_ADMIN, sql_string ) ;
			}
		}
		else if ( pl_status == 1 )
		{
			if ( pl_type == 0 )
			{
	            new sql_string [ 128 ] ;
	            format ( sql_string, sizeof sql_string, "{"#cGInfo"}* {"#cWH"}Вы установили {"#cGInfo"}%s {"#cWH"}лидерскую блокировку!", pl_name ) ;
	            SendClientMessage ( playerid, col_white, sql_string ) ;

			    format ( sql_string, sizeof sql_string, "UPDATE `users` SET `u_block_leader` = '255' WHERE `u_name` = '%s' LIMIT 1", pl_name ) ;
			    mysql_tquery ( sql_connection, sql_string ) ;

	            sql_string [ 0 ] = EOS ;
				format ( sql_string, 128, "%s выдал LEADER BLOCK %s", p_info [ playerid ] [ name ], pl_name ) ;
				WriteLog ( playerid, TYPE_LOG_ADMIN, sql_string ) ;
			}
			else if ( pl_type == 1 )
			{
	            new sql_string [ 128 ] ;
	            format ( sql_string, sizeof sql_string, "{"#cGInfo"}* {"#cWH"}Вы установили {"#cGInfo"}%s {"#cWH"}админскую блокировку!", pl_name ) ;
	            SendClientMessage ( playerid, col_white, sql_string ) ;

			    format ( sql_string, sizeof sql_string, "UPDATE `users` SET `u_block_adm` = '255' WHERE `u_name` = '%s' LIMIT 1", pl_name ) ;
			    mysql_tquery ( sql_connection, sql_string ) ;

	            sql_string [ 0 ] = EOS ;
				format ( sql_string, 128, "%s выдал ADM BLOCK %s", p_info [ playerid ] [ name ], pl_name ) ;
				WriteLog ( playerid, TYPE_LOG_ADMIN, sql_string ) ;
			}
		}
	}
	return 1 ;
}

CMD:ahelp ( playerid )
{
	if ( ! admin_info [ playerid ] [ admin ] )return 1 ;

	switch ( admin_info [ playerid ] [ admin ] )
	{
