		PlayerTextDrawBoxColor(playerid, training_ptd[playerid][1], color_box);
		PlayerTextDrawBackgroundColor(playerid, training_ptd[playerid][1], 255);
		PlayerTextDrawFont(playerid, training_ptd[playerid][1], 1);
		PlayerTextDrawSetProportional(playerid, training_ptd[playerid][1], 1);
		PlayerTextDrawSetShadow(playerid, training_ptd[playerid][1], 0);

		training_ptd[playerid][2] = CreatePlayerTextDraw(playerid, 102.3333, 226.9185, "East_Side_Ballas"); // 1 Box ( Right Gang )
		PlayerTextDrawLetterSize(playerid, training_ptd[playerid][2], 0.1748, 0.7578);
		PlayerTextDrawTextSize(playerid, training_ptd[playerid][2], 0.0000, 38.0000);
		PlayerTextDrawAlignment(playerid, training_ptd[playerid][2], 2);
		PlayerTextDrawColor(playerid, training_ptd[playerid][2], -1061109505);
		PlayerTextDrawUseBox(playerid, training_ptd[playerid][2], 1);
		PlayerTextDrawBoxColor(playerid, training_ptd[playerid][2], color_box);
		PlayerTextDrawBackgroundColor(playerid, training_ptd[playerid][2], 255);
		PlayerTextDrawFont(playerid, training_ptd[playerid][2], 1);
		PlayerTextDrawSetProportional(playerid, training_ptd[playerid][2], 1);
		PlayerTextDrawSetShadow(playerid, training_ptd[playerid][2], 0);

		training_ptd[playerid][3] = CreatePlayerTextDraw(playerid, 27.4342, 245.1704, "100"); // 1 Box ( Left Gang )
		PlayerTextDrawLetterSize(playerid, training_ptd[playerid][3], 0.1748, 0.7578);
		PlayerTextDrawTextSize(playerid, training_ptd[playerid][3], 0.0000, 14.0000);
		PlayerTextDrawAlignment(playerid, training_ptd[playerid][3], 2);
		PlayerTextDrawColor(playerid, training_ptd[playerid][3], -1);
		PlayerTextDrawUseBox(playerid, training_ptd[playerid][3], 1);
		PlayerTextDrawBoxColor(playerid, training_ptd[playerid][3], color_textdraw);
		PlayerTextDrawBackgroundColor(playerid, training_ptd[playerid][3], 255);
		PlayerTextDrawFont(playerid, training_ptd[playerid][3], 1);
		PlayerTextDrawSetProportional(playerid, training_ptd[playerid][3], 1);
		PlayerTextDrawSetShadow(playerid, training_ptd[playerid][3], 0);

		training_ptd[playerid][4] = CreatePlayerTextDraw(playerid, 114.6675, 245.2704, "100"); // 1 Box ( Right Gang )
		PlayerTextDrawLetterSize(playerid, training_ptd[playerid][4], 0.1748, 0.7578);
		PlayerTextDrawTextSize(playerid, training_ptd[playerid][4], 0.0000, 14.0000);
		PlayerTextDrawAlignment(playerid, training_ptd[playerid][4], 2);
		PlayerTextDrawColor(playerid, training_ptd[playerid][4], -1);
		PlayerTextDrawUseBox(playerid, training_ptd[playerid][4], 1);
		PlayerTextDrawBoxColor(playerid, training_ptd[playerid][4], color_textdraw);
		PlayerTextDrawBackgroundColor(playerid, training_ptd[playerid][4], 255);
		PlayerTextDrawFont(playerid, training_ptd[playerid][4], 1);
		PlayerTextDrawSetProportional(playerid, training_ptd[playerid][4], 1);
		PlayerTextDrawSetShadow(playerid, training_ptd[playerid][4], 0);

		new fraction_id = p_t_info [ playerid ] [ tr_enter ] ;
	    new team_id = p_t_info [ playerid ] [ tr_team ] - 1 ;

		new _string [ 64 ] ;
		format ( _string, sizeof _string, "%s", convert_time ( time_tr_team [ fraction_id ], TYPE_TIME_SECOND ) ) ;
		PlayerTextDrawSetString ( playerid, training_ptd [ playerid ] [ 0 ], _string ) ;

		if ( team_id == 0 )
		{
			PlayerTextDrawSetString ( playerid, training_ptd [ playerid ] [ 1 ], "YOU_TEAM" ) ;
			PlayerTextDrawSetString ( playerid, training_ptd [ playerid ] [ 2 ], "RIVAL" ) ;
		}
		else
		{
			PlayerTextDrawSetString ( playerid, training_ptd [ playerid ] [ 2 ], "YOU_TEAM" ) ;
			PlayerTextDrawSetString ( playerid, training_ptd [ playerid ] [ 1 ], "RIVAL" ) ;
		}

		format ( _string, sizeof _string, "%d", score_tr_team [ fraction_id ] [ 0 ] ) ;
		PlayerTextDrawSetString ( playerid, training_ptd [ playerid ] [ 3 ], _string ) ;

		format ( _string, sizeof _string, "%d", score_tr_team [ fraction_id ] [ 1 ] ) ;
		PlayerTextDrawSetString ( playerid, training_ptd [ playerid ] [ 4 ], _string ) ;

		if ( p_info [ playerid ] [ training_status ] > 1 )
		{
   			training_ptd[playerid][5] = CreatePlayerTextDraw(playerid, 30.1009, 276.4188, "4921"); // 2 Box ( Kills )
			PlayerTextDrawLetterSize(playerid, training_ptd[playerid][5], 0.1748, 0.7578);
			PlayerTextDrawTextSize(playerid, training_ptd[playerid][5], 0.0000, 20.0000);
			PlayerTextDrawAlignment(playerid, training_ptd[playerid][5], 2);
			PlayerTextDrawColor(playerid, training_ptd[playerid][5], -1);
			PlayerTextDrawUseBox(playerid, training_ptd[playerid][5], 1);
			PlayerTextDrawBoxColor(playerid, training_ptd[playerid][5], color_textdraw);
			PlayerTextDrawBackgroundColor(playerid, training_ptd[playerid][5], 255);
			PlayerTextDrawFont(playerid, training_ptd[playerid][5], 1);
			PlayerTextDrawSetProportional(playerid, training_ptd[playerid][5], 1);
			PlayerTextDrawSetShadow(playerid, training_ptd[playerid][5], 0);

			training_ptd[playerid][6] = CreatePlayerTextDraw(playerid, 111.4676, 276.4188, "4921"); // 2 Box ( Deaths )
			PlayerTextDrawLetterSize(playerid, training_ptd[playerid][6], 0.1748, 0.7578);
			PlayerTextDrawTextSize(playerid, training_ptd[playerid][6], 0.0000, 20.0000);
			PlayerTextDrawAlignment(playerid, training_ptd[playerid][6], 2);
			PlayerTextDrawColor(playerid, training_ptd[playerid][6], -1);
			PlayerTextDrawUseBox(playerid, training_ptd[playerid][6], 1);
			PlayerTextDrawBoxColor(playerid, training_ptd[playerid][6], color_textdraw);
			PlayerTextDrawBackgroundColor(playerid, training_ptd[playerid][6], 255);
			PlayerTextDrawFont(playerid, training_ptd[playerid][6], 1);
			PlayerTextDrawSetProportional(playerid, training_ptd[playerid][6], 1);
			PlayerTextDrawSetShadow(playerid, training_ptd[playerid][6], 0);

			training_ptd[playerid][7] = CreatePlayerTextDraw(playerid, 71.0336, 276.5723, "KD:_1.00"); // 2 Box ( K/D Ratio )
			PlayerTextDrawLetterSize(playerid, training_ptd[playerid][7], 0.1748, 0.7578);
			PlayerTextDrawTextSize(playerid, training_ptd[playerid][7], 0.0000, 14.0000);
			PlayerTextDrawAlignment(playerid, training_ptd[playerid][7], 2);
			PlayerTextDrawColor(playerid, training_ptd[playerid][7], -1);
			PlayerTextDrawBackgroundColor(playerid, training_ptd[playerid][7], 255);
			PlayerTextDrawFont(playerid, training_ptd[playerid][7], 1);
			PlayerTextDrawSetProportional(playerid, training_ptd[playerid][7], 1);
			PlayerTextDrawSetShadow(playerid, training_ptd[playerid][7], 0);

			format ( _string, sizeof _string, "%d", p_info [ playerid ] [ training_kills ] ) ;
			PlayerTextDrawSetString ( playerid, training_ptd [ playerid ] [ 5 ], _string ) ;

			format ( _string, sizeof _string, "%.2f", p_info [ playerid ] [ training_damage ] ) ;
			PlayerTextDrawSetString ( playerid, training_ptd [ playerid ] [ 6 ], _string ) ;

			if ( ! p_info [ playerid ] [ training_kills ] || ! p_info [ playerid ] [ training_death ] ) format ( _string, sizeof _string, "K/D:_0.00" ) ;
			else format ( _string, sizeof _string, "K/D:_%.2f", floatdiv ( p_info [ playerid ] [ training_kills ], p_info [ playerid ] [ training_death ] ) ) ;
			PlayerTextDrawSetString ( playerid, training_ptd [ playerid ] [ 7 ], _string ) ;
		}

        if ( p_info [ playerid ] [ training_status ] > 2 )
		{
   			training_ptd[playerid][8] = CreatePlayerTextDraw(playerid, 15.8332, 308.2572, "PLAYER_1"); // 3 Box ( Left Player )
			PlayerTextDrawLetterSize(playerid, training_ptd[playerid][8], 0.1636, 0.7869);
			PlayerTextDrawAlignment(playerid, training_ptd[playerid][8], 1);
			PlayerTextDrawColor(playerid, training_ptd[playerid][8], -1061109505);
			PlayerTextDrawBackgroundColor(playerid, training_ptd[playerid][8], 49);
			PlayerTextDrawFont(playerid, training_ptd[playerid][8], 1);
			PlayerTextDrawSetProportional(playerid, training_ptd[playerid][8], 1);
			PlayerTextDrawSetShadow(playerid, training_ptd[playerid][8], 1);

			training_ptd[playerid][9] = CreatePlayerTextDraw(playerid, 127.0330, 308.2573, "PLAYER_2"); // 3 Box ( Right Player )
			PlayerTextDrawLetterSize(playerid, training_ptd[playerid][9], 0.1636, 0.7869);
			PlayerTextDrawAlignment(playerid, training_ptd[playerid][9], 3);
			PlayerTextDrawColor(playerid, training_ptd[playerid][9], -1061109505);
			PlayerTextDrawBackgroundColor(playerid, training_ptd[playerid][9], 49);
			PlayerTextDrawFont(playerid, training_ptd[playerid][9], 1);
			PlayerTextDrawSetProportional(playerid, training_ptd[playerid][9], 1);
			PlayerTextDrawSetShadow(playerid, training_ptd[playerid][9], 1);

			format ( _string, sizeof _string, "%s", training_kills_first_name ) ;
			PlayerTextDrawSetString ( playerid, training_ptd [ playerid ] [ 8 ], _string ) ;

			format ( _string, sizeof _string, "%s", training_kills_two_name ) ;
			PlayerTextDrawSetString ( playerid, training_ptd [ playerid ] [ 9 ], _string ) ;
		}

		for ( new i = 0 ; i < 38 ; i ++ )
		{
		    if ( p_info [ playerid ] [ training_status ] == 2 )
		    {
		        if ( i < 32 ) TextDrawShowForPlayer ( playerid, training_td [ i ] ) ;
		        if ( i < 8 ) PlayerTextDrawShow ( playerid, training_ptd [ playerid ] [ i ] ) ;
		    }
		    else if ( p_info [ playerid ] [ training_status ] == 3 )
		    {
		        TextDrawShowForPlayer ( playerid, training_td [ i ] ) ;
		        if ( i < 10 ) PlayerTextDrawShow ( playerid, training_ptd [ playerid ] [ i ] ) ;
		    }
		    else
		    {
		        if ( i < 26 ) TextDrawShowForPlayer ( playerid, training_td [ i ] ) ;
		        if ( i < 5 ) PlayerTextDrawShow ( playerid, training_ptd [ playerid ] [ i ] ) ;
		    }
		}
	}
	else
	{
	    for ( new i = 0 ; i < 38 ; i ++ )
		{
		    if ( p_info [ playerid ] [ training_status ] == 2 )
		    {
		        if ( i < 32 ) TextDrawHideForPlayer ( playerid, training_td [ i ] ) ;
		        if ( i < 8 )
			    {
					PlayerTextDrawDestroy ( playerid, training_ptd [ playerid ] [ i ] ) ;
					training_ptd [ playerid ] [ i ] = PlayerText:-1;
				}
		    }
		    else if ( p_info [ playerid ] [ training_status ] == 3 )
		    {
		        TextDrawHideForPlayer ( playerid, training_td [ i ] ) ;
		        if ( i < 10 )
			    {
					PlayerTextDrawDestroy ( playerid, training_ptd [ playerid ] [ i ] ) ;
					training_ptd [ playerid ] [ i ] = PlayerText:-1;
				}
		    }
		    else
		    {
		        if ( i < 26 ) TextDrawHideForPlayer ( playerid, training_td [ i ] ) ;
		        if ( i < 5 )
			    {
					PlayerTextDrawDestroy ( playerid, training_ptd [ playerid ] [ i ] ) ;
					training_ptd [ playerid ] [ i ] = PlayerText:-1;
				}
		    }
		}
	}
	return 1 ;
}

callback: trening_timer ( _teams_id )
{
	foreach(new pl_id: logged_players)
	{
		if ( ! p_t_info [ pl_id ] [ tr_enter ] && tr_td_status_bool [ pl_id ] == true )
		{
			tr_td_status ( pl_id, false ) ;
			tr_td_status_bool [ pl_id ] = false ;

			for ( new j = 0 ; j < 5 ; j ++ ) SendDeathMessageToPlayer ( pl_id, 1001, 1001, 200 ) ;
		}
		else if ( p_t_info [ pl_id ] [ tr_enter ] == _teams_id && tr_td_status_bool [ pl_id ] == false )
		{
		    p_info [ pl_id ] [ training_kills ] =
		    p_info [ pl_id ] [ training_death ] = 0 ;
		    p_info [ pl_id ] [ training_damage ] = 0.0 ;

   			tr_td_status ( pl_id, true ) ;
			tr_td_status_bool [ pl_id ] = true ;
		}

		if ( p_t_info [ pl_id ] [ tr_enter ] == _teams_id && tr_td_status_bool [ pl_id ] == true )
		{
			if ( time_tr_team [ _teams_id ] >= 1 )
			{
		        new td_string [ 24 ] ;
				format ( td_string, sizeof ( td_string ), "%s", convert_time ( time_tr_team [ _teams_id ], TYPE_TIME_SECOND ) ) ;
				PlayerTextDrawSetString ( pl_id, training_ptd [ pl_id ] [ 0 ], td_string ) ;
			}
		}
	}
	if ( time_tr_team [ _teams_id ] > 1 )
	{
		time_tr_team [ _teams_id ] -- ;
		if ( time_tr_team [ _teams_id ] == 1 )
		{
			foreach(new i: logged_players)
			{
				if ( tr_td_status_bool [ i ] == true && p_t_info [ i ] [ tr_enter ] == _teams_id )
				{
					tr_td_status ( i, false ) ;
					tr_td_status_bool [ i ] = false ;

					reset_player_weapon ( i ) ;

					GameTextForPlayer ( i, "~r~~h~STOP", 2000, 4 ) ;

					p_info [ i ] [ training_death ] =
			    	p_info [ i ] [ training_kills ] = 0 ;
			    	p_info [ i ] [ training_damage ] = 0.0 ;

					for ( new j = 0 ; j < 5 ; j ++ ) SendDeathMessageToPlayer ( i, 1001, 1001, 200 ) ;
				}
			}

			KillTimer ( tren_timer [ _teams_id ] ) ;
	        tren_timer [ _teams_id ] = -1 ;
			time_tr_team [ _teams_id ] = 0 ;
		}
	}
	return 1 ;
}

CMD:trmembers ( playerid )
{
    if ( ! p_t_info [ playerid ] [ tr_team ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не участник тренировки." ) ;

	new afk = 0, full = 0 ;

	global_string [ 0 ] = EOS ;
	new line_string [ 128 ] ;

	strcat(global_string, "{"#cLY"}ID\tУровень\tТелефон\t\tИмя игрока\n\n");
	foreach(new i: logged_players)
	{
		if ( p_t_info [ playerid ] [ tr_team ] == p_t_info [ i ] [ tr_team ] )
		{
			new text [ 32 ] ;
		    if ( pl_afk_time [ i ] > 2 ) afk ++ ;
			if ( p_info [ i ] [ number ] <= 1 ) format ( text, sizeof ( text ), "None\t\t" ) ;
			else format ( text, sizeof ( text ), "%i\t\t", p_info [ i ] [ number ] ) ;
			format ( line_string, sizeof line_string, "{"#cWH"}%i\t%i\t\t%s\t%s %s\n", i, p_info [ i ] [ level ], text, p_info [ i ] [ name ], ( p_info [ i ] [ warblock ] == 0 ) ? ( "" ) : ( "{"#cGRDialog"}* WAR BLOCK" ) ) ;
			strcat ( global_string, line_string ) ;

			full++;
		}
	}
	format ( line_string, sizeof line_string, "\n{FFFFFF}Члены тренировки в AFK: {"#cLY"}%i{"#cWH"} человек(а)", afk);
	strcat ( global_string, line_string ) ;

	format ( line_string, sizeof line_string, "\n{FFFFFF}В игре членов тренировки: {"#cLY"}%i{"#cWH"} человек(а)", full);
	strcat ( global_string, line_string ) ;

	show_dialog(playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Члены тренировки", global_string, "Закрыть", "");
	return 1 ;
}

stock show_training_menu ( playerid )
{
	global_string [ 0 ] = EOS ;
	new f = p_info [ playerid ] [ member ] ;

	static const cards_name [ max_maps ] [ 32 ] =
	{
		"Военный полигон",
		"Заброшенный город"
	} ;

	format ( global_string, sizeof ( global_string ), "{"#cGRDialog"}- {"#cWH"}Тренировка {"#cGRDialog"}(%s{"#cGRDialog"})\n\
														{"#cGRDialog"}- {"#cWH"}Площадка {"#cGRDialog"}(%s{"#cGRDialog"})\n\
														{"#cGRDialog"}- {"#cWH"}Карта {"#cGRDialog"}({"#cGN"}%s{"#cGRDialog"})\n\
														{"#cGRDialog"}- {"#cWH"}Доступ к тренировке\n\
														{"#cGRDialog"}- {"#cWH"}Оружие\n\
														{"#cGRDialog"}- {"#cWH"}Настройка спавна\n\
														{"#cGRDialog"}- {"#cWH"}Настройка одежды\n\
														{"#cGRDialog"}- {"#cWH"}HP при спавне {"#cGRDialog"}({"#cGN"}%d {"#cGRDialog"}HP)",
	( f_info [ f - 1 ] [ f_tr_status ] == 1 ) ? ( "{"#cGN"}Активна{"#cWH"}" ) : ( "{"#cRD"}Неактивна{"#cWH"}" ),
	( f_info [ f - 1 ] [ f_tr_status_map ] == 1 ) ? ( "{"#cGN"}Открыта{"#cWH"}" ) : ( "{"#cRD"}Закрыта{"#cWH"}" ),
	cards_name [ f_info [ f - 1 ] [ f_tr_map ] - 1 ], f_info [ f - 1 ] [ f_tr_health ] ) ;

	show_dialog ( playerid, d_tr_menu, DIALOG_STYLE_LIST, "{"#cBHD"}Тренировочный комплекс", global_string, "Выбрать", "Назад" ) ;
	return 1 ;
}

stock show_fraction_training ( playerid, fractionid )
{
	global_string [ 0 ] = EOS ;

	new line_string [ 32 + 4 + 32 + 24 ], step = 0 ;
	for ( new i = 0 ; i < max_fraction - 1 ; i ++ )
	{
		if ( fractionid - 1 == i ) continue ;

		set_player_listitem_values ( playerid, step, i ) ;

		step ++ ;

		format ( line_string, sizeof line_string, "{"#cBL"}%i. {"#cWH"}%s (%s)\n", i + 1, f_info [ i ] [ f_name ], ( f_info [ fractionid - 1 ] [ f_tr_dostup ] [ i ] == 1 ) ? ( "{"#cGN"}Открыт{"#cWH"}" ) : ( "{"#cRD"}Закрыт{"#cWH"}" ) );
		strcat ( global_string, line_string ) ;
	}
	show_dialog ( playerid, d_tr_fraction, DIALOG_STYLE_LIST, "{"#cBHD"}Доступ к тренировке", global_string, "Выбрать", "Назад" ) ;
	return 1 ;
}

stock show_map_training ( playerid, fractionid )
{
	global_string [ 0 ] = EOS ;
	new line_string [ 128 ] ;

	static const cards_name [ max_maps ] [ 24 ] =
	{
		"Военный полигон",
		"Заброшенный город"
	} ;

	for ( new i = 0 ; i < max_maps ; i ++ )
	{
		format ( line_string, sizeof line_string, "{"#cBL"}%i. {"#cWH"}%s %s\n", i + 1, cards_name [ i ], ( i == f_info [ fractionid - 1 ] [ f_tr_map ] - 1 ) ? ( "{"#cGRDialog"}* Карта уже выбрана" ) : ( "" ) ) ;
		strcat ( global_string, line_string ) ;
	}
	show_dialog ( playerid, d_tr_map, DIALOG_STYLE_LIST, "{"#cBHD"}Выбор карты", global_string, "Выбрать", "Назад" ) ;
	return 1 ;
}

stock show_guns_training ( playerid, fractionid )
{
	global_string [ 0 ] = EOS ;
	new line_string [ 128 ] ;

	for ( new i = 0 ; i < 12 ; i ++ )
	{
	    new gun_name[ 32 ] ;
		GetWeaponName ( f_info [ fractionid - 1 ] [ f_tr_gun ] [ i ], gun_name, 32 ) ;

		format ( line_string, sizeof line_string, "{"#cBL"}%i. {"#cWH"}%s {"#cGRDialog"}(Патроны: {"#cWH"}%d{"#cGRDialog"})\n", i + 1, gun_name, f_info [ fractionid - 1 ] [ f_tr_ammo ] [ i ] ) ;
		strcat ( global_string, line_string ) ;
	}
	show_dialog ( playerid, d_tr_guns, DIALOG_STYLE_LIST, "{"#cBHD"}Выбор оружия", global_string, "Выбрать", "Назад" ) ;
	return 1 ;
}

CMD:giveleader ( playerid, params [ ] )
{
	if ( ! gov_player ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команда доступна только для сотрудников правительства." ) ;
	if ( p_info [ playerid ] [ rank ] != f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 6 ] &&
		p_info [ playerid ] [ rank ] != f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 7 ] &&
		p_info [ playerid ] [ rank ] != f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 8 ] &&
		p_info [ playerid ] [ rank ] != f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 12 ] )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команда доступна только для министров." ) ;
	if ( sscanf ( params, "u", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /giveleader [ид/имя]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( params [ 0 ] == playerid) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете применить к самому себе." ) ;
    if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;

	if ( p_info [ playerid ] [ rank ] == f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 6 ] )
	{
		global_string [ 0 ] = EOS ;
		new line_string [ 64 ] ;
		new row_count ;
		for ( new j = 14 ; j < 14 + 3 ; j ++ )
		{
			set_player_listitem_values ( playerid, row_count, j ) ;
		    row_count ++ ;

			format ( line_string, 64, "{%s}%s\n", f_info [ j ] [ f_chat_color ], f_info [ j ] [ f_name ] ) ;
			strcat ( global_string, line_string ) ;
		}
		strcat ( global_string, "{"#cWH"}Снять полномочия" ) ;
		set_player_use_page ( playerid, row_count, 0 ) ;

		show_dialog ( playerid, d_giveleader, DIALOG_STYLE_LIST, "{"#cBHD"}Назначение руководителя", global_string, "Выбрать", "Закрыть" ) ;
	}
	if ( p_info [ playerid ] [ rank ] == f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 7 ] )
	{
		global_string [ 0 ] = EOS ;
		new line_string [ 64 ] ;
		new row_count ;
		for ( new j = 3 ; j < 3 + 4 ; j ++ )
		{
		    set_player_listitem_values ( playerid, row_count, j ) ;
		    row_count ++ ;

			format ( line_string, 64, "{%s}%s\n", f_info [ j ] [ f_chat_color ], f_info [ j ] [ f_name ] ) ;
			strcat ( global_string, line_string ) ;
		}
		strcat ( global_string, "{"#cWH"}Снять полномочия" ) ;
		set_player_use_page ( playerid, row_count, 0 ) ;

		show_dialog ( playerid, d_giveleader, DIALOG_STYLE_LIST, "{"#cBHD"}Назначение руководителя", global_string, "Выбрать", "Закрыть" ) ;
	}
	if ( p_info [ playerid ] [ rank ] == f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 8 ] )
	{
		global_string [ 0 ] = EOS ;
		new line_string [ 64 ] ;
		new row_count ;
		for ( new j = 7 ; j < 7 + 2 ; j ++ )
		{
		    set_player_listitem_values ( playerid, row_count, j ) ;
		    row_count ++ ;

			format ( line_string, 64, "{%s}%s\n", f_info [ j ] [ f_chat_color ], f_info [ j ] [ f_name ] ) ;
			strcat ( global_string, line_string ) ;
		}
		strcat ( global_string, "{"#cWH"}Снять полномочия" ) ;
		set_player_use_page ( playerid, row_count, 0 ) ;

		show_dialog ( playerid, d_giveleader, DIALOG_STYLE_LIST, "{"#cBHD"}Назначение руководителя", global_string, "Выбрать", "Закрыть" ) ;
	}
	if ( p_info [ playerid ] [ rank ] == f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 9 ] )
	{
		global_string [ 0 ] = EOS ;
		new line_string [ 64 ] ;
		new row_count ;
		for ( new j = 0 ; j < 3 ; j ++ )
		{
		    set_player_listitem_values ( playerid, row_count, j ) ;
		    row_count ++ ;

			format ( line_string, 64, "{%s}%s\n", f_info [ j ] [ f_chat_color ], f_info [ j ] [ f_name ] ) ;
			strcat ( global_string, line_string ) ;
		}
		strcat ( global_string, "{"#cWH"}Снять полномочия" ) ;
		set_player_use_page ( playerid, row_count, 0 ) ;

		show_dialog ( playerid, d_giveleader, DIALOG_STYLE_LIST, "{"#cBHD"}Назначение руководителя", global_string, "Выбрать", "Закрыть" ) ;
	}
	SetPVarInt ( playerid, "pl_giveleader_id", params [ 0 ] ) ;
	return 1 ;
}
