			    									{"#cRD"}* На счету бизнеса не достаточно средств.\n\n\
													{"#cWH"}Приостановления работы бизнеса.\n\n\
													{"#cGRDialog"}* Доступных дней: {"#cBL"}%d\n\
													{"#cGRDialog"}* Стоимость дня: {"#cGN"}%d"valute_title_"\n\n\
													{"#cGRDialog"}* Укажите количество дней, на которые Вы хотите заморозить бизнес:", b_info [ b ] [ b_freeze_day ], price_fd ) ;
				show_dialog ( playerid, d_b_panel_freeze_set, DIALOG_STYLE_INPUT, "{"#cBHD"}Заморозка", dialog_string, "Выбрать", "Назад" ) ;
			    return 1 ;
			}

			new scm_string [ 144 ] ;
			format ( scm_string, sizeof scm_string, "{"#cGInfo"}* {"#cWH"}Вы успешно заморозили {"#cGN"}%s {"#cWH"}на {"#cGN"}%d {"#cWH"}дн. за {"#cGN"}%d"valute_title"{"#cWH"}.", b_types [ b_info [ b ] [ b_type ] ], _value, _value * price_fd ) ;
			SendClientMessage ( playerid, col_white, scm_string ) ;

			b_info [ b ] [ b_money ] -= _value * price_fd ;
			b_info [ b ] [ b_freeze_day ] -= _value ;
			b_info [ b ] [ b_freeze ] += _value ;
			b_info [ b ] [ b_freeze_date ] = gettime ( ) ;

			new rcon_string [ 120 + 4 + 4 + 9 + 9 ] ;
	        format ( rcon_string, sizeof rcon_string, "UPDATE `businesses` SET `b_freeze` = '%d', `b_freeze_day` = '%d', `b_freeze_date` = '%d' WHERE `b_id` = '%d' LIMIT 1", b_info [ b ] [ b_freeze ], b_info [ b ] [ b_freeze_day ], b_info [ b ] [ b_freeze_date ], b_info [ b ] [ b_id ] ) ;
			mysql_tquery ( sql_connection, rcon_string ) ;

			business_freeze ( playerid ) ;
			return 1 ;
		}
