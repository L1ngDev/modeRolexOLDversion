	        switch ( listitem )
	        {
				case 0: show_window_tireshop ( playerid ) ;
	            case 1: show_window_tuning ( playerid ) ;
	            case 2: show_remove_millage ( playerid ) ;
				case 3: showComponentShop ( playerid ) ;
				case 4: ShowPlayerTechCenter ( playerid ) ;
	        }
	        return 1 ;
	    }
	    case d_contract_select:
	    {
