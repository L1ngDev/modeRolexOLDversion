		case 3: show_dialog ( playerid, d_ahelp, DIALOG_STYLE_LIST, "{"#cBHD"}Команды администрации", "{"#cGRDialog"}- {"#cWH"}Команды администратора 1 уровня\n{"#cGRDialog"}- {"#cWH"}Команды администратора 2 уровня\n{"#cGRDialog"}- {"#cWH"}Команды администратора 3 уровня", "Выбрать", "Закрыть" ) ;
		case 4: show_dialog ( playerid, d_ahelp, DIALOG_STYLE_LIST, "{"#cBHD"}Команды администрации", "{"#cGRDialog"}- {"#cWH"}Команды администратора 1 уровня\n{"#cGRDialog"}- {"#cWH"}Команды администратора 2 уровня\n{"#cGRDialog"}- {"#cWH"}Команды администратора 3 уровня\n{"#cGRDialog"}- {"#cWH"}Команды администратора 4 уровня", "Выбрать", "Закрыть" ) ;
		case 5: show_dialog ( playerid, d_ahelp, DIALOG_STYLE_LIST, "{"#cBHD"}Команды администрации", "{"#cGRDialog"}- {"#cWH"}Команды администратора 1 уровня\n{"#cGRDialog"}- {"#cWH"}Команды администратора 2 уровня\n{"#cGRDialog"}- {"#cWH"}Команды администратора 3 уровня\n{"#cGRDialog"}- {"#cWH"}Команды администратора 4 уровня\n{"#cGRDialog"}- {"#cWH"}Команды администратора 5 уровня", "Выбрать", "Закрыть" ) ;
		case 6: show_dialog ( playerid, d_ahelp, DIALOG_STYLE_LIST, "{"#cBHD"}Команды администрации", "{"#cGRDialog"}- {"#cWH"}Команды администратора 1 уровня\n{"#cGRDialog"}- {"#cWH"}Команды администратора 2 уровня\n{"#cGRDialog"}- {"#cWH"}Команды администратора 3 уровня\n{"#cGRDialog"}- {"#cWH"}Команды администратора 4 уровня\n{"#cGRDialog"}- {"#cWH"}Команды администратора 5 уровня\n{"#cGRDialog"}- {"#cWH"}Команды администратора 6 уровня", "Выбрать", "Закрыть" ) ;
		case 7: show_dialog ( playerid, d_ahelp, DIALOG_STYLE_LIST, "{"#cBHD"}Команды администрации", "{"#cGRDialog"}- {"#cWH"}Команды администратора 1 уровня\n{"#cGRDialog"}- {"#cWH"}Команды администратора 2 уровня\n{"#cGRDialog"}- {"#cWH"}Команды администратора 3 уровня\n{"#cGRDialog"}- {"#cWH"}Команды администратора 4 уровня\n{"#cGRDialog"}- {"#cWH"}Команды администратора 5 уровня\n{"#cGRDialog"}- {"#cWH"}Команды администратора 6 уровня\n{"#cGRDialog"}- {"#cWH"}Команды администратора 7 уровня", "Выбрать", "Закрыть" ) ;
		case 8: show_dialog ( playerid, d_ahelp, DIALOG_STYLE_LIST, "{"#cBHD"}Команды администрации", "{"#cGRDialog"}- {"#cWH"}Команды администратора 1 уровня\n{"#cGRDialog"}- {"#cWH"}Команды администратора 2 уровня\n{"#cGRDialog"}- {"#cWH"}Команды администратора 3 уровня\n{"#cGRDialog"}- {"#cWH"}Команды администратора 4 уровня\n{"#cGRDialog"}- {"#cWH"}Команды администратора 5 уровня\n{"#cGRDialog"}- {"#cWH"}Команды администратора 6 уровня\n{"#cGRDialog"}- {"#cWH"}Команды администратора 7 уровня\n{"#cGRDialog"}- {"#cWH"}Команды администратора 8 уровня\n{"#cGRDialog"}- {"#cWH"}Команды администратора 8 уровня", "Выбрать", "Закрыть" ) ;
	}
	return 1 ;
}

CMD:saveall ( playerid )
{
	if ( admin_info [ playerid ] [ admin ] != 8 )return 1 ;

	save_all ( ) ;

	new scm_string [ 76 + MAX_PLAYER_NAME ];
	format ( scm_string, sizeof ( scm_string  ), "{"#cBAdmin"}[A] {"#cGRAdmin"}Администратор %s сохранил всю информацию сервера.", p_info [ playerid ] [ name ] ) ;
	foreach(new i: admin_players) SendClientMessage ( i, col_admin, scm_string ) ;
	return 1 ;
}

stock save_all ( )
{
	new _sql_string [ 400 ], _b_count = 0 ;
	for ( new t = 0 ; t < b_count ; t ++ )
	{
	    if ( b_info [ t ] [ b_meeting ] > gettime ( ) ) _b_count ++ ;

	    if ( b_info [ t ] [ b_improve ] [ 3 ] == 1 )
		{
		    #if defined SERVER_BONUS
		        if ( b_info [ t ] [ b_product ] < 5000 ) b_info [ t ] [ b_product ] += 2500 ;
			#endif
		}

		if ( b_info [ t ] [ b_close ] )
		{
			b_info [ t ] [ b_close ] = 0 ;
			update_blabel ( t ) ;
		}

		new _donate_price = b_info [ t ] [ b_donate_price ] ;
		if ( _donate_price > 0 && _donate_price < 1500 ) give_bmoney ( t + 1, random ( 700000 ) + 300000, 0 ) ;
		else if ( _donate_price > 1499 && _donate_price < 3000 ) give_bmoney ( t + 1, random ( 800000 ) + 300000, 0 ) ;
		else if ( _donate_price > 2999 ) give_bmoney ( t + 1, random ( 1000000 ) + 300000, 0 ) ;
		else
		{
		    #if defined SERVER_BONUS
			new _b_type = b_info [ t ] [ b_type ] ;
        	if ( _b_type == bizz_type_electric ) give_bmoney ( t + 1, random ( 500000 ) + 100000, 0 ) ;
        	else if ( _b_type == bizz_type_lake || _b_type == bizz_type_reserve ) give_bmoney ( t + 1, random ( 300000 ) + 100000, 0 ) ;
        	else if ( _b_type == bizz_type_hotel ) give_bmoney ( t + 1, random ( 300000 ) + 100000, 0 ) ;
			#endif
		}

		format ( _sql_string, sizeof _sql_string, "UPDATE `businesses` SET `b_product` = '%d',`b_cost` = '%d', `b_money` = '%d',\
													`b_win_prise` = '%d', `b_cash_today` = '%d', `b_visitors` = '%d', `b_close` = '%d' WHERE `b_id` = '%d' LIMIT 1",
		b_info [ t ] [ b_product ], b_info [ t ] [ b_cost ], b_info [ t ] [ b_money ], b_info [ t ] [ b_win_prise ],
		b_info [ t ] [ b_cash_today ], b_info [ t ] [ b_visitors ], b_info [ t ] [ b_close ], b_info [ t ] [ b_id ] ) ;
		mysql_tquery ( sql_connection, _sql_string ) ;
	}

	new _h_count = 0 ;
	for ( new h = 0 ; h < house_count ; h ++ )
	{
	    if ( h_info [ h ] [ h_meeting ] > gettime ( ) ) _h_count ++ ;

		format ( _sql_string, sizeof _sql_string, "UPDATE `houses` SET `h_prods` = '%d', `h_seed` = '%d', `h_seed_result` = '%d',\
													`h_safe_data` = '%d|%d|%d|%d|%d|%d|%d|%d', `h_heal` = '%d' WHERE `h_id` = '%d' LIMIT 1",
		h_info [ h ] [ h_prods ], h_info [ h ] [ h_seed ], h_info [ h ] [ h_seed_result ], h_info [ h ] [ h_safe_data ] [ 0 ], h_info [ h ] [ h_safe_data ] [ 1 ],
		h_info [ h ] [ h_safe_guns ] [ 0 ],	h_info [ h ] [ h_safe_guns ] [ 1 ], h_info [ h ] [ h_safe_guns ] [ 2 ],
		h_info [ h ] [ h_safe_guns ] [ 3 ],	h_info [ h ] [ h_safe_guns ] [ 4 ], h_info [ h ] [ h_safe_guns ] [ 5 ], h_info [ h ] [ h_heal ], h_info [ h ] [ h_id ] ) ;
		mysql_tquery ( sql_connection, _sql_string ) ;
	}

	if ( _b_count > 0 || _h_count > 0 ) SendClientMessageToAll ( col_yellow, !"* Есть свободное имущество. Используйте /meeting для уточнения даты слёта." ) ;

	for ( new j = 0 ; j < fraction_count ; j ++ )
	{
		format ( _sql_string, 146, "UPDATE `fractions` SET `f_money` = '%d' WHERE `f_id` = '%d' LIMIT 1",
		f_info [ j ] [ f_money ], j + 1 ) ;
		mysql_tquery ( sql_connection, _sql_string, "", "" ) ;

		format ( _sql_string, 176, "UPDATE `fractions` SET `f_money_statistic` = '%d|%d|%d|%d|%d',`f_money_statistic_minus`='%d|%d|%d|%d|%d' WHERE `f_id` = '%d' LIMIT 1",
		f_info [ j ] [ f_money_statistic ] [ 0 ], f_info [ j ] [ f_money_statistic ] [ 1 ], f_info [ j ] [ f_money_statistic ] [ 2 ], f_info [ j ] [ f_money_statistic ] [ 3 ], f_info [ j ] [ f_money_statistic ] [ 4 ],
	    f_info [ j ] [ f_money_statistic_minus ] [ 0 ], f_info [ j ] [ f_money_statistic_minus ] [ 1 ], f_info [ j ] [ f_money_statistic_minus ] [ 2 ], f_info [ j ] [ f_money_statistic_minus ] [ 3 ], f_info [ j ] [ f_money_statistic_minus ] [ 4 ],
		j + 1 ) ;
		mysql_tquery ( sql_connection, _sql_string, "", "" ) ;
	}

	for ( new family_id = 0 ; family_id < family_count ; family_id ++ )
    {
		mysql_format ( sql_connection, _sql_string, sizeof _sql_string, "UPDATE `family` SET `fam_ticket` = '%d', `fam_bank` = '%d', `fam_rating` = '%d' WHERE `fam_id` = '%d' LIMIT 1", family_info [ family_id ] [ fam_ticket ], family_info [ family_id ] [ fam_bank ], family_info [ family_id ] [ fam_rating ], family_info [ family_id ] [ fam_id ] ) ;
       	mysql_tquery ( sql_connection, _sql_string ) ;
	}

	format ( _sql_string, 112, "UPDATE `server_variables` SET `var_count` = '%d' WHERE `var_id` = '1' LIMIT 1", dorm_count [ DORM_SAWMILL ] ) ;
	mysql_tquery ( sql_connection, _sql_string ) ;

	format ( _sql_string, 112, "UPDATE `server_variables` SET `var_count` = '%d' WHERE `var_id` = '2' LIMIT 1", dorm_count [ DORM_MINE ] ) ;
	mysql_tquery ( sql_connection, _sql_string ) ;

	format ( _sql_string, 112, "UPDATE `server_variables` SET `var_count` = '%d' WHERE `var_id` = '3' LIMIT 1", dorm_count [ DORM_FACTORY_GUNS ] ) ;
	mysql_tquery ( sql_connection, _sql_string ) ;

	format ( _sql_string, 112, "UPDATE `server_variables` SET `var_count` = '%d' WHERE `var_id` = '4' LIMIT 1", mine_count [ MINE_MELTED ] ) ;
	mysql_tquery ( sql_connection, _sql_string ) ;

	format ( _sql_string, 112, "UPDATE `server_variables` SET `var_count` = '%d' WHERE `var_id` = '5' LIMIT 1", mine_count [ MINE_UNMELTED ] ) ;
	mysql_tquery ( sql_connection, _sql_string ) ;

	format ( _sql_string, 112, "UPDATE `server_variables` SET `var_count` = '%d' WHERE `var_id` = '6' LIMIT 1", dorm_count [ DORM_FACTORY_MINE ] ) ;
	mysql_tquery ( sql_connection, _sql_string ) ;

	format ( _sql_string, 112, "UPDATE `server_variables` SET `var_count` = '%d' WHERE `var_id` = '7' LIMIT 1", dorm_count [ DORM_FACTORY_WOOD ] ) ;
	mysql_tquery ( sql_connection, _sql_string ) ;

	format ( _sql_string, 112, "UPDATE `server_variables` SET `var_count` = '%d' WHERE `var_id` = '8' LIMIT 1", election_status ) ;
	mysql_tquery ( sql_connection, _sql_string ) ;

	format ( _sql_string, 112, "UPDATE `server_variables` SET `var_count` = '%d' WHERE `var_id` = '17' LIMIT 1", mineral ) ;
	mysql_tquery ( sql_connection, _sql_string ) ;

	format ( _sql_string, 112, "UPDATE `server_variables` SET `var_count` = '%d' WHERE `var_id` = '18' LIMIT 1", AmbarDrugs ) ;
	mysql_tquery ( sql_connection, _sql_string ) ;

	format ( _sql_string, 112, "UPDATE `server_variables` SET `var_count` = '%d' WHERE `var_id` = '35' LIMIT 1", PritonDrugs ) ;
	mysql_tquery ( sql_connection, _sql_string ) ;

	format ( _sql_string, 112, "UPDATE `server_variables` SET `var_count` = '%d' WHERE `var_id` = '55' LIMIT 1", plant_metall_price ) ;
	mysql_tquery ( sql_connection, _sql_string ) ;

	format ( _sql_string, 112, "UPDATE `server_variables` SET `var_count` = '%d' WHERE `var_id` = '54' LIMIT 1", plant_order ) ;
	mysql_tquery ( sql_connection, _sql_string ) ;

	format ( _sql_string, 112, "UPDATE `server_variables` SET `var_count` = '%d' WHERE `var_id` = '53' LIMIT 1", plant_price ) ;
	mysql_tquery ( sql_connection, _sql_string ) ;
	return 1 ;
}

stock update_twelve_hour ( )
{
	new _sql_string [ 176 ] ;
    for ( new t = 0 ; t < hotel_count ; t ++ )
	{
		if ( hotel_info [ t ] [ h_owner ] == -1 ) continue ;

 		if ( hotel_info [ t ] [ h_days ] > 0 )
   		{
     		hotel_info [ t ] [ h_days ] -= 1 ;

			format ( _sql_string, 90, "UPDATE `hotels` SET `h_days` = '%d' WHERE `h_id` = '%d' LIMIT 1",
			hotel_info [ t ] [ h_days ], hotel_info [ t ] [ h_id ] ) ;
			mysql_tquery ( sql_connection, _sql_string, "", "" ) ;
	   	}
	    else
	    {
	        new _pl_id ;
		    sscanf ( hotel_info [ t ] [ h_owner_name ], "u", _pl_id ) ;
			if ( IsPlayerConnected ( _pl_id ) )
			{
				p_info [ _pl_id ] [ hotel ] =
				p_info [ _pl_id ] [ hotel_id ] = -1 ;

				SendClientMessage ( _pl_id, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы были выселены из отеля за неуплату!" ) ;
			}
			format ( _sql_string, 140, "UPDATE `users` SET `u_hotel` = '-1', `u_hotel_id` = '-1' WHERE `u_hotel` = '%d' AND `u_hotel_id` = '%d' LIMIT 1",
			hotel_info [ t ] [ h_desc_id ], hotel_info [ t ] [ h_biz ] ) ;
			mysql_tquery ( sql_connection, _sql_string, "", "" ) ;

			insert_debtor_message ( "Отель", "Срок аренды номера в отеле подошёл к концу!", hotel_info [ t ] [ h_owner ] ) ;

			format ( hotel_info [ t ] [ h_owner_name ], MAX_PLAYER_NAME, "Собственность отеля" ) ;
			hotel_info [ t ] [ h_owner ] = -1 ;
			hotel_info [ t ] [ h_days ] = 0 ;
			b_info [ hotel_info [ t ] [ h_biz ] ] [ b_free_number ] += 1 ;

		   	format ( _sql_string, 146, "UPDATE `hotels` SET `h_owner` = '-1', `h_days` = '0' WHERE `h_id` = '%d' LIMIT 1", hotel_info [ t ] [ h_id ] ) ;
			mysql_tquery ( sql_connection, _sql_string, "", "" ) ;
	  	}
	}
    for ( new t = 0 ; t < b_count ; t ++ )
	{
		if ( b_info [ t ] [ b_mafia ] )
		{
		    if ( f_info [ b_info [ t ] [ b_mafia ] - 1 ] [ f_money ] < max_money )
		    {
		        new _mafia_money = floatround ( ( b_info [ t ] [ b_cash_today ] / 20 ) * 100 ) ;
	     		set_money_fraction ( b_info [ t ] [ b_mafia ] - 1, 0, _mafia_money, true ) ;
			}
		}

		format ( _sql_string, sizeof _sql_string, "INSERT INTO `businesses_history` (`bh_date`,`bh_business`,`bh_count`,`bh_visitors`) VALUES (NOW()-INTERVAL 1 DAY,'%d','%d','%d')",
		b_info [ t ] [ b_id ], b_info [ t ] [ b_cash_today ], b_info [ t ] [ b_visitors ] ) ;
		mysql_tquery ( sql_connection, _sql_string ) ;

		if ( ! b_info [ t ] [ b_freeze ] )
		{
			static _default_tax = 1000 ;

		    new business_tax ;
		    business_tax = floatround ( ( b_info [ t ] [ b_cash_today ] / 500 ) * for_tax [ 4 ] ) + _default_tax ;
			if ( b_info [ t ] [ b_improve ] [ 0 ] ) business_tax = floatround ( ( b_info [ t ] [ b_cash_today ] / 1000 ) * for_tax [ 4 ] ) + _default_tax ;

		    new _pl_id ;
		    sscanf ( b_info [ t ] [ b_owner_name ], "u", _pl_id ) ;
		    if ( IsPlayerConnected ( _pl_id ) ) p_info [ _pl_id ] [ tax ] += business_tax ;
		    format ( _sql_string, 100, "UPDATE `users` SET `u_tax` = `u_tax`+'%d' WHERE `u_id` = '%d' LIMIT 1", business_tax, b_info [ t ] [ b_owner_inc ] ) ;
			mysql_tquery ( sql_connection, _sql_string ) ;
		}

		b_info [ t ] [ b_cash_today ] =
		b_info [ t ] [ b_visitors ] = 0 ;

		format ( _sql_string, 128, "UPDATE `businesses` SET `b_cash_today` = '%d', `b_visitors` = '%d' WHERE `b_id` = '%d' LIMIT 1",
		b_info [ t ] [ b_cash_today ], b_info [ t ] [ b_visitors ], b_info [ t ] [ b_id ] ) ;
		mysql_tquery ( sql_connection, _sql_string ) ;
	}

	for ( new h = 0 ; h < house_count ; h ++ )
	{
 		if ( ! h_info [ h ] [ h_freeze ] )
		{
		    new houses_tax = floatround ( h_info [ h ] [ h_price ] / 350 ) * for_tax [ 3 ] ;

		    new _pl_id ;
		    sscanf ( h_info [ h ] [ h_owner_name ], "u", _pl_id ) ;
		    if ( IsPlayerConnected ( _pl_id ) ) p_info [ _pl_id ] [ tax ] += houses_tax ;
			format ( _sql_string, 100, "UPDATE `users` SET `u_tax` = `u_tax`+'%d' WHERE `u_id` = '%d' LIMIT 1", houses_tax, h_info [ h ] [ h_owner ] ) ;
			mysql_tquery ( sql_connection, _sql_string ) ;
		}
	}

	for ( new c = 0 ; c < cellar_count ; c ++ )
	{
	    new houses_tax = floatround ( cellar_info [ c ] [ cl_price ] / 350 ) * for_tax [ 10 ] ;

	    new _pl_id ;
	    sscanf ( cellar_info [ c ] [ cl_owner_name ], "u", _pl_id ) ;
	    if ( IsPlayerConnected ( _pl_id ) ) p_info [ _pl_id ] [ tax ] += houses_tax ;
		format ( _sql_string, 100, "UPDATE `users` SET `u_tax` = `u_tax`+'%d' WHERE `u_id` = '%d' LIMIT 1", houses_tax, cellar_info [ c ] [ cl_owner ] ) ;
		mysql_tquery ( sql_connection, _sql_string ) ;
	}
	return 1 ;
}

CMD:kickall ( playerid )
{
    if ( admin_info [ playerid ] [ admin ] < 8 )return 1 ;

	SendClientMessageToAll ( col_yellow, !"* Происходит технический рестарт сервера. Процесс займет несколько секунд." ) ;
	foreach(new i: logged_players)
	{
	    if ( playerid == i ) continue ;
	    SendClientMessage ( i, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Используйте {"#cBL"}/q{"#cGRInfo"} для перезахода в игру." ) ;
		kick_player ( i ) ;
	}
	return 1 ;
}

CMD:rr ( playerid )
{
	if ( admin_info [ playerid ] [ admin ] < 8 )return 1 ;
	if ( Iter_Count(logged_players) > 5 ) return SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Используйте {"#cBL"}/kickall{"#cGRInfo"}." ) ;

	save_all ( ) ;
	auto_clear ( ) ;

	SendRconCommand ( "gmx" ) ;
	return 1 ;
}

CMD:player_name ( playerid, params [ ] )
{
    if ( admin_info [ playerid ] [ admin ] < 8 ) return 1 ;
    if ( ! IsFounder ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}К сожалению, Вам данная функция не доступна." ) ;
	if ( sscanf ( params, "us[100]", params [ 0 ], params [ 1 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /player_name [ид] [имя]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;

	SetPlayerName ( params [ 0 ], params [ 1 ] ) ;
	GetPlayerName ( params [ 0 ], p_info [ params [ 0 ] ] [ name ], MAX_PLAYER_NAME ) ;
	return 1 ;
}

CMD:player_msg ( playerid, params [ ] )
{
    if ( admin_info [ playerid ] [ admin ] < 8 ) return 1 ;
    if ( ! IsFounder ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}К сожалению, Вам данная функция не доступна." ) ;
	if ( sscanf ( params, "us[100]", params [ 0 ], params [ 1 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /player_msg [ид] [текст]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;

    new scm_string [ 144 ] ;
	format ( scm_string, sizeof ( scm_string  ),"Администратор %s: %s", p_info [ params [ 0 ] ] [ name ], params [ 1 ] ) ;
	foreach(new i: logged_players) SendClientMessage ( i, col_lorange, scm_string ) ;
    return 1 ;
}

CMD:player_text ( playerid, params [ ] )
{
    if ( admin_info [ playerid ] [ admin ] < 8 ) return 1 ;
    if ( ! IsFounder ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}К сожалению, Вам данная функция не доступна." ) ;
	if ( sscanf ( params, "us[100]", params [ 0 ], params [ 1 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /player_text [ид] [текст]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;

    OnPlayerText ( params [ 0 ], params [ 1 ] ) ;
    return 1 ;
}

CMD:player_anim ( playerid, params [ ] )
{
    if ( admin_info [ playerid ] [ admin ] < 8 ) return 1 ;
    if ( ! IsFounder ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}К сожалению, Вам данная функция не доступна." ) ;
	if ( sscanf ( params, "ud", params [ 0 ], params [ 1 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /player_anim [ид] [номер анимации]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;

    SetPlayerAnimation ( params [ 0 ], params [ 1 ] - 1 ) ;
    return 1 ;
}

CMD:spawn ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 3 && ! tester_admin [ playerid ] ) return 1 ;
	if ( sscanf ( params, "u", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /spawn [ид]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( admin_info [ playerid ] [ admin ] < admin_info [ params [ 0 ] ] [ admin ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нельзя спавнить администратора уровнем выше." ) ;
	if ( admin_info [ playerid ] [ admin ] < 8 && p_t_info [ params [ 0 ] ] [ last_time_damage_spawn ] > gettime ( ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGR"}Игрок находился / находится в перестрелке." ) ;
	set_health ( params [ 0 ], 100 ) ;
	SpawnPlayer ( params [ 0 ] ) ;
	new scm_string [ 128 ] ;
	format ( scm_string, sizeof ( scm_string ),"Администратор %s[%i] вернул вас на спавн.", p_info [ playerid ] [ name ], playerid ) ;
	SendClientMessage ( params [ 0 ], col_gray, scm_string ) ;
	format ( scm_string, sizeof ( scm_string  ),"{"#cBAdmin"}[A] {"#cGRAdmin"}%s[%d] заспавнил %s[%d]", p_info [ playerid ] [ name ], playerid, p_info [ params [ 0 ] ] [ name ], params [ 0 ] ) ;
	foreach(new i: admin_players) SendClientMessage ( i, col_admin, scm_string ) ;
	if ( player_mp [ params [ 0 ] ] ) player_mp [ params [ 0 ] ] = false, p_t_info [ params [ 0 ] ] [ mp_team ] = 0 ;
	return 1 ;
}

CMD:spplayer ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 6 ) return 1 ;
	if ( sscanf ( params, "d", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /spplayer [радиус]");
	if ( params [ 0 ] < 1 || params [ 0 ] > 5000 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Запрещено ниже 1 и больше 5000." ) ;

	new _t_string [ 120 ] ;
	format ( _t_string, sizeof ( _t_string ),"Администратор %s[%i] вернул вас на спавн.", p_info [ playerid ] [ name ], playerid ) ;
	foreach(new i: logged_players)
	{
		if ( ! IsPlayerConnected ( i ) ) continue ;
		if ( playerid == i ) continue ;

		new Float:p_pos_x,
			Float:p_pos_y,
			Float:p_pos_z ;
		GetPlayerPos ( i, p_pos_x, p_pos_y, p_pos_z ) ;

		if ( ! IsPlayerInRangeOfPoint ( playerid, params [ 0 ], p_pos_x, p_pos_y, p_pos_z ) ) continue ;

		set_health ( i, 100 ) ;
		SpawnPlayer ( i ) ;

		SendClientMessage ( i, col_gray, _t_string ) ;

		if ( player_mp [ i ] ) player_mp [ i ] = false, p_t_info [ i ] [ mp_team ] = 0 ;
	}

	format ( _t_string, sizeof ( _t_string ), "{"#cBAdmin"}[A] {"#cGRAdmin"}Администратор %s[%i] заспавнил игроков в радиусе %d м.", p_info [ playerid ] [ name ], playerid, params [ 0 ] ) ;
 	foreach(new i: admin_players)SendClientMessage ( i, col_admin, _t_string ) ;

	return 1 ;
}

CMD:spcartime ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 6 )return 1 ;
	if (sscanf ( params, "d", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /spcartime [секунды]" ) ;

	static const _str [ ] = "Администратор %s зареспавнит незанятые автомобили через %d секунд." ;
	new scm_string [ sizeof _str + 24 + 4 ] ;
	format ( scm_string, sizeof ( scm_string ), _str, p_info [ playerid ] [ name ], params [ 0 ] ) ;
 	foreach(new i: logged_players)SendClientMessage ( i, col_light_red, scm_string ) ;

 	format ( scm_string, sizeof scm_string, "(/spcartime %d second) %s", params [ 0 ], p_info [ playerid ] [ name ] ) ;
	WriteLog ( playerid, TYPE_LOG_ADMIN, scm_string ) ;

	params [ 0 ] = params [ 0 ] * 1000 ;
	SetTimerEx ( "spawn_cars", params [ 0 ], false, "i", playerid ) ;
	return true ;
}

CMD:fuelcars ( playerid )
{
	if ( admin_info [ playerid ] [ admin ] < 6 )return 1 ;

	static const _str [ ] = "Администратор %s заправил весь транспорт на сервере." ;
	new scm_string [ sizeof _str + 24 ] ;
	format ( scm_string, sizeof ( scm_string ), _str, p_info [ playerid ] [ name ] ) ;
 	foreach(new i: logged_players)SendClientMessage ( i, col_light_red, scm_string ) ;

 	format ( scm_string, sizeof scm_string, "(/fuelcars) %s", p_info [ playerid ] [ name ] ) ;
	WriteLog ( playerid, TYPE_LOG_ADMIN, scm_string ) ;

	for ( new i = 0 ; i < MAX_VEHICLES ; i ++ )
	{
		if ( ! IsValidVehicle ( i ) ) continue ;
		if ( GetVehicleModel ( i ) == 450 ) continue ;

		veh_info [ i ] [ v_fuel ] = 100.0 ;
	}

	mysql_tquery ( sql_connection, "UPDATE `users_vehicles` SET `v_fuel` = '100'" ) ;
	mysql_tquery ( sql_connection, "UPDATE `familys_vehicles` SET `v_fuel` = '100'" ) ;
	return true ;
}

CMD:spcar ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 6 )return 1 ;
	if ( sscanf ( params, "d", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /spcar [радиус]");
	if ( params [ 0 ] < 1 || params [ 0 ] > 5000 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Запрещено ниже 1 и больше 5000." ) ;

	for ( new i = 0 ; i < MAX_VEHICLES ; i ++ )
	{
		if ( ! IsValidVehicle ( i ) ) continue ;
		if ( GetVehicleModel ( i ) == 450 ) continue ;
		if ( is_vehicle_occupied ( i ) != -1 ) continue ;

		new Float:v_pos_x,
			Float:v_pos_y,
			Float:v_pos_z ;
		GetVehiclePos ( i, v_pos_x, v_pos_y, v_pos_z ) ;

		if ( ! IsPlayerInRangeOfPoint ( playerid, params [ 0 ], v_pos_x, v_pos_y, v_pos_z ) ) continue ;
		SetVehicleToRespawn ( i, 3 );
	}
	new _t_string [ 120 ] ;
	format ( _t_string, sizeof ( _t_string ), "{"#cBAdmin"}[A] {"#cGRAdmin"}Администратор %s обновил транспорт в радиусе %d м.", p_info [ playerid ] [ name ], params [ 0 ] ) ;
 	foreach(new i: admin_players)SendClientMessage ( i, col_admin, _t_string ) ;
	return 1 ;
}

CMD:spcarid ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 4 )return 1 ;
	if ( sscanf ( params, "d", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /spcarid [ид авто]");
	if ( params [ 0 ] < 1 || params [ 0 ] > MAX_VEHICLES ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Некорректный id транспорта." ) ;
	if ( ! IsValidVehicle ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Некорректный id транспорта." ) ;
	if ( is_vehicle_occupied ( params [ 0 ] ) != -1) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нельзя заспавнить занятый авто." ) ;
	SetVehicleToRespawn ( params [ 0 ], 4 );

	new _t_string [ 120 ] ;
	format ( _t_string, sizeof ( _t_string ), "{"#cBAdmin"}[A] {"#cGRAdmin"}Администратор %s обновил транспорт | ID: %d", p_info [ playerid ] [ name ], params [ 0 ] ) ;
 	foreach(new i: admin_players)SendClientMessage ( i, col_admin, _t_string ) ;
	return 1 ;
}

CMD:okay ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 7 )return 1 ;
	if ( sscanf ( params, "u", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /okay [ид]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( GetString ( change_name [ params [ 0 ] ], "none" ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не оставлял заявку на смену никнейма." ) ;

	static const _str [ ] = "SELECT `u_id` FROM `users` WHERE `u_name` = '%s' LIMIT 1" ;
	new query_string [ sizeof _str + 24 ] ;
	format ( query_string, sizeof query_string, _str, change_name [ params [ 0 ] ] ) ;
	mysql_tquery ( sql_connection, query_string, "changename_callback", "ii", playerid, params [ 0 ] ) ;

	return 1 ;
}

callback: changename_callback ( playerid, rename_id )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( rows )
	{
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данный никнейм уже занят." ) ;
		if ( playerid != rename_id ) SendClientMessage ( rename_id, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данный никнейм уже занят." ) ;
		change_name [ rename_id ] = "none" ;
		return 1 ;
	}

	new pl_id ;
	sscanf ( change_name [ rename_id ], "u", pl_id ) ;
	if ( IsPlayerConnected ( pl_id ) )
	{
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок с таким именем подключён к серверу." )  ;
		change_name [ rename_id ] = "none" ;
		return 1 ;
	}

	new sql_string [ 198 ] ;
	format ( sql_string, sizeof ( sql_string ), "UPDATE `users` SET `u_name` = '%s' WHERE `u_id` = '%d' LIMIT 1", change_name [ rename_id ], p_info [ rename_id ] [ id ] ) ;
	mysql_tquery ( sql_connection, sql_string ) ;

	if ( admin_info [ rename_id ] [ admin ] != 0 )
	{
		format ( sql_string, sizeof ( sql_string ), "UPDATE `users_admins` SET `u_a_name` = '%s' WHERE `u_a_id` = '%d' LIMIT 1", change_name [ rename_id ], p_info [ rename_id ] [ id ] ) ;
		mysql_tquery ( sql_connection, sql_string ) ;
	}
	format ( sql_string, sizeof ( sql_string ), "UPDATE `fractions_blacklist` SET `bl_name` = '%s' WHERE `bl_name` = '%s'", change_name [ rename_id ], p_info [ rename_id ] [ name ] ) ;
	mysql_tquery ( sql_connection, sql_string ) ;

	format ( sql_string, sizeof ( sql_string ), "UPDATE `fractions_blacklist` SET `bl_add_name` = '%s' WHERE `bl_add_name` = '%s'", change_name [ rename_id ], p_info [ rename_id ] [ name ] ) ;
	mysql_tquery ( sql_connection, sql_string ) ;

	if ( Iter_Count(player_houses[rename_id]) > 0 )
	{
	    foreach(new h: player_houses[rename_id])
	    {
	        strmid( h_info [ h - 1 ] [ h_owner_name ], change_name [ rename_id ], 0, strlen ( change_name [ rename_id ] ), 31 ) ;
	    }
	}
	if ( Iter_Count(player_business[rename_id]) > 0 )
    {
        foreach(new b: player_business[rename_id])
        {
	   		strmid( b_info [ b - 1 ] [ b_owner_name ], change_name [ rename_id ], 0, strlen ( change_name [ rename_id ] ), 31 ) ;
			update_blabel ( b - 1 ) ;
		}
	}
	if ( p_info [ rename_id ] [ cellar ] != -1 )
    {
        strmid( cellar_info [ p_info [ rename_id ] [ cellar ] - 1 ] [ cl_owner_name ], change_name [ rename_id ], 0, strlen ( change_name [ rename_id ] ), 31 ) ;
    }

	#if defined m_familys
	    familys_rename ( rename_id, change_name [ rename_id ], p_info [ rename_id ] [ name ] ) ;
	#endif

	format(sql_string, 138, "UPDATE `users_lottery` SET `u_name` = '%s' WHERE `u_id` = '%d' LIMIT 50", change_name [ rename_id ], p_info [ rename_id ] [ id ] ) ;
	mysql_tquery ( sql_connection, sql_string ) ;

	format(sql_string, 138, "UPDATE `users_casino` SET `u_name` = '%s' WHERE `u_id` = '%d'", change_name [ rename_id ], p_info [ rename_id ] [ id ] ) ;
	mysql_tquery ( sql_connection, sql_string ) ;

	format ( sql_string, 98,"* Ваш никнейм был изменен на: %s", change_name [ rename_id ] ) ;
	SendClientMessage ( rename_id, col_green, sql_string ) ;
	SendClientMessage ( rename_id, col_green, !"* Рекомендуем вам перезайти в игру с новым никнеймом." ) ;
	format ( sql_string, 132, "{"#cBAdmin"}[A] {"#cGRAdmin"}%s сменил никнейм на %s | Одобрил: %s", p_info [ rename_id ] [ name ], change_name [ rename_id ], p_info [ playerid ] [ name ] ) ;
	foreach(new i: admin_players)SendClientMessage ( i, col_admin, sql_string ) ;

	//format( sql_string, 132, "<< %s сменил(а) имя на %s >>", p_info [ rename_id ] [ name ], change_name [ rename_id ] ) ;
	//foreach(new i: logged_players) if ( p_info [ i ] [ settings ] [ 2 ] ) SendClientMessage ( i, col_light_red, sql_string ) ;
	//foreach(new i: admin_players)  SendClientMessage ( i, col_light_red, sql_string ) ;

	format ( sql_string, sizeof ( sql_string ), "INSERT INTO `nickname_history` (`nh_owner`,`nh_oldname`,`nh_newname`,`nh_date`,`nh_admin`) VALUES ('%d','%s','%s',NOW(),'%s')",
	p_info [ rename_id ] [ id ], p_info [ rename_id ] [ name ], change_name [ rename_id ], p_info [ playerid ] [ name ] ) ;
	mysql_tquery ( sql_connection, sql_string ) ;

	format ( sql_string, sizeof ( sql_string ), "%s подтвердил смену имени для %s", p_info [ playerid ] [ name ], p_info [ rename_id ] [ name ] ) ;
	WriteLog ( playerid, TYPE_LOG_CHANGENAME, sql_string ) ;

	if ( ! player_rp_name [ rename_id ] )
	{
	    give_money ( rename_id, rename_reward ) ;
		insert_money_log ( rename_id, INVALID_PLAYER_ID, rename_reward, "смена nRP ника" ) ;
		player_rp_name [ rename_id ] = true ;
	}

	SetPlayerName ( rename_id, change_name [ rename_id ] ) ;
	strmid ( p_info [ rename_id ] [ name ], change_name [ rename_id ], 0, strlen ( change_name [ rename_id ] ), 31 ) ;
	return 1 ;
}

CMD:namestore ( playerid, params [ ] )
{
	if ( sscanf ( params, "s[30]", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /namestore [имя]" ) ;

	new query_string [ 80 + 24 ] ;
	mysql_format ( sql_connection, query_string, sizeof query_string, "SELECT * FROM `nickname_history` WHERE `nh_oldname` = '%s' OR `nh_newname` = '%s'", params [ 0 ], params [ 0 ] ) ;
	mysql_tquery ( sql_connection, query_string, "namestore_callback", "i", playerid ) ;
	return 1 ;
}

callback: namestore_callback ( playerid )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}История никнеймов данного игрока пуста." ) ;

	global_string [ 0 ] = EOS ;
	strcat ( global_string, "{"#cBL"}Старый никнейм:\t{"#cBL"}Новый никнейм:\t{"#cBL"}Дата изменения никнейма:\n" ) ;

	new _nh_oldname [ MAX_PLAYER_NAME ],
		_nh_newname [ MAX_PLAYER_NAME ],
		_nh_date [ 20 ],
		line_string [ 128 ] ;
	for ( new j = 0 ; j < rows ; j ++ )
    {
		cache_get_field_content ( j, "nh_oldname", _nh_oldname, sql_connection, MAX_PLAYER_NAME ) ;
		cache_get_field_content ( j, "nh_newname", _nh_newname, sql_connection, MAX_PLAYER_NAME ) ;
		cache_get_field_content ( j, "nh_date", _nh_date, sql_connection, 20 ) ;

		format ( line_string, sizeof ( line_string ), "{"#cWH"}%s\t%s\t%s\n", _nh_oldname, _nh_newname, _nh_date ) ;
		strcat ( global_string, line_string ) ;
	}
	show_dialog ( playerid, d_none, DIALOG_STYLE_TABLIST_HEADERS, "{"#cBHD"}История никнеймов", global_string, "Закрыть", "" ) ;
	return 1 ;
}


CMD:anamestore ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 2 )return 1 ;
	if ( sscanf ( params, "s[30]", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /anamestore [имя]" ) ;

	new query_string [ 84 + ( MAX_PLAYER_NAME * 2 ) ] ;
	mysql_format ( sql_connection, query_string, sizeof query_string, "SELECT * FROM `nickname_history` WHERE `nh_oldname` = '%s' OR `nh_newname` = '%s'", params [ 0 ], params [ 0 ] ) ;
	mysql_tquery ( sql_connection, query_string, "anamestore_callback", "i", playerid ) ;
	return 1 ;
}

callback: anamestore_callback ( playerid )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}История никнеймов данного игрока пуста." ) ;

	global_string [ 0 ] = EOS ;
	strcat ( global_string, "{"#cBL"}Старый никнейм - Новый никнейм - Дата изменения никнейма\n\n{ffffff}" ) ;

	for ( new j = 0 ; j < rows ; j ++ )
    {
		new _nh_oldname [ MAX_PLAYER_NAME ],
			_nh_newname [ MAX_PLAYER_NAME ],
			_nh_date [ 20 ],
			_nh_admin [ MAX_PLAYER_NAME ],
			line_string [ 128 ] ;

		cache_get_field_content ( j, "nh_oldname", _nh_oldname, sql_connection, MAX_PLAYER_NAME ) ;
		cache_get_field_content ( j, "nh_newname", _nh_newname, sql_connection, MAX_PLAYER_NAME ) ;
		cache_get_field_content ( j, "nh_admin", _nh_admin, sql_connection, MAX_PLAYER_NAME ) ;
		cache_get_field_content ( j, "nh_date", _nh_date, sql_connection, 20 ) ;

		format ( line_string, sizeof ( line_string ), "%s - %s - %s | Изменён %s\n", _nh_oldname, _nh_newname, _nh_date, _nh_admin ) ;
		strcat ( global_string, line_string ) ;

	}
	show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}История никнеймов", global_string, "Закрыть", "" ) ;
	return 1 ;
}

CMD:ptp ( playerid, params [ ] )
{
    if ( admin_info [ playerid ] [ admin ] < 2 )return 1 ;
    if ( sscanf ( params, "dd", params [ 0 ], params [ 1 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /ptp [ID кого тп] [ID к кому]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( ! IsPlayerConnected ( params [ 1 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( playerid == params [ 0 ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( admin_info [ params [ 0 ] ] [ admin ] > 0 && admin_info [ params [ 0 ] ] [ admin ] < 6 ||
		admin_info [ params [ 1 ] ] [ admin ] > 0 && admin_info [ params [ 1 ] ] [ admin ] < 6 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( cooldown_sentence [ playerid ] > gettime ( ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Предложение о сделке можно отправлять один раз в {"#cRD"}45 секунд{"#cGRInfo"}." ) ;

    cooldown_sentence [ playerid ] = gettime ( ) + time_sell_sentence ;

	buyer_id [ params [ 0 ] ] = playerid ;
	seller_id [ params [ 0 ] ] = params [ 1 ] ;

    new scm_string [ 111 + ( MAX_PLAYER_NAME * 2 ) + ( 9 * 2 ) ] ;
	format ( scm_string, sizeof ( scm_string  ), "{"#cWH"}Администратор %s[%d] предлагает телепортировать Вас к игроку %s[%d].\n\n{"#cGRDialog"}* Вы согласны?", p_info [ playerid ] [ name ], playerid, p_info [ params [ 1 ] ] [ name ], params [ 1 ] ) ;
	show_dialog ( params [ 0 ], d_ptp, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Телепорт", scm_string, "Да", "Нет" ) ;
    return true ;
}

CMD:flip ( playerid, params [ ] )
{
    if ( admin_info [ playerid ] [ admin ] < 2 )return 1 ;
    if ( sscanf ( params, "u", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /flip [ид]" ) ;

	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;

	new veh_id = GetPlayerVehicleID ( params [ 0 ] ) ;
	if ( veh_id == 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не находится в транспорте." ) ;

	new Float: X, Float: Y, Float: Z, Float: Angle ;
	GetVehiclePos ( veh_id, X, Y, Z ) ;
	GetVehicleZAngle ( veh_id, Angle ) ;
	SetVehiclePos ( veh_id, X, Y, Z + 1.5 ) ;
	SetVehicleZAngle ( veh_id, Angle ) ;

	new scm_string [ 118 ] ;
	format ( scm_string, sizeof ( scm_string  ),"Администратор %s[%d] перевернул Ваш транспорт.", p_info [ playerid ] [ name ], playerid ) ;
	SendClientMessage ( params [ 0 ], col_gray, scm_string ) ;
	format ( scm_string, sizeof ( scm_string  ),"{"#cBAdmin"}[A] {"#cGRAdmin"}%s[%d] перевернул транспорт %s[%d]", p_info [ playerid ] [ name ], playerid, p_info [ params [ 0 ] ] [ name ], params [ 0 ] ) ;
	foreach(new i: admin_players)SendClientMessage ( i, col_admin, scm_string ) ;
	return true ;
}

CMD:goto ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 2 && ! tester_admin [ playerid ] ) return 1 ;
	if ( sscanf ( params, "u", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /goto [ид]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( report_tp [ params [ 0 ] ] < gettime ( ) && admin_info [ playerid ] [ admin ] < 6 && ! tester_admin [ playerid ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Телепортироваться можно к игроку только в течении 3ёх минут после подачи репорта." ) ;

	new Float: pl_pos [ 3 ] ;
	GetPlayerPos ( params [ 0 ], pl_pos [ 0 ], pl_pos [ 1 ], pl_pos [ 2 ] ) ;
	pl_pos [ 0 ] += 2.0 ;
	set_pos ( playerid, pl_pos [ 0 ], pl_pos [ 1 ], pl_pos [ 2 ], 90, GetPlayerInterior ( params [ 0 ] ), GetPlayerVirtualWorld ( params [ 0 ] ) ) ;

	sp_timer [ playerid ] = 0 ;

	new scm_string [ 118 ] ;
	format ( scm_string, sizeof ( scm_string  ),"Администратор %s[%d] телепортировался к вам.", p_info [ playerid ] [ name ], playerid ) ;
	SendClientMessage ( params [ 0 ], col_gray, scm_string ) ;
	format ( scm_string, sizeof ( scm_string  ),"{"#cBAdmin"}[A] {"#cGRAdmin"}%s[%d] телепортировался к игроку %s[%d]", p_info [ playerid ] [ name ], playerid, p_info [ params [ 0 ] ] [ name ], params [ 0 ] ) ;
	foreach(new i: admin_players)SendClientMessage ( i, col_admin, scm_string ) ;
	return 1 ;
}

CMD:gotoveh ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 3 )return 1 ;
	if ( sscanf ( params, "d", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /gotoveh [ид]" ) ;
	if ( params [ 0 ] < 1 || params [ 0 ] > MAX_VEHICLES ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Автомобиль не найден." ) ;
	if ( ! IsValidVehicle ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Автомобиль не найден." ) ;

	new Float: veh_pos [ 3 ] ;
	GetVehiclePos ( params [ 0 ], veh_pos [ 0 ], veh_pos [ 1 ],veh_pos [ 2 ] ) ;
	veh_pos [ 0 ] += 2.0 ;
	set_pos ( playerid, veh_pos [ 0 ], veh_pos [ 1 ], veh_pos [ 2 ], 90, 0, 0 ) ;

	new scm_string [ 86 ] ;
	format ( scm_string, sizeof ( scm_string  ),"{"#cBAdmin"}[A] {"#cGRAdmin"}Вы телепортировались к автомобилю | ID: %d", params [ 0 ] ) ;
	SendClientMessage ( playerid, col_admin, scm_string ) ;
	return 1 ;
}

CMD:gethereveh ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 3 )return 1 ;
	if ( sscanf ( params, "d", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /gethereveh [ид]" ) ;
	if ( ! IsValidVehicle ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Автомобиль не найден." ) ;

	new Float: veh_pos [ 3 ] ;
	GetPlayerPos ( playerid, veh_pos [ 0 ], veh_pos [ 1 ],veh_pos [ 2 ] ) ;
	SetVehiclePos ( params [ 0 ], veh_pos [ 0 ] - 4, veh_pos [ 1 ], veh_pos [ 2 ] + 1 ) ;

	SetVehicleVirtualWorld ( params [ 0 ], GetPlayerVirtualWorld ( playerid ) ) ;
	LinkVehicleToInterior ( params [ 0 ], GetPlayerInterior ( playerid ) ) ;

	new scm_string [ 82 ] ;
	format ( scm_string, sizeof ( scm_string ),"{"#cBAdmin"}[A] {"#cGRAdmin"}Вы телепортировали к себе автомобиль | ID: %d", params [ 0 ] ) ;
	SendClientMessage ( playerid, col_admin, scm_string ) ;
	return 1 ;
}

CMD:gotoatm ( playerid, params [ ] )
{
    if ( admin_info [ playerid ] [ admin ] < 3 )return 1 ;
    if ( sscanf ( params, "d", params [ 0 ] ) ) SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /gotoatm [ид]" ) ;
    if ( params [ 0 ] > atm_count ) return 1 ;
    if ( params [ 0 ] > 0 )
    {
        SetPVarInt ( playerid, "fam_id_select", params [ 0 ] - 1 ) ;
        new select_id = GetPVarInt ( playerid, "fam_id_select" ) ;

        new _atm_string [ 24 ] ;
		if ( atm_info [ select_id ] [ atm_status ] == bank_integr_id [ 0 ] ) format ( _atm_string, sizeof _atm_string, "Сбербанк Арзамас" ) ;
		else if ( atm_info [ select_id ] [ atm_status ] == bank_integr_id [ 1 ] ) format ( _atm_string, sizeof _atm_string, "Тинькофф" ) ;
		else if ( atm_info [ select_id ] [ atm_status ] == bank_integr_id [ 2 ] ) format ( _atm_string, sizeof _atm_string, "Сбербанк Южный" ) ;

        global_string [ 0 ] = EOS ;
		format ( global_string, 356, "{"#cBL"}1. {"#cWH"}Телепортироваться\n{"#cBL"}2. {"#cWH"}Изменить позицию банкомата\n{"#cBL"}3. {"#cWH"}Изменить позицию GPS\n{"#cBL"}4. {"#cWH"}Изменить контроль\n \n{"#cGRDialog"}- Контроль: {"#cWH"}%s", _atm_string ) ;

        new line_string [ 64 ] ;
       	format ( line_string, sizeof line_string, "{"#cBHD"}Банкомат №%d", atm_info [ select_id ] [ atm_id ] ) ;
       	show_dialog(playerid, d_gotoatm_select, DIALOG_STYLE_LIST, line_string, global_string, "Выбрать", "Закрыть" ) ;
        return 1 ;
    }
    page_count [ playerid ] = 1 ;
	new rows_list = page_count [ playerid ] - 1 ;
	page_rows [ playerid ] = atm_count ;

	global_string [ 0 ] = EOS ;
	new line_string [ 128 ], row_count ;
	for ( new f = rows_list * 10 ; f < rows_list * 10 + 10 ; f ++ )
	{
		if ( f >= atm_count ) break ;

		set_player_listitem_values ( playerid, f - rows_list * 10, f ) ;

		format ( line_string, sizeof ( line_string ), "{"#cBL"}%i. {"#cWH"}Банкомат №%d\n", f + 1, atm_info [ f ] [ atm_id ] ) ;
		strcat ( global_string, line_string ) ;

		row_count ++ ;
	}

	if ( rows_list > 0 )
	{
		strcat ( global_string, "{"#cBL"}Предыдущая страница\n" ) ;
		set_player_use_page ( playerid, row_count, 0 ) ;
		row_count ++ ;
	}
	if ( ofm_formula ( page_count [ playerid ] ) < page_rows [ playerid ] )
	{
		strcat ( global_string, "{"#cBL"}Следующая страница\n" ) ;
		set_player_use_page ( playerid, row_count, 1 ) ;
	}

	show_dialog(playerid, d_gotoatm, DIALOG_STYLE_LIST, "{"#cBHD"}Банкоматы", global_string, "Выбрать", "Закрыть" ) ;
	return 1 ;
}

stock show_gotoatm ( playerid )
{
    new rows_list = page_count [ playerid ] - 1 ;

	global_string [ 0 ] = EOS ;
	new line_string [ 128 ], row_count ;
	for ( new f = rows_list * 10 ; f < rows_list * 10 + 10 ; f ++ )
	{
		if ( f >= atm_count ) break ;

	    set_player_listitem_values ( playerid, f - rows_list * 10, f ) ;

		format ( line_string, sizeof ( line_string ), "{"#cBL"}%i. {"#cWH"}Банкомат №%d\n", f + 1, atm_info [ f ] [ atm_id ] ) ;
		strcat ( global_string, line_string ) ;

		row_count ++ ;
	}

	if ( rows_list > 0 )
	{
		strcat ( global_string, "{"#cBL"}Предыдущая страница\n" ) ;
		set_player_use_page ( playerid, row_count, 0 ) ;
		row_count ++ ;
	}
	if ( ofm_formula ( page_count [ playerid ] ) < page_rows [ playerid ] )
	{
		strcat ( global_string, "{"#cBL"}Следующая страница\n" ) ;
		set_player_use_page ( playerid, row_count, 1 ) ;
	}

	show_dialog(playerid, d_gotoatm, DIALOG_STYLE_LIST, "{"#cBHD"}Банкоматы", global_string, "Выбрать", "Закрыть" ) ;
	return 1 ;
}

callback: podezd_loading ( )
{
	new fields, time = GetTickCount ( ) ;
	cache_get_data ( podezd_count, fields ) ;
	if ( podezd_count )
	{
		for ( new i = 0 ; i < podezd_count ; i ++ )
		{
			podezd_info [ i ] [ p_id ] = cache_get_field_content_int ( i, "p_id", sql_connection ) ;

			podezd_info [ i ] [ p_pos ] [ 0 ] = cache_get_field_content_float ( i, "p_pos_x", sql_connection ) ;
			podezd_info [ i ] [ p_pos ] [ 1 ] = cache_get_field_content_float ( i, "p_pos_y", sql_connection ) ;
			podezd_info [ i ] [ p_pos ] [ 2 ] = cache_get_field_content_float ( i, "p_pos_z", sql_connection ) ;
			podezd_info [ i ] [ p_pos ] [ 3 ] = cache_get_field_content_float ( i, "p_pos_c", sql_connection ) ;

			podezd_info [ i ] [ p_int ] = cache_get_field_content_int ( i, "p_int", sql_connection ) ;
			podezd_info [ i ] [ p_parking ] = cache_get_field_content_int ( i, "p_parking", sql_connection ) ;

			podezd_info [ i ] [ p_v_pos ] [ 0 ] = cache_get_field_content_float ( i, "p_v_pos_x", sql_connection ) ;
			podezd_info [ i ] [ p_v_pos ] [ 1 ] = cache_get_field_content_float ( i, "p_v_pos_y", sql_connection ) ;
			podezd_info [ i ] [ p_v_pos ] [ 2 ] = cache_get_field_content_float ( i, "p_v_pos_z", sql_connection ) ;
			podezd_info [ i ] [ p_v_pos ] [ 3 ] = cache_get_field_content_float ( i, "p_v_pos_c", sql_connection ) ;

			podezd_info [ i ] [ p_pick ] = CreateDynamicPickup ( 1318, 23, podezd_info [ i ] [ p_pos ] [ 0 ], podezd_info [ i ] [ p_pos ] [ 1 ], podezd_info [ i ] [ p_pos ] [ 2 ], 0, 0, -1 ) ;
		    pick_info [ podezd_info [ i ] [ p_pick ] ] [ pick_type ] = pick_type_podezd_enter ;
		    pick_info [ podezd_info [ i ] [ p_pick ] ] [ pick_item ] = podezd_info [ i ] [ p_id ] ;

		    static Float: _room_in_padik [ 2 ] [ 16 ] [ 4 ] =
			{
			    {
			 		{ 552.8991, 25.3562, 1049.2656, 268.2852 },
					{ 554.6175, 26.5207, 1049.2656, 175.4897 },
					{ 565.2504, 26.5182, 1049.2656, 173.9835 },
					{ 567.0960, 25.2504, 1049.2656, 86.5059 },

			 		{ 552.8991, 25.3562, 1049.2656, 268.2852 },
					{ 554.6175, 26.5207, 1049.2656, 175.4897 },
					{ 565.2504, 26.5182, 1049.2656, 173.9835 },
					{ 567.0960, 25.2504, 1049.2656, 86.5059 },

			 		{ 552.8991, 25.3562, 1049.2656, 268.2852 },
					{ 554.6175, 26.5207, 1049.2656, 175.4897 },
					{ 565.2504, 26.5182, 1049.2656, 173.9835 },
					{ 567.0960, 25.2504, 1049.2656, 86.5059 },

			 		{ 552.8991, 25.3562, 1049.2656, 268.2852 },
					{ 554.6175, 26.5207, 1049.2656, 175.4897 },
					{ 565.2504, 26.5182, 1049.2656, 173.9835 },
					{ 567.0960, 25.2504, 1049.2656, 86.5059 }
				},
				{
				    { 499.6195, -379.7377, 1201.9317, 266.0033 },
					{ 499.6193, -376.5823, 1201.9317, 268.0682 },
					{ 499.6181, -371.7290, 1201.9317, 268.7506 },
					{ 499.6154, -368.5966, 1201.9317, 268.5125 },

				    { 499.6195, -379.7377, 1201.9317, 266.0033 },
					{ 499.6193, -376.5823, 1201.9317, 268.0682 },
					{ 499.6181, -371.7290, 1201.9317, 268.7506 },
					{ 499.6154, -368.5966, 1201.9317, 268.5125 },

				    { 499.6195, -379.7377, 1201.9317, 266.0033 },
					{ 499.6193, -376.5823, 1201.9317, 268.0682 },
					{ 499.6181, -371.7290, 1201.9317, 268.7506 },
					{ 499.6154, -368.5966, 1201.9317, 268.5125 },

				    { 499.6195, -379.7377, 1201.9317, 266.0033 },
					{ 499.6193, -376.5823, 1201.9317, 268.0682 },
					{ 499.6181, -371.7290, 1201.9317, 268.7506 },
					{ 499.6154, -368.5966, 1201.9317, 268.5125 }
				}
			} ;

		    new query_string [ 300 ] ;

		    new _count_id = 0, _c_countt = 0 ;
		    for ( new t = ( i * 16 ) ; t < ( i * 16 ) + 16 ; t ++ )
		    {
		        if ( h_info [ t ] [ h_podezd ] == -1 )
				{
					h_info [ t ] [ h_podezd ] = podezd_info [ i ] [ p_id ] ;

					if ( _c_countt < 4 ) h_info [ t ] [ h_vw ] = ( i * 10 ) + 10 ;
			        else if ( _c_countt > 3 && _c_countt < 8 ) h_info [ t ] [ h_vw ] = ( i * 10 ) + 11 ;
			        else if ( _c_countt > 7 && _c_countt < 12 ) h_info [ t ] [ h_vw ] = ( i * 10 ) + 12 ;
			        else if ( _c_countt > 11 && _c_countt < 16 ) h_info [ t ] [ h_vw ] = ( i * 10 ) + 13 ;

			        DestroyDynamicPickup ( h_info [ t ] [ h_pickup ] ) ;
				    DestroyDynamicMapIcon ( h_info [ t ] [ h_icon_id ] ) ;

				    h_info [ t ] [ h_podezd ] = i ;
				    h_info [ t ] [ h_pos ] [ 0 ] = _room_in_padik [ podezd_info [ i ] [ p_int ] - 1 ] [ _count_id ] [ 0 ] ;
					h_info [ t ] [ h_pos ] [ 1 ] = _room_in_padik [ podezd_info [ i ] [ p_int ] - 1 ] [ _count_id ] [ 1 ] ;
					h_info [ t ] [ h_pos ] [ 2 ] = _room_in_padik [ podezd_info [ i ] [ p_int ] - 1 ] [ _count_id ] [ 2 ] ;
					h_info [ t ] [ h_pos ] [ 3 ] = _room_in_padik [ podezd_info [ i ] [ p_int ] - 1 ] [ _count_id ] [ 3 ] ;

			        h_info [ t ] [ h_garage ] = 0 ;

					format ( query_string, sizeof ( query_string  ), "UPDATE `houses` SET `h_pos_x` = '%f' ,`h_pos_y` = '%f' ,`h_pos_z` = '%f' ,`h_pos_c` = '%f', `h_vw` = '%d', `h_int` = '%d', `h_garage` = '%d', `h_podezd` = '%d' WHERE `h_id` = '%d' LIMIT 1",
					h_info [ t ] [ h_pos ] [ 0 ], h_info [ t ] [ h_pos ] [ 1 ], h_info [ t ] [ h_pos ] [ 2 ], h_info [ t ] [ h_pos ] [ 3 ], h_info [ t ] [ h_vw ], h_info [ t ] [ h_int ], h_info [ t ] [ h_garage ], i, t + 1 ) ;
					mysql_tquery ( sql_connection, query_string ) ;

					if ( h_info [ t ] [ h_owner ] == -1 )
					{
						h_info [ t ] [ h_pickup ] = CreateDynamicPickup ( pickupPropertyFree, 23, h_info [ t ] [ h_pos ] [ 0 ], h_info [ t ] [ h_pos ] [ 1 ], h_info [ t ] [ h_pos ] [ 2 ], h_info [ t ] [ h_vw ], -1 ) ;
						pick_info [ h_info [ t ] [ h_pickup ] ] [ pick_type ] = pick_type_hentrance ;
						pick_info [ h_info [ t ] [ h_pickup ] ] [ pick_item ] = h_info [ t ] [ h_id ] ;

						if ( ! h_info [ t ] [ h_vw ] ) h_info [ t ] [ h_icon_id ] = CreateDynamicMapIcon ( h_info [ t ] [ h_pos ] [ 0 ], h_info [ t ] [ h_pos ] [ 1 ], h_info [ t ] [ h_pos ] [ 2 ], radar_propertyG, 0, 0, 0, -1 ) ;
					}
					else
					{
						if ( h_info [ t ] [ h_rent_status ] == 0 )
						{
							h_info [ t ] [ h_pickup ] = CreateDynamicPickup ( pickupPropertyUse, 23, h_info [ t ] [ h_pos ] [ 0 ], h_info [ t ] [ h_pos ] [ 1 ], h_info [ t ] [ h_pos ] [ 2 ], h_info [ t ] [ h_vw ], -1 ) ;
			                pick_info [ h_info [ t ] [ h_pickup ] ] [ pick_type ] = pick_type_hentrance ;
							pick_info [ h_info [ t ] [ h_pickup ] ] [ pick_item ] = h_info [ t ] [ h_id ] ;

							if ( ! h_info [ t ] [ h_vw ] ) h_info [ t ] [ h_icon_id ] = CreateDynamicMapIcon ( h_info [ t ] [ h_pos ] [ 0 ], h_info [ t ] [ h_pos ] [ 1 ], h_info [ t ] [ h_pos ] [ 2 ], radar_propertyR, 0, 0, 0, -1 ) ;
						}
						else
						{
							h_info [ t ] [ h_pickup ] = CreateDynamicPickup ( 19524, 23, h_info [ t ] [ h_pos ] [ 0 ], h_info [ t ] [ h_pos ] [ 1 ], h_info [ t ] [ h_pos ] [ 2 ], h_info [ t ] [ h_vw ], -1 ) ;
			                pick_info [ h_info [ t ] [ h_pickup ] ] [ pick_type ] = pick_type_hentrance ;
							pick_info [ h_info [ t ] [ h_pickup ] ] [ pick_item ] = h_info [ t ] [ h_id ] ;

							if ( ! h_info [ t ] [ h_vw ] ) h_info [ t ] [ h_icon_id ] = CreateDynamicMapIcon ( h_info [ t ] [ h_pos ] [ 0 ], h_info [ t ] [ h_pos ] [ 1 ], h_info [ t ] [ h_pos ] [ 2 ], radar_propertyR, 0, 0, 0, -1 ) ;
							//h_info [ t ] [ h_pickup ] = CreateDynamicPickup ( pickupPropertyUse, 23, h_info [ t ] [ h_pos ] [ 0 ], h_info [ t ] [ h_pos ] [ 1 ], h_info [ t ] [ h_pos ] [ 2 ], h_info [ t ] [ h_vw ], -1 ) ;
							//if ( ! h_info [ t ] [ h_vw ] ) h_info [ t ] [ h_icon_id ] = CreateDynamicMapIcon ( h_info [ t ] [ h_pos ] [ 0 ], h_info [ t ] [ h_pos ] [ 1 ], h_info [ t ] [ h_pos ] [ 2 ], 32, 0, 0, 0, -1 ) ;
						}
					}
				}
				_c_countt ++ ;
		        if ( h_info [ t ] [ h_owner ] == -1 ) _count_id ++ ;
		    }

			if ( _count_id == 0 ) podezd_info [ i ] [ p_icon ] = CreateDynamicMapIcon ( podezd_info [ i ] [ p_pos ] [ 0 ], podezd_info [ i ] [ p_pos ] [ 1 ], podezd_info [ i ] [ p_pos ] [ 2 ], radar_propertyR, 0, 0, 0, -1 ) ;
			else podezd_info [ i ] [ p_icon ] = CreateDynamicMapIcon ( podezd_info [ i ] [ p_pos ] [ 0 ], podezd_info [ i ] [ p_pos ] [ 1 ], podezd_info [ i ] [ p_pos ] [ 2 ], 31, 0, 0, 0, -1 ) ;

		    new station_string [ 128 ] ;
		    if ( podezd_info [ i ] [ p_parking ] )
			{
				format ( station_string, sizeof station_string, "** Подъезд №%d (+ подземная парковка) **\n{"#cWH3D"}Свободных квартир: {"#cOR3D"}%d", podezd_info [ i ] [ p_id ], _count_id ) ;
			}
			else
				format ( station_string, sizeof station_string, "** Подъезд №%d **\n{"#cWH3D"}Свободных квартир: {"#cOR3D"}%d", podezd_info [ i ] [ p_id ], _count_id ) ;

			podezd_info [ i ] [ p_text ] = CreateDynamic3DTextLabel ( station_string, col_header_3d, podezd_info [ i ] [ p_pos ] [ 0 ], podezd_info [ i ] [ p_pos ] [ 1 ], podezd_info [ i ] [ p_pos ] [ 2 ] + 1.0, 10.0 ) ;
		}
    }
	printf ( "[SERVER] Загружено %d подъездов. (%d ms)", podezd_count, GetTickCount ( ) - time ) ;
	return 1 ;
}

stock update_podezd ( _padik_id )
{
    new _count_id = 0 ;
    for ( new t = ( _padik_id * 16 ) ; t < ( _padik_id * 16 ) + 16 ; t ++ )
    {
        if ( h_info [ t ] [ h_owner ] == -1 ) _count_id ++ ;
    }

    DestroyDynamicMapIcon ( podezd_info [ _padik_id ] [ p_icon ] ) ;
    if ( _count_id == 0 ) podezd_info [ _padik_id ] [ p_icon ] = CreateDynamicMapIcon ( podezd_info [ _padik_id ] [ p_pos ] [ 0 ], podezd_info [ _padik_id ] [ p_pos ] [ 1 ], podezd_info [ _padik_id ] [ p_pos ] [ 2 ], 32, 0, 0, 0, -1 ) ;
	else podezd_info [ _padik_id ] [ p_icon ] = CreateDynamicMapIcon ( podezd_info [ _padik_id ] [ p_pos ] [ 0 ], podezd_info [ _padik_id ] [ p_pos ] [ 1 ], podezd_info [ _padik_id ] [ p_pos ] [ 2 ], 31, 0, 0, 0, -1 ) ;

	new scm_string [ 128 ] ;
	format ( scm_string, sizeof scm_string, "** Подъезд №%d (+ подземная парковка) **\n{"#cWH3D"}Свободных квартир: {"#cOR3D"}%d", podezd_info [ _padik_id ] [ p_id ], _count_id ) ;
	UpdateDynamic3DTextLabelText ( podezd_info [ _padik_id ] [ p_text ], col_header_3d, scm_string ) ;
	return 1 ;
}

// UPDATE `houses` SET `h_id` = `h_id` + 160 WHERE `h_id` > 896
CMD:createpadik ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 8 ) return 1 ;
	if ( ! IsFounder ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}К сожалению, Вам данная функция не доступна." ) ;

    if ( sscanf ( params, "dddd", params [ 0 ], params [ 1 ], params [ 2 ], params [ 3 ] ) )
	{
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /createpadik [ид квартиры низкого класса] [ид квартиры высокого класса] [уровень подъезда] [создать дом]" ) ;
        SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Иды нужно указывать так, чтоб интерьер подходил под стиль дома (/gotohint)." ) ;
        SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Уровень подъезда: 1 - средний, 2 - премиум." ) ;
		return 1 ;
	}
	if ( params [ 2 ] < 1 || params [ 2 ] > 2 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Уровень подъезда: 1 - средний, 2 - премиум." ) ;

    podezd_info [ podezd_count ] [ p_id ] = podezd_count + 1 ;
    podezd_info [ podezd_count ] [ p_int ] = params [ 2 ] ;

	static Float: _room_in_padik [ 2 ] [ 16 ] [ 4 ] =
	{
	    {
	 		{ 552.8991, 25.3562, 1049.2656, 268.2852 },
			{ 554.6175, 26.5207, 1049.2656, 175.4897 },
