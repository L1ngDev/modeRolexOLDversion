stock set_skin ( playerid, skinid )
{
	p_info [ playerid ] [ skin ] = skinid ;
	changed_player_skin [ playerid ] = true ;

	if ( p_info [ playerid ] [ save_skin ] != skinid )
	{
	    p_info [ playerid ] [ save_skin ] = skinid ;
		update_int_sql ( playerid, "u_skin", skinid ) ;
	}
	return SetPlayerSkin ( playerid, skinid ) ;
}

stock ResetSkinStats ( playerid )
{
	GetPlayerTimeInfo ( playerid, PT_SKIN_WEAPON_STATS ) = PlayerTimeInfoClearSlot ;
	GetPlayerTimeInfo ( playerid, PT_SKIN_STATS ) = PlayerTimeInfoAcsStats ;

	new skinLevel, modelId = p_info [ playerid ] [ skin ] ;
	for ( new i = 0 ; i < ACS_STATS_SPECIAL ; i ++ )
	{
		if ( GetModelStatsLevel ( i, modelId, skinLevel ) > 0 )
			GetPlayerTimeSkinInfo ( playerid, PT_SKIN_STATS, i ) += GetModelStatsInfo ( i, modelId, skinLevel ) ;

		if ( GetModelStatsLevel ( ACS_STATS_WEAPON, modelId, i ) > 0 )
		{
			weapId = GetModelStatsLevel ( ACS_STATS_WEAPON, modelId, i ) ;
			GetPlayerTimeSkinInfo ( playerid, PT_SKIN_WEAPON_STATS, weapId ) = GetModelStatsInfo ( ACS_STATS_WEAPON, modelId, i ) ;
		}
	}
	return true ;
}

stock SetPlayerSkinEx ( playerid, skinid )
{
	attachUserAccessories ( playerid ) ;

	changed_player_skin [ playerid ] = false ;
	SetPlayerSkin ( playerid, skinid ) ;
	return 1 ;
}

#define SetPlayerSkin SetPlayerSkinEx
