                if ( _value < 3 || _value > 24 ) return show_dialog ( playerid, d_phone_menu_5, DIALOG_STYLE_INPUT, "{"#cBHD"}Добавление контакта", "{"#cWH"}Введите имя контакта:\n\n{"#cGRDialog"}* Минимальная длина 3 символа, максимальная 24 символа", "Принять", "Назад");
                if ( is_text_invalid ( inputtext ) ) return show_dialog ( playerid, d_phone_menu_5, DIALOG_STYLE_INPUT, "{"#cBHD"}Добавление контакта", "{"#cWH"}Введите имя контакта:\n\n{"#cGRDialog"}* Некорректное имя контакта", "Принять", "Назад");

				format ( p_t_info [ playerid ] [ p_contact ], 32, "%s", inputtext ) ;
