			    if ( _b_type == bizz_type_rentcar || _b_type == bizz_type_bank || _b_type == bizz_type_trucker ) show_fixcar ( playerid, 2 ) ;

			    else if ( _b_type == bizz_type_fixcar || _b_type == bizz_type_autoshop ||
						_b_type == bizz_type_electric || _b_type == bizz_type_lake || _b_type == bizz_type_reserve ) business_information ( playerid, _b_id - 1, 1 ) ;

				else show_dialog ( playerid, d_bpanel_order, DIALOG_STYLE_LIST, "{"#cBHD"}Заказ продуктов", "{"#cBL"}1.{"#cWH"} Установить цена за {"#cLY"}1 ед.{"#cWH"}\n{"#cBL"}2.{"#cWH"} Информация", "Выбрать", "Назад" ) ;
			    return 1 ;
