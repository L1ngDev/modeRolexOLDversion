		PlayerTextDrawFont(playerid, capture_ptd[playerid][0], 1);
		PlayerTextDrawSetProportional(playerid, capture_ptd[playerid][0], 1);
		PlayerTextDrawSetShadow(playerid, capture_ptd[playerid][0], 0);

