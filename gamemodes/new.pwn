							if ( BlueScore > RedScore )
							{
								give_money ( i, pay_money ) ;
								insert_money_log ( i, INVALID_PLAYER_ID, pay_money, "выигрыш пеинт" ) ;

								SendClientMessage ( i, col_yellow, text_string ) ;

								if ( p_info [ i ] [ family_quest ] == 8 )
							    {
							        if ( p_info [ i ] [ family_quest_progress ] < 1 )
							        {
							        	p_info [ i ] [ family_quest_progress ] ++ ;
								   		update_int_sql ( i, "u_family_quest_progress", p_info [ i ] [ family_quest_progress ] ) ;
								   	}
									else SendClientMessage ( i, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Задание успешно выполнено. Отправляйтесь к квестовому персонажу." ) ;
								}
							}
						}
						case 2:
						{
							if ( BlueScore < RedScore )
							{
								give_money ( i, pay_money ) ;
								insert_money_log ( i, INVALID_PLAYER_ID, pay_money, "выигрыш пеинт" ) ;

								SendClientMessage ( i, col_yellow, text_string ) ;

								if ( p_info [ i ] [ family_quest ] == 8 )
							    {
							        if ( p_info [ i ] [ family_quest_progress ] < 1 )
							        {
							        	p_info [ i ] [ family_quest_progress ] ++ ;
								   		update_int_sql ( i, "u_family_quest_progress", p_info [ i ] [ family_quest_progress ] ) ;
								   	}
									else SendClientMessage ( i, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Задание успешно выполнено. Отправляйтесь к квестовому персонажу." ) ;
								}
							}
						}
					}

					new _point_paint [ 15 ] ;
					for ( new _m = 0 ; _m < sizeof ( PaintList ) ; _m ++ )
					{
						for ( new q = 0 ; q < sizeof ( PaintList ) ; q ++ )
						{
							if ( PaintList [ q ] [ DamagePoint ] >= _point_paint [ _m ] && PaintList [ q ] [ Sortirovan ] != 1 )
							{
							    _point_paint [ _m ] = PaintList [ q ] [ DamagePoint ] ;
								paint_place [ _m ] = q ;
							}
						}
						PaintList [ paint_place [ _m ] ] [ Sortirovan ] = 1 ;
					}

					TeamPaint [ i ] = 0 ;

					set_health ( i, 100 ) ;
		   			reset_player_weapon ( i ) ;
		   			fraction_duty ( i ) ;
					set_pos ( i, last_coord [ i ] [ 0 ], last_coord [ i ] [ 1 ], last_coord [ i ] [ 2 ], last_coord [ i ] [ 3 ], last_int [ i ], last_virt [ i ] ) ;

					for ( new j = 0 ; j < 5 ; j ++ ) SendDeathMessageToPlayer ( i, 1001, 1001, 200 ) ;
					TogglePlayerControllable ( i, false ) ;
				}
			}
			SendClientMessageToAll ( col_yellow, !"* Матч по PaintBall завершен. Просмотреть список участников - /pbinfo." ) ;

			paintball_bank = 0 ;
			StartPaintBall = RedScore =	BlueScore =	RedPlayer =	BluePlayer = 0 ;
		}
		else if ( StartPaintBall == 3 )
		{
		    StartPaintBall = 2 ;
			TimerPaintBall = 300 ;
			RedScore =
			BlueScore =
			RedPlayer =
			BluePlayer = 0 ;
			foreach(new i: logged_players)
			{
			    if ( TeamPaint [ i ] )
			    {
					GameTextForPlayer ( i, "~g~~h~~h~START", 2000, 4 ) ;
					TogglePlayerControllable ( i, 1 ) ;
				}
			}
		}
	}

