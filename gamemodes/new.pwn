	ALTER TABLE `punishment_mute` ADD `pun_shot` INT(3) NOT NULL DEFAULT '0' AFTER `pun_green_zone`;
	UPDATE `punishment_jail` SET `pun_shot` = '1' WHERE `pun_id` = '0';
