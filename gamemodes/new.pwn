			mysql_tquery ( sql_connection, scm_string, "promo_callback", "is", playerid, inputtext ) ;
	        return 1 ;
		}
		case d_mm_changename:
		{
			if ( ! response )
			{
				show_mainmenu ( playerid ) ;
				return 1 ;
			}

			if ( p_info [ playerid ] [ leader ] > 0 )
			{
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Пока Вы занимаете лидерский пост Вы не сможете сменить игровое имя." ) ;

				if ( ! player_rp_name [ playerid ] )
		   			show_dialog ( playerid, d_mm_changename, DIALOG_STYLE_INPUT, "{"#cBHD"}Смена нонРП ника", "{ffffff}Ваш никнейм не соответствует правилам Role Play режима.\nСмените никнейм и получите бонус в размере "rename_reward_txt""valute_title".\nНапишите новый никнейм в пустом поле диалогового окна:\n\n{"#cGRDialog"}* Пример: Ivan_Ivanov.", "Принять", "Назад" ) ;

				else
					show_dialog ( playerid, d_mm_changename, DIALOG_STYLE_INPUT, "{"#cBHD"}Смена нонРП ника", "{ffffff}Напишите новый никнейм в пустом поле диалогового окна, если Вы считаете, что он не соответствует правилам Role Play режима.\n{"#cGRDialog"}* Пример: Ivan_Ivanov.", "Принять", "Назад" ) ;
			    return 1 ;
			}

			if ( strlen ( inputtext ) < 6 || strlen ( inputtext ) > 20 || is_russian_text ( inputtext ) )
			{
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы ввели некорректный никнейм." ) ;

				if ( ! player_rp_name [ playerid ] )
		   			show_dialog ( playerid, d_mm_changename, DIALOG_STYLE_INPUT, "{"#cBHD"}Смена нонРП ника", "{ffffff}Ваш никнейм не соответствует правилам Role Play режима.\nСмените никнейм и получите бонус в размере "rename_reward_txt""valute_title".\nНапишите новый никнейм в пустом поле диалогового окна:\n\n{"#cGRDialog"}* Пример: Ivan_Ivanov.", "Принять", "Назад" ) ;

				else
					show_dialog ( playerid, d_mm_changename, DIALOG_STYLE_INPUT, "{"#cBHD"}Смена нонРП ника", "{ffffff}Напишите новый никнейм в пустом поле диалогового окна, если Вы считаете, что он не соответствует правилам Role Play режима.\n{"#cGRDialog"}* Пример: Ivan_Ivanov.", "Принять", "Назад" ) ;
				return 1 ;
			}

			if ( ! player_rp_name [ playerid ] && p_info [ playerid ] [ level ] < 5 )
			{
			    if ( ! IsARPName ( inputtext ) )
				{
					SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Указанный ник не соответствует правилам Role Play режима." ) ;

					if ( ! player_rp_name [ playerid ] )
		   			show_dialog ( playerid, d_mm_changename, DIALOG_STYLE_INPUT, "{"#cBHD"}Смена нонРП ника", "{ffffff}Ваш никнейм не соответствует правилам Role Play режима.\nСмените никнейм и получите бонус в размере "rename_reward_txt""valute_title".\nНапишите новый никнейм в пустом поле диалогового окна:\n\n{"#cGRDialog"}* Пример: Ivan_Ivanov.", "Принять", "Назад" ) ;

					else
						show_dialog ( playerid, d_mm_changename, DIALOG_STYLE_INPUT, "{"#cBHD"}Смена нонРП ника", "{ffffff}Напишите новый никнейм в пустом поле диалогового окна, если Вы считаете, что он не соответствует правилам Role Play режима.\n{"#cGRDialog"}* Пример: Ivan_Ivanov.", "Принять", "Назад" ) ;
		            return 1 ;
				}

				format ( change_name [ playerid ], 24, "%s", inputtext ) ;

				static const _str [ ] = "SELECT `u_id` FROM `users` WHERE `u_name` = '%s' LIMIT 1" ;
				new query_string [ sizeof _str + 24 ] ;
				format ( query_string, sizeof query_string, _str, change_name [ playerid ] ) ;
				mysql_tquery ( sql_connection, query_string, "changename_callback", "ii", playerid, playerid ) ;
			    return 1 ;
			}
			format ( change_name [ playerid ], 24, "%s", inputtext ) ;

			new text_string [ 144 ] ;
			SendClientMessage ( playerid, col_white, !"Заявление на смену никнейма отправлена. Ожидайте решение администратора." ) ;
			format ( text_string, 144, "Заявление на смену nonRP никнейма от %s[%d]. Желаемый никнейм: %s (/okay %d)", p_info [ playerid ] [ name ], playerid, inputtext, playerid ) ;
			foreach(new i: admin_players) if ( admin_info [ i ] [ admin ] > 6 ) SendClientMessage ( i, col_red, text_string ) ;
	        return 1 ;
		}
		case d_mm_stats:
		{
			if ( response ) return show_playermenu ( playerid ) ;
			else return 1 ;
		}
		case d_mm_stats_2:
		{
