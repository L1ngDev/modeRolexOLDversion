		        show_dialog ( playerid, d_plant_order_price, DIALOG_STYLE_INPUT, "{"#cBHD"}Цена за металл", "{"#cRD"}* Цена не может быть менее 1"valute_title_" и более 1.000"valute_title_"\n\n{"#cWH"}Введите цену за 1 кг металла:", "Выбрать", "Закрыть" ) ;
