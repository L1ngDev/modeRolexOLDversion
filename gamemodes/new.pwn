				GetPlayerCashValueToSmile ( p_info [ playerid ] [ tax ] ) ) ;
				show_dialog ( playerid, d_bank_bills, DIALOG_STYLE_INPUT, "{"#cBHD"}Оплата налогов", d_string, "Принять", "Назад" ) ;
				return 1 ;
