callback: loaded_player_contacts ( playerid )
{
    new rows, fields ;
	cache_get_data ( rows, fields ) ;

	for ( new i = 0 ; i < MAX_CONTACTS ; i ++ )
	{
        users_contacts [ playerid ] [ i ] [ uc_inc ] = -1 ;
	}

	if ( rows )
	{
		new _name [ MAX_PLAYER_NAME ] ;
		for ( new i = 0 ; i < rows ; i ++ )
		{
		    users_contacts [ playerid ] [ i ] [ uc_inc ] = cache_get_field_content_int ( i, "inc_id", sql_connection ) ;
		    users_contacts [ playerid ] [ i ] [ uc_id ] = cache_get_field_content_int ( i, "u_c_id", sql_connection ) ;
		    users_contacts [ playerid ] [ i ] [ uc_number ] = cache_get_field_content_int ( i, "u_c_number", sql_connection ) ;
		    users_contacts [ playerid ] [ i ] [ uc_skin ] = cache_get_field_content_int ( i, "u_c_skin", sql_connection ) ;

		    cache_get_field_content ( i, "u_name", _name, sql_connection, MAX_PLAYER_NAME ) ;
		    format ( users_contacts [ playerid ] [ i ] [ uc_name ], MAX_PLAYER_NAME, "%s", _name ) ;
			format ( users_contacts [ playerid ] [ i ] [ uc_subname ], MAX_PLAYER_NAME, "%s", _name ) ;
		}
	}

	new sql_string [ 104 + 9 ] ;
	format ( sql_string, sizeof sql_string, "SELECT `online_sec`, `afk_sec` FROM `users_online` WHERE date >= CURDATE() AND accountid = %d LIMIT 1", p_info [ playerid ] [ id ] ) ;
	mysql_tquery ( sql_connection, sql_string, "load_online_today", "i", playerid ) ;
	return 1 ;
}

callback: get_player_lottery ( playerid, price, listitem, _biz_id )
{
    new rows, fields ;
	cache_get_data ( rows, fields ) ;
    if ( rows >= 50 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас максимальное количество лотерейных билетов." ) ;

	new _random = random ( 9000 ) + 1000 ;

	global_string [ 0 ] = EOS ;
    new line_string [ 144 ] ;

	format ( line_string, sizeof line_string, "{"#cBInfo"}* {"#cWH"}Ваше счастливое число: {"#cGN"}%d\n", _random ) ;
 	strcat ( global_string, line_string ) ;

	format ( line_string, sizeof line_string, "{"#cBInfo"}* {"#cWH"}Призовой фонд лотерии: {"#cGN"}%d"valute_title_"\n\n", _random ) ;
    strcat ( global_string, line_string ) ;

	strcat ( global_string, "{"#cGRDialog"}* Вы зарегестрированы в лотерее, резуельтат будет известен во\n");
	strcat ( global_string, "{"#cGRDialog"}* ремя розыгрыша, который проходит каждый день в {"#cBL"}21:00{"#cGRDialog"}.\n\n" ) ;

	strcat ( global_string, "{"#cGRDialog"}* Купить можно до 50 билетов, дабы увеличить свой шанс на удачу.\n" ) ;
	strcat ( global_string, "{"#cGRDialog"}* Во время подведения итогов не обязательно находиться в игре.\n" ) ;
	strcat ( global_string, "{"#cGRDialog"}* Если удача будет на Вашей стороне и Вы выйграете, то при входе\n" ) ;
	strcat ( global_string, "{"#cGRDialog"}* в игру, Вас оповестят.\n\n" ) ;
	strcat ( global_string, "{"#cGRDialog"}* После покупки билет активировать не нужно.\n" ) ;
	strcat ( global_string, "{"#cGRDialog"}* Список Ваших билетов можно увидеть в /mm.\n" ) ;

	show_dialog ( playerid, d_lottery, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Лотерея", global_string, "Принять", "" ) ;

	format ( line_string, sizeof line_string, "INSERT INTO `users_lottery` (`u_id`,`u_name`,`u_lottery`) VALUES ('%d','%s','%d')",
	p_info [ playerid ] [ id ], p_info [ playerid ] [ name ], _random ) ;
	mysql_tquery ( sql_connection, line_string ) ;

	SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы приобрели лотерейный билет." ) ;

	give_bmoney ( _biz_id + 1, price, b_shop_product [ listitem ] ) ;

	give_money ( playerid, - price ) ;
	insert_money_log ( playerid, INVALID_PLAYER_ID, - price, "Закуп 24/7" ) ;
	return 1 ;
}

callback: id_debtors ( playerid, _name_tax [ ] )
{
    new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Произошла ошибка. Попробуйте снова или обратитесь к администрации." ) ;

	new _u_id = cache_get_field_content_int ( 0, "u_id", sql_connection ) ;
	debt_business_count [ playerid ] = cache_get_field_content_int ( 0, "business_count" ) ;
	debt_house_count [ playerid ] = cache_get_field_content_int ( 0, "houses_count" ) ;

	SetPVarInt ( playerid, "debt_uid", _u_id ) ;
	show_debtors ( playerid, _name_tax ) ;
	return 1 ;
}
