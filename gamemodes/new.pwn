		p_info [ playerid ] [ max_biz ] = cache_get_field_content_int ( 0, "u_maxbiz", sql_connection ) ;
		p_info [ playerid ] [ max_house ] = cache_get_field_content_int ( 0, "u_maxhouse", sql_connection ) ;
		p_info [ playerid ] [ max_veh_timeing ] = cache_get_field_content_int ( 0, "u_maxveh_timeing", sql_connection ) ;

