			show_dialog ( playerid, d_skinrank_set, DIALOG_STYLE_INPUT, "{"#cBHD"}Изменение конфигурации", global_string, "Выбрать", "Назад" ) ;
			set_player_listitem_values ( playerid, 0, listitem ) ;
