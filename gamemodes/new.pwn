			if ( rank_count < 3 || rank_count > 12 )return show_dialog ( playerid, d_business_settings_c, DIALOG_STYLE_INPUT, "{"#cBHD"}Количество должностей", "{"#cWH"}Введите количество рабочих должностей, которое желаете установить:\n\n{"#cRD"}* Количество должностей не может быть меньше 3 и больше 12", "Принять", "Назад" ) ;

			p_info [ playerid ] [ business_rang ] = rank_count ;
