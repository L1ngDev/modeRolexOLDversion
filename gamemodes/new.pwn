callback: restart_timer ( )
{
    SendRconCommand ( "password 0" ) ;
    SendRconCommand ( "gmx" ) ;
	return 1 ;
}

stock freeze_player ( playerid )
{
	if ( ! p_info [ playerid ] [ freeze ] ) return 1 ;

    toggle_controlable ( playerid, false ) ;

	#if defined SAMP
    new freeze_time = 3000 ;
    #else
    new freeze_time = 1000 ;
    #endif
	p_t_info [ playerid ] [ g_timer ] = SetTimerEx ( "toggle_controlable", freeze_time, false, "ii", playerid, true ) ;
	//p_t_info [ playerid ] [ g_timer ] = SetTimerEx ( "toggle_controlable", 1000, false, "iii", playerid, true, true ) ;
	return 1 ;
}

stock GetVehicleShiftPos(vehicleid, style, &Float:x, &Float:y, &Float:z, Float:distance)
{
	new Float:a;
	GetVehiclePos(vehicleid, x, y, z);
	GetVehicleZAngle(vehicleid, a);
	switch(style)
	{
		case 0:
		{
			x += (distance * floatsin(-a, degrees));
			y += (distance * floatcos(-a, degrees));
		}
		case 1:
		{
			x -= (distance * floatsin(-a, degrees));
			y -= (distance * floatcos(-a, degrees));
		}
		case 2:
		{
			a += 90.0;
			x -= (distance * floatsin(-a, degrees));
			y -= (distance * floatcos(-a, degrees));
		}
		case 3:
		{
			a -= 90.0;
			x -= (distance * floatsin(-a, degrees));
			y -= (distance * floatcos(-a, degrees));
		}
		default: return 0 ;
	}
	return 1 ;
}

stock show_bagage ( playerid )
{
	new _v_id = idaofcar [ playerid ] ;
	if ( _v_id < 0 || _v_id > MAX_VEHICLES ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Произошла ошибка. Откройте багажник ещё раз." ) ;
	if ( veh_info [ _v_id - 1 ] [ v_trunk_open ] == true )
	{
    	show_dialog ( playerid, d_trunkmenu, DIALOG_STYLE_LIST, "{"#cBHD"}Багажник", "{"#cGRDialog"}- {"#cWH"}Инвентарь\n{"#cGRDialog"}Закрыть багажник", "Далее", "Назад");
	}
	else
	{
	    show_dialog ( playerid, d_trunkmenu, DIALOG_STYLE_LIST, "{"#cBHD"}Багажник", "{"#cGRDialog"}- {"#cWH"}Инвентарь\n{"#cGRDialog"}Открыть багажник", "Далее", "Назад");
	}

	if ( veh_info [ _v_id - 1 ] [ v_type ] == vehicle_type_player )
	{
		if ( veh_info [ _v_id - 1 ] [ v_trunk_load ] == false )
			InventoryLoading ( veh_info [ _v_id - 1 ] [ v_id ], _v_id, SUB_INV_VEHICLE, 1 ) ;
	}
	return 1 ;
}

stock show_duel ( playerid )
{
    player_duel [ playerid ] [ duel_hp ] = 100.0 ;
	player_duel [ playerid ] [ duel_player ] = INVALID_PLAYER_ID ;
	player_duel [ playerid ] [ duel_create ] = false ;

	global_string [ 0 ] = EOS ;
	new line_string [ 128 ], count_player = 0, map [ 20 ], Guns [ 70 ], gunname [ 32 ], bool: _select_weapon = false ;

	strcat ( global_string, "{"#cBL"}Создал:\t{"#cBL"}Карта:\t{"#cBL"}Максимум игроков:\t{"#cBL"}Оружие:\n") ;
	strcat ( global_string, "{"#cBL"}Создать дуэль\t \t \t \n") ;
	foreach(new i: duels_created)
	{
	    if ( player_duel [ i ] [ duel_player ] != INVALID_PLAYER_ID ) continue ;
	    if ( ! player_duel [ i ] [ duel_max_players ] ) continue ;

	    set_player_listitem_values ( playerid, count_player, i ) ;

		switch ( player_duel [ i ] [ duel_map ] )
		{
		    case 1: map = "Две стороны";
		    case 2: map = "Железный корт";
		    case 3: map = "Четыре стены";
		}

		for ( new q = 0 ; q < 3 ; q ++ )
		{
  			if ( ! player_duel [ i ] [ duel_gun ] [ q ] ) continue ;
		   	GetWeaponName ( player_duel [ i ] [ duel_gun ] [ q ], gunname, 32 ) ;
			if ( _select_weapon == false ) format ( Guns, sizeof ( Guns ), "%s%s", Guns, gunname ) ;
			else format ( Guns, sizeof ( Guns ), "%s, %s", Guns, gunname ) ;

			_select_weapon = true ;
		}

	    count_player ++ ;
	    format ( line_string, sizeof line_string, "{"#cBL"}%d. {"#cWH"}%s\t%s\t%d\t%s\n", count_player, p_info [ i ] [ name ], map, player_duel [ i ] [ duel_max_players ], Guns ) ;
	    strcat ( global_string, line_string ) ;
	}
	show_dialog ( playerid, d_duel_select, DIALOG_STYLE_TABLIST_HEADERS, "{"#cBHD"}Дуэли", global_string, "Выбрать", "Закрыть" ) ;
	return 1 ;
}

stock show_reg_mp ( playerid )
{
	new dialog_string [ 123 + 9 + 9 ] ;
	format ( dialog_string, sizeof dialog_string, "{"#cGRDialog"}- {"#cWH"}Регистрация на PaintBall: {"#cGN"}%d"valute_title_"\n{"#cGRDialog"}- {"#cWH"}Регистрация на гонку: {"#cGN"}%d"valute_title_"", price_paint, price_race ) ;
    show_dialog ( playerid, d_reg_mp, DIALOG_STYLE_LIST, "{"#cBHD"}Регистрация на мероприятия", dialog_string, "Выбрать", "Закрыть" ) ;
    return 1 ;
}

stock prise_open ( playerid, slotId )
{
	new invItem = GetUsersInventory ( playerid, INV_ITEM, slotId ), _random_mp = random ( 9 ) + 1 ;
	switch ( invItem )
	{
	    case 2000: rewards_exp ( playerid, 2 ) ;
		case 2001: rewards_exp ( playerid, 3 ) ;
		case 2002: rewards_exp ( playerid, 4 ) ;
		case 2003:
		{
		    new random_random = 0 ;
		    switch ( random ( 11 ) )
		    {
		        case 0,1,7,9: random_random = random ( 3 ) + 2000 ;
		        case 2: random_random = RandomEx ( 2000, 2024 ) ;
		        case 3,4,8: random_random = random ( 4 ) + 2004 ;
				case 5: random_random = RandomEx ( 2032, MAX_CASE_PRISE ) ;
				case 6:
				{
				    static const garage_skin [ 10 ] [ 2 ] =
					{
						{ 83, 0 },
						{ 86, 0 },
						{ 107, 0 },
						{ 164, 0 },
						{ 294, 0 },
						{ 68, 1 },
						{ 104, 1 },
						{ 32, 0 },
						{ 35, 0 },
						{ 43, 0 }
					} ;

					new _random = random ( sizeof garage_skin ) ;
					random_random = garage_skin [ _random ] [ 0 ] ;
				}
				case 10,11: random_random = RandomEx ( 2084, 2098 ) ;
		    }

			/*if ( random_random > 9 && random_random < 15 || random_random > 17 && random_random < 45 || random_random > 46 && random_random < 50 )
			{
		    	format ( query_string, sizeof query_string, "* %s открыл(а) кейс и получил(а) '%s'. Приятной игры на "server_name".", p_info [ playerid ] [ name ], item_name ( random_random ) ) ;
		    	foreach(new j: logged_players) SendClientMessage ( j, col_purple, query_string ) ;*/

			clear_inventory_slot ( playerid, invItem, 1, slotId ) ;
