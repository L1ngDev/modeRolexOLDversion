						format ( string, sizeof string, "{ffffff}В сейфе {"#cGN"}%d{"#cWH"} грамм наркотиков.\n\n{"#cGRDialog"}* Введите количество, которое желаете положить:", h_info [ h ] [ h_safe_data ] [ 0 ]) ;
						show_dialog ( playerid, d_safe_drugs_put, DIALOG_STYLE_INPUT, "{"#cBHD"}Положить наркотики", string, "Принять", "Назад" ) ;
