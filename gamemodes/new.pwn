									{"#cGRDialog"}- {"#cWH"}unix последнее начало месяца: {"#cLY"}%02d.%02d.%d в %02d:%02d:%02d",
	s_day, s_month, s_year, s_hour, s_minute, s_second,
	s_day1, s_month1, s_year1, s_hour1, s_minute1, s_second1 ) ;

	show_dialog ( playerid, d_admin_server, DIALOG_STYLE_LIST, "{"#cBHD"}Настройки сервера", global_string, "Выбрать", "Назад" ) ;
