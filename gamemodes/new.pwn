		PlayerTextDrawAlignment(playerid, roulette_ptd[playerid][0], 1);
		PlayerTextDrawColor(playerid, roulette_ptd[playerid][0], color_textdraw);
		PlayerTextDrawBackgroundColor(playerid, roulette_ptd[playerid][0], 255);
