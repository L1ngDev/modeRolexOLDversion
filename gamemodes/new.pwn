										{"#cBL"}4. {"#cWH"}Ящики с патронами:\t{"#cGN"}%d {"#cWH"}шт.\n\
										{"#cBL"}5. {"#cWH"}Ящики с бронежилетами:\t{"#cGN"}%d {"#cWH"}шт.\n\
