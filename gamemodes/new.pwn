			        foreach(new i: logged_players)
			        {
			            if ( p_info [ i ] [ number ] == phnum && g_phone_call [ i ] [ PC_ENABLED ] )
			            {
			                format ( str, sizeof ( str ), "%d", i ) ;
							return callcmd::search_mobile ( playerid, str ) ;
			            }
			            continue ;
			        }
					SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Не удалось определить местоположение жителя с данным номером телефона." ) ;
				}
				case 5:
				{
					if ( ! strval ( inputtext ) || strlen ( inputtext ) < 6 )
					{
						SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Необходимо ввести номер телефона." ) ;
						return 1 ;
					}
					p_t_info [ playerid ] [ phone_audition ] = strval ( inputtext ) ;
					SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы успешно начали прослушивать телефонные звонки с введённого номера." ) ;
					return 1 ;
				}
			}
		}
		case d_carmarket:
		{
			if ( ! response ) return clear_player_listitem_values ( playerid ) ;

			if ( listitem == 0 ) return show_carmarket ( playerid ) ;
			new carid = get_player_listitem_values ( playerid, listitem - 1 ) ;
			clear_player_listitem_values ( playerid ) ;

			if ( v_boat ( carid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нельзя добавить лодку/катер/яхту на авторынок." ) ;
			if ( v_plane ( carid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нельзя добавить авиа-транспорт на авторынок." ) ;
			if ( veh_info [ carid - 1 ] [ v_type ] != vehicle_type_player ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Выставить можно только личный транспорт." ) ;
			if ( veh_info [ carid - 1 ] [ v_owner ] != p_info [ playerid ] [ id ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Выставить можно только личный транспорт." ) ;

			SetPVarInt ( playerid, "sc_id", carid ) ;
			new d_string [ 128 ] ;
			format ( d_string, sizeof ( d_string ), "{ffffff}Введите цену продажи транспорта:\n\n{"#cGRDialog"}* Стоимость услуг авторынка составляет {"#cGN"}%d"valute_title_"",
			b_info [ GetPVarInt( playerid, "p_biz_id" ) - 1 ] [ b_cost ] ) ;
			show_dialog ( playerid, d_carmarket_price, DIALOG_STYLE_INPUT, "{"#cBHD"}Авторынок", d_string, "Принять", "Назад" ) ;
			return 1 ;
		}
		case d_carmarket_price:
		{
			if ( ! response )
			{
				if ( Iter_Count(player_vehicles[playerid]) == 0) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет транспорта." ) ;
				show_carmarket ( playerid ) ;
				return 1 ;
			}
			new b = GetPVarInt( playerid, "p_biz_id" ) - 1 ;
			if ( p_info [ playerid ] [ money ] < b_info [ b ] [ b_cost ] )
			{
				new d_string [ 128 ] ;
				format ( d_string, sizeof ( d_string ), "{ffffff}Введите цену продажи транспорта:\n\n{"#cGRDialog"}* Стоимость услуг авторынка составляет {"#cGN"}%d"valute_title_"",
				b_info [ b ] [ b_cost ] ) ;
				show_dialog ( playerid, d_carmarket_price, DIALOG_STYLE_INPUT, "{"#cBHD"}Авторынок", d_string, "Принять", "Назад" ) ;
				return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас недостаточно средств.") ;
			}
			new price = strval ( inputtext ) ;
			new vehicle_id = GetPVarInt ( playerid, "sc_id" ) ;
			if ( price < 10000 || price > GetModelPrice ( getVehicleOrdinalNumber ( vehicle_id ) ) )
			{
				new d_string [ 128 ] ;
				format ( d_string, sizeof ( d_string ), "{ffffff}Введите цену продажи транспорта:\n\n{"#cGRDialog"}* Стоимость услуг авторынка составляет {"#cGN"}%d"valute_title_"",
				b_info [ b ] [ b_cost ] ) ;
				show_dialog ( playerid, d_carmarket_price, DIALOG_STYLE_INPUT, "{"#cBHD"}Авторынок", d_string, "Принять", "Назад" ) ;

				format ( d_string, sizeof d_string, "{"#cRInfo"}* {"#cGRInfo"}Цена должна составлять сумму от {"#cRInfo"}10.000"valute_title_" {"#cGRInfo"}и до {"#cRInfo"}%d"valute_title"{"#cGRInfo"}.", GetModelPrice ( getVehicleOrdinalNumber ( vehicle_id ) ) ) ;
				SendClientMessage ( playerid, col_gray, d_string ) ;
				return 1 ;
			}

			new current_slot = -1 ;

			for ( new i = 0 ; i < CAR_MARKET_SLOTS ; i ++ )
			{
				if ( car_market_slotes_toggled [ i ] == true )continue ;
				if ( car_market_pos [ i ] [ 0 ] == 0.0 ) continue ;

				current_slot = i ;
				break ;
			}
			if ( current_slot == -1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}На авторынке нет свободных мест для транспорта." ) ;
			new bool: _sucess_product = false ;
		    if ( b_info [ b ] [ b_product ] < b_other_product [ 0 ] ) _sucess_product = true ;
			if ( p_info [ playerid ] [ money ] < b_price_market [ b ] [ 0 ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас недостаточно средств для размещения." ) ;

			if ( v_plane ( GetVehicleModel ( vehicle_id ) ) || v_boat ( GetVehicleModel ( vehicle_id ) ) )
			{
				if ( Iter_Count(player_vehicles[playerid]) == 0)return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет транспорта." ) ;

				show_carmarket ( playerid ) ;
				return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете выставить на авторынок данное транспортное средство." ) ;
			}

			Iter_Remove(player_vehicles[playerid], vehicle_id ) ;
			give_money ( playerid, -b_price_market [ b ] [ 0 ] ) ;
			if ( ! _sucess_product ) give_bmoney ( b + 1, b_price_market [ b ] [ 0 ], b_other_product [ 0 ] ) ;

			new car_string [ 29 + 32 ] ;
			format ( car_string, sizeof car_string, "Авторынок БУ (Выставил %s)", GetVehicleNameEx ( vehicle_id ) ) ;
			insert_money_log ( playerid, INVALID_PLAYER_ID, -b_info [ b ] [ b_cost ], car_string ) ;

			veh_info [ vehicle_id - 1 ] [ v_sell_price ] = price ;
			veh_info [ vehicle_id - 1 ] [ v_sell_slot ] = current_slot ;
			veh_info [ vehicle_id - 1 ] [ v_sell_carmarket ] = 0 ;

			car_market_slotes_toggled [ current_slot ] = true ;
			veh_info [ vehicle_id - 1 ] [ v_type ] = vehicle_type_carmarket ;

			SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Машина успешно выставлена на продажу." ) ;

			new query_string [ 256 ] ;
			format ( query_string, sizeof ( query_string ), "UPDATE `users_vehicles` SET `v_sell_slot`='%d',`v_sell_price`='%d',`v_sell_carmarket`='%d' WHERE `v_id` = '%d' LIMIT 1",
			veh_info [ vehicle_id - 1 ] [ v_sell_slot ],
			veh_info [ vehicle_id - 1 ] [ v_sell_price ],
			veh_info [ vehicle_id - 1 ] [ v_sell_carmarket ],
			veh_info [ vehicle_id - 1 ] [ v_id ] ) ;
			mysql_tquery ( sql_connection, query_string ) ;

			format ( query_string, sizeof ( query_string ), "SELECT uv.*, lp.* \
													FROM users_vehicles uv \
													LEFT JOIN licence_plate lp \
													ON lp.licence_plate_use_own_car_id = uv.v_id \
													WHERE `v_id` = '%d' AND `v_sell_price` > '0' LIMIT 1", veh_info [ vehicle_id - 1 ] [ v_id ] ) ;
			mysql_tquery ( sql_connection, query_string, "users_vehicles_loading" ) ;

			DestroyVehicle ( vehicle_id, 33 ) ;
			return 1 ;
		}
		case d_carmarket_buy:
		{
			new veh_id ;
			if ( GetPlayerVehicleID ( playerid ) != 0 ) veh_id = GetPlayerVehicleID ( playerid ) ;
			else veh_id = get_player_use_listitem ( playerid ) ;

			if ( ! response )
			{
				RemovePlayerFromVehicle ( playerid ) ;
				new engine, lights, alarm, doors, bonnet, boot, objective ;
				GetVehicleParamsEx ( veh_id, engine, lights, alarm, doors, bonnet, boot, objective ) ;
				if ( engine == 1 ) SetVehicleParamsEx ( veh_id, VEHICLE_PARAMS_OFF, false, false, false, false, false, objective ) ;
    			return 1 ;
			}
			if ( veh_id == 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы покинули транспортное средство." ) ;
			new _text_string [ 144 ] ;
			if ( veh_info [ veh_id - 1 ] [ v_owner ] == p_info [ playerid ] [ id ] )
			{
				format(_text_string, sizeof(_text_string), "UPDATE `users_vehicles` SET `v_sell_slot`='0',`v_sell_price`='0',`v_sell_carmarket`='0' WHERE `v_id` = '%d' LIMIT 1", veh_info [ veh_id -1 ] [ v_id ] ) ;
				mysql_tquery(sql_connection, _text_string);
				Iter_Add ( player_vehicles[playerid], veh_id ) ;

				car_market_slotes_toggled [ veh_info [ veh_id - 1 ] [ v_sell_slot ] ] = false ;

				veh_info [ veh_id - 1 ] [ v_sell_price ] =
				veh_info [ veh_id - 1 ] [ v_sell_slot ] =
				veh_info [ veh_id - 1 ] [ v_sell_carmarket ] = 0 ;

				veh_info [ veh_id - 1 ] [ v_type ] = vehicle_type_player ;

				SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Транспорт снят с продажи." ) ;

				create_speedometr ( playerid ) ;

				if ( IsValidDynamic3DTextLabel ( veh_info [ veh_id - 1 ] [ v_sell_text ] ) )
				{
					DestroyDynamic3DTextLabel ( veh_info [ veh_id - 1 ] [ v_sell_text ] ) ;
					veh_info [ veh_id - 1 ] [ v_sell_text ] = Text3D:INVALID_3DTEXT_ID ;
				}
				return 1 ;

			}
			if ( p_info [ playerid ] [ hour_played ] < THREE_HOUR_PLAYED )
			{
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Доступно с 3 часов в игре. Используйте /mm - Информация о персонаже - Статистика персонажа." ) ;

				RemovePlayerFromVehicle(playerid);
    			new engine, lights, alarm, doors, bonnet, boot, objective ;
				GetVehicleParamsEx(veh_id, engine, lights, alarm, doors, bonnet, boot, objective);
				if(engine==1) SetVehicleParamsEx(veh_id,VEHICLE_PARAMS_OFF,false,false,false,false,false,objective ) ;
				return 1 ;
			}
			if ( veh_info [ veh_id - 1 ] [ v_sell_price ] < 1 )
			{
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данный транспорт уже не продаётся." ) ;

				RemovePlayerFromVehicle(playerid);
    			new engine, lights, alarm, doors, bonnet, boot, objective ;
				GetVehicleParamsEx(veh_id, engine, lights, alarm, doors, bonnet, boot, objective);
				if(engine==1) SetVehicleParamsEx(veh_id,VEHICLE_PARAMS_OFF,false,false,false,false,false,objective ) ;
				return 1 ;
			}
			if ( p_info [ playerid ] [ money ] < veh_info [ veh_id - 1 ] [ v_sell_price ] )
			{
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас недостаточно средств для приобретения данного транспорта." ) ;

				RemovePlayerFromVehicle(playerid);
    			new engine, lights, alarm, doors, bonnet, boot, objective ;
				GetVehicleParamsEx(veh_id, engine, lights, alarm, doors, bonnet, boot, objective);
				if(engine==1) SetVehicleParamsEx(veh_id,VEHICLE_PARAMS_OFF,false,false,false,false,false,objective ) ;
				return 1 ;
			}
			if ( get_player_veh_count ( playerid ) >= p_info [ playerid ] [ max_veh ] )
			{
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Для начала нужно продать одно из имеющихся транспортных средств." ) ;

				RemovePlayerFromVehicle(playerid);
    			new engine, lights, alarm, doors, bonnet, boot, objective ;
				GetVehicleParamsEx(veh_id, engine, lights, alarm, doors, bonnet, boot, objective);
				if(engine==1) SetVehicleParamsEx(veh_id,VEHICLE_PARAMS_OFF,false,false,false,false,false,objective ) ;
				return 1 ;
			}


			format(_text_string, sizeof(_text_string), "UPDATE `users_vehicles` SET `v_owner`='%d',`v_sell_price` = '0' WHERE `v_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ], veh_info [ veh_id -1 ] [ v_id ] ) ;
			mysql_tquery( sql_connection, _text_string ) ;


			format ( _text_string, sizeof ( _text_string ), "{"#cGInfo"}* {"#cWH"}Вы успешно приобрели {"#cGN"}%s {"#cWH"}за {"#cGN"}%d"valute_title_"", GetVehicleNameEx ( veh_id ), veh_info [ veh_id - 1 ] [ v_sell_price ] ) ;
			SendClientMessage ( playerid, col_white, _text_string ) ;

			new targetid = INVALID_PLAYER_ID ;
			foreach(new i: logged_players)
			{
				if ( p_info [ i ] [ id ] != veh_info [ veh_id - 1 ] [ v_owner ] ) continue ;

				targetid = i ;
				break ;
			}

			if ( targetid != INVALID_PLAYER_ID )
			{
				give_money ( targetid, veh_info [ veh_id - 1 ] [ v_sell_price ] ) ;
				format ( _text_string, sizeof ( _text_string ), "{"#cGInfo"}* {"#cWH"}%s приобрел Ваш {"#cGN"}%s {"#cWH"}за {"#cGN"}%d"valute_title_"", p_info [ playerid ] [ name ], GetVehicleNameEx ( veh_id ), veh_info [ veh_id - 1 ] [ v_sell_price ] ) ;
				SendClientMessage ( targetid, col_white, _text_string ) ;

				_text_string [ 0 ] = EOS ;
				format ( _text_string, 70, "продажа БУ транспорта (%s)", GetVehicleNameEx ( veh_id ) ) ;
				insert_money_log ( targetid, INVALID_PLAYER_ID, veh_info [ veh_id - 1 ] [ v_sell_price ], _text_string ) ;
			}
			else
			{
				static const _str [ ] = "Ваш автомобиль с авторынка купили за %d"valute_title".\nПолучить деньги можно в банке подойдя к надписи получение переводов." ;
				new query_string [ sizeof _str + 11 ] ;
				format ( query_string, sizeof query_string, _str, veh_info [ veh_id - 1 ] [ v_sell_price ] ) ;
				insert_debtor_message ( "Денежные операции", query_string, veh_info [ veh_id - 1 ] [ v_owner ] ) ;

				insert_return_money ( "Денежные операции", veh_info [ veh_id - 1 ] [ v_sell_price ], veh_info [ veh_id - 1 ] [ v_owner ] ) ;
			}

			veh_info [ veh_id - 1 ] [ v_owner ] = p_info [ playerid ] [ id ] ;
			veh_info [ veh_id - 1 ] [ v_type ] = vehicle_type_player ;

			give_money ( playerid, -veh_info [ veh_id - 1 ] [ v_sell_price ] ) ;

			_text_string [ 0 ] = EOS ;
			format ( _text_string, 70, "покупка БУ транспорта (%s)", GetVehicleNameEx ( veh_id ) ) ;
			insert_money_log ( playerid, INVALID_PLAYER_ID, -veh_info [ veh_id - 1 ] [ v_sell_price ], _text_string ) ;

			if ( IsValidDynamic3DTextLabel ( veh_info [ veh_id - 1 ] [ v_sell_text ] ) )
			{
				DestroyDynamic3DTextLabel ( veh_info [ veh_id - 1 ] [ v_sell_text ] ) ;
				veh_info [ veh_id - 1 ] [ v_sell_text ] = Text3D:INVALID_3DTEXT_ID ;
			}
			veh_info [ veh_id - 1 ] [ v_fuel ] = 60.0 ;
			car_market_slotes_toggled [ veh_info [ veh_id - 1 ] [ v_sell_slot ] ] = false ;

			veh_info [ veh_id - 1 ] [ v_sell_price ] =
			veh_info [ veh_id - 1 ] [ v_sell_slot ] =
			veh_info [ veh_id - 1 ] [ v_sell_carmarket ] = 0 ;

			Iter_Add ( player_vehicles[playerid], veh_id ) ;
			create_speedometr ( playerid ) ;
			return 1 ;
		}
		case d_gz_sell_accept:
		{
			if ( seller_id [ playerid ] == INVALID_PLAYER_ID ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Продавец покинул игру." ) ;
			if ( ! response )
			{
				SendClientMessage ( seller_id [ playerid ], col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок отказался от покупки территории." ) ;
				clear_sell_params ( playerid, seller_id [ playerid ] ) ;
				return 1 ;
			}
			new target_id = seller_id [ playerid ] ;
			if ( gz_info [ sell_item [ target_id ] ] [ gz_time ] > 0 )
			{
				SendClientMessage ( target_id, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Сейчас ведётся война за данную территорию." ) ;
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Сейчас ведётся война за данную территорию." ) ;
				clear_sell_params ( playerid, target_id ) ;
				return 1 ;
			}
			if ( p_info [ playerid ] [ money ] < sell_price [ target_id ] )
			{
				SendClientMessage ( target_id, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока недостаточно денег для приобретения." ) ;
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас недостаточно денег для приобретения." ) ;
				clear_sell_params ( playerid, seller_id [ playerid ] ) ;
				return 1 ;
			}
			if ( p_info [ target_id ] [ member ] != gz_info [ sell_item [ target_id ] ] [ gz_owner ]  )
			{
				SendClientMessage ( target_id, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данная территория уже не принадлежит Вам." ) ;
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данная территория уже не принадлежит игроку." ) ;
				clear_sell_params ( playerid, target_id ) ;
				return 1 ;
			}
			gz_info [ sell_item [ target_id ] ] [ gz_owner ] = p_info [ playerid ] [ member ] ;

			new _text_string [ 128 ];
			format ( _text_string, sizeof( _text_string ), "{"#cGInfo"}* {"#cWH"}Вы купили территорию у {"#cGN"}%s{"#cWH"} за {"#cGN"}%d"valute_title"{"#cWH"}.",p_info [ target_id ] [ name ], sell_price [ target_id ] ) ;
			SendClientMessage ( playerid, col_white, _text_string ) ;
			format( _text_string, sizeof ( _text_string ), "{"#cGInfo"}* {"#cWH"}Вы продали территорию {"#cGN"}%s{"#cWH"} за {"#cGN"}%d"valute_title"{"#cWH"}.", p_info [ playerid ] [ name ], sell_price [ target_id ] ) ;
			SendClientMessage ( target_id, col_white, _text_string ) ;

			give_money ( playerid,- sell_price [ target_id ] ) ;
			give_money ( target_id, sell_price [ target_id ] ) ;
			insert_money_log ( target_id, playerid, sell_price [ target_id ], "sellzone" ) ;

			GangZoneStopFlashForAll( gz_info [ sell_item [ target_id ] ] [ gz_created ] ) ;
			GangZoneHideForAll ( gz_info [ sell_item [ target_id ] ] [ gz_created ] ) ;
			GangZoneShowForAll( gz_info [ sell_item [ target_id ] ] [ gz_created ], GetGangZoneColor ( gz_info [ sell_item [ target_id ] ] [ gz_owner ] ) ) ;
			SaveGangZone ( sell_item [ target_id ] ) ;

			clear_sell_params ( playerid, target_id ) ;
			return 1 ;
		}
		case d_makegun:
		{
			if ( ! response ) return 1 ;
			if ( GetInventoryFindItem ( playerid, SUB_INVENTORY, 2153 ) < mg_info [ listitem ] [ mg_guns ] )
			{
			    new _text_string [ 108 ] ;
				format ( _text_string, 108, "{"#cRInfo"}* {"#cGRInfo"}Вам нужно {"#cRD"}%d{"#cGRInfo"} ед.оружия для сборки этого оружия.", mg_info [ listitem ] [ mg_guns ] ) ;
			    SendClientMessage ( playerid, col_gray, _text_string ) ;
			    return 1 ;
			}
            show_dialog ( playerid, d_makegun_, DIALOG_STYLE_INPUT, "{"#cBHD"}Сборка оружия","{"#cWH"}Сколько патронов вы хотите использовать для этого оружия?", "Собрать", "Отмена" ) ;
			set_player_use_listitem ( playerid, listitem ) ;
			return 1 ;
		}
		case d_makegun_:
		{
			if ( ! response )
			{
			    global_string [ 0 ] = EOS ;
			    global_string = "{"#cBL"}Название оружия:\t{"#cBL"}Количество ед.оружия:\n";
				for ( new i = 0 ; i < 7; i ++ )
				{
				    format ( global_string, 1000, "%s%s\t%i\n", global_string, mg_info [ i ][ mg_name ], mg_info [ i ] [ mg_guns ] ) ;
				}
				show_dialog ( playerid, d_makegun, DIALOG_STYLE_TABLIST_HEADERS, "{"#cBHD"}Сборка оружия", global_string, "Выбрать", "Закрыть" ) ;
				return 1 ;
			}

   			new ammos = strval ( inputtext ) ;
   			new listitem_gun = get_player_use_listitem ( playerid ) ;
			if ( ammos < 1 || ammos > 500 )
			{
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Можно сделать от {"#cRD"}1 {"#cGRInfo"}до {"#cRD"}500{"#cGRInfo"}." ) ;
				return show_dialog ( playerid, d_makegun_, DIALOG_STYLE_INPUT, "{"#cBHD"}Сборка оружия","{"#cWH"}Сколько патронов вы хотите использовать для этого оружия?", "Собрать", "Отмена" ) ;
			}
			if ( GetInventoryFindItem ( playerid, SUB_INVENTORY, 2154 ) < ammos ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У вас нет столько патронов." ) ;

			if ( p_t_info [ playerid ] [ t_robbery ] != -1 )
			{
				new _team = p_t_info [ playerid ] [ t_robbery ] ;

				foreach(new i: robbery_team[_team])
				{
				    if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ i ] [ p_pos ] [ 0 ], p_t_info [ i ] [ p_pos ] [ 1 ], p_t_info [ i ] [ p_pos ] [ 2 ] ) )
				         return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Ваша команда не рядом с Вами." ) ;

					break ;
				}

			    if ( bank_progress [ _team ] == 2 )
				{
					bank_progress [ _team ] = 3 ;
					step_bank_robbery ( _team, bank_progress [ _team ] ) ;

					foreach(new i: robbery_team[_team])
					{
					    PlayerTextDrawSetString ( i, robbery_ptd [ i ] [ 10 ], "+" ) ;
					    give_weapon ( i, mg_info [ listitem_gun ] [ mg_gunid ], ammos ) ;
					}

					static const _str [ ] = "* [ROBBERY] %s[%d] приобрел(а) оружие! Задачи обновлены. (/ba_robbery)" ;
					new scm_string [ sizeof _str + 24 + 4 ] ;
					format ( scm_string, sizeof scm_string, _str, p_info [ playerid ] [ name ], playerid ) ;
					robbery_message ( _team, col_lblue, scm_string ) ;
				}
			}

		    give_weapon ( playerid, mg_info [ listitem_gun ] [ mg_gunid ], ammos ) ;

			me_action ( playerid, "сделал(-а) оружие из деталей" ) ;
			SetPlayerChatBubble ( playerid, "собрал оружие", col_light_purple, 30.0, 10000 ) ;

            clear_inventory ( playerid, 2154, ammos ) ;
            if ( GetPlayerWeapon ( playerid ) != mg_info [ listitem_gun ] [ mg_gunid ] )
            {
            	clear_inventory ( playerid, 2153, mg_info [ listitem_gun ] [ mg_guns ] ) ;
			}
		    return 1 ;
		}
		case d_gun_sell_accept:
		{
			if ( seller_id [ playerid ] == INVALID_PLAYER_ID ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Продавец покинул игру." ) ;
			if ( ! response )
			{
				SendClientMessage ( seller_id [ playerid ], col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок отказался от покупки оружия." ) ;
				clear_sell_params ( playerid, seller_id [ playerid ] ) ;
				return 1 ;
			}

			if ( p_info [ playerid ] [ money ] < sell_price [ seller_id [ playerid ] ] )
			{
				SendClientMessage ( seller_id [ playerid ], col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока недостаточно денег для приобретения." ) ;
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас недостаточно денег для приобретения." ) ;
				clear_sell_params ( playerid, seller_id [ playerid ] ) ;
				return 1 ;
			}
			new weapon_id = GetPVarInt ( seller_id [ playerid ], "sell_gunid" ) ;
			new weapon_slot = get_weapon_slot ( weapon_id ) ;
			new target_id = seller_id [ playerid ] ;
			if ( p_t_info [ seller_id [ playerid ] ] [ p_gun_ammo ] [ weapon_slot ] < sell_item [ target_id ] )
			{
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока нет такого количества патронов." ) ;
				SendClientMessage ( seller_id [ playerid ], col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет такого количества патронов." ) ;
				clear_sell_params ( playerid, target_id ) ;
				return 1 ;
			}
			if ( p_t_info [ seller_id [ playerid ] ] [ p_gun_slot ] [ weapon_slot ] != weapon_id )
			{
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока уже нет этого оружия." ) ;
				SendClientMessage ( seller_id [ playerid ], col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас уже нет оружия, которое Вы хотели продать." ) ;
				clear_sell_params ( playerid, target_id ) ;
				return 1 ;
			}

			give_money ( playerid, - sell_price [ target_id ] ) ;
			give_money ( target_id, sell_price [ target_id ] ) ;

			insert_money_log ( target_id, playerid, sell_price [ target_id ], "sellgun" ) ;

			give_weapon ( playerid, weapon_id, sell_item [ target_id ] ) ;
			give_weapon ( target_id, weapon_id, - sell_item [ target_id ] ) ;
			new gun_name [ 24 ] ;
			GetWeaponName( weapon_id, gun_name, sizeof ( gun_name ) ) ;


			new string [ 82 ];
			format ( string, sizeof ( string ),"{"#cGN"}* %s {"#cWH"}купил %s.", p_info [ playerid ] [ name ], gun_name ) ;
			SendClientMessage ( target_id, col_white, string ) ;
			format ( string, sizeof ( string ),"{"#cGInfo"}* {"#cWH"}Вы купили %s у {"#cGN"}%s", gun_name, p_info [ target_id ] [ name ] ) ;
			SendClientMessage ( playerid, col_white, string ) ;
			format ( string, sizeof ( string ),"передал(-а) оружие %s", p_info [ playerid ] [ name ] ) ;
			me_action ( target_id, string ) ;

			clear_sell_params ( playerid, target_id ) ;
			DeletePVar ( target_id, "sell_gunid" ) ;

			mysql_tquery ( sql_connection, "UPDATE `server_info` SET `serv_nelegal_gun` = `serv_nelegal_gun` + 1" ) ;

			gunrow ++ ;
			return 1 ;
		}
		case d_drugs_sell_accept:
		{
			if ( seller_id [ playerid ] == INVALID_PLAYER_ID ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Продавец покинул игру." ) ;
			if ( ! response )
			{
				SendClientMessage ( seller_id [ playerid ], col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок отказался от покупки наркотиков." ) ;
				clear_sell_params ( playerid, seller_id [ playerid ] ) ;
				return 1 ;
			}
			if ( p_info [ playerid ] [ money ] < sell_price [ seller_id [ playerid ] ] )
			{
				SendClientMessage ( seller_id [ playerid ], col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока недостаточно денег для приобретения." ) ;
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас недостаточно денег для приобретения." ) ;
				clear_sell_params ( playerid, seller_id [ playerid ] ) ;
				return 1 ;
			}
            new target_id = seller_id [ playerid ] ;
			if ( GetInventoryFindItem ( target_id, SUB_INVENTORY, 2155 ) < sell_item [ target_id ] )
			{
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока нет такого количества наркотиков." ) ;
				SendClientMessage ( seller_id [ playerid ], col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет такого количества наркотиков." ) ;
				clear_sell_params ( playerid, target_id ) ;
				return 1 ;
			}
			if ( GetInventoryFindItem ( playerid, SUB_INVENTORY, 2155 ) + sell_item [ target_id ] > 500 )
			{
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете унести более {"#cRD"}500 {"#cGRInfo"}гр. наркотиков." ) ;
				SendClientMessage ( seller_id [ playerid ], col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не может унести более {"#cRD"}500 {"#cGRInfo"}гр. наркотиков." ) ;
				clear_sell_params ( playerid, target_id ) ;
				return 1 ;
			}

			give_money ( playerid, - sell_price [ target_id ] ) ;
			give_money ( target_id, sell_price [ target_id ] ) ;

			insert_money_log ( target_id, playerid, sell_price [ target_id ], "selldrugs" ) ;

            give_inventory ( playerid, 2155, sell_item [ target_id ], 0, "", "", NUMBERPLATE_TYPE_NONE, 0 ) ;
			clear_inventory ( target_id, 2155, sell_item [ target_id ] ) ;

			mysql_tquery ( sql_connection, "UPDATE `server_info` SET `serv_nelegal_drugs` = `serv_nelegal_drugs` + 1" ) ;

			new string [ 108 ];
			format ( string, sizeof ( string ),"{"#cGInfo"}* %s {"#cWH"}купил у Вас {"#cGN"}%d {"#cWH"}гр. наркотиков.", p_info [ playerid ] [ name ], sell_item [ target_id ] ) ;
			SendClientMessage ( target_id, col_white, string ) ;
			format ( string, sizeof ( string ),"{"#cGInfo"}* {"#cWH"}Вы купили {"#cGN"}%d {"#cWH"}гр. наркотиков у {"#cGN"}%s", sell_item [ target_id ], p_info [ target_id ] [ name ] ) ;
			SendClientMessage ( playerid, col_white, string ) ;
			SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Используйте {"#cBL"}/dropdrugs{"#cWH"}, если хотите их выбросить." ) ;

			format ( string, sizeof ( string ),"передал(-а) пакетик %s", p_info [ playerid ] [ name ] ) ;
			me_action ( target_id, string ) ;

			clear_sell_params ( playerid, target_id ) ;
			DeletePVar ( target_id, "sell_gunid" ) ;
			return 1 ;
		}
		case d_dorm:
		{
			if ( ! response ) return 1 ;
			switch ( listitem )
			{
			    case 0:
			    {
			        if ( p_info [ playerid ] [ hour_played ] < FIVE_HOUR_PLAYED ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Доступно с 5 часов в игре. Используйте /mm - Информация о персонаже - Статистика персонажа." ) ;

					#if defined m_inventory_module
					    used_inventory [ playerid ] = true ;
						toggle_controlable ( playerid, false ) ;

						new _f_id = p_info [ playerid ] [ member ], _str [ 32 ] ;
						SetInventoryItem ( playerid ) ;
						setInventoryLayout ( playerid, 1 ) ;
						setInventoryWarehouse ( playerid, SUB_INV_FRACTION, _f_id ) ;
						set_inventory_button ( playerid, SUB_INV_FRACTION ) ;
						format ( _str, sizeof _str, "%s", GetPlayerCashValueToSmile ( f_info [ _f_id - 1 ] [ f_money ] ) ) ;
						setWarehouseInfo (
							playerid,
							"Склад организации",
							"Здесь хранятся предметы, которые\nв организации",
							"ОРГАНИЗАЦИЯ",
							"ДЕНЕГ В ОРГАНИЗАЦИИ",
							f_info [ _f_id - 1 ] [ f_name ],
							_str
						) ;
					#endif
			    }
				case 1: show_dialog ( playerid, d_money_put, DIALOG_STYLE_INPUT, "{"#cBHD"}Положить деньги:","{"#cWH"}Введите количество денег, которое желаете положить:","Положить","Назад");
				case 2:
				{
					if ( f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_dorm_status ] )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Общак закрыт." ) ;
					show_dialog ( playerid, d_money_get, DIALOG_STYLE_INPUT, "{"#cBHD"}Взять деньги:", "{"#cWH"}Введите количество денег, которое желаете взять:","Взять","Назад");
				}
			}
			return 1 ;
		}
		case d_money_get:
		{
			if ( ! response )return show_dorm ( playerid ) ;
			if ( p_info [ playerid ] [ leader ] == 0 ) return show_dialog ( playerid, d_money_get,DIALOG_STYLE_INPUT, "{"#cBHD"}Взять деньги:","{"#cRInfo"}* {"#cGRInfo"}Только лидер может брать деньги с общака.\n\n{"#cWH"}Введите количество денег, которое желаете взять:","Взять","Назад") ;
			new d_amount = strval ( inputtext ), fractionid = p_info [ playerid ] [ member ] ;

			if ( d_amount < 1 || d_amount > 100000 ) return show_dialog ( playerid, d_money_get,DIALOG_STYLE_INPUT, "{"#cBHD"}Взять деньги:","{"#cRInfo"}* {"#cGRInfo"}Количество денег должно быть от {"#cRD"}1"valute_title_" {"#cGRDialog"}до {"#cRD"}100.000"valute_title_"\n\n{"#cWH"}Введите количество денег, которое желаете взять:","Взять","Назад") ;
			if ( f_info [ fractionid - 1 ] [ f_money ] < d_amount ) return show_dialog ( playerid, d_money_get,DIALOG_STYLE_INPUT, "{"#cBHD"}Взять деньги:","{"#cRInfo"}* {"#cGRInfo"}На складе нет такого количества денег.\n\n{"#cWH"}Введите количество денег, которое желаете взять:","Взять","Назад") ;

			if ( f_info [ fractionid - 1 ] [ f_money_limit ] + d_amount > 500000 )
			{
				new query_string [ 96 ];

				format ( query_string, sizeof ( query_string ), "{"#cRInfo"}* {"#cGRInfo"}Лимит снятия средств в сутки. Остаток: {"#cRD"}%d"valute_title"{"#cGRInfo"}.", 500000 - f_info [ fractionid - 1 ] [ f_money_limit ] ) ;
				SendClientMessage ( playerid, col_gray, query_string ) ;
				return 1 ;
			}
			f_info [ fractionid - 1 ] [ f_money_limit ] += d_amount ;
			f_info [ fractionid - 1 ] [ f_money ] -= d_amount ;
			give_money ( playerid, d_amount ) ;
			insert_money_log ( playerid, INVALID_PLAYER_ID, d_amount, "взял со склада" ) ;

			new query_string [ 128 ];
			format ( query_string, 86, "UPDATE `fractions` SET `f_money` = '%d' WHERE `f_id` = '%d' LIMIT 1",
			f_info [ fractionid - 1 ] [ f_money ], fractionid ) ;
			mysql_tquery ( sql_connection, query_string, "", "" ) ;

			format(query_string, sizeof ( query_string ), "[F] %s %s [id %d] взял(а) со склада {3399FF}%i"valute_title_"", f_rank [ fractionid - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], playerid, d_amount);
            fraction_message ( fractionid, col_lblue, query_string ) ;

            format ( query_string, 128, "Взял(а) со склада %d"valute_title"", d_amount ) ;
			write_fraction ( playerid, fractionid, TYPE_LOG_OBWYAK, query_string ) ;

			update_gdorm_text ( fractionid ) ;
   			show_dorm ( playerid ) ;
			return 1 ;
		}
		case d_money_put:
		{
			if ( ! response )return show_dorm ( playerid ) ;
			new d_amount = strval ( inputtext ), fractionid = p_info [ playerid ] [ member ] ;

			if ( d_amount < 1 || d_amount > 1000000) return show_dialog ( playerid, d_money_put,DIALOG_STYLE_INPUT, "{"#cBHD"}Положить деньги:","{"#cRD"}* Количество денег не может быть меньше {"#cRD"}1"valute_title_" или больше 1.000.000"valute_title_"\n\n{"#cWH"}Введите количество денег, которое желаете положить:","Положить","Назад") ;
			if ( p_info [ playerid ] [ money ] < d_amount ) return show_dialog ( playerid, d_money_put,DIALOG_STYLE_INPUT, "{"#cBHD"}Положить деньги:","{"#cRInfo"}* {"#cGRInfo"}У Вас нет такого количества денег.\n\n{"#cWH"}Введите количество денег, которое желаете положить:","Положить","Назад") ;

			f_info [ fractionid - 1 ] [ f_money ] += d_amount ;
			give_money ( playerid, - d_amount ) ;
			insert_money_log ( playerid, INVALID_PLAYER_ID, - d_amount, "положил на склад" ) ;

			new query_string [ 128 ];
			format ( query_string, 86, "UPDATE `fractions` SET `f_money` = '%d' WHERE `f_id` = '%d' LIMIT 1",
			f_info [ fractionid - 1 ] [ f_money ], fractionid ) ;
			mysql_tquery ( sql_connection, query_string, "", "" ) ;

			format(query_string, sizeof ( query_string ), "[F] %s %s [id %d] положил(а) на склад {3399FF}%i"valute_title_"", f_rank [ fractionid - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], playerid, d_amount);
			fraction_message ( fractionid, col_lblue, query_string ) ;

			format ( query_string, 128, "Положил(а) на склад %d"valute_title"", d_amount ) ;
			write_fraction ( playerid, fractionid, TYPE_LOG_OBWYAK, query_string ) ;

			update_gdorm_text ( fractionid ) ;
   			show_dorm ( playerid ) ;
			return 1 ;
		}
		case d_lspd_payments:
		{
			if ( ! response ) return 1 ;
			switch ( listitem )
			{
				case 0:
				{
					show_dialog ( playerid, d_bail, DIALOG_STYLE_INPUT, "{"#cBHD"}Выплата залога", "{ffffff}Введите ID или имя игрока, за которого хотите внести залог:", "Принять", "Назад" ) ;
				}
				case 1:
				{
					show_dialog ( playerid, d_bail_info, DIALOG_STYLE_INPUT, "{"#cBHD"}Информация о залоге", "{ffffff}Введите ID или имя игрока, информацию о залоге которого хотите узнать:", "Принять", "Назад" ) ;
				}
				case 2:
				{
				    if ( p_info [ playerid ] [ leader ] && cop_player ( playerid ) )
					{
				    	page_count [ playerid ] = 1 ;

						new string [ 144 ] ;
						format ( string, sizeof string, "SELECT `u_id`, `u_fromname`, `u_toname`, `u_date` FROM `users_complaints` WHERE `u_fraction` = '%d' ORDER BY `users_complaints`.`u_id` DESC", p_info [ playerid ] [ member ] ) ;
						mysql_tquery ( sql_connection, string, "show_complaints", "i", playerid ) ;

						return 1 ;
					}
					show_dialog ( playerid, d_cop_complaints, DIALOG_STYLE_INPUT, "{"#cBHD"}Книга жалоб", "{"#cWH"}Введите ID игрока и причину жалобы чтобы пожаловатся:\n{"#cGRDialog"}Пример: {"#cBL"}'30, Плохо работает'", "Далее", "Назад" ) ;
				}
				case 3:
				{
        			if ( p_info [ playerid ] [ hour_played ] < THREE_HOUR_PLAYED ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Доступно с 3 часов в игре. Используйте /mm - Информация о персонаже - Статистика персонажа." ) ;

					show_window_plate ( playerid ) ;
				}
			}
			return 1 ;
		}
		case d_reg_vehicle:
		{
		    if ( ! response )
			{
				clear_player_listitem_values ( playerid ) ;
				show_lspdpayments ( playerid ) ;
				return 1 ;
			}

			new veh_id = get_player_listitem_values ( playerid, listitem ) ;
			clear_player_listitem_values ( playerid ) ;

			set_player_use_listitem ( playerid, veh_id ) ;

			show_window_plate ( playerid ) ;
			return 1 ;
		}
		case d_reg_vehicle_1:
		{
			if ( ! response )
			{
				show_lspdpayments ( playerid ) ;
				return 1 ;
			}

			new _price = price_reg_veh * for_tax [ 5 ] ;
			if ( p_info [ playerid ] [ money ] < _price )
			{
			    show_lspdpayments ( playerid ) ;
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас недостаточно средств." ) ;
				return 1 ;
			}

			new veh_id = get_player_use_listitem ( playerid ) ;

			veh_info [ veh_id - 1 ] [ v_plate_type ] = listitem + 2 ;
			switch ( listitem + 2 )
			{
			    case 2:
			    {
		     		format ( veh_info [ veh_id - 1 ] [ v_plate ], 12, "%s%d%d%d%s%s", veh_number ( listitem + 2 ), random ( 9 ), random ( 9 ), random ( 9 ), veh_number ( listitem + 2 ), veh_number ( listitem + 2 ) ) ;
					format ( veh_info [ veh_id - 1 ] [ v_region ], 10, "%s", veh_region ( ) ) ;
			    }
			    case 3:
			    {
					format ( veh_info [ veh_id - 1 ] [ v_plate ], 12, "%s%s %d%d%d%d %s%s", veh_number ( listitem + 2 ), veh_number ( listitem + 2 ), random ( 9 ), random ( 9 ), random ( 9 ), random ( 9 ), veh_number ( listitem + 2 ), veh_number ( listitem + 2 ) ) ;
					format ( veh_info [ veh_id - 1 ] [ v_region ], 10, "%s", veh_region ( ) ) ;
			    }
			    case 4:
			    {
					format ( veh_info [ veh_id - 1 ] [ v_plate ], 12, "%d%d%d%d %s%s-%d", random ( 9 ), random ( 9 ), random ( 9 ), random ( 9 ), veh_number ( listitem + 2 ), veh_number ( listitem + 2 ), random ( 9 ) ) ;
					format ( veh_info [ veh_id - 1 ] [ v_region ], 10, "%s", veh_region ( ) ) ;
			    }
			    case 5:
			    {
					format ( veh_info [ veh_id - 1 ] [ v_plate ], 12, "%d%d%d%s%s%s", random ( 9 ), random ( 9 ), random ( 9 ), veh_number ( listitem + 2 ), veh_number ( listitem + 2 ), veh_number ( listitem + 2 ) ) ;
					format ( veh_info [ veh_id - 1 ] [ v_region ], 10, "%s", veh_region ( ) ) ;
			    }
			}

			new query_string [ 144 ] ;
			format ( query_string, sizeof ( query_string ), "SELECT `v_id` FROM `users_vehicles` WHERE `v_plate_type` = '%d' AND `v_plate` = '%s' AND `v_region` = '%s' LIMIT 1", veh_info [ veh_id - 1 ] [ v_plate_type ], veh_info [ veh_id - 1 ] [ v_plate ], veh_info [ veh_id - 1 ] [ v_region ] ) ;
			mysql_tquery ( sql_connection, query_string, "callback_check_plate", "ii", playerid, veh_id ) ;
			return 1 ;
		}
		case d_bail:
		{
			if ( ! response )return show_lspdpayments ( playerid ) ;
			new targetid ;
			if ( sscanf ( inputtext, "u", targetid ) ) return show_dialog ( playerid, d_bail, DIALOG_STYLE_INPUT, "{"#cBHD"}Выплата залога", "{ffffff}Введите ID или имя игрока, за которого хотите внести залог:", "Принять", "Назад" ) ;
			if ( ! IsPlayerConnected ( targetid ) || p_t_info [ targetid ] [ p_logged ] == false || targetid == playerid ) return show_dialog ( playerid, d_bail, DIALOG_STYLE_INPUT, "{"#cBHD"}Выплата залога", "{"#cRInfo"}* {"#cGRInfo"}Данный игрок не найден.\n\n{ffffff}Введите ID или имя игрока, за которого хотите внести залог:", "Принять", "Назад" ) ;
			if ( p_info [ targetid ] [ jailed ] == 0 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данный игрок не находится под заключением." ),
														show_lspdpayments ( playerid ) ;

			if ( p_info [ targetid ] [ bail ] == 0 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}За данного игрока нельзя внести залог." ),
														show_lspdpayments ( playerid ) ;
			if ( p_info [ targetid ] [ bail ] > p_info [ playerid ] [ money ] )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас не хватает денег для внесения залога." ),
														show_lspdpayments ( playerid ) ;


			give_money ( playerid, -p_info [ targetid ] [ bail ] ) ;

            new _price = floatround ( ( p_info [ targetid ] [ bail ] * 25 ) / 100 ) ;
            set_money_fraction ( 3, 3, _price, true ) ;
            set_money_fraction ( 4, 3, _price, true ) ;
            set_money_fraction ( 5, 3, _price, true ) ;
            set_money_fraction ( 10, 4, _price, true ) ;

			p_info [ targetid ] [ jailed ] = 3 ;

			p_info [ targetid ] [ bail ] = 0 ;
			update_int_sql ( targetid, "u_bail", 0 ) ;

			new t_string [ 128 ] ;
			format ( t_string, sizeof ( t_string ), "{"#cGN"}* %s {"#cWH"}внёс за Вас залог, теперь Вы свободны.", p_info [ playerid ] [ name ] ) ;
			SendClientMessage ( targetid, col_white, t_string ) ;
			format ( t_string, sizeof ( t_string ), "{"#cGInfo"}* {"#cWH"}Вы внесли залог за {"#cGN"}%s{"#cWH"}, теперь он свободен.", p_info [ targetid ] [ name ] ) ;
			SendClientMessage ( playerid, col_white, t_string ) ;
			return 1 ;

		}
		case d_bail_info:
		{
			if ( ! response )return show_lspdpayments ( playerid ) ;
			new targetid ;
			if ( sscanf ( inputtext, "u", targetid ) ) return show_dialog ( playerid, d_bail, DIALOG_STYLE_INPUT, "{"#cBHD"}Выплата залога", "{ffffff}Введите ID или имя игрока, за которого хотите внести залог:", "Принять", "Назад" ) ;
			if ( ! IsPlayerConnected ( targetid ) || p_t_info [ targetid ] [ p_logged ] == false || targetid == playerid ) return show_dialog ( playerid, d_bail, DIALOG_STYLE_INPUT, "{"#cBHD"}Выплата залога", "{"#cRInfo"}* {"#cGRInfo"}Данный игрок не найден.\n\n{ffffff}Введите ID или имя игрока, за которого хотите внести залог:", "Принять", "Назад" ) ;
			if ( p_info [ targetid ] [ jailed ] == 0 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данный игрок не находится под заключением." ),
														show_lspdpayments ( playerid ) ;
			if ( p_info [ targetid ] [ bail ] == 0 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}За данного игрока нельзя внести залог." ),
														show_lspdpayments ( playerid ) ;

			new dialog_string [ 117 + MAX_PLAYER_NAME + 9 ] ;
			format ( dialog_string, sizeof ( dialog_string ),
			"{"#cBL"}\t\tВЫПИСКА ИЗ ДЕЛА\n\n{"#cGRDialog"}Имя заключенного: {"#cBL"}%s\n{"#cGRDialog"}Сумма залога: {"#cBL"}%d"valute_title_"",
			p_info [ targetid ] [ name ], p_info [ targetid ] [ bail ] ) ;

			show_dialog ( playerid, d_bail_info_list, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Информация о залоге", dialog_string, "Назад", "" ) ;
			return 1 ;
		}
		case d_bail_info_list:
		{
			show_lspdpayments ( playerid ) ;
			return 1 ;
		}
		case d_duty:
		{
			if ( ! response ) return 1 ;

			new _listitem = get_player_listitem_values ( playerid, listitem ),
				_fr_id = p_info [ playerid ] [ member ],
				_fr_skin = f_skin_rank [ _fr_id - 1 ] [ p_info [ playerid ] [ gender ] ] [ _listitem ] ;
			if ( p_info [ playerid ] [ org_skin ] != _fr_skin )
			{
			    if ( p_info [ playerid ] [ rank ] < _listitem + 1 )
			    {
			        show_fraction_duty ( playerid ) ;
			        return 1 ;
			    }

			    p_info [ playerid ] [ org_skin ] = _fr_skin ;

				static const _str [ ] = "UPDATE `fractions_players` SET `u_org_skin` = '%d' WHERE `u_sql_id` = '%d' LIMIT 1" ;
				new query_string [ sizeof _str + ( 2 * 9 ) ] ;
				format ( query_string, sizeof query_string, _str, _fr_skin, p_info [ playerid ] [ id ] ) ;
				mysql_tquery ( sql_connection, query_string ) ;
			}

			is_fraction_duty { playerid } = 1 ;
			SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы начали рабочий день." ) ;

			fraction_duty ( playerid ) ;

			if ( radio_player ( playerid ) ) give_weapon ( playerid, 43, 50 ) ;
			return 1 ;
		}
		case d_duty_end:
		{
		    if ( ! response ) return 1 ;

		    is_fraction_duty { playerid } = 0 ;
			SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы завершили рабочий день." ) ;

			fraction_duty ( playerid ) ;

			if ( cop_player ( playerid ) || fbi_player ( playerid ) || army_player ( playerid ) || prison_player ( playerid ) )
