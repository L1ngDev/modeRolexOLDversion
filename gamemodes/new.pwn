			if ( p_info [ target_id ] [ member ] != b_info [ b_sell_id ] [ b_mafia ] )
			{
				SendClientMessage ( target_id, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данный бизнес уже не подконтролен Вам." ) ;
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данный бизнес уже не подконтролен игроку." ) ;
				clear_sell_params ( playerid, target_id ) ;
				return 1 ;
			}
			b_info [ b_sell_id ] [ b_mafia ] = p_info [ playerid ] [ member ] ;

			new _text_string [ 128 ] ;
			format ( _text_string, sizeof( _text_string ), "{"#cGInfo"}* {"#cWH"}Вы купили контроль над бизнесом {"#cGN"}%s{"#cWH"} за {"#cGN"}%d"valute_title"{"#cWH"}.", b_info [ b_sell_id ] [ b_name ], sell_price [ target_id ] ) ;
			SendClientMessage ( playerid, col_white, _text_string ) ;
			format( _text_string, sizeof ( _text_string ), "{"#cGInfo"}* {"#cWH"}Вы продали контроль над бизнесом {"#cGN"}%s{"#cWH"} за {"#cGN"}%d"valute_title"{"#cWH"}.", b_info [ b_sell_id ] [ b_name ], sell_price [ target_id ] ) ;
			SendClientMessage ( target_id, col_white, _text_string ) ;

			give_money ( playerid, -sell_price [ target_id ] ) ;
			give_money ( seller_id [ playerid ], sell_price [ target_id ] ) ;
			insert_money_log ( target_id, playerid, sell_price [ target_id ], "sellbiz" ) ;

			update_blabel ( b_sell_id ) ;

			new query_string [ 71 + 9 + 9 ] ;
			format ( query_string, sizeof query_string, "UPDATE `businesses` SET `b_mafia` = '%d' WHERE `b_id` = '%d' LIMIT 1", b_info [ b_sell_id ] [ b_mafia ], b_info [ b_sell_id ] [ b_id ] ) ;
			mysql_tquery ( sql_connection, query_string ) ;

			clear_sell_params ( playerid, target_id ) ;
			return 1 ;
		}
		case d_fbi_cover_rank:
		{
			if ( ! response ) return DeletePVar ( playerid, "cover_id" ) ;

			new _player_id = GetPVarInt ( playerid, "cover_id" ) ;
			cover_rank [ _player_id ] = listitem + 1 ;

			show_cover ( playerid ) ;
			return 1 ;
		}
		case d_fbi_cover_name:
		{
		    if ( ! response )
		    {
		        show_cover ( playerid ) ;
			    return 1 ;
		    }

		    if ( ! strlen ( inputtext ) )
			{
				show_dialog ( playerid, d_fbi_cover_name, DIALOG_STYLE_INPUT, "{"#cBHD"}Имя","{"#cRD"}* Вы ввели некорректный формат никнейма.\n\n{"#cWH"}Укажите новое имя для агента:","Выбрать", "Отмена");
				return 1 ;
			}
			if ( is_text_invalid_name ( inputtext ) )
			{
				show_dialog ( playerid, d_fbi_cover_name, DIALOG_STYLE_INPUT, "{"#cBHD"}Имя","{"#cRD"}* Вы ввели некорректный формат никнейма.\n\n{"#cWH"}Укажите новое имя для агента:","Выбрать", "Отмена");
				return 1 ;
			}
			if ( strlen ( inputtext ) < 6 || strlen ( inputtext ) > 24 )
			{
				show_dialog ( playerid, d_fbi_cover_name, DIALOG_STYLE_INPUT, "{"#cBHD"}Имя","{"#cRD"}* Вы ввели некорректный формат никнейма.\n\n{"#cWH"}Укажите новое имя для агента:","Выбрать", "Отмена");
				return 1 ;
			}
			if ( ! IsARPName( inputtext ) )
			{
				show_dialog ( playerid, d_fbi_cover_name, DIALOG_STYLE_INPUT, "{"#cBHD"}Имя","{"#cRD"}* Вы ввели некорректный формат никнейма.\n\n{"#cWH"}Укажите новое имя для агента:","Выбрать", "Отмена");
				return 1 ;
			}

			new sql_string [ 59 + MAX_PLAYER_NAME ] ;
			format ( sql_string, sizeof sql_string, "SELECT `u_id` FROM `users` WHERE `u_name` = '%s' LIMIT 1", inputtext ) ;
			mysql_tquery ( sql_connection, sql_string, "callback_fbi_cover", "is", playerid, inputtext ) ;
			return 1 ;
		}
		case d_fbi_cover:
		{
		    if ( ! response ) return DeletePVar ( playerid, "cover_id" ) ;

			switch ( listitem )
			{
				case 0:
				{
				    show_cover ( playerid ) ;
				}
				case 1: show_dialog ( playerid, d_fbi_cover_name, DIALOG_STYLE_INPUT, "{"#cBHD"}Имя", "{"#cWH"}Укажите новое имя для агента:", "Выбрать", "Отмена" ) ;
				case 2:
				{
				    global_string [ 0 ] = EOS ;
					new row_count = 0 ;
					for ( new j = 0 ; j < max_fraction ; j ++ )
					{
				     	if ( j == 6 || j == 10 || j == 11 || j == 12 || j == 13 || j == 14 || j == 16 || j == 17 || j == 18 || j == 19 || j == 20 || j == 21 || j == 26 || j == 27 || j == 28 ) continue ;

				     	set_player_listitem_values ( playerid, row_count, j ) ;

				     	row_count ++ ;

						new line_string [ 64 ] ;
						format ( line_string, sizeof line_string, "{%s}%s\n", f_info [ j ] [ f_chat_color ], f_info [ j ] [ f_name ] ) ;
						strcat ( global_string, line_string ) ;
					}
					show_dialog ( playerid, d_fbi_cover_fraction_skin, DIALOG_STYLE_LIST, "{"#cBHD"}Маскировка", global_string, "Выбрать", "Закрыть" ) ;
				}
				case 3:
				{
				    new player_id = GetPVarInt ( playerid, "cover_id" ) ;
                    if ( ! cover_fraction [ player_id ] || ! IsPlayerConnected ( player_id ) || p_info [ player_id ] [ member ] != p_info [ playerid ] [ member ] )
				    {
				        SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не выбрали организацию!" ) ;

				        show_cover ( playerid ) ;
				        return 1 ;
				    }

				    global_string [ 0 ] = EOS ;
					new line_string [ 72 ] ;
					for ( new j = 0 ; j < f_info [ cover_fraction [ player_id ] - 1 ] [ f_rank_settings ] [ 0 ] - 2 ; j ++ )
					{
						format ( line_string, 72, "{"#cBL"}%i. {"#cWH"}%s\n", j + 1, f_rank [ cover_fraction [ player_id ] - 1 ] [ j ] ) ;
						strcat ( global_string, line_string ) ;
					}
					show_dialog ( playerid, d_fbi_cover_rank, DIALOG_STYLE_LIST, "{"#cBHD"}Должность", global_string, "Выбрать", "Закрыть" ) ;
				}
				case 4:
				{
				    new player_id = GetPVarInt ( playerid, "cover_id" ) ;
				    if ( ! IsPlayerConnected ( player_id ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
                    if ( player_id == 0 || ! cover_fraction [ player_id ] || ! cover_rank [ player_id ] || ! IsPlayerConnected ( player_id ) || p_info [ player_id ] [ member ] != p_info [ playerid ] [ member ] )
				    {
				        SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы указали не все параметры!" ) ;

				        show_cover ( playerid ) ;
				        return 1 ;
				    }

				    new sql_str [ 256 ] ;
					new fraction_id = cover_fraction [ player_id ], rank_id = cover_rank [ player_id ] ;

					if ( ! GetString ( cover_name [ player_id ], "None" ) )
					{
					    format ( is_fraction_cover_real_name [ player_id ], MAX_PLAYER_NAME, "%s", p_info [ player_id ] [ name ] ) ;
					    format ( is_fraction_cover_name [ player_id ], MAX_PLAYER_NAME, "%s", cover_name [ player_id ] ) ;

					    format ( sql_str, 144, "UPDATE `users` SET `u_cover_name` = '%s', `u_cover_real_name` = '%s' WHERE `u_id` = '%d' LIMIT 1", cover_name [ player_id ], p_info [ player_id ] [ name ], p_info [ player_id ] [ id ] ) ;
						mysql_tquery ( sql_connection, sql_str, "", "" ) ;

					    SetPlayerName ( player_id, cover_name [ player_id ] ) ;
						GetPlayerName ( player_id, p_info [ player_id ] [ name ], MAX_PLAYER_NAME ) ;
					}

					SetPlayerColor ( player_id, f_info [ fraction_id - 1 ] [ f_radar_color ] ) ;

					is_fraction_cover { player_id } = p_info [ player_id ] [ member ] ;
					is_fraction_cover_rank { player_id } = p_info [ player_id ] [ rank ] ;

					p_info [ player_id ] [ member ] = fraction_id ;
					Iter_Add(fraction_players[fraction_id], player_id);
					p_info [ player_id ] [ rank ] = rank_id ;

					is_fraction_cover_skin [ player_id ] = p_info [ player_id ] [ org_skin ] ;

					p_info [ player_id ] [ org_skin ] = cover_skin [ player_id ] ;
					SetPlayerSkin ( player_id, p_info [ player_id ] [ org_skin ] ) ;

					sql_str [ 0 ] = EOS ;
					format ( sql_str, sizeof sql_str, "UPDATE `fractions_players` SET `u_fraction_cover` = '%d', `u_fraction_cover_rank` = '%d', `u_member` = '%d', `u_rank` = '%d',\
													`u_cover_skin` = '%d', `u_org_skin` = '%d' WHERE `u_sql_id` = '%d' LIMIT 1",
                    is_fraction_cover { player_id }, is_fraction_cover_rank { player_id },
					p_info [ player_id ] [ member ], p_info [ player_id ] [ rank ],
					is_fraction_cover_skin [ player_id ], p_info [ player_id ] [ org_skin ], p_info [ player_id ] [ id ] ) ;
					mysql_tquery ( sql_connection, sql_str ) ;

					is_fraction_duty { player_id } = 1 ;

					format ( sql_str, 128, "{"#cGInfo"}* {"#cWH"}Маскировка организации {%s}%s{"#cWH"} успешно надета.", f_info [ fraction_id - 1 ] [ f_chat_color ], f_info [ fraction_id - 1 ] [ f_name ] ) ;
					SendClientMessage ( player_id, col_white, sql_str ) ;

					format ( cover_name [ player_id ], 32, "None" ) ;

					cover_fraction [ player_id ] =
					cover_rank [ player_id ] = 0 ;

					DeletePVar ( playerid, "cover_id" ) ;
				}
			}
			return 1 ;
		}
		case d_fbi_cover_fraction_skin:
		{
			if ( ! response ) return DeletePVar ( playerid, "cover_id" ), clear_player_listitem_values ( playerid ) ;

			global_string [ 0 ] = EOS ;
			new fraction_id = get_player_listitem_values ( playerid, listitem ) ;
			clear_player_listitem_values ( playerid ) ;

			for ( new j = 0 ; j < max_rank ; j ++ )
			{
				if ( f_skin [ fraction_id ] [ p_info [ playerid ] [ gender ] ] [ j ] == 1 )break ;
				new line_string [ 64 ] ;
				format ( line_string, 64, "{"#cBL"}%d. {"#cWH"}Одежда №%d\n", j + 1, f_skin [ fraction_id ] [ p_info [ playerid ] [ gender ] ] [ j ] ) ;
				strcat ( global_string, line_string ) ;
			}

			SetPVarInt ( playerid, "cover_listitem", fraction_id ) ;
			show_dialog ( playerid, d_fbi_cover_skin, DIALOG_STYLE_LIST, "{"#cBHD"}Выбор одежды", global_string, "Выбрать", "Отмена" ) ;
			return 1 ;
		}
		case d_fbi_cover_skin:
		{
			if ( ! response ) return DeletePVar ( playerid, "cover_listitem" ), DeletePVar ( playerid, "cover_id" ) ;

			new fraction_cell = GetPVarInt ( playerid, "cover_listitem" ) ;
			DeletePVar ( playerid, "cover_listitem" ) ;

			new _player_id = GetPVarInt ( playerid, "cover_id" ) ;

			cover_fraction [ _player_id ] = fraction_cell + 1 ;
			cover_skin [ _player_id ] = f_skin [ fraction_cell ] [ p_info [ _player_id ] [ gender ] ] [ listitem ] ;

			show_cover ( playerid ) ;
			return 1 ;
		}
		case d_h_radio:
		{
			if ( ! response ) return 1 ;
			if ( h_info [ p_info [ playerid ] [ house ] - 1 ] [ h_radio_status ] == 0 )show_dialog ( playerid, d_h_radio_url, DIALOG_STYLE_INPUT, "{"#cBHD"}Аудио система", "{"#cWH"}Введи URL-ссылку для начала произведения аудио", "Принять", "Назад" ) ;
			else
			{
			    new house_id = p_info [ playerid ] [ house ] ;
				h_info [ house_id - 1 ] [ h_radio_status ] = 0 ;

				new sql_str [ 90 ] ;
				format ( sql_str, sizeof ( sql_str ), "UPDATE `houses` SET `h_radio_status` = '0' WHERE `h_id` = '%d' LIMIT 1", house_id ) ;
				mysql_tquery ( sql_connection, sql_str ) ;

				SendClientMessage ( playerid, col_succes, !"Аудио-система успешно выключена." ) ;
				foreach ( new i: streamed_players[playerid])
				{
					StopAudioStreamForPlayer ( i  ) ;
				}
				StopAudioStreamForPlayer ( playerid ) ;

			}
			return 1 ;
		}
		case d_h_radio_url:
		{
			if ( ! response )
			{
				if ( h_info [ p_info [ playerid ] [ house ] - 1 ] [ h_radio_status ] == 0 ) show_dialog ( playerid, d_h_radio, DIALOG_STYLE_LIST, "{"#cBHD"}Аудио система", "{"#cBL"}1.{"#cGN"} Включить аудио", "Выбрать", "Закрыть" ) ;
				else show_dialog ( playerid, d_h_radio, DIALOG_STYLE_LIST, "{"#cBHD"}Аудио система", "{"#cBL"}1.{"#cRD"} Выключить аудио", "Выбрать", "Закрыть" ) ;
				return 1 ;
			}
			new house_id = p_info [ playerid ] [ house ] ;
			format ( h_info [ house_id - 1 ] [ h_radio_url ], 128, "%s", inputtext ) ;

			foreach ( new i:streamed_players[playerid])
			{
				PlayAudioStreamForPlayer ( i, h_info [ house_id - 1 ] [ h_radio_url ]);
			}
			PlayAudioStreamForPlayer ( playerid, h_info [ house_id - 1 ] [ h_radio_url ]);
			SendClientMessage ( playerid, col_succes, !"Аудио-система успешно включена." ) ;

			h_info [ house_id - 1 ] [ h_radio_status ] = 1 ;
			new sql_str [ 98 + 128 ] ;
			mysql_format ( sql_connection, sql_str, sizeof ( sql_str ), "UPDATE `houses` SET `h_radio_status`='1',`h_radio_url`='%e' WHERE `h_id`='%d' LIMIT 1",
			inputtext, house_id ) ;
			mysql_tquery ( sql_connection, sql_str ) ;
			return 1 ;
		}
		case d_ffind:
		{
			if ( ! response ) return clear_player_listitem_values ( playerid ) ;

			new fraction_id = get_player_listitem_values ( playerid, listitem ) ;
			clear_player_listitem_values ( playerid ) ;

			show_find ( playerid, fraction_id + 1 ) ;
			return 1 ;
		}
		case d_ssf:
		{
			if ( ! response ) return clear_player_listitem_values ( playerid ) ;

			new fraction_id = get_player_listitem_values ( playerid, listitem ) ;
			clear_player_listitem_values ( playerid ) ;

			if ( listitem == get_player_use_page ( playerid, 0 ) ) player_ssf { playerid } = 255 ;
			else player_ssf { playerid } = fraction_id + 1 ;

			SendClientMessage ( playerid, col_succes, !"Вы успешно подключились к рации организации. Используйте /sf для связи." ) ;
			return 1 ;
		}
		case d_giveleader:
		{
			if ( ! response ) return clear_player_listitem_values ( playerid ), clear_player_use_page ( playerid ) ;
			new targetid = GetPVarInt ( playerid, "pl_giveleader_id" ) ;
			DeletePVar ( playerid, "pl_giveleader_id" ) ;

			if ( listitem == get_player_use_page ( playerid, 0 ) )
            {
                clear_player_use_page ( playerid ) ;

                new fraction_id = get_player_listitem_values ( playerid, listitem ) + 1 ;
				clear_player_listitem_values ( playerid ) ;

                if ( p_info [ targetid ] [ leader ] == 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не является лидером." ) ;
				if ( p_info [ targetid ] [ leader ] != 0 && ! medic_player ( targetid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не подчиняется Вам." ) ;

				new _reason [ ] = "Срок." ;

				new scm_string [ 286 ] ;
				format ( scm_string, 144, "Вы успешно сняли %s с должности лидера организации \"{"#cWH"}%s{"#cGRInfo"}\"", p_info [ targetid ] [ name ], f_info [ p_info [ targetid ] [ member ] - 1 ] [ f_name ] ) ;
				SendClientMessage ( playerid, col_succes, scm_string ) ;
				format ( scm_string, 144, "Министр %s снял Вас с должности лидера организации \"{"#cWH"}%s{"#cGRInfo"}\"", p_info [ playerid ] [ name ], f_info [ p_info [ targetid ] [ member ] - 1 ] [ f_name ] ) ;
				SendClientMessage ( targetid, col_succes, scm_string ) ;

				format( scm_string, 144, "{"#cBAdmin"}[A] {"#cGRAdmin"}Министр %s снял %s с должности лидера организации \"{"#cBAdmin"}%s{"#cGRAdmin"}\".", p_info [ playerid ] [ name ], p_info [ targetid ] [ name ], f_info [ p_info [ targetid ] [ member ] - 1 ] [ f_name ] ) ;
				foreach(new q: admin_players) SendClientMessage ( q, col_admin, scm_string ) ;

				insert_joblist ( targetid, _reason, LABOR_TYPE_UNINVITE, p_info [ targetid ] [ rank ] ) ;

				f_info [ fraction_id - 1 ] [ f_members ] -- ;
				format ( scm_string, 144, "UPDATE `fractions` SET `f_members` = '%d' WHERE `f_id` = '%d' LIMIT 1", f_info [ fraction_id - 1 ] [ f_members ], fraction_id ) ;
				mysql_tquery ( sql_connection, scm_string ) ;

				format ( scm_string, 128, "Уволил(а) %s. Причина: %s", p_info [ targetid ] [ name ], _reason ) ;
				write_fraction ( playerid, fraction_id, TYPE_LOG_UVAL, scm_string ) ;

				if ( fraction_id != 0 ) Iter_Remove(fraction_players[fraction_id], targetid);

				if ( gov_player ( targetid ) )
				{
				    if ( p_info [ targetid ] [ rank ] == f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 6 ] ||
						p_info [ targetid ] [ rank ] == f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 7 ] ||
						p_info [ targetid ] [ rank ] == f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 8 ] ||
						p_info [ targetid ] [ rank ] == f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 12 ] )
					{
					    Iter_Remove ( fraction_ministry, targetid ) ;
					}
				}

				p_info [ targetid ] [ member ] =
				p_info [ targetid ] [ rank ] =
				p_info [ targetid ] [ org_skin ] =
				p_info [ targetid ] [ warblock ] =
				p_info [ targetid ] [ subleader ] =
				p_info [ targetid ] [ f_warning ] = 0 ;

				format ( scm_string, sizeof scm_string, "DELETE FROM `fractions_players` WHERE `u_sql_id` = '%d' LIMIT 1", p_info [ targetid ] [ id ] ) ;
				mysql_tquery ( sql_connection, scm_string ) ;

				if ( is_fraction_duty { targetid } ) is_fraction_duty { targetid } = 0 ;

				SetPlayerSkin ( targetid, p_info [ targetid ] [ skin ] ) ;
				SetPlayerColor ( targetid, 0xFFFFFF80 ) ; // col_white
                return 1 ;
			}

			clear_player_use_page ( playerid ) ;

			new fraction_id = get_player_listitem_values ( playerid, listitem ) + 1 ;
			clear_player_listitem_values ( playerid ) ;

			if ( p_info [ targetid ] [ leader ] != 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок уже обладает правами лидера." ) ;
			if ( p_info [ targetid ] [ member ] != 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок уже состоит в какой-то организации." ) ;
			p_info [ targetid ] [ member ] = fraction_id ;
			p_info [ targetid ] [ leader ] = fraction_id ;
			p_info [ targetid ] [ rank ] = f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 0 ] ;
			p_info [ targetid ] [ org_skin ] = f_skin [ fraction_id - 1 ] [ p_info [ targetid ] [ gender ] ] [ 0 ] ;
			p_info [ targetid ] [ org_date ] = 0 ;

			Iter_Add(fraction_players[fraction_id], targetid);

			p_info [ targetid ] [ spawnchange ] = 2 ;
			update_int_sql ( targetid, "u_spawnchange", 2 ) ;

			fractionLeaderInsert ( targetid ) ;
			SetPlayerColor ( targetid, f_info [ fraction_id - 1 ] [ f_radar_color ] ) ;

			global_string [ 0 ] = EOS ;
			format ( global_string, 128, "%s назначил %s лидером %s", p_info [ playerid ] [ name ], p_info [ targetid ] [ name ], f_info [ fraction_id - 1 ] [ f_name ] );
			WriteLog ( playerid, TYPE_LOG_MKL, global_string ) ;

			new scm_string [ 144 ] ;
			format ( scm_string, sizeof scm_string, "Вы успешно назначили %s на должность лидера организации \"{"#cWH"}%s{"#cGRInfo"}\"", p_info [ targetid ] [ name ], f_info [ fraction_id - 1 ] [ f_name ] ) ;
			SendClientMessage ( playerid, col_succes, scm_string ) ;
			format ( scm_string, sizeof scm_string, "Министр %s назначил Вас на должность лидера организации \"{"#cWH"}%s{"#cGRInfo"}\"", p_info [ playerid ] [ name ], f_info [ fraction_id - 1 ] [ f_name ] ) ;
			SendClientMessage ( targetid, col_succes, scm_string ) ;

			format( scm_string, 144, "{"#cBAdmin"}[A] {"#cGRAdmin"}Министр %s назначил %s на должность лидера организации \"{"#cBAdmin"}%s{"#cGRAdmin"}\".", p_info [ playerid ] [ name ], p_info [ targetid ] [ name ], f_info [ fraction_id - 1 ] [ f_name ] ) ;
			foreach(new q: admin_players) SendClientMessage ( q, col_admin, scm_string ) ;
			return 1 ;
		}
		case d_makeadmin:
		{
			if ( ! response ) return DeletePVar ( playerid, "target_id" ) ;
			new targetid = GetPVarInt ( playerid, "target_id" ) ;
			DeletePVar ( playerid, "target_id" ) ;

			makeadmin_callback ( playerid, targetid, listitem ) ;
			return 1 ;
		}
		case d_mafia_questlist:
		{
			if ( ! response ) return 1 ;
			if ( listitem == get_player_use_listitem ( playerid ) )
			{
				if ( mafia_status [ playerid ] == 2 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете отменить задание, которое ожидает сдачи." ) ;

				mafia_status [ playerid ] =
				mafia_progress [ playerid ] = 0 ;
				SendClientMessage ( playerid, col_succes, !"Задание успешно отменено." ) ;

				show_mafia_quest ( playerid ) ;
				return 1 ;
			}

			new list_item = get_player_listitem_values ( playerid, listitem ) ;
			clear_player_listitem_values ( playerid ) ;

			if ( listitem > 0 )
