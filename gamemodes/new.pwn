CMD:garage ( playerid )
{
	new house_id = GetPVarInt ( playerid, "house_id" ) - 1 ;
	if ( house_id < 0 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нужно находиться в доме." ) ;
	if ( h_info [ house_id ] [ h_garage ] == 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет гаража." ) ;

	new garage_mesto = house_int [ h_info [ house_id ] [ h_int ] - 1 ] [ hint_class ] ;
	set_pos ( playerid, house_garage_position [ garage_mesto ] [ 0 ], house_garage_position [ garage_mesto ] [ 1 ], house_garage_position [ garage_mesto ] [ 2 ], house_garage_position [ garage_mesto ] [ 3 ], house_garage_interior [ garage_mesto ], h_info [ house_id ] [ h_id ] ) ;
	return 1 ;
}

CMD:confisc ( playerid )
{
	if ( ! army_player ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команда доступна только военным и сотрудникам спец. служб." ) ;
	if ( p_info [ playerid ] [ rank ] < f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 1 ] )
	{
	    static const _str [ ] = "{"#cRInfo"}* {"#cGRInfo"}Команда доступна с ранга %s (%d)." ;
	    new scm_string [ sizeof _str + 30 + 3 ] ;
	    format ( scm_string, sizeof scm_string, _str, f_rank [ p_info [ playerid ] [ member ] - 1 ] [ f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 1 ] - 1 ], f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 1 ] ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
		return 1 ;
	}
	if ( army_player ( playerid ) )
	{
		if ( conf_time > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}В данный момент уже проводится конфискация." ) ;
		if ( conf_kd > 0 )
		{
		    new text_confisc [ 128 ] ;
		    format ( text_confisc, sizeof text_confisc, "{"#cRInfo"}* {"#cGRInfo"}Вы недавно проводили конфискацию, отдохните и перегруперуйтесь. До начала конфискации: %d часов.", conf_kd ) ;
			SendClientMessage ( playerid, col_gray, text_confisc ) ;
			return 1 ;
		}

		if ( IsPlayerInQuad ( playerid, quad_lcn [ 0 ], quad_lcn [ 1 ], quad_lcn [ 2 ], quad_lcn [ 3 ] ) )
		{
		    new owner_counts = 0, attack_counts = 0 ;
			foreach(new j: logged_players)
			{
				if ( p_info [ j ] [ member ] == 23 ) owner_counts ++ ;
				if ( IsPlayerInQuad ( j, quad_lcn [ 0 ], quad_lcn [ 1 ], quad_lcn [ 2 ], quad_lcn [ 3 ] ) && army_player ( j ) ) attack_counts ++ ;
			}
			if ( owner_counts < mafia_online ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игроков организации, контроллирующей территорию, нет в игре." ) ;
	        if ( attack_counts < army_online ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Для проведения процедуры конфискации на территории должно быть больше военных." ) ;

	        show_dialog ( playerid, d_confisc, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Конфискация", "{"#cWH"}Вы готовы к проведению конфискации?", "Да", "Нет" ) ;
			return 1 ;
		}
		else if ( IsPlayerInQuad ( playerid, quad_rm [ 0 ], quad_rm [ 1 ], quad_rm [ 2 ], quad_rm [ 3 ] ) )
		{
		    new owner_counts = 0, attack_counts = 0 ;
			foreach(new j: logged_players)
			{
				if ( p_info [ j ] [ member ] == 24 ) owner_counts ++ ;
				if ( IsPlayerInQuad ( j, quad_rm [ 0 ], quad_rm [ 1 ], quad_rm [ 2 ], quad_rm [ 3 ] ) && army_player ( j ) ) attack_counts ++ ;
			}
			if ( owner_counts < mafia_online ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игроков организации, контроллирующей территорию, нет в игре." ) ;
	        if ( attack_counts < army_online ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Для проведения процедуры конфискации на территории должно быть больше военных." ) ;

	        show_dialog ( playerid, d_confisc, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Конфискация", "{"#cWH"}Вы готовы к проведению конфискации?", "Да", "Нет" ) ;
			return 1 ;
		}
		else if ( IsPlayerInQuad ( playerid, quad_yakuza [ 0 ], quad_yakuza [ 1 ], quad_yakuza [ 2 ], quad_yakuza [ 3 ] ) )
		{
		    new owner_counts = 0, attack_counts = 0 ;
			foreach(new j: logged_players)
			{
				if ( p_info [ j ] [ member ] == 25 ) owner_counts ++ ;
				if ( IsPlayerInQuad ( j, quad_yakuza [ 0 ], quad_yakuza [ 1 ], quad_yakuza [ 2 ], quad_yakuza [ 3 ] ) && army_player ( j ) ) attack_counts ++ ;
			}
			if ( owner_counts < mafia_online ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игроков организации, контроллирующей территорию, нет в игре." ) ;
	        if ( attack_counts < army_online ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Для проведения процедуры конфискации на территории должно быть больше военных." ) ;

	        show_dialog(playerid, d_confisc, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Конфискация", "{"#cWH"}Вы готовы к проведению конфискации?", "Да", "Нет" ) ;
			return 1 ;
		}
	}
	return 1 ;
}

callback: confiscation_timer ( attack_org, defeat_org )
{
	if ( conf_time > 1 )
	{
	    conf_time -- ;

	    new temp [ 16 ] ;
	    format(temp, sizeof temp, "~r~%i", conf_time ) ;
	    foreach(new i: logged_players)
	    {
   	 		if ( p_info [ i ] [ member ] == attack_org )
			{
				if ( conf_td_status_bool [ i ] == false )
				{
					conf_td_status_bool [ i ] = true ;
					show_conf_ptd ( i, true ) ;
				}
				PlayerTextDrawSetString ( i, conf_ptd [ i ], temp ) ;
				continue ;
			}
			else if ( p_info [ i ] [ member ] == defeat_org )
			{
				if ( conf_td_status_bool [ i ] == false )
				{
					conf_td_status_bool [ i ] = true ;
					show_conf_ptd ( i, true ) ;
				}
				PlayerTextDrawSetString ( i, conf_ptd [ i ], temp ) ;
				continue ;
			}
			else
			{
				if ( conf_td_status_bool [ i ] == true )
				{
					conf_td_status_bool [ i ] = false ;
					show_conf_ptd ( i, false ) ;
				}
			}
		}
		if ( conf_time == 1 )
		{
      		foreach(new i: logged_players)
			{
				if ( p_info [ i ] [ member ] == attack_org )
			    {
					SendClientMessage ( i, col_lblue, !"[R] Конфискация прошла успешно. Езжайте к главному складу и разгрузите фуры." ) ;

					SetPlayerRaceCheckpoint ( i, 1, army_unloading [ attack_org - 1 ] [ 0 ], army_unloading [ attack_org - 1 ] [ 1 ], army_unloading [ attack_org - 1 ] [ 2 ], 0.0, 0.0, 0.0, 4.0 ) ;

					if ( conf_td_status_bool [ i ] == true )
					{
						conf_td_status_bool [ i ] = false ;
						show_conf_ptd ( i, false ) ;
					}
					continue ;
			    }
				else if ( p_info [ i ] [ member ] == defeat_org )
				{
					SendClientMessage ( i, col_lblue, !"[F] Конфискация окончена. Пора подсчитать потери..." ) ;

					if ( conf_td_status_bool [ i ] == true )
					{
						conf_td_status_bool [ i ] = false ;
						show_conf_ptd ( i, false ) ;
					}
				    continue ;
				}
			}

			KillTimer ( confiscation_time ) ;
	        confiscation_time = -1 ;

			conf_kd = 6 ;

		    conf_time =
		    conf_type = 0 ;

		    GangZoneDestroy ( KonfiskatZoneID ) ;
		    KonfiskatZoneID = -1 ;
		}
	}

	third_minute_confisc ++ ;
	if ( third_minute_confisc < 180 ) return 1 ;
	else third_minute_confisc = 0 ;

	if ( conf_time > 1 )
	{
	    new attack_player = 0 ;
	    foreach(new i: logged_players)
	    {
	        if ( conf_type == 1 )
	    	{
      			if ( IsPlayerInQuad ( i, quad_lcn [ 0 ], quad_lcn [ 1 ], quad_lcn [ 2 ], quad_lcn [ 3 ] ) && army_player ( i ) ) attack_player ++ ;
		    }
		    else if ( conf_type == 2 )
	    	{
      			if ( IsPlayerInQuad ( i, quad_rm [ 0 ], quad_rm [ 1 ], quad_rm [ 2 ], quad_rm [ 3 ] ) && army_player ( i ) ) attack_player ++ ;
		    }
		    else if ( conf_type == 3 )
	    	{
      			if ( IsPlayerInQuad ( i, quad_yakuza [ 0 ], quad_yakuza [ 1 ], quad_yakuza [ 2 ], quad_yakuza [ 3 ] ) && army_player ( i ) ) attack_player ++ ;
		    }
			else if ( conf_type == 4 )
			{
				if ( IsPlayerInQuad ( i, quad_drugs_farm [ 0 ], quad_drugs_farm [ 1 ], quad_drugs_farm [ 2 ], quad_drugs_farm [ 3 ] ) && fbi_player ( i ) ) attack_player ++ ;
			}
			else if ( conf_type == 5 )
			{
				if ( IsPlayerInQuad ( i, quad_gun_factory [ 0 ], quad_gun_factory [ 1 ], quad_gun_factory [ 2 ], quad_gun_factory [ 3 ] ) && fbi_player ( i ) ) attack_player ++ ;
			}
	    }
	    if ( attack_player < 1 )
	    {
	        KillTimer ( confiscation_time ) ;
	        confiscation_time = -1 ;

			foreach(new i: logged_players)
			{
			    if ( p_info [ i ] [ member ] == attack_org )
			    {
					SendClientMessage ( i, col_lblue, !"[R] Конфискация не удалась, мафия отбила свою территорию." ) ;
					if ( conf_td_status_bool [ i ] == true )
					{
						conf_td_status_bool [ i ] = false ;
						show_conf_ptd ( i, false ) ;
					}
					continue ;
			    }

				else if ( p_info [ i ] [ member ] == defeat_org )
				{
    				SendClientMessage ( i, col_lblue, !"[F] Вы успешно отбили свою территорию, конфискация провалилась." ) ;
					if ( conf_td_status_bool [ i ] == true )
					{
						conf_td_status_bool [ i ] = false ;
						show_conf_ptd ( i, false ) ;
					}
				    continue ;
				}
			}

	        conf_kd = 6 ;

		    conf_time =
		    conf_type = 0 ;

		    GangZoneDestroy ( KonfiskatZoneID ) ;
		    KonfiskatZoneID = -1 ;
	    }
	}
	return 1 ;
}

CMD:loadgun ( playerid )
{
	if ( ! army_player ( playerid ) && ! medic_player ( playerid ) && ! mafia_player ( playerid ) && ! gang_player ( playerid ) && p_info [ playerid ] [ family ] < 1 ) return 1 ;

	if ( GetPlayerState ( playerid ) == PLAYER_STATE_DRIVER )
	{
		new _v_id = GetPlayerVehicleID ( playerid ) ;
		if ( veh_info [ _v_id - 1 ] [ v_type ] != vehicle_type_server && veh_info [ _v_id - 1 ] [ v_type ] != vehicle_type_family ) return 1 ;

		new _v_model = GetVehicleModelEx ( _v_id ) ;
		if ( _v_model != 433 && _v_model != 482 && _v_model != 416 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны быть за рулем т/с для перевозки оружия." ) ;
		if ( veh_info [ _v_id - 1 ] [ v_loading ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Авто уже стоит на загрузке / разгрузке!" ) ;

		veh_info [ _v_id - 1 ] [ v_loading ] = 1 ;
		RemovePlayerFromVehicle ( playerid ) ;

		new Float: x, Float: y, Float: z, Float: a ;
		GetVehiclePos ( _v_id, x, y, z ) ;
		GetVehicleZAngle ( _v_id, a ) ;

		if ( _v_model == 433 )
		{
			x = x - (-6.0 * floatsin(a, degrees));
			y = y - 6.0 * floatcos(a, degrees);
			veh_info [ _v_id - 1 ] [ v_pickup ] = CreateDynamicPickup ( 3013, 23, x, y, z, -1, -1, -1, 100.0 ) ;
			pick_info [ veh_info [ _v_id - 1 ] [ v_pickup ] ] [ pick_item ] = _v_id ;
			pick_info [ veh_info [ _v_id - 1 ] [ v_pickup ] ] [ pick_type ] = pick_type_vehicle_gun ;
		}
		else
		{
			x = x - (-3.5 * floatsin(a, degrees));
			y = y - 3.5 * floatcos(a, degrees);
			veh_info [ _v_id - 1 ] [ v_pickup ] = CreateDynamicPickup ( 3013, 23, x, y, z, -1, -1, -1, 100.0 ) ;
			pick_info [ veh_info [ _v_id - 1 ] [ v_pickup ] ] [ pick_item ] = _v_id ;
			pick_info [ veh_info [ _v_id - 1 ] [ v_pickup ] ] [ pick_type ] = pick_type_vehicle_gun ;
		}
		veh_info [ _v_id - 1 ] [ v_label ] = CreateDynamic3DTextLabel ( "** Загрузка **\n{"#cGR3D"}Встаньте для загрузки ящика", col_header_3d, x, y, z + 0.8, 20.0 ) ;
	}
	return 1 ;
}

CMD:unloadgun ( playerid )
{
	if ( ! army_player ( playerid ) && ! medic_player ( playerid ) && ! mafia_player ( playerid ) && ! gang_player ( playerid ) && p_info [ playerid ] [ family ] < 1 ) return 1 ;

	if ( GetPlayerState ( playerid ) == PLAYER_STATE_DRIVER )
	{
		new _v_id = GetPlayerVehicleID ( playerid ) ;
		if ( veh_info [ _v_id - 1 ] [ v_type ] != vehicle_type_server && veh_info [ _v_id - 1 ] [ v_type ] != vehicle_type_family ) return 1 ;

		new _v_model = GetVehicleModelEx ( _v_id ) ;
		if ( _v_model != 433 && _v_model != 482 && _v_model != 416 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны быть за рулем т/с для перевозки оружия." ) ;
		if ( veh_info [ _v_id - 1 ] [ v_loading ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Авто уже стоит на загрузке / разгрузке!" ) ;

        veh_info [ _v_id - 1 ] [ v_loading ] = 2 ;
		RemovePlayerFromVehicle ( playerid ) ;

		new Float: x, Float: y, Float: z, Float: a ;
		GetVehiclePos ( _v_id, x, y, z ) ;
		GetVehicleZAngle ( _v_id, a ) ;

		if ( _v_model == 433 )
		{
			x = x - (-6.0 * floatsin(a, degrees));
			y = y - 6.0 * floatcos(a, degrees);
			veh_info [ _v_id - 1 ] [ v_pickup ] = CreateDynamicPickup ( 3013, 23, x, y, z, -1, -1, -1, 100.0 ) ;
			pick_info [ veh_info [ _v_id - 1 ] [ v_pickup ] ] [ pick_item ] = _v_id ;
			pick_info [ veh_info [ _v_id - 1 ] [ v_pickup ] ] [ pick_type ] = pick_type_vehicle_gun ;
		}
		else
		{
			x = x - (-3.5 * floatsin(a, degrees));
			y = y - 3.5 * floatcos(a, degrees);
			veh_info [ _v_id - 1 ] [ v_pickup ] = CreateDynamicPickup ( 3013, 23, x, y, z, -1, -1, -1, 100.0 ) ;
			pick_info [ veh_info [ _v_id - 1 ] [ v_pickup ] ] [ pick_item ] = _v_id ;
			pick_info [ veh_info [ _v_id - 1 ] [ v_pickup ] ] [ pick_type ] = pick_type_vehicle_gun ;
		}
		veh_info [ _v_id - 1 ] [ v_label ] = CreateDynamic3DTextLabel ( "** Разгрузка **\n{"#cGR3D"}Встаньте для взятия ящика", col_header_3d, x, y, z + 0.8, 20.0 ) ;
	}
	return 1 ;
}

CMD:armpanel ( playerid )
{
	if ( ! army_player ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команда доступна только военным." ) ;

	show_dialog ( playerid, d_armpanel, DIALOG_STYLE_LIST, "{"#cBHD"}Доставка оружия", "{"#cBL"}1.{"#cWH"} Состояние складов\n{"#cBL"}2.{"#cWH"} Загрузка оружия\n{"#cBL"}3.{"#cWH"} Начать доставку", "Выбрать", "Закрыть" ) ;
	return 1 ;
}

stock update_army_text ( )
{
	static const _str [ ] = "*** Склад %s ***\n{"#cGR3D"}Встаньте на пикап для кражи боеприпасов" ;
	new t_string [ sizeof _str + 32 ] ;
	for ( new i = 0 ; i < MAX_ARMY_MATS ; i ++ )
 	{
	    format ( t_string,sizeof ( t_string ), _str, f_info [ army_mats [ i ] [ army_id ] - 1 ] [ f_name ] ) ;
		UpdateDynamic3DTextLabelText ( army_mats_text [ i ], col_header_3d, t_string ) ;
	}
	return 1 ;
}

CMD:sellic ( playerid, params [ ] )
{
	if ( p_info [ playerid ] [ member ] != 10 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команда доступна только для сотрудников автошколы." ) ;
	if ( sscanf ( params, "u", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /sellic [id/имя]") ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете применить это к самому себе." ) ;
	if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;
	if ( ! bad_dialog ( params [ 0 ] ) || ! bad_dialog ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Недоступно в данный момент.") ;
	if ( cooldown_sentence [ playerid ] > gettime ( ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Предложение о сделке можно отправлять один раз в {"#cRD"}45 секунд{"#cGRInfo"}." ) ;

    cooldown_sentence [ playerid ] = gettime ( ) + time_sell_sentence ;

	buyer_id [ playerid ] = params [ 0 ] ;
	seller_id [ params [ 0 ] ] = playerid ;

	sell_time { playerid } =
	sell_time { params [ 0 ] } = time_sell_null ;

	new dialog_string [ 256 ] ;

	format ( dialog_string, sizeof dialog_string, "{"#cWH"}Водительские права: {"#cGN"}%d"valute_title_"{"#cWH"}\nЛицензия пилота: {"#cGN"}%d"valute_title_"{"#cWH"}\nНа водный транспорт: {"#cGN"}%d"valute_title_"{"#cWH"}\nЛицензия на оружие: {"#cGN"}%d"valute_title_"{"#cWH"}",
	licenses_price [ 0 ], licenses_price [ 1 ], licenses_price [ 2 ], licenses_price [ 3 ] ) ;

	show_dialog(playerid, d_sellic, DIALOG_STYLE_LIST, "{"#cBHD"}Продажа лицензий", dialog_string, "Выбрать", "Закрыть" ) ;
	return 1 ;
}

CMD:exam ( playerid, params [ ] )
{
    if ( p_info [ playerid ] [ member ] != 10 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команда доступна только для сотрудников автошколы." ) ;
    if ( sscanf ( params, "u", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /exam [id/имя]") ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете применить это к самому себе." ) ;
	if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;
	if ( ! bad_dialog ( params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Недоступно в данный момент.") ;

	new queue_id = -1 ;
	for ( new i = 9 ; i >= 0 ; i -- )
	{
		if ( autoschool_queue [ i ] == params [ 0 ] )
		{
			autoschool_queue [ i ] = INVALID_PLAYER_ID ;
			queue_id = i + 1 ;
			break ;
		}
	}

	if ( queue_id == -1 )
	{
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не стоит в очереди." ) ;
		return 1 ;
	}

	SendClientMessage ( params [ 0 ], col_white, !"{"#cGInfo"}* {"#cWH"}Инструктор принял(а) у Вас экзамен. Следуйте инструкциям." ) ;

	static const _str [ ] = "{"#cGInfo"}* {"#cWH"}Вы начали экзамен у {"#cGN"}%s{"#cWH"}." ;
	new text_string [ sizeof _str + 24 ] ;
	format ( text_string, sizeof text_string, _str, p_info [ params [ 0 ] ] [ name ] ) ;
	SendClientMessage ( playerid, col_white, text_string ) ;

    update_autoschool_queue ( ) ;
	exam_start [ params [ 0 ] ] = true ;
	return 1 ;
}

stock update_autoschool_queue ( )
{
    new _str [ ( MAX_PLAYER_NAME + 33 ) * 10 + 4 ] ;
	strcat ( _str,"** Очередь на сдачу **\n" ) ;
	for ( new i ; i < 10 ; i ++ )
	{
		if ( autoschool_queue [ i ] != INVALID_PLAYER_ID && ! IsPlayerConnected ( autoschool_queue [ i ] ) ||
			autoschool_queue [ i ] != INVALID_PLAYER_ID && exam_start [ autoschool_queue [ i ] ] != true ||
			autoschool_queue [ i ] != INVALID_PLAYER_ID && p_t_info [ autoschool_queue [ i ] ] [ p_data ] [ 1 ] != 1 ) autoschool_queue [ i ] = INVALID_PLAYER_ID ;

		if ( i != 9 && autoschool_queue [ i ] == INVALID_PLAYER_ID && autoschool_queue [ i + 1 ] != INVALID_PLAYER_ID )
		{
			autoschool_queue [ i ] = autoschool_queue [ i + 1 ] ;
			autoschool_queue [ i + 1 ] = INVALID_PLAYER_ID ;
		}
		if ( autoschool_queue [ i ] != INVALID_PLAYER_ID ) format ( _str, sizeof ( _str ), "%s\n{"#cGR3D"}%i.{"#cWH3D"} %s", _str, i + 1, p_info [ autoschool_queue [ i ] ] [ name ] ) ;
	}
	UpdateDynamic3DTextLabelText ( text_autoschool_queue, col_header_3d, _str ) ;
	return 1 ;
}

CMD:licmenu ( playerid )
{
	if ( p_info [ playerid ] [ leader ] != 10 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команда доступна только для сотрудников автошколы." ) ;
	show_dialog ( playerid, d_licmenu, DIALOG_STYLE_LIST, "{"#cBHD"}Лицензирование", "{"#cBL"}1.{ffffff} Цены на автосдачу\n{"#cBL"}2.{ffffff} Управление продажами\n{"#cBL"}3.{ffffff} Доступность продаж\n{"#cBL"}4.{ffffff} Доступность автосдачи", "Выбрать", "Закрыть" ) ;
	return 1 ;
}

CMD:economy ( playerid )
{
	if ( admin_info [ playerid ] [ admin ] < 8 ) return 1 ;
	if ( p_info [ playerid ] [ leader ] != 11 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команда доступна только для сотрудников правительства." ) ;
	show_dialog ( playerid, d_economy, DIALOG_STYLE_LIST, "{"#cBHD"}Экономика", "{"#cBL"}1.{ffffff} Состояние организаций\n{"#cBL"}2.{ffffff} Перевод средств\n{"#cBL"}3.{ffffff} Зарплаты организаций\n{"#cBL"}4.{ffffff} Зарплаты рабочих\n{"#cBL"}5.{ffffff} Налоги", "Выбрать", "Закрыть" ) ;
	return 1 ;
}

