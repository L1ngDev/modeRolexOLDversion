			 		users_contacts [ playerid ] [ i ] [ uc_inc ], p_info [ playerid ] [ id ], p_info [ _value ] [ id ], p_info [ _value ] [ number ], getNewSkinModel ( _value ) ) ;
					mysql_tquery ( sql_connection, query_string ) ;

					_free_cont = true ;

					SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы добавили контакт в телефонную книгу! Используйте /phone." ) ;
				    break ;
				}

				if ( _free_cont == false ) SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас записано максимальное число контактов!" ) ;
			}
			else
			{
				show_dialog ( playerid, d_phone_menu_5, DIALOG_STYLE_INPUT, "{"#cBHD"}Добавление контакта", "{"#cWH"}Введите имя контакта:", "Принять", "Назад" ) ;
			}
