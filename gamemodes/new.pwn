			    case 2:
			    {
			        new _checkpoint_id = GetPVarInt ( playerid, "_checkpoint_id" ) ;
			        DeletePVar ( playerid, "_checkpoint_id" ) ;

			        set_pos ( playerid, bus_info [ _checkpoint_id ] [ bus_position ] [ 0 ], bus_info [ _checkpoint_id ] [ bus_position ] [ 1 ], bus_info [ _checkpoint_id ] [ bus_position ] [ 2 ], bus_info [ _checkpoint_id ] [ bus_position ] [ 3 ], 0, 0 ) ;

                    show_admin_route ( playerid ) ;
				}
			}
		}
		case d_bus_route:
		{
			if ( ! response ) return 1 ;
			SetPVarInt ( playerid, "pbusroute", listitem ) ;
			show_dialog(playerid, d_bus_price, DIALOG_STYLE_INPUT, "{"#cBHD"}Цена за проезд", "{"#cWH"}Введите цену билета:", "Принять", "Отмена" ) ;
		}
		case d_bus_price:
		{
			if ( ! response ) return DeletePVar ( playerid, "pbusroute" ) ;
			new price = strval ( inputtext ) ;
			if ( price < 0 || price > 500 )
			{
				return show_dialog ( playerid, d_bus_price, DIALOG_STYLE_INPUT, "{"#cBHD"}Цена за проезд","{"#cRD"}* Цена должна быть от 0"valute_title_" до 500"valute_title_"\n\n{"#cWH"}* Введите цену билета:", "Принять", "Отмена" ) ;
			}

			is_gps_used { playerid } = 0 ;

			new route = GetPVarInt ( playerid, "pbusroute" ) ;
			DeletePVar ( playerid, "pbusroute" ) ;

			new mes [ 90 ] ;
			if ( price ) format ( mes, sizeof ( mes ), "** %s **\n{"#cGR3D"}Стоимость билета: {"#cWH3D"}%i"valute_title_"", bus_info [ route ] [ bus_name ], price ) ;
			else format ( mes, sizeof ( mes ), "** %s **\n{"#cGR3D"}Стоимость билета: {"#cWH3D"}бесплатно", bus_info [ route ] [ bus_name ] ) ;
			if ( IsValidDynamic3DTextLabel ( p_t_info [ playerid ] [ pBusText ] ) ) UpdateDynamic3DTextLabelText ( p_t_info [ playerid ] [ pBusText ], col_header_3d, mes ) ;
			else if ( ! IsValidDynamic3DTextLabel ( p_t_info [ playerid ] [ pBusText ] ) ) p_t_info [ playerid ] [ pBusText ] = CreateDynamic3DTextLabel ( mes, col_header_3d, 0.0, 0.0, 3.0, 40.0, INVALID_PLAYER_ID, player_rentcar [ playerid ] ) ;

			p_t_info [ playerid ] [ pBusRoute ] = route ;
			p_t_info [ playerid ] [ pBusPrice ] = price ;

			p_t_info [ playerid ] [ pBusPos ] = bus_route_count [ route ] ;
			SetNextBusCP ( playerid, bus_route_count [ route ] ) ;
		}
		case d_end:
		{
			if ( ! response ) return 1 ;

			end_for_job ( playerid ) ;
			return 1 ;
		}
		case d_job:
		{
			if ( ! response ) return 1 ;

			if ( p_info [ playerid ] [ drive_lic ] == 0 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет водительского удостоверения, оно обязательно для данных работ." ) ;
			if ( player_rentcar [ playerid ] != INVALID_VEHICLE_ID )
			{
				if ( veh_info [ player_rentcar [ playerid ] - 1 ] [ v_model ] != 462 )
				{
					SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не завершили работу на предыдущем рабочем месте." ) ;
					SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Возможно Вы не отменили аренду рабочего транспорта, используйте: {"#cBL"}\"/stoprent\"{"#cGRInfo"}." ) ;
					return 1 ;
				}
			}
			if ( listitem == 13 )
			{
				if ( p_info [ playerid ] [ job ] == 0 )
				{
					show_jobmenu ( playerid ) ;
					return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не трудоустроены на постоянную работу." ) ;

				}
				if ( player_rentcar [ playerid ] != INVALID_VEHICLE_ID )
				{
					if ( veh_info [ player_rentcar [ playerid ] - 1 ] [ v_model ] != 462 )
					{
						show_jobmenu ( playerid ) ;
						return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не завершили работу на предыдущем рабочем месте." ) ;
					}
				}
				p_info [ playerid ] [ job ] = 0 ;
				update_int_sql ( playerid, "u_job", 0 ) ;
				SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы успешно уволились с прежнего места работы." ) ;
				show_jobmenu ( playerid ) ;
				return 1 ;
			}
			else if ( listitem == 0 || listitem == 4 || listitem == 5 )
			{
				show_jobmenu ( playerid ) ;
				return 1 ;
			}
			else if ( p_info [ playerid ] [ job ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы уже трудоустроены, чтобы уволиться с работы, используйте команду {"#cRD"}/quitjob" ) ;
			static const job_level [ 13 ] = { 0, 1, 1, 1, 0, 0, 2, 2, 3, 4, 4, 4, 7 } ;
			for ( new i = 0 ; i < sizeof job_level ; i ++ )
			{
				if( listitem == i && p_info [ playerid ] [ level ] >= job_level [ i ] ) break ;
				else if ( p_info [ playerid ] [ level ] < job_level [ i ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вам необходимо прожить ещё несколько лет в штате." ) ;
			}

			static const _job_id [ 13 ] =
			{
			    -1,
			    -1,
			    -1,
				-1,
				-1,
				-1,
				job_bus,
				job_taxi,
				job_mechanic,
				job_trucker,
				job_delivery,
				job_fuel_delivery,
				job_incass
			} ;

			static const job_status [ 13 ] [ 32 ] =
			{
			    "",
			    "шахтёром",
				"заводским рабочим",
				"рабочим на лесопилке",
				"",
				"",
				"водителя автобуса",
				"таксиста",
				"механика",
				"дальнобойщика",
				"развозчика продуктов",
				"развозчика топлива",
				"инкассатора"
			} ;

			if ( listitem < 4 )
			{
				new _text_string [ 128 ] ;
				format ( _text_string, sizeof _text_string, "{"#cGInfo"}* {"#cWH"}Для устройства {"#cGN"}%s{"#cWH"} используйте {"#cGRInfo"}'/gps'{"#cWH"}.", job_status [ listitem ] ) ;
				SendClientMessage ( playerid, col_white, _text_string ) ;
			    return 1 ;
			}

			p_info [ playerid ] [ job ] = _job_id [ listitem ] ;

			new _text_string [ 92 ] ;
			format ( _text_string, sizeof _text_string, "{"#cGInfo"}* {"#cWH"}Вы успешно устроились на работу {"#cGN"}%s{"#cWH"}.", job_status [ listitem ] ) ;
			SendClientMessage ( playerid, col_white, _text_string ) ;

			if ( p_info [ playerid ] [ job ] == job_incass )
			{
			    SendClientMessage ( playerid, col_white, !"{"#cBInfo"}* {"#cGRInfo"}Отправляйтесь в любой Банк и арендуйте икассаторскую машину." ) ;
				SendClientMessage ( playerid, col_white, !"{"#cBInfo"}* {"#cGRInfo"}Для поиска местоположения Банка используйте {"#cWH"}'/gps'{"#cGRInfo"}." ) ;
			}
			else if ( p_info [ playerid ] [ job ] == job_trucker )
			{
			    SendClientMessage ( playerid, col_white, !"{"#cBInfo"}* {"#cGRInfo"}Отправляйтесь в транспортную компанию для трудоустройства." ) ;
				SendClientMessage ( playerid, col_white, !"{"#cBInfo"}* {"#cGRInfo"}Для поиска местоположения транспортной компании используйте {"#cWH"}'/gps'{"#cGRInfo"}." ) ;
			}
			else SendClientMessage ( playerid, col_white, !"{"#cBInfo"}* {"#cGRInfo"}Для поиска местоположения работы используйте {"#cWH"}'/gps'{"#cGRInfo"}." ) ;

			SendClientMessage ( playerid, col_white, !"{"#cBInfo"}* {"#cGRInfo"}Чтобы узнать команды используйте {"#cWH"}'/mm >> Список команд'{"#cGRInfo"}." ) ;
			update_int_sql ( playerid, "u_job", p_info [ playerid ] [ job ] ) ;
			return 1 ;
		}
		case d_taxi_mark:
		{
			new mapmark = GetPVarInt ( playerid, "map_mark" ) ;
			if ( mapmark == 2 )
			{
				if ( ! response ) return show_dialog ( playerid, d_taxi_mark, DIALOG_STYLE_LIST, "{"#cBHD"}Навигатор таксиста", "{"#cBL"}1. {"#cWH"}Установить метку на карте\n{"#cBL"}2. {"#cWH"}Установить метку из GPS навигатора\n{"#cGRDialog"}Продолжать поездку без навигатора", "Выбрать", "Закрыть" ), DeletePVar ( playerid, "map_mark" ) ;
				new driverid = veh_info [ GetPlayerVehicleID ( playerid ) - 1 ] [ v_driver ] ;
				switch ( listitem )
				{
					case 0: SetPlayerRaceCheckpoint ( driverid, 1, 1481.2469, -1743.4403, 13.5469, 0.0, 0.0, 0.0, 2.0 ) ; // Мэрия
					case 1: SetPlayerRaceCheckpoint ( driverid, 1, 1375.9095, -1088.4717, 25.9133, 0.0, 0.0, 0.0, 2.0 ) ; // Банк Los-Santos
					case 2: SetPlayerRaceCheckpoint ( driverid, 1, -2047.2146, -231.3838, 35.4309, 0.0, 0.0, 0.0, 2.0 ) ; // Автошкола
					case 3: SetPlayerRaceCheckpoint ( driverid, 1, 2645.9961, -2428.7090, 13.2651, 0.0, 0.0, 0.0, 2.0 ) ; // Порт
					case 4: SetPlayerRaceCheckpoint ( driverid, 1, 596.7739, 868.2286, -43.0937, 0.0, 0.0, 0.0, 2.0 ) ; // Шахта
					case 5: SetPlayerRaceCheckpoint ( driverid, 1, -50.2125, -282.1606, 5.4297, 0.0, 0.0, 0.0, 2.0 ) ; // Завод
					case 6: SetPlayerRaceCheckpoint ( driverid, 1, 1025.9675, -358.8767, 74.6368, 0.0, 0.0, 0.0, 2.0 ) ; // Лесопилка
				}
				SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы успешно задали метку водителю." ) ;
				DeletePVar ( playerid, "map_mark" ) ;
				is_gps_used { driverid } = 1 ;
			}
			if ( ! response )
			{
				DeletePVar ( playerid, "map_mark" ) ;
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не выбрали способ движения или пункт назначения." ) ;
				return RemovePlayerFromVehicle ( playerid ) ;
			}
			if ( ! mapmark )
			{
				switch ( listitem )
				{
					case 0:
					{
						SetPVarInt ( playerid, "map_mark", 1 ) ;
						SendClientMessage ( playerid, col_white, !"{"#cBInfo"}* {"#cWH"}Установить метку на карте (ESC - Карта - ПКМ)." ) ;
					}
					case 1:
					{
						SetPVarInt ( playerid, "map_mark", 2 ) ;
						return show_dialog ( playerid, d_taxi_mark, DIALOG_STYLE_LIST, "{"#cBHD"}Навигатор такси", "{"#cBL"}1. {"#cWH"}Мэрия Лос - Сантос\n{"#cBL"}2. {"#cWH"}Банк Лос - Сантос\n{"#cBL"}3. {"#cWH"}Автошкола\n{"#cBL"}4. {"#cWH"}Порт\n{"#cBL"}5. {"#cWH"}Шахта\n{"#cBL"}6. {"#cWH"}Завод\n{"#cBL"}7. {"#cWH"}Лесопилка", "Выбор", "Закрыть" ) ;
					}
				}
			}
			return 1 ;
		}
		case d_rank:
		{
			if ( ! response ) return DeletePVar ( playerid, "pl_setrank_id" ) ;
			new _pl_id = GetPVarInt ( playerid, "pl_setrank_id" ) ;
			new _frac_id = p_info [ playerid ] [ member ] ;

			if ( ! IsPlayerConnected ( _pl_id )  || _pl_id == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
			if ( p_info [ _pl_id ] [ member ] != p_info [ playerid ] [ member ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не состоит в Вашей организации." ) ;

			if ( listitem + 1 >= p_info [ playerid ] [ rank ] || p_info [ playerid ] [ rank ] <= p_info [ _pl_id ] [ rank ] )
			{
				global_string [ 0 ] = EOS ;
				new line_string [ 72 ] ;
				for ( new i = 0; i < f_info [ _frac_id - 1 ] [ f_rank_settings ] [ 0 ] ; i ++ )
				{
					format ( line_string, 72, "{"#cBL"}%i. {"#cWH"}%s\n", i + 1, f_rank [ _frac_id - 1 ] [ i ] ) ;
					strcat ( global_string, line_string ) ;
				}
				show_dialog ( playerid, d_rank, DIALOG_STYLE_LIST, "{"#cBHD"}Смена ранга", global_string, "Выбрать", "Закрыть" ) ;
				return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете назначить игрока на ранг выше Вашего." ) ;
			}

			if ( listitem + 1 >= f_info [ _frac_id - 1 ] [ f_rank_settings ] [ 0 ] - 1 )
			{
			    if ( f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_leader_settings ] [ 6 ] == 0 && p_info [ playerid ] [ leader_status ] == 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Заместителей может назначать только главный лидер." ) ;

				static const _str [ ] = "SELECT COUNT(u_sql_id) FROM `fractions_players` WHERE `u_rank` = '%d' AND `u_member` = '%d' LIMIT 3" ;
			    new sql_string [ sizeof _str + ( 9 * 2 ) ] ;
			    format ( sql_string, sizeof sql_string, _str, listitem + 1, _frac_id ) ;
			    mysql_tquery ( sql_connection, sql_string, "callback_rank_org", "iiiii", playerid, _pl_id, _frac_id, listitem + 1, true ) ;
			    return 1 ;
			}

			new _text_string [ 128 ] ;
			format ( _text_string, 128, "Изменил(а) ранг %s c %d на %d", p_info [ _pl_id ] [ name ], p_info [ _pl_id ] [ rank ], listitem + 1);
			write_fraction ( playerid, _frac_id, TYPE_LOG_AGIVERANK, _text_string ) ;

			if ( p_info [ _pl_id ] [ rank ] > listitem + 1 )
			    insert_joblist ( _pl_id, "RANK", LABOR_TYPE_BACK_RANG, listitem + 1 ) ;

			else
			    insert_joblist ( _pl_id, "RANK", LABOR_TYPE_NEXT_RANG, listitem + 1 ) ;

			p_info [ _pl_id ] [ rank ] = listitem + 1 ;
			if ( f_info [ _frac_id - 1 ] [ f_skin_type ] == 1 )
			{
				p_info [ _pl_id ] [ org_skin ] = f_skin_rank [ _frac_id - 1 ] [ p_info [ _pl_id ] [ gender ] ] [ listitem ] ;
				fraction_duty ( _pl_id ) ;
			}

			static const _str [ ] = "UPDATE `fractions_players` SET `u_rank` = '%d', `u_org_skin` = '%d' WHERE `u_sql_id` = '%d' LIMIT 1" ;
			new query_string [ sizeof _str + ( 3 * 9 ) ] ;
			format ( query_string, sizeof query_string, _str, listitem + 1, p_info [ _pl_id ] [ org_skin ], p_info [ _pl_id ] [ id ] ) ;
			mysql_tquery ( sql_connection, query_string ) ;

			format ( _text_string, 128, "{"#cGInfo"}* {"#cWH"}Вы назначили %s на ранг {"#cGN"}%s(%d)", p_info [ _pl_id ] [ name ], f_rank [ _frac_id - 1 ] [ listitem ], listitem + 1 ) ;
			SendClientMessage ( playerid, col_white, _text_string ) ;
			format ( _text_string, 128, "{"#cGN"}* %s {"#cWH"}назначил Вас на ранг {"#cGN"}%s(%d)", p_info [ playerid ] [ name ], f_rank [ _frac_id - 1 ] [ listitem ], listitem + 1 ) ;
			SendClientMessage ( _pl_id, col_succes, _text_string ) ;
			return 1 ;
		}
		case d_refill:
		{
		    new id_mhnk = seller_id [ playerid ] ;
		    new price_mhnk = sell_price [ id_mhnk ] ;
			new litres = sell_item [ id_mhnk ] ;
			if ( ! response )
			{
			    clear_sell_params ( playerid, id_mhnk ) ;
			    SendClientMessage ( id_mhnk, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок отказался от предложения." ) ;
			    SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы отказались от предложения." ) ;
			}
			else
			{
			    new _text_string [ 50 + MAX_PLAYER_NAME + 4 + 9 ] ;
				format ( _text_string, sizeof _text_string, "%s заправил Вам автомобиль на %d литров за %i"valute_title".", p_info [ id_mhnk ] [ name ], litres, price_mhnk ) ;
			    SendClientMessage ( playerid, col_succes, _text_string ) ;

			    format ( _text_string, sizeof _text_string, "Вы заправили автомобиль %s на %d литров %i"valute_title".",p_info [ playerid ] [ name ], litres, price_mhnk ) ;
			    SendClientMessage ( id_mhnk, col_succes, _text_string ) ;

				give_money ( playerid, -price_mhnk ) ;
				give_money ( id_mhnk, price_mhnk ) ;

				p_info [ id_mhnk ] [ mechanic_skill ] += 1 * server_bonus [ 2 ] ;
				update_int_sql ( id_mhnk, "u_mskill", p_info [ id_mhnk ] [ mechanic_skill ] ) ;

				new vehicleid = GetPlayerVehicleID ( playerid ) ;
				if ( vehicleid )
				{
                	veh_info [ vehicleid - 1 ] [ v_fuel ] += float ( litres ) ;
                }
                SetPVarInt ( playerid, "toplivo", GetPVarInt ( playerid, "toplivo") - litres ) ;

 				new mehname [ 32 ] ;
				GetPVarString ( id_mhnk, "MehName", mehname, 31 ) ;

				if ( strlen ( mehname ) > 0 )
				{
					format ( _text_string, sizeof _text_string, "** %s **\n{"#cGR3D"}Топливо: {"#cWH3D"}%d л.", mehname, GetPVarInt ( id_mhnk, "toplivo" ) + litres ) ;
					UpdateDynamic3DTextLabelText ( veh_info [ vehicleid - 1 ] [ v_label ], col_header_3d, _text_string ) ;
				}
				else
				{
					format ( _text_string, sizeof _text_string, "{"#cGR3D"}Топливо: {"#cWH3D"}%d л.",GetPVarInt ( id_mhnk, "toplivo" ) + litres ) ;
					UpdateDynamic3DTextLabelText ( veh_info [ vehicleid - 1 ] [ v_label ], -1, _text_string ) ;
				}
			}
		 	clear_sell_params ( playerid, id_mhnk ) ;
			return 1 ;
		}
		case d_repair:
		{
		    new id_mhnk = seller_id [ playerid ] ;
		    new price_mhnk = sell_price [ id_mhnk ] ;
			if ( ! response )
			{
			    clear_sell_params ( playerid, id_mhnk ) ;
			    SendClientMessage ( id_mhnk, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок отказался от предложения." ) ;
			    SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы отказались от предложения." ) ;
			}
			else
			{
			    new _v_id = GetPlayerVehicleID ( playerid ) ;
				if ( _v_id > 0 )
				{
				    new _text_string [ 40 + MAX_PLAYER_NAME + 9 ] ;
					format ( _text_string, sizeof _text_string, "%s починил Вам автомобиль за %i"valute_title_"", p_info [ id_mhnk ] [ name ], price_mhnk ) ;
				    SendClientMessage ( playerid, col_succes, _text_string ) ;

				    format ( _text_string, sizeof _text_string, "Вы починили автомобиль %s за %i"valute_title_"", p_info [ playerid ] [ name ], price_mhnk ) ;
				    SendClientMessage ( id_mhnk, col_succes, _text_string ) ;

					give_money ( playerid, -price_mhnk ) ;
					give_money ( id_mhnk, price_mhnk ) ;

					p_info [ id_mhnk ] [ mechanic_skill ] += 1 * server_bonus [ 2 ] ;
					update_int_sql ( id_mhnk, "u_mskill", p_info [ id_mhnk ] [ mechanic_skill ] ) ;

			 		SetVehicleHealth ( _v_id, 1000.0 ) ;
			 		RepairVehicle ( _v_id  ) ;
				}
			}
		 	clear_sell_params ( playerid, id_mhnk ) ;
			return 1 ;
		}
		case d_start_mech:
		{
		    if ( ! response ) return 1 ;
			if ( GetPlayerVehicleID ( playerid ) != player_rentcar [ playerid ] ) return 1 ;
			if ( player_rentcar [ playerid ] == INVALID_VEHICLE_ID )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны быть в рабочей машине." ) ;
			new _v_id = player_rentcar [ playerid ] ;
			if ( veh_info [ _v_id - 1 ] [ v_type ] != vehicle_type_job || veh_info [ _v_id - 1 ] [ v_owner ] != job_mechanic ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны быть в рабочей машине." ) ;

			if ( IsValidDynamic3DTextLabel ( veh_info [ _v_id - 1 ] [ v_label ] ) )
			{
				DestroyDynamic3DTextLabel ( veh_info [ _v_id - 1 ] [ v_label ] ) ;
				veh_info [ _v_id - 1 ] [ v_label ] = Text3D:INVALID_3DTEXT_ID ;
		 	}

		    if ( strlen ( inputtext ) > 0 )
		    {
		        SetPVarString ( playerid, "MehName", inputtext ) ;
				new _text_string [ 34 + 32 ] ;
		    	format ( _text_string, sizeof _text_string, "** %s **\n{"#cGR3D"}Топлива нет", inputtext ) ;
	    		veh_info [ _v_id - 1 ] [ v_label ] = CreateDynamic3DTextLabel ( _text_string, col_header_3d, 0.0, 0.0, 0.0, 15.0, INVALID_PLAYER_ID, _v_id ) ;
			}
			else
			{
			    veh_info [ _v_id - 1 ] [ v_label ] = CreateDynamic3DTextLabel ( "{"#cGR3D"}Топлива нет", -1, 0.0, 0.0, 0.0, 15.0, INVALID_PLAYER_ID, _v_id ) ;
			}
			Streamer_SetFloatData ( STREAMER_TYPE_3D_TEXT_LABEL, veh_info [ GetPlayerVehicleID ( playerid ) - 1 ] [ v_label ], E_STREAMER_ATTACH_OFFSET_Z, 2.0 ) ;
		    return 1 ;
		}
		case d_mech_contract:
		{
			if ( ! response ) return 1 ;
			if ( GetPlayerVehicleID ( playerid ) != player_rentcar [ playerid ] ) return 1 ;
			if ( ! IsValidDynamic3DTextLabel ( veh_info [ GetPlayerVehicleID ( playerid ) - 1 ] [ v_label ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны начать работу. (/mech)");
			if ( player_rentcar [ playerid ] == INVALID_VEHICLE_ID ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны быть в рабочей машине." ) ;
            new _v_id = player_rentcar [ playerid ] ;
			if ( veh_info [ _v_id - 1 ] [ v_type ] != vehicle_type_job || veh_info [ _v_id - 1 ] [ v_owner ] != job_mechanic )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны быть в рабочей машине." ) ;
			new litres = strval(inputtext ) ;
			if( litres < 0 || litres > 5000 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы ввели неверное количество топлива." ) ;
			new _b_id = GetPVarInt ( playerid, "f_biz") - 1 ;
			if( litres * b_info [ _b_id ] [ b_cost ] > p_info [ playerid ] [ money ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас недостаточно средств для покупки." ) ;

			if ( ( litres%2 ) > 0 || litres == 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Количество бензина должно быть кратным двум." ) ;

			new mehname [ 32 ] ;
			GetPVarString ( playerid, "MehName", mehname, 31 ) ;

			if ( strlen ( mehname ) > 0 )
			{
				new _text_string [ 47 + 32 + 4 ] ;
			    format ( _text_string, sizeof _text_string, "** %s **\n{"#cGR3D"}Топливо: {"#cWH3D"}%d л.", mehname, GetPVarInt ( playerid, "toplivo" ) + litres ) ;
			    if ( IsValidDynamic3DTextLabel ( veh_info [ _v_id - 1 ] [ v_label ] ) ) UpdateDynamic3DTextLabelText ( veh_info [ _v_id - 1 ] [ v_label ], col_header_3d, _text_string ) ;
			}
			else
			{
				new _text_string [ 37 + 4 ] ;
		 		format ( _text_string, sizeof _text_string, "{"#cGR3D"}Топливо: {"#cWH3D"}%d л.", GetPVarInt ( playerid, "toplivo" ) + litres ) ;
			    if ( IsValidDynamic3DTextLabel ( veh_info [ _v_id - 1 ] [ v_label ] ) ) UpdateDynamic3DTextLabelText ( veh_info [ _v_id - 1 ] [ v_label ], -1, _text_string ) ;
			}
			give_money ( playerid, -b_info [ _b_id ] [ b_cost ] * litres ) ;
			give_bmoney ( _b_id + 1, b_info [ _b_id ] [ b_cost ] * litres, 0 ) ;

			SetPVarInt ( playerid, "toplivo", GetPVarInt ( playerid, "toplivo" ) + litres ) ;
			DeletePVar ( playerid,"f_biz" ) ;
			return 1 ;
		}
		case d_skin_shop:
		{
			if ( ! response ) return 1 ;
			if ( listitem == 0 )
			{
				p_skin_shop [ playerid ] = true ;
				TogglePlayerSpectating ( playerid, false ) ;
				TogglePlayerControllable ( playerid, true ) ;
				set_world ( playerid, playerid ) ;
				SetPlayerPos ( playerid, position_skin_shop [ 0 ], position_skin_shop [ 1 ], position_skin_shop [ 2 ] ) ;
				SetPlayerFacingAngle ( playerid, position_skin_shop [ 3 ] ) ;
				TogglePlayerControllable ( playerid, 0 ) ;

				SetPlayerCameraPos ( playerid, camera_position_skin_shop [ 0 ], camera_position_skin_shop [ 1 ], camera_position_skin_shop [ 2 ] ) ;
				SetPlayerCameraLookAt ( playerid, camera_position_skin_shop [ 3 ], camera_position_skin_shop [ 4 ], camera_position_skin_shop [ 5 ] ) ;

				SetPlayerSkin ( playerid, shop_skins [ p_info [ playerid ] [ gender ] ] [ 0 ] ) ;

				if ( player_device { playerid } == 2 ) show_clothes ( playerid, 1 ) ;
				else show_skinshop_ptd ( playerid, 1, true ) ;
			}
			else if ( listitem == 1 )
			{
				show_dialog ( playerid, d_accessories, DIALOG_STYLE_LIST, "{"#cBHD"}Аксессуары", "{"#cGRDialog"}- {"#cWH"}Наушники\n{"#cGRDialog"}- {"#cWH"}Шапки\n{"#cGRDialog"}- {"#cWH"}Панамы\n{"#cGRDialog"}- {"#cWH"}Кепки\n{"#cGRDialog"}- {"#cWH"}Каски\n{"#cGRDialog"}- {"#cWH"}Береты\n{"#cGRDialog"}- {"#cWH"}Парики\n{"#cGRDialog"}- {"#cWH"}Очки\n{"#cGRDialog"}- {"#cWH"}Повязки\n{"#cGRDialog"}- {"#cWH"}Шляпы\n{"#cGRDialog"}- {"#cWH"}Часы\n{"#cGRDialog"}- {"#cWH"}Портфели\n{"#cGRDialog"}- {"#cWH"}Банданы\n{"#cGRDialog"}- {"#cWH"}Сумки", "Выбрать", "Закрыть" ) ;
			}
			return 1 ;
		}
		case d_accessories:
		{
			if ( ! response ) return 1 ;
			skinShopAccessories ( playerid, accessories_items [ listitem ] [ 0 ] ) ;

			SetPVarInt ( playerid, "p_acc_listitem", listitem + 1 ) ;
			SetPVarInt ( playerid, "p_acc_view", 1 ) ;
			TogglePlayerSpectating ( playerid, false ) ;
			TogglePlayerControllable ( playerid, true ) ;
			set_world ( playerid, playerid ) ;
			SetPlayerPos ( playerid, position_acs_shop [ 0 ], position_acs_shop [ 1 ], position_acs_shop [ 2 ] ) ;
			SetPlayerFacingAngle ( playerid, position_acs_shop [ 3 ] ) ;
			TogglePlayerControllable ( playerid, 0 ) ;

			acs_pickup [ playerid ] = CreateDynamicPickup ( accessories_items [ listitem ] [ 0 ], 23, acs_shop_position [ 0 ], acs_shop_position [ 1 ], acs_shop_position [ 2 ], playerid, GetPlayerInterior ( playerid ), -1 ) ;
			Streamer_Update ( playerid ) ;

			SetPlayerCameraPos ( playerid, camera_position_acs_shop [ 0 ], camera_position_acs_shop [ 1 ], camera_position_acs_shop [ 2 ] ) ;
			SetPlayerCameraLookAt ( playerid, camera_position_acs_shop [ 3 ], camera_position_acs_shop [ 4 ], camera_position_acs_shop [ 5 ] ) ;

			if ( player_device { playerid } == 2 ) show_clothes ( playerid, 2 ) ;
			else show_skinshop_ptd ( playerid, 2, true ) ;
			return 1 ;
		}
		case d_buy_accessories:
		{
			if ( ! response )return SelectTextDraw ( playerid, 0xB0C4DEFF ) ;

			accept_buy_accessories ( playerid ) ;
			return 1 ;
		}
		case d_accessories_exit:
		{
			if ( ! response ) return SelectTextDraw ( playerid, 0xB0C4DEFF ) ;

			close_buy_accessories ( playerid ) ;
			return 1 ;
		}
		case d_buy_skin:
		{
			if ( ! response )
			{
				SelectTextDraw ( playerid, 0xB0C4DEFF ) ;
				return 1 ;
			}

		    new line_string [ 80 ] ;
			global_string [ 0 ] = EOS ;
			strcat ( global_string, "{"#cBL"}Выберите слот одежды\n" ) ;
			for ( new j = 0 ; j < 5 ; j ++ )
			{
				if ( p_info [ playerid ] [ temp_skin ] [ j ] == 0 )
				{
					strcat ( global_string, "{"#cGRDialog"}- Пусто\n" ) ;
				}
				else
				{
					format ( line_string, sizeof line_string, "{ffffff}Одежда '%s' (%d)\n", get_skin_name ( p_info [ playerid ] [ temp_skin ] [ j ] ), p_info [ playerid ] [ temp_skin ] [ j ] ) ;
					strcat ( global_string, line_string ) ;
				}
			}
			show_dialog ( playerid, d_ss_clothes, DIALOG_STYLE_LIST, "{"#cBHD"}Магазин одежды", global_string, "Выбрать", "Назад" ) ;
			return 1 ;
		}
		case d_ss_clothes:
		{
			if ( ! response )
			{
				SelectTextDraw ( playerid, 0xB0C4DEFF ) ;
				return 1 ;
			}

			if ( listitem == 0 )
			{
				new line_string [ 80 ] ;
				global_string [ 0 ] = EOS ;
				strcat ( global_string, "{"#cBL"}Выберите слот одежды\n" ) ;
				for ( new j = 0 ; j < 5 ; j ++ )
				{
					if ( p_info [ playerid ] [ temp_skin ] [ j ] == 0 )
					{
						strcat ( global_string, "{"#cGRDialog"}- Пусто\n" ) ;
					}
					else
					{
						format ( line_string, sizeof line_string, "{ffffff}Одежда '%s' (%d)\n", get_skin_name ( p_info [ playerid ] [ temp_skin ] [ j ] ), p_info [ playerid ] [ temp_skin ] [ j ] ) ;
						strcat ( global_string, line_string ) ;
					}
				}
				show_dialog ( playerid, d_ss_clothes, DIALOG_STYLE_LIST, "{"#cBHD"}Магазин одежды", global_string, "Выбрать", "Назад" ) ;
				return 1 ;
			}

			new _ss_number = GetPVarInt ( playerid, "skin_select_number" ), _gender = p_info [ playerid ] [ gender ] ;
			if ( p_info [ playerid ] [ money ] < shop_skins_price [ _gender ] [ _ss_number ] )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас недостаточно средств для приобретения одежды.") ;
			give_money ( playerid, - shop_skins_price [ _gender ] [ _ss_number ] ) ;
			insert_money_log ( playerid, INVALID_PLAYER_ID, - shop_skins_price [ _gender ] [ _ss_number ], "Покупка скина" ) ;

			checking_quest_progress ( playerid, 0, 1, quest_line_medium ) ;

			if ( p_info [ playerid ] [ temp_skin ] [ listitem - 1 ] > 0 )
			{
				MODEL_INFO [ p_info [ playerid ] [ temp_skin ] [ listitem - 1 ] ] [ MODEL_COUNT ] -= 1 ;
				set_model_count ( p_info [ playerid ] [ temp_skin ] [ listitem - 1 ], MODEL_INFO [ p_info [ playerid ] [ temp_skin ] [ listitem - 1 ] ] [ MODEL_COUNT ] ) ;
			}

			set_skin ( playerid, shop_skins [ _gender ] [ _ss_number ] ) ;
			p_info [ playerid ] [ temp_skin ] [ listitem - 1 ] = shop_skins [ _gender ] [ _ss_number ] ;

			MODEL_INFO [ p_info [ playerid ] [ temp_skin ] [ listitem - 1 ] ] [ MODEL_COUNT ] += 1 ;
			set_model_count ( p_info [ playerid ] [ temp_skin ] [ listitem - 1 ], MODEL_INFO [ p_info [ playerid ] [ temp_skin ] [ listitem - 1 ] ] [ MODEL_COUNT ] ) ;

			new _query [ 126 ] ;
			format ( _query, sizeof ( _query ), "UPDATE `users` SET `u_tempskin`='%d|%d|%d|%d|%d' WHERE `u_id` = '%d' LIMIT 1",
			p_info [ playerid ] [ temp_skin ] [ 0 ], p_info [ playerid ] [ temp_skin ] [ 1 ], p_info [ playerid ] [ temp_skin ] [ 2 ],
			p_info [ playerid ] [ temp_skin ] [ 3 ], p_info [ playerid ] [ temp_skin ] [ 4 ], p_info [ playerid ] [ id ] ) ;
			mysql_tquery ( sql_connection, _query ) ;

			new b = GetPVarInt ( playerid, "p_biz_id" ) - 1 ;
			TogglePlayerControllable ( playerid, true ) ;
			SetCameraBehindPlayer ( playerid ) ;
			set_world ( playerid, b_info [ b ] [ b_id ] + 1000 ) ;

			give_bmoney ( b + 1, floatround ( shop_skins_price [ _gender ] [ _ss_number ] * 0.22 ), 75 ) ;

			if ( player_device { playerid } == 2 ) show_packet_clothes ( playerid, 3, "" ) ;
			else show_skinshop_ptd ( playerid, 1, false ) ;

			DeletePVar ( playerid, "skin_select_number" ) ;
			p_skin_shop [ playerid ] = false ;

			if ( ! users_education [ playerid ] [ EDUCATION_SKIN_INFO ] )
			{
				show_window_monologue (
					playerid,
					5,
					"Теперь ты модный, ха! Смотри, если вдруг захочешь переодеться, \
					то сможешь ты это сделать в доме, квартире, семейном доме, отеле. \
					Одежду с гардероба можно продать ТОЛЬКО через маркет плэйс в планшете.",
					"Местный",
					"Понял"
				) ;

				save_user_education ( playerid, EDUCATION_SKIN_INFO ) ;
			}
			return 1 ;
		}
		case d_fixcar:
		{
		    if ( ! response ) return clear_player_listitem_values ( playerid ) ;

		    if ( listitem == 0 ) return callcmd::fixcar ( playerid ) ;

		    new _car_id = get_player_listitem_values ( playerid, listitem - 1 ) ;
		    clear_player_listitem_values ( playerid ) ;

		    if ( _car_id == -1 )
		    {
		        show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Информация", "{"#cRD"}ВНИМАНИЕ!\n\n{"#cRD"}ОДИН ИЗ ВАШИХ АВТОМОБИЛЕЙ НАХОДИТСЯ НА ШТРАФСТОЯНКЕ\n{"#cBL"}Чтобы забрать используйте {"#cWH"}'/gps > Прочее > Штрафстоянка'{"#cBL"}.", "Принять", "Закрыть" ) ;
				return 1 ;
			}
			else if ( _car_id == -2 )
		    {
		        show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Информация", "{"#cRD"}ВНИМАНИЕ!\n\n{"#cRD"}ОДИН ИЗ ВАШИХ АВТОМОБИЛЕЙ ВЫСТАВЛЕН НА ПРОДАЖУ НА АВТОРЫНКЕ\n{"#cBL"}Чтобы забрать используйте {"#cWH"}'/gps > Бизнесы > Авторынки'{"#cBL"}.", "Принять", "Закрыть" ) ;
				return 1 ;
			}
			else if ( _car_id == -3 )
		    {
		        show_dialog ( playerid, d_fixcar_fam, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Информация", "{"#cWH"}Весь Ваш транспорт, который находится в семье вернётся в Ваши владения.\n\n{"#cGRDialog"}* Вы уверены, что хотите забрать весь транспорт?", "Принять", "Закрыть" ) ;
				return 1 ;
			}
			else if ( _car_id == -100 )
		    {
		        show_dialog ( playerid, d_fixcar_fam, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Информация", "{"#cWH"}Весь Ваш транспорт, который находится в семье вернётся в Ваши владения.\n\n{"#cGRDialog"}* Вы уверены, что хотите забрать весь транспорт?", "Принять", "Закрыть" ) ;
				return 1 ;
			}

			new _finded_cars = false, _inc_id ;
			foreach(new _veh_id: player_vehicles[playerid])
			{
			    if ( veh_info [ _veh_id - 1 ] [ v_id ] != _car_id ) continue ;

			    _inc_id = _veh_id ;
			    _finded_cars = true ;
			    break ;
			}

			if ( ! _finded_cars )
			{
				show_dialog ( playerid, d_fixcar_last, DIALOG_STYLE_LIST, "{"#cBHD"}Загрузка транспорта", "{"#cBL"}1. {"#cWH"}Загрузить на месте парковки\n{"#cBL"}2. {"#cWH"}Загрузить рядом с Вами [{"#cGN"}200.000"valute_title_"{"#cWH"}]", "Выбрать", "Закрыть" ) ;
				set_player_use_listitem ( playerid, _car_id ) ;
			    return 1 ;
			}

			set_player_use_listitem ( playerid, _inc_id ) ;

			new header_string [ 46 ] ;
			format ( header_string, sizeof header_string, "{"#cBHD"}%s", GetVehicleNameEx ( _inc_id ) ) ;

			global_string [ 0 ] = EOS ;
			strcat ( global_string, "{"#cBL"}1. {"#cWH"}Выгрузить транспорт с сервера\n" ) ;
			strcat ( global_string, "{"#cBL"}2. {"#cWH"}Отметить транспорт на GPS\n" ) ;
			strcat ( global_string, "{"#cBL"}3. {"#cWH"}Отправить на штрафстоянку\n" ) ;
			strcat ( global_string, "{"#cBL"}4. {"#cWH"}Доставка т/с к месту парковки [{"#cGN"}1200"valute_title_"{"#cWH"}]\n" ) ;
			if ( veh_info [ _inc_id - 1 ] [ v_locked ] == false ) strcat ( global_string, "{"#cBL"}5. {"#cWH"}Открыть транспорт\n" ) ;
			else strcat ( global_string, "{"#cBL"}5. {"#cWH"}Закрыть транспорт\n" ) ;
			if ( Iter_Count(player_houses[playerid]) > 0 ) strcat ( global_string, "{"#cBL"}6. {"#cWH"}Отбуксировать к дому\n" ) ;
			show_dialog
			(
				playerid, d_fine_fixcar, DIALOG_STYLE_LIST,
				header_string, global_string,
				"Выбрать", "Закрыть"
			) ;
			return 1 ;
		}
		case d_fixcar_last:
		{
			if ( ! response ) return 1 ;

			if ( listitem == 1 )
			{
				if ( GetPlayerInterior ( playerid ) > 0 )
					return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRDialog"}Сперва выйдите на улицу!" ) ;

				if ( p_info [ playerid ] [ money ] < 200_000 )
					return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRDialog"}У Вас недостаточно средств!" ) ;

				give_money ( playerid, -200_000 ) ;
				insert_money_log ( playerid, INVALID_PLAYER_ID, -200_000, "d_fixcar_last" ) ;
			}

			global_string [ 0 ] = EOS ;
			format ( global_string, 256, "SELECT uv.*, lp.* \
								FROM users_vehicles uv \
								LEFT JOIN licence_plate lp \
								ON lp.licence_plate_use_own_car_id = uv.v_id \
								WHERE `v_id` = '%d' LIMIT 1", get_player_use_listitem ( playerid ) ) ;
			mysql_tquery ( sql_connection, global_string, "load_player_vehicles", "iii", playerid, false, -1 ) ;

			set_player_use_listitem ( playerid, listitem ) ;
			return 1 ;
		}
		case d_fine_fixcar:
		{
		    if ( ! response ) return 1 ;

		    new vehicleid = get_player_use_listitem ( playerid ) ;
		    if ( listitem == 0 )
		    {
		        if ( GetPlayerVehicleID ( playerid ) == vehicleid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Сперва покиньте транспорт." ) ;
				if ( veh_info [ vehicleid - 1 ] [ v_owner ] != p_info [ playerid ] [ id ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Произошла ошибка. Повторите попытку. Ошибка: d_fixcar." ) ;

				static const _str [ ] = "UPDATE `users_vehicles` SET `v_fuel` = '%f',`v_millage` = '%f' WHERE `v_id` = '%d' LIMIT 1" ;
				new sql_string [ sizeof _str + ( 3 * 9 ) ] ;
				format ( sql_string, sizeof sql_string, _str,
				veh_info [ vehicleid - 1 ] [ v_fuel ],
				veh_info [ vehicleid - 1 ] [ v_millage ],
				veh_info [ vehicleid - 1 ] [ v_id ] ) ;
				mysql_tquery ( sql_connection, sql_string ) ;

				sql_string [ 0 ] = EOS ;
				format ( sql_string, 110, "{"#cGInfo"}* {"#cWH"}Вы успешно выгрузили {"#cGN"}%s{"#cWH"} из игры.", GetVehicleNameEx ( vehicleid ) ) ;
				SendClientMessage ( playerid, col_white, sql_string ) ;

		        Iter_Remove(player_vehicles[playerid], vehicleid ) ;

				DestroyVehicle ( vehicleid, 101 ) ;
		    }
		    else if ( listitem == 1 )
		    {
		        if ( veh_info [ vehicleid - 1 ] [ v_gps_tracker ] == 0 )
				{
					SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}В данном транспорте нет GPS-трекера." ) ;
					SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Воспользуйтесь бизнесом TowCar для буксировки т/с. Используйте /gps - Бизнесы." ) ;
					return 1 ;
				}

				SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}[GPS] - Метка установлена." ) ;
				is_gps_used { playerid } = 1 ;

	            find_mark ( playerid, vehicleid ) ;
		    }
		    else if ( listitem == 2 )
		    {
		        if ( GetPlayerVehicleID ( playerid ) == vehicleid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Сперва покиньте транспорт." ) ;
				if ( v_plane ( vehicleid ) || v_boat ( vehicleid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Лодки и самолёты нельзя отправлять на штрафстоянку." ) ;
				if ( veh_info [ vehicleid - 1 ] [ v_owner ] != p_info [ playerid ] [ id ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Произошла ошибка. Повторите попытку. Ошибка: d_fixcar." ) ;

		        new query_string [ 156 ] ;
				format ( query_string, sizeof ( query_string ),"UPDATE `users_vehicles` SET `v_fuel` = '%f',`v_millage` = '%f',`v_fine` = '1' WHERE `v_id` = '%d' LIMIT 1",
				veh_info [ vehicleid - 1 ] [ v_fuel ],
				veh_info [ vehicleid - 1 ] [ v_millage ],
				veh_info [ vehicleid - 1 ] [ v_id ] ) ;
				mysql_tquery ( sql_connection, query_string, "", "" ) ;

				Iter_Remove(player_vehicles[playerid], vehicleid ) ;
				show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Информация", "{"#cRD"}ВНИМАНИЕ!\n\n{"#cRD"}ОДИН ИЗ ВАШИХ АВТОМОБИЛЕЙ НАХОДИТСЯ НА ШТРАФСТОЯНКЕ\n{"#cBL"}Чтобы забрать используйте {"#cWH"}'/gps > Прочее > Штрафстоянка'{"#cBL"}.", "Закрыть", "" ) ;

				veh_info [ vehicleid - 1 ] [ v_owner ] =
				veh_info [ vehicleid - 1 ] [ v_rank ] =
				veh_info [ vehicleid - 1 ] [ v_type ] = 0 ;
				DestroyVehicle ( vehicleid, 102 ) ;
		    }
		    else if ( listitem == 3 )
		    {
		        if ( GetPlayerVehicleID ( playerid ) == vehicleid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Сперва покиньте транспорт." ) ;
				if ( veh_info [ vehicleid - 1 ] [ v_owner ] != p_info [ playerid ] [ id ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Произошла ошибка. Повторите попытку. Ошибка: d_fixcar." ) ;
				if ( p_info [ playerid ] [ money ] < 200_000 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRDialog"}У Вас недостаточно средств!" ) ;

		        foreach(new i: logged_players)
				{
					if ( IsPlayerInVehicle ( i, vehicleid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGR"}Транспорт используется." ) ;
					if ( is_player_in_boat [ i ] == vehicleid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGR"}Нельзя отбуксировать яхту, внутри которой находитесь Вы или другие люди." ) ;
				}
				SetVehicleToRespawn ( vehicleid, 12 ) ;
				give_money ( playerid, -1200 ) ;
				insert_money_log ( playerid, INVALID_PLAYER_ID, -1200, "/fixcar" ) ;

				SendClientMessage ( playerid, col_gray, !"* Транспорт отремонтирован и отбуксирован к месту стоянки." ) ;
		    }
		    else if ( listitem == 4 )
		    {
				PlayerPlaySound ( playerid, 1145, 0.0, 0.0, 0.0 ) ;
				toggle_locked ( playerid, vehicleid ) ;
		    }
		    else if ( listitem == 5 )
