callback: main_jobs_timer ( playerid )
{
	new _timejob = p_info [ playerid ] [ timejob ] ;
	if ( _timejob == job_miner )
	{
		mining_ex [ playerid ] = false ;
		ApplyAnimation ( playerid,"PED","IDLE_chat",4.1,0,0,0,1,5150 ) ;
		if ( IsPlayerAttachedObjectSlotUsed ( playerid, 1 ) ) RemovePlayerAttachedObject ( playerid, 1 ) ;
		SetPlayerAttachedObject ( playerid, 2, 905, 5, 0.020944, 0.039285, -0.035010, 0.000000, 0.000000, 0.000000, 0.301603, 0.125763, 0.233199  ) ;
		SetPlayerAttachedObject ( playerid, 3, 906, 6, -0.032336, 0.111448, 0.001745, 0.000000, 0.000000, 0.000000, 0.026124, 0.048238, 0.048593 ) ;
		job_timer [ playerid ] = SetTimerEx ( "_miner_timer", 5700, false, "i", playerid ) ;
		return 1 ;
	}
	else if ( _timejob == job_factory )
	{
		RemovePlayerAttachedObject ( playerid, 0 ) ;
		RemovePlayerAttachedObject ( playerid, 1 ) ;

		ClearAnimations ( playerid ) ;
		table_area_toggled [ factory_table_id { playerid } ] = INVALID_PLAYER_ID ;

		if( ! IsPlayerInDynamicArea ( playerid, table_area [ factory_table_id { playerid } ] ) )
		{
			factory_table_id { playerid } = 0 ;
			ApplyAnimation ( playerid, "CARRY", "crry_prtial", 4.1, 0, 1, 1, 1, 1 ) ;
			SetTimerEx ( "carry_timer", 500, false, "d", playerid ) ;
			return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Запчасть оказалась бракованной. Пожалуйста, повторите попытку." ) ;
		}
		factory_table_id { playerid } = 0 ;

		if ( random ( 100 ) > 5 )
		{
			SetPlayerAttachedObject ( playerid, 0, 3013, 6, 0.0, 0.10, -0.2, -110.0, 0.0, 78.0 ) ;
			SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы собрали запчасти. Отнесите их на склад." ) ;

			p_t_info [ playerid ] [ p_animation ] = true ;

			SetPlayerCheckpoint ( playerid, factory_box_unload [ 0 ], factory_box_unload [ 1 ], factory_box_unload [ 2 ], 4.0 ) ;
			is_checkpoint_used { playerid } = 1 ;

			ApplyAnimation ( playerid, "CARRY", "crry_prtial", 4.1, 0, 1, 1, 1, 1 ) ;
			SetTimerEx ( "carry_timer", 500, false, "d", playerid ) ;

			give_event_progress ( playerid, THE_FACTORY, 1 ) ;
		}
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Запчасть оказалась бракованной. Пожалуйста, повторите попытку сбора." ) ;
	}
	else if ( _timejob == job_sawmil )
	{
	    tree_process [ playerid ] = 0 ;

		KillTimer ( job_timer [ playerid ] ) ;
		job_timer [ playerid ] = -1 ;

		new _derevo_id = tree_id [ playerid ] ;
		DestroyDynamicObject ( tree_object [ _derevo_id ] ) ;
		tree_object [ _derevo_id ] = INVALID_OBJECT_ID ;

		if ( IsValidDynamicPickup ( tree_pick [ _derevo_id ] ) ) DestroyDynamicPickup ( tree_pick [ _derevo_id ] ) ;

		tree_pick [ _derevo_id ] = CreateDynamicPickup ( 1463, 23, tree_positions [ _derevo_id ] [ 0 ], tree_positions [ _derevo_id ] [ 1 ], tree_positions [ _derevo_id ] [ 2 ], -1, -1, playerid ) ;
		pick_info [ tree_pick [ _derevo_id ] ] [ pick_type ] = pick_type_server ;

		new _chance [ 2 ] = { 4, 10 } ;
		if ( p_info [ playerid ] [ crime_plus ] == true ) _chance [ 0 ] = 2, _chance [ 1 ] = 3 ;

		if ( random ( _chance [ 0 ] ) == 1 )
		{
		    new _count = random ( 20 ) + 3 ;
		    give_inventory ( playerid, 1463, _count, 0, "", "", NUMBERPLATE_TYPE_NONE, 0 ) ;
			SendClientMessage ( playerid, col_yellow, !"* Вам был добавлен предмет 'Дерево'. Откройте инвентарь, используйте /mm или радиальное меню." ) ;
			SendClientMessage ( playerid, col_yellow, !"* Предмет понадобится для крафта. ({"#cGRInfo"}/help - Крафт{FFFF00})" ) ;
		}

		if ( random ( _chance [ 1 ] ) == 1 )
		{
		    new _count = random ( 10 ) + 3 ;
		    give_inventory ( playerid, 2684, _count, 0, "", "", NUMBERPLATE_TYPE_NONE, 0 ) ;
			SendClientMessage ( playerid, col_yellow, !"* Вам был добавлен предмет 'Хлопок'. Откройте инвентарь, используйте /mm или радиальное меню." ) ;
			SendClientMessage ( playerid, col_yellow, !"* Предмет понадобится для крафта. ({"#cGRInfo"}/help - Крафт{FFFF00})" ) ;
		}

		DisablePlayerCheckpoint ( playerid ) ;
		return 1 ;
	}
	return 1 ;
}

callback: _miner_timer ( playerid ) // выдача телеги
{
	new cp_id = player_miner_cp { playerid } ;
	player_miner_cp { playerid } = 0 ;

	if ( ! IsPlayerInRangeOfPoint ( playerid, 5.5, miner_cp [ cp_id ] [ 0 ], miner_cp [ cp_id ] [ 1 ], miner_cp [ cp_id ] [ 2 ] ) )
	{
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы разроняли всё добытое железо." ) ;

		p_t_info [ playerid ] [ p_animation ] = false  ;
		ClearAnimations ( playerid ) ;

		RemovePlayerAttachedObject ( playerid, 2 ) ;
		RemovePlayerAttachedObject ( playerid, 3 ) ;
		DisablePlayerCheckpoint ( playerid ) ;

		if ( job_timer [ playerid ] != -1 ) KillTimer ( job_timer [ playerid ] ) ;

		new _random = random ( 6 ) ;
		SetPlayerCheckpoint ( playerid, miner_cp [ _random ] [ 0 ], miner_cp [ _random ] [ 1 ], miner_cp [ _random ] [ 2 ], 2.5 ) ;
		is_checkpoint_used { playerid } = 2 ;

		player_miner_cp { playerid } = _random ;

		SetPlayerAttachedObject ( playerid, 1, 18634, 14, 0.333391, 0.000000, 0.042249, 358.219909, 268.014739, 170.032974, 2.003867, 1.764811, 1.579773 ) ;

		ClearAnimations ( playerid ) ;
		return 1 ;
	}

	if ( IsPlayerAttachedObjectSlotUsed ( playerid, 2 ) ) RemovePlayerAttachedObject ( playerid, 2 ) ;
	if ( IsPlayerAttachedObjectSlotUsed ( playerid, 3 ) ) RemovePlayerAttachedObject ( playerid, 3 ) ;
	SetPlayerAttachedObject ( playerid, 2, 1458, 1, -1.034844, 1.116571, -0.065124, 76.480148, 75.781570, 280.952545, 0.575599, 0.604554, 0.624122 ) ;
	SetPlayerAttachedObject ( playerid, 3, 905, 1, -0.275758, 1.305280, 0.000000, 0.000000, 0.000000, 0.000000, 1.000000, 1.000000, 1.000000 ) ;

	SetPlayerCheckpoint ( playerid, miner_unload_position [ 0 ], miner_unload_position [ 1 ], miner_unload_position [ 2 ], 2.0 ) ;
	is_checkpoint_used { playerid } = 2 ;

	new _mine_count_ = RandomEx ( 30, 60 ) ;
	SetPVarInt ( playerid, "_mine_count", _mine_count_ ) ;

	new _t_string [ 32 ] ;
	format ( _t_string, sizeof ( _t_string ), "Вы добыли %d кг руды.", _mine_count_ ) ;
	SendClientMessage ( playerid, col_white, _t_string ) ;

	give_global_quest ( playerid, 6, _mine_count_ ) ;

	new _chance [ 2 ] = { 4, 10 } ;
	if ( p_info [ playerid ] [ crime_plus ] == true ) _chance [ 0 ] = 2, _chance [ 1 ] = 3 ;

	if ( random ( _chance [ 0 ] ) == 1 )
	{
		new _count = random ( 20 ) + 3 ;
	    give_inventory ( playerid, 905, _count, 0, "", "", NUMBERPLATE_TYPE_NONE, 0 ) ;
		SendClientMessage ( playerid, col_yellow, !"* Вам был добавлен предмет 'Камень'. Откройте инвентарь, используйте /mm или радиальное меню." ) ;
		SendClientMessage ( playerid, col_yellow, !"* Предмет понадобится для крафта. ({"#cGRInfo"}/help - Крафт{FFFF00})" ) ;
	}

	if ( random ( _chance [ 1 ] ) == 1 )
	{
		new _count = random ( 10 ) + 3 ;
	    give_inventory ( playerid, 19941, _count, 0, "", "", NUMBERPLATE_TYPE_NONE, 0 ) ;
		SendClientMessage ( playerid, col_yellow, !"* Вам был добавлен предмет 'Золото'. Откройте инвентарь, используйте /mm или радиальное меню." ) ;
		SendClientMessage ( playerid, col_yellow, !"* Предмет понадобится для крафта. ({"#cGRInfo"}/help - Крафт{FFFF00})" ) ;
	}

	give_event_progress ( playerid, THE_ROCK, 1 ) ;
	return 1 ;
}

stock show_ad_list ( playerid )
{
	new bool: total_ad = false, advertise_id = 0, line_string [ 128 ] ;
	global_string [ 0 ] = EOS ;
	for ( new i = 0 ; i < MAX_ADVERTS ; i ++ )
	{
		if ( ad_info [ i ] [ ad_busy ] )
		{
			set_player_listitem_values ( playerid, advertise_id, i ) ;

			advertise_id ++ ;

			if ( ad_info [ i ] [ ad_checking ] ) format( line_string, sizeof ( line_string ),"{"#cBL"}%i. {"#cWH"}%s - {"#cYW"}Проверяется (%s){"#cWH"}\n", advertise_id, ad_info [ i ] [ ad_sender ], ad_info [ i ] [ ad_checker ] ) ;
			if ( ad_info [ i ] [ ad_checked ] ) format( line_string, sizeof ( line_string ),"{"#cBL"}%i. {"#cWH"}%s - {"#cGN"}Проверено (%s)\n", advertise_id, ad_info [ i ] [ ad_sender ], ad_info [ i ] [ ad_checker ] ) ;
			if ( ! ad_info [ i ] [ ad_checked ] && ! ad_info [ i ] [ ad_checking ] ) format ( line_string, sizeof ( line_string ),"{"#cBL"}%i. {"#cWH"}от %s {"#cLY"}[тел. %d]{"#cWH"}\n", advertise_id, ad_info [ i ] [ ad_sender ], ad_info [ i ] [ ad_phone_number ] ) ;

			strcat ( global_string, line_string ) ;

			total_ad = true ;
		}
		else continue ;
	}
	if ( total_ad == false ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нет объявлений, нуждающихся в обработке." ) ;
	show_dialog ( playerid, d_ad_list, DIALOG_STYLE_LIST, "{"#cBHD"}Объявления", global_string, "Принять", "Отмена" ) ;
	return 1;
}

