			format ( scm_string, sizeof scm_string, "{"#cGInfo"}* {"#cWH"}Вы взяли заказ на {"#cGN"}%s{"#cWH"}. Цена устранения: {"#cGN"}%d"valute_title_"{"#cWH"}.", p_info [ target_id ] [ name ], p_info [ target_id ] [ head_value ] ) ;
