			           	if ( f_info [ i ] [ f_tr_status ] == 0 || f_info [ i ] [ f_tr_status_map ] == 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Тренировочная площадка закрыта." ) ;

