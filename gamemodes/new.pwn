callback: rent_vehicles_loading ( )
{
	new rows, fields, time = GetTickCount ( ) ;
	cache_get_data ( rows, fields ) ;
	if( rows )
	{
		for ( new i = 0 ; i < rows ; i ++ )
		{
		    new veh_id = GetVehicleID ( ) ;

			veh_info [ veh_id - 1 ] [ v_id ] = cache_get_field_content_int ( i, "sv_id", sql_connection ) ;
			veh_info [ veh_id - 1 ] [ v_model ] = cache_get_field_content_int ( i, "sv_model", sql_connection ) ;
			veh_info [ veh_id - 1 ] [ v_type ] = cache_get_field_content_int ( i, "sv_type", sql_connection ) ;
			veh_info [ veh_id - 1 ] [ v_owner ] = cache_get_field_content_int ( i, "sv_owner", sql_connection ) ;
			veh_info [ veh_id - 1 ] [ v_color ] [ 0 ] = 0 ; //cache_get_field_content_int ( i, "sv_color_1", sql_connection ) ;
			veh_info [ veh_id - 1 ] [ v_color ] [ 1 ] = 0 ; //cache_get_field_content_int ( i, "sv_color_2", sql_connection ) ;

			cache_get_field_content ( i, "sv_plate", veh_info [ veh_id - 1 ] [ v_plate ], sql_connection, 12 ) ;
			veh_info [ veh_id - 1 ] [ v_fuel ] = cache_get_field_content_float ( i,"sv_fuel", sql_connection ) ;
			veh_info [ veh_id - 1 ] [ v_millage ] = cache_get_field_content_float ( i,"sv_millage", sql_connection ) ;
			veh_info [ veh_id - 1 ] [ v_rank ] = cache_get_field_content_int ( i, "sv_rank", sql_connection ) ;

			veh_info [ veh_id - 1 ] [ v_pos ] [ 0 ] = cache_get_field_content_float ( i,"sv_pos_x", sql_connection ) ;
			veh_info [ veh_id - 1 ] [ v_pos ] [ 1 ] = cache_get_field_content_float ( i,"sv_pos_y", sql_connection ) ;
			veh_info [ veh_id - 1 ] [ v_pos ] [ 2 ] = cache_get_field_content_float ( i,"sv_pos_z", sql_connection ) ;
			veh_info [ veh_id - 1 ] [ v_pos ] [ 3 ] = cache_get_field_content_float ( i,"sv_pos_a", sql_connection ) ;

			veh_info [ veh_id - 1 ] [ v_rent_price ] = cache_get_field_content_int ( i, "sv_rent_price", sql_connection ) ;

			veh_info [ veh_id - 1 ] [ v_locked ] = false ;
			veh_info [ veh_id - 1 ] [ v_fuel ] = 35.0 ;

			veh_info [ veh_id - 1 ] [ v_vehicle ] = AddStaticVehicleEx ( veh_info [ veh_id - 1 ] [ v_model ], veh_info [ veh_id - 1 ] [ v_pos ] [ 0 ], veh_info [ veh_id - 1 ] [ v_pos ] [ 1 ], veh_info [ veh_id - 1 ] [ v_pos ] [ 2 ], veh_info [ veh_id - 1 ] [ v_pos ] [ 3 ], veh_info [ veh_id - 1 ] [ v_color ] [ 0 ], veh_info [ veh_id - 1 ] [ v_color ] [ 1 ], SPAWN_TIME_RENTCAR_VEHICLE ) ;
			SetVehicleNumberPlate ( veh_info [ veh_id - 1 ] [ v_vehicle ], veh_info [ veh_id - 1 ] [ v_plate ] ) ;

			new bool: _car_marker = false, _b_id ;
			for ( new b = 0 ; b < b_count ; b ++ )
			{
			    if ( b_info [ b ] [ b_car_marker ] != veh_info [ veh_id - 1 ] [ v_owner ] ) continue ;

			    _car_marker = true ;
			    _b_id = b ;
			    break ;
			}
			if ( _car_marker == true )
			{
			    veh_info [ veh_id - 1 ] [ v_owner ] = b_info [ _b_id ] [ b_id ] ;
				Iter_Add(business_vehicles[veh_info [ veh_id - 1 ] [ v_owner ]], veh_info [ veh_id - 1 ] [ v_vehicle ] ) ;
			}
			else
			    printf ( "[SERVER] В rent_vehicles маркер авто не совпадает с маркером бизнеса. (Маркер авто: %d)", veh_info [ veh_id - 1 ] [ v_owner ] ) ;

			veh_plate ( veh_id ) ;
			veh_info [ veh_id - 1 ] [ v_trunk_open ] = false ;
			veh_info [ veh_id - 1 ] [ v_trunk_load ] = false ;
		}
	}
	printf ( "[SERVER] Загружено %d автомобилей для аренды. (%d ms)", rows, GetTickCount ( ) - time ) ;
   	return 1 ;
}

callback: server_variables_loading ( )
{
	new fields, rows, time = GetTickCount ( ) ;
	cache_get_data ( rows, fields ) ;

	//new lock_status ;
	if ( rows )
	{
        for ( new t = 0 ; t < rows ; t ++ )
        {
			switch ( t )
			{
				case 0:dorm_count [ DORM_SAWMILL ] = cache_get_field_content_int ( t, "var_count", sql_connection ) ;
				case 1:dorm_count [ DORM_MINE ] = cache_get_field_content_int ( t, "var_count", sql_connection ) ;
				case 2:dorm_count [ DORM_FACTORY_GUNS ] = cache_get_field_content_int ( t, "var_count", sql_connection ) ;
				case 3:mine_count [ MINE_MELTED ] = cache_get_field_content_int ( t, "var_count", sql_connection ) ;
				case 4:mine_count [ MINE_UNMELTED ] = cache_get_field_content_int ( t, "var_count", sql_connection ) ;
				case 5:dorm_count [ DORM_FACTORY_MINE ] = cache_get_field_content_int ( t, "var_count", sql_connection ) ;
				case 6:dorm_count [ DORM_FACTORY_WOOD ] = cache_get_field_content_int ( t, "var_count", sql_connection ) ;
				case 7:election_status = cache_get_field_content_int ( t, "var_count", sql_connection ) ;
				//case 8:server_bonus = cache_get_field_content_int ( t, "var_count", sql_connection ) ;

				case 11..15:capture_gang_freezed [ t - 11 ] = cache_get_field_content_int ( t, "var_count", sql_connection ) ;

				case 16:mineral = cache_get_field_content_int ( t, "var_count", sql_connection ) ;
				case 17:AmbarDrugs = cache_get_field_content_int ( t, "var_count", sql_connection ) ;
				case 18..26:zp_for_gos [ t - 18 ] = cache_get_field_content_int ( t, "var_count", sql_connection ) ;
				case 27..33:for_tax [ t - 27 ] = cache_get_field_content_int ( t, "var_count", sql_connection ) ;
				case 34:PritonDrugs = cache_get_field_content_int ( t, "var_count", sql_connection ) ;
				case 35..39:WorkSalary [ t - 35 ] = cache_get_field_content_int ( t, "var_count", sql_connection ) ;
				case 40..47:server_bonus [ t - 40 ] = cache_get_field_content_int ( t, "var_count", sql_connection ) ;
				case 48..51:for_tax [ t - 41 ] = cache_get_field_content_int ( t, "var_count", sql_connection ) ;
				case 52:plant_price = cache_get_field_content_int ( t, "var_count", sql_connection ) ;
				case 53:plant_order = cache_get_field_content_int ( t, "var_count", sql_connection ) ;
				case 54:plant_metall_price = cache_get_field_content_int ( t, "var_count", sql_connection ) ;
				case 55:lottery_prise = cache_get_field_content_int ( t, "var_count", sql_connection ) ;
				case 56,57:zp_for_gos [ t - 47 ] = cache_get_field_content_int ( t, "var_count", sql_connection ) ;
				case 58:server_report = cache_get_field_content_int ( t, "var_count", sql_connection ) ;
				case 59:auto_report = cache_get_field_content_int ( t, "var_count", sql_connection ) ;
				case 60:owner_account_en = cache_get_field_content_int ( t, "var_count", sql_connection ) ;
				case 61:gz_spawn_zz = cache_get_field_content_int ( t, "var_count", sql_connection ) ;
				case 62:offline_report = cache_get_field_content_int ( t, "var_count", sql_connection ) ;
				case 63..65:capture_gang_freezed [ t - 58 ] = cache_get_field_content_int ( t, "var_count", sql_connection ) ;
				case 66:week_gettime = cache_get_field_content_int ( t, "var_count", sql_connection ) ;
				case 67:month_gettime = cache_get_field_content_int ( t, "var_count", sql_connection ) ;
				case 68:online_bonus = cache_get_field_content_int ( t, "var_count", sql_connection ) ;
				case 69:three_week_gettime = cache_get_field_content_int ( t, "var_count", sql_connection ) ;
			}
		}
		printf ( "[SERVER] Загружено %d параметров сервера. (%d ms)", rows, GetTickCount ( ) - time ) ;
//		if ( lock_status != 0 )SendRconCommand("password testatt");

		if ( server_bonus [ 1 ] > 1 ) bonus_activated = true ;
		else bonus_activated = false ;

		if ( election_status != 0 )
		{
			election_pickup = CreateDynamicPickup ( 19134, 23, -1399.8522, -1126.0061, 1520.3199 ) ;
			pick_info [ election_pickup ] [ pick_type ] = pick_type_server ;

			election_text = CreateDynamic3DTextLabel ( "** Выборы **", col_header_3d, -1399.8522, -1126.0061, 1520.3199, 20.0, -1, -1 ) ;
		}

		global_string [ 0 ] = EOS ;
		format ( global_string, 100, "hostname %s", host_name ) ;
        SendRconCommand ( global_string ) ;

        if ( three_week_gettime < 1 )
        {
            three_week_gettime = gettime ( ) ;

			new sql_string [ 81 + 9 ] ;
			format ( sql_string, sizeof sql_string, "UPDATE `server_variables` SET `var_count` = '%d' WHERE `var_id` = '70' LIMIT 1", three_week_gettime ) ;
