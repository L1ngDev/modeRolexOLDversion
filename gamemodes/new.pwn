new loading_time ;

public OnGameModeInit ( )
{
	#if defined m_profiler
		Profiler_Start ( ) ;
	#endif

    loading_time = GetTickCount ( ) ;

	global_weather = 4 ;

	new _ip_addreas [ 16 ] ;

#if defined server_openmp
    GetConsoleVarAsString ( "network.bind", _ip_addreas, sizeof ( _ip_addreas ) ) ;
	new _port = GetConsoleVarAsInt ( "network.port" ) ;
#else
    GetConsoleVarAsString ( "bind", _ip_addreas, sizeof ( _ip_addreas ) ) ;
	new _port = GetConsoleVarAsInt ( "port" ) ;
#endif

	for ( new i = 0 ; i < sizeof server_info ; i ++ )
	{
		if ( GetString ( _ip_addreas, server_info [ i ] [ ip_addreas ] ) && _port == server_info [ i ] [ ip_port ] )
		{
		    #if defined m_streamsource
				InitStreamSources ( ) ;
			#endif

			sql_connection = mysql_connect ( server_info [ i ] [ host ], server_info [ i ] [ user ], server_info [ i ] [ database ], server_info [ i ] [ db_password ] ) ;
			mysql_tquery ( sql_connection, "CREATE TABLE IF NOT EXISTS `users_testers` (`u_t_id` INT NOT NULL, `u_t_name` VARCHAR(24) NOT NULL, `u_t_issued_by` VARCHAR(24) NOT NULL DEFAULT '', `u_t_issued_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP, PRIMARY KEY (`u_t_id`), UNIQUE KEY `u_t_name` (`u_t_name`)) ENGINE=InnoDB DEFAULT CHARSET=utf8" ) ;
			launcher_connection = mysql_connect (
		/*	"remote.mysql-4416-9f82.advens.cloud",
			"gs24553",
			"gs24553_2",
			"J2ZmMlgF84nAihIflPIZDEaYmMevS6PF" */
			"remote.mysql-4416-9f82.advens.cloud",
			"gs24564",
			"gs24564_2",
			"XiulXAgSacz6zbTkd2UemaYWnR5MH6LH"
		) ;

			server_number = i + 1 ;
			if ( server_info [ i ] [ db_test ] )
			{
				#if defined STAGE
					format ( host_name, sizeof host_name, "Stage | Тестовый" ) ;
				#else
					format ( host_name, sizeof host_name, "Rolex Role Play | Тестовый" ) ;
				#endif
				server_test = 1 ;
			}
			else
			{
				#if defined STAGE
					format ( host_name, sizeof host_name, "Stage | %d server", server_number ) ;
				#else
					format ( host_name, sizeof host_name, "Rolex Role Play | %d server", server_number ) ;
				#endif
			}
		}
	}

	for ( new j = 0 ; j < 5 ; j ++ )
	{
		format ( ip_white_list [ j ], 16, "1" ) ;
	}
	switch ( mysql_errno ( ) )
	{
		case 0: print ( "Подключение к базе данных удалось" ) ;
		case 1044: print ( "Подключение к базе данных не удалось [Указано неизвестное имя пользователя]" ) ;
		case 1045: print ( "Подключение к базе данных не удалось [Указан неизвестный пароль]" ) ;
		case 1049: print ( "Подключение к базе данных не удалось [Указана неизвестная база данных]" ) ;
		case 2003: print ( "Подключение к базе данных не удалось [Хостинг с базой данных недоступен]" ) ;
		case 2005: print ( "Подключение к базе данных не удалось [Указан неизвестный адрес хостинга]" ) ;
		default: printf ( "Подключение к базе данных не удалось [Неизвестная ошибка. Код ошибки: %d]", mysql_errno ( ) ) ;
	}
	print ( "==========================================" );

	mysql_set_charset ( "cp1251", sql_connection ) ;
	mysql_set_charset ( "cp1251", launcher_connection ) ;

	//mysql_log(LOG_ALL); // LOG_ERROR
	mysql_log(LOG_ERROR | LOG_WARNING);

	mysql_tquery ( sql_connection, !"UPDATE `server_vehicles` SET `sv_use` = '0' WHERE `sv_use` = '1'" ) ;
	mysql_tquery ( sql_connection, !"UPDATE `rent_vehicles` SET `sv_use` = '0' WHERE `sv_use` = '1'" ) ;
	mysql_tquery ( sql_connection, !"UPDATE `familys_vehicles` SET `sv_use` = '0' WHERE `sv_use` = '1'" ) ;
	mysql_tquery ( sql_connection, !"DELETE FROM `logs_report` WHERE `r_status` = '0'" ) ;

	mysql_tquery ( sql_connection, !"SELECT * FROM `teleport_areas`", "areas_loading" ) ;

	mysql_tquery ( sql_connection, !"SELECT \
									h.*, \
									IFNULL(u.u_name, 'Собственность штата') AS h_ownername, \
									UNIX_TIMESTAMP(h.h_auction_date) AS h_auction_date \
									FROM houses h \
									LEFT JOIN users u ON u.u_id = h.h_owner", "houses_loading" ) ;

	mysql_tquery ( sql_connection, !"SELECT \
									c.*, \
									IFNULL(u.u_name, 'Собственность области') as u_name \
									FROM cellars c \
									LEFT JOIN users u ON u.u_id = c.cl_owner", "cellars_loading" ) ;

	mysql_tquery ( sql_connection, !"SELECT * FROM `podezd` ORDER BY `podezd`.`p_id` ASC", "podezd_loading" ) ;
	mysql_tquery ( sql_connection, !"SELECT * FROM `autoschool`", "autoschool_loading" ) ;
    mysql_tquery ( sql_connection, !"SELECT * FROM `server_variables`", "server_variables_loading" ) ;
	//mysql_tquery ( sql_connection, !"SELECT * FROM `server_vehicles`", "vehicles_loading" ) ;
	mysql_tquery ( sql_connection, !"SELECT * FROM `radars`", "radars_loading" ) ;

	mysql_tquery ( sql_connection, !"SELECT * FROM `fractions`", "fractions_loading" ) ;

	mysql_tquery ( sql_connection, !"SELECT \
									b.*, \
									IFNULL(u.u_name, 'The State') AS b_owner_name, \
									UNIX_TIMESTAMP(b.b_auction_date) AS b_auction_date \
									FROM businesses b \
									LEFT JOIN users u ON u.u_id = b.b_owner_inc", "businesses_loading" ) ;

	mysql_tquery ( sql_connection, !"SELECT uv.*, lp.* \
									FROM users_vehicles uv \
									LEFT JOIN licence_plate lp \
									ON lp.licence_plate_use_own_car_id = uv.v_id \
									WHERE `v_sell_price` > '0'", "users_vehicles_loading" ) ;

	mysql_tquery ( sql_connection, !"SELECT * FROM `server_info`", "server_info_loading" ) ;
	//mysql_tquery ( sql_connection, !"SELECT * FROM `grafity`", "load_graffity" ) ;

	mysql_tquery ( sql_connection, !"SELECT \
									us.*, \
									IFNULL(u.u_name, 'None') as unit_leader \
									FROM unit_settings us \
									LEFT JOIN users u ON u.u_id=us.unit_leader", "unit_loading" ) ;

	mysql_tquery ( sql_connection, !"SELECT * FROM `bus_first_settings`", "bus_first_loading" ) ;

	new query_string [ 144 ] ;
	format ( query_string, sizeof query_string, "\
		SELECT AUTO_INCREMENT AS id \
		FROM information_schema.TABLES \
		WHERE TABLE_SCHEMA = '%s' AND TABLE_NAME = 'users_accessories'", server_info [ server_number - 1 ] [ database ] ) ;
