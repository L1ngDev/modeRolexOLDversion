					format ( scm_string, sizeof scm_string, "Одобрил(а) объявление %s. Текст: %s", ad_info [ _ad_id ] [ ad_sender ], ad_info [ _ad_id ] [ ad_text ] ) ;
					write_fraction ( playerid, fraction_id, TYPE_LOG_OBWYAK, scm_string ) ;

					p_info [ playerid ] [ salary ] += ad_price / 2 ;

					set_money_fraction ( fraction_id - 1, 4, ad_price / 2, true ) ;

					show_ad_list ( playerid ) ;
				}
				case 2:
				{
					if ( p_info [ playerid ] [ rank ] < 3 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Доступно с 3 ранга." ) ;

					global_string [ 0 ] = EOS ;
					format ( global_string, 512, "\
					{"#cWH"}Отправитель: {"#cBL"}%s\n\
					{"#cWH"}Время подачи: {"#cBL"}%s\n\
					{"#cWH"}Текст отправления: {"#cBL"}%s\n\n\
					{"#cGRDialog"}* Введите новый текст отправления:", ad_info [ _ad_id ] [ ad_sender ], ad_info [ _ad_id ] [ ad_date ], ad_info [ _ad_id ] [ ad_text ] ) ;

					return show_dialog ( playerid, d_ad_redit, DIALOG_STYLE_INPUT, "{"#cBHD"}Редактирование", global_string, "Принять", "Отмена" ) ;
				}
				case 3:
				{
				    global_string [ 0 ] = EOS ;
					format ( global_string, 512, "\
					{"#cWH"}Отправитель: {"#cBL"}%s\n\
					{"#cWH"}Время подачи: {"#cBL"}%s\n\
					{"#cWH"}Текст отправления: {"#cBL"}%s\n\n\
					{"#cGRDialog"}* Введите причину удаления:", ad_info [ _ad_id ] [ ad_sender ], ad_info [ _ad_id ] [ ad_date ], ad_info [ _ad_id ] [ ad_text ] ) ;

					return show_dialog ( playerid, d_ad_delete_player, DIALOG_STYLE_INPUT, "{"#cBHD"}Удаление", global_string, "Принять", "Отмена" ) ;
				}
				case 4:
				{
				    global_string [ 0 ] = EOS ;
					format ( global_string, 512, "\
					{"#cWH"}Отправитель: {"#cBL"}%s\n\
					{"#cWH"}Время подачи: {"#cBL"}%s\n\
					{"#cWH"}Текст отправления: {"#cBL"}%s\n\n\
