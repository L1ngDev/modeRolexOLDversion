        //setLabelCustom ( forplayerid, _id + MAX_3DTEXT_GLOBAL, label_info [ _:itemId ] [ label_background ], label_info [ _:itemId ] [ label_icon ], label_info [ _:itemId ] [ label_db ], label_info [ _:itemId ] [ label_str ] ) ;
	}
	return true ;
}

