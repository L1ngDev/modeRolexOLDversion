				return 1 ;
            }

		    if ( ! strcmp("Удалить чекпоинт", inputtext ) )
			{
			    new sql_string [ 93 + 9 ] ;
			    format ( sql_string, sizeof sql_string, "DELETE FROM `bus_settings` WHERE `b_id` = '%d' ORDER BY `b_id`.`bus_settings` DESC LIMIT 1", bus_info [ bus_count ] [ bus_id ] ) ;
			    mysql_tquery ( sql_connection, sql_string ) ;

			    bus_count -- ;

			    show_admin_route ( playerid ) ;
			    return 1 ;
			}
			else if ( ! strcmp("Добавить чекпоинт", inputtext ) )
			{
			    bus_count ++ ;

			    bus_info [ bus_count ] [ bus_id ] = bus_count ;

			    new sql_string [ 66 + 9 + 9 ] ;
			    format ( sql_string, sizeof sql_string, "INSERT INTO `bus_settings` (`b_id`,`b_step`) VALUES ('%d','%d')", bus_info [ bus_count ] [ bus_id ], bus_first_count ) ;
			    mysql_tquery ( sql_connection, sql_string ) ;

			    show_admin_route ( playerid ) ;
			    return 1 ;
			}

			SetPVarInt ( playerid, "_checkpoint_id", get_player_listitem_values ( playerid, listitem ) ) ;
			clear_player_listitem_values ( playerid ) ;
            show_dialog(playerid, d_bus_admin_route_1, DIALOG_STYLE_LIST, "{"#cBHD"}Редактирование маршрута", "{"#cBL"}1.{"#cWH"} Изменить тип {"#cGRDialog"}(Чекпоинт/Остановка)\n{"#cBL"}2.{"#cWH"} Изменить позицию\n{"#cBL"}3.{"#cWH"} Телепортироваться", "Принять", "Отмена" ) ;
		}
		case d_bus_admin_route_1:
		{
		    if ( ! response ) return show_admin_route ( playerid ) ;

			switch ( listitem )
			{
			    case 0:
			    {
			        new _checkpoint_id = GetPVarInt ( playerid, "_checkpoint_id" ) ;
			        DeletePVar ( playerid, "_checkpoint_id" ) ;
			        if ( bus_info [ _checkpoint_id ] [ bus_stop ] == 1 ) bus_info [ _checkpoint_id ] [ bus_stop ] = 0 ;
