			if ( ! get_player_donate ( playerid, 50, 1 ) )
			{
				show_dialog ( playerid, d_donate_age, DIALOG_STYLE_INPUT, "{"#cBHD"}Донат услуги","{"#cRD"}* У Вас недостаточно средств для приобретения данной услуги.\n\n{"#cGRDialog"}- {"#cWH"}Смена игрового возраста:\n\n{"#cGRDialog"}* Цена: {"#cGN"}50 "donate_title"{"#cGRDialog"}.\n{"#cGRDialog"}* Вы действительно хотите сменить Ваш \"{"#cWH"}Возраст{"#cGRDialog"}\"?","Принять", "Назад");
