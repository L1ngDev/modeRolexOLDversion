		{"#cGRDialog"}- {"#cWH"}Мороженое\t{"#cGN"}%d"valute_title_" {"#cGRDialog"}(рек.: %d"valute_title_")\t{"#cWH"}%d ед.\t{"#cGN"}%d"valute_title_"\n\
		{"#cGRDialog"}- {"#cWH"}Бургер\t{"#cGN"}%d"valute_title_" {"#cGRDialog"}(рек.: %d"valute_title_")\t{"#cWH"}%d ед.\t{"#cGN"}%d"valute_title_"\n\
		{"#cGRDialog"}- {"#cWH"}Хот Дог\t{"#cGN"}%d"valute_title_" {"#cGRDialog"}(рек.: %d"valute_title_")\t{"#cWH"}%d ед.\t{"#cGN"}%d"valute_title_"\n\
		{"#cGRDialog"}- {"#cWH"}Салат\t{"#cGN"}%d"valute_title_" {"#cGRDialog"}(рек.: %d"valute_title_")\t{"#cWH"}%d ед.\t{"#cGN"}%d"valute_title_"\n\
		{"#cGRDialog"}- {"#cWH"}Пицца\t{"#cGN"}%d"valute_title_" {"#cGRDialog"}(рек.: %d"valute_title_")\t{"#cWH"}%d ед.\t{"#cGN"}%d"valute_title_"\n\
		{"#cGRDialog"}- {"#cWH"}Курица с картошкой\t{"#cGN"}%d"valute_title_" {"#cGRDialog"}(рек.: %d"valute_title_")\t{"#cWH"}%d ед.\t{"#cGN"}%d"valute_title_"",
		b_price_market [ b ] [ 0 ], get_b_price_market ( 0, b ), b_shop_product [ 0 ], floatround ( b_price_market [ b ] [ 0 ] - ( b_shop_product [ 0 ] * 3 ) ),
		b_price_market [ b ] [ 1 ], get_b_price_market ( 1, b ), b_shop_product [ 1 ], floatround ( b_price_market [ b ] [ 1 ] - ( b_shop_product [ 1 ] * 3 ) ),
		b_price_market [ b ] [ 2 ], get_b_price_market ( 2, b ), b_shop_product [ 2 ], floatround ( b_price_market [ b ] [ 2 ] - ( b_shop_product [ 2 ] * 3 ) ),
		b_price_market [ b ] [ 3 ], get_b_price_market ( 3, b ), b_shop_product [ 3 ], floatround ( b_price_market [ b ] [ 3 ] - ( b_shop_product [ 3 ] * 3 ) ),
		b_price_market [ b ] [ 4 ], get_b_price_market ( 4, b ), b_shop_product [ 4 ], floatround ( b_price_market [ b ] [ 4 ] - ( b_shop_product [ 4 ] * 3 ) ),
		b_price_market [ b ] [ 5 ], get_b_price_market ( 5, b ), b_shop_product [ 5 ], floatround ( b_price_market [ b ] [ 5 ] - ( b_shop_product [ 5 ] * 3 ) ) ) ;
		show_dialog ( playerid, d_bpanel_cost_market, DIALOG_STYLE_TABLIST_HEADERS, "{"#cBHD"}Наценка на товар", global_string, "Выбрать", "Закрыть" ) ;
	}
	return 1 ;
