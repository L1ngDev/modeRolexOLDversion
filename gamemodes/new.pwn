CMD:editobject ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 8 ) return 1 ;

	if ( sscanf ( params, "dd", params [ 0 ], params [ 1 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /editobject [model] [0 delete / 1 save]") ;

	new edit_object = CreateDynamicObject ( params [ 0 ], p_t_info [ playerid ] [ p_pos ] [ 0 ], p_t_info [ playerid ] [ p_pos ] [ 1 ] + 1.5, p_t_info [ playerid ] [ p_pos ] [ 2 ], 0.0, 0.0, 0.0, GetPlayerVirtualWorld ( playerid ), GetPlayerInterior ( playerid ), -1, 300.0, 300.0 ) ;

	create_type { playerid } = 10 ;
	create_object_id [ playerid ] = edit_object ;
	set_player_use_listitem ( playerid, params [ 1 ] ) ;
	EditDynamicObject ( playerid, edit_object ) ;
	return 1 ;
}

CMD:editattach ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 8 ) return 1 ;

	if ( sscanf ( params, "dd", params [ 0 ], params [ 1 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /editattach [model] [bone (/boneinfo)]") ;

	if ( IsPlayerAttachedObjectSlotUsed ( playerid, 6 ) ) RemovePlayerAttachedObject ( playerid, 6 ) ;
    SetPlayerAttachedObject ( playerid, 6, params [ 0 ], params [ 1 ], 0.089999, -0.054999, -0.010000 , 0.000000, 90.000000, 0.000000 , 1.000000, 1.000000, 1.000000, 0xFF4582A1, 0xFF4582A1 ) ;

	edit_acc [ playerid ] = true ;
	editor_acc [ playerid ] = true ;
	EditAttachedObject ( playerid, 6 ) ;
	return 1 ;
}

CMD:editcolor ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 8 ) return 1 ;

	if ( sscanf ( params, "dd", params [ 0 ], params [ 1 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /editcolor [model] [type]") ;

	if ( IsPlayerAttachedObjectSlotUsed ( playerid, 6 ) ) RemovePlayerAttachedObject ( playerid, 6 ) ;

	if ( params [ 1 ] == 0 )
		SetPlayerAttachedObject ( playerid, 6, params [ 0 ], 0, 0.089999, -0.054999, -0.010000 , 0.000000, 90.000000, 0.000000 , 1.000000, 1.000000, 1.000000, 0xFF4582A1, 0xFF4582A1 ) ;

	else if ( params [ 1 ] == 1 )
		SetPlayerAttachedObject ( playerid, 6, params [ 0 ], 0, 0.089999, -0.054999, -0.010000 , 0.000000, 90.000000, 0.000000 , 1.000000, 1.000000, 1.000000, 0xFFAA3333, 0xFFAA3333 ) ;

	else if ( params [ 1 ] == 2 )
		SetPlayerAttachedObject ( playerid, 6, params [ 0 ], 0, 0.089999, -0.054999, -0.010000 , 0.000000, 90.000000, 0.000000 , 1.000000, 1.000000, 1.000000, 0xFFAFAFAF, 0xFFAFAFAF ) ;

	else if ( params [ 1 ] == 3 )
		SetPlayerAttachedObject ( playerid, 6, params [ 0 ], 0, 0.089999, -0.054999, -0.010000 , 0.000000, 90.000000, 0.000000 , 1.000000, 1.000000, 1.000000, 0xFF33AA33, 0xFF33AA33 ) ;

	edit_acc [ playerid ] = true ;
	editor_acc [ playerid ] = true ;
	EditAttachedObject ( playerid, 6 ) ;
	return 1 ;
}

