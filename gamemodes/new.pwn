	        }

	        f_info [ f ] [ f_tr_skin ] [ 1 ] = _value ;

		    new sql_string [ 128 ] ;
			mysql_format(sql_connection, sql_string, sizeof sql_string, "UPDATE `fractions_training` SET `f_tr_skin_two` = '%d' WHERE `f_id` = '%d' LIMIT 1", f_info [ f ] [ f_tr_skin ] [ 1 ], f + 1 );
			mysql_tquery(sql_connection, sql_string);

