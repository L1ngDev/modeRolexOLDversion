	    case d_business_rank:
		{
			if ( ! response ) return clear_sell_params ( playerid, playerid ) ;
			new _pl_id = buyer_id [ playerid ] ;
			clear_sell_params ( playerid, playerid ) ;

			if ( listitem + 1 >= p_info [ playerid ] [ business_rang ] || p_info [ playerid ] [ business_rang ] <= p_info [ _pl_id ] [ business_rang ] )
				return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете назначить игрока на должность выше Вашей." ) ;

			p_info [ _pl_id ] [ business_rang ] = listitem + 1 ;
			update_int_sql ( _pl_id, "u_business_rang", listitem + 1 ) ;

			new _text_string [ 128 ] ;
			format ( _text_string, 128, "{"#cGInfo"}* {"#cWH"}Вы назначили %s на должность {"#cGN"}%s(%d)", p_info [ _pl_id ] [ name ], b_rank [ p_info [ _pl_id ] [ b_worker ] - 1 ] [ listitem ], listitem + 1 ) ;
			SendClientMessage ( playerid, col_white, _text_string ) ;
			format ( _text_string, 128, "{"#cGN"}* %s {"#cWH"}назначил Вас на должность {"#cGN"}%s(%d)", p_info [ playerid ] [ name ], b_rank [ p_info [ _pl_id ] [ b_worker ] - 1 ] [ listitem ], listitem + 1 ) ;
			SendClientMessage ( _pl_id, col_succes, _text_string ) ;
	        return 1 ;
		}
	    case d_business_invite:
        {
            if ( ! response )
            {
                DeletePVar ( playerid, "business_id" ) ;
                return 1 ;
            }

			new business_id = GetPVarInt ( playerid,"business_id" ) ;
			DeletePVar ( playerid, "business_id" ) ;
			p_info [ playerid ] [ b_worker ] = business_id ;
			p_info [ playerid ] [ business_rang ] = 1 ;

			new _t_string [ 144 ] ;
			format ( _t_string, sizeof ( _t_string ), "UPDATE `users` SET `u_bworker` = '%d',`u_business_rang` = '1' WHERE `u_id` = '%d' LIMIT 1", p_info [ playerid ] [ b_worker ], p_info [ playerid ] [ id ] ) ;
			mysql_tquery(sql_connection, _t_string ) ;

			Iter_Add ( business_players[business_id], playerid ) ;

            format ( _t_string, sizeof ( _t_string ), "{%s}[%s] %s %s[%i] принят(а) на работу!", b_info [ business_id - 1 ] [ b_chat_color ], b_info [ business_id - 1 ] [ b_name ], b_rank [ business_id - 1 ] [ p_info [ playerid ] [ business_rang ] - 1 ], p_info [ playerid ] [ name ], playerid ) ;
 			business_message ( business_id, col_gray, _t_string ) ;
 			SendClientMessage ( playerid, col_gray, !"* Используйте {"#cWH"}/quitjob{"#cGR"}, если захотите уволиться с работы." ) ;
 			SendClientMessage ( playerid, col_gray, !"* Используйте {"#cWH"}/mm - Команды сервера{"#cGR"}, чтоб узнать доступные команды." ) ;
	        return 1 ;
        }
	    case d_makeleader:
	    {
	        if ( ! response ) return 1 ;

	        new scm_string [ 144 ] ;

	        new player_id = GetPVarInt ( playerid, "player_id" ) ;
	        DeletePVar ( playerid, "player_id" ) ;

	        format ( scm_string, sizeof scm_string, "{"#cBAdmin"}[A] {"#cGRAdmin"}%s назначил %s лидером организации \"{"#cBAdmin"}%s{"#cGRAdmin"}\"", p_info [ playerid ] [ name ], p_info [ player_id ] [ name ], f_info [ listitem ] [ f_name ] ) ;
			foreach(new i: admin_players)SendClientMessage ( i, col_admin, scm_string ) ;
			format ( scm_string, sizeof scm_string, "* %s назначил Вас лидером организации \"%s\"", p_info [ playerid ] [ name ], f_info [ listitem ] [ f_name ] ) ;
			SendClientMessage ( player_id, col_yellow, scm_string ) ;

			if ( p_info [ player_id ] [ member ] != 0 ) Iter_Remove ( fraction_players[p_info[player_id][member]], player_id ) ;

			p_info [ player_id ] [ member ] = listitem + 1 ;
			p_info [ player_id ] [ leader ] = listitem + 1 ;
			p_info [ player_id ] [ rank ] = f_info [ listitem ] [ f_rank_settings ] [ 0 ] ;
			p_info [ player_id ] [ org_skin ] = f_skin_rank [ p_info [ player_id ] [ member ] - 1 ] [ p_info [ player_id ] [ gender ] ] [ 0 ] ;

			p_info [ player_id ] [ leader_status ] = GetPVarInt ( playerid, "player_position" ) ;
			DeletePVar ( playerid, "player_position" ) ;

			Iter_Add ( fraction_players[p_info[player_id][member]], player_id ) ;

			new query_string [ 256 ] ;
			f_info [ p_info [ player_id ] [ member ] - 1 ] [ f_members ] ++ ;
			format ( scm_string, 144, "UPDATE `fractions` SET `f_members` = '%d' WHERE `f_id` = '%d' LIMIT 1", f_info [ p_info [ player_id ] [ member ] - 1 ] [ f_members ], p_info [ player_id ] [ member ] ) ;
			mysql_tquery ( sql_connection, scm_string ) ;

			p_info [ player_id ] [ f_warning ] = 0 ;
			p_info [ player_id ] [ spawnchange ] = 2 ;
            p_info [ player_id ] [ org_date ] = 0 ;

			fractionLeaderInsert ( player_id ) ;
			ResetFractionTasks ( player_id, true ) ;
			SetPlayerColor ( player_id, f_info [ p_info [ player_id ] [ member ] - 1 ] [ f_radar_color ] ) ;

			format(query_string, 128, "%s назначил %s лидером %s", p_info [ playerid ] [ name ], p_info [ player_id ] [ name ], f_info [ p_info [ player_id ] [ member ] - 1 ] [ f_name ] );
			WriteLog(playerid, TYPE_LOG_MKL, query_string);

		    SpawnPlayer ( player_id ) ;
	        return 1 ;
	    }
	    case d_templeader:
	    {
	        if ( ! response ) return 1 ;

			new scm_string [ 144 ] ;
			format ( scm_string, sizeof scm_string, "{"#cBAdmin"}[A]{"#cGRAdmin"} %s назначил себя временным лидером организации \"{"#cBAdmin"}%s{"#cGRAdmin"}\"", p_info [ playerid ] [ name ], f_info [ listitem ] [ f_name ] ) ;
			foreach(new i: admin_players) SendClientMessage ( i, col_admin, scm_string ) ;

			if ( p_info [ playerid ] [ member ] != 0 ) Iter_Remove ( fraction_players[p_info[playerid][member]], playerid ) ;

            p_info [ playerid ] [ leader_status ] = 1 ;
			p_info [ playerid ] [ member ] = p_info [ playerid ] [ leader ] =  listitem + 1 ;
			p_info [ playerid ] [ rank ] = f_info [ listitem ] [ f_rank_settings ] [ 0 ] ;
			p_info [ playerid ] [ org_skin ] = f_skin_rank [ p_info [ playerid ] [ member ] - 1 ] [ p_info [ playerid ] [ gender ] ] [ 0 ]	;

			Iter_Add ( fraction_players[p_info[playerid][member]], playerid ) ;
			ResetFractionTasks ( playerid, true ) ;

			SpawnPlayer ( playerid ) ;
	        return 1 ;
	    }
	    case d_fractions_logs:
	    {
	        if ( ! response )
		    {
		        ShowLeaderMenu ( playerid ) ;
		        return 1 ;
		    }
	        switch ( listitem )
	        {
	            case 0: SetPVarInt ( playerid, "logs_type", TYPE_LOG_AGIVERANK + 1 ) ;
				case 1: SetPVarInt ( playerid, "logs_type", TYPE_LOG_WARN + 1 ) ;
				case 2: SetPVarInt ( playerid, "logs_type", TYPE_LOG_BL + 1 ) ;
                case 3: SetPVarInt ( playerid, "logs_type", TYPE_LOG_INVITE + 1 ) ;
				case 4: SetPVarInt ( playerid, "logs_type", TYPE_LOG_UVAL + 1 ) ;
				case 5: SetPVarInt ( playerid, "logs_type", TYPE_LOG_OBWYAK + 1 ) ;
	        }

			getMembersLogs ( playerid, GetPVarInt ( playerid, "logs_type" ) - 1, 0, 1 ) ;
	        return 1 ;
	    }
	    case d_fractions_lognext:
		{
			if ( ! response )
			{
			    clear_player_listitem_values ( playerid ) ;
			    if ( page_count [ playerid ] == 1 )
				{
					page_count [ playerid ] = 0 ;
					page_rows [ playerid ] = 0 ;
					DeletePVar ( playerid, "logs_type" ) ;
				}
				ShowLeaderMenu ( playerid ) ;
				return 1 ;
			}

			if ( GetString ( inputtext, "Предыдущая страница" ) ) getMembersLogs ( playerid, GetPVarInt ( playerid, "logs_type" ) - 1, page_count [ playerid ] - 1, 1 ) ;
			else if ( GetString ( inputtext, "Следующая страница" ) ) getMembersLogs ( playerid, GetPVarInt ( playerid, "logs_type" ) - 1, page_count [ playerid ] + 1, 1 ) ;
			return 1 ;
		}
	    case d_offmembers_lognext:
		{
			if ( ! response )
			{
			    clear_player_listitem_values ( playerid ) ;
			    if ( page_count [ playerid ] == 1 )
				{
					page_count [ playerid ] = 0 ;
					page_rows [ playerid ] = 0 ;
				}
				return 1 ;
			}

			new pvar_string [ 38 ],
				pl_name [ MAX_PLAYER_NAME ] ;
			format ( pvar_string, sizeof ( pvar_string ), "ofm_%d", GetPVarInt ( playerid, "ofm_listitem" ) ) ;
			GetPVarString ( playerid, pvar_string, pl_name, MAX_PLAYER_NAME ) ;

            if ( GetString ( inputtext, "Предыдущая страница" ) ) getMembersPlayerLogs ( playerid, pl_name, page_count [ playerid ] - 1, 1 ) ;
			else if ( GetString ( inputtext, "Следующая страница" ) ) getMembersPlayerLogs ( playerid, pl_name, page_count [ playerid ] + 1, 1 ) ;
			return 1 ;
		}
	    case d_wanted:
		{
			if ( ! response )
			{
			    if ( page_count [ playerid ] == 1 )
				{
				    page_count [ playerid ] = 0 ;
				    page_rows [ playerid ] = 0 ;
					return 1;
				}
                page_count [ playerid ] -= 1 ;

				new line_string [ 50 + MAX_PLAYER_NAME ],
					wanted_count ;

				global_string [ 0 ] = EOS ;
				strcat ( global_string, "{"#cLY"}Внимание, розыск:\n\n") ;

				foreach(new i: logged_players)
				{
					if ( p_info [ i ] [ wanted ] > 0 )
					{
					    if ( wanted_count > page_count [ playerid ] * 20 ) break ;
						if ( wanted_count < ( page_count [ playerid ] * 20 ) - 20 )
						{
							wanted_count ++ ;
							continue ;
						}
						wanted_count ++ ;

						format ( line_string, sizeof ( line_string ), "{ffffff}%d. %s[%d] - {"#cLY"}%d уровень розыска\n", wanted_count + 1, p_info [ i ] [ name ], i, p_info [ i ] [ wanted ] ) ;
						strcat ( global_string, line_string) ;
					}
				}
				show_dialog ( playerid, d_wanted, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Список разыскиваемых", global_string, "Вперед", "Назад" ) ;
				return 1 ;
			}

			if ( page_count [ playerid ] * 20 >= page_rows [ playerid ] )
           	{
				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы находитесь на последней странице списка розыскиваемых." ) ;
				callcmd::wanted ( playerid ) ;
				return 1;
			}
            page_count [ playerid ] += 1 ;

            new line_string [ 50 + MAX_PLAYER_NAME ],
				wanted_count ;

			global_string [ 0 ] = EOS ;
			strcat ( global_string, "{"#cLY"}Внимание, розыск:\n\n") ;

			foreach(new i: logged_players)
			{
				if ( p_info [ i ] [ wanted ] > 0 )
				{
				    if ( wanted_count > page_count [ playerid ] * 20 ) break ;
					if ( wanted_count < ( page_count [ playerid ] * 20 ) - 20 )
					{
						wanted_count ++ ;
						continue ;
					}
					wanted_count ++ ;

					format ( line_string, sizeof ( line_string ), "{ffffff}%d. %s[%d] - {"#cLY"}%d уровень розыска\n", wanted_count + 1, p_info [ i ] [ name ], i, p_info [ i ] [ wanted ] ) ;
					strcat ( global_string, line_string) ;
				}
			}
			show_dialog ( playerid, d_wanted, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Список разыскиваемых", global_string, "Вперед", "Назад" ) ;
			return 1 ;
		}
		case d_remove_millage:
		{
		    if ( ! response )
			{
				showTuneDialog ( playerid ) ;
				return 1 ;
			}

		    new _value = strval ( inputtext ), _v_id = GetPlayerVehicleID ( playerid ) ;

		    new Float: _v_millage = floatround ( veh_info [ _v_id - 1 ] [ v_millage ] * 25 ) / 100 ;
		    if ( _v_millage > 1000 ) _v_millage = 1000.0 ;

            if ( _v_millage > veh_info [ _v_id - 1 ] [ v_legal_millage ] || veh_info [ _v_id - 1 ] [ v_legal_millage ] > 1000 )
            {
			    veh_info [ _v_id - 1 ] [ v_legal_millage ] = _v_millage ;

			    new query_string [ 83 + ( 9 * 2 ) ] ;
				format ( query_string, sizeof ( query_string ), "UPDATE `users_vehicles` SET `v_legal_millage` = '%.2f' WHERE `v_id` = '%d' LIMIT 1",
				_v_millage,
				veh_info [ _v_id - 1 ] [ v_id ] ) ;
				mysql_tquery ( sql_connection, query_string ) ;
			}
			else _v_millage = veh_info [ _v_id - 1 ] [ v_legal_millage ] ;

		    if ( _value < 1 || _value > veh_info [ _v_id - 1 ] [ v_millage ] - _v_millage )
		    {
		        SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Не верно указано количество пробега для скрутки." ) ;
		        show_remove_millage ( playerid ) ;
		        return 1 ;
		    }

		    if ( p_info [ playerid ] [ money ] < engine_remove_millage * _value )
		    {
		        SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас недостаточно средств." ) ;
		        show_remove_millage ( playerid ) ;
		        return 1 ;
		    }

		    new Float: _value_millage = _value ;
		    veh_info [ _v_id - 1 ] [ v_millage ] -= _value_millage ;

		    new _price = engine_remove_millage * _value ;
		    give_money ( playerid, -_price ) ;
			insert_money_log ( playerid, INVALID_PLAYER_ID, -_price, "Скрутка пробега" ) ;

			SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы успешно скрутили пробег. Скорость Вашего т/с восстановлена." ) ;
		    showTuneDialog ( playerid ) ;
			return 1 ;
		}
	    case d_recorder:
	    {
	        if ( ! response ) return DeletePVar ( playerid, "car_audio" ) ;
	        if ( listitem == 0 )
	        {
         		show_dialog(playerid, d_recorder_radio, DIALOG_STYLE_LIST, "{"#cBHD"}Выберите радиостанцию", "{"#cBL"}1. {"#cWH"}Europa Plus\n{"#cBL"}2. {"#cWH"}Радио Рекорд", "Выбор", "Выход");
	        }
	        else if ( listitem == 1 )
	        {
	            if ( p_t_info [ playerid ] [ car_audio ] )
	            {
	                foreach(new i: streamed_players[playerid])
					{
						if ( GetPlayerVehicleID ( playerid ) == GetPlayerVehicleID ( i ) )
						{
						    StopAudioStreamForPlayer ( i ) ;
						    SendClientMessage ( i, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Аудио-система в транспорте отключена." ) ;
						}
					}
					StopAudioStreamForPlayer ( playerid ) ;
					DeletePVar ( playerid, "BBStation" ) ;
					return 1 ;
	            }

	            StopAudioStreamForPlayer ( playerid ) ;
	            if ( IsPlayerAttachedObjectSlotUsed ( playerid, 1 ) ) RemovePlayerAttachedObject ( playerid, 1 ) ;
	        }
	        return 1 ;
	    }
	    case d_recorder_radio:
	    {
	        if ( ! response )
	        {
	            if ( boombox_player [ playerid ] [ b_status ] ) show_dialog(playerid, d_recorder, DIALOG_STYLE_LIST, "{"#cBHD"}Магнитофон", "1. Музыка\n2. Радио", "Выбор", "Выход") ;
				if ( GetPVarInt ( playerid, "car_audio" ) ) callcmd::car_play ( playerid ) ;
				else callcmd::play ( playerid ) ;
				return 1 ;
	        }
	        static const Radio_List [ 2 ] [ 50 ] =
			{
				"http://eptop128.streamr.ru",
				"https://www.radiorecord.fm/m3u/rr320-28kbps.m3u"
			};

			if ( boombox_player [ playerid ] [ b_status ] )
			{
				foreach(new i: streamed_players[playerid])
				{
					if ( IsPlayerInDynamicArea ( i, boombox_player [ playerid ] [ b_area ] ) )
					{
					    StopStream ( i ) ;
						PlayStream(i, Radio_List[listitem], boombox_player [ playerid ] [ b_pos ] [ 0 ],
															boombox_player [ playerid ] [ b_pos ] [ 1 ],
															boombox_player [ playerid ] [ b_pos ] [ 2 ], 30.0, 1);
					}
				}
				StopStream ( playerid ) ;
				PlayStream(playerid, Radio_List[listitem], boombox_player [ playerid ] [ b_pos ] [ 0 ],
															boombox_player [ playerid ] [ b_pos ] [ 1 ],
															boombox_player [ playerid ] [ b_pos ] [ 2 ], 30.0, 1);

				SetPVarString(playerid, "BBStation", Radio_List[listitem]);
				return 1 ;
			}
			if ( GetPVarInt ( playerid, "car_audio" ) )
			{
			    p_t_info [ playerid ] [ car_audio ] = false ;
				foreach(new i: streamed_players[playerid])
				{
					if ( GetPlayerVehicleID ( playerid ) == GetPlayerVehicleID ( i ) )
					{
					    if ( IsPlayerAttachedObjectSlotUsed ( i, 1 ) ) RemovePlayerAttachedObject ( i, 1 ), StopAudioStreamForPlayer ( i ) ;
					    PlayAudioStreamForPlayer(i, Radio_List[listitem]);
					    SendClientMessage ( i, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Аудио-система в транспорте включена." ) ;
					}
				}
				if ( IsPlayerAttachedObjectSlotUsed ( playerid, 1 ) ) RemovePlayerAttachedObject ( playerid, 1 ), StopAudioStreamForPlayer ( playerid ) ;
			    PlayAudioStreamForPlayer(playerid, Radio_List[listitem]);
			    SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Аудио-система в транспорте включена." ) ;

				SetPVarString(playerid, "BBStation", Radio_List[listitem]);
				DeletePVar ( playerid, "car_audio" ) ;
				return 1 ;
			}
			else
			{
			    if ( IsPlayerAttachedObjectSlotUsed ( playerid, 1 ) ) RemovePlayerAttachedObject ( playerid, 1 ), StopAudioStreamForPlayer ( playerid ) ;
			    SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы включили онлайн-радио." ) ;
				PlayAudioStreamForPlayer(playerid, Radio_List[listitem]);
				SetAttachToPlay ( playerid ) ;
			}
	        return 1 ;
	    }
	    case d_trunkmenu:
	    {
	        if ( ! response )
	        {
	            new engine, lights, alarm, doors, bonnet, boot, objective ;
				GetVehicleParamsEx ( idaofcar [ playerid ], engine, lights, alarm, doors, bonnet, boot, objective ) ;
		    	SetVehicleParamsEx ( idaofcar [ playerid ], engine, lights, alarm, doors, bonnet, VEHICLE_PARAMS_OFF, objective ) ;
	        	idaofcar [ playerid ] = INVALID_VEHICLE_ID ;
				return 1 ;
	        }
			switch ( listitem )
			{
			    case 0:
			    {
                    new _trunk_vehicle = idaofcar [ playerid ] ;
			    	if ( _trunk_vehicle < 1 || _trunk_vehicle > MAX_VEHICLES ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Произошла ошибка. Откройте багажник ещё раз." ) ;
					if ( veh_info [ _trunk_vehicle - 1 ] [ v_trunk_open ] == false ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Багажник закрыт." ) ;

			    	if ( p_info [ playerid ] [ hour_played ] < FIVE_HOUR_PLAYED ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Доступно с 5 часов в игре. Используйте /mm - Информация о персонаже - Статистика персонажа." ) ;

					#if defined m_inventory_module
						used_inventory [ playerid ] = true ;
						toggle_controlable ( playerid, false ) ;

						SetInventoryItem ( playerid ) ;
						setInventoryLayout ( playerid, 1 ) ;
						set_inventory_button ( playerid, SUB_INV_VEHICLE ) ;
						setInventoryWarehouse ( playerid, SUB_INV_VEHICLE, _trunk_vehicle ) ;
						setWarehouseInfo (
							playerid,
							"Багажник",
							"Здесь хранятся предметы, которые\nв автомобиле",
							"ВАШ ТРАНСПОРТ",
							"ГОС. НОМЕРА",
							GetVehicleNameEx ( _trunk_vehicle ),
							plate_number1 ( veh_info [ _trunk_vehicle - 1 ] [ v_plate_type ], veh_info [ _trunk_vehicle - 1 ] [ v_plate ], veh_info [ _trunk_vehicle - 1 ] [ v_region ] )
						) ;
					#endif
			    }
			    case 1:
			    {
                    new _trunk_vehicle = idaofcar [ playerid ] ;
					if ( _trunk_vehicle == INVALID_VEHICLE_ID ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Произошла ошибка. Откройте багажник ещё раз." ) ;

					show_bagage ( playerid ) ;
			        if ( veh_info [ _trunk_vehicle - 1 ] [ v_owner ] == p_info [ playerid ] [ id ] || veh_info [ _trunk_vehicle - 1 ] [ v_owner ] == p_info [ playerid ] [ member ] ||
						veh_info [ _trunk_vehicle - 1 ] [ v_owner ] == p_info [ playerid ] [ family ] || _trunk_vehicle == player_rentcar [ playerid ] )
			        {
			            veh_info [ _trunk_vehicle - 1 ] [ v_trunk_open ] = ( veh_info [ _trunk_vehicle - 1 ] [ v_trunk_open ] != true ) ? (true) : (false);
			            if ( veh_info [ _trunk_vehicle - 1 ] [ v_trunk_open ] == true ) SendClientMessage ( playerid, col_gray, !"{"#cGInfo"}* {"#cGRInfo"}Вы открыли багажник для игроков." ) ;
						else SendClientMessage ( playerid, col_gray, !"{"#cGInfo"}* {"#cGRInfo"}Вы закрыли багажник для игроков." ) ;
			        }
			    }
			}
	        return 1 ;
	    }
		case d_money_logback:
		{
		    if ( ! response ) return 1 ;

            new log_name [ MAX_PLAYER_NAME ] ;
			GetPVarString(playerid, "log_name", log_name, sizeof(log_name));

  			new sql_string [ 127 + MAX_PLAYER_NAME ] ;
			mysql_format ( sql_connection, sql_string, sizeof sql_string, "SELECT `log_id`, `money`, `name`, `date`, `reason` FROM `money_logs` WHERE `name` = '%s' ORDER BY `money_logs`.`log_id` DESC", log_name ) ;
			mysql_tquery ( sql_connection, sql_string, "cmd_moneylog_callback", "i", playerid ) ;
	        return 1 ;
		}
	    case d_fraction_logback:
		{
		    if ( ! response )
		    {
		        ShowLeaderMenu ( playerid ) ;
		        return 1 ;
		    }

  			new sql_string [ 135 + 9 ] ;
			format ( sql_string, sizeof sql_string, "SELECT `id`, `name`, `date`, `type` FROM `logs_fractions` WHERE `fraction` = '%d' ORDER BY `logs_fractions`.`id` DESC LIMIT 200", p_info [ playerid ] [ member ] ) ;
			mysql_tquery ( sql_connection, sql_string, "logs_fraction", "i", playerid ) ;
	        return 1 ;
		}
		case d_logback:
		{
		    if ( ! response )
		    {
		        DeletePVar ( playerid, "logs_type" ) ;
				DeletePVar ( playerid, "logs_member" ) ;

		        callcmd::logs ( playerid ) ;
		        return 1 ;
		    }

			if ( GetPVarInt ( playerid, "logs_member" ) )
			{
				new sql_string [ 129 + 4 + 9 ] ;
				format ( sql_string, sizeof sql_string, "SELECT `id`, `name`, `date`, `type` FROM `logs_all` WHERE `type` = '%d' AND `member` = '%d' ORDER BY `logs_all`.`id` DESC", GetPVarInt ( playerid, "logs_type" ) - 1, GetPVarInt ( playerid, "logs_member" ) ) ;
				mysql_tquery(sql_connection, sql_string, "GetLogs", "i", playerid);
			}
			else
			{
			    new sql_string [ 129 + 4 ] ;
				format ( sql_string, sizeof sql_string, "SELECT `id`, `name`, `date`, `type` FROM `logs_all` WHERE `type` = '%d' ORDER BY `logs_all`.`id` DESC", GetPVarInt ( playerid, "logs_type" ) - 1 ) ;
				mysql_tquery(sql_connection, sql_string, "GetLogs", "i", playerid);
			}
	        return 1 ;
		}
		case d_logback_message:
		{
		    if ( ! response )
		    {
		        callcmd::logs ( playerid ) ;
		        return 1 ;
		    }

			mysql_tquery ( sql_connection, "SELECT `r_id`, `u_name`, `Text`, `a_name`, `A_Text`, `r_status` FROM `logs_report` ORDER BY `logs_report`.`r_id` DESC", "GetLogsReport", "i", playerid ) ;
	        return 1 ;
