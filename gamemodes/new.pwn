	}
	return 1 ;
}

CMD:number ( playerid, params [ ] )
{
	if ( sscanf ( params, "d", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /number [id игрока / номер]" ) ;

 	foreach(new i: logged_players)
	{
		if ( i == params [ 0 ] || p_info [ i ] [ number ] == params [ 0 ] )
		{
			new scm_string [ 128 ] ;
			format ( scm_string, sizeof ( scm_string ), "{"#cGInfo"}* {"#cWH"}Номер игрока {"#cGN"}%s[%d]{"#cWH"}: {"#cGN"}%i", p_info [ i ] [ name ], i, p_info [ i ] [ number ] ) ;
			SendClientMessage ( playerid, col_white, scm_string ) ;
			return 1 ;
		}
	}
	SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Владельца данного номера нет в игре." ) ;
	return 1 ;
}

alias:joblist("ganglist")
CMD:joblist ( playerid, params [ ] )
{
 	if ( sscanf ( params, "u", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /joblist [id/имя]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;

	if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;
    if ( ! bad_dialog ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Недоступно в данный момент." ) ;
	if ( cooldown_sentence [ playerid ] > gettime ( ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Предложение о сделке можно отправлять один раз в {"#cRD"}45 секунд{"#cGRInfo"}." ) ;

	cooldown_sentence [ playerid ] = gettime ( ) + time_sell_sentence ;

	set_player_use_listitem ( params [ 0 ], playerid ) ;

	new scm_string [ 89 + MAX_PLAYER_NAME ] ;
	format ( scm_string, sizeof scm_string, "{"#cGInfo"}* {"#cWH"}Вы предложили {"#cGN"}%s{"#cWH"} посмотреть Вашу трудовую книжку.", p_info [ params [ 0 ] ] [ name ] ) ;
	SendClientMessage ( playerid, col_white, scm_string ) ;

	if ( ! p_info [ playerid ] [ member ] )
	{
		showPlayerOrgList ( params [ 0 ] ) ;
	}
	else
	{
		global_string [ 0 ] = EOS ;

		new rank_data [ 32 ], fraction_data [ 32 ] ;
		if ( p_info [ playerid ] [ rank ] && p_info [ playerid ] [ member ] )
		{
		    format ( fraction_data, sizeof ( fraction_data ), "%s", f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_name ] ) ;
			format ( rank_data, sizeof ( rank_data ), "%s", f_rank [ p_info [ playerid ] [ member ] - 1 ] [ p_info [ playerid ] [ rank ] - 1 ] ) ;
		}
		else format ( fraction_data, sizeof ( fraction_data ), "отсутствует" ), format ( rank_data, sizeof ( rank_data ), "отсутствует" ) ;

		format ( global_string, 256, "\
			{"#cBL"}** Трудовая книжка ** \n\n\
			{"#cWH"}Имя Фамилия: {"#cOR"}%s\n\
			{"#cWH"}Организация: {"#cOR"}%s\n\
			{"#cWH"}Работа / Должность: {"#cOR"}%s",
			p_info [ playerid ] [ name ], fraction_data, rank_data ) ;

		show_dialog ( params [ 0 ], d_joblist, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Трудовая книжка", global_string, "История", "Закрыть" ) ;
	}
	return 1 ;
}

stock showPlayerOrgList ( playerid )
{
	static const org_structure [ 7 ] [ 22 ] =
	{
	    "Правительство",
		"МВД",
		"Мин. Обороны",
		"Мин. Здравохранения",
		"ТВ и Радио",
		"Банды",
		"Мафии"
	} ;

	global_string [ 0 ] = EOS ;
	new query [ 80 ] ;
	for ( new i = 0 ; i < sizeof org_structure ; i ++ )
	{
		format ( query, sizeof query, "{"#cBL"}%d. {"#cWH"}%s\n", i + 1, org_structure [ i ] ) ;
		strcat ( global_string, query ) ;
	}

	show_dialog ( playerid, d_laborlist, DIALOG_STYLE_LIST, "{"#cBHD"}Трудовая книжка", global_string, "История", "Закрыть" ) ;
	return 1 ;
}

callback: joblist_callback ( playerid, targetid, structure_id )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;

	if ( ! rows )
	    return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Не удалось обнаружить ни одной записи в трудовой книжке." ) ;

	static const org_structure [ 7 ] [ 22 ] =
	{
	    "Правительство",
		"МВД",
		"Мин. Обороны",
		"Мин. Здравохранения",
		"ТВ и Радио",
		"Банды",
		"Мафии"
	} ;

	if ( rows )
	{
	    global_string [ 0 ] = EOS ;
		new line_string [ 128 ], ji_date [ 16 ], ji_reason [ 32 ], ji_fraction, ji_rank, ji_type ;
 		format ( global_string, sizeof global_string, "{FFFFFF}История работы {99cc00}%s {FFFFFF}в {99cc00}%s\n\n", p_info [ targetid ] [ name ], org_structure [ structure_id ] ) ;

		for ( new i = 0 ; i < rows ; i ++ )
		{
			ji_fraction = cache_get_field_content_int ( i, "ji_fraction", sql_connection ) ;
			ji_rank = cache_get_field_content_int ( i, "ji_rank", sql_connection ) ;
			ji_type = cache_get_field_content_int ( i, "ji_type", sql_connection ) ;

			cache_get_field_content ( i, "ji_date", ji_date, sql_connection, 16 ) ;
			cache_get_field_content ( i, "ji_reason", ji_reason, sql_connection, 32 ) ;

	        switch ( ji_type )
	        {
	        	case LABOR_TYPE_INVITE:
	        	{
	        		format ( line_string, sizeof line_string, "{FFFFFF}%s - +Был назначен на должность %s (%s)\n", ji_date, f_rank [ ji_fraction - 1 ] [ ji_rank - 1 ], f_info [ ji_fraction - 1 ] [ f_name ] ) ;
	        	}
	        	case LABOR_TYPE_UNINVITE:
	        	{
	        		format ( line_string, sizeof line_string, "{FFFFFF}%s - -Был уволен с должности %s по причине: %s (%s)\n", ji_date, f_rank [ ji_fraction - 1 ] [ ji_rank - 1 ], ji_reason, f_info [ ji_fraction - 1 ] [ f_name ] ) ;
	        	}
	        	case LABOR_TYPE_UNINVITE_LEAVE:
	        	{
	        		format ( line_string, sizeof line_string, "{FFFFFF}%s - -Покинул должность %s по собственному желанию (%s)\n", ji_date, f_rank [ ji_fraction - 1 ] [ ji_rank - 1 ], f_info [ ji_fraction - 1 ] [ f_name ] ) ;
	        	}
	        	case LABOR_TYPE_NEXT_RANG:
	        	{
	        		format ( line_string, sizeof line_string, "{FFFFFF}%s - +Повышен до должности %s (%s)\n", ji_date, f_rank [ ji_fraction - 1 ] [ ji_rank - 1 ], f_info [ ji_fraction - 1 ] [ f_name ] ) ;
	        	}
	        	case LABOR_TYPE_BACK_RANG:
	        	{
	        		format ( line_string, sizeof line_string, "{FFFFFF}%s - -Понижен до должности %s (%s)\n", ji_date, f_rank [ ji_fraction - 1 ] [ ji_rank - 1 ], f_info [ ji_fraction - 1 ] [ f_name ] ) ;
	        	}
	        	case LABOR_TYPE_TICKET:
	        	{
	        		format ( line_string, sizeof line_string, "{FFFFFF}%s - -Получил выговор по причине: %s (%s)\n", ji_date, ji_reason, f_info [ ji_fraction - 1 ] [ f_name ] ) ;
	        	}
	        }

	        strcat ( global_string, line_string ) ;
		}

		show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Информация", global_string, "Закрыть", "Назад" ) ;

		new scm_string [ 71 + MAX_PLAYER_NAME ] ;
		format ( scm_string, sizeof scm_string, "{"#cGInfo"}* {"#cWH"}Вы показали {"#cGN"}%s{"#cWH"} трудовую книжку.", p_info [ playerid ] [ name ] ) ;
		SendClientMessage ( targetid, col_white, scm_string ) ;
	}
	return 1 ;
}

stock insert_joblist ( playerid, ji_reason [ ], ji_type, ji_rank = 0 )
{
	if ( ! ji_rank ) ji_rank = p_info [ playerid ] [ rank ] ;

	new sql_string [ 256 ] ;
	format ( sql_string, sizeof sql_string, "INSERT INTO `users_jobinfo` (`ji_uid`,`ji_date`,`ji_reason`,`ji_fraction`,`ji_type`,`ji_rank`) VALUES ('%d', NOW(), '%s', '%d', '%d', '%d')",
	p_info [ playerid ] [ id ], ji_reason, p_info [ playerid ] [ member ], ji_type, ji_rank ) ;
	mysql_tquery ( sql_connection, sql_string, "", "" ) ;
	return 1 ;
}

callback: callback_jobinfo_uninvite ( ji_reason [ ], ji_fraction, ji_type )
{
    new rows, fields ;
	cache_get_data ( rows, fields ) ;

	if ( rows )
	{
    	new u_id, u_rank, sql_string [ 256 ] ;
	    u_id = cache_get_field_content_int ( 0, "u_id", sql_connection ) ;
	    u_rank = cache_get_field_content_int ( 0, "u_rank", sql_connection ) ;

		format ( sql_string, sizeof sql_string, "INSERT INTO `users_jobinfo` (`ji_uid`,`ji_date`,`ji_reason`,`ji_fraction`,`ji_type`,`ji_rank`) VALUES ('%d', NOW(), '%s', '%d', '%d', '%d')",
		u_id, ji_reason, ji_fraction, ji_type, u_rank ) ;
		mysql_tquery ( sql_connection, sql_string, "", "" ) ;
	}
	return 1 ;
}

CMD:help ( playerid )
{
	SendClientMessage ( playerid, col_gray, !"* Также рекомендуем Вам ознакомиться с /gps там Вы найдёте много интересных и полезных мест." ) ;
	show_dialog ( playerid, d_help, DIALOG_STYLE_LIST, "{"#cBHD"}Помощь по игре", "{"#cBL"}1. {"#cWH"}Интерфейс / Худ\n{"#cBL"}2. {"#cWH"}Работа\n{"#cBL"}3. {"#cWH"}Транспорт\n{"#cBL"}4. {"#cWH"}Ограбление банка\n{"#cBL"}5. {"#cWH"}Клады\n{"#cBL"}6. {"#cWH"}Семьи\n{"#cBL"}7. {"#cWH"}Альянс\n{"#cBL"}8. {"#cWH"}Тренировочный комплекс\n{"#cBL"}9. {"#cWH"}Банковская система\n{"#cBL"}10. {"#cWH"}Недвижимость\n{"#cBL"}11. {"#cWH"}Организации\n{"#cBL"}12. {"#cWH"}Бонусы\n{"#cBL"}13. {"#cWH"}Битва за контейнеры\n{"#cBL"}14. {"#cWH"}Донат счёт\n{"#cBL"}15. {"#cWH"}Обмен / трейд\n{"#cBL"}16. {"#cWH"}Исправительная колония\n{"#cBL"}17. {"#cWH"}Свалка\n{"#cBL"}18. {"#cWH"}Крафт", "Выбрать", "Закрыть" ) ;
	return 1 ;
}

CMD:debtors ( playerid )
{
	if ( ! gov_player ( playerid ) && ! mayor_player ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Команда доступна только для сотрудников правительства." ) ;
	if ( p_info [ playerid ] [ member ] == 11 && p_info [ playerid ] [ rank ] < 9 || mayor_player ( playerid ) && p_info [ playerid ] [ rank ] < 5 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вам недоступна данная функция." ) ;

	getDebtorsInfo ( playerid, 0, 1 ) ;
	return 1 ;
}

callback: debtors_check_tax ( playerid, _typing )
{
    new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( rows )
	{
		if ( _typing == 1 )
		{
			/*new taxUser, dbMoney ;
			for ( new i = 0 ; i < rows ; i ++ )
			{
				new taxUser = cache_get_field_content_int ( 0, "u_tax" ) ;
				new dbMoney = cache_get_field_content_int ( 0, "db_money" ) ;

				if ( dbMoney >= taxUser )
				{
					SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока достаточно средств на банковских счетах, чтоб погасить долг." ) ;

					new pvar_string [ 38 ],
						pl_name [ MAX_PLAYER_NAME ] ;

					format ( pvar_string, sizeof ( pvar_string ), "ofm_%d", GetPVarInt ( playerid, "ofm_listitem" ) ) ;
					GetPVarString ( playerid, pvar_string, pl_name, MAX_PLAYER_NAME ) ;

					show_debtors ( playerid, pl_name ) ;
					return 1 ;
				}
			}*/
			new _tax_user = cache_get_field_content_int ( 0, "u_tax", sql_connection ) ;

			new query_string [ 84 + 9 + 4 ] ;
			format ( query_string, sizeof query_string, "SELECT `db_money`,`db_type` FROM `deposit_boxes` WHERE `db_owner` = '%d' LIMIT %d", GetPVarInt ( playerid, "debt_uid" ), MAX_BANK_ACCOUNT ) ;
			mysql_tquery ( sql_connection, query_string, "callback_payment_deposit_boxes", "iiii", playerid, GetPVarInt ( playerid, "debt_uid" ), 1, _tax_user ) ;
		}
		else if ( _typing == 2 )
		{
			new _tax_user = cache_get_field_content_int ( 0, "u_tax", sql_connection ) ;

			new query_string [ 92 + 9 + 4 ] ;
	    	format ( query_string, sizeof query_string, "SELECT `db_id`,`db_money`,`db_type` FROM `deposit_boxes` WHERE `db_owner` = '%d' LIMIT %d", GetPVarInt ( playerid, "debt_uid" ), MAX_BANK_ACCOUNT ) ;
			mysql_tquery ( sql_connection, query_string, "callback_payment_deposit_boxes", "iiii", playerid, GetPVarInt ( playerid, "debt_uid" ), 2, _tax_user ) ;
		}
	}
	else
	{
	    getDebtorsInfo ( playerid, page_count [ playerid ], 1 ) ;
		DeletePVar ( playerid, "debt_uid" ) ;
	}
	return 1 ;
}

stock show_debtors ( playerid, player_name [ ] )
{
	new pvar_string [ 48 ] ;
	format ( pvar_string, sizeof pvar_string, "{"#cBHD"}%s", player_name ) ;
    show_dialog ( playerid, d_debtors_pl_menu, DIALOG_STYLE_LIST, pvar_string, "{"#cBL"}1. {"#cWH"}Информация об имуществе\n{"#cBL"}2. {"#cWH"}Продать имущество\n{"#cBL"}3. {"#cWH"}Информация о транспорте\n{"#cBL"}4. {"#cWH"}Списать деньги с банковского счета\n{"#cBL"}5. {"#cWH"}Выслать извещение", "Выбрать", "Назад" ) ;
    return 1 ;
}

alias:spawnchange("setspawn", "spaw")
CMD:spawnchange ( playerid, params [ ] )
{
	global_string [ 0 ] = EOS ;
	new spawn_text [ 24 ] ;
	switch ( p_info [ playerid ] [ spawnchange ] )
	{
	    case 0: spawn_text = "На вокзале" ;
	    case 1: spawn_text = "В собственном доме" ;
	    case 2: spawn_text = "На базе организации" ;
	    case 3: spawn_text = "В личной яхте" ;
	    case 4: spawn_text = "Личный гараж" ;
	    case 5: spawn_text = "В арендованом доме" ;
	    case 6: spawn_text = "В отеле" ;
	    case 7: spawn_text = "В семейном доме" ;
	}
	format ( global_string, 700, "{"#cGRDialog"}- {"#cWH"}Текущее место появления: {"#cGN"}%s\n{"#cBL"}1.{"#cWH"} На вокзале\n{"#cBL"}2.{"#cWH"} В собственном доме\n{"#cBL"}3.{"#cWH"} На базе организации\n{"#cBL"}4.{"#cWH"} В личной яхте\n{"#cBL"}5.{"#cWH"} Личный гараж\n{"#cBL"}6.{"#cWH"} В арендованом доме\n{"#cBL"}7.{"#cWH"} В отеле\n{"#cBL"}8.{"#cWH"} В семейном доме", spawn_text ) ;
	show_dialog ( playerid, d_spawnchange, DIALOG_STYLE_LIST, "{"#cBHD"}Изменение места появления в игре", global_string, "Выбрать", "Закрыть" ) ;
	return 1 ;
}

