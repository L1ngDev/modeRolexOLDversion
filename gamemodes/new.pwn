	if ( is_leave_exam_vehicle { playerid } > 0 )
	{
		new t_string [ 6 ] ;
		format ( t_string, 6, "~r~%d", is_leave_exam_vehicle { playerid } ) ;
		GameTextForPlayer ( playerid, t_string, 5000, 6 ) ;
		if ( is_leave_exam_vehicle { playerid } == 1 )
		{
			SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не успели вовремя вернуться в транспорт, экзамен провален." ) ;
			GameTextForPlayer ( playerid, "~r~FAILED", 5000, 6 ) ;

			if ( exam_vehicle [ playerid ] != INVALID_VEHICLE_ID )
			{
				new vehicle_id = exam_vehicle [ playerid ] ;
				switch ( GetVehicleModel ( vehicle_id ) )
				{
					case vehicle_exam_fly: set_pos ( playerid, exam_player_pos [ 0 ], exam_player_pos [ 1 ], exam_player_pos [ 2 ], exam_player_pos [ 3 ], int_exam_fly, virt_exam_fly ) ;
					case vehicle_exam_boat: set_pos ( playerid, exam_player_pos [ 0 ], exam_player_pos [ 1 ], exam_player_pos [ 2 ], exam_player_pos [ 3 ], int_exam_boat, virt_exam_boat ) ;
					case vehicle_exam_drive: set_pos ( playerid, exam_player_pos [ 0 ], exam_player_pos [ 1 ], exam_player_pos [ 2 ], exam_player_pos [ 3 ], int_exam_drive, virt_exam_drive ) ;
				}

				if ( veh_info [ vehicle_id - 1 ] [ v_model ] != vehicle_exam_drive ) DestroyVehicle ( vehicle_id, 6 ) ;
				else SetVehicleToRespawn ( vehicle_id, 1 ) ;

				exam_vehicle [ playerid ] = INVALID_VEHICLE_ID ;
			}

			exam_start [ playerid ] = false ;
			DisablePlayerRaceCheckpoint ( playerid ) ;
			is_leave_exam_vehicle { playerid } = 0 ;
		}
		else is_leave_exam_vehicle { playerid } -- ;
	}

	if ( is_leave_quest_vehicle { playerid } > 0 )
	{
		new t_string [ 6 ] ;
