	if ( params [ 1 ] < 1 || params [ 1 ] > 500 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Количество передаваемых патрон должно быть от {"#cRD"}1 {"#cGRInfo"}до {"#cRD"}500{"#cGRInfo"}." ) ;
	if ( GetInventoryFindItem ( playerid, SUB_INVENTORY, 2154 ) < params [ 1 ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет столько патрон." ) ;
	if ( ( GetInventoryFindItem ( params [ 0 ], SUB_INVENTORY, 2154 ) + params [ 1 ] > 500 && ! p_info [ params [ 0 ] ] [ enhancement ] [ 0 ] ) || GetInventoryFindItem ( params [ 0 ], SUB_INVENTORY, 2154 ) + params [ 1 ] > 1000 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока уже достаточно патрон." ) ;

	clear_inventory ( playerid, 2154, params [ 1 ] ) ;
