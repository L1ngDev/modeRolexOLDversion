callback: callback_last_contacts ( )
{
    new fields,
		rows,
		time = GetTickCount ( ) ;

	cache_get_data ( rows, fields ) ;

    if ( rows ) contacts_inc_id = cache_get_field_content_int ( 0, "inc_id", sql_connection ) ;
