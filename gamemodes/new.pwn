	static const _str [ ] = "DELETE FROM `users_skins_stats` WHERE `id` = '%d' LIMIT 1" ;
	new query_string [ sizeof _str + 9 ] ;
	format ( query_string, sizeof query_string, _str, skinId ) ;
	mysql_tquery( sql_connection, query_string ) ;
	return true ;
}

CMD:pbinfo ( playerid )
{
	global_string [ 0 ] = EOS ;
	global_string = "{"#cBL"}Ник:\t{"#cBL"}Урон:\t{"#cBL"}Убийств:\t{"#cBL"}Смертей:{"#cWH"}\n";
	for ( new i = 0 ; i < 15 ; i ++ )
	{
	    new _place = paint_place [ i ] ;
	    format ( global_string, sizeof ( global_string ), "%s%d) %s\t%d\t%d\t%d\n", global_string, i + 1,
		PaintList [ _place ] [ Killername ], PaintList [ _place ] [ DamagePoint ],
		PaintList [ _place ] [ KillsPoint ], PaintList [ _place ] [ DeathsPoint ] ) ;
	}
	show_dialog ( playerid, d_none, DIALOG_STYLE_TABLIST_HEADERS, "{"#cBHD"}Итоги пейнтболла", global_string, "Закрыть", "" ) ;

	return 1 ;
}

callback: callback_payment_deposit_boxes ( playerid, account_id, type_payment, payment_sum )
{
    new fields,
		rows ;

	cache_get_data ( rows, fields ) ;
	if ( rows )
	{
	    if ( type_payment == 1 )
	    {
			for ( new i = 0 ; i < rows ; i++ )
			{
				new bank_money = cache_get_field_content_int ( i, "db_money", sql_connection ) ;
				new bank_card_type = cache_get_field_content_int ( i, "db_type", sql_connection ) ;

				if ( bank_card_type == 3 ) continue ;

				if ( bank_money >= payment_sum )
				{
				    SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока достаточно средств на банковских счетах, чтоб погасить долг." ) ;

					new pvar_string [ 38 ],
						pl_name [ MAX_PLAYER_NAME ] ;

					format ( pvar_string, sizeof ( pvar_string ), "ofm_%d", GetPVarInt ( playerid, "ofm_listitem" ) ) ;
					GetPVarString ( playerid, pvar_string, pl_name, MAX_PLAYER_NAME ) ;

					show_debtors ( playerid, pl_name ) ;
				    return 1 ;
				}
			}
			static const _str [ ] = "SELECT `u_id`,`u_cellar`,`u_tax` FROM `users` WHERE `u_id` = '%d' LIMIT 1" ;
			new query_string [ sizeof _str + 9 ] ;
			format ( query_string, sizeof query_string, _str, GetPVarInt ( playerid, "debt_uid" ) ) ;
			mysql_tquery ( sql_connection, query_string, "callback_debtor_property", "i", playerid ) ;
		}
		else if ( type_payment == 2 )
	    {
	        global_string [ 0 ] = EOS ;
	        new line_string [ 128 ], _card_count = 0 ;
	        for ( new i = 0 ; i < rows ; i++ )
			{
				new bank_money = cache_get_field_content_int ( i, "db_money", sql_connection ) ;
				new bank_card = cache_get_field_content_int ( i, "db_id", sql_connection ) ;
				new bank_card_type = cache_get_field_content_int ( i, "db_type", sql_connection ) ;

				if ( bank_card_type == 3 ) continue ;

				format ( line_string, 32, "bc_%d", _card_count ) ;
				SetPVarInt ( playerid, line_string, bank_card ) ;

				format ( line_string, 32, "bm_%d", _card_count ) ;
				SetPVarInt ( playerid, line_string, bank_money ) ;

				_card_count ++ ;

				format ( line_string, sizeof line_string, "{"#cBL"}%d. {"#cWH"} Номер карты: {"#cBL"}%d{"#cWH"}. Состояние счёта: {"#cGN"}%d"valute_title_"{"#cWH"}\n", _card_count, bank_card, bank_money ) ;
				strcat ( global_string, line_string ) ;
			}
			if ( _card_count == 0 )
			{
			    new pvar_string [ 38 ],
					pl_name [ MAX_PLAYER_NAME ] ;

				format ( pvar_string, sizeof ( pvar_string ), "ofm_%d", GetPVarInt ( playerid, "ofm_listitem" ) ) ;
				GetPVarString ( playerid, pvar_string, pl_name, MAX_PLAYER_NAME ) ;

				show_debtors ( playerid, pl_name ) ;
			    return 1 ;
			}
    		show_dialog ( playerid, d_debtors_card, DIALOG_STYLE_LIST, "{"#cBHD"}Банковские счета", global_string, "Выбрать", "Закрыть" ) ;
		}
		else if ( type_payment == 3 )
	    {
	        new _card_count = 0 ;
	        for ( new i = 0 ; i < rows ; i++ )
			{
				new bank_card = cache_get_field_content_int ( i, "db_id", sql_connection ) ;
				new bank_card_type = cache_get_field_content_int ( i, "db_type", sql_connection ) ;

				if ( bank_card_type == 3 ) continue ;

				_card_count ++ ;

				static const _str [ ] = "UPDATE `deposit_boxes` SET `db_money` = `db_money`+'%d' WHERE `db_id` = '%d' LIMIT 1" ;
				new query_string [ sizeof _str + 9 + 9 ] ;
				format ( query_string, sizeof query_string, _str, payment_sum, bank_card ) ;
				mysql_tquery ( sql_connection, query_string ) ;
				break ;
			}

			if ( _card_count == 0 )
			{
			    static const _str [ ] = "UPDATE `users` SET `u_money` = `u_money`+'%d' WHERE `u_id` = '%d' LIMIT 1" ;
				new query_string [ sizeof _str + 9 + 9 ] ;
				format ( query_string, sizeof query_string, _str, payment_sum, GetPVarInt ( playerid, "debt_uid" ) ) ;
				mysql_tquery ( sql_connection, query_string ) ;
			}
	    }
	}
	else
	{
	    if ( type_payment == 1 )
		{
		    static const _str [ ] = "SELECT `u_id`,`u_cellar`,`u_tax` FROM `users` WHERE `u_id` = '%d' LIMIT 1" ;
			new query_string [ sizeof _str + 9 ] ;
			format ( query_string, sizeof query_string, _str, GetPVarInt ( playerid, "debt_uid" ) ) ;
			mysql_tquery ( sql_connection, query_string, "callback_debtor_property", "i", playerid ) ;
		}
		else if ( type_payment == 2 )
		{
			SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока нет средств на банковских счетах." ) ;

			DeletePVar ( playerid, "debt_uid" ) ;
			DeletePVar ( playerid, "ofm_listitem" ) ;
			getDebtorsInfo ( playerid, page_count [ playerid ], 1 ) ;
		}
		else if ( type_payment == 3 )
		{
		    static const _str [ ] = "UPDATE `users` SET `u_money` = `u_money`+'%d' WHERE `u_id` = '%d' LIMIT 1" ;
		    new query_string [ sizeof _str + 9 + 9 ] ;
			format ( query_string, sizeof query_string, _str, payment_sum, GetPVarInt ( playerid, "debt_uid" ) ) ;
			mysql_tquery ( sql_connection, query_string ) ;
		}
	}
	return 1 ;
}

stock stock_reset_vip_player ( playerid )
{
	new _vip_level = p_info [ playerid ] [ vip ] ;
	p_info [ playerid ] [ vip_day ] =
	p_info [ playerid ] [ vip ] = 0 ;

	p_info [ playerid ] [ max_veh ] -- ;

	new scm_string [ 179 + 9 ] ;
	if ( _vip_level == 1 )
	{
	    p_info [ playerid ] [ max_biz ] -= 1 ;

		format ( scm_string, sizeof scm_string, "UPDATE `users` SET `u_vip` = '0', `u_vip_day` = '0',\
	 										`u_maxbiz` = `u_maxbiz` - '1' WHERE `u_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
		mysql_tquery ( sql_connection, scm_string ) ;
	}
	else if ( _vip_level == 2 )
	{
	    p_info [ playerid ] [ max_biz ] -= 2 ;
		p_info [ playerid ] [ max_house ] -= 1 ;

		format ( scm_string, sizeof scm_string, "UPDATE `users` SET `u_vip` = '0', `u_vip_day` = '0',\
											`u_maxbiz` = `u_maxbiz` - '2', `u_maxhouse` = `u_maxhouse` - '1',\
											`u_maxveh` = `u_maxveh` - '1' WHERE `u_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
		mysql_tquery ( sql_connection, scm_string ) ;
	}
	else if ( _vip_level == 3 )
	{
	    p_info [ playerid ] [ max_biz ] -= 3 ;
		p_info [ playerid ] [ max_house ] -= 2 ;

		format ( scm_string, sizeof scm_string, "UPDATE `users` SET `u_vip` = '0', `u_vip_day` = '0',\
											`u_maxbiz` = `u_maxbiz` - '3', `u_maxhouse` = `u_maxhouse` - '2',\
											`u_maxveh` = `u_maxveh` - '1' WHERE `u_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
		mysql_tquery ( sql_connection, scm_string ) ;
	}

	new bool: _status = false ;
	if ( Iter_Count(player_business[playerid]) > 1 )
	{
		new _b_count = 0 ;
	    foreach(new b: player_business[playerid])
	    {
	        if ( _b_count < p_info [ playerid ] [ max_biz ] )
	        {
	            _b_count ++ ;
	            continue ;
	        }

			sell_businesses ( b_info [ b - 1 ] [ b_id ] - 1, playerid, true, true ) ;
			_status = true ;
	    }
	}

	if ( Iter_Count(player_houses[playerid]) > 1 )
	{
		new _h_count = 0 ;
	    foreach(new h: player_houses[playerid])
	    {
	        if ( _h_count < p_info [ playerid ] [ max_house ] )
	        {
	            _h_count ++ ;
	            continue ;
	        }

	        sell_houses ( h_info [ h - 1 ] [ h_id ] - 1, playerid, true, true ) ;
	        if ( h_info [ h - 1 ] [ h_podezd ] != -1 ) update_podezd ( h_info [ h - 1 ] [ h_podezd ] ) ;
	        _status = true ;
	    }
	}

    SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Ваш срок действия VIP истёк!" ) ;
    if ( _status )
    {
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Часть имущества было продано, т.к. слоты уменьшены." ) ;
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Деньги были возвращены Вам на руки." ) ;
	}

	format ( scm_string, sizeof scm_string, "%s истёк срок VIP (VIP: %d lvl).", p_info [ playerid ] [ name ], _vip_level ) ;
	WriteLogs ( playerid, -1, TYPE_LOG_VIP, scm_string ) ;
	return 1 ;
}

callback: callback_reset_property ( _type, bool: _status )
{
    new fields,
		rows ;

	cache_get_data ( rows, fields ) ;
	if ( rows )
	{
		if ( _type == 1 )
		{
		    new sql_string [ 64 + ( 9 * 2 ) ] ;
		    for ( new i = 0 ; i < rows ; i ++ )
		    {
		        new _u_id = cache_get_field_content_int ( i, "u_id", sql_connection ) ;
		        new _u_tax = cache_get_field_content_int ( i, "u_tax", sql_connection ) ;

		        new bool: _finded_prop = false ;
		        for ( new h = 0 ; h < house_count ; h ++ )
		        {
		            if ( h_info [ h ] [ h_owner ] != _u_id ) continue ;

		            _finded_prop = true ;
		            sell_property ( _u_id, _u_tax, h + 1, 1, _status ) ;
		            break ;
		        }

		        if ( _finded_prop == false )
		        {
		            for ( new b = 0 ; b < b_count ; b ++ )
			        {
			            if ( b_info [ b ] [ b_owner_inc ] != _u_id ) continue ;

			            _finded_prop = true ;
			            sell_property ( _u_id, _u_tax, b, 2, _status ) ;
			            break ;
			        }
		        }

		        if ( _finded_prop == false )
		        {
		            for ( new c = 0 ; c < cellar_count ; c ++ )
			        {
			            if ( cellar_info [ c ] [ cl_owner ] != _u_id ) continue ;

			            _finded_prop = true ;
			            sell_property ( _u_id, _u_tax, c + 1, 3, _status ) ;
			            break ;
			        }
		        }

		        if ( _finded_prop == false )
		        {
		            format ( sql_string, sizeof sql_string, "UPDATE `users` SET `u_tax` = '%d' WHERE `u_id` = '%d' LIMIT 1", tax_limit_auto, _u_id ) ;
		            mysql_tquery ( sql_connection, sql_string ) ;
		        }
		    }
		}
		else if ( _type == 2 )
		{
		    for ( new i = 0 ; i < rows ; i ++ )
		    {
		        new _account_name [ MAX_PLAYER_NAME ] ;
		        cache_get_field_content ( i, "u_b_name", _account_name, sql_connection, MAX_PLAYER_NAME ) ;

		        for ( new h = 0 ; h < house_count ; h ++ )
		        {
		            if ( ! GetString ( h_info [ h ] [ h_owner_name ], _account_name ) ) continue ;

		            sell_property ( h_info [ h ] [ h_owner ], 1, h + 1, 1, _status ) ;
		        }

		        for ( new b = 0 ; b < b_count ; b ++ )
			    {
			    	if ( ! GetString ( b_info [ b ] [ b_owner_name ], _account_name ) ) continue ;

			    	sell_property ( b_info [ b ] [ b_owner_inc ], 1, b, 2, _status ) ;
		        }

		        for ( new c = 0 ; c < cellar_count ; c ++ )
			    {
			    	if ( ! GetString ( cellar_info [ c ] [ cl_owner_name ], _account_name ) ) continue ;

			        sell_property ( cellar_info [ c ] [ cl_owner ], 1, c + 1, 3, _status ) ;
		        }
		    }
		}
	}
	return 1 ;
}

stock finded_houses_players_online ( bool: _status, bool: _status2 )
{
    for ( new h = 0 ; h < house_count ; h ++ )
  	{
		if ( h_info [ h ] [ h_owner ] == -1 ) continue ;

		new sql_string [ 76 + 9 ] ;
        format ( sql_string, sizeof sql_string, "SELECT `online_sec` FROM `users_online` WHERE `accountid` = '%d' LIMIT 30", h_info [ h ] [ h_owner ] ) ;
		mysql_tquery ( sql_connection, sql_string, "callback_players_online", "iiii", h, 1, _status, _status2 ) ;
	}
	return 1 ;
}

stock finded_business_players_online ( bool: _status, bool: _status2 )
{
    for ( new b = 0 ; b < b_count ; b ++ )
  	{
		if ( b_info [ b ] [ b_owner_inc ] == -1 ) continue ;

		new sql_string [ 76 + 9 ] ;
        format ( sql_string, sizeof sql_string, "SELECT `online_sec` FROM `users_online` WHERE `accountid` = '%d' LIMIT 30", b_info [ b ] [ b_owner_inc ] ) ;
		mysql_tquery ( sql_connection, sql_string, "callback_players_online", "iiii", b, 2, _status, _status2 ) ;
	}
	return 1 ;
}

stock finded_cellars_players_online ( bool: _status, bool: _status2 )
{
    for ( new c = 0 ; c < cellar_count ; c ++ )
  	{
		if ( cellar_info [ c ] [ cl_owner ] == -1 ) continue ;

		new sql_string [ 76 + 9 ] ;
        format ( sql_string, sizeof sql_string, "SELECT `online_sec` FROM `users_online` WHERE `accountid` = '%d' LIMIT 30", cellar_info [ c ] [ cl_owner ] ) ;
		mysql_tquery ( sql_connection, sql_string, "callback_players_online", "iiii", c, 3, _status, _status2 ) ;
	}
	return 1 ;
}

#define max_slet 100
new houses_slet [ max_slet ] = { -1, ... } ;
new business_slet [ max_slet ] = { -1, ... } ;
new cellars_slet [ max_slet ] = { -1, ... } ;
callback: callback_players_online ( _inc_id, _type, bool: _status, bool: _status2 )
{
	new fields,
		rows ;

	cache_get_data ( rows, fields ) ;
	if ( rows && rows > 19 )
	{
	    if ( _type == 1 )
	    {
	        new _u_online = 0 ;
	    	for ( new i = 0 ; i < rows ; i ++ )
	    	{
	    	    _u_online += cache_get_field_content_int ( i, "online_sec", sql_connection ) ;
	    	}

	    	if ( floatround ( _u_online / 3600 ) < 6 )
	    	{
				if ( _status2 ) sell_property ( h_info [ _inc_id ] [ h_owner ], 1, _inc_id + 1, 1, _status ) ;
				else
				{
				    for ( new i = 0 ; i < max_slet ; i ++ )
				    {
						if ( houses_slet [ i ] != -1 ) continue ;

						houses_slet [ i ] = _inc_id + 1 ;
						break ;
				    }
				}
	    	}
		}
		else if ( _type == 2 )
	    {
	        new _u_online = 0 ;
	    	for ( new i = 0 ; i < rows ; i ++ )
	    	{
	    	    _u_online += cache_get_field_content_int ( i, "online_sec", sql_connection ) ;
	    	}

	    	if ( floatround ( _u_online / 3600 ) < 6 )
	       	{
				if ( _status2 ) sell_property ( b_info [ _inc_id ] [ b_owner_inc ], 1, _inc_id, 2, _status ) ;
				else
				{
				    for ( new i = 0 ; i < max_slet ; i ++ )
				    {
						if ( business_slet [ i ] != -1 ) continue ;

						business_slet [ i ] = _inc_id + 1 ;
						break ;
				    }
				}
	    	}
		}
		else if ( _type == 3 )
	    {
	        new _u_online = 0 ;
	    	for ( new i = 0 ; i < rows ; i ++ )
	    	{
	    	    _u_online += cache_get_field_content_int ( i, "online_sec", sql_connection ) ;
	    	}

	    	if ( floatround ( _u_online / 3600 ) < 6 )
	       	{
				if ( _status2 ) sell_property ( cellar_info [ _inc_id ] [ cl_owner ], 1, _inc_id + 1, 3, _status ) ;
				else
				{
				    for ( new i = 0 ; i < max_slet ; i ++ )
				    {
						if ( cellars_slet [ i ] != -1 ) continue ;

						cellars_slet [ i ] = _inc_id + 1 ;
						break ;
				    }
				}
    		}
		}
	}
	else if ( ! rows )
	{
	    if ( _type == 1 )
		{
			if ( _status2 ) sell_property ( h_info [ _inc_id ] [ h_owner ], 1, _inc_id + 1, 1, _status ) ;
			else
			{
			    for ( new i = 0 ; i < max_slet ; i ++ )
			    {
					if ( houses_slet [ i ] != -1 ) continue ;

					houses_slet [ i ] = _inc_id + 1 ;
					break ;
			    }
			}
		}
	    else if ( _type == 2 )
		{
			if ( _status2 ) sell_property ( b_info [ _inc_id ] [ b_owner_inc ], 1, _inc_id, 2, _status ) ;
			else
			{
			    for ( new i = 0 ; i < max_slet ; i ++ )
			 	{
					if ( business_slet [ i ] != -1 ) continue ;

					business_slet [ i ] = _inc_id + 1 ;
					break ;
			    }
			}
		}
	    else if ( _type == 3 )
		{
			if ( _status2 ) sell_property ( cellar_info [ _inc_id ] [ cl_owner ], 1, _inc_id + 1, 3, _status ) ;
			else
			{
			    for ( new i = 0 ; i < max_slet ; i ++ )
			    {
					if ( cellars_slet [ i ] != -1 ) continue ;

					cellars_slet [ i ] = _inc_id + 1 ;
					break ;
			    }
			}
		}
	}
	return 1 ;
}

stock sell_property ( debt_id, _debt_tax, _inc_id, type = 0, bool: status )
{
	if ( type == 1 )
	{
	    new s_house_id = _inc_id ;
        if ( h_info [ s_house_id - 1 ] [ h_sell_status ] ) return 1 ;

		new _pl_id ;
		sscanf ( h_info [ s_house_id - 1 ] [ h_owner_name ], "u", _pl_id ) ;

		new scm_string [ 144 ] ;
		format ( scm_string, sizeof scm_string, "Сервер опечатал(а) имущество должника %s (Дом №%d).", h_info [ s_house_id - 1 ] [ h_owner_name ], h_info [ s_house_id - 1 ] [ h_id ]);
		WriteLogsName ( h_info [ s_house_id - 1 ] [ h_owner_name ], 1, TYPE_LOG_DEBTORS, scm_string ) ;

		if ( IsPlayerConnected ( _pl_id ) )
		{
		    sell_houses ( s_house_id - 1, -1, false, false ) ;

			if ( status )
			{
				new _sql_string [ 100 ] ;
            	h_info [ s_house_id - 1 ] [ h_meeting ] = SetElapsedTime ( gettime ( ), random ( 24 ) + 1, CONVERT_TIME_TO_HOURS ) ;
				format ( _sql_string, sizeof( _sql_string ), "UPDATE `houses` SET `h_meeting` = '%d' WHERE `h_id` = '%d' LIMIT 1", h_info [ s_house_id - 1 ] [ h_meeting ], s_house_id ) ;
				mysql_tquery ( sql_connection, _sql_string ) ;
			}

	        if ( h_info [ s_house_id - 1 ] [ h_podezd ] != -1 ) update_podezd ( h_info [ s_house_id - 1 ] [ h_podezd ] ) ;

			p_info [ _pl_id ] [ house ] = -1 ;
			Iter_Remove(player_houses[_pl_id], h_info [ s_house_id - 1 ] [ h_id ]);

			SendClientMessage ( _pl_id, col_gray, !"* Сотрудники мэрии изъяли Вашу недвижимость в счёт оплаты долгов." ) ;
			SendClientMessage ( _pl_id, col_gray, !"* Остаточная стоимость была переведена на Ваш банковский счёт." ) ;

			new _text_string [ 148 ] ;
			if ( h_info [ s_house_id - 1 ] [ h_price ] > _debt_tax )
			{
				format(_text_string, 128, "UPDATE `users` SET `u_tax` = '0' WHERE `u_id` = '%d' LIMIT 1", debt_id ) ;
				mysql_tquery ( sql_connection, _text_string ) ;

                insert_return_money ( "Продажа дома ([S] опечатка)", h_info [ s_house_id - 1 ] [ h_price ] - _debt_tax, debt_id ) ;

				p_info [ _pl_id ] [ tax ] = 0 ;
			}
			else
			{
				format(_text_string, 128, "UPDATE `users` SET `u_tax` = `u_tax`-'%d' WHERE `u_id` = '%d' LIMIT 1",
				h_info [ s_house_id - 1 ] [ h_price ], debt_id ) ;
				mysql_tquery ( sql_connection, _text_string ) ;

				p_info [ _pl_id ] [ tax ] -= h_info [ s_house_id - 1 ] [ h_price ] ;
			}
		}
		else
		{
			sell_houses ( s_house_id - 1, -1, false, false ) ;

			if ( status )
			{
            	new _sql_string [ 100 ] ;
				h_info [ s_house_id - 1 ] [ h_meeting ] = SetElapsedTime ( gettime ( ), random ( 24 ) + 1, CONVERT_TIME_TO_HOURS ) ;
				format ( _sql_string, sizeof( _sql_string ), "UPDATE `houses` SET `h_meeting` = '%d' WHERE `h_id` = '%d' LIMIT 1", h_info [ s_house_id - 1 ] [ h_meeting ], s_house_id ) ;
				mysql_tquery ( sql_connection, _sql_string ) ;
			}

	        if ( h_info [ s_house_id - 1 ] [ h_podezd ] != -1 ) update_podezd ( h_info [ s_house_id - 1 ] [ h_podezd ] ) ;

			insert_debtor_message ( "Налоги", "Ваш дом был изъят сотрудниками мэрии в счёт оплаты налогов.\n\
												Остаточная стоимость была переведена на Ваш банковский счёт.", debt_id ) ;

            new _text_string [ 148 ] ;
			if ( h_info [ s_house_id - 1 ] [ h_price ] > _debt_tax )
			{
			    _text_string [ 0 ] = EOS ;
				format ( _text_string, 128, "UPDATE `users` SET `u_tax` = '0' WHERE `u_id` = '%d' LIMIT 1", debt_id ) ;
				mysql_tquery ( sql_connection, _text_string ) ;
			}
			else
			{
			    _text_string [ 0 ] = EOS ;
				format ( _text_string, 128, "UPDATE `users` SET `u_tax` = `u_tax`-'%d' WHERE `u_id` = '%d' LIMIT 1",
				h_info [ s_house_id - 1 ] [ h_price ], debt_id ) ;
				mysql_tquery ( sql_connection, _text_string ) ;
			}
		}

		new Float: pos [ 4 ] ;
  		get_gz_pos ( h_info [ s_house_id - 1 ] [ h_pos ] [ 0 ], h_info [ s_house_id - 1 ] [ h_pos ] [ 1 ], 50.0, pos [ 0 ], pos [ 1 ], pos [ 2 ], pos [ 3 ] ) ;
		h_info [ s_house_id - 1 ] [ h_zz_area ] = CreateDynamicRectangle ( pos [ 0 ], pos [ 1 ], pos [ 2 ], pos [ 3 ], -1, -1, -1 ) ;
		area_info [ h_info [ s_house_id - 1 ] [ h_zz_area ] ] [ a_type ] = area_type_sellstatus ;
		area_info [ h_info [ s_house_id - 1 ] [ h_zz_area ] ] [ a_item ] = h_info [ s_house_id - 1 ] [ h_id ] ;
	}
	else if ( type == 2 )
	{
	    new business_id = _inc_id ;
        if ( b_info [ business_id ] [ b_sell_status ] ) return 1 ;

        new _pl_id ;
		sscanf ( b_info [ business_id ] [ b_owner_name ], "u", _pl_id ) ;

		new scm_string [ 144 ] ;
		format ( scm_string, sizeof scm_string, "Сервер опечатал(а) имущество должника %s (%s - %s).", b_info [ business_id ] [ b_owner_name ], b_info [ business_id ] [ b_name ], b_types [ b_info [ business_id ] [ b_type ] ]);
		WriteLogsName ( b_info [ business_id ] [ b_owner_name ], 1, TYPE_LOG_DEBTORS, scm_string ) ;

		if ( IsPlayerConnected ( _pl_id ) )
		{
		    sell_businesses ( business_id, -1, false, false ) ;

			if ( status )
			{
				new _sql_string [ 100 ] ;
            	b_info [ business_id ] [ b_meeting ] = SetElapsedTime ( gettime ( ), random ( 24 ) + 1, CONVERT_TIME_TO_HOURS ) ;
				format ( _sql_string, sizeof( _sql_string ), "UPDATE `businesses` SET `b_meeting` = '%d' WHERE `b_id` = '%d' LIMIT 1", b_info [ business_id ] [ b_meeting ], b_info [ business_id ] [ b_id ]  ) ;
				mysql_tquery ( sql_connection, _sql_string ) ;
			}

            new query_string [ 148 + MAX_PLAYER_NAME + 1 ] ;
			if ( b_info [ business_id ] [ b_price ] > _debt_tax )
			{
				format(query_string, 166, "UPDATE `users` SET `u_tax` = '0' WHERE `u_id` = '%d' LIMIT 1", debt_id ) ;
				mysql_tquery ( sql_connection, query_string ) ;

				insert_return_money ( "Продажа бизнеса ([S] опечатка)", b_info [ business_id ] [ b_price ] - _debt_tax, debt_id ) ;

				p_info [ _pl_id ] [ tax ] = 0 ;
			}
			else
			{
				format(query_string, 166, "UPDATE `users` SET `u_tax` = `u_tax`-'%d' WHERE `u_id` = '%d' LIMIT 1",
				b_info [ business_id ] [ b_price ], debt_id ) ;
				mysql_tquery ( sql_connection, query_string ) ;

				p_info [ _pl_id ] [ tax ] -= b_info [ business_id ] [ b_price ] ;
			}

			p_info [ _pl_id ] [ business ] = -1 ;
			Iter_Remove(player_business[_pl_id], b_info [ business_id ][ b_id ]);

			p_info [ _pl_id ] [ business_rang ] = 0 ;
			update_int_sql ( _pl_id, "u_business_rang", 0 ) ;

			SendClientMessage ( _pl_id, col_gray, !"* Сотрудники мэрии изъяли Вашу недвижимость в счёт оплаты долгов." ) ;
			SendClientMessage ( _pl_id, col_gray, !"* Остаточная стоимость была переведена на Ваш банковский счёт." ) ;
		}
		else
		{
            sell_businesses ( business_id, -1, false, false ) ;

			if ( status )
			{
				new _sql_string [ 100 ] ;
				b_info [ business_id ] [ b_meeting ] = SetElapsedTime ( gettime ( ), random ( 24 ) + 1, CONVERT_TIME_TO_HOURS ) ;
				format ( _sql_string, sizeof( _sql_string ), "UPDATE `businesses` SET `b_meeting` = '%d' WHERE `b_id` = '%d' LIMIT 1", b_info [ business_id ] [ b_meeting ], b_info [ business_id ] [ b_id ]  ) ;
				mysql_tquery ( sql_connection, _sql_string ) ;
			}

			new _query_string [ 148 + MAX_PLAYER_NAME + 1 ] ;
			if ( b_info [ business_id ] [ b_price ] > _debt_tax )
			{
				format(_query_string, 128, "UPDATE `users` SET `u_tax` = '0' WHERE `u_id` = '%d' LIMIT 1", debt_id ) ;
				mysql_tquery ( sql_connection, _query_string ) ;
			}
			else
			{
				format(_query_string, 128, "UPDATE `users` SET `u_tax` = `u_tax`-'%d' WHERE `u_id` = '%d' LIMIT 1",
				b_info [ business_id ] [ b_price ], debt_id ) ;
				mysql_tquery ( sql_connection, _query_string ) ;
			}

			insert_debtor_message ( "Налоги", "Ваш бизнес был изъят сотрудниками мэрии в счёт оплаты налогов.\n\
											Остаточная стоимость была переведена на Ваш банковский счёт.", debt_id ) ;
		}

		new Float: pos [ 4 ] ;
  		get_gz_pos ( b_info [ business_id ] [ b_position ] [ 0 ], b_info [ business_id ] [ b_position ] [ 1 ], 50.0, pos [ 0 ], pos [ 1 ], pos [ 2 ], pos [ 3 ] ) ;
		b_info [ business_id ] [ b_zz_area ] = CreateDynamicRectangle ( pos [ 0 ], pos [ 1 ], pos [ 2 ], pos [ 3 ], -1, -1, -1 ) ;
		area_info [ b_info [ business_id ] [ b_zz_area ] ] [ a_type ] = area_type_sellstatus ;
	}
	else if ( type == 3 )
	{
	    new s_house_id = _inc_id ;
        if ( cellar_info [ s_house_id - 1 ] [ cl_sell_status ] ) return 1 ;

		new _pl_id ;
		sscanf ( cellar_info [ s_house_id - 1 ] [ cl_owner_name ], "u", _pl_id ) ;

		if ( IsPlayerConnected ( _pl_id ) )
		{
		    format ( cellar_info [ s_house_id - 1 ] [ cl_owner_name ], MAX_PLAYER_NAME, "Собственность штата" ) ;

			cellar_info [ s_house_id - 1 ] [ cl_owner ] = -1 ;
			cellar_info [ s_house_id - 1 ] [ cl_closed ] = 0 ;
			cellar_info [ s_house_id - 1 ] [ cl_sell_status ] = 0 ;

			new _sql_string [ 100 ] ;
			format ( _sql_string, sizeof( _sql_string ), "UPDATE `cellars` SET `cl_sell_status` = '0' WHERE `cl_id` = '%d' LIMIT 1", cellar_info [ s_house_id - 1 ] [ cl_id ] ) ;
			mysql_tquery ( sql_connection, _sql_string ) ;

			if ( status )
			{
				cellar_info [ s_house_id - 1 ] [ cl_meeting ] = SetElapsedTime ( gettime ( ), random ( 24 ) + 1, CONVERT_TIME_TO_HOURS ) ;
				format ( _sql_string, sizeof( _sql_string ), "UPDATE `cellars` SET `cl_meeting` = '%d' WHERE `cl_id` = '%d' LIMIT 1", cellar_info [ s_house_id - 1 ] [ cl_meeting ], cellar_info [ s_house_id - 1 ] [ cl_id ] ) ;
				mysql_tquery ( sql_connection, _sql_string ) ;
			}

			save_cellar ( s_house_id - 1 ) ;

			p_info [ _pl_id ] [ cellar ] = -1 ;

			SendClientMessage ( _pl_id, col_gray, !"* Сотрудники мэрии изъяли Вашу недвижимость в счёт оплаты долгов." ) ;
			SendClientMessage ( _pl_id, col_gray, !"* Остаточная стоимость была переведена на Ваш банковский счёт." ) ;

			p_info [ _pl_id ] [ max_veh ] -= 1 ;

			new _text_string [ 186 ] ;
			if ( cellar_info [ s_house_id - 1 ] [ cl_price ] > _debt_tax )
			{
				format(_text_string, sizeof _text_string, "UPDATE `users` SET `u_tax` = '0', `u_cellar` = '-1', `u_maxveh` = `u_maxveh` - '1' WHERE `u_id` = '%d' LIMIT 1", debt_id ) ;
				mysql_tquery ( sql_connection, _text_string ) ;

				insert_return_money ( "Продажа гаража ([S] опечатка)", cellar_info [ s_house_id - 1 ] [ cl_price ] - _debt_tax, debt_id ) ;

				p_info [ _pl_id ] [ tax ] = 0 ;
			}
			else
			{
				format(_text_string, sizeof _text_string, "UPDATE `users` SET `u_tax` = `u_tax`-'%d', `u_cellar` = '-1' WHERE `u_id` = '%d' LIMIT 1",
				cellar_info [ s_house_id - 1 ] [ cl_price ], debt_id ) ;
				mysql_tquery ( sql_connection, _text_string ) ;

				p_info [ _pl_id ] [ tax ] -= cellar_info [ s_house_id - 1 ] [ cl_price ] ;
			}
		}
		else
		{
			format ( cellar_info [ s_house_id - 1 ] [ cl_owner_name ], MAX_PLAYER_NAME, "Собственность штата" ) ;

			cellar_info [ s_house_id - 1 ] [ cl_owner ] = -1 ;
			cellar_info [ s_house_id - 1 ] [ cl_closed ] = 0 ;
			cellar_info [ s_house_id - 1 ] [ cl_sell_status ] = 0 ;

			new _sql_string [ 128 ] ;
			format ( _sql_string, sizeof( _sql_string ), "UPDATE `cellars` SET `cl_sell_status` = '0' WHERE `cl_id` = '%d' LIMIT 1", cellar_info [ s_house_id - 1 ] [ cl_id ] ) ;
			mysql_tquery ( sql_connection, _sql_string ) ;

			if ( status )
			{
				cellar_info [ s_house_id - 1 ] [ cl_meeting ] = SetElapsedTime ( gettime ( ), random ( 24 ) + 1, CONVERT_TIME_TO_HOURS ) ;
				format ( _sql_string, sizeof( _sql_string ), "UPDATE `cellars` SET `cl_meeting` = '%d' WHERE `cl_id` = '%d' LIMIT 1", cellar_info [ s_house_id - 1 ] [ cl_meeting ], cellar_info [ s_house_id - 1 ] [ cl_id ] ) ;
				mysql_tquery ( sql_connection, _sql_string ) ;
			}

			for ( new i = 0 ; i < 4 ; i ++ )
			{
				cellar_info [ s_house_id - 1 ] [ cl_improve ] [ i ] = 0 ;
			}
			format ( _sql_string, sizeof( _sql_string ),"UPDATE `cellars` SET `cl_improve` = '0|0|0|0' WHERE `cl_id` = '%d' LIMIT 1", cellar_info [ s_house_id - 1 ] [ cl_id ] ) ;
			mysql_tquery ( sql_connection, _sql_string ) ;

			save_cellar ( s_house_id - 1 ) ;

			insert_debtor_message ( "Налоги", "Ваш гараж был изъят сотрудниками мэрии в счёт оплаты налогов.\n\
											Остаточная стоимость была переведена на Ваш банковский счёт.", debt_id ) ;

            new _text_string [ 140 ] ;
			if ( cellar_info [ s_house_id - 1 ] [ cl_price ] > _debt_tax )
			{
				format ( _text_string, sizeof _text_string, "UPDATE `users` SET `u_tax` = '0',`u_cellar`='-1' WHERE `u_id` = '%d' LIMIT 1", debt_id ) ;
				mysql_tquery ( sql_connection, _text_string ) ;

				format ( _text_string, sizeof _text_string, "UPDATE `users` SET `u_maxveh` = `u_maxveh` - '1' WHERE `u_id` = '%d' LIMIT 1", debt_id ) ;
				mysql_tquery ( sql_connection, _text_string ) ;
			}
			else
			{
				format ( _text_string, sizeof _text_string, "UPDATE `users` SET `u_tax` = `u_tax`-'%d',`u_cellar`='-1' WHERE `u_id` = '%d' LIMIT 1",
				cellar_info [ s_house_id - 1 ] [ cl_price ], debt_id ) ;
				mysql_tquery ( sql_connection, _text_string ) ;

				format ( _text_string, sizeof _text_string, "UPDATE `users` SET `u_maxveh` = `u_maxveh` - '1' WHERE `u_id` = '%d' LIMIT 1", debt_id ) ;
				mysql_tquery ( sql_connection, _text_string ) ;
			}
		}
	}
	return 1 ;
}

callback: callback_reset_vip_player ( )
{
    new fields,
		rows ;

	cache_get_data ( rows, fields ) ;
	if ( rows )
	{
		new scm_string [ 356 ], _u_id, _vip_level ;
	    for ( new i = 0 ; i < rows ; i ++ )
	    {
	        _u_id = cache_get_field_content_int ( i, "u_id", sql_connection ) ;
	        _vip_level = cache_get_field_content_int ( i, "u_vip", sql_connection ) ;

	        new _account_name [ MAX_PLAYER_NAME ] ;
	        cache_get_field_content ( 0, "u_name", _account_name, sql_connection, MAX_PLAYER_NAME ) ;

			insert_debtor_message ( "VIP", "\
						Ваш срок действия VIP истёк!\n\
						Если у Вас было более 1 бизнеса или дома, то лишние были проданы.\n\
						Деньги были возвращены Вам на руки.", _u_id ) ;

			if ( _vip_level == 1 )
			{
				format ( scm_string, sizeof scm_string, "UPDATE `users` SET `u_vip` = '0', `u_vip_day` = '0',\
			 										`u_maxbiz` = `u_maxbiz` - '1' WHERE `u_id` = '%d' LIMIT 1", _u_id ) ;
				mysql_tquery ( sql_connection, scm_string ) ;
			}
			else if ( _vip_level == 2 )
			{
				format ( scm_string, sizeof scm_string, "UPDATE `users` SET `u_vip` = '0', `u_vip_day` = '0',\
			 										`u_maxbiz` = `u_maxbiz` - '2', `u_maxhouse` = `u_maxhouse` - '1',\
			 										`u_maxveh` = `u_maxveh` - '1' WHERE `u_id` = '%d' LIMIT 1", _u_id ) ;
				mysql_tquery ( sql_connection, scm_string ) ;
			}
			else if ( _vip_level == 3 )
			{
				format ( scm_string, sizeof scm_string, "UPDATE `users` SET `u_vip` = '0', `u_vip_day` = '0',\
			 										`u_maxbiz` = `u_maxbiz` - '3', `u_maxhouse` = `u_maxhouse` - '2',\
											   		`u_maxveh` = `u_maxveh` - '1' WHERE `u_id` = '%d' LIMIT 1", _u_id ) ;
				mysql_tquery ( sql_connection, scm_string ) ;
			}

			format ( scm_string, 110, "SELECT `b_id` FROM `businesses` WHERE `b_owner_inc` = '%d' LIMIT %d", _u_id, max_biz_gold ) ;
			mysql_tquery ( sql_connection, scm_string, "callback_reset_vip_businesses", "i", _u_id ) ;

			format ( scm_string, 110, "SELECT `h_id` FROM `houses` WHERE `h_owner` = '%d' LIMIT %d", _u_id, max_h_gold ) ;
			mysql_tquery ( sql_connection, scm_string, "callback_reset_vip_houses", "i", _u_id ) ;

			format ( scm_string, sizeof scm_string, "%s истёк срок VIP (VIP: %d lvl).", _account_name, _vip_level ) ;
			WriteLogsName ( _account_name, -1, TYPE_LOG_VIP, scm_string ) ;
	    }
	}
	return 1 ;
}

callback: callback_reset_vip_businesses ( _account_id )
{
    new fields,
		rows ;

	cache_get_data ( rows, fields ) ;
	if ( rows )
	{
		new _b_id ;
	    for ( new i = 0 ; i < rows ; i ++ )
	    {
	        _b_id = cache_get_field_content_int ( i, "b_id", sql_connection ) ;

	        if ( i == 0 ) continue ;

			sell_businesses ( b_info [ _b_id - 1 ] [ b_id ] - 1, -1, true, true ) ;
		}
	}
	return 1 ;
}

callback: callback_reset_vip_houses ( _account_id )
{
    new fields,
		rows ;

	cache_get_data ( rows, fields ) ;
	if ( rows )
	{
		new _h_id ;
	    for ( new i = 0 ; i < rows ; i ++ )
	    {
	        _h_id = cache_get_field_content_int ( i, "h_id", sql_connection ) ;

	        if ( i == 0 ) continue ;

			sell_houses ( h_info [ _h_id - 1 ] [ h_id ] - 1, -1, true, true ) ;
			if ( h_info [ _h_id - 1 ] [ h_podezd ] != -1 ) update_podezd ( h_info [ _h_id - 1 ] [ h_podezd ] ) ;
		}
	}
	return 1 ;
}

callback: callback_deposit_reset_date ( )
{
    new fields,
		rows ;

	cache_get_data ( rows, fields ) ;
	if( rows )
	{
		new scm_string [ 128 ], db_owner, db_id ;
	    for ( new i = 0 ; i < rows ; i ++ )
	    {
	        db_owner = cache_get_field_content_int ( i, "db_owner", sql_connection ) ;
	        db_id = cache_get_field_content_int ( i, "db_id", sql_connection ) ;

	        new _new_password = random ( 8000 ) + 1000 ;
	        scm_string [ 0 ] = EOS ;
			format ( scm_string, sizeof scm_string, "Карта №%d перевыпущена! Пароль: %d.", db_id, _new_password ) ;
			insert_debtor_message ( "Банк", scm_string, db_owner ) ;

	        scm_string [ 0 ] = EOS ;
			format ( scm_string, sizeof scm_string, "UPDATE `deposit_boxes` SET `db_reset` = '0', `db_pincode` = '%d' WHERE `db_id` = '%d' LIMIT 1", _new_password, db_id ) ;
			mysql_tquery ( sql_connection, scm_string ) ;
	    }
	}
	return 1 ;
}

