					{"#cGRDialog"}Аптечек в доме: {"#cWH"}%d\n\
					{"#cGRDialog"}Пароль от сейфа: {"#cWH"}%s\n\n\
					{"#cGRDialog"}* Для заказа продуктов используйте /service.",
					house_classes [ house_int [ h_info [ house_id ] [ h_int ] - 1 ] [ hint_class ] ], h_info [ house_id ] [ h_id ],
					floatround ( h_info [ house_id ] [ h_price ] / 350 ) * for_tax [ 3 ], h_info [ house_id ] [ h_heal ], password_string ) ;
					show_dialog ( playerid, d_hmenu_stats, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Информация о доме:", global_string, "Назад", "Закрыть" ) ;
				}

				case 2:
				{
					global_string [ 0 ] = EOS ;
					new line_string [ 128 ] ;
					for(new i = 0; i < 8; i ++)
					{
						new c [ 7 ] ;
						if ( h_info [ house_id ] [ h_improve ] [ i ] ) c = ""#cGN"";
						else if ( !i || h_info [ house_id ] [ h_improve ] [ i - 1 ] ) c = ""#cWH"" ;
						else c = ""#cGRDialog"" ;

						format( line_string, sizeof ( line_string ),"{%s}%d. %s\n", c, i + 1, h_improve_name [ i ] ) ;
						strcat ( global_string, line_string ) ;
					}
					show_dialog ( playerid, d_h_improvement, DIALOG_STYLE_LIST, "{"#cBHD"}Улучшения дома", global_string, "Выбрать", "Назад" ) ;
				}
				case 3:
				{
					if ( h_info [ house_id ] [ h_improve ] [ improve_wardrobe ] == 0 )
					{
						show_hmenu ( playerid ) ;
						return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет гардероба." ) ;
					}
					new line_string [ 80 ] ;
					global_string [ 0 ] = EOS ;
					for ( new j = 0 ; j < 5 ; j ++ )
					{
						if ( p_info [ playerid ] [ temp_skin ] [ j ] == 0 )
						{
							strcat ( global_string, "{"#cGRDialog"}- Пусто\n" ) ;
						}
						else
						{
							format ( line_string, sizeof line_string, "{ffffff}Одежда '%s' (%d)\n", get_skin_name ( p_info [ playerid ] [ temp_skin ] [ j ] ), p_info [ playerid ] [ temp_skin ] [ j ] ) ;
							strcat ( global_string, line_string ) ;
						}
					}
					strcat ( global_string, "Одежда организации" ) ;
					show_dialog ( playerid, d_h_clothes, DIALOG_STYLE_LIST, "{"#cBHD"}Гардероб", global_string, "Выбрать", "Назад" ) ;
				}
				case 4:
				{
					show_renters ( playerid ) ;
				}
				case 5:
				{
				    global_string [ 0 ] = EOS ;
				    format ( global_string, 156, "{"#cBL"}1.{ffffff} Рента дома за час ({"#cGN"}%d"valute_title_"{ffffff})\n{"#cBL"}2.{ffffff} Доступность ренты (%s)", h_info [ house_id ] [ h_rent_price ], ( ! h_info [ house_id ] [ h_rent_status ] ) ? ("{"#cRD"}Выключено{"#cWH"}") : ("{"#cGN"}Включено{"#cWH"}") ) ;
				    show_dialog ( playerid, d_h_rent_mn1, DIALOG_STYLE_LIST, "{"#cBHD"}Управление арендой дома", global_string, "Выбрать", "Назад" ) ;
				}
				case 6:
				{
					#if defined m_auction
					if ( h_info [ house_id ] [ h_auction_status ] == 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Дом выставлен на аукционе." ) ;

                    show_dialog ( playerid, d_hmenu_sell, DIALOG_STYLE_LIST, "{"#cBHD"}Продажа дома", "{"#cBL"}1.{"#cWH"} Продать игроку\n{"#cBL"}2.{"#cWH"} Продать государству", "Выбрать", "Назад" ) ;
					#else
					show_dialog ( playerid, d_hmenu_sell, DIALOG_STYLE_LIST, "{"#cBHD"}Продажа дома", "{"#cBL"}1.{"#cWH"} Продать игроку\n{"#cBL"}2.{"#cWH"} Продать государству", "Выбрать", "Назад" ) ;
					#endif
				}
				case 7: houses_freeze ( playerid ) ;
				case 8:
				{
					if ( h_info [ house_id ] [ h_improve ] [ improve_cellar ] == 0 )
					{
						show_hmenu ( playerid ) ;
						return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет оборудованного подвала." ) ;
					}

					teleport_tick [ playerid ] = GetTickCount ( ) ;
					set_pos ( playerid, house_cellar_position [ 0 ], house_cellar_position [ 1 ], house_cellar_position [ 2 ], house_cellar_position [ 3 ], house_cellar_int, h_info [ house_id ] [ h_id ] ) ;
				}
				case 9:
				{
					callcmd::garage ( playerid ) ;
				}
			}
			return 1 ;
		}
		case d_hmenu_sell:
		{
			if ( ! response ) return show_hmenu ( playerid ) ;

			if ( p_t_info [ playerid ] [ owner_account ] ) return bad_owner_account ( playerid ) ;
			if ( listitem == 0 )
			{
			    if ( p_info [ playerid ] [ hour_played ] < THREE_HOUR_PLAYED ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Доступно с 3 часов в игре. Используйте /mm - Информация о персонаже - Статистика персонажа." ) ;
				show_dialog ( playerid, d_hmenu_sell_id, DIALOG_STYLE_INPUT, "{"#cBHD"}Продажа дома", "{ffffff}Введите ID игрока, которому желаете продать дом:", "Принять", "Назад" ) ;
				return 1 ;
			}
			else if ( listitem == 1 )
			{
				new _d_str [ 300 ] ;
				format ( _d_str, sizeof _d_str, "{"#cBInfo"}* {"#cWH"}Государственная стоимость: {"#cGN"}%d"valute_title_"\n\
												{"#cBInfo"}* {"#cWH"}Цена продажи: {"#cGN"}%d"valute_title_"\n\n\
												{"#cGRDialog"}* Цена продажи может быть намного меньше\n\
												{"#cGRDialog"}* если на дом есть государственная наценка.\n\n\
												{"#cGRDialog"}* Вы действительно желаете продать дом в Собственность штата?",
				h_info [ p_info [ playerid ] [ house ] - 1 ] [ h_price ] * for_tax [ 0 ], floatround ( ( h_info [ p_info [ playerid ] [ house ] - 1 ] [ h_price ] * sell_percent ) / 100 ) ) ;
				show_dialog ( playerid, d_hmenu_sell_gov, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Продажа бизнеса", _d_str, "Продать", "Назад" ) ;
				return 1 ;
			}
		}
		case d_hmenu_sell_id:
		{
			if ( ! response )return show_dialog ( playerid, d_hmenu_sell, DIALOG_STYLE_LIST, "{"#cBHD"}Продажа дома", "{"#cBL"}1.{"#cWH"} Продать игроку\n{"#cBL"}2.{"#cWH"} Продать государству", "Выбрать", "Назад" ) ;
			new pl_id = strval ( inputtext ) ;
			if ( pl_id < 0 || pl_id > MAX_PLAYERS )return show_dialog ( playerid, d_hmenu_sell_id, DIALOG_STYLE_INPUT, "{"#cBHD"}Продажа дома", "{ffffff}Введите ID игрока, которому желаете продать дом:\n\n{"#cRD"}* Данный игрок не найден.", "Принять", "Назад" ) ;
            if ( buyer_id [ playerid ] != INVALID_PLAYER_ID )return show_dialog ( playerid, d_hmenu_sell_id, DIALOG_STYLE_INPUT, "{"#cBHD"}Продажа дома", "{ffffff}Введите ID игрока, которому желаете продать дом:\n\n{"#cRD"}* Вы уже предложили купить Ваш дом.", "Принять", "Назад" ) ;
			if ( ! bad_dialog ( pl_id ) || ! bad_dialog ( playerid ) ) return show_dialog ( playerid, d_hmenu_sell_id, DIALOG_STYLE_INPUT, "{"#cBHD"}Продажа дома", "{ffffff}Введите ID игрока, которому желаете продать дом:\n\n{"#cRD"}* Игрок в данный момент не может заключить сделку(открыт диалог).", "Принять", "Назад" ) ;
			if ( ! IsPlayerConnected ( pl_id ) || p_t_info [ pl_id ] [ p_logged ] == false ) return show_dialog ( playerid, d_hmenu_sell_id, DIALOG_STYLE_INPUT, "{"#cBHD"}Продажа дома", "{ffffff}Введите ID игрока, которому желаете продать дом:\n\n{"#cRD"}* Данный игрок не найден.", "Принять", "Назад" ) ;
			if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ pl_id ][ p_pos ] [ 0 ], p_t_info [ pl_id ][ p_pos ] [ 1 ], p_t_info [ pl_id ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( pl_id ) != GetPlayerVirtualWorld ( playerid ) )return show_dialog ( playerid, d_hmenu_sell_id, DIALOG_STYLE_INPUT, "{"#cBHD"}Продажа дома", "{ffffff}Введите ID игрока, которому желаете продать дом:\n\n{"#cRD"}* Данный игрок слишком далеко.", "Принять", "Назад" ) ;
            if ( admin_info [ pl_id ] [ admin ] > 0 && admin_info [ pl_id ] [ admin ] < 6 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок администратор." ) ;
			if ( Iter_Count(player_houses[pl_id]) >= p_info [ pl_id ] [ max_house ] ) return show_dialog ( playerid, d_hmenu_sell_id, DIALOG_STYLE_INPUT, "{"#cBHD"}Продажа дома", "{ffffff}Введите ID игрока, которому желаете продать дом:\n\n{"#cRD"}* У игрока уже есть дом.", "Принять", "Назад" ) ;
            if ( p_info [ pl_id ] [ hour_played ] < THREE_HOUR_PLAYED ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не отыграл 3 часа." ) ;

            if ( GetString ( p_t_info [ pl_id ] [ p_ip ], p_t_info [ playerid ] [ p_ip ] ) )
			{
				new scm_string [ 128 ] ;
				format ( scm_string, sizeof ( scm_string ), "{"#cBAdmin"}[A]{"#cGRAdmin"} %s[%d] попытка продажи дома %s[%d] | same ip", p_info [ playerid ] [ name ], playerid, p_info [ pl_id ] [ name ], pl_id ) ;
				foreach(new i: admin_players)SendClientMessage ( i, col_admin, scm_string ) ;

				SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Невозможно продать данному игроку." ) ;
				return 1 ;
			}

			buyer_id [ playerid ] = pl_id ;
			show_dialog ( playerid, d_hmenu_sell_price, DIALOG_STYLE_INPUT, "{"#cBHD"}Продажа дома", "{ffffff}Введите сумму, за которую хотите продать дом:", "Принять", "Назад" ) ;
			return 1 ;
		}
		case d_hmenu_sell_price:
		{
			if ( ! response )return buyer_id [ playerid ] = INVALID_PLAYER_ID, show_dialog ( playerid, d_hmenu_sell_id, DIALOG_STYLE_INPUT, "{"#cBHD"}Продажа дома", "{ffffff}Введите ID игрока, которому желаете продать дом:", "Принять", "Назад" ) ;
			new money_count = strval ( inputtext ) ;
			if ( money_count < 1 || money_count > 100000000 || money_count == INVALID_PRICE ) return show_dialog ( playerid, d_hmenu_sell_price, DIALOG_STYLE_INPUT, "{"#cBHD"}Продажа дома", "{ffffff}Введите сумму, за которую хотите продать дом:\n\n{"#cGRDialog"}* Вы ввели некорректную сумму.", "Принять", "Назад" ) ;
			if ( cooldown_sentence [ playerid ] > gettime ( ) ) return show_dialog ( playerid, d_hmenu_sell_price, DIALOG_STYLE_INPUT, "{"#cBHD"}Продажа дома", "{ffffff}Введите сумму, за которую хотите продать дом:\n\n{"#cGRDialog"}* Предложение о сделке можно отправлять один раз в {"#cRD"}45 секунд{"#cGRInfo"}.", "Принять", "Назад" ) ;

			cooldown_sentence [ playerid ] = gettime ( ) + time_sell_sentence ;

			sell_price [ playerid ] = money_count ;
			new pl_id = buyer_id [ playerid ] ;
			seller_id [ pl_id ] = playerid ;

			sell_time { playerid } =
			sell_time { pl_id } = time_sell_null ;

			show_dialog ( pl_id, d_hmenu_check, DIALOG_STYLE_LIST, "{"#cBHD"}Покупка дома", "{"#cBL"}1. {"#cWH"}Приобрести\n{"#cBL"}2. {"#cWH"}Информация", "Выбрать", "Отмена" ) ;
			return 1 ;
		}
		case d_hmenu_check:
		{
		    new pl_id = seller_id [ playerid ] ;
			if ( ! response )
			{
				clear_sell_params ( playerid, pl_id ) ;
				SendClientMessage ( pl_id, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок отказался приобретать дом." ) ;
				return 1 ;
			}
			if ( ! IsPlayerConnected ( pl_id ) || p_t_info [ pl_id ] [ p_logged ] == false )
			{
				clear_sell_params ( playerid, pl_id ) ;
				return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Произошла ошибка при продаже дома. Код: 19.") ;
			}
			new t = p_info [ pl_id ] [ house ] - 1 ;
			switch ( listitem )
			{
			    case 0:
			    {
			        global_string [ 0 ] = EOS ;
			        new money_count = sell_price [ pl_id ] ;

					format ( global_string, 128, "{ffffff}%s[%d] предлагает Вам приобрести дом {"#cBL"}№%d\n{ffffff}Цена: {"#cBL"}%s"valute_title_"",
					p_info [ pl_id ] [ name ], playerid, h_info [ t ] [ h_id ], GetPlayerCashValueToSmile ( money_count ) ) ;
					show_dialog ( playerid, d_hmenu_buy, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Покупка дома", global_string, "Купить", "Отмена" ) ;
			    }
			    case 1:
			    {
			        global_string [ 0 ] = EOS ;
					format ( global_string, 300, "{"#cGRDialog"}Класс: {"#cWH"}%s\n{"#cGRDialog"}Номер дома: {"#cWH"}%d\n{"#cGRDialog"}Налог в сутки: {"#cWH"}%d"valute_title_"\n{"#cGRDialog"}Аптечек в доме: {"#cWH"}%d",
					house_classes [ house_int [ h_info [ t ] [ h_int ] - 1 ] [ hint_class ] ], h_info [ t ] [ h_id ],
					floatround ( h_info [ t ] [ h_price ] / 350 ) * for_tax [ 3 ], h_info [ t ] [ h_heal ] ) ;
					show_dialog ( playerid, d_hmenu_check_stats, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Информация о доме:", global_string, "Назад", "Закрыть" ) ;
			    }
			}
			return 1 ;
		}
		case d_hmenu_check_stats:
		{
		    new pl_id = seller_id [ playerid ] ;
			if ( ! response )
			{
				clear_sell_params ( playerid, pl_id ) ;
				SendClientMessage ( pl_id, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок отказался приобретать дом." ) ;
				return 1 ;
			}
			show_dialog ( playerid, d_hmenu_check, DIALOG_STYLE_LIST, "{"#cBHD"}Покупка дома", "{"#cBL"}1. {"#cWH"}Приобрести\n{"#cBL"}2. {"#cWH"}Информация", "Выбрать", "Отмена" ) ;
			return 1 ;
		}
		case d_hmenu_buy:
		{
			new pl_id = seller_id [ playerid ] ;
			if ( ! response )
			{
				clear_sell_params ( playerid, pl_id ) ;
				SendClientMessage ( pl_id, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок отказался приобретать дом." ) ;
				return 1 ;
			}
			if ( ! IsPlayerConnected ( pl_id ) || p_t_info [ pl_id ] [ p_logged ] == false ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Произошла ошибка при продаже дома. Код: 19.") ;
			if ( ! Iter_Count(player_houses[pl_id]) )
			{
				clear_sell_params ( playerid, pl_id ) ;
				return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока нет дома." ) ;
			}

			if ( Iter_Count(player_houses[playerid]) >= p_info [ playerid ] [ max_house ] )
			{
			    clear_sell_params ( playerid, pl_id ) ;
				SendClientMessage ( pl_id, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока уже есть дом." ) ;
				return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас уже есть дом." ) ;
			}

			new _b_sell_price = sell_price [ pl_id ] ;
			if ( p_info [ playerid ] [ money ] < _b_sell_price )
			{
				clear_sell_params ( playerid, pl_id ) ;
				SendClientMessage ( pl_id, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока недостаточно средств для приобретения дома." ) ;
				return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас недостаточно средств для приобретения дома." ) ;
			}
			if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ pl_id ] [ p_pos ] [ 0 ], p_t_info [ pl_id ] [ p_pos ] [ 1 ], p_t_info [ pl_id ] [ p_pos ] [ 2 ] ) || p_t_info [ playerid ] [ p_data ] [ 1 ] != p_t_info [ pl_id ] [ p_data ] [ 1 ] )
			{
				clear_sell_params ( playerid, pl_id ) ;
				SendClientMessage ( pl_id, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы слишком далеко от покупателя." ) ;
				return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы слишком далеко от продавца." ) ;
			}
			if ( ! IsPlayerConnected ( pl_id ) || p_t_info [ pl_id ] [ p_logged ] == false )
			{
				clear_sell_params ( playerid, pl_id ) ;
				return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Произошла ошибка при продаже бизнеса. Код: 19.") ;
			}

			new house_id = p_info [ pl_id ] [ house ] ;
			p_info [ playerid ] [ house ] = house_id ;
			p_info [ pl_id ] [ house ] = -1 ;

			format ( h_info [ house_id - 1 ] [ h_owner_name ], MAX_PLAYER_NAME, "%s", p_info [ playerid ] [ name ] ) ;
			h_info [ house_id - 1 ] [ h_owner ] = p_info [ playerid ] [ id ] ;
			give_money ( playerid, - _b_sell_price ) ;
			give_money ( pl_id, _b_sell_price ) ;

			insert_money_log ( pl_id, playerid, _b_sell_price, "продажа дома игроку" ) ;

			Iter_Remove(player_houses[pl_id], house_id);
			Iter_Add(player_houses[playerid], house_id);

			#if defined m_tablet
				deleteForSellProperty ( house_id, CATEGORY_HOUSES ) ;
			#endif

			p_info [ playerid ] [ spawnchange ] = 1 ;
			update_int_sql ( playerid, "u_spawnchange", 1 ) ;

			PlayerPlaySound ( playerid, 1052, 0.0, 0.0, 0.0 ) ;

			h_info [ house_id - 1 ] [ h_sell_status ] =
			h_info [ house_id - 1 ] [ h_safe_code ] = 0 ;

			global_string [ 0 ] = EOS ;
	 		format ( global_string, 256, "UPDATE `houses` SET `h_owner` = '%d', `h_sell_status` = '0', `h_safe_code` = '0000' WHERE `h_id` = '%d' LIMIT 1",
			p_info [ playerid ] [ id ], h_info [ house_id - 1 ] [ h_id ] ) ;
			mysql_tquery ( sql_connection, global_string ) ;

			new query_string [ 144 ] ;
			format ( query_string, 144, "{"#cGN"}* %s{"#cWH"} продал Вам своё жильё {"#cGN"}№%d {"#cWH"}за {"#cGN"}%d"valute_title"{"#cWH"}.", p_info [ pl_id ] [ name ], h_info [ house_id - 1 ] [ h_id ], _b_sell_price ) ;
			SendClientMessage ( playerid, col_white, query_string ) ;
			format( query_string, 144, "{"#cGInfo"}* {"#cWH"}Вы продали своё жильё №%d {"#cGN"}%s{"#cWH"} за {"#cGN"}%d"valute_title"{"#cWH"}.", h_info [ house_id - 1 ] [ h_id ], p_info [ playerid ] [ name ], _b_sell_price ) ;
			SendClientMessage ( pl_id, col_white, query_string ) ;

			clear_fam_house ( pl_id, house_id, 0 ) ;

			SendClientMessage ( playerid, col_gray, !"{"#cGInfo"}* {"#cGRInfo"}Вы успешно приобрели данную недвижимость. Используйте {"#cGN"}/hmenu{"#cGRInfo"} для управление домом." ) ;
		 	SendClientMessage ( playerid, col_gray, !"{"#cGInfo"}* {"#cGRInfo"}Вам необходимо оплачивать налоги на недвижимость." ) ;
		 	SendClientMessage ( playerid, col_gray, !"{"#cGInfo"}* {"#cGRInfo"}Налоги списываются 1 раз в сутки. Для получения выписки рекомендуем обратиться в банк." ) ;

			if ( h_info [ house_id - 1 ] [ h_garage ] )
			{
				SendClientMessage ( playerid, col_gray, !"{"#cGInfo"}* {"#cGRInfo"}В доме имеется обустроенный гараж, в котором можно парковать т/с." ) ;
				SendClientMessage ( playerid, col_gray, !"{"#cGInfo"}* {"#cGRInfo"}Домашний гараж не даёт дополнительный слот для т/с." ) ;
			}

			if ( ! users_education [ playerid ] [ EDUCATION_BUY_HOUSE ] )
			{
				show_window_monologue (
					playerid,
					5,
					"Поздравляю тебя с покупкой дома! \
					Не забывай оплачивать налоги. Налоги на недвижимость начисляются раз в сутки. \
					Оплатить их можно в банке или банкомате. Используй /gps, чтоб найти ближайший. \
					Если сумма долга превысит "tax_limit", то сотрудники Мэрии опечатать имущество для аукциона.",
					"Местный",
					"Понял"
				) ;

				save_user_education ( playerid, EDUCATION_BUY_HOUSE ) ;
			}

			clear_sell_params ( playerid, pl_id ) ;
			checking_quest_progress ( playerid, 2, 1, quest_line_medium ) ;
			return 1 ;
		}
		case d_hmenu_sell_gov:
