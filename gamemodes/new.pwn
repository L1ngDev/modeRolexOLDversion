			hotel_info [ i ] [ h_pos ] [ 1 ] = cache_get_field_content_float ( i,"h_pos_y", sql_connection ) ;
			hotel_info [ i ] [ h_pos ] [ 2 ] = cache_get_field_content_float ( i,"h_pos_z", sql_connection ) ;
			hotel_info [ i ] [ h_pos ] [ 3 ] = cache_get_field_content_float ( i,"h_pos_c", sql_connection ) ;

			hotel_info [ i ] [ h_v_pos ] [ 0 ] = cache_get_field_content_float ( i,"h_v_pos_x", sql_connection ) ;
			hotel_info [ i ] [ h_v_pos ] [ 1 ] = cache_get_field_content_float ( i,"h_v_pos_y", sql_connection ) ;
			hotel_info [ i ] [ h_v_pos ] [ 2 ] = cache_get_field_content_float ( i,"h_v_pos_z", sql_connection ) ;
			hotel_info [ i ] [ h_v_pos ] [ 3 ] = cache_get_field_content_float ( i,"h_v_pos_c", sql_connection ) ;

			hotel_info [ i ] [ h_desc_id ] = cache_get_field_content_int ( i, "h_desc_id", sql_connection ) ;
			hotel_info [ i ] [ h_closed ] = cache_get_field_content_int ( i, "h_closed", sql_connection ) ;

			hotel_info [ i ] [ h_days ] = cache_get_field_content_int ( i, "h_days", sql_connection ) ;
			hotel_info [ i ] [ h_biz ] = cache_get_field_content_int ( i, "h_biz", sql_connection ) ;
			if ( hotel_info [ i ] [ h_owner ] == -1 ) b_info [ hotel_info [ i ] [ h_biz ] ] [ b_free_number ] += 1 ;

			CreateDynamic3DTextLabel ( "** Выход **\n{"#cGR3D"}Введите {"#cWH3D"}/exit{"#cGR3D"} для выхода из номера", col_header_3d,
													hotel_exit_pickup [ 0 ], hotel_exit_pickup [ 1 ], hotel_exit_pickup [ 2 ] + 0.5,
													4.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, hotel_info [ i ] [ h_biz ] + hotel_info [ i ] [ h_id ], 3 ) ;

			new _form_elevator = hotel_info [ i ] [ h_biz ] + 1000 + hotel_info [ i ] [ h_biz ] + ( hotel_info [ i ] [ h_vw ] - ( hotel_info [ i ] [ h_biz ] + 1 ) ) ;
			new hotel_number [ 64 ] ;
			format ( hotel_number, sizeof hotel_number, "** Номер отеля **\n{"#cGR3D"}Комната: {"#cWH3D"}№%d", hotel_info [ i ] [ h_desc_id ] ) ;
            CreateDynamic3DTextLabel ( hotel_number, col_header_3d,
													hotel_info [ i ] [ h_pos ] [ 0 ], hotel_info [ i ] [ h_pos ] [ 1 ], hotel_info [ i ] [ h_pos ] [ 2 ] + 0.5,
													4.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, _form_elevator, 3 ) ;

			hotel_info [ i ] [ h_pickup ] = CreateDynamicPickup ( 1318, 23, hotel_info [ i ] [ h_pos ] [ 0 ], hotel_info [ i ] [ h_pos ] [ 1 ], hotel_info [ i ] [ h_pos ] [ 2 ], _form_elevator, 3 ) ;

			pick_info [ hotel_info [ i ] [ h_pickup ] ] [ pick_type ] = pick_type_hotelentrance ;
			pick_info [ hotel_info [ i ] [ h_pickup ] ] [ pick_item ] = hotel_info [ i ] [ h_id ] ;
		}
    }

    foreach(new b: business_types[bizz_type_hotel])
    {
        new bool: _find_room = false ;
        for ( new i = 0 ; i < hotel_count ; i ++ )
    	{
			if ( b_info [ b - 1 ] [ b_id ] != hotel_info [ i ] [ h_biz ] ) continue ;

			_find_room = true ;
			break ;
		}

		if ( _find_room == false )
		{
	        for ( new q = 1 ; q < 4 ; q ++ )
			{
				for ( new z = 0 ; z < MAX_ROOMS ; z ++ )
				{
				    new query_string [ 256 ], _desc_id = ( z + 1 ) + ( ( q - 1 ) * MAX_ROOMS ) ;
					mysql_format ( sql_connection, query_string, sizeof ( query_string  ),"INSERT INTO `hotels` (`h_vw`,`h_pos_x`,`h_pos_y`,`h_pos_z`,`h_pos_c`,`h_desc_id`,`h_biz`) VALUES ('%d','%f','%f','%f','%f','%d','%d')",
					b_info [ b - 1 ] [ b_id ] + q, rooms_position [ z ] [ 0 ], rooms_position [ z ] [ 1 ], rooms_position [ z ] [ 2 ], rooms_position [ z ] [ 3 ], _desc_id, b_info [ b - 1 ] [ b_id ] ) ;
					mysql_tquery ( sql_connection, query_string, "", "" ) ;

					hotel_count ++ ;
				}
			}
		}
    }

	printf ( "[SERVER] Загружено %d номеров в отелях. (%d ms)", hotel_count, GetTickCount ( ) - time ) ;
	return 1 ;
}

callback: houses_loading ( )
{
	new fields, time = GetTickCount ( ) ;
	cache_get_data ( house_count, fields ) ;
	if ( house_count )
	{
	    new _h_id ;
		for ( new i = 0 ; i < house_count ; i ++ )
		{
			_h_id = cache_get_field_content_int ( i, "h_id", sql_connection ) ;

			if ( h_info [ i ] [ h_id ] == _h_id ) continue ;
			else h_info [ i ] [ h_id ] = _h_id ;

			h_info [ i ] [ h_owner ] = cache_get_field_content_int ( i, "h_owner", sql_connection ) ;
			cache_get_field_content ( i, "h_ownername", h_info [ i ] [ h_owner_name ], sql_connection, MAX_PLAYER_NAME ) ;

			h_info [ i ] [ h_int ] = cache_get_field_content_int ( i, "h_int", sql_connection ) ;
			h_info [ i ] [ h_vw ] = cache_get_field_content_int ( i, "h_vw", sql_connection ) ;

			h_info [ i ] [ h_pos ] [ 0 ] = cache_get_field_content_float ( i,"h_pos_x", sql_connection ) ;
			h_info [ i ] [ h_pos ] [ 1 ] = cache_get_field_content_float ( i,"h_pos_y", sql_connection ) ;
			h_info [ i ] [ h_pos ] [ 2 ] = cache_get_field_content_float ( i,"h_pos_z", sql_connection ) ;
			h_info [ i ] [ h_pos ] [ 3 ] = cache_get_field_content_float ( i,"h_pos_c", sql_connection ) ;

			h_info [ i ] [ h_v_pos ] [ 0 ] = cache_get_field_content_float ( i,"h_v_pos_x", sql_connection ) ;
			h_info [ i ] [ h_v_pos ] [ 1 ] = cache_get_field_content_float ( i,"h_v_pos_y", sql_connection ) ;
			h_info [ i ] [ h_v_pos ] [ 2 ] = cache_get_field_content_float ( i,"h_v_pos_z", sql_connection ) ;
			h_info [ i ] [ h_v_pos ] [ 3 ] = cache_get_field_content_float ( i,"h_v_pos_c", sql_connection ) ;

			h_info [ i ] [ h_radio_status ] = cache_get_field_content_int ( i, "h_radio_status", sql_connection ) ;
			cache_get_field_content ( i, "h_radio_url", h_info [ i ] [ h_radio_url ], sql_connection, MAX_PLAYER_NAME ) ;

			h_info [ i ] [ h_garage ] = cache_get_field_content_int ( i, "h_garage", sql_connection ) ;
			h_info [ i ] [ h_price ] = cache_get_field_content_int ( i, "h_price", sql_connection ) ;
			h_info [ i ] [ h_rent_price ] = cache_get_field_content_int ( i, "h_rent", sql_connection ) ;
			h_info [ i ] [ h_rent_status ] = cache_get_field_content_int ( i, "h_rent_status", sql_connection ) ;
			h_info [ i ] [ h_closed ] = cache_get_field_content_int ( i, "h_closed", sql_connection ) ;

			h_info [ i ] [ h_renters ] = cache_get_field_content_int ( i, "h_renters", sql_connection ) ;

			h_info [ i ] [ h_safe_code ] = cache_get_field_content_int ( i, "h_safe_code", sql_connection ) ;
			h_info [ i ] [ h_prods ] = cache_get_field_content_int ( i, "h_prods", sql_connection ) ;

			h_info [ i ] [ h_days ] = cache_get_field_content_int ( i, "h_days", sql_connection ) ;

			new sscanf_delimit [ 48 ] ;
			cache_get_field_content ( i, "h_improve", sscanf_delimit, sql_connection, 48 ) ;
			sscanf ( sscanf_delimit, "p<|>dddddddd", h_info [ i ] [ h_improve ] [ 0 ], h_info [ i ] [ h_improve ] [ 1 ], h_info [ i ] [ h_improve ] [ 2 ],
			h_info [ i ] [ h_improve ] [ 3 ], h_info [ i ] [ h_improve ] [ 4 ], h_info [ i ] [ h_improve ] [ 5 ], h_info [ i ] [ h_improve ] [ 6 ], h_info [ i ] [ h_improve ] [ 7 ] ) ;

			cache_get_field_content ( i, "h_safe_data", sscanf_delimit, sql_connection, 36 ) ;
			sscanf ( sscanf_delimit, "p<|>dddddddd", h_info [ i ] [ h_safe_data ] [ 0 ], h_info [ i ] [ h_safe_data ] [ 1 ],
			h_info [ i ] [ h_safe_guns ] [ 0 ],	h_info [ i ] [ h_safe_guns ] [ 1 ], h_info [ i ] [ h_safe_guns ] [ 2 ],
			h_info [ i ] [ h_safe_guns ] [ 3 ],	h_info [ i ] [ h_safe_guns ] [ 4 ], h_info [ i ] [ h_safe_guns ] [ 5 ] ) ;

			h_info [ i ] [ h_seed ] = cache_get_field_content_int ( i, "h_seed", sql_connection ) ;
			h_info [ i ] [ h_seed_result ] = cache_get_field_content_int ( i, "h_seed_result", sql_connection ) ;

			h_info [ i ] [ h_heal ] = cache_get_field_content_int ( i, "h_heal", sql_connection ) ;

            h_info [ i ] [ h_price_ticket ] = cache_get_field_content_int ( i, "h_price_ticket", sql_connection ) ;

            h_info [ i ] [ h_sell_status ] = cache_get_field_content_int ( i, "h_sell_status", sql_connection ) ;
            h_info [ i ] [ h_auction_date ] = cache_get_field_content_int ( i, "h_auction_date", sql_connection ) ;
            h_info [ i ] [ h_auction_bet ] = cache_get_field_content_int ( i, "h_auction_bet", sql_connection ) ;
            h_info [ i ] [ h_auction_player ] = cache_get_field_content_int ( i, "h_auction_player", sql_connection ) ;
            if ( h_info [ i ] [ h_auction_date ] > gettime ( ) )
			{
				h_info [ i ] [ h_auction_status ] = 1 ;
				AddAuctionHouse ( h_info [ i ] [ h_id ] ) ;
				sell_houses_auction ( i, 1 ) ;
			}

            h_info [ i ] [ h_freeze ] = cache_get_field_content_int ( i, "h_freeze", sql_connection ) ;
			h_info [ i ] [ h_freeze_day ] = cache_get_field_content_int ( i, "h_freeze_day", sql_connection ) ;
			h_info [ i ] [ h_freeze_date ] = cache_get_field_content_int ( i, "h_freeze_date", sql_connection ) ;

			h_info [ i ] [ h_meeting ] = cache_get_field_content_int ( i, "h_meeting", sql_connection ) ;
			if ( h_info [ i ] [ h_meeting ] > gettime ( ) && ! IsValidDynamicArea ( h_info [ i ] [ h_zz_area ] ) )
			{
			    new Float: pos [ 4 ] ;
		  		get_gz_pos ( h_info [ i ] [ h_pos ] [ 0 ], h_info [ i ] [ h_pos ] [ 1 ], 50.0, pos [ 0 ], pos [ 1 ], pos [ 2 ], pos [ 3 ] ) ;
				h_info [ i ] [ h_zz_area ] = CreateDynamicRectangle ( pos [ 0 ], pos [ 1 ], pos [ 2 ], pos [ 3 ], -1, -1, -1 ) ;
				area_info [ h_info [ i ] [ h_zz_area ] ] [ a_type ] = area_type_sellstatus ;
				area_info [ h_info [ i ] [ h_zz_area ] ] [ a_item ] = h_info [ i ] [ h_id ] ;
			}

			h_info [ i ] [ h_podezd ] = cache_get_field_content_int ( i, "h_podezd", sql_connection ) ;
			h_info [ i ] [ h_upgrade_craft ] = cache_get_field_content_int ( i, "h_upgrade_craft", sql_connection ) ;

			#if defined m_garden
			h_info [ i ] [ h_garden ] = cache_get_field_content_int ( i, "h_garden", sql_connection ) ;
			if ( h_info [ i ] [ h_garden ] == 1 )
			{
				Iter_Add(houses_garden, h_info [ i ] [ h_id ]);

				h_info [ i ] [ h_garden_position ] [ 0 ] = cache_get_field_content_float ( i, "h_garden_position_x", sql_connection ) ;
				h_info [ i ] [ h_garden_position ] [ 1 ] = cache_get_field_content_float ( i, "h_garden_position_y", sql_connection ) ;
				h_info [ i ] [ h_garden_position ] [ 2 ] = cache_get_field_content_float ( i, "h_garden_position_z", sql_connection ) ;
				h_info [ i ] [ h_garden_position ] [ 3 ] = cache_get_field_content_float ( i, "h_garden_position_c", sql_connection ) ;

				h_info [ i ] [ h_garden_pickup ] = CreateDynamicPickup ( 19639, 23, h_info [ i ] [ h_garden_position ] [ 0 ], h_info [ i ] [ h_garden_position ] [ 1 ], h_info [ i ] [ h_garden_position ] [ 2 ], -1, -1 ) ;
				pick_info [ h_info [ i ] [ h_garden_pickup ] ] [ pick_type ] = pick_type_gentrance ;

				h_info [ i ] [ h_garden_label ] = CreateDynamic3DTextLabel("** Теплица **\n", col_header_3d,
										h_info [ i ] [ h_garden_position ] [ 0 ], h_info [ i ] [ h_garden_position ] [ 1 ], h_info [ i ] [ h_garden_position ] [ 2 ],
										4.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, -1 ) ;

				for ( new q = 0 ; q < MAX_PLANT_IN_GARDEN ; q ++ )
				{
				    h_info [ i ] [ h_garden_time ] [ q ] = 0 ;
				    h_info [ i ] [ h_garden_object ] [ q ] = INVALID_OBJECT_ID ;

				    h_info [ i ] [ h_garden_text ] [ q ] = CreateDynamic3DTextLabel ( "** Грядка **\n{"#cGR3D"}Нажмите {"#cWH3D"}ALT{"#cGR3D"} для взаимодействия", col_header_3d, garden_object_position [ q ] [ 0 ],
																										garden_object_position [ q ] [ 1 ],
																										garden_object_position [ q ] [ 2 ] + 0.8, 5.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, h_info [ i ] [ h_id ], garden_interior ) ;
				}
			}
			#endif

			if ( h_info [ i ] [ h_garage ] > 0 )
			{
			    if ( house_first_garage == -1 ) house_first_garage = i ;

			    h_info [ i ] [ h_garage_pickup ] = CreateDynamicPickup ( pickupPropertyGarage, 23, h_info [ i ] [ h_v_pos ] [ 0 ], h_info [ i ] [ h_v_pos ] [ 1 ], h_info [ i ] [ h_v_pos ] [ 2 ], -1, -1 ) ;
                pick_info [ h_info [ i ] [ h_garage_pickup ] ] [ pick_type ] = pick_type_housegarage ;
				pick_info [ h_info [ i ] [ h_garage_pickup ] ] [ pick_item ] = h_info [ i ] [ h_id ] ;

				h_info [ i ] [ h_garage_area ] = CreateDynamicSphere ( h_info [ i ] [ h_v_pos ] [ 0 ], h_info [ i ] [ h_v_pos ] [ 1 ], h_info [ i ] [ h_v_pos ] [ 2 ], 3.0, -1, -1, -1 ) ;
				area_info [ h_info [ i ] [ h_garage_area ] ] [ a_type ] = area_type_housegarage ;
		        area_info [ h_info [ i ] [ h_garage_area ] ] [ a_item ] = h_info [ i ] [ h_id ] ;

				new scm_string [ 74 + 9 ] ;
				format ( scm_string, sizeof scm_string, "** Гараж №%d **\n{"#cGR3D"}Нажмите {"#cWH3D"}Y{"#cGR3D"}, чтобы заехать", i + 1 ) ;
				h_info [ i ] [ h_garage_text ] = CreateDynamic3DTextLabel ( scm_string, col_header_3d,
										h_info [ i ] [ h_v_pos ] [ 0 ], h_info [ i ] [ h_v_pos ] [ 1 ], h_info [ i ] [ h_v_pos ] [ 2 ],
										4.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, -1, -1 ) ;
			}

			new hint = h_info [ i ] [ h_int ] - 1 ;
			CreateDynamic3DTextLabel("** Выход **\n{"#cGR3D"}Введите {"#cWH3D"}/exit{"#cGR3D"} для выхода из дома", col_header_3d,
													house_int [ hint ] [ hint_position ] [ 0 ], house_int [ hint ] [ hint_position ] [ 1 ], house_int [ hint ] [ hint_position ] [ 2 ] + 0.5,
													4.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, h_info [ i ] [ h_id ], house_int [ hint ] [ hint_int ] ) ;

			if ( h_info [ i ] [ h_owner ] == -1 )
			{
				h_info [ i ] [ h_pickup ] = CreateDynamicPickup ( pickupPropertyFree, 23, h_info [ i ] [ h_pos ] [ 0 ], h_info [ i ] [ h_pos ] [ 1 ], h_info [ i ] [ h_pos ] [ 2 ], h_info [ i ] [ h_vw ], -1 ) ;
				if ( ! h_info [ i ] [ h_vw ] ) h_info [ i ] [ h_icon_id ] = CreateDynamicMapIcon ( h_info [ i ] [ h_pos ] [ 0 ], h_info [ i ] [ h_pos ] [ 1 ], h_info [ i ] [ h_pos ] [ 2 ], radar_propertyG, 0, 0, 0, -1 ) ;
			}
			else
			{
				if ( h_info [ i ] [ h_rent_status ] == 0 )
				{
					h_info [ i ] [ h_pickup ] = CreateDynamicPickup ( pickupPropertyUse, 23, h_info [ i ] [ h_pos ] [ 0 ], h_info [ i ] [ h_pos ] [ 1 ], h_info [ i ] [ h_pos ] [ 2 ], h_info [ i ] [ h_vw ], -1 ) ;
					if ( ! h_info [ i ] [ h_vw ] ) h_info [ i ] [ h_icon_id ] = CreateDynamicMapIcon ( h_info [ i ] [ h_pos ] [ 0 ], h_info [ i ] [ h_pos ] [ 1 ], h_info [ i ] [ h_pos ] [ 2 ], radar_propertyR, 0, 0, 0, -1 ) ;
				}
				else
				{
					h_info [ i ] [ h_pickup ] = CreateDynamicPickup ( 19524, 23, h_info [ i ] [ h_pos ] [ 0 ], h_info [ i ] [ h_pos ] [ 1 ], h_info [ i ] [ h_pos ] [ 2 ], h_info [ i ] [ h_vw ], -1 ) ;
					if ( ! h_info [ i ] [ h_vw ] ) h_info [ i ] [ h_icon_id ] = CreateDynamicMapIcon ( h_info [ i ] [ h_pos ] [ 0 ], h_info [ i ] [ h_pos ] [ 1 ], h_info [ i ] [ h_pos ] [ 2 ], radar_propertyR, 0, 0, 0, -1 ) ;
				}
			}

			if ( create_pick_house_exit [ hint ] == false )
			{
			    create_pick_house_exit [ hint ] = true ;
			    pick_house_exit [ hint ] = CreateDynamicPickup ( 1318, 23, house_int [ hint ] [ hint_position ] [ 0 ], house_int [ hint ] [ hint_position ] [ 1 ], house_int [ hint ] [ hint_position ] [ 2 ], -1, -1 ) ;
				pick_info [ pick_house_exit [ hint ] ] [ pick_type ] = pick_type_hexit ;
				//h_info [ i ] [ h_exit_pickup ] = CreateDynamicPickup ( 1318, 23, house_int [ hint ] [ hint_position ] [ 0 ], house_int [ hint ] [ hint_position ] [ 1 ], house_int [ hint ] [ hint_position ] [ 2 ], h_info [ i ] [ h_id ], house_int [ hint ] [ hint_int ] ) ;
				//pick_info [ h_info [ i ] [ h_exit_pickup ] ] [ pick_type ] = pick_type_hexit ;
			}

			pick_info [ h_info [ i ] [ h_pickup ] ] [ pick_type ] = pick_type_hentrance ;
			pick_info [ h_info [ i ] [ h_pickup ] ] [ pick_item ] = h_info [ i ] [ h_id ] ;

			for ( new k = 0 ; k < 6 ; k ++ )
			{
				if ( ! h_info [ i ] [ h_improve ] [ k ] ) continue ;
				switch ( k )
				{
					case 1:
					{
						#if defined Computer
					    h_info [ i ] [ h_safe ] = CreateDynamic3DTextLabel ( "** Сейф **\n{"#cGR3D"}Нажмите {"#cWH3D"}Y{"#cGR3D"} для взаимодействия", col_header_3d, house_safe_pos [ hint ] [ 0 ], house_safe_pos [ hint ] [ 1 ], house_safe_pos [ hint ] [ 2 ] + 0.8, 5.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, h_info [ i ] [ h_id ] ) ;
					    #else
					    h_info [ i ] [ h_safe ] = CreateDynamic3DTextLabel ( "** Сейф **", col_header_3d, house_safe_pos [ hint ] [ 0 ], house_safe_pos [ hint ] [ 1 ], house_safe_pos [ hint ] [ 2 ] + 0.8, 5.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, h_info [ i ] [ h_id ] ) ;
					    #endif
                        #if defined SAMP
						h_info [ i ] [ h_safe_object ] = CreateDynamicObject ( 2332, house_safe_pos [ hint ] [ 0 ], house_safe_pos [ hint ] [ 1 ], house_safe_pos [ hint ] [ 2 ], house_safe_pos [ hint ] [ 3 ], house_safe_pos [ hint ] [ 4 ], house_safe_pos [ hint ] [ 5 ], h_info [ i ] [ h_id ], house_int [ hint ] [ hint_int ] ) ;
						#endif
					}
					case 2:
					{
						#if defined Computer
					    h_info [ i ] [ h_fridge ] = CreateDynamic3DTextLabel ( "** Холодильник **\n{"#cGR3D"}Нажмите {"#cWH3D"}Y{"#cGR3D"} для взаимодействия", col_header_3d, house_freeze_pos [ hint ] [ 0 ], house_freeze_pos [ hint ] [ 1 ], house_freeze_pos [ hint ] [ 2 ] + 0.8, 5.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, h_info [ i ] [ h_id ] ) ;
					    #else
					    h_info [ i ] [ h_fridge ] = CreateDynamic3DTextLabel ( "** Холодильник **", col_header_3d, house_freeze_pos [ hint ] [ 0 ], house_freeze_pos [ hint ] [ 1 ], house_freeze_pos [ hint ] [ 2 ] + 0.8, 5.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, h_info [ i ] [ h_id ] ) ;
					    #endif
                        #if defined SAMP
						h_info [ i ] [ h_fridge_object ] = CreateDynamicObject ( 2141, house_freeze_pos [ hint ] [ 0 ], house_freeze_pos [ hint ] [ 1 ], house_freeze_pos [ hint ] [ 2 ], house_freeze_pos [ hint ] [ 3 ], house_freeze_pos [ hint ] [ 4 ], house_freeze_pos [ hint ] [ 5 ], h_info [ i ] [ h_id ], house_int [ hint ] [ hint_int ] ) ;
						#endif
					}
				}
			}
		}
    }

    new areaId ;
    for ( new idx = 0 ; idx < HINTS_COUNT ; idx ++ )
    {
    	areaId = CreateDynamicSphere ( house_safe_pos [ idx ] [ 0 ], house_safe_pos [ idx ] [ 1 ], house_safe_pos [ idx ] [ 2 ], 2.0, -1, -1, -1 ) ;
		area_info [ areaId ] [ a_type ] = area_type_safe ;

    	areaId = CreateDynamicSphere ( house_freeze_pos [ idx ] [ 0 ], house_freeze_pos [ idx ] [ 1 ], house_freeze_pos [ idx ] [ 2 ], 2.0, -1, -1, -1 ) ;
		area_info [ areaId ] [ a_type ] = area_type_freeze ;
	}

    #if defined m_garden
	    garden_OnGameModeInit ( ) ;
	#endif

	printf ( "[SERVER] Загружено %d домов. (%d ms)", house_count, GetTickCount ( ) - time ) ;
	return 1 ;
}

callback: cellars_loading ( )
{
	new fields, time = GetTickCount ( ) ;
	cache_get_data ( cellar_count, fields ) ;
	if ( cellar_count )
	{
		for ( new i = 0 ; i < cellar_count ; i ++ )
		{
			cellar_info [ i ] [ cl_id ] = cache_get_field_content_int ( i, "cl_id", sql_connection ) ;
			cellar_info [ i ] [ cl_owner ] = cache_get_field_content_int ( i, "cl_owner", sql_connection ) ;
			cache_get_field_content ( i, "u_name", cellar_info [ i ] [ cl_owner_name ], sql_connection, MAX_PLAYER_NAME ) ;

			cellar_info [ i ] [ cl_pos ] [ 0 ] = cache_get_field_content_float ( i,"cl_pos_x", sql_connection ) ;
			cellar_info [ i ] [ cl_pos ] [ 1 ] = cache_get_field_content_float ( i,"cl_pos_y", sql_connection ) ;
			cellar_info [ i ] [ cl_pos ] [ 2 ] = cache_get_field_content_float ( i,"cl_pos_z", sql_connection ) ;
			cellar_info [ i ] [ cl_pos ] [ 3 ] = cache_get_field_content_float ( i,"cl_pos_c", sql_connection ) ;

			cellar_info [ i ] [ cl_price ] = cache_get_field_content_int ( i, "cl_price", sql_connection ) ;
			cellar_info [ i ] [ cl_closed ] = cache_get_field_content_int ( i, "cl_closed", sql_connection ) ;

			new sscanf_delimit [ 48 ] ;
			cache_get_field_content ( i, "cl_improve", sscanf_delimit, sql_connection, 48 ) ;
			sscanf ( sscanf_delimit, "p<|>dddd", cellar_info [ i ] [ cl_improve ] [ 0 ], cellar_info [ i ] [ cl_improve ] [ 1 ], cellar_info [ i ] [ cl_improve ] [ 2 ],
			cellar_info [ i ] [ cl_improve ] [ 3 ] ) ;

			cache_get_field_content ( i, "cl_safe_data", sscanf_delimit, sql_connection, 36 ) ;
			sscanf ( sscanf_delimit, "p<|>dddddddd", cellar_info [ i ] [ cl_safe_data ] [ 0 ], cellar_info [ i ] [ cl_safe_data ] [ 1 ],
			cellar_info [ i ] [ cl_safe_guns ] [ 0 ],	cellar_info [ i ] [ cl_safe_guns ] [ 1 ], cellar_info [ i ] [ cl_safe_guns ] [ 2 ],
			cellar_info [ i ] [ cl_safe_guns ] [ 3 ],	cellar_info [ i ] [ cl_safe_guns ] [ 4 ], cellar_info [ i ] [ cl_safe_guns ] [ 5 ] ) ;

			cellar_info [ i ] [ cl_seed ] = cache_get_field_content_int ( i, "cl_seed", sql_connection ) ;
			cellar_info [ i ] [ cl_seed_result ] = cache_get_field_content_int ( i, "cl_seed_result", sql_connection ) ;

			cellar_info [ i ] [ cl_sell_status ] = cache_get_field_content_int ( i, "cl_sell_status", sql_connection ) ;
			cellar_info [ i ] [ cl_meeting ] = cache_get_field_content_int ( i, "cl_meeting", sql_connection ) ;
			cellar_info [ i ] [ cl_upgrade_craft ] = cache_get_field_content_int ( i, "cl_upgrade_craft", sql_connection ) ;

			cellar_info [ i ] [ cl_pickup ] = CreateDynamicPickup ( 1239, 23, cellar_info [ i ] [ cl_pos ] [ 0 ], cellar_info [ i ] [ cl_pos ] [ 1 ], cellar_info [ i ] [ cl_pos ] [ 2 ], 0, -1 ) ;

			pick_info [ cellar_info [ i ] [ cl_pickup ] ] [ pick_type ] = pick_type_clentrance ;
			pick_info [ cellar_info [ i ] [ cl_pickup ] ] [ pick_item ] = cellar_info [ i ] [ cl_id ] ;

			cellar_info [ i ] [ cl_area ] = CreateDynamicSphere ( cellar_info [ i ] [ cl_pos ] [ 0 ], cellar_info [ i ] [ cl_pos ] [ 1 ], cellar_info [ i ] [ cl_pos ] [ 2 ], 3.0, -1, -1, -1 ) ;
			area_info [ cellar_info [ i ] [ cl_area ] ] [ a_type ] = area_type_cellargarage ;
		    area_info [ cellar_info [ i ] [ cl_area ] ] [ a_item ] = cellar_info [ i ] [ cl_id ] ;

			new label_string [ 110 + 9 ] ;
			format ( label_string, sizeof ( label_string  ), "** Гараж **\n{"#cGR3D"}Номер гаража: {"#cWH3D"}%d\n\n{"#cWH3D"}Посигнальте{"#cGR3D"}, чтобы заехать", cellar_info [ i ] [ cl_id ] ) ;
			cellar_info [ i ] [ cl_label ] = CreateDynamic3DTextLabel ( label_string, col_header_3d, cellar_info [ i ] [ cl_pos ] [ 0 ], cellar_info [ i ] [ cl_pos ] [ 1 ], cellar_info [ i ] [ cl_pos ] [ 2 ] + 0.7, 4.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0 ) ;
		}
    }
	printf ( "[SERVER] Загружено %d гаражей. (%d ms)", cellar_count, GetTickCount ( ) - time ) ;
	return 1 ;
}

callback: areas_loading ( )
{
	new fields, time = GetTickCount ( ) ;
	cache_get_data ( area_tp_amount, fields ) ;
	if ( area_tp_amount )
	{
       	for ( new t = 0 ; t < area_tp_amount ; t ++ )
        {
			area_tp_info [ t ] [ a_id ] = cache_get_field_content_int ( t, "area_id", sql_connection ) ;

			area_tp_info [ t ] [ a_pick ] = cache_get_field_content_int ( t, "area_pickup", sql_connection ) ;

			area_tp_info [ t ] [ a_pos ] [ 0 ] = cache_get_field_content_float ( t, "area_x", sql_connection ) ;
			area_tp_info [ t ] [ a_pos ] [ 1 ] = cache_get_field_content_float ( t, "area_y", sql_connection ) ;
			area_tp_info [ t ] [ a_pos ] [ 2 ] = cache_get_field_content_float ( t, "area_z", sql_connection ) ;
			area_tp_info [ t ] [ a_pos ] [ 3 ] = cache_get_field_content_float ( t, "area_c", sql_connection ) ;
			area_tp_info [ t ] [ a_to_pos ] [ 0 ] = cache_get_field_content_float ( t, "area_to_x", sql_connection ) ;
			area_tp_info [ t ] [ a_to_pos ] [ 1 ] = cache_get_field_content_float ( t, "area_to_y", sql_connection ) ;
			area_tp_info [ t ] [ a_to_pos ] [ 2 ] = cache_get_field_content_float ( t, "area_to_z", sql_connection ) ;
			area_tp_info [ t ] [ a_to_pos ] [ 3 ] = cache_get_field_content_float ( t, "area_to_c", sql_connection ) ;

			area_tp_info [ t ] [ a_virt_world ] [ 0 ] = cache_get_field_content_int ( t, "area_virtual_world", sql_connection ) ;
			area_tp_info [ t ] [ a_virt_world ] [ 1 ] = cache_get_field_content_int ( t, "area_to_virtual_world", sql_connection ) ;
			area_tp_info [ t ] [ a_interior ] [ 0 ] = cache_get_field_content_int ( t, "area_interior", sql_connection ) ;
			area_tp_info [ t ] [ a_interior ] [ 1 ] = cache_get_field_content_int ( t, "area_to_interior", sql_connection ) ;

			cache_get_field_content ( t, "area_name", area_tp_info [ t ] [ a_name ], sql_connection, 32 ) ;

			area_tp_info [ t ] [ a_3d_valid ] = cache_get_field_content_int ( t, "area_3d_valid", sql_connection ) ;
			cache_get_field_content ( t, "area_text_3d", area_tp_info [ t ] [ a_text_3d ], sql_connection, 128 ) ;

			if ( area_tp_info [ t ] [ a_3d_valid ] )
			{
				new scm_string [ 144 ] ;
				format ( scm_string, sizeof scm_string, "%s", area_tp_info [ t ] [ a_text_3d ] ) ;
			    area_tp_info [ t ] [ a_text ] = CreateDynamic3DTextLabel ( scm_string, col_header_3d, area_tp_info [ t ] [ a_pos ] [ 0 ], area_tp_info [ t ] [ a_pos ] [ 1 ], area_tp_info [ t ] [ a_pos ] [ 2 ] + 0.5, 5.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, area_tp_info [ t ] [ a_virt_world ] [ 0 ], area_tp_info [ t ] [ a_interior ] [ 0 ] );
			}

            area_tp_info [ t ] [ a_area ] [ 0 ] = CreateDynamicPickup ( area_tp_info [ t ] [ a_pick ], 23, area_tp_info [ t ] [ a_pos ] [ 0 ], area_tp_info [ t ] [ a_pos ] [ 1 ], area_tp_info [ t ] [ a_pos ] [ 2 ], area_tp_info [ t ] [ a_virt_world ] [ 0 ], area_tp_info [ t ] [ a_interior ] [ 0 ] ) ;
			pick_info [ area_tp_info [ t ] [ a_area ] [ 0 ] ] [ pick_type ] = pick_type_teleportation ;
			pick_info [ area_tp_info [ t ] [ a_area ] [ 0 ] ] [ pick_item ] = t + 1 ;

			if ( area_tp_info [ t ] [ a_to_pos ] [ 0 ] == 0 ) continue ;
			area_tp_info [ t ] [ a_area ] [ 1 ] = CreateDynamicPickup ( area_tp_info [ t ] [ a_pick ], 23, area_tp_info [ t ] [ a_to_pos ] [ 0 ], area_tp_info [ t ] [ a_to_pos ] [ 1 ], area_tp_info [ t ] [ a_to_pos ] [ 2 ], area_tp_info [ t ] [ a_virt_world ] [ 1 ], area_tp_info [ t ] [ a_interior ] [ 1 ] ) ;

			pick_info [ area_tp_info [ t ] [ a_area ] [ 1 ] ] [ pick_type ] = pick_type_teleportation ;
			pick_info [ area_tp_info [ t ] [ a_area ] [ 1 ] ] [ pick_item ] = t + 1 ;
	 	}
		printf ( "[SERVER] Загружено %d телепортов. (%d ms)", area_tp_amount, GetTickCount ( ) - time ) ;
    }
	else print ( "[SERVER] Телепорты не были найдены в базе данных." ) ;

	/*

			factory

	*/

	for ( new i = 0 ; i < MAX_GUNWORK_TABLE ; i ++ )
	{
		table_area [ i ] = CreateDynamicSphere ( table_areas_pos [ i ] [ 0 ], table_areas_pos [ i ] [ 1 ], table_areas_pos [ i ] [ 2 ], 1.0 ) ;
		area_info [ table_area [ i ] ] [ a_type ] = area_type_factory_table ;
		area_info [ table_area [ i ] ] [ a_item ] = i ;
		table_area_toggled [ i ] = INVALID_PLAYER_ID ;
	}

    CreateDynamic3DTextLabel ( "** Склад завода **", col_header_3d, factory_box_unload [ 0 ], factory_box_unload [ 1 ], factory_box_unload [ 2 ], 5.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, -1, -1 ) ;
	CreateDynamic3DTextLabel ( "** Заготовки **", col_header_3d, factory_box_position [ 0 ], factory_box_position [ 1 ], factory_box_position [ 2 ], 5.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, -1, -1 ) ;

	factory_take_area = CreateDynamicSphere ( factory_take_position [ 0 ], factory_take_position [ 1 ], factory_take_position [ 2 ], 1.0 ) ;
	area_info [ factory_take_area ] [ a_type ] = area_type_job_factory ;

	CreateDynamicPickup ( 2359, 1, factory_pickup_boxes [ 0 ], factory_pickup_boxes [ 1 ], factory_pickup_boxes [ 2 ] ) ;
	return 1 ;
}

callback: businesses_price_loading ( )
{
	new fields, rows, time = GetTickCount ( ) ;
	cache_get_data ( rows, fields ) ;

	for ( new i = 0 ; i < b_count ; i ++ )
	{
	    for ( new t = 0 ; t < MAX_PRICE_MARKET ; t ++ ) b_price_market [ i ] [ t ] = -1 ;
	}

	if ( rows )
	{
	    for ( new t = 0 ; t < rows ; t ++ )
	    {
	       	b_price_market [ t ] [ 0 ] = cache_get_field_content_int ( t, "b_shop_0", sql_connection ) ;
	       	b_price_market [ t ] [ 1 ] = cache_get_field_content_int ( t, "b_shop_1", sql_connection ) ;
	       	b_price_market [ t ] [ 2 ] = cache_get_field_content_int ( t, "b_shop_2", sql_connection ) ;
	       	b_price_market [ t ] [ 3 ] = cache_get_field_content_int ( t, "b_shop_3", sql_connection ) ;
	       	b_price_market [ t ] [ 4 ] = cache_get_field_content_int ( t, "b_shop_4", sql_connection ) ;
	       	b_price_market [ t ] [ 5 ] = cache_get_field_content_int ( t, "b_shop_5", sql_connection ) ;
	       	b_price_market [ t ] [ 6 ] = cache_get_field_content_int ( t, "b_shop_6", sql_connection ) ;
	       	b_price_market [ t ] [ 7 ] = cache_get_field_content_int ( t, "b_shop_7", sql_connection ) ;
	       	b_price_market [ t ] [ 8 ] = cache_get_field_content_int ( t, "b_shop_8", sql_connection ) ;
	       	b_price_market [ t ] [ 9 ] = cache_get_field_content_int ( t, "b_shop_9", sql_connection ) ;
	       	b_price_market [ t ] [ 10 ] = cache_get_field_content_int ( t, "b_shop_10", sql_connection ) ;
	       	b_price_market [ t ] [ 11 ] = cache_get_field_content_int ( t, "b_shop_11", sql_connection ) ;
	       	b_price_market [ t ] [ 12 ] = cache_get_field_content_int ( t, "b_shop_12", sql_connection ) ;
	       	b_price_market [ t ] [ 13 ] = cache_get_field_content_int ( t, "b_shop_13", sql_connection ) ;
	       	b_price_market [ t ] [ 14 ] = cache_get_field_content_int ( t, "b_shop_14", sql_connection ) ;
	       	b_price_market [ t ] [ 15 ] = cache_get_field_content_int ( t, "b_shop_15", sql_connection ) ;
	       	b_price_market [ t ] [ 16 ] = cache_get_field_content_int ( t, "b_shop_16", sql_connection ) ;
	       	b_price_market [ t ] [ 17 ] = cache_get_field_content_int ( t, "b_shop_17", sql_connection ) ;
	    }
	}

	new query_string [ 100 ] ;
	for ( new i = 0 ; i < b_count ; i ++ )
    {
        if ( b_info [ i ] [ b_type ] == bizz_type_gas )
        {
            if ( b_price_market [ i ] [ 0 ] > 1000 )
			{
				b_price_market [ i ] [ 0 ] = 1000 ;

			   	format ( query_string, sizeof query_string, "UPDATE `businesses_price` SET `b_shop_%d` = '%d' WHERE `b_id` = '%d' LIMIT 1",
			   	0, b_price_market [ i ] [ 0 ], b_info [ i ] [ b_id ] ) ;
			   	mysql_tquery ( sql_connection, query_string ) ;
			}
            if ( b_price_market [ i ] [ 1 ] > 1000 )
			{
				b_price_market [ i ] [ 1 ] = 1000 ;

			   	format ( query_string, sizeof query_string, "UPDATE `businesses_price` SET `b_shop_%d` = '%d' WHERE `b_id` = '%d' LIMIT 1",
			   	0, b_price_market [ i ] [ 0 ], b_info [ i ] [ b_id ] ) ;
			   	mysql_tquery ( sql_connection, query_string ) ;
			}
            if ( b_price_market [ i ] [ 2 ] > 1000 )
			{
				b_price_market [ i ] [ 2 ] = 1000 ;

			   	format ( query_string, sizeof query_string, "UPDATE `businesses_price` SET `b_shop_%d` = '%d' WHERE `b_id` = '%d' LIMIT 1",
			   	0, b_price_market [ i ] [ 0 ], b_info [ i ] [ b_id ] ) ;
			   	mysql_tquery ( sql_connection, query_string ) ;
			}
            if ( b_price_market [ i ] [ 3 ] > 1000 )
			{
				b_price_market [ i ] [ 3 ] = 1000 ;

			   	format ( query_string, sizeof query_string, "UPDATE `businesses_price` SET `b_shop_%d` = '%d' WHERE `b_id` = '%d' LIMIT 1",
			   	0, b_price_market [ i ] [ 0 ], b_info [ i ] [ b_id ] ) ;
			   	mysql_tquery ( sql_connection, query_string ) ;
			}
            if ( b_price_market [ i ] [ 4 ] > 1000 )
			{
				b_price_market [ i ] [ 4 ] = 1000 ;

			   	format ( query_string, sizeof query_string, "UPDATE `businesses_price` SET `b_shop_%d` = '%d' WHERE `b_id` = '%d' LIMIT 1",
			   	0, b_price_market [ i ] [ 0 ], b_info [ i ] [ b_id ] ) ;
			   	mysql_tquery ( sql_connection, query_string ) ;
			}
        }
        else if ( b_info [ i ] [ b_type ] == bizz_type_bank )
        {
            if ( b_price_market [ i ] [ 0 ] > 10 )
			{
				b_price_market [ i ] [ 0 ] = 10 ;

			   	format ( query_string, sizeof query_string, "UPDATE `businesses_price` SET `b_shop_%d` = '%d' WHERE `b_id` = '%d' LIMIT 1",
			   	0, b_price_market [ i ] [ 0 ], b_info [ i ] [ b_id ] ) ;
			   	mysql_tquery ( sql_connection, query_string ) ;
			}
            if ( b_price_market [ i ] [ 1 ] > 10 )
			{
				b_price_market [ i ] [ 1 ] = 10 ;

			   	format ( query_string, sizeof query_string, "UPDATE `businesses_price` SET `b_shop_%d` = '%d' WHERE `b_id` = '%d' LIMIT 1",
			   	1, b_price_market [ i ] [ 0 ], b_info [ i ] [ b_id ] ) ;
			   	mysql_tquery ( sql_connection, query_string ) ;
			}
        }
        else if ( b_info [ i ] [ b_type ] == bizz_type_hotel )
        {
            if ( b_price_market [ i ] [ 0 ] > 1000 )
			{
				b_price_market [ i ] [ 0 ] = 1000 ;

			   	format ( query_string, sizeof query_string, "UPDATE `businesses_price` SET `b_shop_%d` = '%d' WHERE `b_id` = '%d' LIMIT 1",
			   	0, b_price_market [ i ] [ 0 ], b_info [ i ] [ b_id ] ) ;
			   	mysql_tquery ( sql_connection, query_string ) ;
			}
        }
        else if ( b_info [ i ] [ b_type ] == bizz_type_ammo )
        {
            /*for ( new a = 0 ; a < MAX_AMMO_IN_SHOP ; a ++ )
            {
            	if ( b_price_market [ i ] [ a ] < b_gun_shop [ a ] [ bs_min_price ] || b_price_market [ i ] [ a ] > b_gun_shop [ a ] [ bs_min_price ] * 10 )
				{
					b_price_market [ i ] [ a ] = b_gun_shop [ a ] [ bs_min_price ] ;

				   	format ( query_string, sizeof query_string, "UPDATE `businesses_price` SET `b_shop_%d` = '%d' WHERE `b_id` = '%d' LIMIT 1",
				   	a, b_price_market [ i ] [ a ], b_info [ i ] [ b_id ] ) ;
				   	mysql_tquery ( sql_connection, query_string ) ;
				}
			}*/
		}
        else if ( b_info [ i ] [ b_type ] == bizz_type_carshop )
        {
            if ( b_price_market [ i ] [ 1 ] > 10 )
			{
				b_price_market [ i ] [ 1 ] = 10 ;

			   	format ( query_string, sizeof query_string, "UPDATE `businesses_price` SET `b_shop_%d` = '%d' WHERE `b_id` = '%d' LIMIT 1",
			   	1, b_price_market [ i ] [ 1 ], b_info [ i ] [ b_id ] ) ;
			   	mysql_tquery ( sql_connection, query_string ) ;
			}

			if ( b_price_market [ i ] [ 2 ] > 10 )
			{
				b_price_market [ i ] [ 2 ] = 10 ;

			   	format ( query_string, sizeof query_string, "UPDATE `businesses_price` SET `b_shop_%d` = '%d' WHERE `b_id` = '%d' LIMIT 1",
			   	2, b_price_market [ i ] [ 2 ], b_info [ i ] [ b_id ] ) ;
			   	mysql_tquery ( sql_connection, query_string ) ;
			}
		}

        if ( b_price_market [ i ] [ 0 ] != -1 ) continue ;

		format ( query_string, sizeof query_string, "INSERT INTO `businesses_price` (`b_id`,`b_type`) VALUES ('%d','%d')", b_info [ i ] [ b_id ], b_info [ i ] [ b_type ] ) ;
		mysql_query ( sql_connection, query_string, false ) ;
    }

	printf ( "[SERVER] Загружено цен для %d бизнесов. (%d ms)", rows, GetTickCount ( ) - time ) ;
	return 1 ;
}

stock create_veh_casino ( _vehicle_model, _casino_id )
{
	if ( IsValidVehicle ( b_info [ _casino_id - 1 ] [ b_car_id ] ) ) DestroyVehicle ( b_info [ _casino_id - 1 ] [ b_car_id ], 73 ) ;
    b_info [ _casino_id - 1 ] [ b_car_id ] = INVALID_VEHICLE_ID ;

    b_info [ _casino_id - 1 ] [ b_car_id ] = AddStaticVehicle ( _vehicle_model, -1673.3190, -326.3890, 1201.8909, 144.5219, 6, 1 ) ;

    new _vehicleid = b_info [ _casino_id - 1 ] [ b_car_id ] ;
	SetVehicleVirtualWorld ( _vehicleid, b_info [ _casino_id - 1 ] [ b_id ] + 1000 ) ;
	LinkVehicleToInterior ( _vehicleid, 10 ) ;

	veh_info [ _vehicleid - 1 ] [ v_pos ] [ 0 ] = -1673.3190 ;
	veh_info [ _vehicleid - 1 ] [ v_pos ] [ 1 ] = -326.3890 ;
	veh_info [ _vehicleid - 1 ] [ v_pos ] [ 2 ] = 1201.8909 ;
	veh_info [ _vehicleid - 1 ] [ v_pos ] [ 3 ] = 144.5219 ;

	new engine, lights, alarm, doors, bonnet, boot, objective ;
	veh_info [ _vehicleid - 1 ] [ v_locked ] = true ;
	GetVehicleParamsEx ( _vehicleid, engine, lights, alarm, doors, bonnet, boot, objective ) ;
	SetVehicleParamsEx ( _vehicleid, engine, lights, alarm, true, bonnet, boot, objective ) ;
	return 1 ;
}

callback: businesses_loading ( )
{
	new fields, time = GetTickCount ( ) ;
	cache_get_data ( b_count, fields ) ;
	if ( b_count )
	{
	    new bank_door_id = 0, _carm_id = 0, _b_id ;
        for ( new t = 0 ; t < b_count ; t ++ )
        {
			_b_id = cache_get_field_content_int ( t, "b_id", sql_connection ) ;

			if ( b_info [ t ] [ b_id ] == _b_id ) continue ;
			else b_info [ t ] [ b_id ] = _b_id ;

			b_info [ t ] [ b_owner_inc ] = cache_get_field_content_int ( t, "b_owner_inc", sql_connection ) ;

			cache_get_field_content ( t, "b_owner_name", b_info [ t ] [ b_owner_name ] , sql_connection, 32 ) ;
			cache_get_field_content ( t, "b_name", b_info [ t ] [ b_name ] , sql_connection, 32 ) ;

			b_info [ t ] [ b_position ] [ 0 ] = cache_get_field_content_float ( t, "b_pos_x", sql_connection ) ;
			b_info [ t ] [ b_position ] [ 1 ] = cache_get_field_content_float ( t, "b_pos_y", sql_connection ) ;
			b_info [ t ] [ b_position ] [ 2 ] = cache_get_field_content_float ( t, "b_pos_z", sql_connection ) ;
			b_info [ t ] [ b_position ] [ 3 ] = cache_get_field_content_float ( t, "b_pos_c", sql_connection ) ;

			b_info [ t ] [ b_int ] = cache_get_field_content_int ( t, "b_int", sql_connection ) ;

			b_info [ t ] [ b_money ] = cache_get_field_content_int ( t, "b_money", sql_connection ) ;

			b_info [ t ] [ b_close ] = cache_get_field_content_int ( t, "b_close", sql_connection ) ;
			b_info [ t ] [ b_price ] = cache_get_field_content_int ( t, "b_price", sql_connection ) ;
			b_info [ t ] [ b_donate_price ] = cache_get_field_content_int ( t, "b_donate_price", sql_connection ) ;
			b_info [ t ] [ b_product ] = cache_get_field_content_int ( t, "b_product", sql_connection ) ;
			b_info [ t ] [ b_product_price ] = cache_get_field_content_int ( t, "b_product_price", sql_connection ) ;
			b_info [ t ] [ b_type ] = cache_get_field_content_int ( t, "b_type", sql_connection ) ;
			Iter_Add(business_types[b_info [ t ] [ b_type ]], b_info [ t ] [ b_id ] ) ;

			b_info [ t ] [ b_fee ] = cache_get_field_content_int ( t, "b_fee", sql_connection ) ;
			b_info [ t ] [ b_maxproduct ] = cache_get_field_content_int ( t, "b_maxproduct", sql_connection ) ;

 			b_info [ t ] [ b_cost ] = cache_get_field_content_int ( t, "b_cost", sql_connection ) ;

			b_info [ t ] [ b_mafia ] = cache_get_field_content_int ( t, "b_mafia", sql_connection ) ;

			new sscanf_delimit [ 36 ] ;
			cache_get_field_content ( t, "b_improve", sscanf_delimit, sql_connection, 36 ) ;
			sscanf ( sscanf_delimit, "p<|>dddd", b_info [ t ] [ b_improve ] [ 0 ], b_info [ t ] [ b_improve ] [ 1 ], b_info [ t ] [ b_improve ] [ 2 ], b_info [ t ] [ b_improve ] [ 3 ] ) ;

			b_info [ t ] [ b_procurement ] [ 0 ] = cache_get_field_content_float ( t, "b_procurement_x", sql_connection ) ;
			b_info [ t ] [ b_procurement ] [ 1 ] = cache_get_field_content_float ( t, "b_procurement_y", sql_connection ) ;
			b_info [ t ] [ b_procurement ] [ 2 ] = cache_get_field_content_float ( t, "b_procurement_z", sql_connection ) ;

			b_info [ t ] [ b_repair ] [ 0 ] = cache_get_field_content_float ( t, "b_repair_x", sql_connection ) ;
			b_info [ t ] [ b_repair ] [ 1 ] = cache_get_field_content_float ( t, "b_repair_y", sql_connection ) ;
			b_info [ t ] [ b_repair ] [ 2 ] = cache_get_field_content_float ( t, "b_repair_z", sql_connection ) ;
			b_info [ t ] [ b_repair ] [ 3 ] = cache_get_field_content_float ( t, "b_repair_a", sql_connection ) ;

