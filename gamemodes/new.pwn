CMD:dir ( playerid )
{
	if ( GetInventoryFindItem ( playerid, SUB_INVENTORY, 2163 ) < 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет справочника, приобретите его в 24/7." ) ;
	show_direction ( playerid ) ;
	return true ;
}

stock show_direction ( playerid )
{
    show_dialog ( playerid, d_direction, DIALOG_STYLE_LIST, "{"#cBHD"}Справочник", "{"#cBL"}1.{"#cWH"} Лидеры\n{"#cBL"}2.{"#cWH"} Механики\n{"#cBL"}3.{"#cWH"} Таксисты\n{"#cBL"}4.{"#cWH"} Репортеры\n{"#cBL"}5.{"#cWH"} Лицензеры\n{"#cBL"}6.{"#cWH"} Адвокаты\n{"#cBL"}7.{"#cWH"} Развозчики\n{"#cBL"}8.{"#cWH"} Сотрудники больницы", "Далее", "Отмена" ) ;
	return 1 ;
}

CMD:leaders ( playerid )
{
	global_string [ 0 ] = EOS ;
	new leaders_count = 0, fraction_id = -1,
		line_string [ 128 ],
		afk_text [ 36 ], text [ 20 ] ;
	for ( new f = 0 ; f < max_fraction - 1 ; f ++ )
	{
		foreach(new i: fraction_players[f + 1])
		{
			if ( ! p_info [ i ] [ member ] || admin_info [ i ] [ admin ] ) continue ;
			if ( ( p_info [ i ] [ rank ] < f_info [ p_info [ i ] [ member ] - 1 ] [ f_rank_settings ] [ 0 ] - 1 ) && ( p_info [ i ] [ member ] != 11 || p_info [ i ] [ rank ] < 6 ) ) continue ;

			if ( pl_afk_time [ i ] > 2 ) format ( afk_text, 36, " {FFB859}[AFK: %s]{"#cWH"}", convert_time ( pl_afk_time [ i ], TYPE_TIME_SECOND ) ) ;
			else format ( afk_text, 36, "" ) ;

			if ( p_info [ i ] [ number ] == 0 ) format ( text, sizeof ( text ), "None" ) ;
			else format ( text, sizeof ( text ), "%i", p_info [ i ] [ number ] ) ;

			if ( fraction_id != f )
			{
			    if ( ! leaders_count )
			    {
					format ( line_string, sizeof line_string, "{"#cLY"}%s:\n", f_info [ f ] [ f_name ] ) ;
					strcat ( global_string, line_string ) ;
				}
				else
				{
				    format ( line_string, sizeof line_string, "\n{"#cLY"}%s:\n", f_info [ f ] [ f_name ] ) ;
					strcat ( global_string, line_string ) ;
				}
			}

			format ( line_string, sizeof line_string, "{"#cWH"}%s%s - т. %s {"#cGRDialog"}(%s)\n", p_info [ i ] [ name ], afk_text, text, f_rank [ f ] [ p_info [ i ] [ rank ] - 1 ] ) ;
			strcat ( global_string, line_string ) ;

			fraction_id = f ;
			leaders_count ++ ;
		}
	}
	if ( leaders_count )
	{
		new header_string [ 64 ] ;
		format ( header_string, sizeof header_string, "{"#cBHD"}Лидеры онлайн ({"#cWH"}%d {"#cBHD"}чел.)", leaders_count ) ;
		show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, header_string, global_string, "Закрыть", "" ) ;
	}
	else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}В сети нет ни одного лидера." ) ;
	return 1 ;
}

CMD:fstyle ( playerid )
{
	global_string [ 0 ] = EOS ;

	new StatsLevel [ 3 ] [ 32 ], _stats_1 = p_info [ playerid ] [ stats ] [ 1 ], _stats_2 = p_info [ playerid ] [ stats ] [ 2 ] ;
	if ( _stats_1 <= 10 ) StatsLevel [ 1 ] = "{FF4500}Очень плохая{FFFFFF}" ;
	else if ( _stats_1 <= 30 ) StatsLevel [ 1 ] = "{FF8C00}Плохая{FFFFFF}" ;
	else if ( _stats_1 <= 70 ) StatsLevel [ 1 ] = "{FFD00F}Нормальная{FFFFFF}" ;
	else if ( _stats_1 <= 90 ) StatsLevel [ 1 ] = "{ADFF2F}Хорошая{FFFFFF}" ;
	else StatsLevel [ 1 ] = "{008000}Очень хорошая{FFFFFF}" ;

	if ( _stats_2 <= 10 ) StatsLevel [ 2 ] = "{FF4500}Очень маленькая{FFFFFF}" ;
	else if ( _stats_2 <= 30 ) StatsLevel [ 2 ] = "{FF8C00}Маленькая{FFFFFF}" ;
	else if ( _stats_2 <= 70 ) StatsLevel [ 2 ] = "{FFD00F}Нормальная{FFFFFF}" ;
	else if ( _stats_2 <= 90 ) StatsLevel [ 2 ] = "{ADFF2F}Большая{FFFFFF}" ;
	else StatsLevel [ 2 ] = "{008000}Очень большая{FFFFFF}" ;

	format ( global_string, 512, "{"#cWH"}Навыки {"#cOR"}бокса:\t{"#cGN"}%d / 1000\n\
									Навыки {"#cOR"}кунг-фу:\t{"#cGN"}%d / 1000\n\
									{"#cWH"}Сила:\t{"#cGN"}%d {"#cWH"}[%s]\n\
									Выносливость:\t{"#cGN"}%d {"#cWH"}[%s]\n\
									Сила удара:\t{"#cRD"}%.2f {"#cWH"}HP / удар\n\
									Сила удара {"#cOR"}кулаком:\t{"#cRD"}%.2f {"#cWH"}HP / удар\n\
									Сила удара {"#cOR"}битой:\t\t\t{"#cRD"}%.2f {"#cWH"}HP / удар\n\
									{"#cGRDialog"}* Прокачивая, стили начнут комбинироваться.\n\
									{"#cGRDialog"}* Прокачав оба стиля удары будут чередоваться.",
	p_info [ playerid ] [ u_style ] [ 0 ], p_info [ playerid ] [ u_style ] [ 1 ],
	_stats_2, StatsLevel [ 2 ],
	_stats_2, StatsLevel [ 1 ],
	_stats_2 * 0.05,
	( _stats_2 * 0.05 ) + 1.0,
	( _stats_2 * 0.05 ) + 5.0 ) ;
	show_dialog ( playerid, d_fstyle, DIALOG_STYLE_TABLIST, "{"#cBHD"}Стиль боя", global_string, "Обнулить", "Закрыть" ) ;
	return 1;
}

CMD:quitjob ( playerid )
{
	if ( p_info [ playerid ] [ job ] == 0 && p_info [ playerid ] [ b_worker ] == -1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не трудоустроены на постоянную работу." ) ;
	if ( player_rentcar [ playerid ] != INVALID_VEHICLE_ID )
	{
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не завершили работу на предыдущем рабочем месте." ) ;
		SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Возможно Вы не отменили аренду рабочего транспорта, используйте: {"#cBL"}\"/stoprent\"{"#cGRInfo"}." ) ;
		return 1 ;
	}
	if ( p_info [ playerid ] [ b_worker ] != -1 )
	{
	    Iter_Remove ( business_players[p_info[playerid][b_worker]], playerid ) ;

	    p_info [ playerid ] [ b_worker ] = -1 ;
		p_info [ playerid ] [ business_rang ] = 0 ;

		new scm_string [ 93 + 9 ] ;
		format ( scm_string, sizeof scm_string, "UPDATE `users` SET `u_bworker` = '-1', `u_business_rang` = '0' WHERE `u_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
		mysql_tquery ( sql_connection, scm_string ) ;
	}
	if ( p_info [ playerid ] [ job ] != 0 )
	{
		p_info [ playerid ] [ job ] = 0 ;
		update_int_sql ( playerid, "u_job", 0 ) ;
	}
	SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы успешно уволились с прежнего места работы." ) ;
	return 1 ;
}

CMD:robbery ( playerid )
{
	if ( cop_player ( playerid ) || fbi_player ( playerid ) || army_player ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Нельзя грабить бизнес состоя в гос. организации." ) ;
	if ( ! gang_player ( playerid ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Доступно только для банд." ) ;
	if ( p_info [ playerid ] [ robbery_coldown ] > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы уже совершали ограбление." ) ;
	if ( ! GetPVarInt ( playerid, "p_biz_id" ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы должны находиться в бизнесе." ) ;
	if ( b_info [ GetPVarInt ( playerid, "p_biz_id" ) - 1 ] [ b_robbery ] > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Данный бизнес не так давно уже грабили." ) ;
    if ( b_info [ GetPVarInt ( playerid, "p_biz_id" ) - 1 ] [ b_cash_today ] < 100000 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}В бизнесе недостаточно дневной выручки." ) ;

	new _team_count = 1, _b_id = GetPVarInt ( playerid, "p_biz_id" ) ;
	foreach(new i: streamed_players[playerid])
	{
	    if ( ! gang_player ( i ) ) continue ;
	    if ( p_info [ i ] [ robbery_coldown ] > 0 ) continue ;
 		if ( IsPlayerInRangeOfPoint ( playerid, 20, p_t_info [ i ] [ p_pos ] [ 0 ], p_t_info [ i ] [ p_pos ] [ 1 ], p_t_info [ i ] [ p_pos ] [ 2 ] ) && GetPlayerVirtualWorld ( i ) == GetPlayerVirtualWorld ( playerid ) )
	    {
	        if ( p_info [ playerid ] [ member ] == p_info [ i ] [ member ] )
		    {
				_team_count ++ ;
				if ( _team_count == player_robbery ) break ;
		    }
		}
	}
	if ( _team_count < player_robbery )
	{
	    static const _str [ ] = "{"#cRInfo"}* {"#cGRInfo"}Для начала ограбления должно быть {"#cRD"}%d{"#cGRInfo"} человек(а) включая Вас." ;
	    new scm_string [ sizeof _str + 4 ] ;
	    format ( scm_string, sizeof scm_string, _str, player_robbery ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
		return 1 ;
	}

	_team_count = 0 ;
	foreach(new i: streamed_players[playerid])
	{
	    if ( ! gang_player ( i ) ) continue ;
	    if ( p_info [ i ] [ robbery_coldown ] > 0 ) continue ;
 		if ( IsPlayerInRangeOfPoint ( playerid, 20, p_t_info [ i ] [ p_pos ] [ 0 ], p_t_info [ i ] [ p_pos ] [ 1 ], p_t_info [ i ] [ p_pos ] [ 2 ] ) && GetPlayerVirtualWorld ( i ) == GetPlayerVirtualWorld ( playerid ) )
	    {
	        if ( p_info [ playerid ] [ member ] == p_info [ i ] [ member ] )
		    {
				_team_count ++ ;

				SendClientMessage ( i, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Ограбление началось. Ваша задача: не умереть и не покидать бизнес." ) ;
				SendClientMessage ( i, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Вы можете закончить ограбление раньше, просто покиньте бизнес." ) ;

				p_info [ i ] [ robbery_stop ] = 0 ;

                p_info [ i ] [ robbery_business ] = _b_id ;

				SetPlayerAttachedObject ( i, 1, 1550, 1,   0.160001, -0.234000, -0.009998, 1.100002, 95.899940, -17.500007  ) ;

				p_info [ i ] [ robbery_coldown ] = 3 ;
				update_int_sql ( i, "u_robbery_coldown", 3 ) ;

				if ( _team_count == player_robbery ) break ;
		    }
		}
	}
	SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Ограбление началось. Ваша задача: не умереть и не покидать бизнес." ) ;
	SendClientMessage ( playerid, col_gray, !"{"#cBInfo"}* {"#cGRInfo"}Вы можете закончить ограбление раньше, просто покиньте бизнес." ) ;

	p_info [ playerid ] [ robbery_stop ] = 0 ;

	SetPlayerAttachedObject ( playerid, 1, 1550, 1,   0.160001, -0.234000, -0.009998, 1.100002, 95.899940, -17.500007  ) ;

	p_info [ playerid ] [ robbery_coldown ] = 3 ;
	update_int_sql ( playerid, "u_robbery_coldown", 3 ) ;

	b_info [ _b_id - 1 ] [ b_robbery ] = 4 ;
	p_info [ playerid ] [ robbery_business ] = _b_id ;

	static const _str [ ] = "UPDATE `businesses` SET `b_robbery` = '%d' WHERE `b_id` = '%d' LIMIT 1" ;
	new _sql_string [ sizeof _str + 4 + 9 ] ;
	format ( _sql_string, sizeof _sql_string, _str, b_info [ _b_id - 1 ] [ b_robbery ], b_info [ _b_id - 1 ] [ b_id ] ) ;
	mysql_tquery ( sql_connection, _sql_string ) ;
	return 1 ;
}

stock clear_robbery ( playerid )
{
    RemovePlayerAttachedObject ( playerid, 1 ) ;

    p_info [ playerid ] [ robbery_money ] =
    p_info [ playerid ] [ robbery_stop ] =
    p_info [ playerid ] [ robbery_business ] = 0 ;

    DisablePlayerRaceCheckpoint ( playerid ) ;
	is_gps_used { playerid } = 0 ;
	return 1 ;
}

CMD:election ( playerid )
{
	if ( admin_info [ playerid ] [ admin ] < 6 ) return 1 ;
	show_dialog ( playerid, d_election, DIALOG_STYLE_LIST, "{"#cBHD"}Управление выборами | Статус", "{"#cBL"}1. {"#cWH"}Выборы закрыты\n{"#cBL"}2. {"#cWH"}Регистрация кандидатов\n{"#cBL"}3. {"#cWH"}Голосование\n{"#cBL"}4. {"#cWH"}Удалить кандидатов\n{"#cBL"}5. {"#cWH"}Удалить кандидата\n{"#cBL"}6. {"#cWH"}Возможность выдвижения", "Принять", "Закрыть" ) ;
	return 1 ;
}

stock show_vote ( playerid )
{
    show_dialog(playerid, d_vote, DIALOG_STYLE_LIST, "{"#cBHD"}Выборы", "{"#cBL"}1. {"#cWH"}Голосование\n{"#cBL"}2. {"#cWH"}Список кандидатов\n{"#cBL"}3. {"#cWH"}Подать кандидатуру [{"#cGN"}250.000"valute_title_"{"#cWH"}]", "Выбрать", "Закрыть");
	return 1 ;
}

