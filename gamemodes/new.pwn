            {
		        show_dialog ( playerid, d_mp_car, DIALOG_STYLE_INPUT, "{"#cBHD"}Выдача транспорта", "{"#cWH"}Укажите ID транспорта, которое хотите выдать игрокам:\n\n{"#cRD"}* Нельзя установить менее 400 и более 611", "Выбрать", "Отмена");
                return 1 ;
