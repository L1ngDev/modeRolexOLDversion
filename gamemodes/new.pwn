					show_dialog(playerid, d_tr_skin_1, DIALOG_STYLE_INPUT, "{"#cBHD"}Изменение конфигурации", global_string, "Выбрать", "Назад");
			    }
			    case 1:
			    {
			        new f = p_info [ playerid ] [ member ] - 1 ;

		            global_string [ 0 ] = EOS ;
					format(global_string, 450, "{"#cWH"}Вы собираетесь изменить следующую конфигурацию:\n\n\tОрганизация: {%s}%s\n\t{"#cWH"}Название: {"#cLY"}Одежда команды №2\n\t{"#cWH"}Текущее значение: {"#cLY"}%d\n\n{"#cGRDialog"}* Введите новое значение для данной конфигурации:", f_info [ f ] [ f_chat_color ], f_info [ f ] [ f_name ], f_info [ f ] [ f_tr_skin ] [ 1 ] );
					show_dialog(playerid, d_tr_skin_2, DIALOG_STYLE_INPUT, "{"#cBHD"}Изменение конфигурации", global_string, "Выбрать", "Назад");
			    }
