				    {
				        if ( h_info [ t ] [ h_owner ] == -1 ) _count_id ++ ;
				    }

					if ( _count_id == 0 ) podezd_info [ station_id ] [ p_icon ] = CreateDynamicMapIcon ( podezd_info [ station_id ] [ p_pos ] [ 0 ], podezd_info [ station_id ] [ p_pos ] [ 1 ], podezd_info [ station_id ] [ p_pos ] [ 2 ], 32, 0, 0, 0, -1 ) ;
					else podezd_info [ station_id ] [ p_icon ] = CreateDynamicMapIcon ( podezd_info [ station_id ] [ p_pos ] [ 0 ], podezd_info [ station_id ] [ p_pos ] [ 1 ], podezd_info [ station_id ] [ p_pos ] [ 2 ], 31, 0, 0, 0, -1 ) ;

