				        show_conf_ptd ( i, true ) ;
				    }
				}

				confiscation_time = SetTimerEx ( "confiscation_timer", 1000, true, "ii", p_info [ playerid ] [ member ], 23 ) ;

				new scm_string [ 128 ];
				format ( scm_string, sizeof ( scm_string  ), "{"#cBAdmin"}[A] {"#cGRAdmin"}Армия начала конфискацию у %s.", f_info [ 22 ] [ f_name ] ) ;
				foreach(new i: admin_players) SendClientMessage ( i, col_admin, scm_string ) ;

