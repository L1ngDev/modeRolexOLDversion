CMD:leave ( playerid )
{
	if ( ! p_info [ playerid ] [ enhancement ] [ 2 ] )
	{
	    if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "У Вас не приобретено улучшение 'Решительность'!\n/mm - Информация о персонаже - Улучшения персонажа.", 0, 3, CINFO_OTHER_ID, PICTURE_INFO_ERROR, "", "" ) ;
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас не приобретено улучшение {"#cWH"}'Решительность'{"#cGRInfo"}. (/mm - Информация о персонаже - Улучшения персонажа)") ;
		return 1 ;
	}
	if ( p_info [ playerid ] [ leader ] > 0 )
	{
	    if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Лидер не может уволиться из организации.", 0, 3, CINFO_OTHER_ID, PICTURE_INFO_ERROR, "", "" ) ;
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Лидер не может уволиться из организации." ) ;
		return 1 ;
	}
    if ( p_info [ playerid ] [ member ] < 1 )
    {
	    if ( player_device { playerid } == 2 ) send_check_cinfo ( playerid, "Вы не состоите в организации.", 0, 3, CINFO_OTHER_ID, PICTURE_INFO_ERROR, "", "" ) ;
		else SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не состоите в организации." ) ;
		return 1 ;
	}

    new fraction_id = p_info [ playerid ] [ member ] ;

	new _reason [ 32 ] = "ПСЖ" ;
	insert_joblist ( playerid, _reason, LABOR_TYPE_UNINVITE_LEAVE, p_info [ playerid ] [ rank ] ) ;

	new scm_string [ 156 ] ;

	f_info [ fraction_id - 1 ] [ f_members ] -- ;
	format ( scm_string, 128, "UPDATE `fractions` SET `f_members` = '%d' WHERE `f_id` = '%d' LIMIT 1", f_info [ fraction_id - 1 ] [ f_members ], fraction_id ) ;
	mysql_tquery ( sql_connection, scm_string ) ;

	if ( p_info [ playerid ] [ subleader ] )
	{
	    new _unit_id = p_info [ playerid ] [ subleader ] ;
		unit_info [ _unit_id - 1 ] [ u_members ] -- ;
		format ( scm_string, 128, "UPDATE `unit_settings` SET `unit_members` = '%d' WHERE `unit_id` = '%d' LIMIT 1", unit_info [ _unit_id - 1 ] [ u_members ], _unit_id ) ;
		mysql_tquery ( sql_connection, scm_string ) ;
	}

	if ( p_info [ playerid ] [ member ] != 0 ) Iter_Remove ( fraction_players[fraction_id], playerid ) ;

	if ( gov_player ( playerid ) )
	{
	    if ( p_info [ playerid ] [ rank ] == f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 6 ] ||
			p_info [ playerid ] [ rank ] == f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 7 ] ||
			p_info [ playerid ] [ rank ] == f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 8 ] ||
			p_info [ playerid ] [ rank ] == f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 12 ] )
		{
		    Iter_Remove ( fraction_ministry, playerid ) ;
		}
	}

	p_info [ playerid ] [ member ] =
	p_info [ playerid ] [ rank ] =
	p_info [ playerid ] [ org_skin ] =
	p_info [ playerid ] [ subleader ] =
	p_info [ playerid ] [ f_warning ] =
	p_info [ playerid ] [ warblock ] = 0 ;

	scm_string [ 0 ] = EOS ;
	format ( scm_string, sizeof scm_string, "DELETE FROM `fractions_players` WHERE `u_sql_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
	mysql_tquery ( sql_connection, scm_string ) ;

	if ( is_fraction_duty { playerid } ) is_fraction_duty { playerid } = 0 ;

	fraction_duty ( playerid ) ;
	SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы успешно уволились из организации!" ) ;
	return 1 ;
}

CMD:hleave ( playerid )
{
	if ( ! p_info [ playerid ] [ rent_house ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не снимаете жильё.") ;

	p_info [ playerid ] [ rent_house ] = 0 ;
	update_int_sql ( playerid, "u_renthouse", 0 ) ;

	SendClientMessage ( playerid, col_white, !"{"#cGInfo"}* {"#cWH"}Вы успешно выселились." ) ;
	return 1 ;
}

CMD:renthome ( playerid )
{
    if ( Iter_Count(player_houses[playerid]) > 0 || p_info [ playerid ] [ rent_house ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы снимаете жилье или у Вас уже есть дом.") ;

	for ( new h = 0 ; h < house_count ; h ++ )
	{
		if ( h_info [ h ] [ h_vw ] == GetPlayerVirtualWorld ( playerid ) && IsPlayerInRangeOfPoint ( playerid, 4, h_info [ h ] [ h_pos ] [ 0 ], h_info [ h ] [ h_pos ] [ 1 ], h_info [ h ] [ h_pos ] [ 2 ] ) )
		{
			if( ! h_info [ h ] [ h_rent_price ] || ! h_info [ h ] [ h_rent_status ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Аренда дома не доступна." ) ;

			if ( p_info [ playerid ] [ money ] < h_info [ h ] [ h_rent_price ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас недостаточно денег для аренды дома.") ;

			p_info [ playerid ] [ rent_house ] = h + 1 ;
			update_int_sql ( playerid, "u_renthouse", h + 1 ) ;

			static const _str [ ] = "{"#cGInfo"}* {"#cWH"}Вы успешно поселились в доме. Стоимость аренды дома в час: {"#cGN"}%d"valute_title"{"#cWH"}." ;
			new text_size [ sizeof _str + 9 ] ;
			format ( text_size, sizeof text_size, _str, h_info [ h ] [ h_rent_price ] ) ;
            SendClientMessage ( playerid, col_white, text_size ) ;
			return 1 ;
		}
	}
	return 1 ;
}

CMD:hrent ( playerid )
{
    if ( ! p_info [ playerid ] [ rent_house ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не снимаете жильё." ) ;

    show_dialog ( playerid, d_rent_house, DIALOG_STYLE_LIST, "{"#cBHD"}Взаимодействие с домом", "{"#cBL"}1. {"#cWH"}Гардероб\n{"#cBL"}2. {"#cWH"}Подвал", "Выбрать", "Назад" ) ;
	return 1 ;
}

CMD:paydaytest ( playerid )
{
	if ( admin_info [ playerid ] [ admin ] < 8 ) return 1 ;

	foreach(new i: logged_players)
	{
	    p_info [ i ] [ time_hour ] = GetTickCount ( ) + ( 60 * 21 ) ;
	}

	pay_day_time ( ) ;
	return 1 ;
}

CMD:fmute ( playerid, params [ ] )
{
	if ( ! p_info [ playerid ] [ member ] ) return 1 ;

	new fraction_id = p_info [ playerid ] [ member ] ;
	if ( p_info [ playerid ] [ rank ] <  f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 5 ] )
	{
	    static const _str [ ] = "{"#cRInfo"}* {"#cGRInfo"}Команда доступна с ранга %s (%d)." ;
	    new scm_string [ sizeof _str + 30 + 3 ] ;
	    format ( scm_string, sizeof scm_string, _str, f_rank [ fraction_id - 1 ] [ f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 5 ] - 1 ], f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 5 ] ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
		return 1 ;
	}

	if ( sscanf ( params, "uds[42]", params [ 0 ], params [ 1 ], params [ 2 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /fmute [ид] [минуты] [причина]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( p_info [ params [ 0 ] ] [ member ] != p_info [ playerid ] [ member ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не состоит в Вашей организации." ) ;
	if ( p_info [ params [ 0 ] ] [ rank ]  >= p_info [ playerid ] [ rank ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете дать затычку своему руководству." ) ;
	if ( params [ 1 ] < 1 || params [ 1 ] > 120 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Затычка не может быть меньше 1 минуты или больше 120 минут." ) ;

	new scm_string [ 144 ] ;
	if ( gang_player ( playerid ) || mafia_player ( playerid ) ) format ( scm_string, sizeof scm_string, "[F] %s %s поставил(а) затычку %s на %i мин. Причина: %s", f_rank [ fraction_id - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], params [ 1 ], params [ 2 ] ) ;
    else format ( scm_string, sizeof scm_string, "[R] %s %s поставил(а) затычку %s на %i мин. Причина: %s", f_rank [ fraction_id - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], params [ 1 ], params [ 2 ] ) ;
	fraction_message ( fraction_id, col_lblue, scm_string ) ;

    format ( scm_string, 128, "Поставил(а) затычку %s на %i мин. Причина: %s", p_info [ params [ 0 ] ] [ name ], params [ 1 ], params [ 2 ]);
	write_fraction ( playerid, fraction_id, TYPE_LOG_WARN, scm_string ) ;

	p_info [ params [ 0 ] ] [ f_mute ] = params [ 1 ] * 60 ;
	return 1;
}

CMD:funmute ( playerid, params [ ] )
{
	if ( p_info [ playerid ] [ member ] < 1 ) return 1 ;

    new fraction_id = p_info [ playerid ] [ member ] ;
	if ( p_info [ playerid ] [ rank ] <  f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 5 ] )
	{
	    static const _str [ ] = "{"#cRInfo"}* {"#cGRInfo"}Команда доступна с ранга %s (%d)." ;
	    new scm_string [ sizeof _str + 30 + 3 ] ;
	    format ( scm_string, sizeof scm_string, _str, f_rank [ fraction_id - 1 ] [ f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 5 ] - 1 ], f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 5 ] ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
		return 1 ;
	}
	if ( sscanf ( params, "u", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /funmute [ид]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( p_info [ params [ 0 ] ] [ member ] != fraction_id ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не состоит в Вашей организации." ) ;
	if ( p_info [ params [ 0 ] ] [ rank ]  >= p_info [ playerid ] [ rank ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете дать затычку своему руководству." ) ;
	if ( p_info [ params [ 0 ] ] [ f_mute ] == 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока нет затычки." ) ;

	p_info [ params [ 0 ] ] [ f_mute ] = 0 ;

	new scm_string [ 128 ] ;
	if ( gang_player ( playerid ) || mafia_player ( playerid ) ) format ( scm_string, sizeof scm_string, "[F] %s %s снял(а) затычку с %s.", f_rank [ fraction_id - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ] ) ;
	else format ( scm_string, sizeof scm_string, "[R] %s %s снял(а) затычку с %s.", f_rank [ fraction_id - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ] ) ;
	fraction_message ( fraction_id, col_lblue, scm_string ) ;

	format ( scm_string, sizeof scm_string, "UPDATE `fractions_players` SET `u_fmute` = '0' WHERE `u_sql_id` = '%d' LIMIT 1", p_info [ params [ 0 ] ] [ id ] ) ;
	mysql_tquery ( sql_connection, scm_string ) ;

    format ( scm_string, 128, "Снял(а) затычку с %s.", p_info [ params [ 0 ] ] [ name ] ) ;
	write_fraction ( playerid, fraction_id, TYPE_LOG_WARN, scm_string ) ;
	return 1 ;
}

callback: callback_rank_org ( playerid, _pl_id, _frac_id, _rank_id, bool: _online )
{
    new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( rows >= 3 ) return SendClientMessage ( _pl_id, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Поставить можно только трёх заместителей!" ) ;

	if ( _online )
	{
	    new _text_string [ 128 ] ;
		format ( _text_string, 128, "Изменил(а) ранг %s c %d на %d", p_info [ _pl_id ] [ name ], p_info [ _pl_id ] [ rank ], _rank_id);
		write_fraction ( playerid, _frac_id, TYPE_LOG_AGIVERANK, _text_string ) ;

		if ( p_info [ _pl_id ] [ rank ] > _rank_id )
		    insert_joblist ( _pl_id, "RANK", LABOR_TYPE_BACK_RANG, _rank_id ) ;

		else
		    insert_joblist ( _pl_id, "RANK", LABOR_TYPE_NEXT_RANG, _rank_id ) ;

		p_info [ _pl_id ] [ rank ] = _rank_id ;
		if ( f_info [ _frac_id - 1 ] [ f_skin_type ] == 1 )
		{
			p_info [ _pl_id ] [ org_skin ] = f_skin_rank [ _frac_id - 1 ] [ p_info [ _pl_id ] [ gender ] ] [ _rank_id - 1 ] ;
			fraction_duty ( _pl_id ) ;
		}

		_text_string [ 0 ] = EOS ;
		format ( _text_string, sizeof _text_string, "UPDATE `fractions_players` SET `u_rank` = '%d', `u_org_skin` = '%d' WHERE `u_sql_id` = '%d' LIMIT 1", _rank_id, p_info [ _pl_id ] [ org_skin ], p_info [ _pl_id ] [ id ] ) ;
		mysql_tquery ( sql_connection, _text_string ) ;

		format ( _text_string, 128, "{"#cGInfo"}* {"#cWH"}Вы назначили %s на ранг {"#cGN"}%s(%d)", p_info [ _pl_id ] [ name ], f_rank [ _frac_id - 1 ] [ _rank_id - 1 ], _rank_id ) ;
		SendClientMessage ( playerid, col_white, _text_string ) ;
		format ( _text_string, 128, "{"#cGN"}* %s {"#cWH"}назначил Вас на ранг {"#cGN"}%s(%d)", p_info [ playerid ] [ name ], f_rank [ _frac_id - 1 ] [ _rank_id - 1 ], _rank_id ) ;
		SendClientMessage ( _pl_id, col_succes, _text_string ) ;
	}
	else
	{
	    new pvar_string [ 38 ], pl_name [ MAX_PLAYER_NAME ] ;
		format ( pvar_string, sizeof ( pvar_string ), "ofm_%d", GetPVarInt ( playerid, "ofm_listitem" ) ) ;
		GetPVarString ( playerid, pvar_string, pl_name, MAX_PLAYER_NAME ) ;

		offmembers_rank ( playerid, _rank_id, pl_name, 0 ) ;
		show_offmembers_dialog ( playerid, pl_name, 0 ) ;
	}
	return 1 ;
}

CMD:invite ( playerid, params [ ] )
{
	if ( p_info [ playerid ] [ member ] < 1 ) return 1 ;

	new fraction_id = p_info [ playerid ] [ member ] ;
	if ( p_info [ playerid ] [ rank ] <  f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 1 ] )
	{
	    static const _str [ ] = "{"#cRInfo"}* {"#cGRInfo"}Команда доступна с ранга %s (%d)." ;
	    new scm_string [ sizeof _str + 30 + 3 ] ;
	    format ( scm_string, sizeof scm_string, _str, f_rank [ fraction_id - 1 ] [ f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 1 ] - 1 ], f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 1 ] ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
		return 1 ;
	}

	if ( sscanf ( params, "d", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /invite [ид]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] )  || params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( p_info [ params [ 0 ] ] [ member ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок уже состоит в какой-то организации, либо имеет приглашение." ) ;
	if ( ! bad_dialog ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Невозможно принять игрока в данный момент." ) ;
    if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок слишком далеко." ) ;
	if ( p_info [ params [ 0 ] ] [ p_warn ] != 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете принять игрока с предупреждением." ) ;
	if ( bl_info [ params [ 0 ] ] [ bl_onFrac ] [ fraction_id ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете принять игрока из чёрного списка организации." ) ;
	if ( ! gang_player ( playerid ) && ! mafia_player ( playerid ) )
	{
	    if ( GetInventoryFindItem ( params [ 0 ], SUB_INVENTORY, ITEM_PASSPORT ) < 1 )
		{
		    SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока нет паспорта." ) ;
		    SendClientMessage ( params [ 0 ], col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет паспорта. Получить его можно в Мэрии." ) ;
		    return 1 ;
		}
	}
	if ( cop_player ( playerid ) )
	{
	    if ( GetInventoryFindItem ( params [ 0 ], SUB_INVENTORY, ITEM_MILITARY_ID ) < 1 )
		{
		    SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока нет военного билета." ) ;
		    SendClientMessage ( params [ 0 ], col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет военного билета. Получить его можно отслужив в армии." ) ;
		    return 1 ;
		}
		if ( p_info [ params [ 0 ] ] [ law_obedience ] < 30 )
		{
			SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не законопослушен. Необходимо 30 законопослушности." ) ;
		    SendClientMessage ( params [ 0 ], col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нехватает законопослушности. Необходимо 30 законопослушности." ) ;
		    SendClientMessage ( params [ 0 ], col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Законопослушность {"#cGN"}повышается {"#cGRInfo"}каждый час проведённый в игре." ) ;
		    SendClientMessage ( params [ 0 ], col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Законопослушность {"#cRD"}уменьшается {"#cGRInfo"}за убийство игроков." ) ;
		    return 1 ;
		}
	}
	if ( fbi_player ( playerid ) )
	{
	    if ( GetInventoryFindItem ( params [ 0 ], SUB_INVENTORY, ITEM_MILITARY_ID ) < 1 )
		{
		    SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока нет военного билета." ) ;
		    SendClientMessage ( params [ 0 ], col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нет военного билета. Получить его можно отслужив в армии." ) ;
		    return 1 ;
		}
		if ( p_info [ params [ 0 ] ] [ law_obedience ] < 50 )
		{
			SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не законопослушен. Необходимо 50 законопослушности." ) ;
		    SendClientMessage ( params [ 0 ], col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У Вас нехватает законопослушности. Необходимо 50 законопослушности." ) ;
		    SendClientMessage ( params [ 0 ], col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Законопослушность {"#cGN"}повышается {"#cGRInfo"}каждый час проведённый в игре, в армии быстрее." ) ;
		    SendClientMessage ( params [ 0 ], col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Законопослушность {"#cRD"}уменьшается {"#cGRInfo"}за убийство игроков." ) ;
		    return 1 ;
		}
	}
    if ( ! player_rp_name [ params [ 0 ] ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока nonRP Nick_Name." ) ;
	if ( admin_info [ params [ 0 ] ] [ admin ] > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок администратор." ) ;

	global_string [ 0 ] = EOS ;
	format ( global_string, 100, "Вы пригласили %s в организацию", p_info [ params [ 0 ] ] [ name ] ) ;
	SendClientMessage ( playerid, col_gray, global_string ) ;
	if ( army_player ( playerid ) )
	{
		global_string [ 0 ] = EOS ;
		format ( global_string, 256, "{"#cOR"}%s {"#cWH"}предлагает Вам вступить в организацию {%s}\"%s\"\n\n{"#cWH"}Вы получите военный билет когда:\n{"#cGRDialog"}- {"#cWH"}Отыграете {"#cLY"}15 часов {"#cWH"}в организации.\n{"#cGRDialog"}- {"#cWH"}Достигните {"#cLY"}3 ранга{"#cWH"}.", p_info [ playerid ] [ name ], f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_chat_color ], f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_name ] ) ;
		show_dialog ( params [ 0 ], d_invite_box, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Вступление в организацию", global_string, "Вступить", "Отклонить" ) ;
	}
	else
	{
		global_string [ 0 ] = EOS ;
		format ( global_string, 128, "{"#cOR"}%s {"#cWH"}предлагает Вам вступить в организацию {%s}\"%s\"", p_info [ playerid ] [ name ], f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_chat_color ], f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_name ] ) ;
		show_dialog ( params [ 0 ], d_invite_box, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Вступление в организацию", global_string, "Вступить", "Отклонить" ) ;
	}

	buyer_id [ playerid ] = params [ 0 ] ;
	sell_item [ playerid ] = p_info [ playerid ] [ member ] ;
	seller_id [ params [ 0 ] ] = playerid ;

	sell_time { playerid } =
	sell_time { params [ 0 ] } = time_sell_null ;
	return 1 ;
}

CMD:auninvite ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 4 )return 1 ;
	if ( sscanf ( params, "us[48]", params [ 0 ], params [ 1 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /auninvite [ид/имя] [причина]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( p_info [ params [ 0 ] ] [ member ] == 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не состоит в организации." ) ;
	if ( p_info [ params [ 0 ] ] [ leader ] != 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок является лидером." ) ;

	new scm_string [ 266 ] ;
	format ( scm_string, 144, "Администратор %s[%i] уволил Вас из организации. Причина: %s", p_info [ playerid ] [ name ], playerid, params [ 1 ] ) ;
	SendClientMessage ( params [ 0 ], col_gray, scm_string ) ;

	format( scm_string, 144, "{"#cBAdmin"}[A] {"#cGRAdmin"}%s[%d] уволил %s[%d] из организации. Причина: %s", p_info [ playerid ] [ name ], playerid, p_info [ params [ 0 ] ] [ name ], params [ 0 ], params [ 1 ] ) ;
	foreach(new i: admin_players) SendClientMessage ( i, col_admin, scm_string ) ;

	format(scm_string, 128, "[A] %s уволил %s. Причина: %s", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], params [ 1 ]);
	WriteLogs(playerid, p_info [ playerid ] [ member ], TYPE_LOG_UVAL, scm_string);

	insert_joblist ( params [ 0 ], params [ 1 ], LABOR_TYPE_UNINVITE, p_info [ params [ 0 ] ] [ rank ] ) ;

	if ( p_info [ params [ 0 ] ] [ member ] != 0 ) Iter_Remove ( fraction_players[p_info[params [ 0 ]][member]], params [ 0 ] ) ;

	if ( gov_player ( params [ 0 ] ) )
	{
	    new fraction_id = p_info [ params [ 0 ] ] [ member ] ;
	    if ( p_info [ params [ 0 ] ] [ rank ] == f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 6 ] ||
			p_info [ params [ 0 ] ] [ rank ] == f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 7 ] ||
			p_info [ params [ 0 ] ] [ rank ] == f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 8 ] ||
			p_info [ params [ 0 ] ] [ rank ] == f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 12 ] )
		{
		    Iter_Remove ( fraction_ministry, params [ 0 ] ) ;
		}
	}

	p_info [ params [ 0 ] ] [ member ] =
	p_info [ params [ 0 ] ] [ rank ] =
	p_info [ params [ 0 ] ] [ org_skin ] =
    p_info [ params [ 0 ] ] [ warblock ] =
	p_info [ params [ 0 ] ] [ subleader ] =
	p_info [ params [ 0 ] ] [ f_warning ] = 0 ;

	scm_string [ 0 ] = EOS ;
	format ( scm_string, sizeof scm_string, "DELETE FROM `fractions_players` WHERE `u_sql_id` = '%d' LIMIT 1", p_info [ params [ 0 ] ] [ id ] ) ;
	mysql_tquery ( sql_connection, scm_string ) ;

	if ( is_fraction_duty { params [ 0 ] } == 1 ) is_fraction_duty { params [ 0 ] } = 0 ;

	SetPlayerSkin ( params [ 0 ], p_info [ params [ 0 ] ] [ skin ] ) ;
	SetPlayerColor ( params [ 0 ], 0xFFFFFF80 ) ; // col_white
	return 1 ;
}

CMD:promocodelist ( playerid )
{
	if ( admin_info [ playerid ] [ admin ] < 3 ) return 0 ;

	mysql_tquery(sql_connection, "SELECT `promo_id`, `promo_text`, `promo_used`, `promo_level`, `promo_llevel` FROM `server_promocodes`", "promo_code_list", "i", playerid);
	return 1 ;
}

CMD:promocodelistday ( playerid )
{
	if ( admin_info [ playerid ] [ admin ] < 3 ) return 0 ;

	mysql_tquery(sql_connection, "SELECT `promo_id`, `promo_text`, `promo_used` FROM `time_promocodes`", "promo_code_list_day", "i", playerid);
	return 1 ;
}

CMD:uninvite ( playerid, params [ ] )
{
	if ( ! p_info [ playerid ] [ member ] )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не состоите в организации." ) ;

	new fraction_id = p_info [ playerid ] [ member ] ;
	if ( p_info [ playerid ] [ rank ] <  f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 2 ] )
	{
	    static const _str [ ] = "{"#cRInfo"}* {"#cGRInfo"}Команда доступна с ранга %s (%d)." ;
	    new scm_string [ sizeof _str + 30 + 3 ] ;
	    format ( scm_string, sizeof scm_string, _str, f_rank [ fraction_id - 1 ] [ f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 1 ] - 1 ], f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 1 ] ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
		return 1 ;
	}

	if ( sscanf ( params, "us[32]", params [ 0 ], params [ 1 ] ) )
		return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /uninvite [ид/имя] [причина]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] )  || params [ 0 ] == playerid )
		return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( p_info [ params [ 0 ] ] [ member ] != fraction_id )
		return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не состоит в Вашей организации." ) ;
	if ( p_info [ params [ 0 ] ] [ rank ]  >= p_info [ playerid ] [ rank ] )
		return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете уволить своё руководство." ) ;
    if ( strlen ( params [ 1 ] ) < 3 || strlen ( params [ 1 ] ) > 32 )
		return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Причина должна содержать от 3 до 32 символов." ) ;
	if ( is_text_invalid ( params [ 1 ] ) )
		return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Причина содержит некорректные символы." ) ;
	if ( p_info [ params [ 0 ] ] [ leader ] != 0 )
		return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете разжаловать лидера организации." ) ;

	new scm_string [ 266 ] ;
	format ( scm_string, 128, "%s уволил Вас из организации. Причина: {ffffff}%s", p_info [ playerid ] [ name ], params [ 1 ] ) ;
	SendClientMessage ( params [ 0 ], col_wavy, scm_string ) ;
	format ( scm_string, 128, "Вы уволили %s из организации. Причина: {ffffff}%s", p_info [ params [ 0 ] ] [ name ], params [ 1 ] ) ;
	SendClientMessage ( playerid, col_wavy, scm_string ) ;

	if ( gang_player ( playerid ) || mafia_player ( playerid ) )
	{
		format ( scm_string, 128, "[F] %s %s выгнал(а) %s из организации. Причина: %s", f_rank [ fraction_id - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], params [ 1 ] ) ;
		fraction_message ( fraction_id, col_lblue, scm_string ) ;
	}
	else
	{
	    format ( scm_string, 128, "[R] %s %s выгнал(а) %s из организации. Причина: %s", f_rank [ fraction_id - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], params [ 1 ] ) ;
		fraction_message ( fraction_id, col_lblue, scm_string ) ;
	}

	insert_joblist ( params [ 0 ], params [ 1 ], LABOR_TYPE_UNINVITE, p_info [ params [ 0 ] ] [ rank ] ) ;

	f_info [ fraction_id - 1 ] [ f_members ] -- ;
	format ( scm_string, 144, "UPDATE `fractions` SET `f_members` = '%d' WHERE `f_id` = '%d' LIMIT 1", f_info [ fraction_id - 1 ] [ f_members ], fraction_id ) ;
	mysql_tquery ( sql_connection, scm_string ) ;

	if ( p_info [ playerid ] [ subleader ] )
	{
	    new _unit_id = p_info [ playerid ] [ subleader ] ;
		unit_info [ _unit_id - 1 ] [ u_members ] -- ;
		format ( scm_string, sizeof scm_string, "UPDATE `unit_settings` SET `unit_members` = '%d' WHERE `unit_id` = '%d' LIMIT 1", unit_info [ _unit_id - 1 ] [ u_members ], _unit_id ) ;
		mysql_tquery ( sql_connection, scm_string ) ;
	}

	format ( scm_string, 128, "Уволил(а) %s. Причина: %s", p_info [ params [ 0 ] ] [ name ], params [ 1 ]);
	write_fraction ( playerid, fraction_id, TYPE_LOG_UVAL, scm_string ) ;

	if ( fraction_id != 0 ) Iter_Remove(fraction_players[fraction_id], params[0]);

	if ( gov_player ( params [ 0 ] ) )
	{
	    if ( p_info [ params [ 0 ] ] [ rank ] == f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 6 ] ||
			p_info [ params [ 0 ] ] [ rank ] == f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 7 ] ||
			p_info [ params [ 0 ] ] [ rank ] == f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 8 ] ||
			p_info [ params [ 0 ] ] [ rank ] == f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 12 ] )
		{
		    Iter_Remove ( fraction_ministry, params [ 0 ] ) ;
		}
	}

	p_info [ params [ 0 ] ] [ member ] =
	p_info [ params [ 0 ] ] [ rank ] =
	p_info [ params [ 0 ] ] [ org_skin ] =
	p_info [ params [ 0 ] ] [ warblock ] =
	p_info [ params [ 0 ] ] [ subleader ] =
	p_info [ params [ 0 ] ] [ f_warning ] = 0 ;
	day_uninvite_player [ fraction_id - 1 ] += 1 ;

	scm_string [ 0 ] = EOS ;
	format ( scm_string, sizeof scm_string, "DELETE FROM `fractions_players` WHERE `u_sql_id` = '%d' LIMIT 1", p_info [ params [ 0 ] ] [ id ] ) ;
	mysql_tquery ( sql_connection, scm_string ) ;

	if ( is_fraction_duty { params [ 0 ] } ) is_fraction_duty { params [ 0 ] } = 0 ;

	SetPlayerSkin ( params [ 0 ], p_info [ params [ 0 ] ] [ skin ] ) ;
	SetPlayerColor ( params [ 0 ], 0xFFFFFF80 ) ; // col_white
	return 1 ;
}

CMD:warblock ( playerid, params [ ] )
{
    if ( ! gang_player ( playerid ) && ! mafia_player ( playerid ) ) return 1 ;

    new fraction_id = p_info [ playerid ] [ member ] ;
	if ( p_info [ playerid ] [ rank ] <  f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 8 ] )
	{
	    static const _str [ ] = "{"#cRInfo"}* {"#cGRInfo"}Команда доступна с ранга %s (%d)." ;
	    new scm_string [ sizeof _str + 30 + 3 ] ;
	    format ( scm_string, sizeof scm_string, _str, f_rank [ fraction_id - 1 ] [ f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 8 ] - 1 ], f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 8 ] ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
		return 1 ;
	}

	if ( sscanf ( params, "us[32]", params [ 0 ], params [ 1 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /warblock [ид/имя] [причина]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] )  || params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( p_info [ params [ 0 ] ] [ member ] != fraction_id ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не состоит в Вашей организации." ) ;
	if ( p_info [ params [ 0 ] ] [ rank ]  >= p_info [ playerid ] [ rank ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете дать запрет своему руководству." ) ;
	if ( p_info [ params [ 0 ] ] [ warblock ] > 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока уже имеется запрет на участие в войнах." ) ;

    new scm_string [ 144 ] ;
	p_info [ params [ 0 ] ] [ warblock ] = 1 ;

	format ( scm_string, sizeof scm_string, "[F] %s %s выдал(а) запрет на участие в войнах %s. Причина: %s", f_rank [ fraction_id - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], params [ 1 ] ) ;
	fraction_message ( fraction_id, col_lblue, scm_string ) ;

	format ( scm_string, sizeof scm_string, "UPDATE `fractions_players` SET `u_warblock` = '1' WHERE `u_sql_id` = '%d' LIMIT 1", p_info [ params [ 0 ] ] [ id ] ) ;
	mysql_tquery ( sql_connection, scm_string ) ;
	return 1 ;
}

CMD:unwarblock ( playerid, params [ ] )
{
    if ( ! gang_player ( playerid ) && ! mafia_player ( playerid ) ) return 1 ;

    new fraction_id = p_info [ playerid ] [ member ] ;
	if ( p_info [ playerid ] [ rank ] <  f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 8 ] )
	{
	    static const _str [ ] = "{"#cRInfo"}* {"#cGRInfo"}Команда доступна с ранга %s (%d)." ;
	    new scm_string [ sizeof _str + 30 + 3 ] ;
	    format ( scm_string, sizeof scm_string, _str, f_rank [ fraction_id - 1 ] [ f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 8 ] - 1 ], f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 8 ] ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
		return 1 ;
	}
	if ( sscanf ( params, "u", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /warblock [ид/имя]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] )  || params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( p_info [ params [ 0 ] ] [ member ] != fraction_id ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не состоит в Вашей организации." ) ;
	if ( p_info [ params [ 0 ] ] [ warblock ] == 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока нету запрета на участие в войнах." ) ;

    new scm_string [ 128 ] ;
	p_info [ params [ 0 ] ] [ warblock ] = 0 ;

	format ( scm_string, sizeof scm_string, "[F] %s %s снял(а) запрет на участие в войнах с %s.", f_rank [ fraction_id - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ] ) ;
	fraction_message ( fraction_id, col_lblue, scm_string ) ;

	format ( scm_string, sizeof scm_string, "UPDATE `fractions_players` SET `u_warblock` = '0' WHERE `u_sql_id` = '%d' LIMIT 1", p_info [ params [ 0 ] ] [ id ] ) ;
	mysql_tquery ( sql_connection, scm_string ) ;
	return 1 ;
}

CMD:fwarn ( playerid, params [ ] )
{
 	if ( ! p_info [ playerid ] [ member ] )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не состоите в организации." ) ;

 	new fraction_id = p_info [ playerid ] [ member ] ;
	if ( p_info [ playerid ] [ rank ] <  f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 4 ] )
	{
	    static const _str [ ] = "{"#cRInfo"}* {"#cGRInfo"}Команда доступна с ранга %s (%d)." ;
	    new scm_string [ sizeof _str + 30 + 3 ] ;
	    format ( scm_string, sizeof scm_string, _str, f_rank [ fraction_id - 1 ] [ f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 4 ] - 1 ], f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 4 ] ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
		return 1 ;
	}

	new targetid, _fwarn_str [ 32 ] ;
	if ( sscanf ( params, "us[32]", targetid, _fwarn_str ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /fwarn [ид/имя] [причина]" ) ;
	if ( ! IsPlayerConnected ( targetid )  || targetid == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( p_info [ targetid ] [ member ] != fraction_id ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не состоит в Вашей организации." ) ;
	if ( p_info [ targetid ] [ rank ]  >= p_info [ playerid ] [ rank ] && f_info [ fraction_id - 1 ] [ f_rank_warn ] == 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете дать выговор своему руководству." ) ;
	if ( strlen ( _fwarn_str ) < 3 || strlen ( _fwarn_str ) > 32 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Причина должна содержать от 3 до 32 символов." ) ;
	if ( is_text_invalid ( _fwarn_str ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Причина содержит некорректные символы." ) ;
	if ( p_info [ targetid ] [ leader ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете выдать выговор лидеру." ) ;
	if ( check_advertise ( playerid, params [ 1 ], report_type_fwarn ) ) return 1 ;

	p_info [ targetid ] [ f_warning ] ++ ;
	if ( p_info [ targetid ] [ f_warning ] >= f_info [ fraction_id - 1 ] [ f_maxwarn ] )
	{
		new scm_string [ 160 ] ;

		if ( gang_player ( playerid ) || mafia_player ( playerid ) ) format ( scm_string, 144, "[F] %s %s уволил(а) из организации %s (%d/%d). Причина: %s", f_rank [ fraction_id - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], p_info [ targetid ] [ name ], p_info [ targetid ] [ f_warning ], f_info [ fraction_id - 1 ] [ f_maxwarn ], _fwarn_str ) ;
		else format ( scm_string, 144, "[R] %s %s уволил(а) из организации %s (%d/%d). Причина: %s", f_rank [ fraction_id - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], p_info [ targetid ] [ name ], p_info [ targetid ] [ f_warning ], f_info [ fraction_id - 1 ] [ f_maxwarn ], _fwarn_str ) ;
		fraction_message ( fraction_id, col_lblue, scm_string ) ;

		insert_joblist ( targetid, _fwarn_str, LABOR_TYPE_TICKET ) ;

		f_info [ fraction_id - 1 ] [ f_members ] -- ;
		format ( scm_string, 144, "UPDATE `fractions` SET `f_members` = '%d' WHERE `f_id` = '%d' LIMIT 1", f_info [ fraction_id - 1 ] [ f_members ], fraction_id ) ;
		mysql_tquery ( sql_connection, scm_string ) ;

		format ( scm_string, 144, "Уволил(а) из организации %s (%d/%d). Причина: %s", p_info [ targetid ] [ name ], p_info [ targetid ] [ f_warning ], f_info [ fraction_id - 1 ] [ f_maxwarn ], _fwarn_str ) ;
		write_fraction ( playerid, fraction_id, TYPE_LOG_UVAL, scm_string ) ;

		if ( p_info [ targetid ] [ member ] != 0 ) Iter_Remove(fraction_players[fraction_id], targetid);

		if ( gov_player ( targetid ) )
		{
		    if ( p_info [ targetid ] [ rank ] == f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 6 ] ||
				p_info [ targetid ] [ rank ] == f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 7 ] ||
				p_info [ targetid ] [ rank ] == f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 8 ] ||
				p_info [ targetid ] [ rank ] == f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 12 ] )
			{
			    Iter_Remove ( fraction_ministry, targetid ) ;
			}
		}

		p_info [ targetid ] [ member ] =
		p_info [ targetid ] [ rank ] =
		p_info [ targetid ] [ org_skin ] =
		p_info [ targetid ] [ warblock ] =
		p_info [ targetid ] [ subleader ] =
		p_info [ targetid ] [ f_warning ] = 0 ;
		day_uninvite_player [ fraction_id - 1 ] += 1 ;

		scm_string [ 0 ] = EOS ;
		format ( scm_string, sizeof scm_string, "DELETE FROM `fractions_players` WHERE `u_sql_id` = '%d' LIMIT 1", p_info [ targetid ] [ id ] ) ;
		mysql_tquery ( sql_connection, scm_string ) ;

		if ( is_fraction_duty { targetid } ) is_fraction_duty { targetid } = 0 ;

		SetPlayerSkin ( targetid, p_info [ targetid ] [ skin ] ) ;
		SetPlayerColor ( targetid, 0xFFFFFF80 ) ; // col_white
	}
	else
	{
		new scm_string [ 256 ] ;

		if ( gang_player ( playerid ) || mafia_player ( playerid ) ) format ( scm_string, 144, "[F] %s %s выдал(а) выговор %s (%d/%d). Причина: %s", f_rank [ fraction_id - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], p_info [ targetid ] [ name ], p_info [ targetid ] [ f_warning ], f_info [ fraction_id - 1 ] [ f_maxwarn ], _fwarn_str ) ;
		else format ( scm_string, 144, "[R] %s %s выдал(а) выговор %s (%d/%d). Причина: %s", f_rank [ fraction_id - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], p_info [ targetid ] [ name ], p_info [ targetid ] [ f_warning ], f_info [ fraction_id - 1 ] [ f_maxwarn ], _fwarn_str ) ;
		fraction_message ( fraction_id, col_lblue, scm_string ) ;

		format ( scm_string, 144, "Выдал(а) выговор %s (%d/%d). Причина: %s", p_info [ targetid ] [ name ], p_info [ targetid ] [ f_warning ], f_info [ fraction_id - 1 ] [ f_maxwarn ], _fwarn_str ) ;
		write_fraction ( playerid, fraction_id, TYPE_LOG_WARN, scm_string ) ;

		format ( scm_string, sizeof scm_string, "UPDATE `fractions_players` SET `u_f_warning` = '%d' WHERE `u_sql_id` = '%d' LIMIT 1", p_info [ targetid ] [ f_warning ], p_info [ targetid ] [ id ] ) ;
		mysql_tquery ( sql_connection, scm_string ) ;
	}
    return 1 ;
}

CMD:funwarn ( playerid, params [ ] )
{
 	if ( ! p_info [ playerid ] [ member ] )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не состоите в организации." ) ;

 	new fraction_id = p_info [ playerid ] [ member ] ;
 	if ( p_info [ playerid ] [ rank ] <  f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 4 ] )
 	{
	    static const _str [ ] = "{"#cRInfo"}* {"#cGRInfo"}Команда доступна с ранга %s (%d)." ;
	    new scm_string [ sizeof _str + 30 + 3 ] ;
	    format ( scm_string, sizeof scm_string, _str, f_rank [ fraction_id - 1 ] [ f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 4 ] - 1 ], f_info [ fraction_id - 1 ] [ f_rank_settings ] [ 4 ] ) ;
		SendClientMessage ( playerid, col_gray, scm_string ) ;
		return 1 ;
	}
	if ( sscanf ( params, "u", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /funwarn [ид/имя]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] )  || params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не найден." ) ;
	if ( p_info [ params [ 0 ] ] [ member ] != fraction_id ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Игрок не состоит в Вашей организации." ) ;
	if ( p_info [ params [ 0 ] ] [ rank ]  >= p_info [ playerid ] [ rank ] && f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_warn ] == 0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не можете снять выговор своему руководству." ) ;
	if ( p_info [ params [ 0 ] ] [ f_warning ] == 0 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}У игрока нет выговоров." ) ;

	p_info [ params [ 0 ] ] [ f_warning ] -= 1 ;

	new scm_string [ 128 ] ;
	if ( gang_player ( playerid ) || mafia_player ( playerid ) ) format ( scm_string, sizeof scm_string, "[F] %s %s снял(а) выговор с %s.", f_rank [ fraction_id - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ] ) ;
	else  format ( scm_string, sizeof scm_string, "[R] %s %s снял(а) выговор с %s.", f_rank [ fraction_id - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ] ) ;
	fraction_message ( fraction_id, col_lblue, scm_string ) ;

	format ( scm_string, sizeof scm_string, "UPDATE `fractions_players` SET `u_f_warning` = '%d' WHERE `u_sql_id` = '%d' LIMIT 1", p_info [ params [ 0 ] ] [ f_warning ], p_info [ params [ 0 ] ] [ id ] ) ;
	mysql_tquery ( sql_connection, scm_string ) ;

	format ( scm_string, 128, "Снял(а) выговор с %s", p_info [ params [ 0 ] ] [ name ] ) ;
	write_fraction ( playerid, fraction_id, TYPE_LOG_WARN, scm_string ) ;
    return 1 ;
}

callback: FractionWarns ( playerid )
{
    new rows, fields ;
    cache_get_data ( rows, fields ) ;

    global_string [ 0 ] = EOS ;
	new line_string [ 128 ], warn_id, f_date [ 32 ], f_reason [ 32 ], to_f_name [ 32 ] ;
	strcat ( global_string, "{"#cBL"}Выдал(а):\t{"#cBL"}Дата:\t{"#cBL"}Причина:\n" ) ;
	for ( new i = 0 ; i < rows ; i ++ )
	{
        warn_id = cache_get_field_content_int ( i, "f_id", sql_connection ) ;
        cache_get_field_content ( i, "f_date", f_date, sql_connection, MAX_PLAYER_NAME ) ;
        cache_get_field_content ( i, "f_reason", f_reason, sql_connection, 32 ) ;
        cache_get_field_content ( i, "to_f_name", to_f_name, sql_connection, 32 ) ;

		set_player_listitem_values ( playerid, i, warn_id ) ;

        format ( line_string, sizeof line_string, "%s\t%s\t%s\n", to_f_name, f_date, f_reason ) ;
        strcat ( global_string, line_string ) ;

        show_dialog(playerid, d_fwarn, DIALOG_STYLE_TABLIST_HEADERS, "{"#cBHD"}Выговоры члена организации", global_string, "Снять", "Закрыть");
    }
	return 1;
}

alias:find("members")
CMD:find ( playerid, params [ ] )
{
	if ( p_info [ playerid ] [ member ] < 1 )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Вы не состоите в организации." ) ;
	show_find ( playerid, p_info [ playerid ] [ member ] ) ;
	return 1 ;
}

stock show_find ( playerid, fraction_id )
{
    new full = 0, afk = 0, text [ 20 ],
		_f_maxwarn = f_info [ fraction_id - 1 ] [ f_maxwarn ], line_string [ 144 ], _rank_id ;

	global_string [ 0 ] = EOS ;
	if ( fraction_id == 7 )
	{
		strcat ( global_string, "{"#cBL"}ID. Имя игрока:\t{"#cBL"}Должность:\t{"#cBL"}Телефон:\t{"#cBL"}Маскировка:\n" ) ;
	    foreach(new i: logged_players)
	    {
	        if ( p_info [ i ] [ member ] == fraction_id || is_fraction_cover { i } == fraction_id )
			{
			    _rank_id = p_info [ i ] [ rank ] ;
				if ( _rank_id < 1 ) continue ;

			    if ( pl_afk_time [ i ] > 2 ) afk ++ ;
				if ( p_info [ i ] [ number ] <= 1 ) format ( text, sizeof ( text ), "{"#cRD"}Нет" ) ;
				else format ( text, sizeof ( text ), "{"#cLY"}%i", p_info [ i ] [ number ] ) ;

				if ( is_fraction_cover { i } == 7 && p_info [ i ] [ member ] > 0 )
					format ( line_string, sizeof line_string, "{"#cBL"}%i. {"#cWH"}%s%s%s\t{33AAFF}%s {"#cGRDialog"}- %d ранг {"#cWH"}(%d/%d)\t%s{"#cWH"}\t%s (%s)\n",
					i, is_fraction_cover_name [ i ], ( p_info [ i ] [ mute ] > 0 ) ? ( " {"#cRD"}(MUTE){"#cWH"}" ) : ( "" ),
					( pl_afk_time [ i ] > 2 ) ? ( " {EBA43D}[AFK]{ffffff}" ) : ( "" ), f_rank [ fraction_id - 1 ] [ _rank_id - 1 ],
					_rank_id, p_info [ i ] [ f_warning ], _f_maxwarn, text, p_info [ i ] [ name ],
					f_info [ fraction_id - 1 ] [ f_letter_name ] ) ;

				else
					format ( line_string, sizeof line_string, "{"#cBL"}%i. {"#cWH"}%s%s%s\t{33AAFF}%s {"#cGRDialog"}- %d ранг {"#cWH"}(%d/%d)\t%s{"#cWH"}\t-\n",
					i, p_info [ i ] [ name ], ( p_info [ i ] [ mute ] > 0 ) ? ( " {"#cRD"}(MUTE){"#cWH"}" ) : ( "" ),
					( pl_afk_time [ i ] > 2 ) ? ( " {EBA43D}[AFK]{ffffff}" ) : ( "" ), f_rank [ fraction_id - 1 ] [ _rank_id - 1 ],
					_rank_id, p_info [ i ] [ f_warning ], _f_maxwarn, text ) ;

	            strcat ( global_string, line_string ) ;

				full ++ ;
			}
	    }
	}
	else
	{
		strcat ( global_string, "{"#cBL"}ID. Имя игрока:\t{"#cBL"}Должность:\t{"#cBL"}Телефон:\n" ) ;
		foreach(new i: fraction_players[fraction_id])
		{
			if ( p_info [ i ] [ member ] == fraction_id )
			{
			    _rank_id = p_info [ i ] [ rank ] ;
				if ( _rank_id < 1 ) continue ;

			    if ( pl_afk_time [ i ] > 2 ) afk ++ ;
				if ( p_info [ i ] [ number ] <= 1 ) format ( text, sizeof ( text ), "{"#cRD"}Нет") ;
				else format ( text, sizeof ( text ), "{"#cLY"}%i", p_info [ i ] [ number ] ) ;

				format ( line_string, sizeof line_string, "{"#cBL"}%i. {"#cWH"}%s%s%s\t{33AAFF}%s {"#cGRDialog"}- %d ранг {"#cWH"}(%d/%d)\t%s{"#cWH"} %s\n",
				i, p_info [ i ] [ name ], ( p_info [ i ] [ mute ] > 0 ) ? ( " {"#cRD"}(MUTE){"#cWH"}" ) : ( "" ),
				( pl_afk_time [ i ] > 2 ) ? ( " {EBA43D}[AFK]{ffffff}" ) : ( "" ), f_rank [ fraction_id - 1 ] [ _rank_id - 1 ],
				_rank_id, p_info [ i ] [ f_warning ], _f_maxwarn, text,
				( p_info [ i ] [ warblock ] == 0 ) ? ( "" ) : ( "{"#cGRDialog"}* WAR BLOCK" ) ) ;
				strcat ( global_string, line_string ) ;

				full ++ ;
			}
		}
	}

	line_string [ 0 ] = EOS ;
	format ( line_string, sizeof line_string, "{"#cBHD"}В AFK: {"#cWH"}%d чел.{"#cBHD"}, Онлайн: {"#cWH"}%d чел.{"#cBHD"}, Всего: {"#cWH"}%d чел.{"#cBHD"}.", afk, full, f_info [ fraction_id - 1 ] [ f_members ] ) ;
	show_dialog ( playerid, d_none, DIALOG_STYLE_TABLIST_HEADERS, line_string, global_string, "Закрыть", "" ) ;
	return 1 ;
}

stock ULoadAllMembers ( playerid, unit_id )
{
    new full = 0, afk = 0, text [ 20 ],
		fraction_id = p_info [ playerid ] [ member ], _f_maxwarn = f_info [ fraction_id - 1 ] [ f_maxwarn ],
		 line_string [ 144 ], _rank_id ;

	global_string [ 0 ] = EOS ;
	if ( fraction_id == 7 )
	{
		strcat ( global_string, "{"#cBL"}ID. Имя игрока:\t{"#cBL"}Должность:\t{"#cBL"}Телефон:\t{"#cBL"}Маскировка:\n" ) ;
	    foreach(new i: logged_players)
	    {
	        if ( p_info [ i ] [ member ] == fraction_id && p_info [ i ] [ subleader ] == unit_id && is_fraction_cover { i } == fraction_id )
			{
			    _rank_id = p_info [ i ] [ rank ] ;
				if ( _rank_id < 1 ) continue ;

			    if ( pl_afk_time [ i ] > 2 ) afk ++ ;
				if ( p_info [ i ] [ number ] <= 1 ) format ( text, sizeof ( text ), "{"#cRD"}Нет" ) ;
				else format ( text, sizeof ( text ), "{"#cLY"}%i", p_info [ i ] [ number ] ) ;

				if ( is_fraction_cover { i } == 7 && p_info [ i ] [ member ] > 0 )
					format ( line_string, sizeof line_string, "{"#cBL"}%i. {"#cWH"}%s%s%s\t{33AAFF}%s {"#cGRDialog"}- %d ранг {"#cWH"}(%d/%d)\t%s{"#cWH"}\t%s (%s)\n",
					i, is_fraction_cover_name [ i ], ( p_info [ i ] [ mute ] > 0 ) ? ( " {"#cRD"}(MUTE){"#cWH"}" ) : ( "" ),
					( pl_afk_time [ i ] > 2 ) ? ( " {EBA43D}[AFK]{ffffff}" ) : ( "" ), f_rank [ fraction_id - 1 ] [ _rank_id - 1 ],
					_rank_id, p_info [ i ] [ f_warning ], _f_maxwarn, text, p_info [ i ] [ name ],
					f_info [ fraction_id - 1 ] [ f_letter_name ] ) ;

				else
					format ( line_string, sizeof line_string, "{"#cBL"}%i. {"#cWH"}%s%s%s\t{33AAFF}%s {"#cGRDialog"}- %d ранг {"#cWH"}(%d/%d)\t%s{"#cWH"}\t-\n",
					i, p_info [ i ] [ name ], ( p_info [ i ] [ mute ] > 0 ) ? ( " {"#cRD"}(MUTE){"#cWH"}" ) : ( "" ),
					( pl_afk_time [ i ] > 2 ) ? ( " {EBA43D}[AFK]{ffffff}" ) : ( "" ), f_rank [ fraction_id - 1 ] [ _rank_id - 1 ],
					_rank_id, p_info [ i ] [ f_warning ], _f_maxwarn, text ) ;

	            strcat ( global_string, line_string ) ;

				full ++ ;
			}
	    }
	}
	else
	{
		strcat ( global_string, "{"#cBL"}ID. Имя игрока:\t{"#cBL"}Должность:\t{"#cBL"}Телефон:\n" ) ;
		foreach(new i: fraction_players[fraction_id])
		{
			if ( p_info [ i ] [ member ] == fraction_id && p_info [ i ] [ subleader ] == unit_id )
			{
			    _rank_id = p_info [ i ] [ rank ] ;
				if ( _rank_id < 1 ) continue ;

			    if ( pl_afk_time [ i ] > 2 ) afk ++ ;
				if ( p_info [ i ] [ number ] <= 1 ) format ( text, sizeof ( text ), "{"#cRD"}Нет") ;
				else format ( text, sizeof ( text ), "{"#cLY"}%i", p_info [ i ] [ number ] ) ;

				format ( line_string, sizeof line_string, "{"#cBL"}%i. {"#cWH"}%s%s%s\t{33AAFF}%s {"#cGRDialog"}- %d ранг {"#cWH"}(%d/%d)\t%s{"#cWH"} %s\n",
				i, p_info [ i ] [ name ], ( p_info [ i ] [ mute ] > 0 ) ? ( " {"#cRD"}(MUTE){"#cWH"}" ) : ( "" ),
				( pl_afk_time [ i ] > 2 ) ? ( " {EBA43D}[AFK]{ffffff}" ) : ( "" ), f_rank [ fraction_id - 1 ] [ _rank_id - 1 ],
				_rank_id, p_info [ i ] [ f_warning ], _f_maxwarn, text,
				( p_info [ i ] [ warblock ] == 0 ) ? ( "" ) : ( "{"#cGRDialog"}* WAR BLOCK" ) ) ;
				strcat ( global_string, line_string ) ;

				full ++ ;
			}
		}
	}

	line_string [ 0 ] = EOS ;
	format ( line_string, sizeof line_string, "{"#cBHD"}В AFK: {"#cWH"}%d чел.{"#cBHD"}, Онлайн подр.: {"#cWH"}%d чел.{"#cBHD"}, Всего в подр.: {"#cWH"}%d чел.{"#cBHD"}.", afk, full, f_info [ fraction_id - 1 ] [ f_members ] ) ;
	show_dialog ( playerid, d_none, DIALOG_STYLE_TABLIST_HEADERS, line_string, global_string, "Закрыть", "" ) ;
	return 1 ;
}

CMD:gzowner ( playerid, params [ ] )
{
	if ( admin_info [ playerid ] [ admin ] < 5 )return 1 ;
 	if ( sscanf ( params, "d", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Используйте: /gzowner [банда]" ) ;
	if ( params [ 0 ] != 0 && ( params [ 0 ] < 18 || params [ 0 ] > 22 ) )return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Неверный номер банды." ) ;
    for ( new i = 0 ; i < gz_count ; i ++ )
	{
		if ( IsPlayerInGangZone ( playerid, i ) )
		{
			gz_info [ i ] [ gz_owner ] = params [ 0 ] ;
			GangZoneHideForAll ( gz_info [ i ] [ gz_created ] ) ;
			GangZoneShowForAll ( gz_info [ i ] [ gz_created ], GetGangZoneColor ( gz_info [ i ] [ gz_owner ]) ) ;
			SaveGangZone ( i ) ;
			break ;
		}
	}
	return 1 ;
}

CMD:gzid ( playerid, params [ ] )
